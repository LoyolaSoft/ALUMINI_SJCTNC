<script>
    var attachmentFilesMap = {}; // Global map to track pending attachments

    function AppendFileDom(fileDom, fileName, exactSize, iProgress, files, i) {

        let r = Math.random().toString(36).substring(i);
        var filedom = "<tr id=" + r + ">" +
            "<td>" +
            "<span class='preview'>" + fileDom + "</span>" +
            "</td>" +
            "<td>" +
            "<div>" +
            "<dl>" +
            "<dt class=text-inverse>File Name:</dt>" +
            "<dd class=name>" + fileName + "</dd>" +
            "<dt class=text-inverse>File Size:</dt>" +
            "<dd class=size>" + exactSize + "</dd>" +
            "</dl>" +
            "</div>" +
            "<strong class='error text-danger'></strong>" +
            "</td>" +
            "<td>" +
            "<div class='m-b-15'>" +
            "<span class='label label-success' style='font-size:12px;'><i class='fa fa-check-circle'></i> Ready to Upload</span>" +
            "</div>" +
            "</td>" +
            "<td nowrap=>" +
            "<button class='btn btn-default cancel width-100 p-r-20' onclick=FileCancel('" + r + "')>" +
            "<i class='fa fa-trash fa-fw pull-left m-t-2 m-r-5 text-muted'></i>" +
            "<span>Cancel</span>" +
            "</button>" +

            "</td>" +
            "</tr>";
        attachmentFilesMap[r] = files[i];
        return filedom;

    }

    function readmultifiles() {

        var totalFiles = document.getElementById('fAttachment').files.length;
        if (totalFiles > 0) {
            $('#trEmpty').empty();
        }
        if (totalFiles > 1) {
            alert("Only one file is allowed.");
            fileInput.value = ""; // clear selection
            return;
        }
        var files = document.getElementById('fAttachment').files;
        // Read first file
        setup_reader(files, 0);
    }

    function setup_reader(files, i) {
        var file = files[i];
        var name = file.name;
        var reader = new FileReader();
        reader.onloadend = function (e) {
            readerLoaded(e, files, i, name);
        };
        reader.readAsBinaryString(file);
        // After reading, read the next file.
    }

    function readerLoaded(e, files, i, name) {
        var Dom = $('.files');
        var _size = files[i].size;
        var extension = GetFileExtension(files, i);
        var size = GetFileSize(files, i);
        var iProgress = GetProgressRate(_size);

        if (size != null && size != '') {
            var actualFileDom;
            if (extension != null && extension != '') {
                if (extension == 'jpg' || extension == 'png') {
                    actualFileDom = "<img src=" + window.URL.createObjectURL(files[i]) + " width=77 height=80></img>";
                }
                else {
                    actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                }
                var filedom = AppendFileDom(actualFileDom, name, size, iProgress, files, i);
                Dom.append(filedom);
            }
        }

        // get file content
        var bin = e.target.result;
        // do sth with text

        // If there's a file left to load
        if (i < files.length - 1) {
            // Load the next file
            setup_reader(files, i + 1);

        }
    }

    function GetFileExtension(files, i) {
        // Get uploaded file extension
        var extension = files[i].name.split('.').pop().toLowerCase();
        var validFileExtensions = ['doc', 'docx', 'pdf', 'jpg', 'png', 'txt', 'xlsx'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            alert("Sorry!! Upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file")
            //$(this).replaceWith($(this).val('').clone(true));
            return extension = null;
        }
        else {
            return extension;
        }
    }

    function GetFileSize(files, i) {

        var _size = files[i].size;
        var fileSize = _size;
        var fSExt = new Array('Bytes', 'KB', 'MB', 'GB'),
            i = 0; while (_size > 900) { _size /= 1024; i++; }
        var exactSize = (Math.round(_size * 100) / 100) + ' ' + fSExt[i];

        if (fileSize > 1024000000) {
            alert("Sorry!! Max allowed file size is 100 mb");
            // Clear fileuload control selected file
            // $(this).replaceWith($(this).val('').clone(true));
            return exactSize = null;

        }
        else {
            return exactSize;
        }

    }

    function GetProgressRate(size) {

        var dataTotal = 0;
        // sum up files lengths
        dataTotal = dataTotal + size;
        var iProgress = parseInt((dataTotal / 1000) * 100 / 128);
        return iProgress;
    }
    function FileCancel(rowId, isExisting) {
        var row = document.getElementById(rowId);
        
        if (isExisting) {
            // If it's an existing file, we need to remove it from the hidden #FILE_PATH field
            var pathToRemove = $(row).attr('data-existing-path');
            var currentPaths = $('#FILE_PATH').val().split(',');
            var updatedPaths = currentPaths.filter(function(p) { return p !== pathToRemove; });
            $('#FILE_PATH').val(updatedPaths.join(','));
        } else {
            if (attachmentFilesMap[rowId]) {
                delete attachmentFilesMap[rowId];
            }
        }
        
        row.parentNode.removeChild(row);
        
        // If no more files, show empty row
        if ($("#tblStaffPersonalFileList tbody tr").not("#trEmpty").length === 0) {
            $("#trEmpty").show();
        }
    }
     $("#btnEditStudentAcadamic").on("click",function()
 {
     var fileData = new FormData();
     var IS_EMAIL_SHOW = 0;
     var IS_CONTACT_NO_SHOW = 0;
     var isValid = true;
     if ($('#nav-tab2-1').parsley().validate() !== true) isValid = false;
     if (!isValid) {
         //gritter-info,danger,success,warning,default
         myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
         return false;
     }
     IS_EMAIL_SHOW = $("#IS_EMAIL_SHOW").is(":checked") ? "1" : "0";
     IS_CONTACT_NO_SHOW = $("#IS_CONTACT_NO_SHOW").is(":checked") ? "1" : "0";
     var STAFF_ID = $("#STAFF_ID").val();
     var COLLEGE_EMAIL_ID = $("#COLLEGE_EMAIL_ID").val();
     var STAFF_CODE = $("#STAFF_CODE").val();
     var PROFILE_ID = $("#PROFILE_ID").val();
     var STAFF_NAME = $("#STAFF_NAME").val();
     var ADDRESS = $("#ADDRESS").val();
     var QUALIFICATION = $("#QUALIFICATION").val();
     var CONTACT_NO = $("#CONTACT_NO").val();
     var EMAIL_ID = $("#EMAIL_ID").val();
     var PHD_AWARDEES = $("#PHD_AWARDEES").val();
     var PHOTO = $("#PHOTO").val() ? $("#PHOTO").val().replace(/\\/g, '\\\\') : "";
     var FILE_PATH = $("#FILE_PATH").val() ? $("#FILE_PATH").val().replace(/\\/g, '\\\\') : "";
     var SPECIALIZATION = $("#SPECIALIZATION").val();
     var DESIGNATION = $("#DESIGNATION").val();
     var PHD_SUPERVISOR = $("#PHD_SUPERVISOR").val();
     var NEW_ACCEPTING_PHD = $("#NEW_ACCEPTING_PHD").val();
     var LINKEDIN_LINK = $("#LINKEDIN_LINK").val();
     var GOOGLE_SCHOLAR = $("#GOOGLE_SCHOLAR").val();
     var SCOPUS_ID = $("#SCOPUS_ID").val();
     var IRINS_ID = $("#IRINS_ID").val();
     var ORCID_ID = $("#ORCID_ID").val();
     var DEPARTMENT = $("#DEPARTMENT").val();
     var RESEARCHER_ID = $("#RESEARCHER_ID").val();

     var fileUpload = $("#inputimg").get(0);
     var files = fileUpload.files;
     // Create FormData object
     
         var profileImgFile = $("#inputimg")[0].files[0];
         if (profileImgFile) {
             fileData.append("profileImage", profileImgFile);
         }

          // attachments from global map
          for (var key in attachmentFilesMap) {
              if (attachmentFilesMap.hasOwnProperty(key)) {
                  fileData.append("attachments", attachmentFilesMap[key]);
              }
          }
     // Looping over all files and add it to FormData object
   


     var profileData = {
         STAFF_ID: STAFF_ID,
         PROFILE_ID: PROFILE_ID,
         IS_EMAIL_SHOW: IS_EMAIL_SHOW,
         IS_CONTACT_NO_SHOW: IS_CONTACT_NO_SHOW,
         COLLEGE_EMAIL_ID: COLLEGE_EMAIL_ID,
         STAFF_CODE: STAFF_CODE,
         STAFF_NAME: STAFF_NAME,
         ADDRESS: ADDRESS,
         QUALIFICATION: QUALIFICATION,
         CONTACT_NO: CONTACT_NO,
         EMAIL_ID: EMAIL_ID,
         PHOTO: $("#PHOTO").val(), // No manual escaping needed with JSON.stringify
         SPECIALIZATION: SPECIALIZATION,
         DESIGNATION: DESIGNATION,
         PHD_SUPERVISOR: PHD_SUPERVISOR,
         NEW_ACCEPTING_PHD: NEW_ACCEPTING_PHD,
         LINKEDIN_LINK: LINKEDIN_LINK,
         GOOGLE_SCHOLAR: GOOGLE_SCHOLAR,
         SCOPUS_ID: SCOPUS_ID,
         IRINS_ID: IRINS_ID,
         ORCID_ID: ORCID_ID,
         RESEARCHER_ID: RESEARCHER_ID,
         PHD_AWARDEES: PHD_AWARDEES,
         FILE_PATH: $("#FILE_PATH").val(),
         DEPARTMENT: DEPARTMENT,
         STF_ROLE_RES_ID: $("#ROLES_RESPONSE").val()
     };

     fileData.append("str", JSON.stringify(profileData));
        

     $.ajax({
         url:"@Url.Action("UpdateStfProfile", "Website")",
         method:"POST",
         contentType: false,
         processData: false,
         data: fileData,
         success:function(data)
         {
             if (data == "200") {
                 swal({
                     title: "Success!",
                     text: 'Record(s) saved successfully!',
                     icon: 'success',
                     button: false,
                     timer: 1500
                 });
                 setTimeout(function () {
                     loadContent('/Website/EditStaffProfileByStaff');
                 }, 1500);
             }
             else if (data == "406")
                 swal({ title: "Failed !", text: 'Failed to save Records !', showConfirmButton: false, timer: 2000, type: 'error', animation: true });
         },error:function(error)
         {
             swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
         }
     });
 });
</script>

