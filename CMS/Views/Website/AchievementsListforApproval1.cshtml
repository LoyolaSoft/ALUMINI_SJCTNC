
@model CMS.ViewModel.ViewModel.WebsiteViewModel

@{
    Layout = null;

}
<style>
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    #btnImage {
        border: 1px solid gray;
        color: gray;
        background-color: white;
        padding: 7px 15px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }

    .approvBtn {
        border-radius: 5px;
        border: 2px solid lightgrey;
        padding: 3px;
        color: black;
        margin: 10px;
    }

    .Cancelbtn {
        border-radius: 5px;
        border: 2px solid lightgrey;
        padding: 3px;
        color: black;
        margin-left: 10px;
    }

    /* Premium Offcanvas Styles for HomeAchievement-dialog */
    #HomeAchievement-dialog.modal {
        padding-right: 0 !important;
        overflow: hidden !important;
    }

    #HomeAchievement-dialog.modal .modal-dialog {
        position: fixed;
        margin: 0 !important;
        right: 0;
        top: 0;
        bottom: 0;
        height: 100%;
        width: 80% !important;
        max-width: none !important;
        z-index: 1050;
        transform: translate3d(100%, 0, 0);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Slide-in/out transitions */
    #HomeAchievement-dialog.modal.in .modal-dialog {
        transform: translate3d(0, 0, 0);
    }

    #HomeAchievement-dialog.modal.fade .modal-dialog {
        transform: translate3d(100%, 0, 0);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #HomeAchievement-dialog.modal.fade.in .modal-dialog {
        transform: translate3d(0, 0, 0);
    }

    #HomeAchievement-dialog.modal .modal-content {
        height: 100%;
        border-radius: 0 !important;
        border: none;
        box-shadow: -8px 0 30px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    #HomeAchievement-dialog.modal .modal-header {
        flex-shrink: 0;
        border-bottom: 1px solid #eaeaea;
        background-color: #fcfcfc;
        padding: 18px 24px;
    }

    #HomeAchievement-dialog.modal .modal-title {
        font-weight: 600;
        color: #333333;
        font-size: 18px;
    }

    #HomeAchievement-dialog.modal .close {
        font-size: 24px;
        color: #999;
        opacity: 0.8;
        outline: none;
        margin-top: 2px;
        transition: color 0.2s;
    }

    #HomeAchievement-dialog.modal .close:hover {
        color: #333;
    }

    #HomeAchievement-dialog.modal .modal-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 24px;
        background: #ffffff;
    }

    #HomeAchievement-dialog.modal .modal-footer {
        flex-shrink: 0;
        border-top: 1px solid #eaeaea;
        background-color: #fcfcfc;
        padding: 16px 24px;
        margin-top: 0;
        text-align: right;
    }

    #HomeAchievement-dialog.modal .modal-footer .btn {
        padding: 8px 16px;
        font-weight: 500;
        border-radius: 6px;
    }

    /* Desktop View width 80% */
    @@media (min-width: 768px) {
        #HomeAchievement-dialog.modal .modal-dialog {
            width: 80% !important;
        }
    }

    /* Mobile View width 100% */
    @@media (max-width: 767px) {
        #HomeAchievement-dialog.modal .modal-dialog {
            width: 100% !important;
        }
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/css/lightbox.min.css">
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Website</a></li>
        <li class="active">Campus News Approval Page</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Campus News Approval Page<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Campus News Approval Page</h4>
        </div>
        <div class="panel-body">

            @if (Model.liWebsiteEvent != null && Model.liWebsiteEvent.Count > 0)
            {
                var count = 0;
                <div class="form-group col-md-12 table-responsive">
                    <table class="table table-hover table-bordered" id="tblAchievementList">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Department  </th>
                                <th>Category  </th>
                                <th>Date</th>
                                <th>Image</th>
                                <th>File</th>

                                <th>Entry Name</th>
                                <th>Approver Status</th>
                                <th>Action</th>
                                <th>Title</th>
                                <th>Descritpion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.liWebsiteEvent)
                            {
                                var splitImgPath = item.IMG_PATH.Split(',');
                                count = count + 1;
                                int imgcount = 0;
                                <tr>
                                    <td>@count</td>


                                    <td>@item.DEPARTMENT</td>
                                    <td>@item.ACHIEVEMENT_NAME</td>
                                    <td>@item.DATE</td>
                                    <td>
                                        @foreach (var items in splitImgPath)
                                        {
                                            imgcount++;

                                            //var imgpath = "/" + items.Replace(@"\", "/").TrimStart('/');
                                            var parts = items.Split(new[] { "\\" }, StringSplitOptions.RemoveEmptyEntries)
                                                        .Select(part => part.Trim('/'))
                                                        .ToList(); // Convert to a list to easily check for elements

                                            var imgpath = parts.Any() ? "/" + parts.Aggregate((current, next) => current + "/" + next) : string.Empty;


                                            if (imgcount == 1)
                                            {
                                                @*<img src="@item.IMG_PATH" height="100" width="100" />*@
                                                <a href="@imgpath" data-lightbox="image-@item.ACHIEVEMENT_ID" data-title="Image @item.ACHIEVEMENT_ID">

                                                    <img src="@imgpath" class="" alt="..." height="100" width="100">
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@imgpath" data-lightbox="image-@item.ACHIEVEMENT_ID" data-title="Image @item.ACHIEVEMENT_ID" class="hidden">

                                                    <img src="@imgpath" class="" alt="..." height="100" width="100">
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (item.FILE_PATH != null && item.FILE_PATH != "")
                                        {
                                            <a href="@item.FILE_PATH" target="_blank"><i class="fa fa-file-pdf-o" style="font-size:48px;color:red"></i></a>
                                        }
                                        else
                                        {
                                            <a href="#" target="_blank"></a>
                                        }
                                    </td>

                                    <td>@item.FIRST_NAME</td>
                                    @if (item.APPROVE_LEVEL1 == "0")
                                    {
                                        <td><button onclick="updateApprovStatus('@item.ACHIEVEMENT_ID', '1')" class="bg-success table-hover approvBtn">Approve</button> <button class="bg-danger Cancelbtn" onclick="updateApprovStatus('@item.ACHIEVEMENT_ID', '2')">Cancel</button></td>
                                    }
                                    else if (item.APPROVE_LEVEL1 == "1")
                                    {
                                        <td>
                                            <p>Approved</p>
                                        </td>
                                    }
                                    else if (item.APPROVE_LEVEL1 == "2")
                                    {
                                        <td>
                                            <p>Canceled</p>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                        </td>
                                    }
                                    @if (item.APPROVE_LEVEL1 == "2")
                                    {
                                        <td>
                                        </td>
                                    }
                                    else if (item.APPROVE_LEVEL1 == "1")
                                    {
                                        <td>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <a href="#HomeAchievement-dialog" onclick="FetchAchievementById(@item.ACHIEVEMENT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        </td>
                                    }
                                    <td>@item.TITLE</td>
                                     <td>
                                         @{
                                             var descRaw = item.DESCRIPTION ?? "";
                                             var plainText = System.Text.RegularExpressions.Regex.Replace(descRaw, "<.*?>", string.Empty).Replace("&nbsp;", " ").Trim();
                                             if (plainText.Length > 200)
                                             {
                                                 var truncated = plainText.Substring(0, 200) + "...";
                                                 <span>@truncated</span>
                                                 <a href="javascript:;" class="text-primary view-full-desc-btn" style="margin-left: 5px; font-weight: bold;">(View All)</a>
                                                 <div class="hidden-full-desc" style="display:none;">@Html.Raw(descRaw)</div>
                                             }
                                             else
                                             {
                                                 @Html.Raw(descRaw)
                                             }
                                         }
                                     </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <br />
                <div class=" text-center bg-warning">

                    <h3>No Records Found </h3>
                    <br />
                </div>
            }
            <div class="modal fade" id="HomeAchievement-dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                            <h4 class="modal-title">Add/Edit Campus News</h4>
                        </div>
                        <div class="modal-body" data-parsley-validate="true" id="IQACProject">
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label class="control-label">Organizing Unit</label>
                                    <div>
                                        @Html.DropDownListFor(m => m.sDepartmentList, (Model.sDepartmentList != null) ? Model.sDepartmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(m => m.sDepartmentList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="control-label">Category</label>
                                    <div>
                                        @Html.DropDownListFor(m => m.sAchievement, (Model.sAchievement != null) ? Model.sAchievement : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(m => m.sAchievement, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="control-label">SDG</label>
                                    <div>
                                        @Html.DropDownListFor(m => m.sSdgList, (Model.sSdgList != null) ? Model.sSdgList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(m => m.sSdgList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 form-group hidden" id="dvStaffList">
                                    <label class="control-label">Staff List</label>
                                    <div>
                                        @Html.DropDownListFor(m => m.sStaffList, (Model.sStaffList != null) ? Model.sStaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @multiple = "multiple", @data_action_box = "true" })
                                        @Html.ValidationMessageFor(m => m.sStaffList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-8 form-group">
                                    <label class="control-label">Title</label>
                                    <div>
                                        <input type="text" id="txtATitle" class="form-control" placeholder="Event Title" data-parsley-required="true" data-parsley-maxlength="100">
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="control-label">Date</label>
                                    <div>
                                        <input type="text" id="txtDate" class="datepicker date form-control" data-parsley-required="true" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 form-group">
                                    <label class="control-label">Description (Report)</label>
                                    <div>
                                        <textarea id="txtDescription" class="summernote form-control" name="content"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Link</label>
                                    <div>
                                        <input type="text" id="link" class="form-control" placeholder="Event Link">
                                    </div>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Link Text</label>
                                    <div>
                                        <input type="text" id="linkText" class="form-control" placeholder="Enter Link Text">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Image Upload</label>
                                    <div>
                                        <div class="btn btn-primary" onclick="ImageClick('imageUpload')"> <i class="fa fa-plus"></i> Select Image</div>
                                        <input type="file" id="imageUpload" class="hidden" multiple="multiple" onchange="LoadImage('dvImageUpload', 'imageUpload')" />
                                    </div>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label">File Upload</label>
                                    <div>
                                        <div class="btn btn-primary" onclick="FileClick('ActivityUpload')"> <i class="fa fa-plus"></i> Select File</div>
                                        <input type="file" id="ActivityUpload" class="hidden" multiple="multiple" onchange="LoadFile('dvActivityUpload', 'ActivityUpload')" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group hidden" id="dvImageUpload">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover" id="tbl_imageUpload">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>File</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbimageUpload"></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-6 form-group hidden" id="dvActivityUpload">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover" id="tbl_ActivityUpload">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>File</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbActivityUpload"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary">Submit</a>
                            <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                        </div>
                    </div>
                    <input type="hidden" id="AchievementID" value="" />
                </div>
            </div>

            <!-- Modal for Full Description View -->
            <div class="modal fade" id="fullDescriptionModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content" style="border-radius: 6px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                        <div class="modal-header" style="background-color: #fafafa; border-bottom: 1px solid #eaeaea;">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                            <h4 class="modal-title" style="font-weight: 600; color: #333;">Description Details</h4>
                        </div>
                        <div class="modal-body" id="fullDescriptionContent" style="max-height: 550px; overflow-y: auto; padding: 24px; line-height: 1.6; font-size: 14px; color: #444;">
                            <!-- Full description HTML will be dynamically inserted here -->
                        </div>
                        <div class="modal-footer" style="background-color: #fafafa; border-top: 1px solid #eaeaea;">
                            <button type="button" class="btn btn-sm btn-default" data-dismiss="modal" style="border-radius: 4px; padding: 6px 12px;">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/js/lightbox.min.js"></script>

<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script>
    $('#txtDescription').summernote({
        height: 450,                    // set editor height
        minHeight: null,                // set minimum height of editor
        maxHeight: null,                // set maximum height of editor
        focus: true,                    // set focus to editable area after initializing summernote
        callbacks: {
            onImageUpload: function (files) {
                for (let i = 0; i < files.length; i++) {
                    UploadImage(files[i]);
                }
            }
        }
    });
    var formData = new FormData();


    $(document).ready(function () {
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');

        $("#tblAchievementList").DataTable({
            dom: "lBfrtip", buttons: [{
                extend: "copy", className: "btn-sm"
            }
                , {
                extend: "excel", className: "btn-sm"
            }
                , {
                extend: "pdf", className: "btn-sm"
            }
            ], responsive: !0, "paging": true, "ordering": true
        });

        $(document).on('click', '.view-full-desc-btn', function () {
            var fullHtml = $(this).siblings('.hidden-full-desc').html();
            $('#fullDescriptionContent').html(fullHtml);
            $('#fullDescriptionModal').modal('show');
        });
    });

    function updateApprovStatus(achivementId, approveStatus) {
        swal({
            title: "Are you sure?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
            function () {

                $.ajax({
                    url: '@Url.Action("AchievementStatusUpdate", "Website")',
                    method: 'POST',
                    data: { sAchieveId: achivementId, approveStatus: approveStatus },
                    //data: JSON.stringify({ sAchieveId: achivementId, approveStatus: approveStatus }), // Serialize the data
                    async: false,
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {
                            if (data.ErrorCode == "200") {

                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });

                                loadContent('/Website/AchievementsListforApproval1');
                            }
                            if (data.ErrorCode == "417") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                            if (data.ErrorCode == "503") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }
                            if (data.ErrorCode == "406") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }
                        }
                    },
                    error: function (error) {
                        alert('Internal Server Error !');
                        return false;
                    }
                });
            })
    };

</script>
<script>
    function FetchAchievementById(sAchievement) {
    //$('#pBody').parsley().destroy();

    if (sAchievement != null) {
        $.ajax({

             url: '@Url.Action("FetchAchievementsById", "Website")',
            type: "POST",
            datatype: 'json',
            data: { sAchievement: sAchievement },
            success: function (data) {
                if (data.Message != null) {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                }
                else {
                    if (data[0] != null) {
                        $('#txtDate').attr('value', data[0].DATE);
                        $('#sDepartmentList option[value="' + data[0].DEPARTMENT_ID + '"]').attr("selected", "selected");
                        $('#sAchievement option[value="' + data[0].ACHIEVEMNT_CATEGORY + '"]').attr("selected", "selected");
                        $('#AchievementID').attr('value', data[0].ACHIEVEMENT_ID);
