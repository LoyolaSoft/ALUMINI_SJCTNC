
@model CMS.ViewModel.ViewModel.WebsiteViewModel
@using CMS.Utility
@{
    ViewBag.Title = "AchievementsList";
    Layout = null;
}
<style>
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    #btnImage {
        border: 1px solid gray;
        color: gray;
        background-color: white;
        padding: 7px 15px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Website</a></li>
        <li class="active">Campus News</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Campus News<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Campus News</h4>
        </div>
        <div class="panel-body">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#HomeAchievement-dialog" onclick="Add()" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            @if (Model.liWebsiteEvent != null && Model.liWebsiteEvent.Count > 0)
            {
                var count = 0;
                <div class="form-group col-md-12 table-responsive">
                    <table class="table table-hover table-bordered" id="tblAchievementList">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Department  </th>
                                <th> Category</th>
                                <th>Date</th>
                                <th>Image</th>
                                <th>Descritpion</th>
                                <th>Approver 1</th>
                                <th>Approver 2</th>
                                @*<th>Approver 3</th>*@
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>


                            @foreach (var item in Model.liWebsiteEvent)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>


                                    <td>@item.DEPARTMENT</td>
                                    <td>@item.ACHIEVEMENT_NAME</td>
                                    <td>@item.DATE</td>
                                    <td><img src="@item.IMG_PATH" height="100" width="100" /> </td>

                                    <td>@item.DESCRIPTION</td>
                                    @if (item.APPROVE_LEVEL1 == "0")
                                    {
                                        <td>Pending</td>
                                    }
                                    else if (item.APPROVE_LEVEL1 == "1")
                                    {
                                        <td>Approved</td>
                                    }
                                    else if (item.APPROVE_LEVEL1 == "2")
                                    {
                                        <td>Canceled</td>
                                    }
                                    @if (item.APPROVER_LEVEL2 == "0")
                                    {
                                        <td>Pending</td>
                                    }
                                    else if (item.APPROVER_LEVEL2 == "1")
                                    {
                                        <td>Approved</td>
                                    }
                                    else if (item.APPROVER_LEVEL2 == "2")
                                    {
                                        <td>Canceled</td>
                                    }
                                    @*@if (item.APPROVE_LEVEL1 == "0")
                                        {
                                            <td>Bending</td>
                                        }
                                        else if (item.APPROVE_LEVEL1 == "1")
                                        {
                                            <td>Approved</td>
                                        }
                                        else if (item.APPROVE_LEVEL1 == "2")
                                        {
                                            <td>Canceled</td>
                                        }*@

                                    @if (item.APPROVE_LEVEL1 == "0")
                                    {

                                        <td>

                                            <a href="#HomeAchievement-dialog" onclick="FetchAchievementById(@item.ACHIEVEMENT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                            <a href="javascrip:;" onclick="GetConfirm(@item.ACHIEVEMENT_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                </tr>
                            }



                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <br />
                <div class=" text-center bg-warning">

                    <h3>No Records Found </h3>
                    <br />
                </div>
            }

            <div class="modal" id="HomeAchievement-dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                            <h4 class="modal-title">Add/Edit Campus News</h4>
                        </div>
                        <div class="modal-body" data-parsley-validate="true" id="IQACProject">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="form-horizontal">
                                            <div class="col-md-12 form-horizontal">


                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Organizing  Unit</label>

                                                    <div class="col-md-8">
                                                        @Html.DropDownListFor(m => m.sDepartmentList, (Model.sDepartmentList != null) ? Model.sDepartmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                                        @Html.ValidationMessageFor(m => m.sDepartmentList, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Category</label>

                                                    <div class="col-md-8">
                                                        @Html.DropDownListFor(m => m.sAchievement, (Model.sAchievement != null) ? Model.sAchievement : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                                        @Html.ValidationMessageFor(m => m.sAchievement, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">SDG </label>

                                                    <div class="col-md-8">
                                                        @Html.DropDownListFor(m => m.sSdgList, (Model.sSdgList != null) ? Model.sSdgList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                                        @Html.ValidationMessageFor(m => m.sSdgList, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Title</label>

                                                    <div class="col-md-8">
                                                        <input type="text" id="txtATitle" class="form-control" placeholder="Event Tilte" data-parsley-required="true" data-parsley-maxlength="50">
                                                    </div>
                                                </div>

                                                <div class="col-md-12 form-group">
                                                    @Html.Label(" Date", htmlAttributes: new { @class = "control-label col-md-4" })
                                                    <div class="col-md-8">
                                                        <input type="text" id="txtDate" class="datepicker date form-control" data-parsley-required="true" />
                                                    </div>
                                                </div>

                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Description (Report)</label>

                                                    <div class="col-md-8">
                                                        <textarea type="text" id="txtDescription" class="form-control" placeholder="Enter Description maxlength 300 only" data-parsley-required="true" data-parsley-maxlength="300"></textarea>
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-12">
                                                    <label class="control-label col-md-4"></label>
                                                    <div class="col-md-8">
                                                        <div class="fileupload fileupload-new" data-provides="fileupload">
                                                            <div class="fileupload-new thumbnail" style="width: 150px; height: 190px;">
                                                                <img src="" id="img" style="width: 140px; height: 185px;" accesskey=".jpg,.jpeg,.png" />
                                                            </div>
                                                            <div class="upload-btn-wrapper">
                                                                <button class="btn" id="btnImage">Select Image</button>
                                                                <input type="file" class="btn bg-purple" name="image" id="inputimg" onchange="encodeImagetoBase64(this)" accept=".jpg,.png,.jpeg">
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary">Submit</a>
                            <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                        </div>
                    </div>
                    <input type="hidden" id="AchievementID" value="" />
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {

    }
     function loadContent() {
    $.ajax({
        url: '@Url.Action("_AchievementsList", "Website")',
        type: 'GET',
        success: function (data) {
            $('#achievementsListContainer').empty();
            $('#achievementsListContainer').html(data);
        },
        error: function () {
            alert('Failed to load content.');
        }
    });
}

    $(document).ready(function () {
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
    });
    function FetchAchievementById(sAchievement) {
        //$('#pBody').parsley().destroy();

        if (sAchievement != null) {
            $.ajax({

                 url: '@Url.Action("FetchAchievementsById", "Website")',
                type: "POST",
                datatype: 'json',
                data: { sAchievement: sAchievement },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    else {
                        if (data.oResult[0] != null) {
                            $('#txtDate').attr('value', data.oResult[0].DATE);
                            $('#txtDescription').attr('value', data.oResult[0].DESCRIPTION);
                            $('#sDepartmentList option[value="' + data.oResult[0].DEPARTMENT_ID + '"]').attr("selected", "selected");
                            $('#sAchievement option[value="' + data.oResult[0].ACHIEVEMNT_CATEGORY + '"]').attr("selected", "selected");
                            $('#AchievementID').attr('value', data.oResult[0].ACHIEVEMENT_ID);
                            $('#sSdgList').attr('value', data.oResult[0].SDG_ID);
                            $('#img').attr("src", data.oResult[0].IMG_PATH);
                            $('.selectpicker').selectpicker('refresh');

                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
    function SaveData() {
        var isValid = true;
        if ($('#IQACProject').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        //summernote
        var sAchieveId = $('#AchievementID').val();
        var sTitle = $('#txtATitle').val();
        var Department = $('#sDepartmentList').val();
        var SAcategory = $('#sAchievement').val();
        var date = $('#txtDate').val();
        var description = $('#txtDescription').val();
        var sdgList = $('#sSdgList').val();
            var fileData = new FormData();
            var fileUpload = $("#inputimg").get(0);
            var files = fileUpload.files;
            fileData.append('photo', files[0]);

            var EventImage = $('#img').attr('src');
        var sJsonData = '{"ACHIEVEMENT_ID":"' + sAchieveId + '","ACHIEVEMNT_CATEGORY":"' + SAcategory + '","DEPARTMENT":"' + Department + '","DATE":"' + date + '","DESCRIPTION":"' + description + '","TITLE":"' + sTitle + '","SDG_ID":"' + sdgList + '"}';

            fileData.append('jsonData', sJsonData);

            $.ajax({
                url: '@Url.Action("SaveHomeAchievements", "Website")',
                method: 'POST',
                contentType: false, // Not to set any content header
                processData: false,
                data: fileData,
                async: false,
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        if (data.ErrorCode == "200") {
                            $('#btnCancel').click();
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadContent();
                        }
                        if (data.ErrorCode == "417") {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        if (data.ErrorCode == "503") {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "406") {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }

                    }


                },
                error: function (error) {
                    alert('Internal Server Error !');
                    return false;
                }
            });
    };


    GetConfirm = function (sProjectId) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


            function () {
                $.ajax({
                    url: "/Website/DeleteAchievements",
                    type: "post",
                    data: { sAchieve: sProjectId },
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            LoadPage();
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }


                });
            });

    }

    function Add() {
        nFileCount = 0; nCount = 0;
        //$('#pBody').parsley().destroy();

        $('#txtDate').attr('value', '');
        $('#txtDescription').attr('value', '');
        $('#AchievementID').attr('value', '');
        $('#txtATitle').attr('value', '');
        $('#sdgList').attr('value', '');
        $('#img').attr('value', '');
        $('#inputimg').attr('value', '');
        $('#sAchievement option[value=""]').attr("selected", "selected");
        $('#sDepartmentList option[value=""]').attr("selected", "selected");
        $('.selectpicker').selectpicker('refresh');
    }


</script>
<script>
 

    var baseimage64;
    var extension;
    function encodeImagetoBase64(element) {
        if (element != null && element != "") {
            var file = element.files[0];
            extension = String(file.value).substr(String(file.value).lastIndexOf('.') + 1);
            var reader = new FileReader();
            reader.onloadend = function () {

                $(".link").attr("href", reader.result);

                $(".link").text(reader.result);

                $('#img').attr("src", reader.result);
                //only this is required to send file in ajax
                baseimage64 = reader.result;
            }


        }
        //this is method call
        reader.readAsDataURL(file);
    }
    function getBase64AndExtension() {
        var file = String($('#inputimg').val());
        extension = file.split('.').pop();
        return { base64String: baseimage64, sextension: extension }
    }

</script>









