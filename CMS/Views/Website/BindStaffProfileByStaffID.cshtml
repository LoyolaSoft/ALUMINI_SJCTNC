<script>
    var croppieInstance = null;

    function initCroppie(imageSource) {
        if (croppieInstance) {
            croppieInstance.destroy();
        }

        var containerWidth = $('#croppie-viewport-container').width();
        var boundaryWidth = containerWidth > 350 ? 350 : containerWidth - 20;
        var viewportSize = boundaryWidth - 100;
        if (viewportSize < 200) viewportSize = 200;
        if (boundaryWidth < viewportSize + 40) boundaryWidth = viewportSize + 40;

        croppieInstance = new Croppie(document.getElementById('croppie-viewport'), {
            viewport: { width: viewportSize, height: viewportSize, type: 'square' },
            boundary: { width: boundaryWidth, height: boundaryWidth + 50 },
            showZoomer: true,
            enableOrientation: true,
            mouseWheelZoom: 'ctrl'
        });

        croppieInstance.bind({
            url: imageSource
        });
    }

    function cropImage() {
        if (croppieInstance) {
            croppieInstance.result({
                type: 'base64',
                size: { width: 400, height: 400 }, // Output size
                format: 'jpeg',
                quality: 0.9
            }).then(function (base64) {
                $('#img').attr('src', base64).show();
                $('#PHOTO').val(base64); // Send this to backend
                $('#dragDropZone .upload-icon, #uploadText').hide();
                $('#photoActions').show();
                $('#cropModal').modal('hide');
                
                // Keep the raw baseimage64 for any other legacy use
                baseimage64 = base64;
            });
        }
    }

    // Override encodeImagetoBase64 to open modal
    function encodeImagetoBase64(element) {
        if (element != null && element.files && element.files[0]) {
            var file = element.files[0];
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#cropModal').modal('show');
                // The modal needs to be fully shown before initializing Croppie
                setTimeout(function() {
                    initCroppie(e.target.result);
                }, 300);
            }
            reader.readAsDataURL(file);
        }
    }
</script>


