        function updateExperienceBadge(dateStr) {
            if (dateStr) {
                var parts = dateStr.split('/');
                if (parts.length === 3) {
                    var joinDate = new Date(parts[2], parts[1] - 1, parts[0]);
                    var today = new Date();
                    
                    var totalMonths = (today.getFullYear() - joinDate.getFullYear()) * 12 + (today.getMonth() - joinDate.getMonth());
                    if (today.getDate() < joinDate.getDate()) {
                        totalMonths--;
                    }
                    
                    if (totalMonths >= 0) {
                        var expYears = Math.floor(totalMonths / 12);
                        var expMonths = totalMonths % 12;
                        
                        var textParts = [];
                        if (expYears > 0) textParts.push(expYears + (expYears === 1 ? " Year" : " Years"));
                        if (expMonths > 0) textParts.push(expMonths + (expMonths === 1 ? " Month" : " Months"));
                        
                        var text = textParts.length > 0 ? textParts.join(" ") + " Experience" : "New Joinee";
                        $("#YEARS_OF_EXPERIENCE_BADGE").text(text).removeClass("hidden");
                    } else {
                        $("#YEARS_OF_EXPERIENCE_BADGE").text("Future Joining date").removeClass("hidden");
                    }
                }
            } else {
                $("#YEARS_OF_EXPERIENCE_BADGE").addClass("hidden");
            }
        }

