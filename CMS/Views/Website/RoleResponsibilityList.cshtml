@model CMS.ViewModel.ViewModel.WebsiteViewModel
@{
    ViewBag.Title = "RoleResponsibilityList";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Website</li>
    </ol>
    <h1 class="page-header">Staff Role Responsibility List </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Staff Role Responsibility List </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Responsibilities</th>
                            <th>Active</th>
                            <th>Order By</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liRoleResponsibility != null)
                        {
                            var count = 0;
                            foreach (var item in Model.liRoleResponsibility)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.ROLES__RESPONSIBILITIES</td>
                                    <td>
                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;"><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;"><i class="fa fa-times text-danger"></i></a>
                                        }
                                    </td>
                                    <td>@item.ORDER_BY</td>
                                    <td>
                                        <a href="#Rules-dialog" onclick="FetchStaffRoleResponsibilities('@item.STF_ROLE_RES_ID')" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" onclick="GetConfirm('@item.STF_ROLE_RES_ID')" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="hidden" id="STF_ROLE_RES_ID" value="" />
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Responsibilities", htmlAttributes: new { @class = "col-md-3 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="text" id="ROLES__RESPONSIBILITIES" required />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Order By", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="number" id="orderby" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <div class="col-md-9 col-md-offset-3">
                                            <input type="checkbox" id="chIsActive" /> &nbsp; &nbsp; Is Active
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        $('#tblcer').DataTable({});
    });

    $('#btnSubmit').on('click', function () {
        if ($('#pBody').parsley().validate() !== true) {
            myAlert('Something went wrong! Please check your inputs!', 'gritter-warning', '');
            return false;
        }

        var postData = {
            STF_ROLE_RES_ID: $("#STF_ROLE_RES_ID").val(),
            ROLES__RESPONSIBILITIES: $('#ROLES__RESPONSIBILITIES').val(),
            IS_ACTIVE: $('#chIsActive').is(':checked') ? 1 : 0,
            ORDER_BY: $('#orderby').val()
        };

        $.ajax({
            url: '@Url.Action("SaveRoleResponsibility", "Website")',
            method: 'POST',
            data: { category: JSON.stringify(postData) },
            success: function (data) {
                if (data.ErrorCode != null && data.ErrorCode == "402") {
                    swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                } else {
                    swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    $('#Rules-dialog').modal('hide');
                    loadContent('/Website/RoleResponsibilityList');
                }
            },
            error: function () {
                swal({ title: "Error..!!", text: "Internal Server Error", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });
    });

    function FetchStaffRoleResponsibilities(RuleId) {
        $('#pBody').parsley().destroy();
        if (RuleId != null) {
            $.ajax({
                url: "@Url.Action("FetchStaffRoleResponsibilities", "Website")",
                type: "post",
                data: { STF_ROLE_RES_ID: RuleId },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }
                    else if (data.oResult && data.oResult.length > 0) {
                        var res = data.oResult[0];
                        $('#STF_ROLE_RES_ID').val(res.STF_ROLE_RES_ID);
                        $('#ROLES__RESPONSIBILITIES').val(res.ROLES__RESPONSIBILITIES);
                        $('#orderby').val(res.ORDER_BY);
                        $("#chIsActive").prop("checked", res.IS_ACTIVE == "1");
                    }
                },
                error: function () {
                    swal({ title: "Error..!!", text: "Failed to fetch data.", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            });
        }
    }

    function GetConfirm(ID) {
        swal({
            title: "Are you sure want to Delete..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("DeleteStaffRoleResponsibilities", "Website")",
                type: "post",
                data: { STF_ROLE_RES_ID: ID },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode == "402") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Website/RoleResponsibilityList');
                    }
                },
                error: function () {
                    swal({ title: "Error..!!", text: "Internal Server Error", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            });
        });
    }

    $("#Add").on('click', function () {
        $('#STF_ROLE_RES_ID').val('');
        $('#ROLES__RESPONSIBILITIES').val('');
        $('#orderby').val('');
        $("#chIsActive").prop("checked", false);
        $('#pBody').parsley().destroy();
    });
</script>
