
@model CMS.ViewModel.ViewModel.StaffViewModel

@{
    Layout = null;

}
<style>
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    #btnImage {
        border: 1px solid gray;
        color: gray;
        background-color: white;
        padding: 7px 15px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }

    .approvBtn {
        border-radius: 5px;
        border: 2px solid lightgrey;
        padding: 3px;
        color: black;
        margin: 10px;
    }

    .Cancelbtn {
        border-radius: 5px;
        border: 2px solid lightgrey;
        padding: 3px;
        color: black;
        margin-left: 10px;
    }

    .img-thumb {
        padding: 4px;
        line-height: 1.42857143;
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        -webkit-transition: all .2s ease-in-out;
        transition: all .2s ease-in-out;
        display: inline-block;
        max-width: 100%;
        height: 80px;
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/css/lightbox.min.css">
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Website</a></li>
        <li class="active">Faculty Profile Approval Page</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Faculty Profile Approval Page<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Faculty Profile Approval Page</h4>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DepartmentList, "Department", htmlAttributes: new { @class = "control-label col-md-4 complusary" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker form-control input-sm ", @data_live_search = "true", @data_parsley_required = "true", @id = "DEPARTMENT", @multiple = "multiple", @data_actions_box = "true" })

                            @Html.ValidationMessageFor(model => model.DepartmentList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div id="binddefaultData">
                @if (Model.liStfProfie != null && Model.liStfProfie.Count > 0)
                {
                    var count = 0;
                    <div class="form-group col-md-12 table-responsive">
                        <table class="table table-hover table-bordered" id="tblStaffList">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Staff Name</th>
                                    <th>Image</th>
                                    <th>Department</th>
                                    <th>Qualification</th>
                                    <th>Contact No</th>
                                    <th>Last Update Date</th>
                                    <th>Approver Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.liStfProfie)
                                {
                                    count = count + 1;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.STAFF_NAME</td>
                                        <td>
                                            <img src="@item.PHOTO" itemprop="thumbnail" class="img-thumb" alt="@item.STAFF_ID Icon" onerror="this.onerror=null;this.src='@Url.Content("~/Content/assets/img/transparent/e-user.jpg")';" />
                                        </td>
                                        <td>@item.DEPARTMENT</td>
                                        <td>@item.QUALIFICATION</td>
                                        <td>@item.CONTACT_NO</td>
                                        <td>@item.LAST_UPDATE_DATE</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.PROFILE_ID))
                                            {
                                                if (item.IS_SHOW_WEBSITE == "1")
                                                {
                                                    <i class="label label-success" onclick="SetDeActive(@item.PROFILE_ID)">Yes</i>
                                                }
                                                else
                                                {
                                                    <i class="label label-danger" onclick="SetActive(@item.PROFILE_ID)">No</i>
                                                }
                                            }
                                            else
                                            {
                                                <i class="label label-warning"> Yet Not Update</i>
                                            }
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <br />
                    <div class=" text-center bg-warning">
                        <h3>No Records Found </h3>
                        <br />
                    </div>
                }

            </div>
           
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/js/lightbox.min.js"></script>

<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>


<script type="text/javascript">
    $(document).ready(function () {

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');

        $("#tblStaffList").DataTable({
            dom: "lBfrtip", buttons: [{
                extend: "copy", className: "btn-sm"
            }
                , {
                extend: "excel", className: "btn-sm"
            }
                , {
                extend: "pdf", className: "btn-sm"
            }
            ], responsive: !0, "paging": false, "ordering": true
        });
    });
    $('#DEPARTMENT').on('change', function () {
        var departmentId = String($(this).val());
        if (departmentId != "") {
            $.ajax({
                url: '@Url.Action("GetStaffProfileApprovalListByDeptID", "Website")',
                type: 'POST',
                dataType: 'html',
                data: { departmentId: departmentId },
                success: function (data) {
                    $("#binddefaultData").empty();
                    $("#binddefaultData").append(data);
                    $("#tblStaffList").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                            , {
                            extend: "excel", className: "btn-sm"
                        }
                            , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": false, "ordering": true
                    });
                },
                error: function (error) {
                    swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                }
            });
        } else {
            $('#tblStaffList').DataTable().clear().draw();
        }


    });
    function SetActive(ID)
    {
                swal({
                    title: "Are you sure?",
                    text: "Are you sure to Approval. ?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "btn-danger",
                    confirmButtonText: "Yes, Approval it!",
                    closeOnConfirm: false
                },
                    function () {
                $.ajax({
                    url: "@Url.Action("StaffProfileApprovalStatusUpdate", "Website")",
                    method: "POST",
                    datatype: "json",
                    data: { sProfileId: ID, approveStatus: '1' },
                    success: function (data) {
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                            loadContent('/Website/StaffProfileApproval');

                        }
                        else {

                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                        }
                    }, error: function (error) {

                        swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
}
                });

        });

}

// De - Activate Setting ...
function SetDeActive(ID)
{
            swal({
                title: "Are you sure?",
                text: "Are you sure to Cancel. ?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, Cancel it!",
                closeOnConfirm: false
            },
                function () {

            $.ajax({
                url: "@Url.Action("StaffProfileApprovalStatusUpdate", "Website")",
                method: "POST",
                datatype: "json",
                data: { sProfileId: ID, approveStatus: '0' },
                success: function (data) {
                    if (data.ErrorCode == "200") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                        loadContent('/Website/StaffProfileApproval');
                    }
                    else {

                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                    }
                }, error: function (error) {
                    swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                }
            });

    });
    }
</script>








