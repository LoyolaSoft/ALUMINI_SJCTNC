

@model CMS.ViewModel.ViewModel.WebsiteViewModel
@using CMS.Utility
@{
    ViewBag.Title = "";
    Layout = null;
}
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Website</a></li>
        <li class="active">Guideline</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Guideline<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand" title="Expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload" title="Reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse" title="Collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove" title="Remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Guideline</h4>
        </div>
        <div class="panel-body">


            <h3 class="panel-title">Guidelines for Submitting a Report</h3>

            <div class="panel-body">
                <div class="guidelines-content">
                    <p><strong>To submit a report to the website, please follow these steps:</strong></p>
                    <ol class="steps">
                        <li>Login to <a href="https://erp.sjctnc.edu.in/" target="_blank">https://erp.sjctnc.edu.in/</a></li>
                        <li>In your side panel, find the <strong>WEBSITE</strong> tab.</li>
                        <li>Click on the <strong>WEBSITE</strong> tab and select the <strong>CAMPUS NEWS</strong> page.</li>
                        <li>Click on <strong>Add</strong> to open a pop-up menu and fill out the form:</li>
                        <ul class="form-details">
                            <li><b>a. Organizing Unit:</b> Department or club that organizes the function.</li>
                            <li><b>b. Category:</b> Refers to the type of event.</li>
                            <li><b>c. SDG:</b> Refers to sustainable development goals. Choose a goal aligned with the event. Select N/A if not applicable or Unknown.</li>
                            <li><b>d. Title:</b> Should be short and concise.</li>
                            <li><b>e. Date:</b> Specify the opening date (for multi-day events).</li>
                            <li>
                                <b>f. Description:</b> Be concise and limit your report to 2000 characters (~200 words)
                                .
                            </li>
                            <li><b>g. Photograph:</b> Avoid posting on-stage photos. Showcase resource persons interacting with students.</li>
                            <ul class="photo-guidelines">
                                <li><b>Maximum Number of Photos: </b> 5 (Adding photo is mandatory)</li>
                                <li><b>Photo Format: </b> Jpg or Png or jpeg</li>
                                <li><b>Photo Name: </b>  Please keep the name short For Example: 28022024ypp1.jpg</li>
                                <li><b>Maximum Dimensions:</b>  3000x3000</li>
                                <li><b>Maximum Size:</b> 2MB</li>
                            </ul>
                            <li><b>h. Faculty Achievements and Publications:</b> You can select multiple faculty members.</li>
                            <li><b>i. Files:</b> Add PDF versions of your article.</li>
                        </ul>
                        <li>Once you have completed the form, click <strong>Submit</strong>.</li>
                        <li>Your submission will be published after approval. You can check the status on the ERP portal.</li>
                    </ol>

                    .
                </div>
            </div>
        </div>

        <style>
            /* Styling for the panel */
            #guidelines-panel {
                border-radius: 6px;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            }

            .panel-heading {
                background-color: #5bc0de;
                color: white;
                padding: 10px 15px;
                border-radius: 6px 6px 0 0;
            }

            .panel-title {
                font-size: 1.5rem;
                margin: 0;
            }

            /* Guidelines content styling */
            .guidelines-content {
                padding: 20px;
                font-size: 1.4rem;
                line-height: 1.8;
            }

                .guidelines-content ol.steps {
                    padding-left: 20px;
                }

                    .guidelines-content ol.steps li {
                        margin-bottom: 10px;
                    }

                .guidelines-content ul.form-details {
                    list-style-type: none;
                    padding-left: 40px;
                    margin-bottom: 20px;
                }

                .guidelines-content ul.photo-guidelines {
                    list-style-type: disc;
                    padding-left: 60px;
                }

                /* Link styling */
                .guidelines-content a {
                    color: #337ab7;
                    text-decoration: underline;
                }

                    .guidelines-content a:hover {
                        text-decoration: none;
                    }

            /* Responsive design for smaller screens */
            @@media (max-width: 768px) {
                .guidelines-content {
                    font-size: 1.3rem;
                }

                .panel-title {
                    font-size: 1.5rem;
                }
            }
        </style>


