@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{
    ViewBag.Title = "CiaBlockList";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active"> CIA Block List </li>
    </ol>
    <h1 class="page-header"> CIA Block List </h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> CIA Block List</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">
                <div class="col-md-5 form-group">
                    <label class="col-md-4 control-label">CIA Block List </label>
                    <div class="col-md-8">
                        <select class="selectpicker form-control" id="CIABlockListDDL" data-live-search="true">
                            <option value=""> -- Select -- </option>
                            <option value="1"> Class Course Staff </option>
                            <option value="2"> Programme </option>
                            <option value="3"> Programme Level (UG/PG) </option>
                            <option value="4"> Shift </option>
                            <option value="5"> Class </option>
                            <option value="6"> Course </option>
                            <option value="7"> Staff </option>
                        </select>
                    </div>
                </div>
                <div class="col-md-1 form-group">
                    <button class="btn btn-primary pull-right" id="btnGet"> Get </button>
                </div>
                <div id="dvCIABlockList"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        // Change Active 
        function ActiveCIABlockList(ID)
        {
            if (ID != null && ID != '')
            {
                if (!confirm('Are you sure to change this  ?'))
                {
                    return false;
                }
                $.ajax({
                    url: "@Url.Action("ActiveCIABlockList", "TaskManagement")",
                    method: "POST",
                    datatype: "json",
                    data: { sCIABlockListId: ID, sActive :"1"},
                    success: function (data)
                    {
                        alert(data.Message);
                        FetchCIAList();
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }

        // Change To DeActive
        function DeActiveCIABlockList(ID)
        {
            if (ID != null && ID != '')
            {
                if (!confirm('Are you sure to change this  ?'))
                {
                    return false;
                }
                $.ajax({
                    url: "@Url.Action("ActiveCIABlockList", "TaskManagement")",
                    method: "POST",
                    datatype: "json",
                    data: { sCIABlockListId: ID, sActive :"0"},
                    success: function (data)
                    {
                        alert(data.Message);
                        FetchCIAList();
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
        // Delete Function 
        function Deleteconfirm(ID)
        {
            if (ID != null && ID != '')
            {
                if (!confirm('Are you sure to Delete ?'))
                {
                    return false;
                }

                $.ajax({
                    url:'@Url.Action("DeleteCIABlockList", "TaskManagement")',
                    method:'POST',
                    datatype:'json',
                    data: { sCIABlockListId: ID },
                    success: function (data)
                    {
                        alert(data.Message);
                        FetchCIAList();
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
    </script>

    <script>

        // Fetch Cia List On Button Click
        function FetchCIAList()
        {
            if ($('#CIABlockListDDL').val())
            {
                $.ajax({
                    url:'@Url.Action("FetchCIAListByDDL", "TaskManagement")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sCIAId: $('#CIABlockListDDL').val() },
                    success: function (data)
                    {
                        $('#dvCIABlockList').empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#dvCIABlockList').append(data);
                            $("#tblCIABlockList").DataTable();
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }

        // Get Button Click To Fetch Records .
        $('#btnGet').on('click',function () 
        {
            if ($('#CIABlockListDDL').val())
            {
                FetchCIAList();
            } else
            {
                alert('Please Select Option To Continue !');
            }
           
        });
    </script>


