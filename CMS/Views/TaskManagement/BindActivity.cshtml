@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{ 
    Layout = null;
    int count = 0;
}

    <div class="col-md-12 table-responsive">
        <table class="table table-hover table-bordered" id="tblActivityList">
            <thead>
                <tr>
                    <th>#</th>
                    @*<th>Activity Level</th>*@
                    <th>Title</th>
                    <th>Description</th>
                    <th class="col-md-4">Name</th>
                    <th>Last Date</th>
                    <th>File</th>
                    <th>Image</th>
                    <th>Status</th>
                    <th>Active</th>
                    <th>Action</th>
                    <th>Notifications</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.liActivityList != null && Model.liActivityList.Count > 0)
                {
                    foreach (var item in Model.liActivityList)
                    {
                        <tr>
                            <td>@{count++;} @count</td>
                            @*<td>@item.ACTIVITY_LEVEL</td>*@
                            <td>@item.ACTIVITY_TITLE</td>
                            <td>@item.DESCRIPTION</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.SUBMISSION_DATE</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FILE_PATH))
                                {
                                    <a href="@item.FILE_PATH" title="view"><i class="ion-eye fa-2x" style="font-size: 17px;"></i> </a>
                                    <a href="@item.FILE_PATH" download title="download"> <i class="ion-android-download" style="font-size: 17px;"></i></a>
                                }
                                else
                                {
                                    <a href="javascript:;"><i class="ion-eye-disabled fa-2x" style="font-size: 17px;"></i> </a>
                                    <a href="javascript:;" download> <i class="ion-android-download" style="font-size: 17px;"></i></a>
                                }

                            </td>
                            <td><img src="@item.PHOTO_PATH" style="width:50px; height:50px;"/></td>
                            <td>@item.ACTIVITY_STATUS_NAME</td>
                            <td>
                                @if (item.IS_ACTIVE == "0")
                                {
                                    <a href="#"><i class="fa fa-close text-danger"></i></a>
                                }
                                else
                                {
                                    <a href="#"><i class="fa fa-check text-success"></i></a>
                                }
                            </td>
                            <td>
                                @if (item.STATUS != "4")
                                {
                                    <a href="javascript:;" onclick="loadContent('/TaskManagement/AcademicActivity?sActivityId=@item.ACTIVITY_ID')"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                    <a href="#" onclick="Deleteconfirm(@item.ACTIVITY_ID);"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                                }
                                @if (item.STATUS=="2")
                                {
                                    <br>

                                    <a href="#" onclick="ApproveActivity(@item.ACTIVITY_ID);" class="" title="Approve"><i class="icon ion-checkmark-circled"></i></a>
                                    <a  href="#modal-correction" data-toggle="modal" class="" title="File Correction" onclick="SendCorrection(@item.ACTIVITY_ID)"><i class="icon ion-chatbubble-working"></i></a>
                                }
                            </td>
                            <td>
    
   
    
        @if (item.FILE_CORRECTION_RETURN != "" && item.FILE_CORRECTION_RETURN != null)
        {

            <ul class="nav navbar-nav">

                <li class="dropdown" style="list-style:none;">
                    <a data-toggle="modal" class="dropdown-toggle icon" aria-expanded="false" href="#modal-correction_return" onclick="FetchCorrectionReturn(@item.ACTIVITY_ID)">
                        <i class="ion-android-notifications" style="font-size: 26px;"></i>

                        @if (item.FILE_CR_STATUS == "0")
                        {
                            <span class="label" id="sRemainder_@item.ACTIVITY_ID"></span>
                        }
                        else
                        {
                            <span class="label" id="sRemainder_@item.ACTIVITY_ID">1</span>
                        }

                    </a>
                </li>

            </ul>
        }
        else
        {
            <ul class="nav navbar-nav">
                <li>
                    <a href="javascript:;" onclick=""><i class="ion-android-notifications-off" style="font-size: 26px;"></i></a>
                </li>

            </ul>
        }
   
    
                            </td>
                        </tr>
                                        }
                                    }
            </tbody>
        </table>
    </div>


