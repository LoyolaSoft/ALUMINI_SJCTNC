@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{
    ViewBag.Title = "AddCiaBlockList";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <!-- ================== BEGIN PAGE CSS STYLE ================== -->
    <link href="~/Content/assets/plugins/switchery/switchery.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/powerange/powerange.min.css" rel="stylesheet" />
    <!-- ================== END PAGE CSS STYLE ================== -->

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a @*href="@Url.Action("CiaBlockList", "TaskManagement")"*@ href="javascript:;" onclick="loadContent('/TaskManagement/CiaBlockList')">CIA Block List</a></li>
        <li class="active">Add/Edit CIA Block List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Add/Edit CIA Block List<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Add/Edit CIA Block List</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

               <div class="col-md-12 form-horizontal">

                   <div class="col-md-4">
                       <table class="table table-bordered table-condensed m-b-0" id="tblCiaBlockList">
                           <thead>
                               <tr>
                                   <th>Cia Block List</th>
                                   <th class="col-md-1">Swither</th>
                               </tr>
                           </thead>
                           <tbody>
                               <tr>
                                   <td>Class Course Staff</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="black" id="1" name="CIA" value="1" /></td>
                               </tr>
                               <tr>
                                   <td>Programme Wise</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="purple" id="2" name="CIA" value="2" /></td>
                               </tr>
                               <tr>
                                   <td>Programme Level (UG/PG)</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="orange" id="3" name="CIA" value="3" /></td>
                                  
                               </tr>
                               <tr>
                                   <td>Shift</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="black" id="4" name="CIA" value="4" /></td>
                                   
                               </tr>
                               <tr>
                                   <td>Class Wise</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="red" id="5" name="CIA" value="5" /></td>
                                   
                               </tr>
                               <tr>
                                   <td>Course Wise</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="blue" id="6" name="CIA" value="6" /></td>
                                   
                               </tr>
                               <tr>
                                   <td>Staff Wise</td>
                                   <td><input type="checkbox" data-render="switchery" data-theme="default" id="7" name="CIA" value="7" /></td>
                                   
                               </tr>
                           </tbody>
                       </table>
                   </div>

                   <div class="col-md-8 hidden" id="dvControls">
                       <div class="form-group" id="Class">
                           @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                               @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                           </div>
                       </div>

                       <div class="form-group" id="course">
                           @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                               @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                           </div>
                       </div>

                       <div class="form-group" id="staff">
                           @Html.Label("Staff", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               @Html.DropDownListFor(m => m.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                               @Html.ValidationMessageFor(m => m.StaffList, "", new { @class = "text-danger" })
                           </div>
                       </div>

                       <div class="form-group" id="shift">
                           @Html.Label("Shift", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               @Html.DropDownListFor(m => m.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                               @Html.ValidationMessageFor(m => m.ShiftList, "", new { @class = "text-danger" })
                           </div>
                       </div>

                       <div class="form-group" id="programme">
                           @Html.Label("Programme", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                               @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                           </div>
                       </div>

                       <div class="form-group" id="programme_Level">
                           @Html.Label("Programme Level", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               @Html.DropDownListFor(m => m.ProgrammeLevel, (Model.ProgrammeLevel != null) ? Model.ProgrammeLevel : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                               @Html.ValidationMessageFor(m => m.ProgrammeLevel, "", new { @class = "text-danger" })
                           </div>
                       </div>

                       <!-- Class Course Staff-->
                       <div class="form-group hidden" id="ClassCourseStaff">

                           <!-- Class-->
                           <div class="form-group">
                               @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                               <div class="col-md-9">
                                   @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", id = "txtClass" })
                                   @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                               </div>
                           </div>
                           <!-- Class -->
                           <!-- Course -->
                           <div class="form-group">
                               @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label " })
                               <div class="col-md-9">
                                   @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", id = "txtCourse" })
                                   @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                               </div>
                           </div>
                           <!-- Course -->
                           <!-- Staff -->
                           <div class="form-group">
                               @Html.Label("Staff", htmlAttributes: new { @class = "col-md-3 control-label " })
                               <div class="col-md-9">
                                   @Html.DropDownListFor(m => m.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", id = "txtStaff" })
                                   @Html.ValidationMessageFor(m => m.StaffList, "", new { @class = "text-danger" })
                               </div>
                           </div>
                           <!-- Staff -->

                       </div>

                       <div class="form-group">
                           @Html.Label("Date From", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               <div class="input-group date" id="datetimepicker1">
                                   @Html.Editor("txtDateFrom", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                                   <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                               </div>
                           </div>
                       </div>

                       <div class="form-group">
                           @Html.Label("Date To", htmlAttributes: new { @class = "col-md-3 control-label " })
                           <div class="col-md-9">
                               <div class="input-group date" id="datetimepicker1">
                                   @Html.Editor("txtDateTo", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                                   <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                               </div>
                           </div>
                           
                       </div>

                      

                       <div class="form-group">
                           <div class="col-md-9 pull-right">
                               <div class="checkbox checkbox-css ">
                                   <input type="checkbox" id="IsActive" checked />
                                   <label for="IsActive">Is Active</label>
                               </div>
                           </div>
                       </div>
                       
                       <div class="form-group">
                           <div class="col-md-9 pull-right">
                               <a href="#" class="btn btn-primary" id="btnSubmit"> Submit </a>
                           </div>
                       </div>
                   </div>
               </div>

            }
            
        </div>

    </div>

</div>

<!-- Hidden Fields-->
<input type="text" id="hdCIABlockListId" class="hidden" value="@Model.ObjCIABlockList.CIA_BLOCK_ID" />
<!-- Hidden Fields-->




<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <!-- ================== BEGIN PAGE LEVEL JS ================== -->
<script src="~/Content/assets/plugins/switchery/switchery.min.js"></script>
<script src="~/Content/assets/plugins/powerange/powerange.min.js"></script>
<script src="~/Content/assets/js/form-slider-switcher.demo.min.js"></script>

<!-- ================== END PAGE LEVEL JS ================== -->
    <script>
        var CIABlockId = null;
        function ContentLoad()
        {
            // Document Ready Function .
            FormSliderSwitcher.init();
            if ($('#hdCIABlockListId').val())
            {
                $.ajax({
                    url: '@Url.Action("FetchCIABlockListById", "TaskManagement")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sCIABlockListId: $('#hdCIABlockListId').val() },
                    success: function (data) {
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#' + data[0].ORDER_ID).click();
                            CIABlockId = data[0].CIA_BLOCK_ID;
                            $('#txtStaff').val(data[0].STAFF_ID);
                            $('#txtCourse').val(data[0].COURSE_ID);
                            $('#txtClass').val(data[0].CLASS_ID);
                            $('#ProgrammeList').val(data[0].PROGRAMME_GROUP_ID);
                            $('#ProgrammeLevel').val(data[0].PROGRAMME_LEVEL);
                            $('#ShiftList').val(data[0].SHIFT_ID);
                            $('#ClassList').val(data[0].S_CLASS_ID);
                            $('#CourseList').val(data[0].S_COURSE_ID);
                            $('#StaffList').val(data[0].S_STAFF_ID);

                            $('#txtDateTo').val(data[0].DATE_FROM);
                            $('#txtDateFrom').val(data[0].DATE_TO);
                            if (data[0].IS_ACTIVE != "1") {
                                $('#IsActive').click();
                            }
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }
        }

       

        $('.selectpicker').selectpicker({
            size: 6
        });
        $("#txtDateFrom,#txtDateTo").datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
    </script>    

    <script>
        var Selected = 0;
        var Flag = 0;
        $("input[name='CIA']").on('change', function ()
        {
            if (Flag == 0) {

                
                $('#dvControls').removeClass('hidden');

                Selected = $(this).val();
                
                // Hide Controls ...
                $('#Class').addClass('hidden');
                $('#course').addClass('hidden');
                $('#staff').addClass('hidden');
                $('#shift').addClass('hidden');
                $('#programme').addClass('hidden');
                $('#programme_Level').addClass('hidden');
                $('#ClassCourseStaff').addClass('hidden');
                // End Hidden Controls 

                // Clear Values Of A Controls ..
                $('#txtDateTo').val('');
                $('#txtDateFrom').val('');
                $('#ProgrammeLevel').val('');
                $('#ProgrammeList').val('');
                $('#ShiftList').val('');
                $('#StaffList').val('');
                $('#CourseList').val('');
                $('#ClassList').val('');
                $('#txtStaff').val('');
                $('#txtCourse').val('');
                $('#txtClass').val('');

                $('.selectpicker').selectpicker('refresh');
                // End Clear Values Of A Controls ..

                // Class Course Staff
                if (Selected == "1") {
                    $('#ClassCourseStaff').removeClass('hidden');
                }
                    // Programme
                else if (Selected == "2") {
                    $('#programme').removeClass('hidden');
                }
                    // Programme level
                else if (Selected == "3") {
                    $('#programme_Level').removeClass('hidden');
                }
                    // Shift
                else if (Selected == "4") {
                    $('#shift').removeClass('hidden');
                }
                    // Class
                else if (Selected == "5") {
                    $('#Class').removeClass('hidden');
                }
                    // Course 
                else if (Selected == "6") {
                    $('#course').removeClass('hidden');
                }
                    // Staff
                else if (Selected == "7") {
                    $('#staff').removeClass('hidden');
                }

                $('#tblCiaBlockList tbody tr').each(function () {
                    if ($(this).find('input[type="checkbox"]').is(':checked')) {
                        if ($(this).find('input[type="checkbox"]').val() != Selected)
                        {
                            Flag = 1;
                            //$(switchElement).trigger('click').removeAttr("checked");
                            // $('#' + $(this).find('input[type="checkbox"]').val()).trigger('click').removeAttr("checked");
                            $(this).find('input[type="checkbox"]').click();
                            
                            // $(this).find('input[type="checkbox"]').attr('name', 'CIA');
                        }
                    }
                });
            } else {
                Flag = 0;
            }
            
        });
    </script>

    <script>
        // Class List Change ...
        $('#txtClass').on('change', function ()
        {           
            $.ajax({
                url: '@Url.Action("FetchCourseByClass", "TaskManagement")',
                method:'POST',
                datatype: 'json',
                data: { sClassId: $('#txtClass').val() },
                success: function (data)
                {
                    $('#txtCourse').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#txtCourse').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        });

        // Course List Change ...
        $('#txtCourse').on('change', function ()
        {
            if ($('#txtClass').val() && $('#txtCourse').val())
            {
                $.ajax({
                    url: '@Url.Action("FetchStaffByClassAndCourse", "TaskManagement")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sClassId: $('#txtClass').val(), sCourseId: $('#txtCourse').val() },
                    success: function (data)
                    {
                        $('#txtStaff').empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#txtStaff').append(data.sResult);
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            } else
            {
                alert('Please Select Class && Course !');
            }
            
        });


        // On Submit List ...
        $('#btnSubmit').on('click', function myfunction()
        {
            var JsonData = null;
            var IsActive=0;
            if ($('#IsActive').is(':checked'))
            {
                IsActive = 1;
            }
            if (CIABlockId != Selected )
            {
                CIABlockId = '';
            } 
            JsonData = '{"CIA_BLOCK_ID":"' + CIABlockId + '",\
                         "DATE_TO":"' + $('#txtDateTo').val() + '",\
                         "DATE_FROM":"' + $('#txtDateFrom').val() + '",\
                         "PROGRAMME_LEVEL":"' + $('#ProgrammeLevel').val() + '",\
                         "PROGRAMME_GROUP_ID":"' + $('#ProgrammeList').val() + '",\
                         "SHIFT_ID":"' + $('#ShiftList').val() + '",\
                         "S_STAFF_ID":"' + $('#StaffList').val() + '",\
                         "S_COURSE_ID":"' + $('#CourseList').val() + '",\
                         "S_CLASS_ID":"' + $('#ClassList').val() + '",\
                         "STAFF_ID":"' + $('#txtStaff').val() + '",\
                         "COURSE_ID":"' + $('#txtCourse').val() + '",\
                         "CLASS_ID":"' + $('#txtClass').val() + '",\
                         "ORDER_ID":"' + Selected + '",\
                         "IS_ACTIVE":"' + IsActive + '"}';
            if ($('#txtDateTo').val() && $('#txtDateFrom').val())
            {
                $.ajax({
                    url: '@Url.Action("SaveCIABlockList", "TaskManagement")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sSaveCIABlockList: JsonData },
                    success: function (data)
                    {
                        alert(data.Message);
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Please Select All The Value !');
            }
            
        });
    </script>
