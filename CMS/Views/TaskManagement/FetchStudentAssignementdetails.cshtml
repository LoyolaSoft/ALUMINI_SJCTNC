@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@*@{ int count = 0;}*@
@{ 
    Layout = null;
}
<div class="table-responsive">
    @if(Model.liTaskManagementModel!=null && Model.liTaskManagementModel.Count>0)
    {
        @Html.Hidden("studentid", Model.liTaskManagementModel.FirstOrDefault().STUDENT_ID);
        @Html.Hidden("assignmentid", Model.liTaskManagementModel.FirstOrDefault().ASSIGNMENT_ID);

        <div class="">
            <h4 style="text-align:center">Assignment Attachment</h4>
            <div class="alert alert-info">
                <a href="@Model.liTaskManagementModel.FirstOrDefault().FILE_PATH"><i class="fa fa-file fa-3x"></i></a>
                <a href="@Model.liTaskManagementModel.FirstOrDefault().FILE_PATH" target="- blank"><i class="glyphicon glyphicon-open" title="Open"></i></a>
                <a href="@Model.liTaskManagementModel.FirstOrDefault().FILE_PATH" download=""><i class="glyphicon glyphicon-download" title="Download"></i></a>
            </div>
            <br><br>
            <div class="form-group col-md-8">
                @Html.Label("Assignment Mark", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                 <input class="form-control" id="assignmentmark" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No Attachment File Found..!
        </div>
    }
</div>