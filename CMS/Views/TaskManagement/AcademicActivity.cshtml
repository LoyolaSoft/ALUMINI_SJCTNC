@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{
    ViewBag.Title = "AcademicActivity";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a @*href="@Url.Action("ListAcademicActivity","TaskManagement")"*@ href="javascript:;" onclick="loadContent('/TaskManagement/ListAcademicActivity')">List Activity </a></li>
            <li class="active">Edit Assignment </li>
        </ol>
        <h1 class="page-header">Assignment</h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Activity</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    <div class="col-md-12">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-md-6 col-md-offset-3">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Activity.ACTIVITY_TITLE, "Activity", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.Activity.ACTIVITY_TITLE, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Activity Title" } })
                                    @Html.ValidationMessageFor(model => model.Activity.ACTIVITY_TITLE, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ActivityLevelList, "Activity Level", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ActivityLevelList, (Model.ActivityLevelList != null) ? Model.ActivityLevelList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.ActivityLevelList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Activity.DESCRIPTION, "Description", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.Activity.DESCRIPTION, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Description" } })
                                    @Html.ValidationMessageFor(model => model.Activity.DESCRIPTION, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.StaffList, "In-charge", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5, @multiple = "multiple", @data_actions_box = "true" })
                                    @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Activity.SUBMISSION_DATE, "Submission Date", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker1">
                                        @Html.EditorFor(model => model.Activity.SUBMISSION_DATE, new { htmlAttributes = new { @class = "form-control", id = "SubmissionDate", placeholder = "Pick Submission Date" } })
                                        @Html.ValidationMessageFor(model => model.Activity.SUBMISSION_DATE, "", new { @class = "text-danger" })
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Is Active", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.CheckBox("Is_Active", Model.IS_ACTIVE, new { @class = "input-sm",id="IS_ACTIVE" })

                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Is File Upload", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.CheckBox("IS_FILE_UPLOAD", Model.IS_FILE_UPLOAD, new { @class = "input-sm" })

                                </div>
                            </div>

                            <div class="form-group">
                                <div class="pull-right">
                                    <a id="btnSubmit" value="SUBMIT" class="btn btn-primary">Submit</a>
                                    <a id="" @*href="@Url.Action("ListAcademicActivity","TaskManagement")"*@ href="javascript:;" onclick="loadContent('/TaskManagement/ListAcademicActivity')" value="" class="btn btn-danger">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Hidden Flieds-->
@Html.HiddenFor(model=>model.sActivityId)
<!-- Hidden Flieds-->

    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
            handleDatepicker();
            // Fetch Activity By Id For Edit .
            if ($('#sActivityId').val()) {
                $.ajax({
                    url: '@Url.Action("FetchActivityByActivityId", "TaskManagement")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sActivityId: $('#sActivityId').val() },
                    success: function (data) {
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        } else {
                            $('#sActivityId').val(data[0].ACTIVITY_ID);
                            $('#ActivityLevelList').val(data[0].ACTIVITY_LEVEL);
                            var values = data[0].STAFF_ID;
                            $.each(values.split(","), function (i, e) {
                                $("#StaffList option[value='" + e + "']").prop("selected", true);
                            });
                            // $('#StaffList').selectpicker('val',[String(data[0].STAFF_ID)]);
                            $('#Activity_ACTIVITY_TITLE').val(data[0].ACTIVITY_TITLE);
                            $('#Activity_DESCRIPTION').val(data[0].DESCRIPTION);
                            $('#SubmissionDate').val(data[0].SUBMISSION_DATE);
                            if (data[0].IS_ACTIVE == "1") {
                                $("#IS_ACTIVE").click();
                            }
                            if (data[0].IS_FILE_UPLOAD == "1") {
                                $("#IS_FILE_UPLOAD").click();
                            }
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
    </script>
    <script>
       
            handleDatepicker = function ()
            {
                "use strict";
                $("#SubmissionDate").datepicker({
                    todayHighlight: !0,
                    autoclose: !0,
                    startDate: new Date(),
                    format: "dd/mm/yyyy",
                    orientation: "right bottom",
                    zIndexOffset: '15',
                    defaultDate: new Date()
                    // 'top': top,
                    // 'left': left
                }
                )
            }
           

            
        
    </script>
    <script>
        var validate = function () {
            var validate = true;
            //var ActivityLevelId = $('#ActivityLevelList').val();
            //var StaffIds = String($('#StaffList').val());
            //var Title = $('#Activity_ACTIVITY_TITLE').val(); 
            //var Description = $('#Activity_DESCRIPTION').val();
            //var SubmissionDate = $('#SubmissionDate').val();
            //if (ActivityLevelId != '' && StaffIds != '' && Title != '' && SubmissionDate != '' && Description != '')
            //{
            //    validate = true;
            //}
            if ($('#ActivityLevelList').val() &&  $('#Activity_ACTIVITY_TITLE').val() && $('#Activity_DESCRIPTION').val() && $('#SubmissionDate').val())
            {
                if ($('#StaffList').val() != '' && $('#StaffList').val()!=null)
                {
                    validate = false;
                }
            } 
            return validate;
        }
        $('#btnSubmit').on('click', function ()
        {
            var IsActive = 0;
            var IsFileUpload = 0;
            var JsonData;
            var ActivityLevelId = $('#ActivityLevelList').val();
            var StaffIds = String($('#StaffList').val());
            var Title = $('#Activity_ACTIVITY_TITLE').val();
            var Description = $('#Activity_DESCRIPTION').val();
            var SubmissionDate = $('#SubmissionDate').val();
            if ($('#IS_ACTIVE').is(":checked"))
            {
                IsActive = 1;
            }
            
            if ($('#IS_FILE_UPLOAD').is(":checked"))
            {
                IsFileUpload = 1;
            }
            if (validate())
            {
                alert('Please Enter Correct Values...!!!');
                return false;
            }
            JsonData = '{"ACTIVITY_ID":"' + $('#sActivityId').val() + '","ACTIVITY_LEVEL":"' + ActivityLevelId + '","STAFF_ID":"' + StaffIds + '","ACTIVITY_TITLE":"' + Title + '","SUBMISSION_DATE":"' + SubmissionDate + '","DESCRIPTION":"' + Description + '","IS_ACTIVE":"' + IsActive + '","IS_FILE_UPLOAD":"' + IsFileUpload + '"}';
            if (JsonData != null) {
                $.ajax({
                    url: "@Url.Action("SaveAcademicActivity", "TaskManagement")",
                    method: "POST",
                    data: { AcademicActivity: JsonData },
                    success: function (objResult)
                    {
                        alert(objResult.Message);
                       // $('#sActivityId').val(objResult.sResult);
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        });
    </script>
