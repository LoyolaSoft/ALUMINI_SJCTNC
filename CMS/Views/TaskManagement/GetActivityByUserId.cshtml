    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        var extension;
        var baseimage64;
        
        function SaveFileAndImage(ActivityId,ActivityTitle) 
        {
            var File = $("input[cms-File=File_" + ActivityId + "]").get(0);
            var Image = $("input[cms-Image=Image_" + ActivityId + "]").get(0);
          //  alert("File" + File + " \\" + "Image " + Image);
            if (File!=null && Image!=null) 
            {
                var fileData = new FormData();
                var file = File.files;
                if (file.length<=0) {
                   

                    swal({ title: "Info !", text: "Please Upload Your File !", showConfirmButton: false, timer: 1800, type: 'info', animation: true });

                    return false;
                }
                // File Append ...
                for (var j = 0; j < file.length; j++) 
                {
                    fileData.append(file[j].name, file[j]);
                }
                file = Image.files;
                if (file.length <= 0) {
                  
                    swal({ title: "Info !", text: "Please Upload Your Image !", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                    return false;
                }
                //if (!$('#' + ActivityId).attr('src')) {                   
                //    alert('Please Upload Your Image');
                //    return false;
                //} 
                // Image Append ...
                for (var j = 0; j < file.length; j++) 
                {
                    fileData.append(file[j].name, file[j]);
                }
                fileData.append("ACTIVITY_ID", ActivityId);
                fileData.append("ACTIVITY_TITLE", ActivityTitle);
                $.ajax({
                    url: "@Url.Action("SaveUploadedFiles", "TaskManagement")",
                    method: "POST",
                    contentType: false, // Not to set any content header
                    processData: false,
                    data: fileData,
                    success: function (data)
                    {
                        //myAlert(data.Message, 'gritter-success', '');
                     
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    }, error: function (error)
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        return false;
                    }
                });
            } else
            {
               
                swal({ title: "Info !", text: "Please Upload Your Documents To Continue !", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
            }
        }

