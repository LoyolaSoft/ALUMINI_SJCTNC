@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{
    Layout = null;
}
<br /><br /><br />
<div class="col-md-12 table-bordered">

    <br /><br /><br />
    @if (Model.liImageCorrection != null && Model.liImageCorrection.Count > 0)
    {
        foreach (var item in Model.liImageCorrection)
        {
        <!-- begin col-3 -->
            <div class="col-md-3 form-group" style="height:650px;">
                <!-- begin card -->
                <div class="card">
                    <img class="card-img-top" src="@item.PHOTO" alt="" />
                    <div class="card-block">
                        <h4 class="card-title m-t-0 m-b-10">@item.NAME</h4>
                        <div  class="card-text text-left">
                            Dob : @item.DATE_OF_BIRTH <br />
                            Roll No : @item.ROLL_NO <br />
                            Register No : @item.REGISTER_NO <br />
                            Admission No : @item.ADMISSION_NO <br />
                            Class : @item.CLASS_NAME <br />
                            Shift : @item.SHIFT_NAME <br />
                            Programme : @item.PROGRAMME_NAME <br />
                        </div>
                        @*<pre class="card-text text-left">
                        Dob : @item.DATE_OF_BIRTH
                        Roll No : @item.ROLL_NO
                        Register No : @item.REGISTER_NO
                        Admission No : @item.ADMISSION_NO
                        Class : @item.CLASS_NAME
                        Shift : @item.SHIFT_NAME
                        Programme : @item.PROGRAMME_NAME
                    </pre>*@
                    </div>
                </div>
                <!-- end card -->
            </div>
           
        }
    }
</div>