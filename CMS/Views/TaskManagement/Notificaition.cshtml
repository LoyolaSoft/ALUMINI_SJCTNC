@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@using CMS.Utility
@{
    ViewBag.Title = "Notification";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div id="content" class="content">
        <div class="form-horizontal">
            <!-- BEGIN breadcrumb -->
            <ul class="breadcrumb pull-right">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item active">General Notification</li>
            </ul>
            <!-- END breadcrumb -->
            <h1 class="page-header">
                General Notification
            </h1>
            <div class="panel panel-primary">
                <div class="panel-heading bg-primary">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">General Notification</h4>
                </div>
                <div class="form-horizontal">
                    <div class="panel-body">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-md-12">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label class="col-md-2 control-label pull-left">Notification for</label>
                                    <div class="col-md-10">
                                        <div class="radio radio-css radio-success radio-inline">    
                                            <input type="radio" name="inline_radio" id="rbtnStudent" value="1" />
                                            <label for="rbtnStudent">
                                                Student
                                            </label>
                                        </div>
                                        <div class="radio radio-css radio-warning radio-inline">
                                            <input type="radio" name="inline_radio" id="rbtnStaff" value="2" />
                                            <label for="rbtnStaff">
                                                Staff
                                            </label>
                                        </div>
                                        <div class="radio radio-css radio-pink radio-inline">
                                            <input type="radio" name="inline_radio" id="rbtnBoth" value="3" />
                                            <label for="rbtnBoth">
                                                Both
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group ">
                                    <label class="col-md-3 control-label">Notification Level</label>
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(model => model.NotificationLevelList, (Model.NotificationLevelList != null) ? Model.NotificationLevelList : Enumerable.Empty<SelectListItem>(), "---Select----", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" })
                                        @Html.ValidationMessageFor(model => model.NotificationLevelList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            @*<div class="col-md-3">
                                <div class="form-group">
                                    <label class="col-md-6 col-md-offset-4 control-label">
                                        Record Count
                                    </label>
                                    <div class="col-md-2">
                                        <label class="label label-danger" id="lblCount" clientidmode="static">0</label>
                                    </div>
                                </div>
                            </div>*@
                        </div>
                        <div class="col-md-12">

                            
                            <div class="col-md-12 hidden" id="divClassForUserLevelforStudent"  data-parsley-validate="true">
                                <div class="form-group">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5,@id="ddULClass", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.StudentList, "Student", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5,@id= "ddULStudent" , @data_parsley_required = "true", @data_actions_box = "true",@multiple ="true" })
                                            @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                          
                        </div>


                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForClassLevelforStudent" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5, @id = "ddCLClassFS" ,@data_actions_box="true", @data_parsley_required = "true",@multiple="true" })
                                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>


                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForProgrammeLevelforStudent" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ProgrammeList, "Programme", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",@id="ddPLProgramme", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ProgrammeYear, "Programme Year", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.ProgrammeYear, (Model.ProgrammeYear != null) ? Model.ProgrammeYear : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",@id= "ddPLProgrammeYear",@multiple="true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.ProgrammeYear, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="col-md-12">
                            <div class="col-md-6 hidden" id="divClassForCollegeLevelforStudent" clientidmode="static">
                            
                            </div>

                        </div>
                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForApplicationLevelforStudent" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ApplicationType, "Application Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",@id = "ddALApplicationLevel" ,@multiple="true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>
                        @* staff level *@
                         
                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForUserLevelforStaff" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.StaffList, "Staff List", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ddULStaff" ,@multiple="true",@data_actions_box="true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>


                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForClassLevelforStaff" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    @*<div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ddCLClassFSS",@multiple="true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>*@

                                </div>
                            </div>
                        </div>




                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForProgrammeLevelforStaff" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.DepartmentList, "Department", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ddDLDepartment",@multiple="true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.DepartmentList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>



                        <div class="col-md-12">
                            <div class="col-md-6 hidden" id="divClassForCollegeLevelforStaff" clientidmode="static">
                                
                            </div>

                        </div>




                        @* both student and staff *@



                        <div class="col-md-12">
                            <div class="col-md-12 hidden" id="divClassForClassLevelforBoth" clientidmode="static" data-parsley-validate="true">
                                <div class="form-group">
                                    @*<div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ddCLClassFB" ,@multiple="true", @data_parsley_required = "true"})
                                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>*@

                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="col-md-6 hidden" id="divClassForCollegeLevelforBoth" clientidmode="static">

                            </div>

                        </div>




                       
                        <div class="col-md-12">
                            <div class="col-md-12">
                                <label class="control-label">
                                    Notification Message
                                </label>
                                <p>&nbsp;</p>
                                <textarea id="txtMessageContent" rows="5" cols="10" class="form-control" maxlength="612"></textarea>
                            </div>
                        </div>
                       
                        <p>&nbsp;</p>
                        <div class="col-md-12">
                          
                            <div class="col-md-6 ">
                                <button type="reset" id="btnClear" Style="margin-left: 5px;" class="pull-right btn btn-danger m-b-5 input-sm">Clear</button>
                                <button type="button" id="btnSubmit" class="pad pull-right btn btn-success input-sm">Submit</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>



<script>
        $('.selectpicker').selectpicker({
            size: 5
        });

        function ContentLoad()
        {
            // Document Ready Function .
           
        }
</script>
<script>
    var sActiveDiv = "";
    $('#NotificationLevelList').on("change", function () {
       
        $('#' + sActiveDiv + '').addClass("hidden");
       
        if($('input[name="inline_radio"]:checked').val())
        {
            var sUserrole = $('input[name="inline_radio"]:checked').val();
            
            var sNotificationlevel = $('#NotificationLevelList').val();

           

            if($('#NotificationLevelList').val())
            {
               
                if(sUserrole=="1")
                {
                    switch (sNotificationlevel) {
                        case "@Common.NOTITFICATION_LEVEL.USER_LEVEL":
                            // code block
                            
                            ShowSelectDiv("divClassForUserLevelforStudent");


                            break;
                        case "@Common.NOTITFICATION_LEVEL.CLASS_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForClassLevelforStudent");


                            break;
                        case "@Common.NOTITFICATION_LEVEL.PROGRAMME_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForProgrammeLevelforStudent");


                            break;
                        case "@Common.NOTITFICATION_LEVEL.COLLEGE_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForCollegeLevelforStudent");



                            break;
                        case "@Common.NOTITFICATION_LEVEL.APPLICATION_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForApplicationLevelforStudent");

                            break;

                        default:
                            // code block
                    }




                }
             
                if (sUserrole == "2")
                {

                    switch (sNotificationlevel) {
                        case "@Common.NOTITFICATION_LEVEL.USER_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForUserLevelforStaff");


                            break;
                        case "@Common.NOTITFICATION_LEVEL.CLASS_LEVEL":
                            // code block
                            //ShowSelectDiv("divClassForClassLevelforStaff");
                            swal({ title: "Info !", text: "For staff role this level not required", showConfirmButton: false, timer: 5000, type: 'info', animation: true });


                            break;
                        case "@Common.NOTITFICATION_LEVEL.PROGRAMME_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForProgrammeLevelforStaff");


                            break;
                        case "@Common.NOTITFICATION_LEVEL.COLLEGE_LEVEL":
                            // code block
                            ShowSelectDiv("divClassForCollegeLevelforStaff");



                            break;
                        case "@Common.NOTITFICATION_LEVEL.APPLICATION_LEVEL":
                            // code block
                            swal({ title: "Info !", text: "For staff role this level not required", showConfirmButton: false, timer: 5000, type: 'info', animation: true });

                            break;

                        default:
                            // code block
                    }
                }
                   
                    if (sUserrole == "3")
                    {
                        switch (sNotificationlevel) {
                            case "@Common.NOTITFICATION_LEVEL.USER_LEVEL":
                                // code block
                                swal({ title: "Info !", text: "For Both role this level not required", showConfirmButton: false, timer: 5000, type: 'info', animation: true });


                                break;
                            case "@Common.NOTITFICATION_LEVEL.CLASS_LEVEL":
                                // code block
                               
                                //ShowSelectDiv("divClassForClassLevelforBoth");
                                swal({ title: "Info !", text: "For this role this level not required", showConfirmButton: false, timer: 5000, type: 'info', animation: true });

                                break;
                            case "@Common.NOTITFICATION_LEVEL.PROGRAMME_LEVEL":
                                // code block
                                swal({ title: "Info !", text: "For Both role this level not required", showConfirmButton: false, timer: 5000, type: 'info', animation: true });


                                break;
                            case "@Common.NOTITFICATION_LEVEL.COLLEGE_LEVEL":
                                // code block
                                ShowSelectDiv("divClassForCollegeLevelforBoth");



                                break;
                            case "@Common.NOTITFICATION_LEVEL.APPLICATION_LEVEL":
                                // code block
                                swal({ title: "Info !", text: "For Both role this level not required", showConfirmButton: false, timer: 5000, type: 'info', animation: true });

                                break;

                            default:
                                // code block
                        }
                    }

                

            }
           

        }
        else
        {
            swal({ title: "Info !", text: "Pleas select user role for notification", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
        }
        });
    

    function ShowSelectDiv(sDiv)
    {
       

        var sLevelDivs=["UserLevel","ClassLevel","ProgrammeLevel","CollegeLevel","ApplicationLevel"];
        var ssLevelDivs=["UserLevel","ProgrammeLevel","CollegeLevel"];
        var bLevelDivs=["CollegeLevel"];


       
        //student level
        for(var i=0;i<sLevelDivs.length;i++)
        { 
            if($('#divClassFor'+sLevelDivs[i]+'forStudent').hasClass("hidden"))
            {

            }
            else{
                $('#divClassFor'+sLevelDivs[i]+'forStudent').addClass("hidden");
            }

           
        }


        //staff level
        for(var i=0;i<ssLevelDivs.length;i++)
        {
            if( $('#divClassFor'+ssLevelDivs[i]+'forStaff').hasClass("hidden"))
            {

            }
            else{
                $('#divClassFor'+ssLevelDivs[i]+'forStaff').addClass("hidden");
            }
           
        }


        //both level
        for(var i=0;i<bLevelDivs.length;i++)
        {
            if( $('#divClassFor'+bLevelDivs[i]+'forBoth').hasClass("hidden"))
            {

            }
            else{
                $('#divClassFor'+bLevelDivs[i]+'forBoth').addClass("hidden");
            }
           
        }
       
        $('#'+ sDiv +'').removeClass("hidden");
        sActiveDiv="";
        sActiveDiv=sDiv;
    }


    $('#btnSubmit').click(function () {
      
        if ($('input[name="inline_radio"]:checked').val() && $('#NotificationLevelList').val()) 
        {
           
            var isValid = true;
            if ($('#' + sActiveDiv + '').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }
            if($('#txtMessageContent').val())
            {
               
                var JsonData = "";
                JsonData=DesingnJsonDataBasedOnNotificationLevel();



                $.ajax({
                    url: "@Url.Action("SaveNotification", "TaskManagement")",
                    method: "POST",
                datatype: "json",
                data: { sJsonData: JsonData },
                success: function (data) {

                    if(data.Message!=null && data.Message!="")
                    {
                        if(data.ErrorCode=="200")
                        {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                        }
                        if(data.ErrorCode=="417")
                        {
                            swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                        }
                       
                    }

                    
                }, error: function (error) {
                    alert("Internal Server Error ...!!!");
                }
            });
        }
        else
        {
                swal({ title: "Info !", text: "Notification message cannot be empty!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
        }

        }
        else
        {
            swal({ title: "Info !", text: "Please select all the fields!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
        }
    });


    function DesingnJsonDataBasedOnNotificationLevel()
    {
      
        var sJsonData = '[';
        var sUserrole = $('input[name="inline_radio"]:checked').val();
        var sNotificationlevel = $('#NotificationLevelList').val();



        if(sUserrole=="1")
        {
            switch (sNotificationlevel) {
                case "@Common.NOTITFICATION_LEVEL.USER_LEVEL":
                    // code block
                   
                    var sStudentVal = $("#ddULStudent").val();
                    var sSplitStudentval = sStudentVal.toString().split(",");
                   
                    for (var i = 0; i < sSplitStudentval.length;i++)
                    {
                      
                        sJsonData += '{"NOTIFICATION_ROLE_TYPE_ID":"' + sUserrole + '","NOTIFICATION":"' + $('#txtMessageContent').val() + '","USER_ID":"' + sSplitStudentval[i] + '","CLASS_ID":"","PROGRAMME_GROUP_ID":"","PROGRAMME_YEAR":"","APP_TYPE_ID":"","NOTIFICATION_LEVEL_ID":"' + sNotificationlevel + '"},';
                    }
                    sJsonData = sJsonData.slice(0, -1);
                    sJsonData += ']';
                    
                    break;
                case "@Common.NOTITFICATION_LEVEL.CLASS_LEVEL":
                    // code block

                    var sClassVal = $("#ddCLClassFS").val();
                    var sSplitClassval = sClassVal.toString().split(",");

                    for (var i = 0; i < sSplitClassval.length; i++) {

                        sJsonData += '{"NOTIFICATION_ROLE_TYPE_ID":"' + sUserrole + '","NOTIFICATION":"' + $('#txtMessageContent').val() + '","USER_ID":"","CLASS_ID":"' + sSplitClassval[i] + '","PROGRAMME_GROUP_ID":"","PROGRAMME_YEAR":"","APP_TYPE_ID":"","NOTIFICATION_LEVEL_ID":"' + sNotificationlevel + '"},';
                    }
                    sJsonData = sJsonData.slice(0, -1);
                    sJsonData += ']';

                    break;
                case "@Common.NOTITFICATION_LEVEL.PROGRAMME_LEVEL":
                    // code block
                    var sProgrammeYearVal = $("#ddPLProgrammeYear").val();
                    var sSplitProgrammeYearval = sProgrammeYearVal.toString().split(",");

                    for (var i = 0; i < sSplitProgrammeYearval.length; i++) {

                        sJsonData += '{"NOTIFICATION_ROLE_TYPE_ID":"' + sUserrole + '","NOTIFICATION":"' + $('#txtMessageContent').val() + '","USER_ID":"","CLASS_ID":"","PROGRAMME_GROUP_ID":"' + $('#ddPLProgramme').val() + '","PROGRAMME_YEAR":"' + sSplitProgrammeYearval[i] + '","APP_TYPE_ID":"","NOTIFICATION_LEVEL_ID":"' + sNotificationlevel + '"},';
                    }
                    sJsonData = sJsonData.slice(0, -1);
                    sJsonData += ']';



                    break;
                case "@Common.NOTITFICATION_LEVEL.COLLEGE_LEVEL":
                    // code block
                    sJsonData += '{"NOTIFICATION_ROLE_TYPE_ID":"' + sUserrole + '","NOTIFICATION":"' + $('#txtMessageContent').val() + '","USER_ID":"","CLASS_ID":"","PROGRAMME_GROUP_ID":"","PROGRAMME_YEAR":"","APP_TYPE_ID":"","NOTIFICATION_LEVEL_ID":"' + sNotificationlevel + '"},';
                    sJsonData = sJsonData.slice(0, -1);
                    sJsonData += ']';

                  


                    break;
                case "@Common.NOTITFICATION_LEVEL.APPLICATION_LEVEL":
                    // code block
                  
                    var sApplicationVal = $("#ddALApplicationLevel").val();
