<script>


    $('#ddULClass').on('change', function () {
        if ($('#ddULClass').val()) {
            $.ajax({
                url: '@Url.Action("FetchStudentByClassId", "Attendance")',
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ddULClass').val() },
                success: function (data) {
                    $('#ddULStudent').empty();
                    if (data.Message != null && data.Message != '') {
                        alert(data.Message);
                    } else {
                        $('#ddULStudent').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    });



    $('input[name="inline_radio"]').click(function(){

        $('#txtMessageContent').val("");

        $('#NotificationLevelList option[value=""]').prop("selected", true);
        $('.selectpicker').selectpicker('refresh');
        $('#NotificationLevelList').trigger("change");

    });

    $('#btnClear').on("click", function () {

        $('#NotificationLevelList option[value=""]').prop("selected", true);
        $('.selectpicker').selectpicker('refresh');
        $('#NotificationLevelList').trigger("change");


    });



</script>

