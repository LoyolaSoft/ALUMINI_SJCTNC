@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{
    ViewBag.Title = "ListTasks";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Task List</li>
    </ol>
    <h1 class="page-header">Task List</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Task List</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#tasklistmodal" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tbltasklist">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Task Name</th>
                            <th>Submission Date</th>
                            <th>Description</th>
                           
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.litasklist != null && Model.litasklist.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.litasklist)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td>@item.TASK_NAME</td>
                                    <td>@item.SUB_DATE</td>
                                    <td>@item.DESCRIPTION</td>
                                    
                                    <td>
                                        <a href="#tasklistmodal" onclick="FetchTaskList(@item.TASK_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.TASK_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="tasklistmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="taskid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Task Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="taskname" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Submission Date</label>

                                        <div class="col-md-8">
                                            <input type="text" id="subdate" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Description</label>
                                        <div class="col-md-8">
                                            <textarea  id="description" class="form-control" data-parsley-required="true"/>
                                        </div>
                                    </div>
                                   
                                    <div class="form-group col-md-12">
                                        @Html.LabelFor(model => model.StaffList, "Staff Name", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_selected_text_format = "count", @data_action_box = "true" })
                                            @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }
       
        $("#subdate").datepicker({
            todayHighlight: true,
            autoclose: true,
            //  endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

        var tbl = $('#tbltasklist').DataTable();
        $('#tbltasklist').DataTable();
        function FetchTaskList(ID)
        {
            if (ID != null)
            {
                $.ajax({
                    url: "@Url.Action("FetchTasklist", "TaskManagement")",
                    type:"post",
                    data: { taskid: ID },
                    success:function(data)
                    {
                           if (data != null)
                           {
                               $('#taskid').attr('value', data.TASK_ID);
                               $('#taskname').val(data.TASK_NAME);
                               $('#subdate').attr('value', data.SUB_DATE);
                               $('#description').attr('value', data.DESCRIPTION);
                               
                               $('#StaffList').empty();
                               $('#StaffList').append(data.STAFF_ID);
                                $('.selectpicker').selectpicker('refresh');
                            }
                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }
        $('#btnSubmit').click(function ()
        {
            var isValid = true;
            var JsonData = null;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid)
            {
                return false;
            }
            var staff = $('#StaffList').val();
            JsonData = '{"TASK_ID":"' + $('#taskid').val() + '","TASK_NAME":"' + $('#taskname').val() + '","SUB_DATE":"' + $('#subdate').val() + '","DESCRIPTION":"' + $('#description').val() + '","STAFF_ID":"' + staff + '"}';
              var req=  $.ajax({
                  url: "@Url.Action("SaveorUpdateTaskAssigned", "TaskManagement")",
                    type: "post",
                    data: { sJsonData: JsonData },
                    success: function (data)
                    {

                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/TaskManagement/ListTasks');

                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
              });
        });

    GetConfirm = function (ID)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function ()
{
    $.ajax({
        url: "@Url.Action("DeleteTaskList", "TaskManagement")",
        type: "post",
        data: { taskid: ID },
        success: function (data)
        {
            if (data.Message != null && data.Message != "")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/TaskManagement/ListTasks');
            }
        },
        error: function (ex)
        {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }


</script>



