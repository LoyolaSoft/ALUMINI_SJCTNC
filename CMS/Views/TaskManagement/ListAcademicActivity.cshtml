        function SendCorrection(ActivityId)
        {
            $('#txtActivityId').val(ActivityId);

            if(ActivityId!="" && ActivityId!=null)
            {
                $.ajax({
                    url: "@Url.Action("FetchActivityFileCorrectionByActivityId", "TaskManagement")",
                    method: "POST",
                async: false,
                cache: false,
                datatype: "json",
                data: { sActivityId: $('#txtActivityId').val() },
                success: function (data)
                {
                    if(data.Message!="" && data.Message!=null)
                    {
                        $('#txtFileCorrection').val('');
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }
                    else{

                        $('#txtFileCorrection').val('');
                        $('#txtFileCorrection').val(data[0].FILE_CORRECTION);


                    }

                }, error: function (error)
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                }
            });
        }
        else
        {
            swal({ title: "Info !", text: "Something went wrong please try later!", showConfirmButton: false, timer: 2000, type: 'info', animation: true });
        }
        }



    

        $('#btnModalSubmit').on("click", function () {

            var isValid = true;
            if($('#smodalcorrection').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //myAlert('Please check your inputs !', 'gritter-warning', '');
                return false;
            }
            $.ajax({
                url: "@Url.Action("SaveFileCorrectionByActivity", "TaskManagement")",
                method: "POST",
            datatype: "json",
            data: { sActivityId: $('#txtActivityId').val(), sFileCorrection: $('#txtFileCorrection').val() },
            success: function (objResult)
            {
                if(objResult.ErrorCode == "200")
                {
                    swal({ title: "Success !", text: objResult.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                    FethActivityList();
                }
                if (objResult.ErrorCode == "417")
                {
                    swal({ title: "Failed !", text: objResult.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                }
              
               
            }, error: function (error)
            {
                swal({ title: "Error !", text: objResult.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
            }
        });
      
        });
 

        
