@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{ 
    Layout = null;
}

<div class="table-responsive">
    @if (Model.litasksubmissionlist != null && Model.litasksubmissionlist.Count > 0)
    {
       
        <div class="">
            <h4 style="text-align:center">Task Submitted Details</h4>
            <div class="form-group">
                <label class="col-md-4 control-label">Staff  Name</label>

                <div class="col-md-8">
                    <label class="col-md-4 control-label"><b>@Model.litasksubmissionlist.FirstOrDefault().FIRST_NAME</b></label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-4 control-label">Staff Code</label>

                <div class="col-md-8">
                    <label class="col-md-4 control-label"><b>@Model.litasksubmissionlist.FirstOrDefault().STAFF_CODE</b></label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-4 control-label">Description</label>
                <div class="col-md-8">
                    <textarea id="description" class="form-control" style="height:200px" disabled data-parsley-required="true">@Model.litasksubmissionlist.FirstOrDefault().DESCRIPTION</textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-4 control-label">Document</label>
                <div class="col-md-8">
                    <a href="@Model.litasksubmissionlist.FirstOrDefault().FILE_PATH"><i class="fa fa-file fa-3x"></i></a>
                    <a href="@Model.litasksubmissionlist.FirstOrDefault().FILE_PATH" target="- blank"><i class="glyphicon glyphicon-open" title="Open"></i></a>
                    <a href="@Model.litasksubmissionlist.FirstOrDefault().FILE_PATH" download=""><i class="glyphicon glyphicon-download" title="Download"></i></a>
                </div>
                </div>   
        </div>
       
    }
    else
    {
        <div class="alert alert-info">
            No Attachment File Found..!
        </div>
    }
</div>