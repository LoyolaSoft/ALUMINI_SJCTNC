@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{
    ViewBag.Title = "EventRegistratinSettings";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Event Registration Setting</li>
    </ol>
    <h1 class="page-header">Event Registration Setting</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Event Registration Setting</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#evevntsetting" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tbleventsetting">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Event Name</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th>Is Active</th>                    
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.Lieventregistrationsettings != null && Model.Lieventregistrationsettings.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.Lieventregistrationsettings)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td>@item.MAIN_EVENT_NAME</td>
                                    <td>@item.FROM_DATE</td>
                                    <td>@item.TO_DATE</td>
                                    <td>
                                    @if (item.IS_ACTIVE == "1")
                                    {
                                        <a href="javascrip:;" onclick="SetActive(@item.EVENT_SETTING_ID,0)" class="text-success"><i class="fa fa-check"></i></a>             }
                                    else
                                    {
                                        <a href="javascrip:;" onclick="SetActive(@item.EVENT_SETTING_ID,1)" class="text-danger"><i class="fa fa-times"></i></a>
                                    }
                                       </td>                               
                                        <td>
                                            <a href="#evevntsetting" onclick="FetchEventsetting(@item.EVENT_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                            <a href="javascrip:;" onclick="GetConfirm(@item.EVENT_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                        </td>                                    
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="evevntsetting">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Event Setting</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="eventsettingid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Event Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="eventname" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">From Date</label>

                                        <div class="col-md-8">
                                            <input type="text" id="fromdate" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">To Date</label>

                                        <div class="col-md-8">
                                            <input type="text" id="todate" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                  
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }
        $("#fromdate").datepicker({
            todayHighlight: true,
            autoclose: true,
            //  endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $("#todate").datepicker({
            todayHighlight: true,
            autoclose: true,
            //endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

        var tbl = $('#tbleventsetting').DataTable();
        $('#tbleventsetting').DataTable();
        function FetchEventsetting(ID)
        {
            if (ID != null)
            {
                $.ajax({
                    url: "@Url.Action("FetchEventRegistrationById", "TaskManagement")",
                    type:"post",
                    data: { sEventsettingId: ID },
                    success:function(data)
                    {
                           if (data != null)
                           {
                               $('#eventsettingid').attr('value', data.EVENT_SETTING_ID);
                               $('#eventname').val(data.MAIN_EVENT_NAME);
                               $('#fromdate').attr('value', data.FROM_DATE);
                               $('#todate').attr('value', data.TO_DATE);
                                $('.selectpicker').selectpicker('refresh');
                            }
                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }
        $('#btnSubmit').click(function ()
        {
            var isValid = true;
            var JsonData = null;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid)
            {
                return false;
            }
            JsonData = '{"EVENT_SETTING_ID":"' + $('#eventsettingid').val() + '","MAIN_EVENT_NAME":"' + $('#eventname').val() + '","FROM_DATE":"' + $('#fromdate').val() + '","TO_DATE":"' + $('#todate').val() + '"}';
              var req=  $.ajax({
                  url: "@Url.Action("SaveorUpdateEventSetting", "TaskManagement")",
                    type: "post",
                    data: { sJsonData: JsonData },
                    success: function (data)
                    {

                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/TaskManagement/EventRegistratinSettings');

                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
              });
        });

    GetConfirm = function (ID)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function ()
{
    $.ajax({
        url: "@Url.Action("DeleteEventSetting", "TaskManagement")",
        type: "post",
        data: { sEventsettingId: ID },
        success: function (data)
        {
            if (data.Message != null && data.Message != "")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/TaskManagement/EventRegistratinSettings');
            }
        },
        error: function (ex)
        {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }
    function SetActive(ID,Mode)
    {
        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "@Url.Action("UpdateEventSettingIsActive", "TaskManagement")",
                type: "post",
                data: { sEventsettingId: ID, sValue: Mode },
            success: function (data) {
                if (data.Message != null && data.Message != "")
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    loadContent('/TaskManagement/EventRegistratinSettings');
                }
            },
            error: function (ex) {
                swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

            }

        });
    });

    }

</script>



