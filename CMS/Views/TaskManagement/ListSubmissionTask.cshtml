@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{
    ViewBag.Title = "ListSubmissionTask";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Task List</li>
    </ol>
    <h1 class="page-header">Task List</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Task List</h4>
        </div>
        <div class="panel-body noPadding">

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tbltasklist">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Task Name</th>
                            <th>Submission Date</th>
                            <th>Description</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.litasklist != null && Model.litasklist.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.litasklist)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td>@item.TASK_NAME</td>
                                    <td>@item.SUB_DATE</td>
                                    <td>@item.DESCRIPTION</td>

                                    <td>
                                        <a href="#tasklistmodal" onclick="FetchTaskList(@item.TASK_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-expand" title="Submit"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="tasklistmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="taskid" class="hidden">
                                    <input type="text" id="tasksubid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Task Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="taskname" disabled class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    @*<div class="col-md-12 form-group">
                                            <label class="col-md-4 control-label">Submission Date</label>

                                            <div class="col-md-8">
                                                <input type="text" id="subdate" class="form-control" data-parsley-required="true">
                                            </div>
                                        </div>*@
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Description</label>
                                        <div class="col-md-8">
                                            <textarea id="description" class="form-control" data-parsley-required="true"  style="height:200px"/>
                                        </div>
                                    </div>


                                    <div class="col-md-12 form-group">
                                        @Html.Label("Choose File", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            <input class="btn btn-success" type="file" name="files" id="InputFile" onchange="encodefiletoBase64();" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    $('#tbltasklist').DataTable({});
    function FetchTaskList(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchTaskSubmission", "TaskManagement")",
                type: "post",
                data: { taskid: ID },
                success: function (data) {
                    if (data != null)
                    {
                        $('#taskid').attr('value', data.TASK_ID);
                        $('#tasksubid').val(data.TASK_SUB_ID);
                        $('#taskname').val(data.TASK_NAME);
                        $('#description').attr('value', data.DESCRIPTION);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function ()
    {
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
        if ($('#InputFile').get(0).files.length === 0)
        {
            var JsonData = null;
            JsonData = '{"TASK_ID":"' + $('#taskid').val() + '","TASK_NAME":"' + $('#taskname').val() + '","DESCRIPTION":"' + $('#description').val() + '","TASK_SUB_ID":"' + $('#tasksubid').val() + '"}';
            var Taskname = $('#taskname').val();

            var fileUpload = $("#InputFile").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
            }
            // Adding one more key to FormData object
            fileData.append('TASK_NAME', Taskname);
            fileData.append('sJsonData', JsonData);
            $.ajax({
                url: "@Url.Action("SaveSubmissionTask", "Taskmanagement")",
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (objResult) {
                    alert(objResult.Message);
                },
                error: function (err) {
                    alert(err.statusText);
                }
            });
        }
        else
        {
            alert("No File Selected ...!");
        }
    });



</script>