@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{
    ViewBag.Title = "ListHalls";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Hall</li>
    </ol>
    <h1 class="page-header">List Hall</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Hall</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#hallmodal" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblhall">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Hall No</th>
                            <th>Hall Name</th>
                            <th>Block</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lihalls != null && Model.lihalls.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lihalls)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td><img src="@item.IMAGE" height="80" width="80"></td>
                                    <td>@item.HALL_NO</td>
                                    <td>@item.HALL_NAME</td>
                                    <td>@item.BLOCK_NAME</td>
                                    <td>
                                        <a href="#hallmodal" onclick="FetchHallDetails(@item.HALL_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.HALL_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="hallmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="hallid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Hall No</label>

                                        <div class="col-md-8">
                                            <input type="text" id="hallno" class="form-control" @*data-parsley-required="true"*@>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Hall Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="hallname" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Location</label>
                                        <div class="col-md-8">
                                            <input type="text" id="location" class="form-control" data-parsley-required="true" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Capacity</label>
                                        <div class="col-md-8">
                                            <input type="text" id="capacity" class="form-control" data-parsley-required="true" />
                                        </div>
                                    </div>

                                    <div class="form-group col-md-12">
                                        @Html.Label("Block List", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.BlockList, (Model.BlockList != null) ? Model.BlockList : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_selected_text_format = "count", @data_action_box = "true" })
                                            @Html.ValidationMessageFor(model => model.BlockList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Choose File", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            <input class="btn btn-success" type="file" name="files" id="InputFile" onchange="encodefiletoBase64();" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }

  
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

        var tbl = $('#tblhall').DataTable();
        $('#tblhall').DataTable();
        function FetchHallDetails(ID)
        {
            if (ID != null)
            {
                $.ajax({
                    url: "@Url.Action("FetchHallsById", "TaskManagement")",
                    type:"post",
                    data: { sHallId: ID },
                    success:function(data)
                    {
                           if (data != null)
                           {
                               $('#hallid').val(data.HALL_ID);
                               $('#hallno').attr('value', data.HALL_NO);
                               $('#hallname').val(data.HALL_NAME);
                               $('#location').attr('value', data.LOCATION);
                               $('#capacity').attr('value', data.CAPACITY);
                               $('#BlockList').val(data.BLOCK_ID);
                                $('.selectpicker').selectpicker('refresh');
                            }
                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }
        $('#btnSubmit').click(function ()
        {
            var isValid = true;
            var JsonData = null;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid)
            {
                return false;
            }           
            JsonData = '{"HALL_ID":"' + $('#hallid').val() + '","HALL_NO":"' + $('#hallno').val() + '","HALL_NAME":"' + $('#hallname').val() + '","LOCATION":"' + $('#location').val() + '","CAPACITY":"' + $('#capacity').val() + '","BLOCK_ID":"' + $('#BlockList').val() + '"}';
            var fileUpload = $("#InputFile").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
            }
            // Adding one more key to FormData object       
            fileData.append('sJsonData', JsonData);
              var req=  $.ajax({
                  url: "@Url.Action("SaveorUpdateHalls", "TaskManagement")",
                  type: "post",
                  contentType: false, // Not to set any content header
                  processData: false, // Not to process data
                  data: fileData,
                    success: function (data)
                    {

                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/TaskManagement/ListHalls');

                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
              });
        });

    GetConfirm = function (ID)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function ()
{
    $.ajax({
        url: "@Url.Action("DeleteHalls", "TaskManagement")",
        type: "post",
        data: { sHallId: ID },
        success: function (data)
        {
            if (data.Message != null && data.Message != "")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/TaskManagement/ListHalls');
            }
        },
        error: function (ex)
        {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }


</script>



