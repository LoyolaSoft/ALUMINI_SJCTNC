@model CMS.ViewModel.ViewModel.TaskManagementViewModel
@{
    ViewBag.Title = "VisitorsMeetingAppointment";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />


<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/css/jquery.jqGauges.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/morris/morris.css" rel="stylesheet" />
<link href="~/Content/assets/css/timepicki.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#" onclick="loadContent('@Url.Action("ADMIN","DashBoard")')"></a></li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-default panel-with-tabs" data-sortable-id="ui-unlimited-tabs-2">
        <div class="panel-heading p-0">
            <div class="panel-heading-btn m-r-10 m-t-10">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-inverse" data-click="panel-expand"><i class="fa fa-expand"></i></a>
            </div>
            <!-- begin nav-tabs -->
            <div class="tab-overflow" data-parsley-validate="true" name="form-wizard">
                <ul class="nav nav-tabs">
                    @*<li class="prev-button"><a href="javascript:;" data-click="prev-tab" aria-controls="first" class="text-inverse"><i class="fa fa-arrow-left"></i></a></li>*@

                    <li class="nav-item active" id="bookedlist"><a href="#nav-tab1-1" class="nav-link active" data-toggle="tab">Visitors Meeting Appointment</a></li>
                    <li class="" id=""><a href="#nav-tab1-2" data-toggle="tab">Visitors Report</a></li>

                </ul>
            </div>
        </div>
        <div class="panel-body">
            <div class="tab-content">
                <div class="tab-pane fade active in" id="nav-tab1-1" data-parsley-validate="true">
                    <div class="col-md-12" id="hallreserved">
                        <table class="table table-hover table-bordered" id="meetingappointment">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Visitors Name</th>
                                    <th>Mobile No</th>
                                    <th>Category</th>
                                    <th>Date </th>
                                    <th>Purpose</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.livisitorsmeetingappointment != null && Model.livisitorsmeetingappointment.Count > 0)
            {
                foreach (var item in Model.livisitorsmeetingappointment)
                {

                                        <tr>
                                            <td>
                                                @{ count++;} @count
                                            </td>
                                            <td>@item.VISITORS_NAME</td>
                                            <td>@item.MOBILE</td>
                                            <td>@item.VISITORS_CATEGORY_NAME</td>
                                            <td>@item.VISIT_DATE </td>
                                            <td>@item.PURPOSE</td>
                                           
                                           <td><p class="" >@item.STATUS_NAME</p></td>
                                          

                                            <td>
                                                <a href="#visitorsmeetingappointment" onclick="FetchVisitorsMeetingAppointment(@item.VISITORS_MEET_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-edit" title="EDIT"></i></a>
                                            </td>

                                        </tr>
                                                        }
                                                    }

                            </tbody>
                        </table>


                    </div>
                </div>
                <div class="tab-pane fade" id="nav-tab1-2" data-parsley-validate="true">
                    <div class="col-md-12">
                        <div class="col-md-4">
                            <label class="col-md-4 control-label">From Date</label>

                            <div class="col-md-8">
                                <input type="text" id="sdate" class="form-control" data-parsley-required="true">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="col-md-4 control-label">To Date</label>

                            <div class="col-md-8">
                                <input type="text" id="edate" class="form-control" data-parsley-required="true">
                            </div>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-primary" id="btnget">Get</button>
                        </div>
                    </div>
                    <div class="col-md-12" id="bindvisitordetails">
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- end panel -->
</div>

<div class="modal" id="visitorsmeetingappointment">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <input type="text" id="visitorsmeetid" class="hidden">
                                    <input type="text" id="visitorsappointmentid" class="hidden">
                                    <input type="text" id="visitormobile" class="hidden">
                                    
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Appointment Date</label>

                                        <div class="col-md-8">
                                            <input type="text" id="appointmentdate" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Appointment Time</label>
                                        <div class="col-md-8">
                                            <input type="text" placeholder="Enter Time" id="appointmenttime" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Reply</label>
                                        <div class="col-md-8">
                                            <textarea id="reply" style="height:100px" class="form-control" data-parsley-required="true" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-12">
                                        @Html.Label("Status", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.StatusList, (Model.StatusList != null) ? Model.StatusList : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_selected_text_format = "count", @data_action_box = "true" })
                                            @Html.ValidationMessageFor(model => model.StatusList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/morris/raphael.min.js"></script>
<script src="~/Content/assets/plugins/morris/morris.js"></script>
<script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap.min.js"></script>
<script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap-world-merc-en.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/js/timepicki.js"></script>

<script>
    $('.selectpicker').selectpicker({});
    $("#appointmentdate").datepicker({
        todayHighlight: true,
        autoclose: true,
        startDate: new Date(),
        //endDate: new Date(),
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });
    $("#sdate,#edate").datepicker({
        todayHighlight: true,
        autoclose: true,
        //endDate: new Date(),
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });
    $('#meetingappointment').DataTable({});
    $('#tbldatewise').DataTable({});
    function FetchVisitorsMeetingAppointment(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchVisitorMeetingappointment", "TaskManagement")",
                type: "post",
                data: { sVisitormeetId: ID },
                success: function (data) {
                    if (data != null)
                    {
                        $('#visitorsappointmentid').val(data.VISITORS_APPOINTMENT_ID);
                        $('#visitorsmeetid').val(data.VISITORS_MEET_ID);
                        $('#visitormobile').val(data.MOBILE);
                        $('#appointmentdate').attr('value', data.APPOINTMENT_DATE);
                        $('#appointmenttime').val(data.APPOINTMENT_TIME);
                        $('#reply').attr('value', data.REPLY);
                        $('#StatusList').attr('value', data.STATUS);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex)
                {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').on('click',function()
    {
        var JsonData = null;
        var visitermeetappid = $('#visitorsappointmentid').val();
       var visitermeetid= $('#visitorsmeetid').val();
       var appdate=$('#appointmentdate').val();
       var apptime= $('#appointmenttime').val();
       var reply=$('#reply').val();
       var status = $('#StatusList').val();
       var mobile = $('#visitormobile').val();
       var statusname = $('#StatusList option:selected').text();
       var isValid = true;
       if ($('#pBody').parsley().validate() !== true) isValid = false;
       if (!isValid) 
       {
           return false;
       }
       JsonData = '{"VISITORS_APPOINTMENT_ID":"' + visitermeetappid + '","VISITORS_MEET_ID":"' + visitermeetid + '","APPOINTMENT_DATE":"' + appdate + '","APPOINTMENT_TIME":"' + apptime + '","REPLY":"' + reply + '","STATUS":"' + status + '","STATUS_NAME":"' + statusname + '","MOBILE":"' + mobile + '"}';

       $.ajax({
           url: "@Url.Action("SaveorUpdateVisitorMeetingAppointment", "Taskmanagement")",
           method: "POST",
           datatype: "json",
           data: { sJsonData: JsonData },
           success: function (data)
           {                  
               swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
               loadContent('/TaskManagement/VisitorsMeetingAppointment');

           },
           error: function (data)
           {
               swal({ title: "Error !", text:'Internal Server Error...!', showConfirmButton: false, timer: 1800, type: 'error', animation: true });
           }
       });
       
    });

    $('#btnget').on('click', function ()
    {
        var startdate = $('#sdate').val();
        var enddate = $('#edate').val();
        $.ajax({
            url: "@Url.Action("BindVisitorMeetingandAppointment", "Taskmanagement")",
            method: "POST",
            datatype: "json",
            data: { sStartDate: startdate, sEndDate: enddate },
            success: function (data)
            {
                $('#bindvisitordetails').empty();
                $('#bindvisitordetails').append(data);

            },
            error: function (data) {
                swal({ title: "Error !", text: 'Internal Server Error...!', showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });
    });
</script>
