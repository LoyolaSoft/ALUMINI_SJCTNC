@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{ 
    Layout = null;
    int count = 0;
}


    <div class="col-md-12 form-group">
        <div class="col-md-12 form-group">
            <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/TaskManagement/AddCiaBlockList')" @*href="@Url.Action("AddCiaBlockList","TaskManagement")"*@><i class="fa fa-plus" title="Add"> Add</i></a>
        </div>
        <br />

        <div class="col-md-12 table-responsive">
            <table class="table table-hover table-bordered" id="tblCIABlockList">
                <thead>
                    <tr>
                        <th>#</th>
                        @{
                            if (Model.ObjCIABlockList.ORDER_ID == "1")
                            {
                                <th> Class</th>
                                <th> Course</th>
                                <th> Staff</th>
                            }
                            else if (Model.ObjCIABlockList.ORDER_ID == "2")
                            {
                                <th> Programme</th>
                            }
                            else if (Model.ObjCIABlockList.ORDER_ID == "3")
                            {
                                <th> Programme Level (UG/PG)</th>
                            }
                            else if (Model.ObjCIABlockList.ORDER_ID == "4")
                            {
                                <th> Shift</th>
                            }
                            else if (Model.ObjCIABlockList.ORDER_ID == "5")
                            {
                                <th> Class</th>
                            }
                            else if (Model.ObjCIABlockList.ORDER_ID == "6")
                            {
                                <th> Course</th>
                            }
                            else if (Model.ObjCIABlockList.ORDER_ID == "7")
                            {
                                <th> Staff</th>
                            }
                        }
                        <th>Date From</th>
                        <th>Date To</th>
                        <th>Active</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.liCIABlockList != null && Model.liCIABlockList.Count > 0)
                    {
                        foreach (var item in Model.liCIABlockList)
                        {
                            <tr>
                                @{
                                    <td>@{ count++;}@count</td>
                                        if (Model.ObjCIABlockList.ORDER_ID == "1")
                                        {
                                            <td>@item.CLASS_ID</td>
                                            <td>@item.COURSE_ID</td>
                                            <td>@item.STAFF_ID</td>
                                        }
                                        else if (Model.ObjCIABlockList.ORDER_ID == "2")
                                        {
                                            <td>@item.PROGRAMME_GROUP_ID</td>
                                        }
                                        else if (Model.ObjCIABlockList.ORDER_ID == "3")
                                        {
                                            <td>@item.PROGRAMME_LEVEL</td>
                                        }
                                        else if (Model.ObjCIABlockList.ORDER_ID == "4")
                                        {
                                            <td>@item.SHIFT_ID</td>
                                        }
                                        else if (Model.ObjCIABlockList.ORDER_ID == "5")
                                        {
                                            <td>@item.S_CLASS_ID</td>
                                        }
                                        else if (Model.ObjCIABlockList.ORDER_ID == "6")
                                        {
                                            <td>@item.S_COURSE_ID</td>
                                        }
                                        else if (Model.ObjCIABlockList.ORDER_ID == "7")
                                        {
                                            <td>@item.S_STAFF_ID</td>
                                        }
                                }

                                <td>@Html.DisplayFor(modelItem => item.DATE_FROM)</td>
                                <td>@Html.DisplayFor(modelItem => item.DATE_TO)</td>
                                <td>
                                    @if (item.IS_ACTIVE == "0")
                                    {
                                        <a href="#"><i class="fa fa-close text-danger" onclick="ActiveCIABlockList(@item.CIA_BLOCK_ID);"></i></a>
                                    }
                                    else
                                    {
                                        <a href="#"><i class="fa fa-check text-success" onclick="DeActiveCIABlockList(@item.CIA_BLOCK_ID);"></i></a>
                                    }
                                </td>
                                <td>
                                    <a @*href="@Url.Action("AddCiaBlockList","TaskManagement",new { sCIABlockListId=@item.CIA_BLOCK_ID})"*@ href="javascript:;" onclick="loadContent('/TaskManagement/AddCiaBlockList/@item.CIA_BLOCK_ID')"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                    <a href="#" onclick="Deleteconfirm(@item.CIA_BLOCK_ID);"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                                </td>
                            </tr>
                                            }
                                        }
                    
                </tbody>
            </table>
        </div>
    </div>
 

