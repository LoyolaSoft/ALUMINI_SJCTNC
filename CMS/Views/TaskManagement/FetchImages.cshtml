@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{
    ViewBag.Title = "FetchImages";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <!-- ================== END PAGE LEVEL STYLE ================== -->


<!-- begin #page-loader -->
<div id="page-loader" class="fade"><span class="spinner"></span></div>
<!-- end #page-loader -->
<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Image List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Image List</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Image List</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                           @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="col-md-12">
                            <a class="btn btn-primary" onclick="BindImages();">Get</a>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="dvImages">

                    </div>
                </div>
            }
        </div>
    </div>
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
           
        }

        $('.selectpicker').selectpicker({
            size: 5
        });

        $('.selectpicker').selectpicker('refresh');
        
        function BindImages()
        {
            if ($('#ClassList').val())
            {
                $('#dvImages').empty;
                $.ajax({
                    url:'@Url.Action("BindClassWiseImages", "TaskManagement")',
                    method:"POST",
                    datatype:'json',
                    data:{sClassId:$('#ClassList').val()},
                    success:function (data)
                    {
                        if (data.Message!=null && data.Message!='') 
                        {
                            alert(data.Message);
                        }else 
                        {
                            $('#dvImages').append(data);
                        }
                    },error:function (error) 
                    {
                        alert('Internal Server Error !');
                    }
                });
            } else
            {
                alert('Please Select  Class To Continue !');
            }
            //$('.selectpicker').selectpicker('refresh');
        };
    </script>





