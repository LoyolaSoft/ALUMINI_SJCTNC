@model CMS.ViewModel.ViewModel.TaskManagementViewModel

@{
    ViewBag.Title = "ListStudentLeaveRequest";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    int count = 0;
}


@section styles{
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
}
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Student Leave Request</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Student Leave Request</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Student Leave Request</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="col-md-12 table-responsive">
                        <table class="table table-hover table-bordered" id="tblLeaveRequest">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    @*<th>Activity Level</th>*@
                                    <th>Request Date</th>
                                    <th class="col-md-3">Subject</th>
                                    <th class="col-md-4">REASON</th>
                                    <th>Date From</th>
                                    <th>Date To</th>
                                    <th>Approve By</th>
                                    <th>Approved By</th>
                                    <th>Approved Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liStuLeaveRequest != null && Model.liStuLeaveRequest.Count > 0)
                                {
                                    foreach (var item in Model.liStuLeaveRequest)
                                    {
                                        <tr>
                                            <td>@{count++;} @count</td>
                                            <td>@item.REQUEST_DATE</td>
                                            @*<td>@item.ACTIVITY_LEVEL</td>*@
                                            <td>@item.SUBJECT</td>
                                            <td>@item.REASON</td>
                                            <td>@item.DATE_FROM</td>
                                            <td>@item.DATE_TO</td>
                                            <td>@item.APPROVE_BY</td>
                                            <td>@item.NAME</td>
                                            <td>@item.APPROVED_DATE</td>
                                            <td>@item.STATUS_NAME</td>
                                            <td>
                                                @if (item.STATUS != "3")
                                                {
                                                    <a href="@Url.Action("AcademicActivity","TaskManagement",new { sActivityId=@item.LEAVE_REQUEST_ID})"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                                    <a href="#" onclick="Deleteconfirm(@item.LEAVE_REQUEST_ID);"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                                                }
                                            </td>
                                        </tr>
                                                    }
                                                }

                            </tbody>
                        </table>
                    </div>
                </div>

                
            }
        </div>

    </div>
</div>





