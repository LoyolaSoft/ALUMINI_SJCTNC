@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "ListSalaryTemplates";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Salary Template</li>
    </ol>
    <h1 class="page-header">List Salary Template</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Salary Template</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#inventdepart" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tbltemplate">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>TEMPLATE NAME</th>
                            <th>DESCRIPTION</th>
                            <th>STAFF CATEGORY</th>     
                            <th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lisalarytemplate != null && Model.lisalarytemplate.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lisalarytemplate)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>
                                    <td>@item.TEMPLATE_NAME</td>
                                    <td>@item.DESCRIPTION</td>
                                    <td>@item.STF_CATEGORY</td>
                                    <td>
                                        <a href="#inventdepart" onclick="FetchTemplateDetails(@item.TEMPLATE_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.TEMPLATE_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="inventdepart">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="templateid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Template Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="templatename" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Description</label>

                                        <div class="col-md-8">
                                            <textarea  id="description" class="form-control" data-parsley-required="true" style="height:200px"/>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Staff Category</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Staff Category", (Model.STAFF_CATEGORY != null) ? Model.STAFF_CATEGORY : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true",@id= "STAFF_CATEGORY" })
                                            @Html.ValidationMessageFor(model => model.STAFF_CATEGORY, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    var tbl = $('#tbltemplate').DataTable();
    $('#tbltemplate').DataTable();
    function FetchTemplateDetails(ID) 
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchSalaryTemplate", "Payroll")",
                type: "post",
                data: { sTemplateId: ID },
                success: function (data) 
                {
                    if (data != null) 
                    {
                        $('#templateid').val(data.TEMPLATE_ID);
                        $('#templatename').attr('value', data.TEMPLATE_NAME);
                        $('#description').text(data.DESCRIPTION);
                        $('#STAFF_CATEGORY').val(data.STAFF_CATEGORY);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function ()
    {
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
       
        JsonData = '{"TEMPLATE_ID":"' + $('#templateid').val() + '","TEMPLATE_NAME":"' + $('#templatename').val() + '","DESCRIPTION":"' + $('#description').val() + '","STAFF_CATEGORY":"' + $('#STAFF_CATEGORY').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateSalaryTemplate", "Payroll")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data)
            {
                if (data.ErrorCode == "400")
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
                else
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/Payroll/ListSalaryTemplates');
                }
               

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteSalaryTemplate", "Payroll")",
        type: "post",
        data: { sTemplateId: ID },
        success: function (data)
        {
            if (data.ErrorCode == "400")
            {
                swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
            else
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListSalaryTemplates');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

    }


</script>






