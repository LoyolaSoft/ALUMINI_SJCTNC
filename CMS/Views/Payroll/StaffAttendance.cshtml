@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "StaffAttendance";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />
<link href="~/Content/assets/css/timepicki.css" rel="stylesheet"/>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Staff Attendance Status</li>
    </ol>
    <h1 class="page-header">Staff Attendance Status</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Staff Attendance Status</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-4">
                @Html.Label("Date From", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    <input type="text" class="form-control" id="datefrom">
                </div>
            </div>
            <div class="col-md-4">
                @Html.Label("Date To", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    <input type="text" class="form-control" id="dateto">
                </div>
            </div>
          
            <div class="col-md-1">
                <button class="btn btn-primary" id="btnGet">Get</button>
            </div>
            <br>

            <div class="col-md-12" id="bindstaffattendance">

            </div>
        </div>
    </div>
</div>

<div class="modal" id="staffattendance">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="staffattid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Date In</label>

                                        <div class="col-md-8">
                                            <input type="text" id="datein" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Time In</label>

                                        <div class="col-md-8">
                                            <input type="text" id="timein" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Date Out</label>

                                        <div class="col-md-8">
                                            <input type="text" id="dateout" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Time Out</label>

                                        <div class="col-md-8">
                                            <input type="text" id="timeout" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Status</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Status", (Model.LEAVE_STATUS != null) ? Model.LEAVE_STATUS : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "LEAVE_STATUS" })
                                            @Html.ValidationMessageFor(model => model.LEAVE_STATUS, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>
<script src="~/Content/assets/js/timepicki.js"></script>

<script>
    function ContentLoad()
    {
       
        $('.selectpicker').selectpicker('refresh');
       
    }
    $('#fromtime').timepicki({
        min_hour_value: 0,
        max_hour_value: 23
    });
    $('#totime').timepicki({
        min_hour_value: 0,
        max_hour_value: 23
    });
    $('.selectpicker').selectpicker({
        size: 6
    });
    $("#datefrom").datepicker({
        todayHighlight: true,
        autoclose: true,
        endDate: new Date(),
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });
   
    $("#dateto").datepicker({
        todayHighlight: true,
        autoclose: true,
        //  endDate: new Date(),
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });


    $('#btnGet').click(function ()
    {
        if ($('#datefrom').val() && $('#dateto').val())
        {
            $.ajax({
                url: "@Url.Action("BindStaffAttendanceByDate", "Payroll")",
                type: "post",
                data: { sFromDate: $('#datefrom').val(), sToDate: $('#dateto').val() },
                success: function (data)
                {
                    $('#bindstaffattendance').empty();
                    $('#bindstaffattendance').append(data);
                    $('#tblstaffattendance').DataTable({});

                },
                error: function (ex)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
        else
        {
           alert('Please Select Date ...!')
        }
    });



</script>





