@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "ListEmployeeIncrementdetails";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Empolyee Increment Details</li>
    </ol>
    <h1 class="page-header">Empolyee Increment Details</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Empolyee Increment Details</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-3">
                @Html.Label("Year", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                    @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                @Html.Label("Month", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    <select id="Month" class="form-control selectpicker"></select>
                </div>
            </div>
            <div class="col-md-4">
                @Html.Label("Category", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    @Html.DropDownListFor(m => m.STAFF_CATEGORY, (Model.STAFF_CATEGORY != null) ? Model.STAFF_CATEGORY : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                    @Html.ValidationMessageFor(m => m.STAFF_CATEGORY, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary" id="btnGet">Get</button>
            </div>
            <br>

            <div class="col-md-12" id="bindemployeeincrment">

            </div>
            <div class="col-md-12 hidden" id="btnsubmitdiv">
                <div class="col-md-1 pull-right">
                    <button class="btn btn-primary" id="btnSubmit">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        var monthNames = ["--Select--", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        var month = 0;
        for (; month <= monthNames.length; month++) {
            $('#Month').append('<option value=' + month + '>' + monthNames[month] + '</option>');

        }
        $('.selectpicker').selectpicker('refresh');

    }
    $('.selectpicker').selectpicker({
        size: 6

    });
    $('#btnGet').click(function () {

        $.ajax({
            url: "@Url.Action("BindIncrementEmployeeList", "Payroll")",
            type: "post",
            data: { sAcyear: $("#AcademicYearList option:selected").text(), sMonth: $('#Month').val(), sEmpolyeecateogry: $('#STAFF_CATEGORY').val() },
            success: function (data) {
                $('#bindemployeeincrment').empty();
                $('#bindemployeeincrment').append(data);
                $('#tblemployeeincrement').DataTable({});
                $('#btnsubmitdiv').removeClass('hidden');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#btnSubmit').on('click', function ()
    {
        var count = 0;
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            return false;
        }
        $('#tblemployeeincrement tbody tr').each(function ()
        {
          
            if ($(this).find('.ddlincrementstatus').val() == '' || typeof ($(this).find('.ddlincrementstatus').val()) == "undefined" || $(this).find('.ddlincrementstatus').val() == "0")
            {
                count++;
                
                
            }

        });
        
        if (count > 0)
        {

            swal({ title: "Error!", text: "Please Select the Status for All...", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            return false;
           
        }
        var JsonData = '';
        JsonData += '{"Liemployeincrement":[';
        $('#tblemployeeincrement tbody tr').each(function ()
        {
            if ($(this).find('.ddlincrementstatus').val() != '' && typeof ($(this).find('.ddlincrementstatus').val()) != "undefined" && $(this).find('.ddlincrementstatus').val() != "0") {

                JsonData += '{"EMPLOYEE_ID":"' + $(this).attr('employeeid') + '","INCREMENT_DETAILS_ID":"' + $(this).attr('incrementdetailsid') + '","STATUS":"' + $(this).find('.ddlincrementstatus').val() + '","EXPERIENCE_YEAR":"' + $(this).attr('exprience') + '"},';
            }

        });
        JsonData = JsonData.slice(0, -1);
        JsonData += ']}';

        var req = $.ajax({
            url: "@Url.Action("SaveorUpdateEmployeeIncrementDetails", "Payroll")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListEmployeeIncrementdetails');
            },
            error: function (ex)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    });

</script>
