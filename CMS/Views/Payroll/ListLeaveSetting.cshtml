@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "ListLeaveSetting";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Leave Settings</li>
    </ol>
    <h1 class="page-header">List Leave Settings</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Leave Settings</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#leavesettingmodal" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblleavesetting">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Staff Category</th>
                            <th>Leave Type</th>
                            <th>Experience From</th>
                            <th>Experience To</th>
                        
                            <th>MaxDay-Month</th>
                            <th>MaxDay-Year</th>                        
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lileavesetting != null && Model.lileavesetting.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lileavesetting)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>
                                    <td>@item.STF_CATEGORY</td>
                                    <td>@item.LEAVE_TYPE</td>
                                    <td>@item.EXP_YEAR_FROM</td>
                                    <td>@item.EXP_YEAR_TO</td>
                                    <td>@item.M_MAX_DAYS</td>
                                    <td>@item.Y_MAX_DAYS</td>
                                
                                    <td>
                                        <a href="#leavesettingmodal" onclick="FetchLeaveSettingDetails(@item.STF_LEAVE_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.STF_LEAVE_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                       
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>             
            </div>
        </div>
    </div>
</div>


<div class="modal" id="leavesettingmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="stfleavesetid" class="hidden">

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Staff Category</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Staff Category", (Model.STAFF_CATEGORY != null) ? Model.STAFF_CATEGORY : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "STAFF_CATEGORY" })
                                            @Html.ValidationMessageFor(model => model.STAFF_CATEGORY, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Leave Type</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Leave Type", (Model.LEAVE_TYPE != null) ? Model.LEAVE_TYPE : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "LEAVE_TYPE" })
                                            @Html.ValidationMessageFor(model => model.LEAVE_TYPE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">

                                        <label class="col-md-4 control-label">Experience Year From</label>
                                        <div class="col-md-8">
                                            <input type="number" id="fromyear" class="form-control" data-parsley-required = "true">
                                        </div>

                                    </div>
                                    <div class="col-md-12 form-group">

                                        <label class="col-md-4 control-label">Experience Year To</label>
                                        <div class="col-md-8">
                                            <input type="number" id="toyear" class="form-control" data-parsley-required = "true">
                                        </div>

                                    </div>

                                    <div class="col-md-12 form-group" >
                                        
                                            <label class="col-md-4 control-label">Max.Days in Month</label>
                                            <div class="col-md-8">
                                                <input type="number" id="m_maxday" class="form-control">
                                            </div>
                                      
                                    </div>
                                    <div class="col-md-12 form-group">
                                       
                                            <label class="col-md-4 control-label">Max.Days in Year</label>
                                            <div class="col-md-8">
                                                <input type="number" id="y_maxday" class="form-control" data-parsley-required = "true">
                                            </div>
                                       
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label"></label>
                                        <div class="col-md-8 checkbox checkbox-css">
                                            <input type="checkbox" id="cssCheckbox1" value="1">
                                            <label for="cssCheckbox1" class="control-label"><b>Is Carried Next Year</b></label>
                                        </div>
                                    </div>
                                  
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnsub" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    var tbl = $('#tblleavesetting').DataTable();
    $('#tblleavesetting').DataTable();

    function FetchLeaveSettingDetails(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchLeaveSetting", "Payroll")",
                type: "post",
                data: { sLeavesettingId: ID },
                success: function (data)
                {
                    if (data != null)
                    {
                        $('#stfleavesetid').val(data.STF_LEAVE_SETTING_ID);
                        $('#STAFF_CATEGORY').val(data.STAFF_CATEGORY);
                        $('#LEAVE_TYPE').val(data.LEAVE_TYPE);
                        $('#fromyear').val(data.EXP_YEAR_FROM);
                        $('#toyear').val(data.EXP_YEAR_TO);
                        $('#m_maxday').val(data.M_MAX_DAYS);
                        $('#y_maxday').val(data.Y_MAX_DAYS);
                       $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }

    $('#btnsub').click(function ()
    {
       
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
        var iscarried = 0;
        if ($('#cssCheckbox1').is(":checked"))
        {
            iscarried = $('#cssCheckbox1').val();
        }
        JsonData = '{"STF_LEAVE_SETTING_ID":"' + $('#stfleavesetid').val() + '","STAFF_CATEGORY":"' + $('#STAFF_CATEGORY').val() + '","LEAVE_TYPE":"' + $('#LEAVE_TYPE').val() + '","M_MAX_DAYS":"' + $('#m_maxday').val() + '","Y_MAX_DAYS":"' + $('#y_maxday').val() + '","EXP_YEAR_FROM":"' + $('#fromyear').val() + '","EXP_YEAR_TO":"' + $('#toyear').val() + '","IS_CARRIED_NEXT_YEAR":'+iscarried+'}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateLeaveSetting", "Payroll")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data)
            {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListLeaveSetting');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteLeaveSetting", "Payroll")",
        type: "post",
        data: { sLeavesettingId: ID },
        success: function (data)
        {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListLeaveSetting');
            }
        },
        error: function (ex)
        {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
    });

    }
   

</script>


