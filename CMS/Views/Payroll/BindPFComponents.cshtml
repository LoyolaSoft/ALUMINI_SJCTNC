@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    Layout = null;
    int count = 0;
}

<div class="col-md-12">

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Template</th>
                <th>Component</th>
                <th>Calcluation</th>
                <th>Percentage</th>
                <th>Component Type</th>
                <th>Name in Payslip</th>
            </tr>
        </thead>

        @if (Model.litemplatepfcomponent != null && Model.litemplatepfcomponent.Count > 0)
        {
            <tbody>
                @foreach (var item in Model.litemplatepfcomponent)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.TEMPLATE_NAME</td>
                        <td>@item.PF_COMPONENT_NAME</td>
                        <td>
                          @("(" + item.FIRST_COMPONENT + " " + item.OPERATORS + "" + @item.SECOND_COMPONENT + ")")
                        </td>

                        <td>@(@item.PERCENTAGE+"%")</td>
                        <td>@item.SALARY_COMPONENT_NAME</td>
                        <td>@item.NAME_IN_PAYSLIP</td>



                    </tr>
                }
            </tbody>
        }
    </table>
    
</div>
