@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "SalaryPaySlipGeneration";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />
<style>
    .modal {
        text-align: center;
        padding: 0 !important;
    }

        .modal:before {
            content: '';
            display: inline-block;
            height: 100%;
            vertical-align: middle;
            margin-right: -4px;
        }

    .modal-dialog {
        display: inline-block;
        text-align: left;
        vertical-align: middle;
    }
</style>
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Payslip Generation</li>
    </ol>
    <h1 class="page-header">Payslip Generation</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Payslip Generation</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-3">
                @Html.Label("Year", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                    @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                @Html.Label("Month", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    <select id="Month" class="form-control selectpicker">
                     
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                @Html.Label("Category", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-7">
                    @Html.DropDownListFor(m => m.STAFF_CATEGORY, (Model.STAFF_CATEGORY != null) ? Model.STAFF_CATEGORY : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                    @Html.ValidationMessageFor(m => m.STAFF_CATEGORY, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-1">
               <button class="btn btn-primary" id="btnGet">Get</button>
            </div>
            <br>

            <div class="col-md-12" id="bindpayslip">

            </div>
           </div>
    </div>
</div>

<div class="modal" id="proceduremodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Procedure to be Completed</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody1">
                <div class="form-horizontal">
                    <div class="form-group" style="padding:5px">
                        <div class="col-md-12 form-group">
                            <label class="col-md-8 control-label" style="text-align:left"><b>1.Salary template</b></label>
                            <div class="col-md-4 checkbox checkbox-css">

                                @if (Model.lisalarytemplate != null && Model.lisalarytemplate.Count > 0)
                                {
                                    <input type="checkbox" id="salarytemplate" checked disabled>
                                }
                                else
                                {
                                    <input type="checkbox" id="salarytemplate" disabled>

                                }
                                <label for="salarytemplate" class="control-label"><b></b></label>
                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <label class="col-md-8 control-label" style="text-align:left"><b>2.salary template components</b></label>
                            <div class="col-md-4 checkbox checkbox-css">

                                @if (Model.lisalarytemplatecomponent != null && Model.lisalarytemplatecomponent.Count > 0 || Model.litemplatepfcomponent != null && Model.litemplatepfcomponent.Count > 0)
                                {
                                    <input type="checkbox" id="salarycomponents" checked disabled>
                                }
                                else
                                {
                                    <input type="checkbox" id="salarycomponents" disabled>

                                }
                                <label for="salarycomponents" class="control-label"><b></b></label>

                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <label class="col-md-8 control-label" style="text-align:left"><b>3.Increment mapped template</b></label>
                            <div class="col-md-4 checkbox checkbox-css">

                                @if (Model.lisalarytemplateincrements != null && Model.lisalarytemplateincrements.Count > 0)
                                {
                                    <input type="checkbox" id="incrementtemplate" checked disabled>
                                }
                                else
                                {
                                    <input type="checkbox" id="incrementtemplate" disabled>
                                }
                                <label for="incrementtemplate" class="control-label"><b></b></label>

                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <label class="col-md-8 control-label" style="text-align:left"><b>4.Employee Leave Setting</b></label>
                            <div class="col-md-4 checkbox checkbox-css">

                                @if (Model.lileavesetting != null && Model.lileavesetting.Count > 0)
                                {
                                    <input type="checkbox" id="leavesetting" checked disabled>
                                }
                                else
                                {
                                    <input type="checkbox" id="leavesetting" disabled>

                                }
                                <label for="leavesetting" class="control-label"><b></b></label>

                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <label class="col-md-8 control-label" style="text-align:left"><b>5.Employee salary template</b></label>
                            <div class="col-md-4 checkbox checkbox-css">

                                @if (Model.liemployeesalarytemplate != null && Model.liemployeesalarytemplate.Count > 0)
                                {
                                    <input type="checkbox" id="employeetemplate" checked disabled>
                                }
                                else
                                {
                                    <input type="checkbox" id="employeetemplate" disabled>

                                }
                                <label for="employeetemplate" class="control-label"><b></b></label>

                            </div>
                        </div>
                        <div class="col-md-12 col-md-offset-2 form-group">
                            <div class="col-md-10 col-md-offset-2">
                                <label class="label label-info"><span style="color:black;font-size:14px;">Please complete the following steps before generate the payslip...!</span></label>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad()
    {
        $('#proceduremodal').modal({
            show: 'true'
        });

        var monthNames = ["--Select--","January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        var month = 0;
        for (; month <= monthNames.length; month++)
        {
            $('#Month').append('<option value=' + month + '>' + monthNames[month] + '</option>');
           
        }
        $('.selectpicker').selectpicker('refresh');
    }
    $('.selectpicker').selectpicker({
        size: 6
    });

    $('#btnGet').click(function ()
    {
        
        $.ajax({
            url: "@Url.Action("BindPaySlipGeneration", "Payroll")",
            type: "post",
            data: { sAcyear: $("#AcademicYearList option:selected").text(), sMonth: $('#Month').val(), sEmpolyeecateogry: $('#STAFF_CATEGORY').val() },
            success: function (data)
            {
                $('#bindpayslip').empty();
                $('#bindpayslip').append(data);

            },
            error: function (ex)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

  

</script>




