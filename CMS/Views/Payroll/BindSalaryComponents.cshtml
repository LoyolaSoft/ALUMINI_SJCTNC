@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    Layout = null;
    int count = 0;
}

<div class="col-md-12">

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Template</th>
                <th>Component</th>
                <th>Percentage/Flat</th>
                <th>Percentage Component</th>
                <th>Component Type</th>
                <th>Name in Payslip</th>
            </tr>
        </thead>

        @if (Model.lisalarytemplatecomponent != null && Model.lisalarytemplatecomponent.Count > 0)
        {
            <tbody>
                @foreach(var item in Model.lisalarytemplatecomponent)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.TEMPLATE_NAME</td>
                        <td>@item.COMPONENT_NAME</td>
                        <td>
                            @if (item.PERCENTAGE != "")
                            {
                                @(@item.PERCENTAGE+"%")

                            }
                            else
                            {
                                @item.FLAT_AMOUNT
                            }
                        </td>

                        <td>
                            @if (item.PERCENTAGE_COMPONENT_ID != "")
                            {

                                @item.PERCENTAGE_COMPONENT_ID
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td>@item.SALARY_COMPONENT_NAME</td>
                        <td>@item.NAME_IN_PAYSLIP</td>
                    

                    </tr>
                }
            </tbody>
        }
    </table>
    
</div>