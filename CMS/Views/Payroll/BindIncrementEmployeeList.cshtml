
@model CMS.ViewModel.ViewModel.PayrollViewModel
    @{ 
        Layout = null;
        int count = 0;
    }
<div class="col-md-12" data-parsley-validate="true" id="pBody">
    <table class="table table-bordered" id="tblemployeeincrement">
        <thead>
            <tr>
                <td>#</td>
                <td>Employee</td>
                <td>DOJ</td>
                <td>Template</td>
                <td>EXPRIENCE</td>
                <td>AMOUNT</td>
                <td>STATUS</td>
            </tr>
        </thead>
        <tbody>
            @if(Model.liEmployeeincrementdetails!=null && Model.liEmployeeincrementdetails.Count>0)
            {
                foreach(var item in Model.liEmployeeincrementdetails)
                {
                    count++;
                    <tr employeeid="@item.EMPLOYEE_ID" incrementdetailsid="@item.INCREMENT_DETAILS_ID" exprience="@item.CURRENT_COUNT">
                        <td>@count</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.DATE_OF_JOIN</td>
                        <td>@item.TEMPLATE_NAME</td>
                        <td>@item.CURRENT_COUNT</td>
                        <td>@item.AMOUNT</td>
                        <td>
                            <select class="selectpicker form-control ddlincrementstatus" data-live-search="true" data-parsley-required="true">
                                <option empsalarytemid="" staffid="" value="0">--Select--</option>
                                @foreach (SelectListItem option in Model.INCREMENT_STATUS)
                                {
                                    <option value="@option.Value" @(option.Value == item.STATUS ? "selected='selected'" : "")>@option.Text</option>

                                }
                            </select>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>
