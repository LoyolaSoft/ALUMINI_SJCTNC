@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "ListPaidleaveEntry";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Paid Leave</li>
    </ol>
    <h1 class="page-header">List Paid Leave</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Paid Leave</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#paidleave" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblpaidleave">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Date From</th>
                            <th>Date To</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lipaidleaveentry != null && Model.lipaidleaveentry.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lipaidleaveentry)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>
                                    <td>@item.FIRST_NAME</td>
                                    <td>@item.LEAVE_TYPE</td>
                                    <td>@item.DATE_FROM</td>
                                    <td>@item.DATE_TO</td>

                                    <td>
                                        <a href="#paidleave" onclick="FetchPaidleaveDetails(@item.PAID_LEAVE_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.PAID_LEAVE_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
              
            </div>
        </div>
    </div>
</div>


<div class="modal" id="paidleave">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="paidleaveid" class="hidden">

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Employee</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Employee", (Model.EMPLOYEE != null) ? Model.EMPLOYEE : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "EMPLOYEE" })
                                            @Html.ValidationMessageFor(model => model.EMPLOYEE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Leave Type</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Leave Type", (Model.LEAVE_TYPE != null) ? Model.LEAVE_TYPE : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "LEAVE_TYPE" })
                                            @Html.ValidationMessageFor(model => model.LEAVE_TYPE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">

                                        <label class="col-md-4 control-label">Date From</label>
                                        <div class="col-md-8">
                                            <input type="text" id="fromdate" class="form-control">
                                        </div>

                                    </div>
                                    <div class="col-md-12 form-group">

                                        <label class="col-md-4 control-label">Date To</label>
                                        <div class="col-md-8">
                                            <input type="text" id="todate" class="form-control">
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnsub" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });

    $("#fromdate,#todate").datepicker({
        todayHighlight: true,
        autoclose: true,
        startDate: new Date(),
        //endDate: new Date(),
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });
    var tbl = $('#tblpaidleave').DataTable();
    $('#tblpaidleave').DataTable();

    function FetchPaidleaveDetails(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchPaidleaveEntry", "Payroll")",
                type: "post",
                data: { sPaidleaveid: ID },
                success: function (data)
                {
                    if (data != null)
                    {
                        $('#paidleaveid').val(data.PAID_LEAVE_ID);
                        $('#EMPLOYEE').val(data.EMPLOYEE_ID);
                        $('#LEAVE_TYPE').val(data.LEAVE_TYPE_ID);
                        $('#fromdate').val(data.DATE_FROM);
                        $('#todate').val(data.DATE_TO);
                       $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }

    $('#btnsub').click(function ()
    {

        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }

        JsonData = '{"PAID_LEAVE_ID":"' + $('#paidleaveid').val() + '","EMPLOYEE_ID":"' + $('#EMPLOYEE').val() + '","LEAVE_TYPE_ID":"' + $('#LEAVE_TYPE').val() + '","DATE_FROM":"' + $('#fromdate').val() + '","DATE_TO":"' + $('#todate').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdatePaidleaveEntry", "Payroll")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data)
            {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListPaidleaveEntry');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeletePaidleaveentry", "Payroll")",
        type: "post",
        data: { sPaidleaveid: ID },
        success: function (data)
        {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListPaidleaveEntry');
            }
        },
        error: function (ex)
        {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
    });

    }


</script>




