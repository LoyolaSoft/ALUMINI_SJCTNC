@model CMS.ViewModel.ViewModel.PayrollViewModel
@{
    ViewBag.Title = "ListStaffworkingdetails";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />
<link href="~/Content/assets/css/timepicki.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Staff Working time details</li>
    </ol>
    <h1 class="page-header">List Staff Working time details</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Staff Working time details</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#staffworkingdetails" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblstaffworkingtimes">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Staff Category</th>
                            <th>Shift</th>
                            <th>Time In</th>
                            <th>Time Out</th> 
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.listaffworkingtimedetails != null && Model.listaffworkingtimedetails.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.listaffworkingtimedetails)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>
                                    <td>@item.STF_CATEGORY</td>
                                    <td>@item.SHIFT_NAME</td>
                                    <td>@item.TIME_IN</td>
                                    <td>@item.TIME_OUT</td>
                                    <td>
                                        <a href="#staffworkingdetails" onclick="FetchStaffWorkingdetails(@item.STAFF_WORKING_TIME_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.STAFF_WORKING_TIME_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="staffworkingdetails">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="staffworkingtimeid" class="hidden">
                                    
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Staff Category</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Staff Category", (Model.STAFF_CATEGORY != null) ? Model.STAFF_CATEGORY : Enumerable.Empty<SelectListItem>(),"--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "STAFF_CATEGORY" })
                                            @Html.ValidationMessageFor(model => model.STAFF_CATEGORY, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                       c
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Time In</label>

                                        <div class="col-md-8">
                                            <input type="text" id="timein" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Time Out</label>

                                        <div class="col-md-8">
                                            <input type="text" id="timeout" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>
<script src="~/Content/assets/js/timepicki.js"></script>


<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('#timein').timepicki({       
        min_hour_value: 0,
        max_hour_value: 12,
        overflow_minutes: true,
        increase_direction: 'up',
        disable_keyboard_mobile: true
    });
    $('#timeout').timepicki({
        min_hour_value: 0,
        max_hour_value:12,      
        overflow_minutes: true,
        increase_direction: 'up',
        disable_keyboard_mobile: true
    });
  
    $('.selectpicker').selectpicker({
        size: 6
    }); 
    $('#tblstaffworkingtimes').DataTable();

    function FetchStaffWorkingdetails(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchStaffWorkingdetails", "Payroll")",
                type: "post",
                data: { sStaffworkingtimeId: ID },
                success: function (data)
                {
                    if (data != null)
                    {
                        $('#staffworkingtimeid').val(data.STAFF_WORKING_TIME_ID);
                        $('#STAFF_CATEGORY').attr('value', data.STAFF_CATEGORY);
                        $('#SHIFT').val(data.SHIFT);
                        $('#timein').val(data.TIME_IN);
                        $('#timeout').val(data.TIME_OUT);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function ()
    {
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }

        JsonData = '{"STAFF_WORKING_TIME_ID":"' + $('#staffworkingtimeid').val() + '","STAFF_CATEGORY":"' + $('#STAFF_CATEGORY').val() + '","SHIFT":"' + $('#SHIFT').val() + '","TIME_IN":"' + $('#timein').val() + '","TIME_OUT":"' + $('#timeout').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateStaffWorkingdetails", "Payroll")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data)
            {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListStaffworkingdetails');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteStaffWorkingtimes", "Payroll")",
        type: "post",
        data: { sStaffworkingtimeId: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Payroll/ListStaffworkingdetails');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

    }


</script>






