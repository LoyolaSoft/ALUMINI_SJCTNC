<script>
        ContentLoad = function () {
            $('.selectpicker').selectpicker({
                size: 5
            });
            $('.selectpicker').selectpicker('refresh');


            $('#BindIssuedBooks').addClass("active in");
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = dd + '/' + mm + '/' + yyyy;
           // document.getElementById('DATE').value = today;
            $('input[name="txtDate"]').val(today);

        }

        handleDatepicker = function () {
            "use strict";


            $("input[name='txtDate']").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();

    var title;
    var date;
    var action;
    var year;

    $('button[name="btnGet"]').click(function () {

            date = $('.tab-pane.fade.active.in').find('input[name="txtDate"]').val();
             year = $('.tab-pane.fade.active.in').find('#sAcademicYearList option:selected').text();
             action = $('.tab-pane.fade.active.in').attr('id');
             title = action.split('Bind');

             if (year && action)
            {
                $.ajax({
                    url: "/Library/" + action + "",
                    type:"post",
                    data: { sYear: year,sDate : date },

                    success:function(data)
                    {

                        if(data.Message!=null)
                        {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        }
                        else
                        {
                            //$('#btnPrint').removeClass("hidden");
                            //$('#btnExport').removeClass("hidden");



                            $('#dvGrievanceReport').html('');
                            $('#dvGrievanceReport').append(data);
                            $('#lblReportName').text(title[1].toUpperCase() + "-" + date);
                        }
                    },
                    error:function()
                    {
                        //$('#btnPrint').addClass("hidden");
                        //$('#btnExport').addClass("hidden");



                        swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }


                });
            }
            else
            {
                swal({ title: "Error !", text: "Plese select the date!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });


        $('.nav-items').on("click", function () {

            $('#dvGrievanceReport').html('');

        });




</script>




