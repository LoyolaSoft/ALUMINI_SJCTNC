@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "ListBookDetails";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}




<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Book Details </li>
    </ol>
    <h1 class="page-header">List Book Details </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Book Details </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/Library/AddBookDetails')"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblBookDetails">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Rack</th>
                            <th>Access No</th>
                            <th>Class No</th>
                            <th>Language</th>
                            <th>Personal Author1</th>
                            <th>Personal Author2</th>
                            @*<th>Joined Author1</th>
                            <th>Joined Author2</th>
                            <th>Corporate Author1</th>
                            <th>Corporate Author2</th>*@
                            <th>Doc Title</th>
                            <th>Parrellel Title</th>
                            @*<th>Notes</th>
                            <th>Physical Discription</th>*@
                            @*<th>Illustrate</th>*@
                            <th>Status</th>
                            <th>Price</th>
                            <th>DOP</th>
                            <th>Isbn No</th>
                            @*<th>Dis Code</th>
                            <th>Name of Publisher</th>
                            <th>Place of Publisher</th>*@
                            <th>BARCODE</th>
                            <th>RFID</th>
                            @*<th>Lib Code</th>
                            <th>Book Publish Year</th>*@
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liBookDetails != null && Model.liBookDetails.Count>0)
                        {
                            foreach (var item in Model.liBookDetails)
                            {
                                <tr>
                                    <td>@{count++;} @count</td>
                                    <td>@item.RACK_ID</td>
                                    <td>@item.ACCESS_NO</td>
                                    <td>@item.CLASS_NO</td>
                                    <td>@item.LANGUAGE</td>
                                    <td>@item.PERSONAL_AUTHOR1</td>
                                    <td>@item.PERSONAL_AUTHOR2</td>
                                    @*<td>@item.JOINED_AUTHOR1</td>
                                    <td>@item.JOINED_AUTHOR2</td>
                                    <td>@item.CORPORATE_AUTHOR1</td>
                                    <td>@item.CORPORATE_AUTHOR2</td>*@
                                    <td>@item.DOC_TITLE</td>
                                    <td>@item.PARALLEL_TITLE</td>
                                    @*<td>@item.NOTES</td>
                                    <td>@item.PHYDESC</td>
                                    <td>@item.ILLUSTRATE</td>*@
                                    <td>@item.STATUS</td>
                                    <td>@item.PRICE</td>
                                    <td>@item.DOP</td>
                                    <td>@item.ISBN_NO</td>
                                    @*<td>@item.DISIPLINE</td>
                                    <td>@item.NAME_OF_PUBLISHER</td>
                                    <td>@item.PLACE_OF_PUBLISHER</td>*@
                                    <td>@item.BARCODE</td>
                                    <td>@item.RFID</td>
                                    @*<td>@item.LIB_CODE</td>
                                    <td>@item.BOOK_PUBLISH_YEAR</td>*@
                                    <td>
                                         <a href="javascript:;" class="text-primary" onclick="loadContent('/Library/AddBookDetails?sBookId=@item.BOOK_ID');" title="Click To Edit"><i class="fa fa-edit"></i></a>                    
                                        <a href="javascript:;" onclick="GetConfrim(@item.BOOK_ID);" title="Click To Delete"><i class="fa fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        function ContentLoad()
        {
            $('#tblBookDetails').DataTable({ "bPaginate": false, });
            // Document Ready Function .
        }
        
        function GetConfrim(Id)
        {
            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
                function () {
                    $.ajax({
                        url: '@Url.Action("DeleteBookDetails", "Library")',
                        method: 'POST',
                        datatype: 'json',
                        data: { sBookId: Id },
                        success: function (data)
                        {
                            if (data.ErrorCode == '200')
                            {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                                //loadContent("/Library/ListBookDetails?sBookId="+data.sResult+"");
                            }
                            else
                            {
                                swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                            }
                        }, error: function (error)
                        {
                            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    });

                });
        }
</script>
