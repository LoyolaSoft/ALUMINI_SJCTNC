<script>
    ContentLoad = function () {
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

        $('#BindIssuedBooks').addClass("active in");
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1;
        var yyyy = today.getFullYear();
        if (dd < 10) { dd = '0' + dd; }
        if (mm < 10) { mm = '0' + mm; }
        var todayStr = dd + '/' + mm + '/' + yyyy;
        $('input[name="txtFromDate"]').val(todayStr);
        $('input[name="txtToDate"]').val(todayStr);
    };

    handleDatepicker = function () {
        "use strict";
        $("input[name='txtFromDate'], input[name='txtToDate']").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
    };
    handleDatepicker();

    // Shared Date-Wise PDF Splitting Function for DataTables
    window.splitPdfDateWise = function (doc, dateColIdx, reportTitle, collegeName, fromDate, toDate) {
        if (!doc || !doc.content || doc.content.length < 2) return;

        var tableItem = null;
        var tableIndex = -1;
        for (var i = 0; i < doc.content.length; i++) {
            if (doc.content[i] && doc.content[i].table) {
                tableItem = doc.content[i];
                tableIndex = i;
                break;
            }
        }
        if (!tableItem || !tableItem.table || !tableItem.table.body || tableItem.table.body.length <= 1) return;

        var body = tableItem.table.body;
        var headerRow = body[0];
        var dataRows = body.slice(1);

        // Group rows by Date column
        var groups = {};
        var dateOrder = [];

        for (var r = 0; r < dataRows.length; r++) {
            var row = dataRows[r];
            var dateVal = '';
            if (dateColIdx >= 0 && row[dateColIdx]) {
                var c = row[dateColIdx];
                dateVal = (typeof c === 'object' && c.text !== undefined ? c.text : c).toString().trim();
            }
            if (!dateVal) dateVal = (fromDate || 'All Dates');

            if (!groups[dateVal]) {
                groups[dateVal] = [];
                dateOrder.push(dateVal);
            }
            groups[dateVal].push(row);
        }

        // Set default font size and table header styles
        doc.defaultStyle = doc.defaultStyle || {};
        doc.defaultStyle.fontSize = 8.5;
        doc.styles = doc.styles || {};
        doc.styles.tableHeader = {
            bold: true,
            fontSize: 9,
            color: '#ffffff',
            fillColor: '#2563eb',
            alignment: 'center'
        };

        // If only 1 date, re-sequence serial numbers without page breaks
        if (dateOrder.length <= 1) {
            for (var k = 0; k < dataRows.length; k++) {
                if (dataRows[k][0]) {
                    if (typeof dataRows[k][0] === 'object') {
                        dataRows[k][0].text = (k + 1).toString();
                        dataRows[k][0].alignment = 'center';
                    } else {
                        dataRows[k][0] = { text: (k + 1).toString(), alignment: 'center' };
                    }
                }
            }
            return;
        }

        // Multiple dates: Split content date-wise
        var newContent = [];
        var rangeDesc = (fromDate === toDate) ? fromDate : (fromDate + ' to ' + toDate);

        for (var d = 0; d < dateOrder.length; d++) {
            var dt = dateOrder[d];
            var rowsForDt = groups[dt];

            if (d > 0) {
                newContent.push({
                    text: (collegeName ? collegeName + '\n' : '') + reportTitle.toUpperCase() + ' (' + rangeDesc + ')',
                    fontSize: 11,
                    bold: true,
                    alignment: 'center',
                    color: '#1e3a8a',
                    pageBreak: 'before',
                    margin: [0, 0, 0, 6]
                });
            } else {
                newContent.push({
                    text: (collegeName ? collegeName + '\n' : '') + reportTitle.toUpperCase() + ' (' + rangeDesc + ')',
                    fontSize: 13,
                    bold: true,
                    alignment: 'center',
                    color: '#1e3a8a',
                    margin: [0, 0, 0, 10]
                });
            }

            var sectionHeader = {
                text: 'DATE: ' + dt + '   |   TOTAL RECORDS: ' + rowsForDt.length,
                fontSize: 11,
                bold: true,
                color: '#1e40af',
                margin: [0, 4, 0, 6]
            };

            newContent.push(sectionHeader);

            var dateTableBody = [];
            dateTableBody.push(JSON.parse(JSON.stringify(headerRow)));

            for (var j = 0; j < rowsForDt.length; j++) {
                var rowCopy = JSON.parse(JSON.stringify(rowsForDt[j]));
                if (rowCopy[0]) {
                    if (typeof rowCopy[0] === 'object') {
                        rowCopy[0].text = (j + 1).toString();
                        rowCopy[0].alignment = 'center';
                    } else {
                        rowCopy[0] = { text: (j + 1).toString(), alignment: 'center' };
                    }
                }
                dateTableBody.push(rowCopy);
            }

            newContent.push({
                table: {
                    headerRows: 1,
                    widths: tableItem.table.widths || Array(headerRow.length).fill('*'),
                    body: dateTableBody
                },
                layout: {
                    hLineWidth: function () { return 0.5; },
                    vLineWidth: function () { return 0.5; },
                    hLineColor: function () { return '#cbd5e1'; },
                    vLineColor: function () { return '#cbd5e1'; },
                    paddingLeft: function () { return 4; },
                    paddingRight: function () { return 4; },
                    paddingTop: function () { return 3; },
                    paddingBottom: function () { return 3; }
                },
                margin: [0, 0, 0, 15]
            });
        }

        doc.content = newContent;
    };

    // Shared Print Formatter for DataTables Print View with Solid Borders & Date Splitting
    window.formatDataTablePrint = function (win, reportTitle, collegeName, dateRangeStr, dateColIdx) {
        if (!win || !win.document) return;
        $(win.document.body).find('h1').remove();

        var headerHtml = '<div style="text-align:center; margin-bottom:15px;">' +
            (collegeName ? '<h2 style="margin:0 0 5px 0; font-size:18px; font-weight:bold; text-transform:uppercase;">' + collegeName + '</h2>' : '') +
            '<h4 style="margin:0 0 5px 0; font-size:14px; font-weight:bold; color:#1e3a8a;">' + (reportTitle || '').toUpperCase() + '</h4>' +
            (dateRangeStr ? '<h5 style="margin:0 0 10px 0; font-size:12px; color:#475569;">Date Range: ' + dateRangeStr + '</h5>' : '') +
            '</div>';
        $(win.document.body).prepend(headerHtml);

        var $table = $(win.document.body).find('table');
        $table.addClass('compact').css({
            'border-collapse': 'collapse',
            'width': '100%'
        });

        // Group rows date-wise if dateColIdx is provided and multiple dates exist
        if (dateColIdx !== undefined && dateColIdx !== null && dateColIdx >= 0) {
            var $tbody = $table.find('tbody');
            var $rows = $tbody.find('tr');
            var groups = {};
            var dateOrder = [];

            $rows.each(function () {
                var $cells = $(this).find('td');
                var dtVal = $cells.eq(dateColIdx).text().trim() || (dateRangeStr || 'All Dates');
                if (!groups[dtVal]) {
                    groups[dtVal] = [];
                    dateOrder.push(dtVal);
                }
                groups[dtVal].push($(this));
            });

            if (dateOrder.length > 1) {
                var $container = $('<div></div>');
                for (var d = 0; d < dateOrder.length; d++) {
                    var dt = dateOrder[d];
                    var groupRows = groups[dt];
                    var $section = $('<div></div>');
                    if (d > 0) {
                        $section.css({ 'page-break-before': 'always', 'break-before': 'page' });
                        $section.append(headerHtml);
                    }
                    $section.append(
                        '<div style="font-size:12px; font-weight:bold; color:#1e40af; margin: 8px 0 6px 0;">' +
                        'DATE: ' + dt + ' &nbsp;&nbsp;|&nbsp;&nbsp; TOTAL RECORDS: ' + groupRows.length +
                        '</div>'
                    );
                    var $newTable = $table.clone();
                    var $newTbody = $newTable.find('tbody').empty();
                    for (var r = 0; r < groupRows.length; r++) {
                        var $rCopy = groupRows[r].clone();
                        $rCopy.find('td').eq(0).text(r + 1).css('text-align', 'center');
                        $newTbody.append($rCopy);
                    }
                    $section.append($newTable);
                    $container.append($section);
                }
                $table.replaceWith($container);
            }
        }

        $(win.document.head).append(
            '<style>' +
            '@@page { size: auto; margin: 10mm; }' +
            'body { font-family: Arial, Helvetica, sans-serif !important; font-size: 11px !important; color: #111 !important; padding: 10px !important; }' +
            'table { border-collapse: collapse !important; width: 100% !important; margin-top: 6px !important; margin-bottom: 12px !important; }' +
            'table, th, td { border: 1px solid #333 !important; }' +
            'th { background-color: #f1f5f9 !important; font-weight: bold !important; text-align: center !important; vertical-align: middle !important; padding: 6px 8px !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }' +
            'td { padding: 5px 8px !important; vertical-align: middle !important; }' +
            '.text-center { text-align: center !important; }' +
            '.text-right { text-align: right !important; }' +
            '</style>'
        );
        $(win.document.body).find('table, th, td').css({
            'border': '1px solid #333'
        });
    };

    $('button[name="btnGet"]').click(function () {
        var $activePane = $('.tab-pane.active');
        if ($activePane.length === 0) {
            $activePane = $('.tab-pane.fade.in');
        }
        var fromDate = $activePane.find('input[name="txtFromDate"]').val();
        var toDate = $activePane.find('input[name="txtToDate"]').val();
        var action = $activePane.attr('id');

        if (!fromDate) {
            swal({ title: "Warning !", text: "Please select From Date!", type: 'warning' });
            return;
        }
        if (!toDate) {
            toDate = fromDate;
            $activePane.find('input[name="txtToDate"]').val(toDate);
        }

        // Validate From Date <= To Date
        var partsFrom = fromDate.split('/');
        var partsTo = toDate.split('/');
        if (partsFrom.length === 3 && partsTo.length === 3) {
            var dFrom = new Date(partsFrom[2], partsFrom[1] - 1, partsFrom[0]);
            var dTo = new Date(partsTo[2], partsTo[1] - 1, partsTo[0]);
            if (dFrom > dTo) {
                swal({ title: "Invalid Dates !", text: "From Date cannot be greater than To Date.", type: 'warning' });
                return;
            }
        }

        var title = action ? action.replace('Bind', '') : '';

        $('#dvGrievanceReport').html('<div class="text-center" style="padding: 40px;"><i class="fa fa-spinner fa-spin fa-3x text-primary"></i><div style="margin-top: 12px; font-weight: 600; font-size: 15px;">Loading report data...</div></div>');

        $.ajax({
            url: "/Library/" + action,
            type: "POST",
            data: { sFromDate: fromDate, sToDate: toDate, sDate: fromDate },
            success: function (data) {
                if (data && data.Message != null) {
                    swal({ title: "Notice", text: data.Message, showConfirmButton: true, type: 'info' });
                    $('#dvGrievanceReport').html('<div class="alert alert-info text-center">' + data.Message + '</div>');
                } else {
                    $('#dvGrievanceReport').html(data);
                    var rangeText = (fromDate === toDate) ? fromDate : (fromDate + " to " + toDate);
                    $('#lblReportName').text(title.toUpperCase() + " (" + rangeText + ")");
                }
            },
            error: function () {
                swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: true, type: 'error' });
                $('#dvGrievanceReport').html('<div class="alert alert-danger text-center">Failed to load report data. Please try again.</div>');
            }
        });
    });

              
        $('.nav-items').on("click", function () {

            $('#dvGrievanceReport').html('');

        });

    $('#btnTitlesearchsubject').click(function () {

        var subjectType = $('#subjectwiseid').val();
        var AcYear = String($('#ACYearForTitleSearchsubject').val());
        var AcYearText = $('#ACYearForTitleSearchsubject option:selected').map(function () {
            return $(this).text();
        }).get().join(', ');

        // Show loading animation
        $('#loading').removeClass('hidden');

        // Clear previous data
        $('#dvGrievanceReport').empty();

        $.ajax({
            url: "/Library/FetchBookInfoBySubjectWise",
            type: "post",
            data: { subjecttype: subjectType.toString(), sAcYear: AcYear, ssacyear: AcYearText },
            success: function (data) {

                if (data.Message != null) {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
                else {
                    // Hide loading animation
                    $('#loading').addClass('hidden');

                    $('#dvGrievanceReport').html('');
                    $('#dvGrievanceReport').append(data);
                    //$('#lblReportName').text(title[1].toUpperCase() + "-" + date);
                }
            },
            error: function () {
                swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }


        });


    });
       
    
</script>



