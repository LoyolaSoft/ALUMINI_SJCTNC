

@model CMS.ViewModel.ViewModel.LibraryViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BindYearReservedBooks";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

@if (Model.liReportFields != null && Model.liReportFields.Count > 0)
{
    int nCount = 0; string sCancelled = string.Empty; string sSMSSent = string.Empty;
    <div class="col-md-12 table-responsive">

        @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
        {
            <div class="text-center">
                @*<img class="image" />*@
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
            </div>
                <div class="text-center">

                    <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                    <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                    @*<h5>
                        LIBRARY  REPORT FOR <label id="lblReportName">m</label> &nbsp;-(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                            { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } }) <br />
                    </h5>*@
                </div>
                            }
        <br />
        <hr />

        <div style="page-break-after:avoid !important;page-break-inside:avoid !important;" class="table-responsive">
            <table class="table table-bordered  table-hover" id="tbllibReport">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Photo</th>
                        <th>Roll No/Employee No</th>
                        <th>Name</th>
                        <th>Access No</th>
                        <th>Title</th>
                        <th>Is Cancelled</th>
                        <th>Sms Sent</th>
                        <th>Entry Date</th>
                        <th>Approved Date</th>
                        <th>Cancelled Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.liReportFields)
                    {
                        sSMSSent = string.Empty;

                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>
                                <img src="@item.PHOTO" alt="" class="image" width="60" height="60">
                            </td>
                            <td>@item.USERNAME</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.ACCESS_NO</td>
                            <td>@item.BOOK_TITLE</td>
                            <td>
                                @if (item.IS_USER_CANCELLED == "1")
                                {
                                    sCancelled = "User Cancelled";
                                }
                                else if (item.IS_SYSTEM_CANCELLED == "1")
                                {
                                    sCancelled = "System Cancelled";
                                }
                                else if (item.IS_CANCELLED == "1")
                                {
                                    sCancelled = "Admin Cancelled";
                                }
                                else
                                {
                                    sCancelled = string.Empty;
                                }
                                @sCancelled
                            </td>
                            <td>
                                @if (item.CANCELLED_SMS == "1")
                                {
                                    sSMSSent = "Cancel SMS Sent";
                                }
                                @if (item.APPROVED_SMS == "1")
                                {
                                    sSMSSent = "Approved SMS Sent";
                                }
                                @if (item.SYSTEM_CANCELLED_SMS == "1")
                                {
                                    sSMSSent = "System Cancelled SMS Sent";
                                }
                                @sSMSSent
                            </td>
                            <td>@item.ENTRY_DATE</td>
                            <td>@item.APPROVED_DATE</td>
                            <td>@item.CANCELLED_DATE</td>
                        </tr>

                                }
                </tbody>
            </table>
            <hr />
        </div>
    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger">No Record(s) Found !</div>
                                }

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    $("#tbllibReport").DataTable({
        "aaSorting": [],
        dom: "lBfrtip", buttons: [{ extend: "copy", className: "btn-sm" },
        { extend: "excel", className: "btn-sm" },
        { extend: "pdf", className: "btn-sm" },
        { extend: "print", className: "btn-sm" }
        ]
    });
</script>

