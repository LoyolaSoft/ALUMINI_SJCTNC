          else {
              $('#divProgrammeLevel').addClass("hidden");
              $('#divProgrammeLevel').find("select").attr('data-parsley-required',false);
          }

      }
        if ($('#UserType').val() == S) {
            if ($('#divSupRole').hasClass("hidden")) {

                $('#divSupRole').removeClass("hidden");
                // $('#divSupRole').find("select").show();
                $('#divSupRole').find("select").attr('data-parsley-required',true);
            }
            else {

            }

            if ($('#divProgrammeLevel').hasClass("hidden")) {

                $('#divProgrammeLevel').removeClass("hidden");
                // $('#divSupRole').find("select").show();
                $('#divProgrammeLevel').find("select").attr('data-parsley-required',true);
            }
            else {

            }
        }

        if ($('#UserType').val() == EX) {
            if ($('#divSupRole').hasClass("hidden")) {


            }
            else {
                $('#divSupRole').addClass("hidden");
                $('#divSupRole').find("select").attr('data-parsley-required',false);
            }

            if ($('#divProgrammeLevel').hasClass("hidden")) {


            }
            else {
                $('#divProgrammeLevel').addClass("hidden");
                $('#divProgrammeLevel').find("select").attr('data-parsley-required',false);
            }
        }

    });



</script>



