
@model CMS.ViewModel.ViewModel.LibraryViewModel
@using CMS.Utility
@{
    ViewBag.Title = "Periods";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Library Peroids</li>
    </ol>
    <h1 class="page-header">Library Peroids</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Library Peroids</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblLiRules">
                    <thead>
                        <tr>
                            <th>#</th>

                            <th>User Type</th>
                            <th>Role</th>
                            <th>Application Type</th>
                            <th>Semester Begin Date</th>
                            <th>Semester End Date</th>
                            <th>Semester Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liPeriods != null && Model.liPeriods.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liPeriods)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.USER_TYPE</td>
                                    <td>@item.ROLE</td>
                                    <td>@item.PROGRAMME_LEVEL</td>
                                    <td>@item.SEM_BEGIN_DATE</td>
                                    <td>@item.SEM_END_DATE</td>
                                    <td>@item.SEMESTER_TYPE</td>
                                    

                                    <td>
                                        <a href="#Rules-dialog" onclick="FetchLiPeriodById(@item.PERIOD_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.PERIOD_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Periods</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <div class="col-md-12 form-group">
                                        @Html.Label("User Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(m => m.UserType, (Model.UserType != null) ? Model.UserType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.UserType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group hidden" id="divSupRole">
                                        @Html.Label("Role", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(m => m.SupRole, (Model.SupRole != null) ? Model.SupRole : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "false", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.SupRole, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group hidden" id="divProgrammeLevel">
                                        @Html.Label("Application Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(m => m.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.ApplicationType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-3 control-label">Semester Begin Date</label>

                                       
                                        <div class="col-md-9">
                                            <div class="input-group date">
                                                @*<input type="text" id="txtExpiryDate" class="form-control input-sm" placeholder="Select Date" data-parsley-required="true">*@

                                                <input class="form-control" data-parsley-required="true" id="txtBeginDate" name="txtBeginDate"  placeholder="DD/MM/YYYY" type="text" value="">
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-3 control-label">Semester End Date</label>


                                        <div class="col-md-9">
                                            <div class="input-group date">
                                                @*<input type="text" id="txtExpiryDate" class="form-control input-sm" placeholder="Select Date" data-parsley-required="true">*@

                                                <input class="form-control" data-parsley-required="true" id="txtEndDate" name="txtEndDate"  placeholder="DD/MM/YYYY" type="text" value="">
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Semester Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(m => m.SupSemesterType, (Model.SupSemesterType != null) ? Model.SupSemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(m => m.SupSemesterType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    
                                   

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="PeriodId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        handleDatepicker = function () {
            "use strict";


            $("input[name='txtBeginDate']").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("input[name='txtEndDate']").datepicker({
                todayHighlight: true,
                autoclose: true,
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();
        var tbl=$('#tblLiRules').DataTable();


        function FetchLiPeriodById(PeriodId)
        {
            $('#pBody').parsley().destroy();

            if(PeriodId!=null)
            {
                $.ajax({
                    url: "/Library/FetchLiPeriodById",
                    type:"post",
                    data: { sPeriodId: PeriodId },
                    success:function(data)
                    {
                        if (data.Message != null)
                        {
                            alert(data.Message);
                        }
                        else {
                            if (data.oResult[0] != null)
                            {
                                $('#UserType option[value="' + data.oResult[0].USER_TYPE + '"]').attr("selected", "selected");
                                $('#UserType').trigger('change');


                                $('#SupRole option[value="' + data.oResult[0].ROLE + '"]').attr("selected", "selected");
                                $('#ApplicationType option[value="' + data.oResult[0].PROGRAMME_LEVEL + '"]').attr("selected", "selected");

                                $('#txtBeginDate').attr('value', data.oResult[0].SEM_BEGIN_DATE);
                                $('#txtEndDate').attr('value', data.oResult[0].SEM_END_DATE);
                                $('#SupSemesterType option[value="' + data.oResult[0].SEMESTER_TYPE + '"]').attr("selected", "selected");
                              
                               



                                //if(data.oResult[0].MEM_CATEGORY=="1")
                                //{
                                //    $('#MemberCategory').trigger("change");
                                //    $('#ApplicationType option[value="' + data.oResult[0].APPTYPE_ID + '"]').attr("selected", "selected");
                                //}



                                //$('#txtExtraBooks').attr('value', data.oResult[0].EXTRA_BOOKS);
                                $('#PeriodId').attr('value', data.oResult[0].PERIOD_ID);
                                $('.selectpicker').selectpicker('refresh');
                            }


                        }

                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }

        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var PeriodId = $('#PeriodId').val();
            var UserType = $('#UserType').val();
            var Role = $('#SupRole').val()!="" ? $('#SupRole').val():"0";
            var ProgrammeLevel = $('#ApplicationType').val() != "" ? $('#ApplicationType').val() :"0";
            var SemBeginDate = $('#txtBeginDate').val();
            var SemEndDate = $('#txtEndDate').val();
            var SemesterType = $('#SupSemesterType').val();
           

            //var Deposit = $('#txtDeposit').val();
            //var AutoReneval;
            //if ($('#AutoReneval').is(":checked"))
            //{
            //     AutoReneval = 1;
            //}
            //else
            //{
            //    AutoReneval = 0;
            //}
            //var ExtraBook = $('#txtExtraBooks').val();


            var jsonData = '{"PERIOD_ID":"' + PeriodId + '","USER_TYPE":"' + UserType + '","ROLE":"' + Role + '",'+
                            '"PROGRAMME_LEVEL":"' + ProgrammeLevel + '","SEM_BEGIN_DATE":"' + SemBeginDate + '","SEM_END_DATE":"' + SemEndDate + '",'+
                            '"SEMESTER_TYPE":"' + SemesterType + '"}';


              var req=  $.ajax({
                  url: "/Library/SavePeriods",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {

                        if (data.ErrorCode == "200")
                        {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadContent('/Library/Periods');
                        }
                        if (data.ErrorCode == "417") {
                            swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        }
                        if (data.ErrorCode == "503") {
                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "204") {
                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }



                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }

              });
            


        });



        GetConfirm=function(PeriodId)
        {
            if(alert("Are you sure want to delete?"))
            {
                return false;
            }

        var req=    $.ajax({
                url: "/Library/DeleteLiPeriodById",
                type:"post",
                data: { sPeriodId: PeriodId },
                success:function(data)
                {
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Library/Periods');
                    }
                    if (data.ErrorCode == "417") {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }



                },
                error:function(ex)
                {
                    alert(ex.Message);
                }


        });
        req.done(function (response) {
            tbl.rows().remove().draw();
            tbl.rows.add(response).draw();
        });
        }

        $('#Add').click(function () {

            $('#pBody').parsley().destroy();

            $('#SupRole option[value=""]').attr("selected", "selected");
            $('#UserType option[value=""]').attr("selected", "selected");
            $('#ApplicationType option[value=""]').attr("selected", "selected");
            $('#SupSemesterType option[value=""]').attr("selected", "selected");

            $('#txtBeginDate').attr('value', '');
            $('#txtEndDate').attr('value', '');
           
            $('#PeriodId').attr('value', '');
            //$('#ApplicationType option[value=""]').attr("selected", "selected");
            //$('#MemberCategory').trigger("change");
            $('.selectpicker').selectpicker('refresh');

        });




        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
        }



</script>
