
@model CMS.ViewModel.Model.LI_LOGIN_FIELDS
@{
    ViewBag.Title = "Login";
}




<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<style>
    .libFont{
        color:#ffffff;
        font-size:16px;
    }
     .libHeader{
        color:#ffffff;
        font-size:26px;
    }
    .LibHover
    {    /*background: transparent url(https://fiverr-res.cloudinary.com/app_assets/fiverr_logo_loader.svg) no-repeat 50%;*/
    background-size: 80px;
    max-width: 100%;
    max-height: 100%;
    min-width: 140px;
    min-height: 400px;
    background-color:#342c29;
    background-clip:content-box;
     
    }
    .LibPanel{
        border: 4px solid #fff;
    -webkit-box-shadow: 0 5px 15px 0 rgba(14,14,15,.15);
    box-shadow: 0 5px 15px 0 rgba(14,14,15,.15);
    }

</style>


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Login</li>
    </ol>
    <h1 class="page-header"> Login</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Login</h4>
        </div>
        <div class="panel-body noPadding">
           
                <div class="col-md-12 form-horizontal LibPanel" style="border:2px solid #0079ff;background-image:url(/Content/lib_img/sign/library_bg.jpg);">
                 
                    <br />
                    <br />
                    <div class="row" style="margin-top: 30px;margin-bottom: 30px;margin-left: 30px; margin-right: 30px;">
                        
                        <div class="col-lg-6 LibHover col-md-offset-3" style="background-color: rgba(21, 19, 19, 0.8);">
                            <center>
                                <span class="logo">
                                    <i class="">
                                        <!-- ion-ios-cloud-->
                                        <img src="~/Content/lib_img/sign/login.png" width="100px;" class="img-circle " style="margin-top: -53px;">
                                    </i>
                                </span>
                                    @*<img src="~/Content/lib_img/sign/login.png" class="img-circle " width="100px" height="80px" style="margin-top: -49px;"/>*@
                             
                               
                                <h4 class="libHeader">Log in</h4>
                            </center>
                            <div class="form-group col-md-12">
                                <div class="col-md-12 form-group">

                                    <label class="col-md-4 control-label libFont">ScanId</label>

                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.USER_ID, new {@class= "form-control" ,@placeholder="User Id" , @data_parsley_required = "true",@id="txtUserId"})
                                        @*<input class="form-control" data-parsley-required="true" id="txtUserId" name="USER_ID" placeholder="" type="text" value="">*@
                                    </div>

                                </div>

                                <div class="col-md-12 form-group">

                                    <label class="col-md-4 control-label libFont">Name</label>

                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.FIRST_NAME, new { @class = "form-control", @placeholder = "User Name", @data_parsley_required = "true", @id = "txtUserName" })
                                        @*<input class="form-control" data-parsley-required="true" id="txtUserName" name="FIRST_NAME" placeholder="" type="text" value="">*@
                                    </div>
                                </div>

                        



                          
                                <div class="col-md-12 form-group">
                                    <label class="col-md-4 control-label libFont">Date</label>
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.CURRENT_DATE, new { @class = "form-control", @placeholder = "Date", @data_parsley_required = "true", @id = "txtCurrentDate" })
                                         @*<input class="form-control" data-parsley-required="true" id="txtDate" name="CURRENT_DATE" placeholder="" type="text" value="">*@
                                    </div>
                                </div>
                                <div class="col-md-12 form-group">
                                    <label class="col-md-4 control-label libFont">Time</label>
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.CURRENT_TIME, new { @class = "form-control", @placeholder = "Time", @data_parsley_required = "true", @id = "txtCurrentTime" })
                                        @*<input class="form-control" data-parsley-required="true" id="txtDate" name="CURRENT_DATE" placeholder="" type="text" value="">*@
                                    </div>
                                </div>
                                <div class="col-md-12 form-group">
                                    <label class="col-md-4 control-label libFont">Visitors</label>
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.VISITORS, new { @class = "form-control", @placeholder = "Visitors", @data_parsley_required = "true", @id = "txtVisitors" })
                                        @*<input class="form-control" data-parsley-required="true" id="txtVisitors" name="VISITORS" placeholder="" type="text" value="">*@
                                    </div>
                                </div>
                                <div class="col-md-12 form-group">
                                    <label class="col-md-4 control-label libFont">LibHrs</label>
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.LIB_HRS, new { @class = "form-control", @placeholder = "Working Hours", @data_parsley_required = "true", @id = "txtLibHours" })
                                        @*<input class="form-control" data-parsley-required="true" id="txtLibHours" name="LIB_HRS" placeholder="" type="text" value="">*@
                                    </div>
                                </div>
                            </div>




                        </div>
                    </div>
                   

                </div>
      
         
       </div>
   </div>
  </div>


            <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
            <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
            <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
            <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
            <script>
                function ContentLoad() {
                    // Document Ready Function .
                }




                $('#txtUserId').keypress(function (e) {


                    if(e.keyCode=="13")
                    {
                       
                        var id = $('#txtUserId').val();
                        if (id)
                        {
                            $.ajax({
                                url: "/Library/FetchUserCredentials",
                                type: "post",
                                data: { Id: id },
                                success: function (data)
                                {
                                    $('#txtUserId').attr('value', '');
                                    if (data.ErrorCode == "200")
                                    {
                                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                        $('#txtUserName').val(data.oResult[0].FIRST_NAME);
                                        $('#txtLibHours').val(data.oResult[0].LIB_HRS);
                                        $('#txtCurrentDate').val(data.oResult[0].CURRENT_DATE);
                                        $('#txtCurrentTime').val(data.oResult[0].CURRENT_TIME);
                                        $('#txtVisitors').val(data.oResult[0].VISITORS);
                                    }
                                    else
                                    {
                                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                                        $('#txtUserName').attr('value', '');
                                        $('#txtLibHours').attr('value', '');
                                        $('#txtCurrentDate').attr('value', '');
                                        $('#txtCurrentTime').attr('value', '');
                                        $('#txtVisitors').attr('value', '');
                                    }
                                },
                                error: function ()
                                {
                                    swal({ title: "error !", text: "Internal Server Error", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                                    // loadContent('/Library/LiUserList');
                                }

                            });
                        }
                        else
                        {
                            swal({ title: "Info !", text: "Please Enter Your Boid or rfid!", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }
                    }
                });




            </script>




