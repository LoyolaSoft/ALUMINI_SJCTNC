@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    ViewBag.Title = "DailyAbsenteesSMSForReception";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Library Bulk Check-in</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Library Bulk Check-in</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Library Bulk Check-in</h4>
        </div>
        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        @*<div class="form-group col-md-4">
                                <label class="control-label col-md-5">Date To</label>
                                <div class="col-md-7">
                                    <div class="input-group date" id="datetimepicker2">
                                        <input type="text" id="txtDateTo" class="form-control input-sm" placeholder="Select Date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>*@
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ApplicationType, "App.Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Shift, "Shift", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "---- Select ----", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgrammeList, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>




                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ClassYear, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.ClassYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ClassName, "ClassName", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "---- Select ----", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                            @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                        </div>



                    </div>



                    <div class="form-group col-md-4">
                        <label class="control-label col-md-4">Check-in Date</label>
                        <div class="col-md-8">
                            <div class="input-group date" id="datetimepicker2" data-date-format="dd/mm/yyyy">
                                <input type="text" id="txtReturnDate" class="form-control input-sm" placeholder="Select Date" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-12">
                        <div class="col-md-12" style="text-align: center;">
                            <a class="btn btn-primary" id="btnGet">Get Student List</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="dvAbsentReportBind"></div>
                    <a class="btn btn-primary" id="btnSaveCheckin">Save Check-In</a>
                </div>
            }
        </div>

    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>


        $('.selectpicker').selectpicker({
            size: 6
        });


        $('#datetimepicker2').datepicker({
            todayHighlight: true,
            autoclose: true
        });

        $('#btnSaveCheckin').on('click', function () {
            SaveBulkCheckin();
        });

        $("#ProgrammeList").on("change", function () {
            FetchClass();
        });
        $("#ClassYear").on("change", function ()
        {
            FetchClass();
        });

    function FetchClass()
    {
        var classYear = String($("#ClassYear").val());
        var ProgramName = String($("#ProgrammeList").val());
        var sShift = $("#Shift").val();
        if ($("#Shift").val() && $("#ProgrammeList").val() && $("#ClassYear").val())
        {
            $.ajax({
                url: "@Url.Action("BindDDLClassList", "Library")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: sShift, sClassYear: classYear },
                success: function (data) {
                    $("#ClassName").empty();
                    $("#ClassName").append(data);   // "/*<option>--- select --- </option>*/"+
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
        };
        $("#ApplicationType").on("change", function ()
                            {
                                fetchProgramme();
        });
        $("#Shift").on("change", function () {
            fetchProgramme();
        });
                            function fetchProgramme()
                            {
                                var sShift = $("#Shift").val();
                                var pLevel = $("#ApplicationType").val();
                                if ($("#Shift").val() && $("#ApplicationType").val())
                                {
                                    $.ajax({
                                        url: "@Url.Action("GetProgramByShiftclasslevel", "Library")",
                                        method: "POST",
                                        datatype: "json",
                                        data: { sShiftId: sShift, programmeLevel: pLevel },
                                        success: function (data) {
                                            $("#ProgrammeList").empty();
                                            $("#ProgrammeList").append(data);
                                            $('.selectpicker').selectpicker('refresh');
                                        }, error: function (error) {
                                            alert('Internal Server Error ! ');
                                        }
                                    });
                                }
    };
    $("#btnGet").on("click", function () {
        FetchStudentDetails();
    });

        function FetchStudentDetails()
    {
            var ProgramName = $("#ProgrammeList").val();
            var ClassName = String($("#ClassName").val());
            var returnDate = $("#txtReturnDate").val();
            if ($("#ClassName").val() && $("#ProgrammeList").val() && $("#txtReturnDate").val())
            {
                $("#loader").show();
                $.ajax({
                    url: "@Url.Action("BindStudentListforBulkCheckin", "Library")",
                    method: "POST",
                    datatype: "json",
                    data: { sClassId: ClassName, sProgramName: ProgramName, ReturnDate: returnDate },
                    success: function (data) {
                        $("#dvAbsentReportBind").empty();
                        $("#dvAbsentReportBind").append(data);
                        // Select All functionality is handled inside the partial view now
                        $("#loader").hide();
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }
    };
        function SaveBulkCheckin() {
            var StudentId = "";
            var returnDate = $("#txtReturnDate").val();
            $('#StudentToSelect tbody tr').each(function () {
                $(this).find('td').each(function () {

                    var chkBox = $(this).find('input[type="checkbox"]');
                    if (chkBox.is(':checked')) {
                        var id = $(this).find('input[type="checkbox"]').attr("cms-studentid");
                        if(id) StudentId += id + ',';
                    }
                });
            });

            if (StudentId == "") {
                if(typeof swal === "function") {
                     swal({ title: "Warning!", text: "Please select at least one student.", showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                } else { alert("Please select at least one student."); }

                return false;
            }

            // Remove trailing comma
            if (StudentId.endsWith(',')) StudentId = StudentId.slice(0, -1);

            if(typeof swal === "function") {
                swal({
                    title: "Confirmation",
                    text: "Are you sure you want to Check-In selected students?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "btn-danger",
                    confirmButtonText: "Yes, Save!",
                    closeOnConfirm: false,
                    animation: true
                }, function () {
                        $("#loader").show();
                        $.ajax({
                            url: "@Url.Action("SaveLibraryBulkChickin", "Library")",
                            method: "POST",
                            data: { StudentIds: StudentId, ReturnDate: returnDate },
                            success: function (data) {
                                if(data.ErrorCode == "200" || data.ErrorCode == 200) {
                                    swal({ title: "Success !", text: data.Message, showConfirmButton: true, type: 'success', animation: true });
                                } else {
                                    swal({ title: "Error !", text: data.Message, showConfirmButton: true, type: 'error', animation: true });
                                }
                                $("#loader").hide();
                                FetchStudentDetails(); // Refresh list
                            }, error: function (error) {
                                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                                $("#loader").hide();
                            }
                        });
                });
            }
            else {
                 if(confirm("Are you sure you want to Check-In selected students?")) {
                      // Fallback without SweetAlert if necessary
                      // ... logic ...
                 }
            }
        };
        function SendAbsenteesSMS() {
            var StudentId;
            $('#StudentToSelect tbody tr').each(function () {
                $(this).find('td').each(function () {

                    var chkBox = $(this).find('input[type="checkbox"]');
                    if (chkBox.is(':checked')) {
                        StudentId += '"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '",';
                    }
                });
            });
            if (StudentId == null) {
                swal({ title: "Warning!", text: "Please select the student to Send SMS...!!!", showConfirmButton: false, timer: 2000, type: 'info', animation: true });

                return false;
            }
            var searchValue = document.querySelector("input[type='search']").value;
            if (searchValue == '') {
                swal({
                    title: "Confirmation",
                    text: "Are you sure you want to send an absentee SMS?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "btn-danger",
                    confirmButtonText: "Yes, Send!",
                    closeOnConfirm: false,
                    animation: true
                }, function () {
                    if (StudentId != null) {
                        $("#loader").show();
                        $.ajax({
                            url: "@Url.Action("SendAbsenteesSMSReception", "Library")",
                            method: "POST",
                            data: { StudentId: StudentId },
                            success: function (data) {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: true, type: 'info', animation: true });
                                $("#loader").hide();
                                FetchStudentDetails();
                            }, error: function (error) {
                                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                            }
                        });
                    }
                });
            }
            else {
                swal({ title: "Warning!", text: "Please clear the search input field before proceeding. ...!!!", showConfirmButton: true, type: 'info', animation: true });
            }
        };
    </script>







