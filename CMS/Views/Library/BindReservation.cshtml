
@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "BindReservation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<ul class="nav nav-pills">
    <li class="active">
        <a href="#navApproved" data-toggle="tab">
            <span class="visible-xs">Approved</span>
            <span class="hidden-xs">Approved</span>
        </a>
    </li>
    <li>
        <a href="#navCancelled" data-toggle="tab">
            <span class="visible-xs">Cancelled</span>
            <span class="hidden-xs">Cancelled</span>
        </a>
    </li>
    <li>
        <a href="#navCollected" data-toggle="tab">
            <span class="visible-xs">Collected</span>
            <span class="hidden-xs">Collected</span>
        </a>
    </li>

</ul>
<div class="tab-content">
    <div class="tab-pane fade active in" id="navApproved">
        @*<h3 class="m-t-10">Book Issue/Reading</h3>*@

        <div class="form-group">
            <div class="col-md-12 table-responsive">
                <table class="table table-bordered" id="tblReserveApproved">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>
                                <div class="checkbox checkbox-css">
                                    <input type="checkbox" id="AllchkID" onchange="SelectOrUnselect()" />
                                    <label for="AllchkID"> &nbsp; &nbsp;</label>
                                </div>
                            </th>
                            <th>Access No</th>
                            <th>Book No</th>
                            <th>Book title</th>
                            <th>Author</th>
                            <th>Reserved Date</th>
                            <th>Approved Date</th>
                            <th>Status</th>
                            <th class="hidden" id="thStatus">Action</th>
                           

                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liBookReserve != null && Model.liBookReserve.Count > 0)
                        {
                            foreach (var item in Model.liBookReserve)
                            {
                                if (item.IS_APPROVED=="1" && item.IS_COLLECTED!="1")
                                {
                                    <tr cms-row-id="@item.RESERVE_ID" cms-book-id="@item.BOOK_ID">
                                        <td>@{nCount++;} @nCount</td>

                                        <td>
                                            <div class="checkbox checkbox-css">

                                                <input type="checkbox" id="cbx_@item.RESERVE_ID" />
                                                <label for="cbx_@item.RESERVE_ID"></label>

                                            </div>
                                        </td>

                                        <td>@item.ACCESS_NO</td>
                                        <td>@item.BOOK_NO</td>
                                        <td>@item.BOOK_TITLE</td>
                                        <td>@item.AUTHOR</td>
                                        <td>@item.ENTRY_DATE</td>
                                        <td>@item.APPROVED_DATE</td>
                                        <td>@item.STATUS</td>
                                        <td class="ms-lastCell hidden"></td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="form-group">
                <a class="btn btn-primary pull-right" href="javascript:;" id="btnSubmit"> Submit </a>
            </div>
        </div>

    </div>


    <div class="tab-pane fade" id="navCancelled">
        @*<h3 class="m-t-10">Book Return</h3>*@

        <div class="form-group">
            <div class="col-md-12 table-responsive">
                <table class="table table-bordered" id="tblReserveCancelled">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Access No</th>
                            <th>Book No</th>
                            <th>Book title</th>
                            <th>Author</th>
                            <th>Reserved Date</th>
                            <th>Approved Date</th>
                            <th>Status</th>
                         
                           
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liBookReserve != null && Model.liBookReserve.Count > 0)
                        {
                            foreach (var item in Model.liBookReserve)
                            {
                                if (item.IS_CANCELLED == "1")
                                {
                                    <tr cms-row-id="@item.RESERVE_ID" cms-book-id="@item.BOOK_ID">
                                        <td>@{nCount++;} @nCount</td>
                                        <td>@item.ACCESS_NO</td>
                                        <td>@item.BOOK_NO</td>
                                        <td>@item.BOOK_TITLE</td>
                                        <td>@item.AUTHOR</td>
                                        <td>@item.ENTRY_DATE</td>
                                        <td>@item.APPROVED_DATE</td>
                                        <td>@item.STATUS</td>

                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="tab-pane fade" id="navCollected">
        @*<h3 class="m-t-10">Book Return</h3>*@

        <div class="form-group">
            <div class="col-md-12 table-responsive">
                <table class="table table-bordered" id="tblReserveCollected">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Access No</th>
                            <th>Book No</th>
                            <th>Book title</th>
                            <th>Author</th>
                            <th>Reserved Date</th>
                            <th>Approved Date</th>
                            <th>Status</th>


                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liBookReserve != null && Model.liBookReserve.Count > 0)
                        {
                            foreach (var item in Model.liBookReserve)
                            {
                                if (item.IS_COLLECTED == "1")
                                {
                                    <tr cms-row-id="@item.RESERVE_ID" cms-book-id="@item.BOOK_ID">
                                        <td>@{nCount++;} @nCount</td>
                                        <td>@item.ACCESS_NO</td>
                                        <td>@item.BOOK_NO</td>
                                        <td>@item.BOOK_TITLE</td>
                                        <td>@item.AUTHOR</td>
                                        <td>@item.ENTRY_DATE</td>
                                        <td>@item.APPROVED_DATE</td>
                                        <td>@item.STATUS</td>

                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>




<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    $('#tblReserveApproved').DataTable();
     $('#tblReserveCancelled').DataTable();
     $('#tblReserveCollected').DataTable();
</script>

<script>
    SelectOrUnselect = function () {
        if (AllchkID.checked == true) {
            $('#tblReserveApproved tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", true);
                });
            });
        }
        else {
            $('#tblReserveApproved tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", false);
                });
            });
        }
    }
</script>


    <script>

    $('#btnSubmit').on('click', function ()
    {
        var nCount = 0;
        var JsonData = "";

        JsonData = '{"liBookIssue":[';
        $('#tblReserveApproved tbody tr').each(function () {
            if ($(this).find('input[type="checkbox"]').is(':checked'))
            {
               
                JsonData += '{"BOOK_ID":"' + $(this).attr('cms-book-id') + '","USER_ID":"' + $('#txtUserId').val() + '","USER_TYPE":"' + $('#txtUserType').val() + '","PROGRAMME_LEVEL":"' + $('#txtProgrammeLevel').val() + '",' +
                    '"ROLE":"' + $('#txtRole').val() + '",' +
                    '"SEMESTER_TYPE":"' + $('#txtSemesterType').val() + '","IS_RESERVE_APPROVED":"1"},';
                nCount++;
            }
        });

        if (nCount != 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookCirculation", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonBookDetails: JsonData, sMode: '0' },
                success: function (data) {
                    if (data.sMessage != null && data.sMessage != '') {
                        if (data.sErrorCode == "204") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.sErrorCode == "409") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.sErrorCode == "503") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    }
                    else {
                        var JData = '{"liBookReserve":[';
                        var sStatus = 0;
                        var count = 0;
                        if (data.liGridClass != null && data.liGridClass.length > 0) {
                            $('#thStatus').removeClass("hidden");
                            //$('#bAppend > .ms-lastCell').removeClass("hidden");
                            for (var i = 0; i < data.liGridClass.length; i++) {
                                $('#tblReserveApproved tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID + ']').find('td.ms-lastCell').removeClass('hidden');
                                $('#tblReserveApproved tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID + ']').find('td.ms-lastCell').text(data.liGridClass[i].STATUS);

                                
                                if (data.liGridClass[i].IS_TRANSACTION_COMPLETED != "" && data.liGridClass[i].IS_TRANSACTION_COMPLETED !=null)
                                {
                                    var ReserveId = $('#tblReserveApproved tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID + ']').attr('cms-row-id');
                                    JData += '{"RESERVE_ID":"' + ReserveId + '","IS_COLLECTED":"1","COLLECTED_DATE":""},';
                                    sStatus = 0;
                                    count++;
                                }
                            }

                            if (count != 0 && sStatus == 0) {
                                JData = JData.slice(0, -1);
                                JData = JData + "]}";
                                $.ajax({
                                    url: '@Url.Action("SaveBookReservationTransactionForCollected", "Library")',
                                    method: 'POST',
                                    datatype: 'json',
                                    data: { sJsonTransactionDetails: JData },
                                    success: function (data1) {
                                        
                                            if (data1.sMessage != null && data1.sMessage != '') {
                                                if (data1.sErrorCode == "200") {
                                                    swal({ title: "Success!", text: data1.sMessage, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                                                }
                                                if (data1.sErrorCode == "204") {
                                                    swal({ title: "Info!", text: data1.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                                                }
                                                if (data1.sErrorCode == "503") {
                                                    swal({ title: "Info!", text: data1.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                                                }

                                            }
                                        }, error: function (error) {

                                        }
                                    });
                            }
                        }
                    }
                }
            });
        }
        else
        {
            swal({ title: "Alert !", text: "Please Select Any One To Continue !", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    });
</script>




