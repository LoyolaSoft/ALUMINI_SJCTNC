@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "ERASettingList";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">ERA Setting </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">ERA Setting </h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ERA Setting</h4>
        </div>
        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12 form-horizontal">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Academic Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.sAcademicYearList, (Model.sAcademicYearList != null) ? Model.sAcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ADAcademicYear" })
                                @Html.ValidationMessageFor(model => model.sAcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Semester Type</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.SupSemesterType, (Model.SupSemesterType != null) ? Model.SupSemesterType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ADSemesterType" })
                                @Html.ValidationMessageFor(model => model.SupSemesterType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <a id="btnGet" class="btn btn-primary" onclick="FetchERASetting()">Get</a>
                        </div>

                        <div class="col-md-1 btnPrintDiv hidden">
                            <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                        </div>
                        <div class="col-md-1 btnExcelDiv hidden">
                            <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                        </div>
                        <div class="form-group col-md-1 pull-right">
                            <a href="#malpratice-dialog" data-toggle="modal" class="btn btn-danger" id="btnAdd">+Add</a>
                        </div>
                    </div>

                </div>

            </div>

            <hr />
            <br />
            <div class="form-group col-md-12">
                <div id="divbind"></div>
            </div>
        </div>
        <div class="modal fade" id="malpratice-dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <h4 class="modal-title">ERA Setting </h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="form-horizontal" id="dvValidate" data-parsley-validate="true">
                                    <div class="">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4">Academic Year</label>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.sAcademicYearList, (Model.sAcademicYearList != null) ? Model.sAcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "AcademicYear" })
                                                @Html.ValidationMessageFor(model => model.sAcademicYearList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4">Semester Type</label>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.SupSemesterType, (Model.SupSemesterType != null) ? Model.SupSemesterType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "SemesterType" })
                                                @Html.ValidationMessageFor(model => model.SupSemesterType, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4"> Course Code </label>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control input-sm" id="txtcourseCode" placeholder="Enter course Code " maxlength="98" />
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4">Component</label>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.ComponentList, (Model.ComponentList != null) ? Model.ComponentList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                                @Html.ValidationMessageFor(model => model.ComponentList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4">Per Book Mark</label>
                                            <div class="col-md-8">
                                                <input type="number" class="form-control input-sm" id="txtbookMark" placeholder="Enter Book Mark" maxlength="98" />
                                            </div>
                                        </div>

                                        <div class="col-md-12 form-group">
                                            <label class="col-md-3 col-form-label"></label>
                                            <div class="col-md-9">

                                                <div class="checkbox checkbox-css">
                                                    <input type="checkbox" id="chIsActive" value="" />
                                                    <label for="chIsActive">Is Active Setting</label>
                                                </div>
                                                <div class="checkbox checkbox-css">
                                                    <input type="checkbox" id="chReading" value="" />
                                                    <label for="chReading">Is Reading</label>
                                                </div>
                                                <div class="checkbox checkbox-css">
                                                    <input type="checkbox" id="chWriting" value="" />
                                                    <label for="chWriting">Is Writing </label>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
        <input type="text" id="txtmalpracticeId" class="hidden" value="" />

    </div>
    <!-- end panel -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>



<script>

        $(document).ready(function () {
            $('#chReading, #chWriting').on('change', function () {
                if (this.checked) {
                    // Uncheck the other checkbox
                    $('#chReading, #chWriting').not(this).prop('checked', false);
                }
            });
            FetchERASetting();
    });
    

    $('.selectpicker').selectpicker({
        size: 4
    });


    $("#AcademicYear").on("change", function () {
        LoadExamSetting();

    });

    $("#ADAcademicYear").on("change", function () {
        FetchERASetting();

    });
    $("#ADSemesterType").on("change", function () {
        FetchERASetting();
    });

    $("#btnGet").on("click", function () {
        FetchERASetting();
    });
    function LoadComponentByCourseCode()
                         {
        var CourseCode = $("#txtcourseCode").val()
        if (CourseCode != "" && CourseCode != "null") {
            {
                $.ajax({
                    url: "@Url.Action("GetComponentByCourseCode", "Library")",
                    method: "POST",
                    datatype: "json",
                    data: { sCourseCode: CourseCode },
                    success: function (data) {
                        $("#ComponentList").empty();
                        $("#ComponentList").append("<option>--- Select ---</option>" + data);
                        $('.selectpicker').selectpicker('refresh');
                    }, error: function (error) {
                        alert('Internal Server Error ! ');
                    }
                });
            }
        }
    };

    function checkCourseCodeExistorNot() {
                var courseCode = $("#txtcourseCode").val();
        if (courseCode != "" && courseCode != "null") {
            $.ajax({
                url: "@Url.Action("CheckCourseCodeExist", "Library")",
                method: "POST",
                datatype: "html",
                data: { sCourseCode: courseCode },
                success: function (option) {
                    if (option == "Exist") {
                    }
                    else {
                        swal({ title: "Error", text: "Please Check your Course Code. This course code not Exist", showConfirmButton: false, timer: 3000, type: 'error', animation: true });

                    }

                }, error: function (error) {
                    swal({ title: "Error", text: error, showConfirmButton: false, timer: 2000, type: 'error', animation: true });

                }
            });
        }
    };
    $("#txtcourseCode").on('focusout', function () {
        checkCourseCodeExistorNot();
        LoadComponentByCourseCode();

    });
    function FetchERASetting() {
        
        var SemType = $("#ADSemesterType").val();
        var AcademicYear = $('#ADAcademicYear option:selected').text();

        $('#loader').show();
        $.ajax({
            url: "@Url.Action("BindERASettingList", "Library")",
            method: "POST",
            datatype: "json",
            data: { sAcademicYear: AcademicYear, sSemType: SemType },
            success: function (data) {
                $("#divbind").empty();
                $("#divbind").append(data);
                $(".btnPrintDiv").removeClass('hidden');
                $(".btnExcelDiv").removeClass('hidden');
                table = $("#tblMalpracticeList").DataTable({ "bPaginate": true });
                $("#tblMalpracticeList_filter").addClass("dataTables_filter pull-right");
                $(".pagination").addClass("pagination pull-right");
                $('#loader').hide();
            }, error: function (error) {
                alert('Internal Server Error !');
                $('#loader').hide();
            }
        });
    }
    


 GetConfirm = function (ID)
 {
     swal({
         title: "Are you sure want to Delete?",
         text: "",
         type: "warning",
         showCancelButton: true,
         confirmButtonClass: "btn-danger",
         confirmButtonText: "Yes, I agree!",
         closeOnConfirm: false
     },
         function () {

             $.ajax({
                 url: "@Url.Action("DeleteCIAMalpracticeList", "Examination")",
                 method: "POST",
                 datatype: "html",
                 data: { sSettingID: ID },
                 success: function (ObjJsonData) {
                     if (ObjJsonData.ErrorCode == "200") {
                         swal({ title: "Success !", text: ObjJsonData.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });
                         FetchERASetting();
                     }
                     else {
                         swal({ title: "Fail !", text: ObjJsonData.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                     }

                 }, error: function (error) {
                     alert('Internal Server Error ! ');
                 }
             });
         });
    }

    $("#btnSubmit").on('click', function () {

        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        var IsReading = 0;
        var IsWriting = 0;
        var IsActive = 0;
        if ($('#chReading').is(':checked')) {
            IsReading = 1;
        }

        if ($('#chWriting').is(':checked')) {
            IsWriting = 1;
        }

        if ($('#chIsActive').is(':checked')) {
            IsActive = 1;
        }
        var SemesterType = $("#SemesterType").val();
        var AcademicYear = $("#AcademicYear option:selected").text();
        var ERASetting = $("#txtmalpracticeId").val();
        var ComponentList = $("#ComponentList").val();
        var courseCode = $("#txtcourseCode").val();
        var bookMark = $("#txtbookMark").val();
        $.ajax({
            url: "@Url.Action("SaveOrUpdateERASetting", "Library")",
            method: "POST",
            datatype: "html",
            data: { sERASetting: ERASetting, sSemesterType: SemesterType, sComponentId: ComponentList, sCourseCode: courseCode, IsReading: IsReading, IsWriting: IsWriting, IsActive: IsActive, sBookMark: bookMark },
            success: function (data)
            {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });

                    FetchERASetting();
                }
                else if (data.ErrorCode == "404") {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 4000, type: 'info', animation: true });

                }
                else {
                    swal({ title: "Fail !", text: data.Message, showConfirmButton: false, timer: 4000, type: 'error', animation: true });
                }

            }, error: function ()
            {
                swal({ title: "Fail !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 4000, type: 'error', animation: true });

            }
        })
    });
    $("#btnAdd").on('click', function () {
        $("#txtmalpracticeId").val('');
        $("#txtcourseCode").val('');
        $("#AcademicYear option[value='']").attr("selected", "selected");
        $("#SemesterType option[value='']").attr("selected", "selected");
        $('#txtbookMark').val("");
        $("#ComponentList option[value='']").attr("selected", "selected");
        $('.selectpicker').selectpicker('refresh');
        $('#chReading').prop("checked", false);
        $('#chWriting').prop("checked", false);
        $('#chIsActive').prop("checked", false);

    });

        function FetchMalpracticeById(smalID) {
            if (smalID != null) {
            $.ajax({

                 url: '@Url.Action("FetchERASettingById", "Library")',
                type: "POST",
                datatype: 'json',
                data: { EraSettingIds: smalID },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                    }
                    else {
                        if (data[0] != null) {
                            $('#AcademicYear option').filter(function () {
                                return $(this).text().trim() === data[0].ACADEMIC_YEAR.trim();
                            }).prop('selected', true);
                            LoadComponentByCourseCode();
                            $('.selectpicker').selectpicker('refresh');
                            $('#SemesterType').val(data[0].SEMESTER_TYPE);
                            $('#ComponentList option[value="' + data[0].COMPONENT_ID + '"]').attr("selected", "selected");
                            $('#txtmalpracticeId').attr('value', data[0].ERA_SETTING_ID);
                            $('#txtcourseCode').attr('value', data[0].COURSE_CODE);
                            $('#txtbookMark').attr('value', data[0].PER_BOOK_MARK);


                            $('.selectpicker').selectpicker('refresh');

                            if (data[0].IS_READING == "1") {
                                $('#chReading').click();
                            }

                            if (data[0].IS_WRITING == "1") {
                                $('#chWriting').click();
                            }

                            if (data[0].IS_ACTIVE == "1") {
                                $('#chIsActive').click();
                            }
                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                }
            });
        }
    }
                function SetActive(ID)
    {
                swal({
                    title: "Are you sure?",
                    text: "Are you sure to Activate. ?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "btn-danger",
                    confirmButtonText: "Yes, Activate it!",
                    closeOnConfirm: false
                },
                    function () {
                $.ajax({
                    url: "@Url.Action("UpdateActiveERASetting", "Library")",
                    method: "POST",
                    datatype: "json",
                    data: { sSettingId: ID, sActive: '1' },
                    success: function (data) {
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                            FetchERASetting();
                        }
                        else {

                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                        }
                    }, error: function (error) {

                        swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
}
                });

        });

}

// De - Activate Setting ...
function SetDeActive(ID)
{
            swal({
                title: "Are you sure?",
                text: "Are you sure to De - Activate. ?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, De - Activate it!",
                closeOnConfirm: false
            },
                function () {

            $.ajax({
                url: "@Url.Action("UpdateActiveERASetting", "Library")",
                method: "POST",
                datatype: "json",
                data: { sSettingId: ID, sActive: '0' },
                success: function (data) {
                    if (data.ErrorCode == "200") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                        FetchERASetting();
                    }
                    else {

                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                    }
                }, error: function (error) {
                    swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                }
            });

    });
    }
</script>

<script>

    function Export() {
        var title = "Era Setting";
        var table = $('#tblMalpracticeList').DataTable();
        table.destroy();
        let file = new Blob([$('#divbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        table = $("#tblMalpracticeList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
        $("#tblMalpracticeList_filter").addClass("dataTables_filter pull-right");
        $(".pagination").addClass("pagination pull-right");
    }

    function printDiv() {
        var table = $('#tblMalpracticeList').DataTable();
        table.destroy();
        var printContents = document.getElementById('divbind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Library/ERASettingList')
    }
</script>




