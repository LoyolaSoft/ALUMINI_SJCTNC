<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>


        //var tbl=$('#tblLiRules').DataTable();

    function ContentLoad()
    {
        //GetStudentList();
        $(".table").DataTable({
            processing: true,
            serverSide: true,
            searchable: true,
            ajax: {
                url: '@Url.Action("LiUserList", "AjaxDataTable")',
                type: 'POST',
                dataSrc: function (json) {
                    if (!json.data) {
                        json.data = [];
                    }
                    return json.data;
                }
            },
            dom: "lBfrtip", buttons: [{
                extend: "copy", className: "btn-sm"
            }
                , {
                    extend: "excel", className: "btn-sm"
                }
                , {
                    extend: "print", className: "btn-sm"
                }
            ], responsive: !0,

            columns: [{ data: "RUN_NUMBER" },
                {},
                 { data: "FIRST_NAME" }, { data: "BOID" }, { data: "DATE_OF_BIRTH" }, { data: "USER_TYPE" }, { data: "EMAIL" }, { data: "MOBILE" },
             { data: "RFID" },{}]
            , columnDefs: [
                {
                    "render": function (data, type, row)
                    {
                        return '<a href="#" onclick=' + 'loadContent("/Library/AddLiMember?sUserId=' + row["USER_ID"] + '") ' + 'title="Click To Edit"><i class="fa fa-edit text-primary"></i></a>' +
                               '<a href="#" onclick=' + 'GetConfirm("' + row["USER_ID"] + '") title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>';

                    }, "targets": -1
                },
                {
                    "render": function (data, type, row)
                    {
                        return '<img src="' + row["PHOTO"] + '" width=77 height=80></img>';
                    }, "targets": 1
                }
                          ],
            language: {
                infoEmpty: "No records available - Got it?",
            }
        });

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');
    }



        GetConfirm=function(UserId)
        {
            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },

          function(){
           var req= $.ajax({
                  url: "/Library/DeleteMemberById",
                  type:"post",
                  data: { sUserId: UserId },
                  success:function(data)
                  {
                      if (data.ErrorCode=="200")
                      {
                          swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                          loadContent('/Library/LiUserList');
                      }else
                      {
                          swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                      }
                  },
                  error:function(ex)
                  {
                      alert(ex.Message);
                  }


              });
          });
        //req.done(function (response) {
        //    tbl.rows().remove().draw();
        //    tbl.rows.add(response).draw();
        //});
        }


        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
        }
</script>


