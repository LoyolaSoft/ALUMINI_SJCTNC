
@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "FetchBookDetailsByAnywords";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
}




<div class="form-group">
    <div class="col-md-12 table-responsive">
        <table class="table table-bordered" id="tblABooks">
            <thead>
                <tr>
                    <th>#</th>

                    <th>Access No</th>
                    <th>Rfid</th>
                    <th>Class No</th>
                    <th>ISBN</th>
                    <th>B.No</th>
                    <th>Title</th>
                    <td>Language</td>
                    <td>Personal Author1</td>
                    <td>Personal Author2</td>
                    <td>Name of Publisher</td>
                    <td>Place of Publisher</td>
                    <td>Price</td>
                </tr>
            </thead>
            <tbody>
                @if (Model.liBookDetails != null && Model.liBookDetails.Count > 0)
                {
                    foreach (var item in Model.liBookDetails)
                    {
                        <tr cms-BookId="@item.BOOK_ID">
                            <td>@{nCount++;} @nCount</td>

                            <td>@item.ACCESS_NO</td>
                            <td>@item.RFID</td>
                            <td>@item.CLASS_NO</td>
                            <td>@item.ISBN_NO</td>
                            <td>@item.BOOK_NO</td>
                            <td>@item.BOOK_TITLE</td>
                            <td>@item.LANGUAGE</td>
                            <td>@item.PERSONAL_AUTHOR1</td>
                            <td>@item.PERSONAL_AUTHOR2</td>
                            <td>@item.NAME_OF_PUBLISHER</td>
                            <td>@item.PLACE_OF_PUBLISHER</td>
                            <td><i class="fa fa-rupee"></i> @item.PRICE</td>
                        </tr>
                                    }
                                }
            </tbody>
        </table>


    </div>
</div>



<script>

</script>
