
@model CMS.ViewModel.ViewModel.LibraryViewModel
@{
    ViewBag.Title = "BookCirculationForCancel";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Book Circulation For Cancel</li>
    </ol>
    <h1 class="page-header">Book Circulation For Cancel</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Book Circulation For Cancel</h4>
        </div>
        <div class="panel-body noPadding">
            @*<div class="form-group col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>*@

            <div class="form-group " id="BookReservationCirculationProcess">
                <div class="col-md-12">
                    <ul class="nav nav-tabs">
                        <li class="active">
                            <a href="#BookReserved" data-toggle="tab" id="activeTag">
                                <span class="hidden-xs">Reserved Books</span>
                            </a>
                        </li>
                        <li class="">
                            <a href="#BookIssued" data-toggle="tab" id="liBookIssued">
                                <span class="hidden-xs">Renewed Books</span>
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade active in" id="BookReserved">
                            <div class="form-group col-md-12 table-responsive">
                                <table class="table table-hover table-bordered" id="tblLiReservedBooks">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th></th>
                                            <th>First Name</th>
                                            <th>User Boid</th>
                                            <th>User Category</th>
                                            <th>User Course</th>
                                            <th>Reserved Date</th>
                                            <th>Book Access No</th>
                                            <th>Class No</th>
                                            <th>ISBN No</th>
                                            <th>Book No</th>
                                            <th>Title</th>
                                            <th>Language</th>
                                            <th>Personal Author1</th>
                                            <th>Personal Author2</th>
                                            <th>Name of Publisher</th>
                                            <th>Place of Publisher</th>
                                            <th>Price</th>

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @if (Model.liBookCirculation != null && Model.liBookCirculation.Count > 0)
                                        {
                                            var count = 0;
                                            foreach (var item in Model.liBookCirculation)
                                            {
                                                count = count + 1;
                                                <tr cms-BookId="@item.BOOK_ID" cms-user-id="@item.USER_ID" cms-reserve-id="@item.RESERVE_ID">
                                                    <td>@count</td>
                                                    <td>
                                                        <div class="checkbox checkbox-css">
                                                            <input type="checkbox" id="r_@count" BookId="@item.BOOK_ID" />
                                                            <label for="r_@count"></label>
                                                        </div>
                                                    </td>
                                                    <td>@item.FIRST_NAME</td>
                                                    <td>@item.BOID</td>
                                                    <td>@item.CATEGORY_NAME</td>
                                                    <td>@item.DEGREE</td>
                                                    <td>@item.RESERVE_DATE</td>
                                                    <td>@item.ACCESS_NO</td>
                                                    <td>@item.CLASS_NO</td>
                                                    <td>@item.ISBN_NO</td>
                                                    <td>@item.BOOK_NO</td>
                                                    <td>@item.BOOK_TITLE</td>
                                                    <td>@item.LANGUAGE</td>
                                                    <td>@item.PERSONAL_AUTHOR1</td>
                                                    <td>@item.PERSONAL_AUTHOR2</td>
                                                    <td>@item.NAME_OF_PUBLISHER</td>
                                                    <td>@item.PLACE_OF_PUBLISHER</td>
                                                    <td>@item.PRICE</td>
                                                    
                                                    

                                                </tr>
                                            }

                                        }

                                    </tbody>
                                </table>

                            </div>
                            <div class="form-group">
                                <a class="btn btn-primary pull-right" href="javascript:;" name="btnSubmit" onclick="getSubmit('tblLiReservedBooks')"> Submit </a>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="BookIssued">
                            <div class="form-group col-md-12 table-responsive">
                                <table class="table table-hover table-bordered" id="tblRenewedBooks">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th></th>
                                            <th>First Name</th>
                                            <th>User Boid</th>
                                            <th>User Category</th>
                                            <th>User Course</th>
                                            <th>Issue Date</th>
                                            <th>Book Access No</th>
                                            <th>Class No</th>
                                            <th>ISBN No</th>
                                            <th>Book No</th>
                                            <th>Title</th>
                                            <th>Language</th>
                                            <th>Personal Author1</th>
                                            <th>Personal Author2</th>
                                            <th>Name of Publisher</th>
                                            <th>Place of Publisher</th>
                                            <th>Price</th>

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @if (Model.liBookCirculation1 != null && Model.liBookCirculation1.Count > 0)
                                        {
                                            var count = 0;
                                            foreach (var item in Model.liBookCirculation1)
                                            {
                                                count = count + 1;
                                                <tr cms-BookId="@item.BOOK_ID" cms-user-id="@item.USER_ID" cms-issue-id="@item.ISSUE_ID">
                                                    <td>@count</td>
                                                    <td>
                                                        <div class="checkbox checkbox-css">
                                                            <input type="checkbox" id="rr_@count" BookId="@item.BOOK_ID" />
                                                            <label for="rr_@count"></label>
                                                        </div>
                                                    </td>
                                                    <td>@item.FIRST_NAME</td>
                                                    <td>@item.BOID</td>
                                                    <td>@item.CATEGORY_NAME</td>
                                                    <td>@item.DEGREE</td>
                                                    <td>@item.ISSUE_DATE</td>
                                                    <td>@item.ACCESS_NO</td>
                                                    <td>@item.CLASS_NO</td>
                                                    <td>@item.ISBN_NO</td>
                                                    <td>@item.BOOK_NO</td>
                                                    <td>@item.BOOK_TITLE</td>
                                                    <td>@item.LANGUAGE</td>
                                                    <td>@item.PERSONAL_AUTHOR1</td>
                                                    <td>@item.PERSONAL_AUTHOR2</td>
                                                    <td>@item.NAME_OF_PUBLISHER</td>
                                                    <td>@item.PLACE_OF_PUBLISHER</td>
                                                    <td>@item.PRICE</td>
                                                    

                                                </tr>
                                            }

                                        }

                                    </tbody>
                                </table>

                            </div>
                            <div class="form-group">
                                <a class="btn btn-primary pull-right" href="javascript:;" name="btnSubmit" onclick="getSubmit('tblApprovedBooks')"> Submit </a>
                            </div>
                        </div>
                      
                    </div>
                </div>
            </div>

          
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
        SelectOrUnselect = function ()
        {
            if (AllchkID.checked == true)
            {
                $('#tblLiReservedBooks tbody tr').each(function ()
                {
                    $(this).find('input[type="checkbox"]').each(function ()
                    {
                        $('input[type="checkbox"]').attr("checked", true);
                    });
                });
            }
            else
            {
                $('#tblLiReservedBooks tbody tr').each(function ()
                {
                    $(this).find('input[type="checkbox"]').each(function ()
                    {
                        $('input[type="checkbox"]').attr("checked", false);
                    });
                });
            }
        }

        SelectOrUnselect = function () {
            if (AllchkID.checked == true) {
                $('#tblRenewedBooks tbody tr').each(function () {
                    $(this).find('input[type="checkbox"]').each(function () {
                        $('input[type="checkbox"]').attr("checked", true);
                    });
                });
            }
            else {
                $('#tblRenewedBooks tbody tr').each(function () {
                    $(this).find('input[type="checkbox"]').each(function () {
                        $('input[type="checkbox"]').attr("checked", false);
                    });
                });
            }
        }


</script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }

    var tbl = $('#tblLiReservedBooks').DataTable();
    var tbl2 = $('#tblRenewedBooks').DataTable();
    


    function getSubmit(id)
    {
        var nCount = 0;
        var mode = "";
        var JsonData = "";
        if (id == "tblLiReservedBooks")
        {
            mode = "1";
            JsonData = '{"liBookReserve":[';
            $('#tblLiReservedBooks tbody tr').each(function () {
                if ($(this).find('input[type="checkbox"]').is(':checked')) {
                    JsonData += '{"RESERVE_ID":"' + $(this).attr('cms-reserve-id') + '","USER_ID":"' + $(this).attr('cms-user-id') + '","BOOK_ID":"' + $(this).attr('cms-BookId') + '","IS_CANCELLED":"1","BOOK_STATUS":"0"},';
                    nCount++;
                }
            });
        }
        else {
            mode = "2";
            JsonData = '{"liBookIssue":[';
            $('#tblRenewedBooks tbody tr').each(function () {
                if ($(this).find('input[type="checkbox"]').is(':checked')) {
                    JsonData += '{"ISSUE_ID":"' + $(this).attr('cms-issue-id') + '","BOOK_ID":"' + $(this).attr('cms-BookId') + '","BOOK_STATUS":"0","IS_RENEW_CANCELLED":"1"},';
                    nCount++;
                }
            });
        }

       
        if (nCount != 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookCirculationForCancel", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonReserveDetails: JsonData,sMode:mode },
                success: function (data)
                {
                   
                    if(data.ErrorCode=="200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        $('#activeTag').click();
                        loadContent("/Library/BookCirculationForCancel");
                    }
                    if(data.ErrorCode == "406") {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }
                    if(data.ErrorCode == "417") {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }


                }, error: function (error)
                {
                    swal({ title: "Internal Server Error !", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        } else
        {
            swal({ title: "Alert !", text: "Please Select Any One To Continue !", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    }
</script>



