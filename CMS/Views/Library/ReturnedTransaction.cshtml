<script>

    //status validation
    function onStatusValidate(id) 
    {


        var status = $('#' + id + "").val();
        var text = $("#" + id + " " + "option:selected").text();
        var rowId = $('#' + id + "").attr('cms-row-id');
        if (status==@Common.LI_BOOK_STATUS.DAMAGED) 
        {
            $('#thFineAmount').removeClass("hidden");
            $('#' + rowId + ' > .fineamount').removeClass("hidden");

        }
        else
        {
            $('#thFineAmount').addClass("hidden");
            $('#' + rowId + ' > .fineamount').addClass("hidden");
        }

    }
    var isHeadCheckBoxClicked=false;
    SelectOrUnselect = function ()
    {
        if (AllchkID.checked == true) 
        {
            isHeadCheckBoxClicked=true;
            $('#tblReturnedTransaction tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", true);
                });
            });
        }
        else 
        {
            isHeadCheckBoxClicked=false;
            $('#tblReturnedTransaction tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", false);
                });
            });
        }
    }


    function ContentLoad() {
        //GetStudentList();
        $(".table").DataTable({
            processing: true,
            serverSide: true,
            searchable: true,
            ajax: {
                url: '@Url.Action("ReturnedTransaction", "AjaxDataTable")',
                type: 'POST',
                dataSrc: function (json) {
                    if (!json.data) {
                        json.data = [];
                    }
                    return json.data;
                }
            },
            dom: "lBfrtip", buttons: [{
                extend: "copy", className: "btn-sm"
            }
                , {
                    extend: "excel", className: "btn-sm"
                }
                , {
                    extend: "print", className: "btn-sm"
                }
            ], responsive: !0,

            columns: [{ data: "RUN_NUMBER" },
                {},
                {},{},
                 { data: "FIRST_NAME" }, { data: "USER_TYPE_NAME" }, { data: "ROLE" }, { data: "ISSUE_DATE" }, { data: "BOOK_TITLE" },{ data: "AUTHOR" },
             { data: "RETURN_DATE" },{data: "STATUS"},{},{}]
            ,columnDefs: [
{
    "render": function (data, type, row) {
        // alert(row["FIRST_NAME"]);

        if (row["BALANCE"] != "0" && parseInt(row["CREDIT"]) > 0)
        {
            return '<label class="label label-danger f-s-12">Not Paid</label>';
        }
        if (row["BALANCE"] == "0" && row["CREDIT"]== "0")
        {
            return '<label class="label label-info f-s-12">No Fine</label>';
        }
        else
        {
            return '<label class="label label-success f-s-12">Paid</label>';
        }


    }, "targets":-2
},
{
    "render": function (data, type, row) {
        // alert(row["FIRST_NAME"]);

        if (row["BALANCE"] != "0" && parseInt(row["CREDIT"]) > 0)
        {
            return '<i class="fa fa-inr f-s-14">'+row["BALANCE"]+'</i>';
        }
        if (row["BALANCE"] == "0" && row["CREDIT"]== "0")
        {
            return '<i class="fa fa-inr f-s-14">0</i>';
        }
        else
        {
            return '<label class="fa fa-inr f-s-14">'+row["DEBIT"]+'</label>';
        }

    }, "targets":-1
},
{
    "render": function (data, type, row) {
        if(isHeadCheckBoxClicked==true)
        {
            return '<div class="checkbox checkbox-css"><input type="checkbox" id="cbx_'+row["ISSUE_ID"]+'" checked cms-row-id="'+row["ISSUE_ID"]+'"/><label for="cbx_'+row["ISSUE_ID"]+'"></label></div>';
        }
        else
        {
            return '<div class="checkbox checkbox-css"><input type="checkbox" id="cbx_'+row["ISSUE_ID"]+'" cms-row-id="'+row["ISSUE_ID"]+'"/><label for="cbx_'+row["ISSUE_ID"]+'"></label></div>';
        }

      
    }, "targets": 1
},
{
    "render": function (data, type, row)
    {
        return '<select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" cms-row-id="row_'+row["ISSUE_ID"]+'" data-live-search="true" data-parsley-required="true" data-parsley-validate="true" id="status'+row["ISSUE_ID"]+'" name="sStatusDDL"><option value="">-- Select --</option><option value="9" selected="selected">DAMAGED</option><option value="4" selected="selected">RETURNED</option></select>';
    }, "targets":2

},
{
    "render": function (data, type, row) 
    {
       
        return '<input type="number" id="txtFineAmount_'+ row["ISSUE_ID"] +'" class="form-control" placeholder="Enter Amount" min="1">';
    }, "targets":3
}

            ],
            language: {
                infoEmpty: "No records available - Got it?",
            }
        });


        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

      
    }

</script>
<script>

    $('#btnSubmit').on('click', function ()
    {
        var nCount = 0;
        var sStatus=0;
        var mode = "";
        var JsonData = "";

        var isValid = true;

        JsonData = '{"liBookTransaction":[';
        $('#tblReturnedTransaction tbody tr').each(function () {
            if ($(this).find('input[type="checkbox"]').is(':checked')) {
                nCount++;
                if ($(this).find('select[name="sStatusDDL"]').parsley().validate() !== true) isValid = false;
                if (!isValid) {
                    
                    sStatus++;
                    //gritter-info,danger,success,warning,default
                    //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                    return false;

                }
                else
                {

                    if ($(this).find('select[name="sStatusDDL"]').val() !=@Common.LI_BOOK_STATUS.DAMAGED)
                    {
                        JsonData += '{"ISSUE_ID":"' + $(this).find('input[type="checkbox"]').attr('cms-row-id') + '","BOOK_STATUS":"' + $(this).find('select[name="sStatusDDL"]').val() + '","FINE":"0"},';
                        sStatus = 0;
                    }
                    else
                    {
                        if ($(this).find('input[type="number"]').val())
                        {
                            
                            JsonData += '{"ISSUE_ID":"' + $(this).find('input[type="checkbox"]').attr('cms-row-id') + '","BOOK_STATUS":"' + $(this).find('select[name="sStatusDDL"]').val() + '","FINE":"' + $(this).find('input[type="number"]').val() + '"},';
                            sStatus = 0;
                        }
                        else
                        {
                            
                            sStatus++;
                            swal({ title: "Info !", text: "Please enter the amount to continue!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            return false;
                        }
                    }
                }


            }
        });
      
        if (nCount != 0 && sStatus==0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookReturnedTransaction", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonTransactionDetails: JsonData},
                success: function (data)
                {
                    if (data.Message != null && data.Message != '') {
                        if (data.ErrorCode == "204") {
                            swal({ title: "Info!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "406") {
                            swal({ title: "Failed!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                            loadContent('/Library/ReturnedTransaction');
                        }
                    }
                    else {

                        //if (data.liGridClass != null && data.liGridClass.length > 0) {
                        //    $('#thStatus').removeClass("hidden");
                        //    //$('#bAppend > .ms-lastCell').removeClass("hidden");

                        //    for (var i = 0; i < data.liGridClass.length; i++) {
                        //        $('#tblReturnedTransaction tbody').find('tr[cms-issue_id=' + data.liGridClass[i].ISSUE_ID + ']').find('td.ms-lastCell').removeClass('hidden');
                        //        $('#tblReturnedTransaction tbody').find('tr[cms-issue_id=' + data.liGridClass[i].ISSUE_ID + ']').find('td.ms-lastCell').text(data.liGridClass[i].STATUS);
                        //    }
                        //}
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error !", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
        else if(sStatus!=0)
        {
         
        }
        else
        {
            swal({ title: "Alert !", text: "Please Select Any One To Continue !", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }

    });

</script>


