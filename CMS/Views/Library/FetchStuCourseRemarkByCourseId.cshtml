
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>FetchStuCourseRemarkByCourseId</title>
</head>
<body>
    <div>
    </div>
</body>
</html>

@model CMS.ViewModel.ViewModel.StaffViewModel
@{ Layout = null; int count = 0;}
<div class="table-responsive col-md-12">
    <table class="table table-bordered table-hover" id="tblStuCourseRemark">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    Roll No
                </th>
                <th>
                    Register No
                </th>
                <th>
                    Name
                </th>
                <th>
                    Entry Staff
                </th>
                <th>
                    Remark
                </th>
                <th>Component</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.liStu_Course_Remark != null && Model.liStu_Course_Remark.Count > 0)
            {
                foreach (var item in Model.liStu_Course_Remark)
                {
                    <tr>
                        <td>
                            @{ count++;}
                            @count
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.ROLL_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.REGISTER_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.STUDENT_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.STAFF_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.REMARK)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.COMPONENT)
                        </td>

                    </tr>
                }
            }

        </tbody>
    </table>
</div>
