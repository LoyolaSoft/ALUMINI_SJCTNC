

@model CMS.ViewModel.ViewModel.WebsiteViewModel
@using CMS.Utility
@{
    ViewBag.Title = "WorkSheetGuideline";
    Layout = null;
}


<style>
    body {
        font-family: "Segoe UI", sans-serif;
        background-color: #f0f2f5;
    }

    .worksheet-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }

    .worksheet-title {
        text-align: center;
        font-size: 26px;
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 30px;
    }

    .shift-box {
        background: #fff;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .shift-header {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 10px;
        color: #007bff;
        display: flex;
        align-items: center;
    }

        .shift-header i {
            margin-right: 10px;
        }

    .shift-note {
        font-size: 14px;
        color: #555;
        margin-bottom: 20px;
    }

    .module-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .module-card {
        flex: 1 1 220px;
        background: #e9f7fe;
        padding: 15px 20px;
        border-radius: 8px;
        text-decoration: none;
        color: #2c3e50;
        border: 1px solid #b5e0f3;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .module-card:hover {
            background: #d3effb;
            border-color: #7cc7ec;
        }

        .module-card i {
            font-size: 20px;
            color: #007bff;
        }

    .module-disabled {
        background: #f5f5f5;
        color: #999;
        border: 1px dashed #ccc;
        pointer-events: none;
    }

    @@media (max-width: 600px) {
        .module-grid {
            flex-direction: column;
        }
    }
</style>
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Effective English</a></li>
        <li class="active">WorkSheets</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">WorkSheets<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand" title="Expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload" title="Reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse" title="Collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove" title="Remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">WorkSheets</h4>
        </div>
        <div class="panel-body">

            <div class="panel-body">

                @if (ViewBag.classYear == "1" && ViewBag.classLevel == "1")
                {
                    <div class="worksheet-container">
                        <div class="worksheet-title">Effective English Worksheets</div>
                        @if (ViewBag.shift == "1")
                        {
                            <!-- SHIFT I -->
                            <div class="shift-box">
                                <div class="shift-header"><i class="fa fa-clock"></i> SHIFT - I</div>
                                <div class="shift-note">
                                    You will need to login using your college email ID to complete the worksheets.
                                </div>
                                <div class="module-grid">
                                    <a class="module-card" href="https://docs.google.com/forms/d/e/1FAIpQLSdnixiC_QO85vc3W73VWkNmaWOgCkg86pwQ2PrIqgKlq_X21A/viewform" target="_blank">
                                        <i class="fa fa-book"></i> Module 1
                                    </a>
                                    <a class="module-card" href="https://docs.google.com/forms/d/e/1FAIpQLSeU0dmiCdFrqZmAkOWuu5iSVW1mrBiIFFnv65VhHl3zgUWa1Q/viewform" target="_blank">
                                        <i class="fa fa-book"></i> Module 2
                                    </a>
                                    <a class="module-card" href="https://docs.google.com/forms/d/e/1FAIpQLSdbSCShPa6G2MHpXuDz_rpkv6vMXEcxjfZDeVjCzhFK4PZKiA/viewform" target="_blank">
                                        <i class="fa fa-book"></i> Module 3
                                    </a>
                                    @for (int i = 4; i <= 10; i++)
                                    {
                                        <div class="module-card module-disabled"><i class="fa fa-lock"></i> Module @i (Coming Soon)</div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- SHIFT II -->
                            <div class="shift-box">
                                <div class="shift-header"><i class="fa fa-clock"></i> SHIFT - II</div>
                                <div class="shift-note">
                                    You will need to login using your college email ID to complete the worksheets.
                                </div>
                                <div class="module-grid">
                                    <a class="module-card" href="https://docs.google.com/forms/d/e/1FAIpQLSfFLiw_-Pet8XT5IhIMVijW1lrEi2jMUnfdw9SAnc7gm4YuzA/viewform" target="_blank">
                                        <i class="fa fa-book"></i> Module 1
                                    </a>
                                    <a class="module-card" href="https://docs.google.com/forms/d/e/1FAIpQLSe7Cn_R6ZfBtT7jSnwM2k50UGeg3_Uo4yq3w7x3bHHaEd9pUQ/viewform" target="_blank">
                                        <i class="fa fa-book"></i> Module 2
                                    </a>
                                    <a class="module-card" href="https://docs.google.com/forms/d/e/1FAIpQLScldB3xTKe-IU4RwCLDH6GAkJr_YsmiVYNEeLLhKTIJ5gdd2Q/viewform" target="_blank">
                                        <i class="fa fa-book"></i> Module 3
                                    </a>
                                    @for (int i = 4; i <= 10; i++)
                                    {
                                        <div class="module-card module-disabled"><i class="fa fa-lock"></i> Module @i (Coming Soon)</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <strong>Note:</strong> Worksheets are available exclusively for first-year UG students.
                    </div>

                }


            </div>
        </div>


    </div>

</div>



