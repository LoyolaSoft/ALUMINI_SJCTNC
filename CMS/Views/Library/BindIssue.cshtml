<script>
    function ContentLoad() {
        // Document Ready Function
       
        //$('.selectpicker').selectpicker({
        //    size: 4
        //});   

        //$('.selectpicker').selectpicker('refresh');

    }
    //$('.selectpicker').selectpicker({
    //    size: 5
    //});
    //$('.selectpicker').selectpicker('refresh');

    var message=@Html.Raw(Json.Encode(Model.Message));
    if(message!=null && message!="")
    {
        alertMessage(message);
    }


    function alertMessage(Message)
    {
        swal({ title: "error !", text:Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
    }



    //var tbl = $('#tblLiArticleIssue').DataTable();
    var tbl2 = $('#tblLiBookIssue').DataTable();

    function getSubmit(id)
    {
        var nCount = 0;
        var sStatus=0;
        var mode = "";
        var JsonData = "";

        var isValid = true;
        if (id == "tblLiArticleIssue")
        {
            
            JsonData = '{"liBookIssue":[';
            $('#tblLiArticleIssue tbody tr').each(function () {
                if ($(this).find('input[type="checkbox"]').is(':checked')) {   
                    nCount++;
                    if ($(this).find('select[name="sStatusDDL"]').parsley().validate() !== true) isValid = false;
                    if (!isValid) {
                        sStatus++;
                        //gritter-info,danger,success,warning,default
                        //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                        return false;
                    }
                    else
                    {
                        JsonData += '{"USER_ID":"' + $('#objLiUserDetails_USER_ID').val() + '","BOOK_ID":"' + $(this).attr('cms-BookId') + '","ISSUE_DATE":"","ISSUE_BY":"","RETURN_DATE":"","RECEIVED_BY":"","STATUS":"' + $(this).find('select[name="sStatusDDL"]').val() + '","ACADEMIC_YEAR":""},';
                        sStatus=0;
                    }
                    
                    
                }
            });
        }
        else {
          
            JsonData = '{"liBookIssue":[';
            $('#tblLiBookIssue tbody tr').each(function () {

                if ($(this).find('input[type="checkbox"]').is(':checked')) {
                    nCount++;

                    if ($(this).find('select[name="sStatusDDL"]').parsley().validate() !== true) isValid = false;
                    if (!isValid) {
                       
                        sStatus++;
                        //gritter-info,danger,success,warning,default
                        //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                        return false;
                    }
                    else
                    {
                        JsonData += '{"USER_ID":"' + $('#objLiUserDetails_USER_ID').val() + '","BOOK_ID":"' + $(this).attr('cms-BookId') + '","ISSUE_DATE":"","ISSUE_BY":"","RETURN_DATE":"","RECEIVED_BY":"","STATUS":"' + $(this).find('select[name="sStatusDDL"]').val() + '","ACADEMIC_YEAR":"","BOOK_STATUS":"'+ $(this).find('select[name="sStatusDDL"]').val() +'"},';
                        sStatus=0;
                    }
                }
            });
        }


        if (nCount != 0 && sStatus==0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookIssueCirculation", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonBookIssueDetails: JsonData},
                success: function (data)
                {
                    
                    if(data.ErrorCode=="200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        $('#activeTag').click();


                        if($('#objLiUserDetails_BOID').val()!="" && $('#objLiUserDetails_BOID').val()!=null)
                        {
                            loadContent1("/Library/BindIssue?sUserId="+$('#objLiUserDetails_BOID').val()+"","divBindForIssue");
                        }
                        else if($('#objLiUserDetails_RFID').val()!="" && $('#objLiUserDetails_RFID').val()!=null)
                        {
                            loadContent1("/Library/BindIssue?sUserId="+$('#objLiUserDetails_RFID').val()+"","divBindForIssue");
                        }
                 
                    }
                    if(data.ErrorCode=="417")
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                       
                    }
                    if(data.ErrorCode=="406")
                    {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                       
                    }

                }, error: function (error)
                {
                    swal({ title: "Internal Server Error !", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
        else if(sStatus!=0)
        {

        }
        else
        {
            swal({ title: "Alert !", text: "Please Select Any One To Continue !", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    }

    //status validation
    function onStatusValidate(id)
    {

       
        var status=$('#'+id +"").val();
        var text=$("#"+id+" "+"option:selected").text();
       
        if((status!=@Common.Sup_li_Status.Missing && status!=@Common.Sup_li_Status.Retrun && status!=@Common.Sup_li_Status.Reserved && status!=@Common.Sup_li_Status.Damaged ))
        {

        }
        else
        {
            swal({ title: "Alert !", text: "You can't select "+text+" here" , showConfirmButton: false, timer: 2000, type: 'error', animation: true });
            $("#"+id+" "+ "option:eq(0)").attr("selected","selected");
        }
    }

</script>



