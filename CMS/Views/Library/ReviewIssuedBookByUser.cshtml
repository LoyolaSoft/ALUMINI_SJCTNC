

@model CMS.ViewModel.ViewModel.LibraryViewModel
@{
    ViewBag.Title = "ReviewIssuedBookByUser";
    //    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Issued Book Review</li>
    </ol>
    <h1 class="page-header">Issued Book Review</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Issued Book Review</h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    @if (Model.libookReview != null && Model.libookReview.Count > 0)
                    {
                        <div class="invoice-header">
                            @*<div class="invoice-from">
                                    <small></small>
                                    <address class="m-t-5 m-b-5">
                                        <strong>
                                            <label>Course Name : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().COURSE_TITLE</span>
                                        </strong><br />
                                        <strong>
                                            <label>Course Code &nbsp; : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().COURSE_CODE</span>
                                        </strong><br />
                                        <strong>
                                            <label>Department : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().DEPARTMENT</span>
                                        </strong><br />
                                    </address>
                                </div>
                                <div class="invoice-to">
                                    <small></small>
                                    <address class="m-t-5 m-b-5">
                                        <strong>
                                            <label>Staff Name(s) : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().STAFF_NAME</span>
                                        </strong><br />
                                        <strong>
                                            <label>Semester  &nbsp; : </label><span class="semi-bold" id="sSemester"> @Model.liCIA_Staff_Info.FirstOrDefault().SEMESTER_ID</span>
                                        </strong><br />
                                        <strong>
                                            <label>Class Name : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().CLASS_NAME</span>
                                        </strong><br />

                                    </address>
                                </div>*@

                        </div>
                        <br />
                    }
                    <div class="table-responsive col-md-12">
                        <table class="table table-bordered table-hover" id="tblAIssueBookRemark">
                            <thead>
                                <tr>
                                    <th width="5px">
                                        #
                                    </th>
                                    <th>
                                        USERNAME
                                    </th>
                                    <th>
                                        Book No
                                    </th>
                                    <th>
                                        Access No
                                    </th>
                                    <th>
                                        Book Title
                                    </th>
                                    <th width="30%">
                                        Review
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.libookReview != null && Model.libookReview.Count > 0)
                                {
                                    foreach (var item in Model.libookReview)
                                    {
                                        <tr cms-remarkid="@item.REVIEW_ID" cms-issueid="@item.ISSUE_ID" cms-studentid="@item.USER_ID">
                                            <td width="5px">
                                                @{ count++;}
                                                @count
                                            </td>
                                            <td>
                                                @Html.DisplayFor(m => item.USERNAME)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(m => item.BOOK_NO)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(m => item.ACCESS_NO)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(m => item.BOOK_TITLE)
                                            </td>
                                            <td width="30%">
                                                @if (string.IsNullOrEmpty(@item.REVIEW_ID))
                                                {

                                                    <textarea class="form-control" style="height:80px; width:300px;" maxlength="200">@item.REVIEW</textarea>
                                                }
                                                else
                                                {
                                                    <textarea class="form-control" style="height:80px; width:300px;" maxlength="200" disabled>@item.REVIEW</textarea>

                                                }
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-12" id="dvAddStuCourseRemark">

                </div>
                <div class="col-md-12">
                    <div class="form-group pull-right">
                        <a class="btn btn-success" id="btnSaveRemark">Submit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>

        function ContentLoad() {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');


        $('#btnGetRemark').on("click", function () {
        var sAcademicYear = $('#CourseList').val();
        if (sAcademicYear == '' || sAcademicYear == '0') {
            alert('Please Choose Course...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindStudentForStuCourseRemark", "Staff")",
            method: "POST",
            datatype: "json",
            data: { sCourseId: $('#CourseList').val(), sClassId: $('#liLCasslist').val() , sComponentId: String($('#Component').val())},
            success: function (data) {
                $("#dvAddStuCourseRemark").empty();
                $("#dvAddStuCourseRemark").append(data);
                $("#tblAddStuCourseRemark").DataTable({ paging: false });
                $('#btnSaveRemark').removeClass("disabled");
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        })
        });
        $('#btnSaveRemark').click(function ()
        {
            var jsonObject;
            if (jsonObject == null) {
                jsonObject = '{"LiJsonIssueBookRemark":[';
                $('#tblAIssueBookRemark tbody tr').each(function () {
                    if ($(this).find('input[type="text"]').val()!="") {
                        jsonObject += '{"REVIEW_ID":"' + $(this).attr("cms-remarkid") + '","ISSUE_ID":"' + $(this).attr("cms-issueid") + '","USER_ID":"' + $(this).attr("cms-studentid") + '","REVIEW":"' + ($(this).find('textarea').val()) + '"},';
                    }
                    });
                jsonObject = jsonObject.slice(0, -1);
                jsonObject += ']}';
            }
            $.ajax({
                url: "@Url.Action("SaveIssueBookReView", "Library")",
                method: "post",
                content: "application/json; charset=utf-8",
                data: {JsonIssueBookRemark : jsonObject },
                success: function (data) {
                    alert(data.Message);
                    $('#btnGetRemark').click();
                }, error: function (e) {
                    alert('Internal Server Error !');
                }
        });

        });
</script>



