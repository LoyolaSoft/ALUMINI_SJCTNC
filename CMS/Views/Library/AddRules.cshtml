
@{
    ViewBag.Title = "AddRules";
}

@model CMS.ViewModel.ViewModel.LibraryViewModel
@{
    ViewBag.Title = "Rules";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />



<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">AddRules</li>
    </ol>
    <h1 class="page-header">Add Rules</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Add Rules</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-12 form-horizontal">
                <div class="col-md-4 form-group">
                    @Html.Label("Member Category", htmlAttributes: new { @class = "col-md-6 control-label " })
                    <div class="col-md-6">
                        @Html.DropDownListFor(m => m.MemberCategory, (Model.MemberCategory != null) ? Model.MemberCategory : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true"})
                        @Html.ValidationMessageFor(m => m.MemberCategory, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 form-group hidden" id="dApplicationType">
                    @Html.Label("Application Type", htmlAttributes: new { @class = "col-md-6 control-label " })
                    <div class="col-md-6">
                        @Html.DropDownListFor(m => m.ApplicationType, (Model.ApplicationType != null) ? Model.MemberCategory : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.ApplicationType, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="col-md-3 form-group">
                    <label class="col-md-3 control-label">Description Category</label>

                    <div class="col-md-9">
                        <input type="text" id="txtDescriptoinCategory" class="form-control" placeholder="Enter Description Category" data-parsley-required="true">
                    </div>
                </div>*@
              
                  

                    <div class="col-md-4 form-group">
                        <label class="col-md-5 control-label">Max Books</label>

                        <div class="col-md-7">
                            <input type="number" id="txtMaxBooks" class="form-control" placeholder="Enter Maximum Book" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="col-md-6 control-label">Loan Period</label>

                        <div class="col-md-6">
                            <input type="number" id="txtLoanPeriod" class="form-control" placeholder="Enter Loan Period" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="col-md-6 control-label">Fine Amount</label>

                        <div class="col-md-6">
                            <input type="number" id="txtFineAmount" class="form-control" placeholder="Enter Fine Amount" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="col-md-5 control-label">Deposit</label>

                        <div class="col-md-7">
                            <input type="number" id="txtDeposit" class="form-control" placeholder="Enter Deposit" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="col-md-6 control-label">Auto Reneval</label>

                        <div class="col-md-6">
                            <input type="text" id="txtAutoReneval" class="form-control" placeholder="Enter Auto Reneval" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="col-md-5 control-label">Extra Books</label>

                        <div class="col-md-7">
                            <input type="text" id="txtExtraBooks" class="form-control" placeholder="Enter Extra Books" data-parsley-required="true">
                        </div>
                    </div>
                
            </div>
            <div class="form-group col-md-1">
                <a href="#" id="btnSubmit" class="btn btn-primary">submit</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    ContentLoad = function () {
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }
      

        $('#btnSubmit').click(function () {   

            if ($('#MemberCategory').val() && $('#txtMaxBooks').val() && $('#txtLoanPeriod').val() && $('#txtFineAmount').val() && $('#txtDeposit').val() && $('#txtAutoReneval').val() && $('#txtExtraBooks').val())
            {
                var jsonData = '{"RULE_ID":"","MEM_CATEGORY":"' + $('#MemberCategory').val() + '","MAX_BOOKS":"' + $('#txtMaxBooks').val() + '","LOAN_PERIOD":"' + $('#txtLoanPeriod').val() + '","FINE_AMOUNT":"' + $('#txtFineAmount').val() + '","DEPOSIT":"' + $('#txtDeposit').val() + '","AUTORENEVAL":"' + $('#txtAutoReneval').val() + '","EXTRA_BOOKS":"' + $('#txtExtraBooks').val() + '","APPTYPE_ID":"' + $('#ApplicationType').val() + '"}';


                $.ajax({
                    url:"/Library/SaveRules",
                    type:"post",
                    data: { sJsonData: jsonData },
                    success:function(data)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }

                });



            }
            else {

                alert("Please fill all the fields!");
            }
        });






</script>


<script>
    $('#MemberCategory').on("change", function () {

        if($('#MemberCategory').val()=="1")
        {
            $('#dApplicationType').removeClass("class");
            $('#dApplicationType').attr("data-parsley-required","true");
        }
        else {
            $('#dApplicationType').removeClass("hidden");
            $('#dApplicationType').attr("data-parsley-required", "false");
        }
    });
</script>