@model CMS.ViewModel.ViewModel.LibraryViewModel

@{ 
    Layout = null;
}

<div class="table-responsive form-group col-md-12">
    <table class="table table-bordered table-hover" id="tblSearchView">
        <thead>
            <tr>
                <th>#</th>
                <th>Select</th>
                <th>Discription</th>
                <th>View</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liBookDetails != null && Model.liBookDetails.Count > 0)
            {
                int nCount = 0; string sChecked = string.Empty; string sDisabled = string.Empty; string sClass = string.Empty;
                foreach (var item in Model.liBookDetails)
                {
                    <tr cms-BookId="@item.BOOK_ID" cms-ReserveId="@item.RESERVE_ID">
                        <td>@{nCount++;} @nCount</td>
                        <td>
                           <div class="checkbox checkbox-css">
                               <input type="checkbox" id="chNoAbsentees_@nCount" name="chNoAbsentees_@nCount" cms-chReserveId="@item.RESERVE_ID" onchange="CheckLimit()" @if (!string.IsNullOrEmpty(item.RESERVE_ID)) { sChecked = "Checked"; }else{ sChecked = string.Empty; } @sChecked @if (item.LI_BOOK_STATUS!="1") { sDisabled = "disabled";sClass = "text-danger"; }else{ sDisabled = string.Empty; sClass = "text-success"; } @sDisabled />
                               <label for="chNoAbsentees_@nCount"></label>
                           </div>
                        </td>
                        <td>Book Title : <b>@item.DOC_TITLE</b>  <br /> 
                            Parallel Title : <b>@item.PARALLEL_TITLE</b> <br />
                            By : <b>@item.PERSONAL_AUTHOR1</b> <br /> 
                            Location : <b>@item.CLASS_NO + @item.BOOK_NO </b> <br /> 
                            Status : <b > @item.STATUS</b><br/>
                           Book Status : <b class="@sClass"> @item.STATUS_NAME</b>
                        </td>
                        <td><i class="glyphicon glyphicon-eye-open text-primary" onclick="FetchBookInfoById(@item.BOOK_ID)"></i></td>
                    </tr>
                 }
            }
        </tbody>
    </table>

    <div class="col-md-12 pull-right">
        <a href="javascript:;" class="btn btn-primary pull-right" onclick="SubmitData()"> Submit </a>
    </div>
</div>







