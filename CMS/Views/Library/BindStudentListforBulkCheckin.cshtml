@model CMS.ViewModel.ViewModel.CommunicationViewModel
@{Layout = null; int count = 0;}

<div class="col-md-12">
    <div class="col-md-12" id="divToSelect">
        <div class="table-responsive">
            <table class="table table-hover" id="StudentToSelect">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>
                            <input type="checkbox" id="AllchkID" onchange="SelectOrUnselect()" /> Select All
                        </th>
                        <th>RollNo</th>
                        <th>Name</th>
                        <th>Class</th>
                        <th>Mobile</th>
                    </tr>
                </thead>
                <tbody>
                    @{ if (Model.LIStudentDetails != null)
                        {
                            foreach (var item in Model.LIStudentDetails)
                            {
                                <tr cms-studentid="@item.STUDENT_ID" cms-StuClassId="@item.CLASS_ID">
                                    <td>@{ count++;}@count</td>
                                    <td>
                                        <input type="checkbox" name="chkStudent" id="chkID_@item.STUDENT_ID" cms-studentid="@item.STUDENT_ID" />
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.ROLL_NO)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FIRST_NAME)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CLASS_NAME)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FR_MOBILE)</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function SelectOrUnselect() {
        var isChecked = $('#AllchkID').prop('checked');
        $('#StudentToSelect tbody input[type="checkbox"]').each(function () {
            $(this).prop('checked', isChecked);
        });
    }
</script>
