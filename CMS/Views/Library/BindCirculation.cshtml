
@model CMS.ViewModel.ViewModel.LibraryViewModel
@{
    ViewBag.Title = "BindCirculation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
}



<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="form-group">
    <div class="col-md-12 table-responsive">
        <table class="table table-bordered" id="tblCirculation">
            <thead>
                <tr>
                    <th>#</th>

                    <th>Isbn No</th>
                    <th>Access No</th>
                    <th>Book title</th>
                    <th>Author</th>
                    <th>Issued Date</th>
                    <th>Transaction Status</th>
                    <th>Fine Status</th>
                    <th>Balance</th>
                    <td>Payment Date</td>
                    <td>Returned Date</td>
                    <td>Actual Returned Date</td>
                </tr>
            </thead>
            <tbody>
                @if (Model.liBookCirculation != null && Model.liBookCirculation.Count > 0)
                {
                    foreach (var item in Model.liBookCirculation)
                    {
                <tr cms-BookId="@item.BOOK_ID">
                    <td>@{nCount++;} @nCount</td>

                    <td>@item.ISBN_NO</td>
                    <td>@item.ACCESS_NO</td>
                    <td>@item.BOOK_TITLE</td>
                    <td>@item.AUTHOR</td>
                    <td>@item.ISSUE_DATE</td>
                    @if (item.IS_RETURN_CONFIRMED == "1")
                    {
                        <td>@item.STATUS <p>Confirmed</p></td>
                    }
                    else
                    {
                        <td>@item.STATUS</td>
                    }


                    @if (item.BALANCE != "0" && Convert.ToInt16(item.CREDIT) > 0)
                    {

                        <td><label class="label label-danger f-s-12">Not Paid</label></td>
                        <td><i class="fa fa-inr f-s-14"> @item.BALANCE</i></td>
                    }
                    else if (item.BALANCE == "0" && item.CREDIT == "0")
                    {

                        <td><label class="label label-info f-s-12">No Fine</label></td>
                        <td><i class="fa fa-inr f-s-14">0</i></td>
                    }
                    else
                    {

                        @*<td><i class="ion-ios-checkmark-outline fa-2x text-success"></i></td>*@
                        <td><label class="label label-success f-s-12">Paid</label></td>
                        <td><label class="fa fa-inr f-s-14"> @item.BALANCE</label></td>

                    }

                    <td>@item.PAYMENT_DATE</td>
                    <td>@item.RETURN_DATE</td>
                    <td>@item.ACTUAL_RETURNED_DATE</td>
                </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    $('#tblCirculation').DataTable();
</script>

