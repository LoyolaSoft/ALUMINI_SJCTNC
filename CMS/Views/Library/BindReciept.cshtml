
@model CMS.ViewModel.ViewModel.LibraryViewModel
@{
    ViewBag.Title = "BindReciept";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;

}

<input type="text" class="form-control input-sm hidden" id="txtDuesId" hidden value="@Model.liIssueDues.FirstOrDefault().DUES_ID" />
<div class="form-horizontal ">
    <h4 class="lead"><img src="~/Content/assets/img/hcc-img/hcclogo.jpg" width="70px;" style="box-shadow:1px 1px #eee;" class="img-circle img" alt="HCC Logo" /> @Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h4>

    <hr />

    <div style="page-break-after:always !important;page-break-inside:avoid !important;" id="dvprint_@Model.liIssueDues.FirstOrDefault().DUES_ID">
        @if (Model.liIssueDues != null && Model.liIssueDues.Count() > 0)
        {   //this to print receipt header
            int count = 0;
            <div class="col-md-12">
                <div class="pull-left">
                    <h6>
                        <label>Receipt No:</label>@Model.liIssueDues.FirstOrDefault().RECEIPT_NO
                    </h6>
                </div>
                <div class="pull-right">
                    <label>Date:</label>@Model.liIssueDues.FirstOrDefault().PAYMENT_DATE
                </div>
            </div>
            <div class="col-md-12">

                <div class="col-md-12">
                    @if (Model.liCollegeDetails != null)
                    {
                        foreach (var item in Model.liCollegeDetails)
                        {
                            <center>
                                <img src="/Content/assets/img/hcc-img/hcclogo.jpg" width="75px;" class=" ">
                                <table>
                                    <tr>
                                        <td><center><strong>@item.COLLEGE_NAME</strong></center></td>
                                    </tr>
                                    <tr>
                                        <td><b> @item.GRADE</b></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">
                                            @item.UNIVERSITY
                                        </td>
                                    </tr>

                                </table>
                            </center>
                        }
                    }
                </div>
            </div>
            <div class="col-md-12">
                <table class="table-condensed" cellpadding="5">
                    <tr>
                        @*<td width="15%"><b>Name</b></td>
                            <td width="35%"><b>@Model.liFeeReport.FirstOrDefault().FIRST_NAME</b></td>
                            <td width="25%"><b>Roll No</b></td>
                            <td width="25%">@dataitem.ROLL_NO</td>*@
                    </tr>
                    <tr>
                        <td><b>Payment Type</b></td>
                        <td>
                            offline
                        </td>
                        <td><b>Programme</b></td>
                        @*<td>@dataitem.PROGRAMME_NAME</td>*@
                    </tr>
                </table>

            </div>
            <div class="col-md-12">
                <table class="table-bordered" cellpadding="50" width="100%">
                    <tr class="text-center">
                        <th>&nbsp;&nbsp;#</th>
                        <th>
                            &nbsp;&nbsp;PARTICULARS
                        </th>
                        <th>
                            &nbsp;&nbsp;AMOUNT
                        </th>
                    </tr>
                    @foreach (var item in Model.liIssueDues)
                    {
                        <tr>
                            <td>
                                &nbsp;&nbsp;&nbsp;@{ count++;}@count
                            </td>
                            <td> &nbsp;&nbsp;&nbsp; Due Fine Amount</td>
                            <td class="text-right"><i class="fa fa-inr"></i>@item.DUE_FINE_AMOUNT &nbsp;&nbsp;&nbsp;</td>
                        </tr>
                        <tr>
                            <td>
                                &nbsp;&nbsp;&nbsp;@{ count++;}@count
                            </td>
                            <td> &nbsp;&nbsp;&nbsp; Revised Due Fine Amount</td>
                            <td class="text-right"><i class="fa fa-inr"></i>@item.REVISED_DUE_FINE_AMOUNT &nbsp;&nbsp;&nbsp;</td>
                        </tr>
                        <tr>
                            <td>
                                &nbsp;&nbsp;&nbsp;@{ count++;}@count
                            </td>
                            <td> &nbsp;&nbsp;&nbsp; Damage Due Fine Amount</td>
                            <td class="text-right"><i class="fa fa-inr"></i>@item.DAMAGE_FINE_AMOUNT &nbsp;&nbsp;&nbsp;</td>
                        </tr>
                        <tr>
                            <td>
                                &nbsp;&nbsp;&nbsp;@{ count++;}@count
                            </td>
                            <td> &nbsp;&nbsp;&nbsp; Missing Due Fine Amount</td>
                            <td class="text-right"><i class="fa fa-inr"></i>@item.MISSING_FINE_AMOUNT &nbsp;&nbsp;&nbsp;</td>
                        </tr>
                    }

                    <tr>
                        <td></td>
                        <td class="text-right">TOTAL  &nbsp;&nbsp;&nbsp;</td>
                        <td class="text-right"><i class="fa fa-inr"></i>@Model.liIssueDues.FirstOrDefault().DEBIT  &nbsp;&nbsp;&nbsp;</td>
                    </tr>
                </table>

            </div>

            <hr />
            <br />
        }
    </div>
    <div class="form-group col-md-12"><button class="btn bg-green pull-right m-b-5" onclick="printDiv('dvprint_@Model.liIssueDues.FirstOrDefault().DUES_ID');">Print</button></div>
</div>


<script>

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Library/DuesList');

    }
</script>










