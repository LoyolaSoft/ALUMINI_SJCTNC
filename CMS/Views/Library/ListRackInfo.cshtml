
@model CMS.ViewModel.ViewModel.LibraryViewModel
@using CMS.Utility
@{
    ViewBag.Title = "RackInfo";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Library Rack Info</li>
    </ol>
    <h1 class="page-header">Library Rack Info</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Library Rack Info</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblLiRules">
                    <thead>
                        <tr>
                            <th>#</th>

                            <th>Rack Info</th>
                            <th>Rack</th>
                            <th>Cell</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liRackInfo != null && Model.liRackInfo.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liRackInfo)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.RACK_INFO</td>
                                    <td>@item.RACK</td>
                                    <td>@item.CELL</td>

                                    <td>
                                        <a href="#Rules-dialog" onclick="FetchLiRackInfoById(@item.RACK_INFO_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.RACK_INFO_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Rack Info</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-3 control-label"> Rack Info  </label>
                                        <div class="col-md-9">
                                            <input type="text" placeholder="" class="form-control input-sm" id="txtRackInfo" data-parsley-required="true"/>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Rack", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(m => m.sRack, (Model.sRack != null) ? Model.sRack : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sRack, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group" id="divSupRole">
                                        @Html.Label("Cell", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(m => m.sCell, (Model.sCell != null) ? Model.sCell : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sCell, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="RackInfoId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        handleDatepicker = function () {
            "use strict";
        }
        handleDatepicker();
        var tbl=$('#tblLiRules').DataTable();


    function FetchLiRackInfoById(RackInfoId)
        {
            $('#pBody').parsley().destroy();

        if (RackInfoId!=null)
            {
                $.ajax({
                    url: "/Library/FetchLiRackInfoById",
                    type:"post",
                    data: { sRackInfoId: RackInfoId },
                    success:function(data)
                    {
                        if(data.Message!=null)
                        {
                            alert(data.Message);
                        }
                        else {
                            if (data.oResult[0] != null)
                            {
                                $('#sRack option[value="' + data.oResult[0].RACK_ID + '"]').attr("selected", "selected");
                                $('#sCell option[value="' + data.oResult[0].CELL_ID + '"]').attr("selected", "selected");
                                
                                $('#txtRackInfo').attr('value', data.oResult[0].RACK_INFO);
                                $('#RackInfoId').attr('value', data.oResult[0].RACK_INFO_ID);
                                $('.selectpicker').selectpicker('refresh');
                            }
                        }

                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }

        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {

                return false;
            }

            var RackInfoId = $('#RackInfoId').val();
            var Rack = $('#sRack').val();
            var Cell = $('#sCell').val();
            var RackInfo = $('#txtRackInfo').val();;


            var jsonData = '{"RACK_INFO_ID":"' + RackInfoId + '","RACK_INFO":"' + RackInfo + '","RACK_ID":"' + Rack + '","CELL_ID":"' + Cell + '"}';

            $.ajax({
                url: "/Library/SaveLiRackInfo",
                type: "post",
                data: { sJsonData: jsonData },
                success: function (data) {

                    if (data.ErrorCode == "200") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Library/ListRackInfo');
                    }
                    if (data.ErrorCode == "417") {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }
                    if (data.ErrorCode == "503") {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                    }
                    if (data.ErrorCode == "204") {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                }

            });



    });

    GetConfirm = function (RackInfoId) {
        if (alert("Are you sure want to delete?")) {
            return false;
        }

        $.ajax({
            url: "/Library/DeleteLiRackInfoById",
            type: "post",
            data: { sRackInfoId: RackInfoId },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    loadContent('/Library/ListRackInfo');
                }
                if (data.ErrorCode == "417") {
                    swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            },
            error: function (ex) {
                alert(ex.Message);
            }


        });
        
    }
           
       

        $('#Add').click(function () {

            $('#pBody').parsley().destroy();

            $('#sRack option[value=""]').attr("selected", "selected");
            $('#sCell option[value=""]').attr("selected", "selected");

            $('#RackInfoId').attr('value', '');
            $('#txtRackInfo').attr('value', '');
            //$('#ApplicationType option[value=""]').attr("selected", "selected");
            //$('#MemberCategory').trigger("change");
            $('.selectpicker').selectpicker('refresh');

        });
</script>






