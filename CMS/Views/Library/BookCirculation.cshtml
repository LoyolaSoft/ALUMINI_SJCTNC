    $('#btnIssueSubmit').on('click', function ()
    {
        var JsonData = '{"liBookIssue":[';
        var nCount = 0;
        $('#tblLiBookIssue tbody tr').each(function ()
        {
            if ($(this).find('input[type="checkbox"]').is(':checked'))
            {
                JsonData += '{"BOOK_ID":"' + $(this).attr('cms-book-id') + '","USER_ID":"' + $('#txtUserId').val() + '","USER_TYPE":"' + $('#txtUserType').val() + '","PROGRAMME_LEVEL":"' + $('#txtProgrammeLevel').val() + '",'+
                    '"ROLE":"' + $('#txtRole').val() + '",' +
                    '"SEMESTER_TYPE":"' + $('#txtSemesterType').val() + '"},';
                nCount++;
            }
        });

        if (nCount != 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookCirculation", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonBookDetails: JsonData, sMode:'0'},
                success: function (data)
                {
                    if (data.sMessage != null && data.sMessage != '') {
                        if (data.sErrorCode == "204") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.sErrorCode == "409") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.sErrorCode == "503") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    }
                    else
                    {

                        if (data.liGridClass != null && data.liGridClass.length > 0)
                        {
                            $('#thStatus').removeClass("hidden");
                            //$('#bAppend > .ms-lastCell').removeClass("hidden");

                            for (var i = 0; i < data.liGridClass.length; i++)
                            {
                                $('#tblLiBookIssue tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID + ']').find('td.ms-lastCell').removeClass('hidden');
                                $('#tblLiBookIssue tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID +']').find('td.ms-lastCell').text(data.liGridClass[i].STATUS);
                            }
                        }
                    }
                }, error: function (error)
                {

                }
            });
        } else
        {
            swal({ title: "Info!", text: "Select item to continue!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    });



    $('#btnReturnSubmit').on('click', function ()
    {
        var JsonData = '{"liBookIssue":[';
        var nCount = 0;
        $('#tblLiBookReturn tbody tr').each(function ()
        {
            if ($(this).find('input[type="checkbox"]').is(':checked'))
            {
                JsonData += '{"BOOK_ID":"' + $(this).attr('cms-book-id') + '","USER_ID":"' + $('#txtUserId').val() + '","USER_TYPE":"' + $('#txtUserType').val() + '","PROGRAMME_LEVEL":"' + $('#txtProgrammeLevel').val() + '",'+
                    '"ROLE":"' + $('#txtRole').val() + '",' +
                    '"SEMESTER_TYPE":"' + $('#txtSemesterType').val() + '"},';
                nCount++;
            }
        });

        if (nCount != 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookCirculation", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonBookDetails: JsonData, sMode:'1'},
                success: function (data)
                {
                    if (data.sMessage != null && data.sMessage != '') {
                        if (data.sErrorCode == "204") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.sErrorCode == "409") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.sErrorCode == "503") {
                            swal({ title: "Info!", text: data.sMessage, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    }
                    else
                    {

                        if (data.liGridClass != null && data.liGridClass.length > 0)
                        {
                            $('#thStatusForReturn').removeClass("hidden");
                            //$('#bAppendForReturn > .ms-lastCell').removeClass("hidden");
                            for (var i = 0; i < data.liGridClass.length; i++)
                            {
                                $('#tblLiBookReturn tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID + ']').find('td.ms-lastCell').removeClass('hidden');
                                $('#tblLiBookReturn tbody').find('tr[cms-book-id=' + data.liGridClass[i].BOOK_ID + ']').find('td.ms-lastCell').text(data.liGridClass[i].STATUS);
                            }
                        }
                    }
                }, error: function (error)
                {

                }
            });
        } else
        {
            swal({ title: "Info!", text: "Select item to continue!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    });


</script>
