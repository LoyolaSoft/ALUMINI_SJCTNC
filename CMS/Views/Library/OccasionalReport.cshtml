<script>
    var todayDate;
    ContentLoad = function ()
    {
            $('.selectpicker').selectpicker({
                size: 6
            });
            $('.selectpicker').selectpicker('refresh');

            $('#BindTotalBookDetails').addClass("active in");
            //$('#BindLibraryMembership').addClass("active in");
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            todayDate = dd + '/' + mm + '/' + yyyy;
           // document.getElementById('DATE').value = today;
            $('input[name="txtStartDate"]').val(todayDate);



          

        }

        handleDatepicker = function () {
            "use strict";


            $(".date").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            //$("input[name='txtEndDate']").datepicker({
            //    todayHighlight: true,
            //    autoclose: true,
            //    endDate: new Date(),
            //    format: "dd/mm/yyyy",
            //    orientation: "right bottom"
            //});


        }
        handleDatepicker();

        GetContent=function (action,code) {
         
            $('#dvGrievanceReport').html('');
            var Startdate = $('.tab-pane.fade.active.in').find('input[name="txtStartDate"]').val();
            var EndDate = $('.tab-pane.fade.active.in').find('input[name="txtEndDate"]').val();
            //var action = $('.tab-pane.fade.active.in').attr('id');
            //alert(action);
          
            var title = action.split('Bind');

            ////bind ajax 
           
         

             if (Startdate && EndDate)
            {
                var ajaxProp =
                {
                    data: { sStartDate: Startdate, sEndDate: EndDate }
                };
             }

            else if (Startdate) {
                 var ajaxProp =
                 {
                     data: { sStartDate: Startdate }
                 };
             }
            else if(code!='' && code!=null)
            {
                var ajaxProp = {
                    data: { sBookNo: code }
                };
            }
            else {
                var ajaxProp =
                {
                    data: { }
                };
            }


            if (action)
            {
                $.ajax({
                    url: "/Library/" + action + "",
                    type: "post",
                    data: ajaxProp.data,
                   // data:{sDate:date},
                    success:function(data)
                    {
                        if(data.Message!=null)
                        {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        }
                        else
                        {
                            $('#dvGrievanceReport').html('');
                            $('#dvGrievanceReport').append(data);
                            $('#lblReportName').text(title[1].toUpperCase());
                        }
                    },
                    error:function()
                    {
                        swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }


                });
            }
            else
            {
                swal({ title: "Error !", text: "No action were selected!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        }






        $('.nav-link').on("click", function () {

            $('#dvGrievanceReport').html('');

        });


        $('#cbxDateWise').click(function () {
            if ($('#cbxDateWise').is(":checked")) {
                $('#BindLibraryFinePaidList').find('#datetimepicker6').show();
            }
            else {
                $('#BindLibraryFinePaidList').find('#datetimepicker6').hide();
                $('#BindLibraryFinePaidList').find('input[name="txtStartDate"]').val('');
            }
        });
      


        $('#SubjectType').change(function () {

            var Code = $('#SubjectType option:selected').text();
            var scode = Code.split('-');
            var tcode = scode[0].trim('');
            if(Code!=null && Code!="")
            {
                GetContent("BindLibrarySubjectWiseBook", tcode);
            }

        });

   
        function printDiv() {
            var printContents = document.getElementById('dvGrievanceReport').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            loadContent('/Grievance/GrievanceReport');
        }
</script>

<script>

    $('#btnBRByOccasional').click(function ()
    {
        var isValid = true;
        if ($('#ptotalBookOccasionalBody').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        $.ajax({
            url: "/Library/SaveRules",
            type: "post",
            data: { sDate: date },
            success: function (data)
            {

                if (data.Message != null) {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
                else {
                    //$('#btnPrint').removeClass("hidden");
                    //$('#btnExport').removeClass("hidden");



                    $('#dvGrievanceReport').html('');
                    $('#dvGrievanceReport').append(data);
                    $('#lblReportName').text(title[1].toUpperCase() + "-" + date);
                }
            },
            error: function ()
            {
                swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });
    });

</script>



