@model CMS.ViewModel.ViewModel.LibraryViewModel
@{
    ViewBag.Title = "BookCirculation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Dues</li>
    </ol>
    <h1 class="page-header">Dues</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Dues</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-12 form-horizontal">
                <div class="form-group">
                    <label class="col-md-1"> ScanId </label>
                    <div class="col-md-4">
                        <input type="text" placeholder="Rfid/Barcode" class="form-control input-sm" id="txtScanId" />
                    </div>
                </div>

                <div class="col-md-12 hidden" id="profile-details">
                    <div class="profile-container">
                        <div class="profile-section">
                            <div class="profile-left">
                                <div class="profile-image">
                                    <div id="dvImage"></div>
                                    <i class="fa fa-user hide"></i>
                                </div>
                            </div>
                            <div class="profile-right">
                                <div class="profile-info">

                                    @*<div class="form-group col-md-12">
                                            <label> RFID : <label id="lblRfid"> </label></label>
                                        </div>*@

                                    <div class="form-group col-md-12">
                                        <label> Name : <label id="lblName"> </label></label>
                                    </div>

                                    <div class="form-group col-md-12">
                                        <label> Date Of Birth : <label id="lblDateOfBirth"> </label></label>
                                    </div>

                                    <div class="form-group col-md-12">
                                        <label> User Type : <label id="lblUserType"> </label></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="" id="divCirculation">

                    </div>

                    @*<div class="col-md-9">
                        <a class="btn btn-primary" href="#issue-dialog" data-toggle="modal"><i class="fa fa-plus" id="btnIssue"></i>Issue</a>
                        <a class="btn btn-primary" href="#return-dialog" data-toggle="modal"><i class="fa fa-plus" id="btnReturn"></i>Return</a>
                    </div>*@

                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="txtUserId" value="" />
<input type="hidden" id="txtUserType" value="" />
<input type="hidden" id="txtRole" value="" />
<input type="hidden" id="txtSemesterId" value="" />
<input type="hidden" id="txtSemesterType" value="" />
<input type="hidden" id="txtProgrammeLevel" value="" />

<div class="modal" id="pay-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Pay Fine</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="issueBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12" id="divpayAppend">
                            

                         
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @*<a href="javascript:;" id="btnIssueSubmit" class="btn btn-sm btn-primary">Submit</a>*@
                @*<a href="javascript:;" class="btn btn-sm btn-info" id="btnIssueClear">Clear</a>*@
                <a href="javascript:;" class="btn btn-sm btn-danger" id="btnIssueCancel" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="reciept-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Reciept</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="issueBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12" id="divRecieptAppend">
                          
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @*<a href="javascript:;" id="btnIssueSubmit" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-info" id="btnIssueClear">Clear</a>*@
                <a href="javascript:;" class="btn btn-sm btn-danger" id="btnIssueCancel" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>


<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('#txtScanId').keypress(function (event)
    {
        var x = event.which || event.keyCode
        if (x == 13)
        {
            var text = $('#txtScanId').val();
            $.ajax({
                url: '@Url.Action("FetchStudentDetails", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sScanId: text },
                success: function (data) {
                    if (data.Message != null && data.Message != '')
                    {

                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                        // alert(data.Message); // If Error Occur's alert will  fire ...


                        $('#profile-details').addClass('hidden');


                        // Bind Data's ,..
                        $('#txtScanId').val('');
                        $('#lblName').text('');
                        $('#lblDateOfBirth').text('');
                        $('#lblUserType').text('');
                        $('#lblBloodGroup').text('');

                        $('#txtUserId').val('');
                        $('#txtUserType').val('');
                        $('#txtRole').val('');

                        $('#txtSemesterId').val('');
                        $('#txtSemesterType').val('');
                        $('#txtProgrammeLevel').val('');

                        $('#dvImage').empty();



                    } else
                    {


                        if (data.oResult.sMessage != null && data.oResult.sMessage != '')
                        {
                            if (data.oResult.sErrorCode == "404")
                            {
                                swal({ title: "Info !", text: data.oResult.sMessage, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                            }

                                $('#profile-details').addClass('hidden');


                                // Bind Data's ,..
                                $('#txtScanId').val('');
                                $('#lblName').text('');
                                $('#lblDateOfBirth').text('');
                                $('#lblUserType').text('');
                                $('#lblBloodGroup').text('');
                                $('#txtUserId').val('');
                                $('#txtUserType').val('');
                                $('#txtRole').val('');

                                $('#txtSemesterId').val('');
                                $('#txtSemesterType').val('');
                                $('#txtProgrammeLevel').val('');

                                $('#dvImage').empty();


                        }
                        else
                        {

                                $('#profile-details').removeClass('hidden');

                                // Bind Data's ,..

                                $('#lblName').text(data.oResult.objUserAccount.FIRST_NAME);
                                $('#lblDateOfBirth').text(data.oResult.objUserAccount.DATE_OF_BIRTH);
                                $('#lblUserType').text(data.oResult.objUserAccount.USER_TYPE_NAME);
                                $('#lblBloodGroup').text(data.oResult.objUserAccount.BLOOD_GROUP);
                                $('#dvImage').empty();

                                $('#dvImage').append('<img src="' + data.oResult.objUserAccount.PHOTO + '" alt="User Image" id="imgUser"/>');
                                $('#txtUserId').val(data.oResult.objUserAccount.USER_ID);
                                $('#txtUserType').val(data.oResult.objUserAccount.USER_TYPE);
                                $('#txtRole').val(data.oResult.objUserAccount.ROLE);
                                $('#txtSemesterType').val(data.oResult.objUserAccount.SEMESTER_TYPE);
                                $('#txtProgrammeLevel').val(data.oResult.objUserAccount.PROGRAMME_LEVEL);

                                if (data.oResult.liBookCirculation != null && data.oResult.liBookCirculation.length>0)
                                {
                                     $.ajax({
                                         url:'@Url.Action("BindDues", "Library")',
                                         method: 'POST',
                                         data: { sData: data.oResult.liBookCirculation},
                                                success: function (data1)
                                                {

                                                    $('#divCirculation').empty();
                                                    $('#divCirculation').append(data1);
                                                }, error: function (error)
                                                {

                                                }
                                             });
                            }
                                else {
                                    $('#divCirculation').empty();
                                    $('#divCirculation').append("<div class='alert alert-danger'>No Circulation Yet !</div>");
                                }
                            }



                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
</script>

<script>
    function loadFine(duesId)
    {
        
        if (duesId != null && duesId!="")
        {
            
            $.ajax({
                url: '@Url.Action("FetchDueDetails", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sDuesId: duesId },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        if (data.ErrorCode == "204") {
                            swal({ title: "Info!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    }
                    else
                    {

                            if (data.oResult != null)
                                {
                                     $.ajax({
                                         url:'@Url.Action("BindPay", "Library")',
                                         method: 'POST',
                                         data: { sData: data.oResult},
                                                success: function (data1)
                                                {

                                                    $('#divpayAppend').empty();
                                                    $('#divpayAppend').append(data1);
                                                }, error: function (error)
                                                {

                                                }
                                             });
                                }

                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
    function loadReciept(duesId)
    {
        
        if (duesId != null && duesId!="")
        {

            $.ajax({
                url: '@Url.Action("FetchDueDetailsForReceipt", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sDuesId: duesId },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        if (data.ErrorCode == "204") {
                            swal({ title: "Info!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    }
                    else
                    {

                            if (data.oResult != null)
                                {
                                     $.ajax({
                                         url:'@Url.Action("BindReciept", "Library")',
                                         method: 'POST',
                                         data: { sData: data.oResult},
                                                success: function (data1)
                                                {

                                                    $('#divRecieptAppend').empty();
                                                    $('#divRecieptAppend').append(data1);
                                                }, error: function (error)
                                                {

                                                }
                                             });
                                }

                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
</script>


