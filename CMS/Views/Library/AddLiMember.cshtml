@*On Submit*@ 
<script>
    var formData = new FormData();

    $('#btnSubmit').click(function () 
    {
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }
        var UserId=$('#UserId').val();
        var StudentorStaffId=$('#txtAuthenticateNo').val();
        var UserType = $('#UserType').val();
        var Boid = $('#txtBoid').val();
        var FirstName = $('#txtFirstName').val();
        var LastName = $('#txtLastName').val();
        var Email = $('#txtEmailid').val();
        var Mobile = $('#txtMobileNo').val();
        var DateOfBirth = $('#txtDateOfBirth').val();
        var Degree = $('#Degree').val();
        var Address1 = $('#txtAddress1').val();
        var Address2=$('#txtAddress2').val();
        var BloodGroupId = $('#BloodGroup').val();
        var RegisterDate = $('#txtRegisterDate').val();
        var City=$('#txtCity').val();
        var State=$('#txtState').val();
        var Pincode=$('#txtPincode').val();
        var Rfid = $('#txtRfid').val();
        var BarCode = $('#txtBarcode').val();
            
        var elm=$('#files').find("img");
        if($('#fAttachment').val() || elm.length)
        {
            //clearing formdata sJsonData
            if(formData.has('sJsonData'))
            {
                formData.delete("sJsonData");
            }
            if(formData.has('PHOTO'))
            {
                formData.delete('PHOTO');
            }
            if(formData.has('USER_ID'))
            {
                formData.delete('USER_ID');
            }

            var JsonData = '{"USER_ID":"'+UserId+'",\
                                 "USERNAME":"' + Boid + '",\
                                 "PASSWORD":"' + Boid + '",\
                                 "USER_TYPE":"' + UserType + '",\
                                 "BOID":"' + Boid + '",\
                                 "FIRST_NAME":"' + FirstName + '",\
                                 "LAST_NAME":"' + LastName + '",\
                                 "EMAIL":"' + Email + '",\
                                 "MOBILE":"' + Mobile + '",\
                                 "DATE_OF_BIRTH":"' + DateOfBirth + '",\
                                 "DEGREE":"' + Degree + '",\
                                 "ADDRESS1":"' + Address1 + '",\
                                 "ADDRESS2":"' + Address2 + '",\
                                 "BLOOD_GROUP_ID":"' + BloodGroupId + '",\
                                 "REGISTERED_DATE":"'+RegisterDate+'",\
                                 "RFID":"' + Rfid + '",\
                                 "STATE":"' + State + '",\
                                 "PINCODE":"' + Pincode + '",\
                                 "CITY":"' + City + '",\
                                 "BAR_CODE":"'+ BarCode +'"}';
            formData.append("sJsonData", JsonData);

            //
            formData.append("PHOTO",Photo);
            formData.append("USER_ID","");

            $.ajax({
                url: "/Library/SaveLiMember",
                type: "post",
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) 
                {
                    if(data.ErrorCode =="404")
                    {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                    }
                    if(data.ErrorCode=="200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    }
                    if(data.ErrorCode=="304")
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }
                    if(data.ErrorCode=="208")
                    {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                    }
                    if(data.ErrorCode=="417")
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }
                    if(data.ErrorCode=="503")
                    {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                    }
                },
                error: function (ex) 
                {
                    swal({ title: "error !", text: "Internal Server Error !", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            });
        }
        else
        {
            swal({ title: "error !", text: "Please Select Photo !", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
        }
    });

    
    $('#btnCancel').click(function()
    {
        loadContent('/Library/LiUserList');
    });
</script>

@*File Handling*@
<script>
    function readFiles() 
    {
        var file = document.getElementById('fAttachment').files[0];
        // Read first file
        setup_reader(file);
    }
    function setup_reader(file) 
    {
        //var file = files;

        var name = file.name;
        var reader = new FileReader();
        reader.onloadend = function (e) 
        {
            readerLoaded(e, file, name);
        };
        reader.readAsBinaryString(file);
        // After reading, read the next file.
    }


    function readerLoaded(e, file, name) 
    {


        var _size = file.size;

        var extension = GetFileExtension(file);
        var size = GetFileSize(file);

        //var iProgress = GetProgressRate(_size);

        if (size != null && size != '') 
        {
            var actualFileDom;
            if (extension != null && extension != '') 
            {
                if (extension == 'jpg' || extension == 'png') 
                {
                    actualFileDom = "<img src=" + window.URL.createObjectURL(file) + " width=77 height=80></img>";
                }
                else 
                {
                    actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                }

                formData.append(name, file);
                Dom.html('');
                Dom.append(actualFileDom);
            }
        }
    }

    function GetFileExtension(file) 
    {
        // Get uploaded file extension
        var extension = file.name.split('.').pop().toLowerCase();
        var validFileExtensions = ['jpg', 'png'];
        if ($.inArray(extension, validFileExtensions) == -1) 
        {
            alert("Sorry!! Upload only 'jpf','png'")
            //$(this).replaceWith($(this).val('').clone(true));
            return extension = null;
        }
        else 
        {
            return extension;
        }
    }

    function GetFileSize(file) 
    {
        var _size = file.size;
        var fileSize = _size;
        var fSExt = new Array('Bytes', 'KB', 'MB', 'GB'),
        i = 0; while (_size > 900) { _size /= 1024; i++; }
        var exactSize = (Math.round(_size * 100) / 100) + ' ' + fSExt[i];

        if (fileSize > 500000) 
        {
            myAlert("Sorry!! Max allowed file size is 500 kb");
            // Clear fileuload control selected file
            // $(this).replaceWith($(this).val('').clone(true));
            return exactSize = null;
        }
        else 
        {
            return exactSize;
        }
    }
</script>

