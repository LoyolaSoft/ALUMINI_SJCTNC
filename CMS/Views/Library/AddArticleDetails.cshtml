
@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "AddArticleDetails";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a href="javascript:;" onclick="loadContent('/Library/ListBookDetails')" @*href="@Url.Action("ListCourseInfo","Academics")"*@>List Course</a></li>
            <li class="active">Add Article Details</li>
        </ol>
        <h2 class="page-header">Add Article Details</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Add Article Details</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal" id="Validate" data-parsley-validate="true">

                    <div class="form-group col-md-12">
                     
                        <div class="col-md-6">
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.BOOK_NO, "BookNo", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjBookDetails.BOOK_NO, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Book No", @data_parsley_required = "true" } })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.BOOK_NO, "", new { @class = "text-danger" })
                                </div>
                            </div>

                          
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.sAuthor, "Authors", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.sAuthor, (Model.sAuthor != null) ? Model.sAuthor : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(model => model.sAuthor, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.sRack, "Rack", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.sRack, (Model.sRack != null) ? Model.sRack : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.sRack, "", new { @class = "text-danger" })
                                </div>
                            </div>
                              
                                <div class="form-group col-md-12">
                                    @Html.LabelFor(model => model.ArticleType, "Article Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ArticleType, (Model.ArticleType != null) ? Model.ArticleType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @data_parsley_required = "true" })
                                        @Html.ValidationMessageFor(model => model.ArticleType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                   
                                    <div class="form-group col-md-12">
                                        @Html.LabelFor(model => model.ObjBookDetails.BOOK_TITLE, "Book Title", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.EditorFor(model => model.ObjBookDetails.BOOK_TITLE, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Book Title", @data_parsley_required = "true" } })
                                            @Html.ValidationMessageFor(model => model.ObjBookDetails.BOOK_TITLE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.sSeriesDDL, "Series", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.sSeriesDDL, (Model.sSeriesDDL != null) ? Model.sSeriesDDL : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(model => model.sSeriesDDL, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.SERIES_CODE, "SeriCode", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjBookDetails.SERIES_CODE, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter SeriCode", @data_parsley_required = "true" } })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.SERIES_CODE, "", new { @class = "text-danger" })
                                </div>
                            </div>

                                    
                      </div>
                        <div class="col-md-6">


                           
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.SERIES, "Series", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjBookDetails.SERIES, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Series", @data_parsley_required = "true" } })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.SERIES, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.BOOK_PUPLISH_YEAR, "Book Publish Year", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjBookDetails.BOOK_PUPLISH_YEAR, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Book Publish Year", @data_parsley_required = "true", @data_parsley_type = "number" } })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.BOOK_PUPLISH_YEAR, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.PAGES, "Pages", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjBookDetails.PAGES, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Pages", @data_parsley_required = "true", @data_parsley_type = "number" } })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.PAGES, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.ABSTRACT, "Abstract", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">

                                    @Html.TextAreaFor(model => model.ObjBookDetails.ABSTRACT, new { @class = "form-control", @placeholder = "Enter Abstract", @data_parsley_required = "true", @data_limit_rows = "true", @cols = "60", @rows = "5" })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.ABSTRACT, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                @Html.LabelFor(model => model.ObjBookDetails.RFID, "Rfid", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjBookDetails.RFID, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter RFID", @data_parsley_required = "true" } })
                                    @Html.ValidationMessageFor(model => model.ObjBookDetails.RFID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    
                    </div>
                        

               
                    <br /><br />
                    <div class="form-group pull-right">
                        <div class="col-md-12 pull-right">
                            <a id="btnSubmit" value="Submit" class="btn btn-primary">Submit</a>
                            <a id="btnCancel" value="Cancel" class="btn btn-danger" href="javascript:;" onclick="loadContent('/Library/ListArticlesDetails')">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
      
       
}

<!-- Hidden Filed -->
@Html.HiddenFor(model => model.ObjBookDetails.BOOK_ID)
@Html.HiddenFor(model=>model.ObjBookDetails.SERIES)
@Html.HiddenFor(model => model.ObjBookDetails.RACK_ID)
@Html.HiddenFor(model => model.ObjBookDetails.SERIES_CODE)
@Html.HiddenFor(model => model.ObjBookDetails.ARTICLE_TYPE)
@Html.HiddenFor(model => model.ObjBookDetails.AUTHOR_ID)
<!-- Hidden Filed -->
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>

        function ContentLoad()
        {
            if ($('#ObjBookDetails_SERIES').val() && $('#ObjBookDetails_SERIES_CODE').val())
            {
                var series = $('#ObjBookDetails_SERIES').val();
                var seriescode = $('#ObjBookDetails_SERIES_CODE').val();
                var text = seriescode.concat(" - ", series);
                $('#sSeriesDDL option:contains("' + text + '")').attr('selected', 'selected');
            }
            if ($('#ObjBookDetails_ARTICLE_TYPE').val()) {
                $('#ArticleType').val($('#ObjBookDetails_ARTICLE_TYPE').val());
              
            }
            if ($('#ObjBookDetails_RFID').val()) {
                $('#ObjBookDetails_RFID').prop('readonly', true);

            }
            var author=$('#ObjBookDetails_AUTHOR_ID').val().split(',');
            for (var i = 0; i <= author.length; i++)
            {
                $('#sAuthor option[value="' + author[i] + '"]').attr('selected','selected');
            }
           
            $('#sRack').val($('#ObjBookDetails_RACK_ID').val());
            $('.selectpicker').selectpicker('refresh');
        }
        $('.selectpicker').selectpicker({
            size: 4
        });

        $('.selectpicker').selectpicker('refresh');



        // Series Code ,...
        $('#sSeriesDDL').on('change', function ()
        {
            var sSeries = $('#sSeriesDDL Option:selected').text();
            var sSeriesCode = sSeries.split('-');
            $('#ObjBookDetails_SERIES_CODE').val(sSeriesCode[0].trim());
            $('#ObjBookDetails_SERIES').val(sSeriesCode[1].trim());
        });

     
</script>


<script>
    $("#btnSubmit").on("click", function ()
    {
        var isValid = true;
        if ($('#Validate').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            myAlert('Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        var JsonData = null;
        if (JsonData == null)
        {
            JsonData = '{"BOOK_ID":"' + $('#ObjBookDetails_BOOK_ID').val() + '",\
                         "RACK_ID":"' + $('#sRack').val() + '",\
                         "BOOK_NO":"' + $('#ObjBookDetails_BOOK_NO').val() + '",\
                         "AUTHOR_ID":"' + $('#sAuthor').val() + '",\
                         "BOOK_TITLE":"' + $('#ObjBookDetails_BOOK_TITLE').val() + '",\
                         "SERIES_CODE":"' + $('#ObjBookDetails_SERIES_CODE').val() + '",\
                         "BOOK_PUPLISH_YEAR":"' + $('#ObjBookDetails_BOOK_PUPLISH_YEAR').val() + '",\
                         "ARTICLE_TYPE":"' + $('#ArticleType').val() + '",\
                          "PAGES":"' + $('#ObjBookDetails_PAGES').val() + '",\
                          "ABSTRACT":"' + $('#ObjBookDetails_ABSTRACT').val() + '",\
                         "RFID":"' + $('#ObjBookDetails_RFID').val() + '",\
                         "SERIES":"' + $('#ObjBookDetails_SERIES').val() + '"}';
        }
        $.ajax({
            url:'@Url.Action("SaveArticleDetails", "Library")',
            method:'POST',
            type:'json',
            data: { sJsonArticleDetails: JsonData },
            success: function (data)
            {
                if (data.ErrorCode == '200')
                {
                    $('#ObjBookDetails_BOOK_ID').val(data.sResult);
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                    loadContent("/Library/AddArticleDetails?sBookId=" + $('#ObjBookDetails_BOOK_ID').val() + "");
                }
                else {
                    swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
</script>

