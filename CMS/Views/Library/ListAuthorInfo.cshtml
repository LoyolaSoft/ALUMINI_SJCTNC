@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "ListAuthorInfo";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}



<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Author Info </li>
    </ol>
    <h1 class="page-header">List Author Info </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Author Info </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#Author-dialog" data-toggle="modal"><i class="fa fa-plus" title="Add" id="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblAuthorInfo">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Publisher</th>
                            <th>Place</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liAuthorInfo != null && Model.liAuthorInfo.Count > 0)
                        {
                            foreach (var item in Model.liAuthorInfo)
                            {
                                <tr>
                                    <td>@{count++;} @count</td>
                                    
                                    <td>@item.FIRST_NAME</td>
                                    <td>@item.LAST_NAME</td>
                                    <td>@item.PUBLISHER</td>
                                    <td>@item.PLACE</td>
                                    <td>
                                        <a href="#Author-dialog" onclick="FetchAuthorById(@item.AUTHOR_ID);" class="text-primary" data-toggle="modal" title="Click To Edit"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" onclick="GetConfrim(@item.AUTHOR_ID);" title="Click To Delete"><i class="fa fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="Author-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Author</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                   <div class="form-group">
                                       <label class="control-label col-md-3">First Name</label>
                                       <div class="col-md-9">
                                           <input type="text" id="txtFirstName" placeholder = "Enter First Name"  class="form-control input-sm" data-parsley-required="true"/>
                                       </div>
                                   </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3">Last Name</label>
                                        <div class="col-md-9">
                                            <input type="text" id="txtLastName" placeholder="Enter Last Name" class="form-control input-sm" data-parsley-required="true" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3">Publisher</label>
                                        <div class="col-md-9">
                                            <input type="text" id="txtPublisher" placeholder="Enter Publisher" class="form-control input-sm" data-parsley-required="true" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3">Place</label>
                                        <div class="col-md-9">
                                            <input type="text" id="txtPlace" placeholder="Enter Place" class="form-control input-sm" data-parsley-required="true" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="AuthorId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        $('#tblAuthorInfo').DataTable();

        // On Edit Click ,..
        function FetchAuthorById(Id)
        {
            $('#pBody').parsley().destroy();
            if (Id != null && Id!='')
            {
                $.ajax({
                    url: "/Library/FetchAuthorInfoById",
                    type: "post",
                    data: { AuthorId: Id },
                    success: function (data)
                    {
                        if (data.Message != null && data.Message!='')
                        {
                            swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        } else
                        {
                            $('#AuthorId').val(data[0].AUTHOR_ID);
                            $('#txtFirstName').val(data[0].FIRST_NAME);
                            $('#txtLastName').val(data[0].LAST_NAME);
                            $('#txtPublisher').val(data[0].PUBLISHER);
                            $('#txtPlace').val(data[0].PLACE);
                        }
                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            }
        }

        // On Submit ,...
        $('#btnSubmit').on('click', function ()
        {
            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var JsonData = '{"AUTHOR_ID":"' + $('#AuthorId').val() + '","FIRST_NAME":"' + $('#txtFirstName').val() + '","LAST_NAME":"' + $('#txtLastName').val() + '","PUBLISHER":"' + $('#txtPublisher').val() + '","PLACE":"' + $('#txtPlace').val() + '"}';
            $.ajax({
                url: '/Library/SaveAuthorInfo',
                method: 'POST',
                datatype: 'json',
                data: { sJsonAuthorInfo: JsonData },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadContent("/Library/ListAuthorInfo");
                    } else
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        });
        // On Delete ,...
        function GetConfrim(Id)
        {
            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
                function () {
                    $.ajax({
                        url: '@Url.Action("DeleteAuthorInfo", "Library")',
                        method: 'POST',
                        datatype: 'json',
                        data: { sAuthorId: Id },
                        success: function (data)
                        {
                            if (data.ErrorCode == '200')
                            {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                                loadContent("/Library/ListAuthorInfo");
                            }
                            else
                            {
                                swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                            }
                        }, error: function (error)
                        {
                            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    });

                });
        }

    // On Modal Close ,...
    $(function () {
        
        $('#Author-dialog').on('hidden.bs.modal', function (e) 
        {
            $('#AuthorId').val('');
            $('#txtFirstName').val('');
            $('#txtLastName').val('');
            $('#txtPublisher').val('');
            $('#txtPlace').val('');
        });
    });

    $('#Add').click(function () {

        $('#pBody').parsley().destroy();
          
        
        $('.selectpicker').selectpicker('refresh');

    });

</script>

