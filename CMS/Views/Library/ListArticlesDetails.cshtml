
@model CMS.ViewModel.ViewModel.LibraryViewModel

@{
    ViewBag.Title = "ListArticlesDetails";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}




<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Article Details </li>
    </ol>
    <h1 class="page-header">List Article Details </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Article Details </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/Library/AddArticleDetails')"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblArticleDetails">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tittle</th>
                            <th>Rack </th>
                            <th>Author</th>
                            <th>Series Code</th>
                            <th>Series</th>
                            <th>Book Published Year</th>
                            <th>Article Type</th>
                            <th>Pages</th>
                            <th>Abstact</th>
                            <th>Rfid</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liBookCirculation != null && Model.liBookCirculation.Count > 0)
                        {
                            foreach (var item in Model.liBookCirculation)
                            {
                                <tr>
                                    <td>@{count++;} @count</td>
                                    <td>@item.BOOK_TITLE</td>
                                    <td>@item.RACK_NO</td>
                                    <td>@item.AUTHOR</td>
                                    <td>@item.SERIES_CODE</td>
                                    <td>@item.SERIES</td>
                                    <td>@item.BOOK_PUPLISH_YEAR</td>
                                    <td>@item.ARTICLE_TYPE</td>
                                    <td>@item.PAGES</td>
                                    <td>@item.ABSTRACT</td>
                                    <td>@item.RFID</td>
                                    <td>
                                        <a href="javascript:;" class="text-primary" onclick="loadContent('/Library/AddArticleDetails?sBookId=@item.BOOK_ID');" title="Click To Edit"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" onclick="GetConfrim(@item.BOOK_ID);" title="Click To Delete"><i class="fa fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        $('#tblArticleDetails').DataTable();
        function GetConfrim(Id)
        {
            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
                function () {
                    $.ajax({
                        url: '@Url.Action("DeleteArticleDetails", "Library")',
                        method: 'POST',
                        datatype: 'json',
                        data: { sBookId: Id },
                        success: function (data)
                        {
                            if (data.ErrorCode == '200')
                            {
                                swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                            }
                            else
                            {
                             
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                                loadContent("/Library/ListArticleDetails?sBookId="+data.sResult+"");
                            }
                        }, error: function (error)
                        {
                            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    });

                });
        }
</script>

