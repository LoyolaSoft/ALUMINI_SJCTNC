
@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "ListStuIssuedBookforReading";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />


<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Extensive Reading Assessment</li>
    </ol>
    <h1 class="page-header">List  Extensive Reading Assessment</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Extensive Reading Assessment</h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.liLCasslist, (Model.liLCasslist != null) ? Model.liLCasslist : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liLCasslist, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Component", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Component, (Model.Component != null) ? Model.Component : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Component, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <a class="btn btn-primary" id="btnPushCIAMARKS"><i class="fa fa-pulse"></i> PUSH TO CIA MARK</a>
                    </div>

                </div>
                <div class="col-md-12" id="dvStuCourseRemark">

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script>

    function ContentLoad() {
        // Document Ready Function .
    }
        $('.selectpicker').selectpicker({
            size: 5
        });
    $('.selectpicker').selectpicker('refresh');

        $('#liLCasslist').on("change", function () {
            var sAcademicYear = $('#liLCasslist').val();
            if (sAcademicYear == '' || sAcademicYear == '0') {
                alert('Please Choose Class...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("GetCourseListByClassIdAndStaffIdByERA", "Library")",
                method: "POST",
                datatype: "json",
                data: { sClassId: $('#liLCasslist').val() },
                success: function (data) {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value="">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            })
        });
    $('#CourseList').on("change", function () {
        var sCourseID = $('#CourseList').val();
        if (sCourseID == '' || sCourseID == '0') {
        alert('Please Choose Course...!!!');
        return false;
    }
    $.ajax({
        url: "@Url.Action("FetchSupCIAComponentbyReadingCourseId", "Library")",
        method: "POST",
        datatype: "json",
        data: { sCourseId: sCourseID },
        success: function (data) {
            $("#Component").empty();
            $("#Component").append('<option value="">-- select --</option>' + data);
            $('.selectpicker').selectpicker('refresh');
        }, error: function (error) {
            alert('Internal Server Error !');
        }
    })
    });
    function bindStuReviewStatus() {
           var sComponent = $('#Component').val();
   if (sComponent == '' || sComponent == '0') {
    alert('Please Choose Course...!!!');
    return false;
}
$.ajax({
    url: "@Url.Action("FetchStudentIssuedBook", "Library")",
    method: "POST",
    datatype: "json",
    data: { sCourseId: $('#CourseList').val(), sClassId: $('#liLCasslist').val(), sComponent: $('#Component').val() },
    success: function (data) {
        $("#dvStuCourseRemark").empty();
        $("#dvStuCourseRemark").append(data);
        $("#tblStuCourseRemark").DataTable({});
    }, error: function (error) {
        alert('Internal Server Error !');
    }
})
    }
    $('#Component').on("change", function () {
        bindStuReviewStatus();
    });
    $('#btnPushCIAMARKS').on("click", function () {
        saveReviewMarkComponentWise();
    });

    function saveReviewMarkComponentWise() {
        swal({
            title: "Are you sure",
            text: "Are you sure you want to push this mark to the Internal Assessment entry?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
            function () {
                let isValid = true;
                let allMarks = [];
                $('#tblStuCourseRemark tbody tr').each(function () {
                    const $toggle = $(this);

                    const StudentId = $toggle.data('student-id');
                    const ComponentID = $toggle.data('component-id');
                    const CourseID = $toggle.data('course-id');
                    const Max_mark = $toggle.data('max-mark');
                    const Book_count = $toggle.data('count');
                    const PerBookMark = $toggle.data('book-mark');

                    let secure_Group = parseFloat(Book_count) * parseFloat(PerBookMark);
                    if (secure_Group > Max_mark) {
                        secure_Group = Max_mark
                    }
                    else {

                    }

                    allMarks.push({

                        STUDENT_ID: StudentId,
                        COMPONENT_ID: ComponentID,
                        COURSE_ID: CourseID,
                        MAX_MARK: Max_mark,
                        SEC_MARK: secure_Group
                    });
                });

                if (!isValid) return;

                const jsonList = allMarks.map(x => ({
                    STUDENT_ID: x.STUDENT_ID,
                    COMPONENT_ID: x.COMPONENT_ID,
                    COURSE_ID: x.COURSE_ID,
                    SEC_MARK: x.SEC_MARK,
                    MAX_MARK: x.MAX_MARK
                }));

                const JsonData = JSON.stringify(jsonList);
                var sCourseID = $('#CourseList').val();
                var comID = $('#Component').val();
                $.ajax({
                    url: '/Library/SaveStuCIAGroupComponentMark',
                    method: 'post',
                    data: {
                        sJsonData: JsonData,
                        sComponentID: comID,
                        sCourseID: sCourseID
                    },
                    success: function (data) {
                        if (data.ErrorCode === "200") {

                            swal({
                                title: "Success!",
                                text: data.Message,
                                showConfirmButton: false,
                                timer: 3000,
                                type: 'success',
                                animation: true
                            });

                            bindStuReviewStatus();
                        } else {
                            swal({
                                title: "Error",
                                text: data.Message,
                                showConfirmButton: false,
                                timer: 3000,
                                type: 'error',
                                animation: true
                            });
                        }
                    },
                    error: function () {
                        swal({
                            title: "Internal Server Error!",
                            text: "Sorry for the inconvenience",
                            showConfirmButton: false,
                            timer: 3000,
                            type: 'error',
                            animation: true
                        });
                    }
                });
            });
    }
</script>


