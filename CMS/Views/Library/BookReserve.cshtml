
@model CMS.ViewModel.ViewModel.LibraryViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BookReserve";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">All Reserved Transaction</li>
    </ol>
    <h1 class="page-header">All Reserved Transaction</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> Reserved Transaction</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/Library/Reserve')"><i class="fa fa-plus" title="Add"> Reserve</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblReservedTransaction">
                    <thead>
                        <tr>
                            <th>#</th>

                            <th>
                                <div class="checkbox checkbox-css">
                                    <input type="checkbox" id="AllchkID" onchange="SelectOrUnselect()" />
                                    <label for="AllchkID"> &nbsp; &nbsp;</label>
                                </div>
                            </th>
                            <th>Name</th>
                            <th>User Type</th>
                            <th>Role</th>
                            <th>Reserved Date</th>
                            <th>Access No</th>
                            <th>Book Title</th>
                            <th>Author</th>
                            <th>Book No</th>
                            <th>Reserve Status</th>
                            <th class="hidden" id="thCancelReason">Reason</th>
                            <th class="hidden" id="thStatus">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liBookReserve != null && Model.liBookReserve.Count > 0)
                        {
                            foreach (var item in Model.liBookReserve)
                            {
                        <tr id="row_@item.RESERVE_ID" cms-reserve-id="@item.RESERVE_ID">
                            <td>@{count++;} @count</td>

                            <td>
                                <div class="checkbox checkbox-css">

                                    <input type="checkbox" id="cbx_@item.RESERVE_ID" />
                                    <label for="cbx_@item.RESERVE_ID"></label>

                                </div>
                            </td>


                            <td>@item.FIRST_NAME</td>

                            <td>@item.USER_TYPE_NAME</td>
                            <td>@item.ROLE</td>
                            <td>@item.ENTRY_DATE</td>
                            <td>@item.ACCESS_NO</td>
                            <td>@item.BOOK_TITLE</td>
                            <td>@item.AUTHOR</td>
                            <td>@item.BOOK_NO</td>

                            <td>@Html.DropDownListFor(m => m.sStatusDDL, (Model.sStatusDDL != null) ? Model.sStatusDDL : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true", @cms_row_id = "row_" + @item.RESERVE_ID, @id = "status" + @item.RESERVE_ID, @onchange = "onStatusValidate('status" + @item.RESERVE_ID + "')", @data_parsley_validate = "true" })</td>
                            <td class="cancelreason hidden">
                           
                                
                                <input type="text" id="txtCancelReason_@item.RESERVE_ID" class="form-control Text" placeholder="Enter Reason" value=""/>
                            </td>
                            <td class="ms-lastCell hidden"></td>
                        </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="form-group">
                <a class="btn btn-primary pull-right" href="javascript:;" id="btnSubmit"> Submit </a>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    $('#tblReservedTransaction').DataTable();

    $('#tblReservedTransaction tbody tr').each(function ()
    {
        $(this).find('select[name="sStatusDDL"] option[value=@Common.LI_BOOK_STATUS.RESERVE_APPROVED]').attr('selected', 'selected');

    });

    $('.selectpicker').selectpicker({
                size: 6
        });
        $('.selectpicker').selectpicker('Refresh');
</script>

<script>

    //status validation
    function onStatusValidate(id) {


        var status = $('#' + id + "").val();
        var text = $("#" + id + " " + "option:selected").text();
        var rowId = $('#' + id + "").attr('cms-row-id');
        if ((status==@Common.LI_BOOK_STATUS.RESERVE_CANCELLED)) {
            $('#thCancelReason').removeClass("hidden");
            $('#' + rowId + ' > .cancelreason').removeClass("hidden");

        }
        else
        {
            $('#thCancelReason').addClass("hidden");
            $('#' + rowId + ' > .cancelreason').addClass("hidden");
        }

    }
    SelectOrUnselect = function () {
        if (AllchkID.checked == true) {
            $('#tblReservedTransaction tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", true);
                });
            });
        }
        else {
            $('#tblReservedTransaction tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", false);
                });
            });
        }
    }
</script>
<script>

    $('#btnSubmit').on('click', function () {
        var nCount = 0;
        var sStatus = 0;

        var JsonData = "";

        var isValid = true;

        JsonData = '{"liBookReserve":[';
        $('#tblReservedTransaction tbody tr').each(function () {
            if ($(this).find('input[type="checkbox"]').is(':checked')) {
                nCount++;
                if ($(this).find('select[name="sStatusDDL"]').parsley().validate() !== true) isValid = false;
                if (!isValid) {
                    sStatus++;
                    //gritter-info,danger,success,warning,default
                    //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                    return false;
                }
                else
                {
                    if ($(this).find('select[name="sStatusDDL"]').val() !=@Common.LI_BOOK_STATUS.RESERVE_CANCELLED)
                    {
                        JsonData += '{"RESERVE_ID":"' + $(this).attr('cms-reserve-id') + '","CANCEL_REASON":"","IS_APPROVED":"1","IS_CANCELLED":"0"},';
                        sStatus = 0;
                    }
                    else
                    {
                        if ($(this).find('.Text').val())
                        {
                            JsonData += '{"RESERVE_ID":"' + $(this).attr('cms-reserve-id') + '","CANCEL_REASON":"' + $(this).find('.Text').val() + '","IS_APPROVED":"0","IS_CANCELLED":"1"},';
                            sStatus = 0;
                        }
                        else
                        {
                           
                            sStatus++;
                            swal({ title: "Info !", text: "Please enter the reason to continue!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            return false;
                        }
                    }
                }
            }
        });

        if (nCount != 0 && sStatus == 0) {
            JsonData = JsonData.slice(0, -1);
            JsonData = JsonData + "]}";
            $.ajax({
                url: '@Url.Action("SaveBookReservationTransaction", "Library")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonTransactionDetails: JsonData },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        if (data.ErrorCode == "204") {
                            swal({ title: "Info!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "406") {
                            swal({ title: "Failed!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                            loadContent('/Library/BookReserve');
                        }
                    }
                    else {

                        //if (data.liGridClass != null && data.liGridClass.length > 0) {
                        //    $('#thStatus').removeClass("hidden");
                        //    //$('#bAppend > .ms-lastCell').removeClass("hidden");

                        //    for (var i = 0; i < data.liGridClass.length; i++) {
                        //        $('#tblReservedTransaction tbody').find('tr[cms-reserve-id=' + data.liGridClass[i].RESERVE_ID + ']').find('td.ms-lastCell').removeClass('hidden');
                        //        $('#tblReservedTransaction tbody').find('tr[cms-reserve-id=' + data.liGridClass[i].RESERVE_ID + ']').find('td.ms-lastCell').text(data.liGridClass[i].STATUS);
                        //    }
                        //}
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error !", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
        else if (sStatus != 0) {
          
        }
        else {
            swal({ title: "Alert !", text: "Please Select Any One To Continue !", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    

    });
</script>