

@model CMS.ViewModel.ViewModel.LibraryViewModel


<div class="form-group table-responsive">
    @{ int count = 0;}
    <table class="table table-hover table-bordered" id="tblMalpracticeList">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Coures Code</th>
                <th>Course Title</th>
                <th>Component</th>
                <th>Mark per book</th>
                <th>Is Reading </th>
                <th>Is Writing</th>
                <th>Active</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.EraSetting != null)
            {
                foreach (var item in Model.EraSetting)
                {
                    <tr id="@item.ERA_SETTING_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.COURSE_TITLE</td>
                        <td>@item.COMPONENT</td>
                        <td>@item.PER_BOOK_MARK</td>
                        <td>
                            @if (item.IS_READING == "1")
                            {
                                <i class="label label-success">Yes</i>
                            }
                            else
                            {
                                <i class="label label-danger">No</i>
                            }


                        </td>
                        <td>
                            @if (item.IS_WRITING == "1")
                            {
                                <i class="label label-success">Yes</i>
                            }
                            else
                            {
                                <i class="label label-danger">No</i>
                            }
                        </td>
                        <td>
                            @if (item.IS_ACTIVE == "1")
                            {
                                <a href="javascrip:;" onclick="SetDeActive(@item.ERA_SETTING_ID)" class="text-success"><i class="fa fa-unlock text-green"></i></a>
                            }
                            else
                            {
                                <a href="javascrip:;" onclick="SetActive(@item.ERA_SETTING_ID)" class="text-danger"><i class="fa fa-lock text-danger"></i></a>
                            }
                        </td>
                        <td>
                            <a href="#malpratice-dialog" data-toggle="modal" onclick="FetchMalpracticeById(@item.ERA_SETTING_ID);"><i class="fa fa-edit" title="Click To Update"></i></a>
                            <a href="#" onclick="GetConfirm(@item.ERA_SETTING_ID);"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>

