    // save book details
    function SaveBookInfo()
    {
        if (sStatus > 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData += ']}';
        }

        $.ajax({
            url: '@Url.Action("SaveBookDetails", "Library")',
            method: 'POST',
            type: 'json',
            data: { sJsonBookDetails: JsonData },
            success: function (data)
            {
                if (data.ErrorCode == '200')
                {

                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                    //loadContent("/Library/AddBookDetails?sBookId=" + $('#ObjBookDetails_BOOK_ID').val() + "");
                    loadContent("/Library/AddBookDetails");
                }
                if (data.ErrorCode == '208') {

                    swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                  
                }
                if (data.ErrorCode == '406') {

                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                  
                }
                //else
                //{
                //    swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                //}
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }



