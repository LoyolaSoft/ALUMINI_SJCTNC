<script>

    // for fetching book details by isbn search


    $('#ObjBookDetails_ISBN_NO').on('focusout',function (e) 
    {
        var dbcount = 0;
       

        //$('#ObjBookDetails_PLACE_OF_PUBLISHER').val('');
        //$('#ObjBookDetails_NAME_OF_PUBLISHER').val('');
        //$('#ObjBookDetails_BOOK_PUBLISH_YEAR').val('');
        e.preventDefault();
        var isbn = $('#ObjBookDetails_ISBN_NO').val();
        var isbn_without_hyphens = isbn.replace(/-/g, "");
        var googleAPI = "https://www.googleapis.com/books/v1/volumes?q=" + isbn_without_hyphens;

        //first fetch from database


        $.ajax({
            url: '@Url.Action("FetchPublisherDetailsByIsbn", "Library")',
            method: 'POST',
            async: false,
            cache: false,
            datatype: 'json',
            data: { sIsbn: isbn_without_hyphens },
            success: function (data) {

                if (data.Message!="" && data.Message!=null) 
                {

                }
                else
                {

                    dbcount = parseInt(dbcount) + 1;

                    var dom = $('#liDetails');
                    var content = "";
                    $.each(data.oResult, function (id, item) 
                    {
                        var bookpublishplace = item.PLACE_OF_PUBLISHER != "" && item.PLACE_OF_PUBLISHER != null ? item.PLACE_OF_PUBLISHER : "";
                        var bookpublisher = item.NAME_OF_PUBLISHER != "" && item.NAME_OF_PUBLISHER!=null ? item.NAME_OF_PUBLISHER : "";
                        var bookpublishdate = item.BOOK_PUBLISH_YEAR != "" && item.BOOK_PUBLISH_YEAR!=null ? item.BOOK_PUBLISH_YEAR : "";

                        content += "<li><a href='javascrip:;' onclick=BindBookInfo('" + encodeURIComponent(bookpublisher) + "','" + encodeURIComponent(bookpublishplace) + "','" + bookpublishdate + "')>" + bookpublisher + " " + bookpublishplace + "  " + bookpublishdate + " </a></li>";

                    });
                    dom.html("");
                    dom.append(content);
                    dom.css("display", "block");
                    $('#btnModelisbn').trigger("click");
                }
            }, error: function (error) 
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

        //if not in database search in google

        if(dbcount=="0" )
        {
            
            $.getJSON(googleAPI, function (response) {
                if (typeof response.items === "undefined") {
                    alert("No books match that ISBN.")
                } else {
                    //alert(response.items[0].volumeInfo.title);
                    //alert(response.items[0].volumeInfo.authors[0]);
                    //alert(response.items[0].volumeInfo.publishedDate);
                    var dom = $('#liDetails');
                    var content = "";
                    $.each(response.items, function (id, item) {
                        
                        var title = item.volumeInfo.title != "" && item.volumeInfo.title != null ? item.volumeInfo.title : "";
                       
                       // var author = item.volumeInfo.authors[0] != "" && item.volumeInfo.authors[0]!=null ? item.volumeInfo.authors[0] : "";
                        var bookpublisher = item.volumeInfo.publisher != "" && item.volumeInfo.publisher!=null ? item.volumeInfo.publisher : "";
                        var bookpublishdate = item.volumeInfo.publishedDate != "" && item.volumeInfo.publishedDate!=null ? item.volumeInfo.publishedDate : "";


                        content += "<li><a href='javascrip:;' onclick=BindBookInfo('" + encodeURIComponent(bookpublisher) + "','','" + bookpublishdate + "')>" + bookpublisher + " " + bookpublishdate + " </a></li>";

                    });
                    dom.html("");
                    dom.append(content);
                    dom.css("display", "block");
                    $('#btnModelisbn').trigger("click");

                }
            });
        }
    
    });
    

    function BindBookInfo(bookpublisher,plaeofpublisher, bookpublishdate)
    {
        
        $('#ObjBookDetails_PLACE_OF_PUBLISHER').val('');
        $('#ObjBookDetails_NAME_OF_PUBLISHER').val('');
        $('#ObjBookDetails_BOOK_PUBLISH_YEAR').val('');
        if (plaeofpublisher != "" && plaeofpublisher!="undefined") {

            plaeofpublisher = plaeofpublisher.replace(/%20/g, " ");


            $('#ObjBookDetails_PLACE_OF_PUBLISHER').val(plaeofpublisher);

        }
        if (bookpublisher != "" && bookpublisher!="undefined") {

            bookpublisher = bookpublisher.replace(/%20/g, " ");


            $('#ObjBookDetails_NAME_OF_PUBLISHER').val(bookpublisher);
        }
        if (bookpublishdate != "" && bookpublishdate!="undefined") {


            $('#ObjBookDetails_BOOK_PUBLISH_YEAR').val(bookpublishdate);

        }
    }



    function replaceAll(str, term, replacement) {
        return str.replace(new RegExp(escapeRegExp(term), 'g'), replacement);
    }
    function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }


