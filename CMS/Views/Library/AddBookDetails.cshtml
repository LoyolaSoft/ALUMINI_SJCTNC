        {
            $('#ObjBookDetails_BARCODE').prop('readonly', true);
        }

        var sLibCode=@Html.Raw(Json.Encode(Model.ObjBookDetails.DOC_CATEGORY));
        if(sLibCode!=null && sLibCode!="")
        {
            $("#sLibCode  option[value="+ sLibCode +"]").prop('selected',true);
            $('#sLibCode').selectpicker('refresh');
            // $("#sLibCode").trigger("change");
        }

        var sClassNo=@Html.Raw(Json.Encode(Model.ObjBookDetails.CLASS_NO));
        if(sClassNo!=null && sClassNo!="")
