@model CMS.ViewModel.ViewModel.InventoryViewModel
@{
    ViewBag.Title = "InventoryStockTranscation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Stock Maintenance</a></li>

    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Stock Maintenance<small></small></h1>
    <!-- end page-header -->

    <div class="form-horizontal">
        <div class="panel panel-primary">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Stock Maintenance</h4>
            </div>
            <div class="panel-body">

                <div class="col-md-12">
                    <div class="form-group col-md-5">
                        @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.DEPARTMENT, (Model.DEPARTMENT != null) ? Model.DEPARTMENT : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_selected_text_format = "count", @data_action_box = "true" })
                            @Html.ValidationMessageFor(model => model.DEPARTMENT, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>
                <br /><br /><br />
                <div id="divstockdistribution">

                </div>
            </div>

        </div>
    </div>

</div>

<script>
    $('.selectpicker').selectpicker({});
    $('#tblstockrequest').DataTable({});
 
    $('#DEPARTMENT').on('change', function ()
    {
        $.ajax({
            url: "@Url.Action("FetchStockDistributionByDepartment", "Inventory")",
            type: "post",
            data: { sDepartmentId: $(this).val() },
            success: function (data) 
            {
                $('#divstockdistribution').empty();
                $('#divstockdistribution').append(data);
                
            },
            error: function (ex) {
                alert(ex.Message);
            }
        });
    });
    

    $('#btnSubmit').on('click', function () {

        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
        JsonData = '{"STOCK_DESTRIBUTION_ID":"' + $("#stockdisid").val() + '","DEP_ID":"' + $("#DEPARTMENT").val() + '","ITEM_ID":"' + $("#ITEMS").val() + '","VENDOR_ID":"' + $("#VENDOR").val() + '","QUANTITY":"' + $("#quantity").val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateStockDistribution", "Inventory")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Inventory/InventoryStockDestribution');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });




</script>
