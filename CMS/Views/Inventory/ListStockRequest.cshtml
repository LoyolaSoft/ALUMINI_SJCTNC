@model CMS.ViewModel.ViewModel.InventoryViewModel
@{
    ViewBag.Title = "ListStockRequest";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Stock Requested</li>
    </ol>
    <h1 class="page-header">List Stock Requested</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Stock Requested</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#stockrequestmodal" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblstockrequest">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Department</th>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Description</th>
                           
                            <th>Action</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.listockrequest != null && Model.listockrequest.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.listockrequest)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>


                                    <td>@item.DEPARTMENT_NAME</td>
                                    <td>@item.ITEM_NAME</td>
                                    <td>@item.QUANTITY</td>
                                    <td>@item.PURPOSE</td>
                                 

                                    <td>
                                        @if (item.STATUS != "0")
                                        {
                                        <a href="#stockrequestmodal" onclick="FetchStockRequest(@item.STOCK_REQUEST_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.STOCK_REQUEST_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                        }
                                        else
                                        {
                                            @item.STATUS_NAME
                                        }
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



<div class="modal" id="stockrequestmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Stock Request</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="stockrequestid" class="hidden">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Department</label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.DEPARTMENT, (Model.DEPARTMENT != null) ? Model.DEPARTMENT : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_selected_text_format = "count", @data_action_box = "true" })
                                            @Html.ValidationMessageFor(model => model.DEPARTMENT, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Item</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ITEMS, (Model.ITEMS != null) ? Model.ITEMS : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_selected_text_format = "count", @data_action_box = "true" })
                                            @Html.ValidationMessageFor(model => model.ITEMS, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Quantity</label>
                                        <div class="col-md-8">
                                            <input type="text" id="quantity" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    
                                   
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Description</label>
                                        <div class="col-md-8">
                                            <textarea  id="purpose" class="form-control" data-parsley-required="true" style="height:100px"/>
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });

    $('#tblstockrequest').DataTable({});
    function FetchStockRequest(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchStockRequest", "Inventory")",
                type: "post",
                data: { sStockrequestId: ID },
                success: function (data) {
                    if (data != null)
                    {
                        $('#stockrequestid').val(data.STOCK_REQUEST_ID);
                        $('#DEPARTMENT').val(data.DEP_ID);
                        $('#ITEMS').val(data.ITEM_ID);
                        $('#quantity').val(data.QUANTITY);
                        $('#purpose').val(data.PURPOSE);
                       
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    
    $('#btnSubmit').on('click', function ()
    {

        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            return false;
        }
        JsonData = '{"STOCK_REQUEST_ID":"' + $("#stockrequestid").val() + '","DEP_ID":"' + $("#DEPARTMENT").val() + '","ITEM_ID":"' + $("#ITEMS").val() + '","QUANTITY":"' + $("#quantity").val() + '","PURPOSE":"' + $("#purpose").val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateStockRequest", "Inventory")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data)
            {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Inventory/ListStockRequest');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });



    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function ()
{
    $.ajax({
        url: "@Url.Action("DeletePurchaseDetails", "Inventory")",
        type: "post",
        data: { sPurchaseId: ID },
        success: function (data)
        {
            if (data.Message != null && data.Message != "")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Inventory/ListStockRequest');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

    }

</script>

