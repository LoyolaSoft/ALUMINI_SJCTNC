@model CMS.ViewModel.ViewModel.InventoryViewModel
@{
    Layout = null;
    int count = 0;
}
<table class="table table-bordered" id="tblvendoritems">
    <thead>
        <tr>
            <th>#</th>
            <th>Vendor Name</th>
            <th>Available Stock</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.listockrequest != null && Model.listockrequest.Count > 0)
        {
            foreach (var item in Model.listockrequest)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td>@item.VENDOR_NAME</td>
                    <td>@item.QUANTITY</td>
                    <td><input type="number" class="form-control destriquantity" vendorid="@item.VENDOR_ID"  /></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No Stock Found...!</td>
            </tr>
        }
    </tbody>
</table>
