@model CMS.ViewModel.ViewModel.InventoryViewModel
@{
    ViewBag.Title = "ListStockRequestApproval";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Stock Requested</li>
    </ol>
    <h1 class="page-header">List Stock Requested</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Stock Requested</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#stockrequestmodal" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblstockrequestapproval">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Department</th>
                            <th>Item</th>
                            <th>Quantity</th>

                            <th>Status</th>
                            <th>Action</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.listockrequest != null && Model.listockrequest.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.listockrequest)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>


                                    <td>@item.DEPARTMENT_NAME</td>
                                    <td>@item.ITEM_NAME</td>
                                    <td>@item.QUANTITY</td>
                                  
                                    <td>
                                        @if (item.STATUS_NAME == "")
                                        {   
                                            <label style="color:blue">Pending</label>
                                        }
                                        else
                                        {
                                            @item.STATUS_NAME
                                        }
                                    </td>

                                    <td>
                                      
                                            <a href="#stockrequestmodal" onclick="FetchStockRequest(@item.STOCK_REQUEST_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-edit" title="EDIT"></i></a>                                    
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



<div class="modal" id="stockrequestmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Stock Request </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="stockrequestid" class="hidden">                                                              
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Description</label>
                                        <div class="col-md-8">
                                            <textarea id="purpose" class="form-control" data-parsley-required="true" style="height:100px" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Quantity</label>
                                        <div class="col-md-8">
                                            <input type="text" id="approvalquantity" class="form-control" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Item</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.STATUS, (Model.STATUS != null) ? Model.STATUS : Enumerable.Empty<SelectListItem>(),"--Select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_selected_text_format = "count", @data_action_box = "true" })
                                            @Html.ValidationMessageFor(model => model.STATUS, "", new { @class = "text-danger" })
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });

    $('#tblstockrequestapproval').DataTable({});
    function FetchStockRequest(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchStockRequestById", "Inventory")",
                type: "post",
                data: { sStockrequestId: ID },
                success: function (data) {
                    if (data != null)
                    {
                        $('#stockrequestid').val(data.STOCK_REQUEST_ID);
                        $('#purpose').val(data.PURPOSE);
                        $('#approvalquantity').val(data.APPROVED_QUANTITY);
                        $('#STATUS').val(data.STATUS);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }

    $('#btnSubmit').on('click', function ()
    {

        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            return false;
        }
        JsonData = '{"STOCK_REQUEST_ID":"' + $("#stockrequestid").val() + '","APPROVED_QUANTITY":"' + $("#approvalquantity").val() + '","STATUS":"' + $("#STATUS").val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateStockRequestApproval", "Inventory")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data)
            {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Inventory/ListStockRequestApproval');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });



</script>
