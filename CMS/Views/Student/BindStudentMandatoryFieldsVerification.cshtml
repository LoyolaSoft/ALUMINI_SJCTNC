@model CMS.ViewModel.ViewModel.StudentViewModel

<div class="col-md-12 table-responsive">
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>S.No</th>
                <th>RollNo</th>
                <th>FirstName</th>
                <th>Class</th>
                <th>Fields</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LiStudentReportForOffice != null && Model.LiStudentReportForOffice.Count > 0)
            {
                foreach (var item in Model.LiStudentReportForOffice)
                {
                    var IndStudents = Model.liStudent.Where(s => s.STUDENT_ID == item.STUDENT_ID).ToList();
                    <tr>
                        <td></td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.STUDENT_NAME</td>
                        <td>@item.CLASS</td>
                        <td>
                            @if (IndStudents != null && IndStudents.Count > 0)
                            {
                                foreach (var manitem in Model.LiStudentMandatoryFields)
                                {
                                    var S = IndStudents.Where(s => s.ToString() == manitem.MANDATORY_FIELDS).ToList();
                                    if (S!=null && S.Count>0)
                                    {
                                        @S.FirstOrDefault().REGISTER_NO
                                    };

                                }
                            }
                        </td>

                    </tr>

                }
            }
        </tbody>
    </table>
</div>