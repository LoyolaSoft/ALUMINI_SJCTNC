        <script>
            $(document).ready(function ()
            {
                $('.selectpicker').selectpicker('refresh');
                    handleDatepicker = function ()
                    {
                        "use strict";
                        $("#fdob,#fdofexpiry,#mDOB,#MDOFExpiry").datepicker
                       ({
                            todayHighlight: true,
                            autoclose: true,
                            endDate: new Date(),
                            format: "dd/mm/yyyy",
                            orientation: "right bottom"
                        })
                    }
                    handleDatepicker();
             

                // FetchParents
                GetParents=function () 
                {
                    $.ajax({
                        url:"@Url.Action("FetchParentsDetails", "Student")",
                        method:"POST",
                        datatype:"html",
                        success:function (data) 
                        {
                            if (data.Message != null && data.Message != '')
                            {
                                myAlert(data.Message, 'gritter-warning', '');
                            } else {
                                $("#txtfName").val(data[0].FATHER_NAME);
                                $("#fdob").val(data[0].F_DATE_OF_BIRTH);
                                $("#foccupation").val(data[0].FR_OCCUPATION);
                                $("#feducation").val(data[0].FATHER_EDUCATION);
                                $("#fnationality").val(data[0].FR_NATIONALITY);
                                $("#fbussinessno").val(data[0].FR_BUSINESS_PHONE);
                                $("#fmobile").val(data[0].FR_MOBILE);
                                $("#fpassport").val(data[0].FR_PASSPORT_number);
                                $("#fIncome").val(data[0].FR_INCOME);
                                $("#fdofexpiry").val(data[0].FR_DATE_OF_EXPIRY);
                                $("#femail").val(data[0].FR_EMAIL);
                                $("#mName").val(data[0].MOTHER_NAME);
                                $("#mDOB").val(data[0].M_DATE_OF_BIRTH);
                                $("#mOccupation").val(data[0].MO_OCCUPATION);
                                $("#MEducation").val(data[0].MOTHER_EDUCATION);
                                $("#mNationality").val(data[0].MO_NATIONALITY);
                                $("#mBussinessNo").val(data[0].MO_BUSINESS_PHONE);
                                $("#MMobile").val(data[0].MO_MOBILE);
                                $("#Mpassport").val(data[0].MO_PASSPORT_number);
                                $("#MIncome").val(data[0].MO_INCOME);
                                $("#MDOFExpiry").val(data[0].MO_DATE_OF_EXPIRY);
                                $("#MEmail").val(data[0].MO_EMAIL);
                            }
                           
                        },error:function(error)
                        {
                            myAlert('Internal Server Error ...!', 'gritter-danger', '');
                        }
                    });
                }
                GetParents();
            });

            
            // Parents Details
            $("#EditStuParents").on("click",function()
            {
                var isValid = true;
                if ($('#nav-tab2-3').parsley().validate() !== true) isValid = false;
                if (!isValid) {
                    //gritter-info,danger,success,warning,default
                    myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                    return false;
                }
                var FatherName = $("#txtfName").val();
                var FDOB = $("#fdob").val();
                var FOccupation = $("#foccupation").val();
                var FEducation = $("#feducation").val();
                var FNationality = $("#fnationality").val();
                var FBusinessPhone = $("#fbussinessno").val();
                var FMobile = $("#fmobile").val();
                var FPassportNo = $("#fpassport").val();
                var FIncome = $("#fIncome").val();
                //var FDOExpiry = $("#fdofexpiry").val();
                var FDOExpiry = "0000-00-00";
                var FEmail = $("#femail").val();
                var MName = $("#mName").val();
                var MDOB = $("#mDOB").val();
                var MOccupation = $("#mOccupation").val();
                var MEducation = $("#MEducation").val();
                var MNationality = $("#mNationality").val();
                var MBusinessPhone = $("#mBussinessNo").val();
                var MPhone = $("#MMobile").val();
                var MPassportNo = $("#Mpassport").val();
                var MIncome = $("#MIncome").val();
                //var MDOExpiry = $("#MDOFExpiry").val();
                var MDOExpiry = "0000-00-00";
                var MEmail = $("#MEmail").val();
                //var MPhoto = $("#MOTHER_PHOTO").val();
                //var FPhoto = $("#FATHER_PHOTO").val();
                var JsonData;
                if (JsonData==null)
                {
                    //JsonData = '{"FatherName":"' + FatherName + '","FDateOfBirth":"' + FDOB + '","MotherName":"' + MName + '","MDateOfBirth":"' + MDOB + '","fBusinessContact":"' + FBusinessPhone + '","FMobile":"' + FMobile + '","FPassport":"' + FPassportNo + '","mBusinessContact":"' + MBusinessPhone + '","MMobile":"' + MPhone + '","MPassport":"' + MPassportNo + '","FIncome":"' + FIncome + '","MIncome":"' + MIncome + '","FDateOfExpire":"' + FDOExpiry + '","MDateOfExpire":"' + MDOExpiry + '","FEmail":"' + FEmail + '","MEmail":"' + MEmail + '","FOccupation":"' + FOccupation + '","MOccupation":"' + MOccupation + '","FEducation":"' + FEducation + '","MEducation":"' + MEducation + '","FNationality":"' + FNationality + '","MNationality":"' + MNationality + '"}';
                    JsonData = '{"FATHER_NAME":"' + FatherName + '"\
                                ,"F_DATE_OF_BIRTH":"'+ FDOB + '"\
                                ,"MOTHER_NAME":"'+ MName + '"\
                                ,"M_DATE_OF_BIRTH":"'+ MDOB + '"\
                                ,"FR_BUSINESS_PHONE":"'+ FBusinessPhone + '"\
                                ,"FR_MOBILE":"'+ FMobile + '"\
                                ,"MO_BUSINESS_PHONE":"'+ MBusinessPhone + '"\
                                ,"MO_MOBILE":"'+ MPhone + '"\
                                ,"FR_INCOME":"'+ FIncome + '"\
                                ,"MO_INCOME":"'+ MIncome + '"\
                                ,"FR_DATE_OF_EXPIRY":"'+ FDOExpiry + '"\
                                ,"MO_DATE_OF_EXPIRY":"'+ MDOExpiry + '"\
                                ,"FR_EMAIL":"'+ FEmail + '"\
                                ,"MO_EMAIL":"'+ MEmail + '"\
                                ,"FR_OCCUPATION":"'+ FOccupation + '"\
                                ,"MO_OCCUPATION":"'+ MOccupation + '"\
                                ,"FATHER_EDUCATION":"'+ FEducation + '"\
                                ,"MOTHER_EDUCATION":"'+ MEducation + '"\
                                ,"FR_NATIONALITY":"'+ FNationality + '"\
                                ,"MO_NATIONALITY":"' + MNationality + '"}';
                }
        
                $.ajax({
                    url:"@Url.Action("SaveParentsDetails", "Student")",
                    method:"POST",
                    datatype:"html",
                    data:{JsonParents:JsonData},
                    success:function(data)
                    {
                        if (data.Message == '200')
                        {
                            myAlert('Record Saved Successfully ...!', 'gritter-success', '');
                        } else {
                            myAlert(data.Message, 'gritter-danger', '');
                        }
                    },error:function(error)
                    {
                        myAlert('Internal Server Error ...!', 'gritter-danger', '');
                    }
                });
            });
        </script>
