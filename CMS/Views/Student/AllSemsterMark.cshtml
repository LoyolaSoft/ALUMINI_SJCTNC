@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "AllSemsterMark";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Semster Marks</li>
    </ol>
    <h1 class="page-header">Semster Marks</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Semster Marks</h4>
        </div>
        <div class="panel-body noPadding">
            @if (Model.liSemestermark != null && Model.liSemestermark.Count > 0)
            {
                <div class="form-group col-md-12 table-responsive" id="divprint">
                    <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-4">                        
                            @Html.Label("Reg No", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                <label>@Model.liSemestermark.FirstOrDefault().REGISTER_NO</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            @Html.Label("Name", htmlAttributes: new { @class = "col-md-2 control-label " })
                            <div class="col-md-8">
                                <label>@Model.liSemestermark.FirstOrDefault().NAME</label>
                            </div>
                        </div>
                    </div>
                    </div>
                   <br>

                    <table border="1" id="tblsemstermark" style="padding:10px;">
                        <thead>
                            <tr>
                                <th style="padding:3px">#</th>
                                <th style="padding:3px">Sem</th>
                                <th style="padding:3px">Course</th>
                                <th style="padding:3px">Mark</th>
                                <th style="padding:3px">Result</th>
                                <th style="padding:3px">Grade</th>
                                <th style="padding:3px">Pass Month</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (Model.liSemestermark != null && Model.liSemestermark.Count > 0)
                            {
                                var count = 0;
                                foreach (var item in Model.liSemestermark)
                                {
                                    count = count + 1;

                                    <tr>
                                        <td style="padding:3px">@count</td>

                                        <td style="padding:3px">@item.SEMESTER_NAME</td>
                                        <td style="padding:3px">@item.COURSE_TITLE</td>
                                        <td style="padding:3px">@item.TOTAL</td>
                                        <td style="padding:3px">@item.RESULT</td>
                                        <td style="padding:3px">@item.GRADE</td>
                                        <td style="padding:3px">@item.M_PASS</td>
                                    </tr>
                                }

                            }

                        </tbody>
                    </table>
                    <br>
                  
                    
                </div>
                <div class="col-md-12">
                    <div class="col-md-1 col-md-offset-11">
                        <button class="btn btn-success" id="btnprint" onclick="printDiv('divprint')">Print</button>
                    </div>
                </div>
            }
            </div>
        </div>
    </div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        //$('.selectpicker').selectpicker('Refresh');

        //var tbl = $('#tblsemstermark').DataTable();
        //$('#tblsemstermark').DataTable();

        function printDiv(divName)
        {

            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;

        }


</script>



