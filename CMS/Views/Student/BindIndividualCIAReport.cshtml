@model CMS.ViewModel.ViewModel.StudentViewModel

@if (Model.liCIA_Marks_Info != null && Model.liCIA_Marks_Info.Count > 0)
{
    var StudentList = Model.liCIA_Marks_Info.GroupBy(s => s.STUDENT_ID).ToList();
    if (StudentList != null && StudentList.Count > 0)
    {
        foreach (var student in StudentList)
        {
            var Individual = Model.liStudentList.Where(s => s.STUDENT_ID == student.FirstOrDefault().STUDENT_ID).ToList();
            if (Individual != null && Individual.Count > 0)
            {
               
                    <div style="page-break-after:always !important;page-break-inside:avoid !important;">
                        <div class="col-md-12">
                            <div class="col-md-8 col-lg-offset-2">
                                @if (Model.liCollgeDetails != null)
                                {
                                    foreach (var list in Model.liCollgeDetails)
                                    {
                                        <center>
                                            <table>
                                                <tr>
                                                    <td><center><strong>@list.COLLEGE_NAME</strong></center></td>
                                                </tr>
                                                <tr>
                                                    <td><b> @list.GRADE</b></td>
                                                </tr>
                                                <tr>
                                                    <td class="text-center">
                                                        @list.UNIVERSITY
                                                    </td>
                                                </tr>
                                            </table>
                                        </center>
                                    }
                                }
                            </div>
                        </div>
                        <br />
                        @{
                            <div class="col-md-12">
                                <table  align="center" style="width:100%;">
                                    <tr>
                                        <td style="width:60%"><b>Name</b> : &nbsp;@Individual.FirstOrDefault().FIRST_NAME</td>                                     
                                        <td style="width:40%" align="left"><b>Roll No</b> : &nbsp;@Individual.FirstOrDefault().ROLL_NO</td>
                                    </tr>
                                    <tr>
                                        <td style="width:60%"><b>Department</b> : &nbsp;@Individual.FirstOrDefault().DEPARTMENT</td>                                        
                                        <td style="width:40%" align="left"><b>Register No</b> : &nbsp;@Individual.FirstOrDefault().REGISTER_NO</td>
                                    </tr>
                                    <tr>
                                        <td style="width:60%"><b>Programme</b>: &nbsp;@Individual.FirstOrDefault().PROGRAMME_NAME </td>                                        
                                        <td style="width:40%" align="left"><b>Class</b> : &nbsp;@Individual.FirstOrDefault().CLASS_NAME</td>
                                    </tr>
                                </table>
                            </div>
                        }
                        <div class="col-md-12">
                            <table align="left" style="width:100%; border:1px solid; table-layout:fixed;">
                                <caption><center><h3>I Internal Test (2018-2019)</h3></center></caption>
                                <thead>
                                    <tr>
                                        <th width="5% !important" style="border:1px solid; padding-left:8px;" align="left">#</th>
                                        <th width="5% !important" style="border:1px solid; padding-left:8px;" align="left">Part</th>
                                        <th width="15% !important" style="border:1px solid; padding-left:8px;" align="left">Course Code</th>
                                        <th width="28% !important" style="border:1px solid; padding-left:8px;" align="left">Course Title</th>
                                        <th width="6% !important" style="border:1px solid; padding-left:8px;" align="left">Mark</th>
                                        <th width="6% !important" style="border:1px solid; padding-left:8px;" align="left">Total</th>
                                        <th width="30% !important" style="border:1px solid; word-wrap:break-word; padding-left:8px;" align="left">Course Teacher Remark</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var CIAMARKS = Model.liCIA_Marks_Info.Where(s => s.STUDENT_ID == student.FirstOrDefault().STUDENT_ID).OrderBy(s=>s.PART).ToList();

                                        int count = 0;
                                        foreach (var items in CIAMARKS)
                                        {
                                            <tr>
                                                <td width="5% !important" style="border:1px solid; padding:10px;">@{count++;}@count</td>
                                                <td width="5% !important" style="border:1px solid; padding:10px;">@items.PART</td>
                                                <td width="15% !important" style="border:1px solid; padding:10px;">@items.COURSE_CODE</td>
                                                <td width="30% !important" style="border:1px solid; padding:10px;">@items.COURSE_TITLE</td>
                                                <td width="5% !important" style="border:1px solid; padding:10px;">@items.COURSE_GROUP_MARK</td>
                                                <td width="5% !important" style="border:1px solid; padding:10px;">@items.MAX_MARK</td>
                                                <td width="30% !important" style="border:1px solid; word-wrap:break-word; padding:10px;">@items.REMARK</td> 
                                            </tr>
                                                    }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-12">
                            <table align="center" style="width:100%;" >
                                <tr>
                                    <td><b>Pass:</b> 20 & Above &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<b>Fail:</b> Below 20</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-12">
                            <br/>
                            <table align="center" style="width:100%;">
                                <tr>
                                    <td><b>Class Teacher Remark: </b></td>
                                </tr>
                            </table>
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <br/>                      
                        </div>
                        <div class="col-md-12">
                            <table align="center" style="width:100%;">
                                <tr>
                                    <td><b>Signature of the Class Teacher</b></td>
                                    <td class="pull-right"><b>Signature of  the HOD</b></td>
                                </tr>
                            </table>
                        </div>

                    </div>

                                                                }
                                                            }
                                                        }
                                                    }

