@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "ProgrammeWiseCasteReport";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/css/animate.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ProgrammeWiseCasteReport</li>
    </ol>
    <h1 class="page-header">ProgrammeWise CasteReport</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ProgrammeWise CasteReport</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="col-md-12 form-horizontal">

                <div class="col-md-4 form-group">
                    @Html.LabelFor(model => model.AcademicYearList, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dAcademic" })
                    </div>
                </div>

                <div class="col-md-4 form-group ">
                    @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "dShift", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                    </div>
                </div>
                <div class="col-md-4 form-group ">
                    @Html.LabelFor(model => model.ProgrammeMode, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.ProgrammeMode, (Model.ProgrammeMode != null) ? Model.ProgrammeMode : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "dProgrammeMode", @data_live_search = "true", @data_actions_box = "true" })
                    </div>
                </div>

            </div>
            <div class="col-md-12 form-horizontal">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(model => model.ProgrammeList, htmlAttributes: new {@class="control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(model=>model.ProgrammeList, (Model.ProgrammeList !=null)?Model.ProgrammeList :Enumerable.Empty<SelectListItem>(),null,new {@class= "selectpicker show-menuu-arrow show-tick drop-down form-control  input-sm" ,@id="dProgramme",@data_live_search="true",@multiple="multiple", @data_actions_box = "true" })
                        </div>
                    </div>

                    <div class="col-md-4 form-group">
                        @Html.LabelFor(model=>model.Caste,htmlAttributes:new {@class= "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(model => model.Caste, (Model.Caste != null) ? Model.Caste : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menuu-arrow show-tick drop-down form-control  input-sm", @id = "dCaste", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                        </div>
                    </div>
                  
           </div>
            <div class="col-md-12 form-horizontal">
                <div class="col-md-1 form-group">
                    <button class="btn btn-primary" id="btnGet"> Get </button>
                </div>
                
            </div>
            
            <div class="divBind hidden">
                <div class="" id="divProgramme">

                </div>
                <div class="" id="divStudent">

                </div>
                <div class="" id="divCommunity">

                </div>
            </div>
          



            <div class="row">
                <!-- begin col-12 -->
                <div class="col-lg-12">
                    <!-- begin nav-tabs -->
                    <ul class="nav nav-tabs">
                        <li class="nav-items active">
                            <a href="#default-tab-1" data-toggle="tab" class="nav-link">
                                <span class="d-sm-none">Programme Wise</span>
                                <span class="d-sm-block d-none">Report</span>
                            </a>
                        </li>
                        <li class="nav-items">
                            <a href="#default-tab-2" data-toggle="tab" class="nav-link" id="tab2">
                                <span class="d-sm-none">Student Wise</span>
                                <span class="d-sm-block d-none">Report</span>
                            </a>
                        </li>
                        <li class="nav-items">
                            <a href="#default-tab-3" data-toggle="tab" class="nav-link active show" id="tab3">
                                <span class="d-sm-none">Community Wise</span>
                                <span class="d-sm-block d-none">Report</span>
                            </a>
                        </li>
                    </ul>
                    <!-- end nav-tabs -->
                    <!-- begin tab-content -->
                    <div class="tab-content">
                        <!-- begin tab-pane -->
                        <div class="tab-pane fade active in" id="default-tab-1">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">
                                    <div class="form-group col-md-12">
                                        <div class="col-md-12">
                                            <div class="table-responsive">
                                                
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <!-- end tab-pane -->
                        <!-- begin tab-pane -->
                        <div class="tab-pane fade" id="default-tab-2">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">
                                    <div class="form-group col-md-12">
                                        <div class="col-md-12">
                                            <div class="table-responsive">
                                            
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end tab-pane -->
                        <!-- begin tab-pane -->
                        <div class="tab-pane fade" id="default-tab-3">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">
                                    <div class="form-group col-md-12">
                                        <div class="col-md-12">
                                            <div class="table-responsive">
                                             
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end tab-pane -->
                    </div>
                    <!-- end tab-content -->

                </div>
            </div>



        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        ContentLoad = function () {


            $('.selectpicker').selectpicker({
                size: 5
            });
            $('.selectpicker').selectpicker('refresh');

        }
     
        $('#tab2').click(function () {
            if ($('#dAcademic option:selected').text() && $('#dShift').val() && $('#dProgrammeMode').val() && $('#dProgramme').val() && $('#dCaste').val())
            {
                $.ajax({
                    url: "/Student/BindStudentWiseCasteReportDetails",
                    type: "post",
                    data: { sAcademic: $('#dAcademic  option:selected').text(), sShift: String($('#dShift').val()), sProgrammeMode: String($('#dProgrammeMode').val()), sProgramme: String($('#dProgramme').val()), sCaste: String($('#dCaste').val()) },
                    success: function (data) {
                        if(data.Message!=null && data.Message!='')
                        {
                            alert(data.Message)
                        }
                        else
                        {
                            $('#default-tab-2 .table-responsive').html('');
                            $('#divStudent').html('');
                            $('#default-tab-2 .table-responsive').append(data);
                            $('#divStudent').append(data);
                        }
                    },
                    error: function (ex) {

                    }
                });
            }
            else {
                alert("Pleas Select All the fields")
            }
        });

        $('#tab3').click(function () {
            if ($('#dAcademic option:selected').text() && $('#dShift').val() && $('#dProgrammeMode').val() && $('#dProgramme').val() && $('#dCaste').val()) {
                $.ajax({
                    url: "/Student/BindCommunityWiseCasteReportDetails",
                    type: "post",
                    data: { sAcademic: $('#dAcademic  option:selected').text(), sShift: String($('#dShift').val()), sProgrammeMode: String($('#dProgrammeMode').val()), sProgramme: String($('#dProgramme').val()), sCaste: String($('#dCaste').val()) },
                    success: function (data) {
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message)
                        }
                        else {
                            $('#default-tab-3 .table-responsive').html('');
                            $('#divCommunity').html('');
                            $('#default-tab-3 .table-responsive').append(data);
                            $('#divCommunity').append(data);
                        }
                    },
                    error: function (ex) {
                        alert("Internal Server Error!")
                    }
                });
            }
            else {
                alert("Pleas Select All the fields")
            }
        });




        $('#btnGet').click(function () {
            if ($('#dAcademic option:selected').text() && $('#dShift').val() && $('#dProgrammeMode').val() && $('#dProgramme').val() && $('#dCaste').val())
            {
                $.ajax({
                    url: "/Student/BindProgrammeWiseCasteReportDetails",
                    type: "post",
                    data: { sAcademic: $('#dAcademic  option:selected').text(), sShift: String($('#dShift').val()), sProgrammeMode: String($('#dProgrammeMode').val()), sProgramme: String($('#dProgramme').val()), sCaste: String($('#dCaste').val()) },
                    success: function (data) {
                        if(data.Message!=null && data.Message!='')
                        {
                                alert(data.Message)
                        }
                        else
                        {
                            $('#default-tab-1 .table-responsive').html('');
                            $('#divProgramme').html('');
                            $('#default-tab-1 .table-responsive').append(data);
                            $('#divProgramme').append(data);
                         
                      }
                    },
                    error: function (ex) {

                        alert("Internal Server Error!")
                    }
                });
            }
            else
            {
                alert("Pleas Select All the fields")
            }
        });


        $('#dProgrammeMode').on("change", function () {
            $('#dProgramme').html('');
            $('#dProgramme').selectpicker('refresh');
            if($('#dAcademic option:selected').text() && $('#dShift').val() && $('#dProgrammeMode').val())
            {
                $.ajax({

                    url: "/Student/FetchProgrammeByProgrammeModeandShift",
                    type:"post",
                    data: { sShift: String($('#dShift').val()), sProgrammeMode: String($('#dProgrammeMode').val()) },
                    success: function (data) {
                        if(data.Message!=null && data.Message!='')
                        {
                          
                        }
                        else
                        {
                            $('#dProgramme').empty();
                            $.each(data, function (id, info) {
                                $('#dProgramme').append($('<option>',
                                {
                                    value: info.PROGRAMME_GROUP_ID,
                                    text: info.PROGRAMME_NAME
                                }));

                            });
                            $('#dProgramme').selectpicker('refresh');
                        }
                    },
                    error:function(ex)
                    {
                        alert("Internal Server Error!")

                    }
                });
            }
        });
   
      

    </script>
    
    

