<script>
   

    $(document).ready(function () {
        var urlParams = new URLSearchParams(window.location.search);
        var rollNo = urlParams.get('sRollNo');
        if (rollNo) {
            $('#txtRollNo').val(rollNo);
            BindData();
        }
    });

    $('#txtRollNo').on("keypress", function (event) {
        var keycode = event.keyCode || event.which;
        if (keycode == 13) {
            event.preventDefault();
            BindData();
        }
    });

     function BindData()
 {

         if ($('#txtRollNo').val())
     {
         $.ajax({
             url: '@Url.Action("FetchNoDueFormByRollNO", "Student")',
             method: 'POST',
             datatype: 'Json',
             data: { sRollNo: $('#txtRollNo').val() },
             success: function (data)
             {
                 $('#dvBindHallTicket').empty();
                 $('#dvBindHallTicket').append(data);
             }, error: function (error)
             {
                 swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
             }
         });
     } else
     {
         swal({ title: "Warning !", text: "Something went wrong try again !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
     }
 }
</script>
