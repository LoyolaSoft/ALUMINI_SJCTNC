        {
            // Document Ready Function .
            $('.selectpicker').selectpicker({
                size: 4
            });
            $('.selectpicker').selectpicker('refresh');
            $('#panel-expand').click();
        }
        

        $('#CourseList').on('change', function ()
        {
            if ($('#CourseList').val())
            {
                $.ajax({
                    url: "@Url.Action("GetStaffByCourseId", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sCourseId: $('#CourseList').val() },
                    success: function (data)
                    {
                        $("#StaffList").empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $("#StaffList").append(data.sResult);
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        });
        
    
    $('#StaffList').on('change', function ()
    {
        GetQuizData();
    });

        // On Get Data ..
        @*$("#btnGet").on("click", function ()
        {
