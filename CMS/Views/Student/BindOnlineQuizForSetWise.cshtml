<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<br />
<div id="content" class="content">
    <div id="FullScreen_Content_Expand">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" id="panel-expand" class="btn btn-xs btn-icon btn-circle btn-default disabled" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success disabled" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning disabled" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger disabled" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">
                    Online Quiz
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

                    Time : &nbsp;&nbsp;&nbsp;<b id="lblQuizTimeRunner" class="blink"> </b>
                </h4>

            </div>
            <div class="panel-body">
                <div class="col-md-12" id="dvOnlineQuizQuestionsEntry">
                    @{
                        if (Model.liCourseInfo != null && Model.liCourseInfo.Count > 0)
                        {

                            <div class="col-md-12 form-inline">

                                <div class="form-group col-md-4">
                                    <div><b> Course Code</b> @Model.liCourseInfo.FirstOrDefault().COURSE_CODE</div>
                                </div>

                                <div class="form-group col-md-4">
                                    <div><b> Course Title</b> @Model.liCourseInfo.FirstOrDefault().COURSE_TITLE</div>
                                </div>

                                <div class="form-group col-md-4">
                                    <div><b> Class </b> @Model.liCourseInfo.FirstOrDefault().CLASS_NAME</div>
                                </div>

                            </div>
                            <br /><br />

                            <div class="col-md-12 form-inline">

                                <div class="form-group col-md-4">
                                    <div><b> Incharge </b> @Model.liCourseInfo.FirstOrDefault().STAFF_NAME</div>
                                </div>

                                <div class="form-group col-md-4">
                                    <div><b> Date </b> @Model.liCourseInfo.FirstOrDefault().DATE</div>
                                </div>

                            </div>

                            <br /><br />
                            <input class="hidden" id="hdSemesterId" value="@Model.liCourseInfo.FirstOrDefault().SEMESTER_ID" />
                            <input class="hidden" id="hdStudentId" value="@Model.liCourseInfo.FirstOrDefault().STUDENT_ID" />
                        }
                    }

                    <br />

                    <!-- Hidden Filed -->
                    <input class="hidden" id="hdClassId" value="@Model.ClassId" />
                    <input class="hidden" id="hdCourseId" value="@Model.CourseId" />
                    <input class="hidden" id="hdSettingId" value="@Model.SettingId" />
                    <input class="hidden" id="hdStaffId" value="@Model.StaffId" />
                    <input type="text" value="@Model.sTime" id="hdQuizTime" class="hidden" />
                    <!-- Hidden Filed -->

                    @if (!string.IsNullOrEmpty(Model.sErrorMessage))
                    {
                        <div> @Model.sErrorMessage</div>
                    }
                    else
                    {
                        <div class="col-md-12">
                            <table class="table table-bordered table-hover" id="tblOnlineQuiz">
                                <thead>
                                    <tr><th>Questions</th><th>Answers</th></tr>
                                </thead>
                                <tbody>
                                    @if (Model.liOnlineQuizQuestions != null && Model.liOnlineQuizQuestions.Count > 0 && Model.liOnlineQuizOptions != null && Model.liOnlineQuizOptions.Count > 0)
                                    {
                                        foreach (var item in Model.liOnlineQuizQuestions)
                                        {
                                            var liGroupOptions = Model.liOnlineQuizOptions.Where(x => x.QUIZ_ID == item.QUIZ_ID && item.QUESTION_TYPE == x.QUESTION_TYPE).ToList();
                                            nCount++;
                                            if (item.QUESTION_TYPE == "3")
                                            {
                                                // Bind Match The Following Questions....
                                                <tr cms-Head="1">
                                                    <td colspan="2"><b> @nCount . @(new HtmlString(Model.GetStrigFromBase64String(item.QUIZ_QUESTION)))</b></td>
                                                </tr>
                                                foreach (var GpOptionitem in liGroupOptions)
                                                {
                                                    <tr cms-sQuestionType="@item.QUESTION_TYPE" cms-sQuizId="@item.QUIZ_ID">
                                                        <td>  @(new HtmlString(Model.GetStrigFromBase64String(GpOptionitem.QUESTION))) </td>
                                                        <td>
                                                            <select id="ddlAnswer" class="selectpicker  form-control  input-sm" data-live-search="true">
                                                                <option value="">-- select --</option>
                                                                @{
                                                                    var ddlOptions = liGroupOptions.OrderBy(x => Guid.NewGuid());
                                                                    foreach (var ddlitem in ddlOptions)
                                                                    {
                                                                        <option value="@ddlitem.OPTION_ID" cms-SetId="@ddlitem.SET_ID" cms-QuestionType="@GpOptionitem.QUESTION_TYPE" cms-OptionId="@GpOptionitem.OPTION_ID" cms-sQuizId="@ddlitem.QUIZ_ID" data-content='@(new HtmlString(Model.GetStrigFromBase64String(ddlitem.ANSWER)))'></option>
                                                                    }
                                                                }
                                                            </select>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else if (item.QUESTION_TYPE == "2")
                                            {
                                                // Bind Fill In The Blank Questions....
                                                <tr cms-Head="1">
                                                    <td colspan="2"><b>@nCount . @(new HtmlString(Model.GetStrigFromBase64String(item.QUIZ_QUESTION)))</b></td>
                                                </tr>
                                                <tr cms-sQuestionType="@item.QUESTION_TYPE" cms-sQuizId="@item.QUIZ_ID">
                                                    @*<td><b> @nCount . @item.QUIZ_QUESTION</b></td>*@
                                                    <td colspan="2">
                                                        <select id="ddlAnswer" class="selectpicker  form-control  input-sm" data-live-search="true">
                                                            <option value="">-- select --</option>
                                                            @{
                                                                var ddlOptions = liGroupOptions.OrderBy(x => Guid.NewGuid());
                                                                foreach (var ddlitem in ddlOptions)
                                                                {
                                                                    <option value="@ddlitem.OPTION_ID" cms-SetId="@ddlitem.SET_ID" cms-AnswerId="@item.ANSWER_ID" cms-QuestionType="@item.QUESTION_TYPE" cms-OptionId="@item.OPTION_ID" cms-sQuizId="@ddlitem.QUIZ_ID" data-content='@(new HtmlString(Model.GetStrigFromBase64String(ddlitem.OPTION)))'></option>
                                                                }
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                            else if (item.QUESTION_TYPE == "1")
                                            {
                                                // Bind Objective Type Questions ...
                                                <tr cms-Head="1">
                                                    <td colspan="2"><b>@nCount . @(new HtmlString(Model.GetStrigFromBase64String(item.QUIZ_QUESTION)))</b></td>
                                                </tr>
                                                <tr cms-sQuestionType="@item.QUESTION_TYPE" cms-sQuizId="@item.QUIZ_ID">
                                                    @*<td><b> @nCount . @item.QUIZ_QUESTION</b></td>*@
                                                    <td colspan="2">
                                                        <div class="form-group">
                                                            @{
                                                                foreach (var GpOptionitem in liGroupOptions)
                                                                {
                                                                    <div class="radio radio-css radio-inline">
                                                                        <input type="radio" class="radio-inline" id="@GpOptionitem.OPTION_ID" radio-id="RadioOption" name="@item.QUIZ_ID" cms-AnswerId="@item.ANSWER_ID" cms-OptionId="@GpOptionitem.OPTION_ID" cms-SetId="@GpOptionitem.SET_ID" cms-QuestionType="@GpOptionitem.QUESTION_TYPE"/>
                                                                        <label for="@GpOptionitem.OPTION_ID" class="control-label">@(new HtmlString(Model.GetStrigFromBase64String(GpOptionitem.OPTION)))</label>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="col-md-12" id="dvbtnSubmit">
                        <button type="button" value="1" class="btn btn-primary pull-right" id="btnSubmit">Submit</button>
                        @*<button type="button" id="btnFullScreen" onclick="toggleFullScreen(document.body)" >Enable Full Screen</button>*@
                        <input type="text" id="hdQuizCount" value="@nCount" class="hidden" />
                    </div>
                </div>
                <div class="col-md-12" id="dvOnlineQuiz">

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function ,..
        $('#panel-expand').click();

        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');


    }




    function blink_text() {
        $('.blink').fadeOut(500);
        $('.blink').fadeIn(500);
    }
    var refreshTimerId, BlinkTimer;

    function startTimer(duration, display) {
        var timer = duration, hours, minutes, seconds, ManageTime;
        refreshTimerId = setInterval(function () {
            hours = parseInt(timer / 3600, 10);
            minutes = parseInt(timer / 60, 10);
            minutes = parseInt(minutes % 60, 10);
            seconds = parseInt(timer % 60, 10);

            hours = hours < 10 ? "0" + hours : hours;
            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;
            ManageTime = $('#hdQuizTime').val() - minutes;
            if (ManageTime != 0) {
                document.getElementById("lblQuizTimeRunner").innerHTML = minutes + " : " + seconds + " ";
                if (ManageTime < 2) {
                    BlinkTimer = setInterval(blink_text, 1000);
                    //$('#hdQuizTime').addClass('text-danger');
                }
            } else {
                alert("Time's Up");
                StopTimer();
                $("#btnSubmit").val('0');
                $("#btnSubmit").click();
            }

            if (++timer < 0) {
                timer = duration;
            }
        }, 1000);
    }

    function LoadTimer() {
        var fiveMinutes = 0;
        fiveMinutes = 60 * 60;
        display = document.querySelector('#hdQuizTime');
        startTimer(fiveMinutes, display);
    };

    function StopTimer() {
        clearInterval(refreshTimerId);
        clearInterval(BlinkTimer);

    };

</script>

<script>
    if ($('#hdQuizCount').val() != 0) {
        StopTimer();
        LoadTimer();
        //$('#liQuizTimeRunner').removeClass('hidden');
    }

    $(function () {
        $(document).keydown(function (e) {
            return (e.which || e.keyCode) != 116;
        });
    });
</script>

<script>
            // Get Data ...
            function GetQuizData()
            {
                $('#panel-expand').click();
                var ClassList = $('#hdClassId').val();
                var CourseList = $('#hdCourseId').val();
                var StaffList = $("#hdStaffId").val();
                var SettingId = $("#hdSettingId").val();

                $.ajax({
                    url: "@Url.Action("BindOnlineQuizForSetWise", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sClassId: ClassList, sCourseId: CourseList, sSettingId: SettingId, sStaffId: StaffList },
                    success: function (data)
                    {
                        $("#dvOnlineQuiz").empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                            if (data.sResult != null && data.sResult == "1")
                            {
                                GetQuizResult(CourseList, StaffList, SettingId);
                            }
                        } else
                        {
                            $("#dvOnlineQuiz").append(data);
                            $('#btnSubmit').removeClass('hidden');

                            $('.selectpicker').selectpicker('refresh');
                        }

                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }

            // On Submit ...
            $('#btnSubmit').on('click', function ()
            {
                clearInterval(BlinkTimer);

                var btnValue = $('#btnSubmit').val();
                var ClassList = $('#hdClassId').val();
                var CourseList = $('#hdCourseId').val();
                var StaffList = $("#hdStaffId").val();
                var SettingId = $("#hdSettingId").val();


                    var JsonCount = 0;
                    var JsonData = '{"liOnlineQuiz":[';
                    var sStatus = null;
                    $('#tblOnlineQuiz tbody tr').each(function ()
                    {
                        if ($(this).attr('cms-Head') != "1")
                        {
                            var sQuestionType = $(this).attr('cms-sQuestionType');
                            var sQuizId = $(this).attr('cms-sQuizId');
                            if (sQuestionType == "1")
                            {
                                var AnswerId = $('input[name="' + sQuizId + '"]:checked').attr('cms-AnswerId');
                                var OptionId = $('input[name="' + sQuizId + '"]:checked').attr('cms-OptionId');
                                var SetId = $('input[name="' + sQuizId + '"]:checked').attr('cms-SetId');

                                if (AnswerId != null && AnswerId != '' && AnswerId!='undefine')
                                {
                                    if (AnswerId == OptionId) { sStatus = 1; } else { sStatus = 0; }
                                    JsonData += '{"QUIZ_ID":"' + sQuizId + '",\
                                              "ANSWER_ID":"' + AnswerId + '",\
                                              "OPTION_ID":"' + OptionId + '",\
                                              "STATUS":"' + sStatus + '",\
                                              "CLASS_ID":"' + ClassList + '",\
                                              "COURSE_ID":"' + CourseList + '",\
                                              "SEMESTER_ID":"' + $('#hdSemesterId').val() + '",\
                                              "SET_ID":"' + SetId + '",\
                                              "SETTING_ID":"' + SettingId + '",\
                                              "STUDENT_ID":"' + $('#hdStudentId').val() + '",\
                                              "QUESTION_TYPE":"' + sQuestionType + '",\
                                              "MINUTES":"0" },';
                                    JsonCount++;
                                }

                            } else if (sQuestionType == "2")
                            {
                                var sAnswer = $(this).find('select Option:selected').val();
                                var sQuizId = $(this).find('select Option:selected').attr('cms-sQuizId');
                                var sAnswerId = $(this).find('select Option:selected').attr('cms-AnswerId');
                                var sSetId = $(this).find('select Option:selected').attr('cms-SetId');
                                if (sAnswer != 0 && $(this).attr('cms-Head') != "1")
                                {
                                    if (sAnswer != null && sAnswer != 'undefined') {
                                        if (sAnswerId == sAnswer) { sStatus = 1; } else { sStatus = 0; }
                                        JsonData += '{"QUIZ_ID":"' + sQuizId + '",\
                                          "ANSWER_ID":"' + sAnswerId + '",\
                                          "OPTION_ID":"' + sAnswer + '",\
                                          "STATUS":"' + sStatus + '",\
                                          "CLASS_ID":"' + ClassList + '",\
                                          "COURSE_ID":"' + CourseList + '",\
                                          "SEMESTER_ID":"' + $('#hdSemesterId').val() + '",\
                                          "SET_ID":"' + sSetId + '",\"SETTING_ID":"' + SettingId + '",\
                                          "STUDENT_ID":"' + $('#hdStudentId').val() + '",\
                                          "QUESTION_TYPE":"' + sQuestionType + '",\
                                          "MINUTES":"0" },';
                                        JsonCount++;
                                    }
                                }
                            } else if (sQuestionType = "3")
                            {
                                var sAnswer = $(this).find('select Option:selected').val();
                                var sQuizId = $(this).find('select Option:selected').attr('cms-sQuizId');
                                var sOptionId = $(this).find('select Option:selected').attr('cms-OptionId');
                                var sSetId = $(this).find('select Option:selected').attr('cms-SetId');
                                if (sAnswer != 0 && $(this).attr('cms-Head') != "1")
                                {
                                    if (sAnswer != null && sAnswer != 'undefined')
                                    {
                                        if (sOptionId == sAnswer) { sStatus = 1; } else { sStatus = 0; }
                                        JsonData += '{"QUIZ_ID":"' + sQuizId + '",\
                                          "ANSWER_ID":"' + sOptionId + '",\
                                          "OPTION_ID":"' + sAnswer + '",\
                                          "STATUS":"' + sStatus + '",\
                                          "CLASS_ID":"' + ClassList + '",\
                                          "COURSE_ID":"' + CourseList + '",\
                                          "SEMESTER_ID":"' + $('#hdSemesterId').val() + '",\
                                          "SET_ID":"' + sSetId + '",\"SETTING_ID":"' + SettingId + '",\
                                          "STUDENT_ID":"' + $('#hdStudentId').val() + '",\
                                          "QUESTION_TYPE":"' + sQuestionType + '",\
                                          "MINUTES":"0" },';
                                        JsonCount++;
                                    }
                                }
                            }
                        }
                    });

                    if (JsonCount != 0)
                    {
                        JsonData = JsonData.slice(0, -1);
                        JsonData += ']}';
                        StopTimer();
                    } else if (btnValue=="0")
                    {
                        JsonData += '{"QUIZ_ID":"0",\
                                          "ANSWER_ID":"0",\
                                          "OPTION_ID":"0",\
                                          "STATUS":"0",\
                                          "CLASS_ID":"' + ClassList + '",\
                                          "COURSE_ID":"' + CourseList + '",\
                                          "SEMESTER_ID":"' + $('#hdSemesterId').val() + '",\
                                          "SET_ID":"0",\"SETTING_ID":"' + SettingId + '",\
                                          "STUDENT_ID":"' + $('#hdStudentId').val() + '",\
                                          "QUESTION_TYPE":"2"},';
                        JsonData = JsonData.slice(0, -1);
                        JsonData += ']}';
                    }else
                    {
                        alert('Please Choose Options to Continue !');
                        return false;
                    }

                    $.ajax({
                         url:'@Url.Action("SaveQuizForSetWise", "Student")',
                         method:'POST',
                         datatype: 'json',
                         async: false,
                         cache: false,
                         data: { sJsonSaveQuiz: JsonData, sSettingId: SettingId, sStaffId: StaffList },
                         success: function (data)
                         {
                             alert(data.Message);
                             $('#btnSubmit').addClass('hidden');
                             GetQuizData();
                         }, error: function (error)
                         {
                             alert('Internal Server Error !');
                         }
                    });

            });

            function GetQuizResult(CourseId, StaffId, SettingId)
            {
                $('#dvbtnSubmit').addClass('hidden');
                $('#dvOnlineQuizQuestionsEntry').addClass('hidden');

                $.ajax({
                    url: '@Url.Action("BindOnlineQuizResultForStudent", "Student")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sCourseId: CourseId, sStaffId: StaffId, sSettingId: SettingId },
                    success: function (data)
                    {
                        $("#dvOnlineQuiz").empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $("#dvOnlineQuiz").append(data);
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }

</script>


