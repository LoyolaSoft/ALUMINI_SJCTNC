                                                                <td style="width:6% !important;padding:5px 5px;  border-right:1px solid;" align="left">@Gpa.FirstOrDefault().PART</td>

                                                                <td style="width:6% !important;padding:5px 5px;  border-right:1px solid;" align="left">@Gpa.Sum(o => Convert.ToDouble(o.CREDIT))</td>

                                                                <td style="width:6% !important;padding:5px 5px;  border-right:1px solid;" align="left">@dGpa.ToString("#.##")</td>


                                                            </tr>
                                                        }
                                                    }
