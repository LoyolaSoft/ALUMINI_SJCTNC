<script>
     // Get Shift
    $("#Major").on("change", function () {
        var Major = $("#Major").val();
            $.ajax({
                url: "@Url.Action("GetAlliedCoursesWiseMajor", "Student")",
                method: "POST",
                datatype: "json",
                data: { sMajorId: Major },
                success: function (data)
                {
                    if (data.ALLIED1!="")
                    {
                        $("#Allied1").val(data.MAJOR_ID);
                    }

                    if (data.ALLIED2 != "")
                    {
                        $("#Allied2").val(data.MAJOR_ID);

                    }
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
    });


    
    $("#objStuPersonalInfo_DATE_OF_BIRTH").on('change', function ()
    {
            var age = $("#objStuPersonalInfo_DATE_OF_BIRTH").val();


              $.ajax({
                url: "@Url.Action("GetAgeByUsingMysql", "Student")",
                method: "POST",
                datatype: "json",
                  data: { sDate: age },
                success: function (data)
                {
                   
                    $("#txtAge").val('');
                    $("#txtAge").val(data);

                }, error: function (error) {
                    
                }
            });
           
        });

    

  
</script>

