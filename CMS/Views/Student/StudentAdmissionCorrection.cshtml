<script>
        $('.selectpicker').selectpicker({
            size: 4
        });
    ContentLoad = function () {


         

            $("#AdmissionCorrection").hide();
                $("#tittle").hide();

                var sOption = '<option value="">-- Select --</option>';

                $("#ClassName").empty();
                $("#ClassName").append(sOption);
                $("#ProgramName").empty();
                $("#ProgramName").append(sOption);
                $("#StuName").empty();
                $("#StuName").append(sOption);
                $('.selectpicker').selectpicker('refresh');
                //$("#btnTCIssueUpdate").hide();
                handleSelect2 = function () {
                    $(".default-select2").select2(), $(".multiple-select2").select2({
                        placeholder: "Select a Sudent"
                    })
                }
                handleSelect2();

                handleDatepicker = function () {
                    "use strict";
                    $("#dpDob,#dpAdmissionDate").datepicker({
                        todayHighlight: true,
                        autoclose: true,
                        endDate: new Date(),
                        format: "dd/mm/yyyy"
                        //orientation: "right bottom"
                    })
                }
                handleDatepicker();
                //handlepicker = function () {
                //    "use strict";
                //    $("#LeavingDate,#TCIssueDate,#StuTCApplyDate").datepicker({
                //        todayHighlight: true,
                //        autoclose: true,
                //        format: "dd/mm/yyyy",
                //        orientation: "right bottom"
                //    })
                //}
                //handlepicker();
        }
    $("#dpDob,#dpAdmissionDate").on("keypress", function (evt) {
            var keycode = evt.charCode || evt.keyCode;
            if (keycode == 46) {
                return false;
            }
        });

        $("#ProgramName").on("change", function () {
            var ProgramName = $("#ProgramName").val();
            var ShiftId = $("#ShiftList").val();
            var sAcademicYear = $('#AcademicYear option:selected').text();
            if (sAcademicYear == '' || sAcademicYear == '0') {
                alert('Please Choose All The Values...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("BindDDLClass", "Student")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: ShiftId, AcademicYear: sAcademicYear },
                success: function (data) {
                    $("#ClassName").empty();
                    $("#ClassName").append('<option value="">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        });
        // Get Shift
        $("#ShiftList").on("change", function () {
            var sShift = $("#ShiftList").val();
            $.ajax({
                url: "@Url.Action("GetProgramByShift", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift },
                success: function (data) {
                    $("#ProgramName").empty();
                    $("#ProgramName").append('<option value="">-- Select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                    $("#TransferCertificate").hide();
                    $('#tittle').hide();
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        });
        $("#ClassName").on("change", function () {
            var ProgramName = $("#ProgramName").val();
            var ClassName = $("#ClassName").val();
            var AcademicYear = $('#AcademicYear option:selected').text();
            if (AcademicYear == '' || AcademicYear == '0') {
                alert('Please Choose All The Values...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("FetchStudents", "Student")",
                method: "POST",
                datatype: "json",
                data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
                success: function (data) {
                    $("#StuName").empty();
                    $("#StuName").append('<option value="">-- select --</option>' + data);
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        });

        // Fetch Students ..
        var FetchStudentForAdmissionCorrection = function () {
            var StuName = $("#StuName").val();
            var sAcademicYear = $('#AcademicYear option:selected').text();
            $.ajax({
                url: "@Url.Action("FetchStudentForAdmissionCorrection", "Student")",
                method: "POST",
                datatype: "json",
                data: { sStudentId: StuName, AcademicYear: sAcademicYear },
                success: function (data) {
                    if (data == "No Records Found ...!") {
                        alert(data);
                    } else {
                        $('#tittle').show();
                        $("#AdmissionCorrection").show();
                        $("#tittle").show();

                        $("#objStuPersonalInfo_ADMISSION_NO").val(data.ADMISSION_NO);
                        $("#objStuPersonalInfo_REGISTER_NO").val(data.REGISTER_NO);
                        $("#objStuPersonalInfo_ADMISSION_DATE").val(data.ADMISSION_DATE);
                        $("#objStuPersonalInfo_YEAR_OF_JOIN").val(data.YEAR_OF_JOIN);


                        $("#Major").val('');
                        $("#Allied1").val('');
                        $("#Allied2").val('');


                        if (data.MAJOR != "" && data.MAJOR != null) {
                            $("#Major").find("option:contains(" + data.MAJOR + ")").attr('selected', 'selected');
                        }
                        if (data.ALLIED_1 != "" && data.ALLIED_1 != null) {
                            $("#Allied1").find("option:contains(" + data.ALLIED_1 + ")").attr('selected', 'selected');
                        }
                        if (data.ALLIED_2 != "" && data.ALLIED_2 != null) {
