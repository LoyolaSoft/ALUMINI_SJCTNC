                '"C_DOOR_DETAIL": "' + DoorNo + '",' +
                '"C_TALUK": "' + Taluk + '", ' +
                '"C_CITY": "' + City + '",' +

                '"C_PINCODE": "' + PinCode + '",' +
                '"C_DISTRICT": "' + District + '",' +
                '"STU_MOBILENO": "' + Mobile + '",' +
                '"LAST_SCHOOL_OR_COLLEGE": "' + LastSchool + '", ' +
                '"TC_SERIAL_NO": "' + TcNo + '",' +

                '"LAST_STUDIED_PLACE": "' + LastStudiedPlace + '",' +
                '"TOTAL_MARK": "' + TotalMark + '",' +
                '"TOTAL_MARK_OBTAINED": "' + TotalMarkObtained + '",' +
