                        }

                        $("#objStuPersonalInfo_PART_1_LANGUAGE").val(data.PART_1_LANGUAGE);
                        $("#objStuPersonalInfo_FIRST_NAME").val(data.FIRST_NAME);


                        $("#objStuPersonalInfo_DATE_OF_BIRTH").val(data.DATE_OF_BIRTH);

                        if (data.DATE_OF_BIRTH != "" && data.DATE_OF_BIRTH != null)
                        {
                            $("#objStuPersonalInfo_DATE_OF_BIRTH").trigger("change");
                        }
                        

                        $("#Religion").val(data.RELIGION);
                        $("#Community").val(data.COMMUNITY);
                        $("#objStuPersonalInfo_CASTE").val(data.CASTE);
                        $("#Nationality").val(data.NATIONALITY);
                        $("#objStuPersonalInfo_GUARDIAN_NAME").val(data.GUARDIAN_NAME);


                        $("#BloodGroup").val(data.BLOOD_GROUP);
                        $("#objStuPersonalInfo_AADHAR_NUMBER").val(data.AADHAR_NUMBER);



                        $("#Occupation").val(data.FR_OCCUPATION);

                        $("#objStuPersonalInfo_ANNUAL_INCOME").val(data.ANNUAL_INCOME);
                        $("#objStuPersonalInfo_C_DOOR_DETAIL").val(data.C_DOOR_DETAIL);
                        $("#objStuPersonalInfo_C_STREET").val(data.C_STREET);
                        $("#objStuPersonalInfo_C_TALUK").val(data.C_TALUK);
                        $("#objStuPersonalInfo_C_CITY").val(data.C_CITY);
                        $("#objStuPersonalInfo_C_PINCODE").val(data.C_PINCODE);
                        $("#objStuPersonalInfo_C_DISTRICT").val(data.C_DISTRICT);
                        $("#objStuPersonalInfo_STU_MOBILENO").val(data.STU_MOBILENO);
                        $("#objStuPersonalInfo_LAST_SCHOOL_OR_COLLEGE").val(data.LAST_SCHOOL_OR_COLLEGE);
                        //$("#CourseOfStudy").val(data.CourseOfStudy);
                        $("#objStuPersonalInfo_TC_SERIAL_NO").val(data.TC_SERIAL_NO);
                        $("#objStuPersonalInfo_LAST_STUDIED_PLACE").val(data.LAST_STUDIED_PLACE);

                        if (data.SPECIALLY_ABLED == "1") {
                            $("#rbSaYes").prop("checked", true);
                        }
                        else
                        {
                            $("#rbSaNo").prop("checked", true);
                        }


                        if (data.EX_SERVICE_MAN == "1") {
                            $("#rbExYes").prop("checked", true);
                        }
                        else {
                            $("#rbExNo").prop("checked", true);
                        }

                        if (data.IS_ANDAMAN_ORIGIN == "1")
                        {
                            $("#rbAndYes").prop("checked", true);
                        }
                        else {
                            $("#rbAndNo").prop("checked", true);
                        }

                        if (data.IS_SPORTS == "1") {
                            $("#rbSpoYes").prop("checked", true);
                        }
                        else {
                            $("#rbSpoNo").prop("checked", true);
                        }


                        $("#objStuPersonalInfo_TOTAL_MARK").val(data.TOTAL_MARK);
                        $("#objStuPersonalInfo_TOTAL_MARK_OBTAINED").val(data.TOTAL_MARK_OBTAINED);
                        $("#objStuPersonalInfo_CUT_OF_MARK").val(data.CUT_OF_MARK);


                        $("#objStuPersonalInfo_IDENTIFICATION_MARK1").val(data.IDENTIFICATION_MARK1);
                        $("#objStuPersonalInfo_IDENTIFICATION_MARK2").val(data.IDENTIFICATION_MARK2);
                        $("#objStuPersonalInfo_REMARKS").val(data.REMARKS);

                        $("#objStuPersonalInfo_YEAR_OF_PASSING").val(data.YEAR_OF_PASSING);
                        $("#objStuPersonalInfo_MARK_SHEET_NO").val(data.MARK_SHEET_NO);


                        $("#objStuPersonalInfo_MONTH_OF_PASSING").val(data.MONTH_OF_PASSING);
                        $("#objStuPersonalInfo_Q_REGISTER_NO").val(data.Q_REGISTER_NO);
                        

                        $('.selectpicker').selectpicker('refresh');
                    }

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }

        $("#StuName").on("change", function () {
            FetchStudentForAdmissionCorrection();
        });


        // Save Or Update ...
    $("#btnSave").on("click", function () {
