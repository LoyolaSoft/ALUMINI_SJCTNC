        var IsSports = $("input[name='radioSports']:checked").val();


        var MonthOfPassing = $("#objStuPersonalInfo_MONTH_OF_PASSING").val();
        var QregisterNo = $("#objStuPersonalInfo_Q_REGISTER_NO").val();


            var JsonData;
        if (JsonData == null)
        {
            JsonData = '{"STUDENT_ID":"' + StudentId + '",' +
                '"ADMISSION_NO": "' + ApplicationNo + '",' +
                '"REGISTER_NO": "' + RegisterNo + '",' +
                '"ADMISSION_DATE": "' + AdmissionDate + '",' +
                '"YEAR_OF_JOIN": "' + YearOfJoin + '", ' +
                '"MAJOR": "' + Major + '",' +

                '"ALLIED_1": "' + Allied1 + '",' +
                '"ALLIED_2": "' + Allied2 + '",' +
                '"PART_1_LANGUAGE": "' + Part1 + '",' +
