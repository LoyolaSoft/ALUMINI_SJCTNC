@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Achievement Certificate</title>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Montserrat:wght@400;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f0f0f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            font-family: 'Montserrat', sans-serif;
        }

        .controls {
            margin-top: 20px;
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
        }

        .btn-action {
            padding: 10px 20px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
            color: white;
            transition: opacity 0.2s;
        }

        .btn-download { background-color: #27ae60; }
        .btn-print { background-color: #2980b9; }

        .certificate-wrapper {
            background: white;
            padding: 20px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        .certificate-container {
            width: 1050px;
            height: 740px;
            padding: 30px;
            position: relative;
            background-color: #fff;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 10px solid #2c3e50;
            box-sizing: border-box;
            background-image: linear-gradient(rgba(255,255,255,0.95), rgba(255,255,255,0.95)), url('/Content/assets/img/pattern-cover.png');
            background-size: cover;
        }

        .border-inner {
            position: absolute;
            top: 10px;
            left: 10px;
            right: 10px;
            bottom: 10px;
            border: 2px solid #8e44ad;
            pointer-events: none;
        }

        .header-section {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .logo-box { width: 100px; height: 100px; }
        .logo-box img { width: 100%; height: 100%; object-fit: contain; }

        .college-info {
            text-align: center;
            flex-grow: 1;
        }

        .college-name {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 700;
            color: #b03a2e;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        .college-details {
            font-size: 11px;
            color: #2c3e50;
            line-height: 1.3;
        }

        .dept-title {
            font-size: 28px;
            font-weight: 700;
            color: #1a5276;
            margin: 20px 0;
            text-transform: uppercase;
            border-bottom: 2px solid #1a5276;
            padding-bottom: 5px;
        }

        .certify-line {
            font-size: 18px;
            color: #b03a2e;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .student-name-box {
            margin: 15px 0;
            position: relative;
        }

        .student-name {
            font-family: 'Dancing Script', cursive;
            font-size: 42px;
            color: #17202a;
            padding: 0 50px;
            border-bottom: 1px solid #7f8c8d;
        }

        .main-content {
            font-size: 17px;
            color: #2c3e50;
            line-height: 1.8;
            max-width: 850px;
            margin-top: 15px;
        }

        .course-highlight {
            color: #b03a2e;
            font-weight: bold;
            font-size: 19px;
        }

        .footer-section {
            margin-top: auto;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding: 0 40px 40px 40px;
            box-sizing: border-box;
        }

        .sig-block {
            text-align: center;
            width: 220px;
        }

        .sig-img {
            height: 60px;
            margin-bottom: 5px;
            object-fit: contain;
        }

        .sig-line {
            border-top: 1.5px solid #2c3e50;
            padding-top: 5px;
            font-size: 13px;
            font-weight: 700;
            color: #17202a;
            text-transform: uppercase;
        }

        .sig-label {
            font-size: 11px;
            color: #566573;
        }

        @@media print {
            body { background: none; padding: 0; margin: 0; }
            .controls { display: none; }
            .certificate-wrapper { box-shadow: none; padding: 0; }
            .certificate-container { border: 10px solid #2c3e50 !important; -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="controls no-print">
        <button class="btn-action btn-download" onclick="downloadPDF()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download PDF
        </button>
        <button class="btn-action btn-print" onclick="window.print()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Print
        </button>
    </div>

    <div class="certificate-wrapper" id="print-area">
        <div class="certificate-container">
            <div class="border-inner"></div>
            
            <div class="header-section">
                <div class="logo-box">
                    <img src="/Content/assets/img/hcc-img/SJCLOGO.png" alt="SJC Logo">
                </div>
                <div class="college-info">
                    <div class="college-name">St. Joseph's College of Arts and Science (Autonomous)</div>
                    <div class="college-details">
                        Affiliated to Annamalai University, Annamalai Nagar<br>
                        Re-accredited by NAAC with "A" Grade (4th Cycle)<br>
                        Recognised u/s 2(f) & 12(B) of the UGC Act, 1956<br>
                        MANJAKUPPAM, CUDDALORE - 607 001.
                    </div>
                </div>
                <div class="logo-box">
                    <img src="/Content/assets/img/hcc-img/hcclogo.jpg" alt="Secondary Logo">
                </div>
            </div>

            <div class="dept-title">DEPARTMENT OF @ViewBag.Department</div>

            <div class="certify-line">This is to Certify that</div>

            <div class="student-name-box">
                <div class="student-name">@ViewBag.StudentName</div>
            </div>

            <div class="main-content">
                has actively participated in the <span class="course-highlight">"@ViewBag.QuizName"</span> Online Quiz, 
                organized by the Department of @ViewBag.Department, 
                St. Joseph's College of Arts and Science (Autonomous) - Cuddalore 
                held on <strong>@ViewBag.Date</strong>.
            </div>

            <div class="footer-section">
                <div class="sig-block">
                    <div class="sig-img"></div>
                    <div class="sig-line">Dr. Mercy Anthony</div>
                    <div class="sig-label">HEAD OF THE DEPARTMENT</div>
                </div>
                <div class="sig-block">
                    <div class="sig-img"></div>
                    <div class="sig-line">Dr. M. Arumai Selvam</div>
                    <div class="sig-label">PRINCIPAL</div>
                </div>
                <div class="sig-block">
                    <div class="sig-img"></div>
                    <div class="sig-line">Rev. Fr. Dr. M. Swaminathan</div>
                    <div class="sig-label">SECRETARY</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function downloadPDF() {
            const element = document.getElementById('print-area');
            const opt = {
                margin: 0,
                filename: 'Certificate_@ViewBag.StudentName' + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>
