@model CMS.ViewModel.ViewModel.StudentViewModel
@*<div class="col-md-12 col-md-6 hidden" id="logodiv">
    <div class="col-md-3"><img src="~/favicon.ico"/></div>
    </div>*@
<br>
@{

    var liGroupbyClassId = Model.liStudent.GroupBy(u => u.CLASS_ID).ToList();
   
    foreach (var tempcid in liGroupbyClassId)
    {
        var temp = Model.liStudent.Where(x => x.CLASS_ID == tempcid.FirstOrDefault().CLASS_ID).ToList();
        if (temp != null && temp.Count > 0)
        {
            int count = 0;
            <center> <b>@temp.FirstOrDefault().CLASS_NAME</b></center>
            <table class="table table-hover table-bordered" border="1" id="StudentReporttbl">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Roll No</th>
                        <th>Register No</th>
                        <th>Student Name</th>
                        <th>Class</th>
                        <th>Religion</th>
                        <th>Cast</th>
                        <th>Phyiscally Challnged</th>
                        <th>Exservie Man</th>
                        <th>First graduvation</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in temp)
                    {

                        <tr>
                            <td>
                                @{count++;} @count
                            </td>
                            <td>

                                @Html.DisplayFor(modelItem => item.ADMISSION_NO)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.REGISTER_NO)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FIRST_NAME)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CLASS_NAME)
                            </td>
                            <td>

                                @Html.DisplayFor(modelItem => item.RELIGION)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CASTE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SPECIALLY_ABLED)
                            </td>

                            <td></td>
                            <td></td>

                        </tr>
                                    }

                </tbody>

            </table>
                                        }

                                    }

}


<div class="col-md-12 col-md-offset-11">


</div>
