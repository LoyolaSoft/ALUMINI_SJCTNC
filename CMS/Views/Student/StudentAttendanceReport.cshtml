@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "StudentAttendanceReport";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 31;

}
<style>
    .unselectable{
    
     cursor: not-allowed;
}
</style>
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Student Attendance Report</li>
    </ol>
    <h1 class="page-header">Student Attendance Report</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Attendance Report</h4>
        </div>
        <div class="panel-body noPadding">

            @if(Model.liStudentList!=null && Model.liStudentList.Count>0)
            { 
            <div class="form-group">
                <div class="col-md-3">
                    Roll No : <b> @Model.liStudentList.FirstOrDefault().ROLL_NO </b>
                </div>
                <div class="col-md-3">
                    Register No : <b> @Model.liStudentList.FirstOrDefault().REGISTER_NO </b>
                </div>
                <div class="col-md-3">
                    Name : <b>@Model.liStudentList.FirstOrDefault().FIRST_NAME </b>
                </div>
                <div class="col-md-3">
                    Class : <b>@Model.liStudentList.FirstOrDefault().CLASS_NAME </b>
                </div>
              
           
               
            </div> <br /><br />
            }


            <h4>  <label class="label label-success">Attendance Percentage : <b> @ViewBag.Attendancepercentage%</b></label></h4>
            <br>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="LackOfAttendanceList">
                        <thead>
                            <tr>
                                <th>Month/Days</th>
                                @for (int i = 1; i < 32; i++)
                                {
                                    <th>@i</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.liMonths != null)
            {
                foreach (var item in Model.liMonths)
                {
                    var listTemp = Model.liCalendar.Where(s => s.DAY_ORDER_MONTH == item.DAY_ORDER_MONTH).ToList();
                    if (listTemp != null && listTemp.Count > 0)
                    {
                        { count = 31; }
                                        <tr>
                                            <td>@listTemp.FirstOrDefault().DAY_ORDER_MONTH</td>
                                            @foreach (var lst in listTemp)
                                            {
                                                if (lst.IS_HOLIDAY != "1")
                                                {
                                                    if (lst.DAY_ORDER == "")
                                                    {
                                                        <td>-</td>
                                                    }
                                                    else
                                                    {
                                                        if (lst.DAY_TYPE == "0")
                                                        {
                                                        <td><a href="#attendance" data-toggle="modal" onclick="FetchDaywiseAttendance('@lst.DAY_ORDER_DATE')">@lst.DAY</a></td>
                                                        }
                                                        else if (lst.DAY_TYPE == "1")
                                                        {
                                                            <td class="unselectable"><a href="#attendance" data-toggle="modal" class="unselectable"  onclick="FetchDaywiseAttendance('@lst.DAY_ORDER_DATE')">@lst.DAY</a></td>
                                                        }
                                                    }
                                                }
                                                else if (lst.DAY_NAME == "Sunday")
                                                {
                                                    <td>S</td>
                                                }
                                                else
                                                {
                                                    <td>HD</td>
                                                }
                                            }
                                            @{ count = count - listTemp.Count;}
                                            @for (int i = 0; i < count; i++)
                                            {
                                                <td>-</td>
                                            }
                                        </tr>

                                                        }
                                                    }
                                                }
                        </tbody>
                    </table>
                    <div class="col-md-offset-1">
                        <strong class="text-primary">
                            Remarks: &nbsp; &nbsp;S -SUNDAY &nbsp; &nbsp;HD-HOLIDAY&nbsp; &nbsp;
                        </strong>
                    </div>
                </div>

            </div>
    </div>
</div>
<div class="modal" id="attendance">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Day Wise Attendance</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div id="divattendance">

                </div>
            </div>

        </div>

    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .

    }

    $('.selectpicker').selectpicker({
        size: 6
    });

    function FetchDaywiseAttendance(Dayorderdate) {
       
        if (Dayorderdate != null && Dayorderdate != "") {
            $.ajax({
                url: "@Url.Action("BindDaywiseAttendanceReport", "Student")",
                type: "post",
                data: { sDayorderdate: Dayorderdate },
                success: function (data) {
                    $('#divattendance').empty();
                    $('#divattendance').append(data);
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }

            });
        }
    }


</script>
