
@model CMS.ViewModel.ViewModel.StudentViewModel
@{

    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<style>
    .table-bordered td {
        border: none !important;
        border-right: solid 1px #ccc !important;
    }

    page {
        size: A4;
        margin: 11mm 17mm 17mm 17mm;
        width: 21cm;
        height: 29.7cm;
        position: absolute;
        top: 40px;
        left: 30px;
    }

    .noprint {
        display: none !important;
        height: 0px !important;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Pass Certificate</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Pass Certificate</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Pass Certificate</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.Batch, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ApplicationType, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ProgrammeList, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.StudentList, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", multiple = "multiple", data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ResultMonth, "Result Month", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ResultMonth, (Model.ResultMonth != null) ? Model.ResultMonth : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ResultMonth, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <div class="col-md-1 col-md-offset-2 pull-right">
                                <a class="btn btn-primary" id="btnGetIndvidualSemeterMark" title="Click to Get the MarkSheet">Get</a>
                            </div>
                            <div class="col-md-1 col-md-offset-2 pull-right">
                                <a href="javascript:;" id="sPrint" onclick="printDiv('dvIndvidualSemesterMark')" class="btn btn-success m-b-10 pull-right"><i class="fa fa-print m-r-5"></i>Get PDF</a>
                            </div>
                        </div>
                    </div>
                    <div class="row col-md-12">
                        <div id="dvIndvidualSemesterMark">
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script>
    ContentLoad = function () {
        //Ready Function()
    }
    $('.selectpicker').selectpicker({
        size: 4
    });
    $("#ApplicationType").on("change", function () {

        var sApplictionTypeId = $("#ApplicationType").val();
        $.ajax({
            url: "@Url.Action("FetchProgrammeByAppType", "Student")",
            method: "POST",
            datatype: "json",
            data: { sApplictionId: sApplictionTypeId },
            success: function (data) {
                $("#ProgrammeList").empty();
                $("#ProgrammeList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });

    $("#ProgrammeList").on("change", function () {
        var vProgram = $("#ProgrammeList").val();
        var vBatch = $("#Batch").val();
        $.ajax({
            url: "@Url.Action("FetchStudentByProgrammeGroupBatch", "Student")",
            method: "POST",
            datatype: "json",
            data: { sBatch: vBatch, sProgrammeGroupId: vProgram, },
            success: function (data) {
                $("#StudentList").empty();
                $("#StudentList").append('<option value="">-- select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });

    $('#btnGetIndvidualSemeterMark').on("click", function ()
    {
      
        var vResultMonth = $('#ResultMonth').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vStudent = String($('#StudentList').val());
        var sApplicationType = $('#ApplicationType').val();
        if (vResultMonth == '' || vResultMonth == '0' && vAcademicYear == '' || vAcademicYear == '0' && $('#StudentList').val()) {
            alert('Please Choose All the Fields...!!!');
            return false;
        }

            $.ajax({
                url: "@Url.Action("BindPassCertificate", "Student")",
                method: "POST",
                datatype: "json",
                data: { sStudentId: vStudent, sExamSettingId: vResultMonth, sBatch: $('#Batch').val(), sApplicationType: $('#ApplicationType').val() },
                success: function (data)
                {
                    $('#dvIndvidualSemesterMark').empty();
                    $('#dvIndvidualSemesterMark').append(data);
                    $('#completemonth').text($('#ResultMonth option:selected').text());
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            })

    })
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Student/PassCertificateforauxclg');
    }
</script>

