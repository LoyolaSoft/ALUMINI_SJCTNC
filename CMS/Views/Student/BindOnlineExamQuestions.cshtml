<div id="content" class="content">
    <div id="FullScreen_Content_Expand">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" id="panel-expand" class="btn btn-xs btn-icon btn-circle btn-default disabled" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success disabled" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning disabled" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger disabled" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">
                    Online Exam Questions
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

                    Time : &nbsp;&nbsp;&nbsp;<b id="lblQuizTimeRunner" class="blink"> </b>
                </h4>

            </div>
            <div class="panel-body">

                <div class="col-md-12" id="dvOnlineQuizQuestionsEntry">
                       @{
                           if (Model.liOnlineExaminationList != null && Model.liOnlineExaminationList.Count > 0)
                           {

                               // print Question Header ...
                               <div class="col-md-12 form-inline">

                                    <div class="form-group">
                                        <div><b> Roll No :</b> @Model.liOnlineExaminationList.FirstOrDefault().ROLL_NO</div>
                                    </div>
                                    <br />
                                    <div class="form-group">
                                        <div><b> Register No :</b> @Model.liOnlineExaminationList.FirstOrDefault().REGISTER_NO</div>
                                    </div>
                                    <br />
                                    <div class="form-group">
                                        <div><b> Name of the Candidate :  </b> @Model.liOnlineExaminationList.FirstOrDefault().FIRST_NAME</div>
                                    </div>

                                </div>

                                <div class="col-md-12 form-group">
                                    <div class="text-center">
                                        @*<img class="image" />*@
                                        
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
                                    </div>
                                    <div class="text-center">
                                        <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                                        <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                                        <h5>
                                            @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                                            @Model.liOnlineExaminationList.FirstOrDefault().DEGREE DEGREE EXAMINATION MAY @Model.liOnlineExaminationList.FirstOrDefault().ACADEMIC_YEAR <br />
                                            @Model.liOnlineExaminationList.FirstOrDefault().COURSE_CODE - @Model.liOnlineExaminationList.FirstOrDefault().COURSE_TITLE <br />
                                        </h5>
                                        <div class="form-group col-md-6">
                                            <b>[ Time : @Model.sTime Hours  ] </b>
                                        </div>
                                        <div class="form-group col-md-6 ">
                                            <b>Maximum : @Model.liOnlineExaminationList.FirstOrDefault().TOTAL_MARK marks </b>
                                        </div>
                                        <br />
                                        <b>–––––––––––– –––––––––––– –––––––––––– –––––––––––– –––––––––––– –––––––––––– –––––––––––– –––––––––––– –––––––––––– ––––––––––––</b> <br />
                                        <b>
                                            SECTION - A <br />
                                            Answer any @Model.liOnlineExaminationList.FirstOrDefault().QUESTIONS_TO_ATTEN questions. All questions carry equal marks.   (@Model.liOnlineExaminationList.FirstOrDefault().QUESTIONS_TO_ATTEN × @Model.liOnlineExaminationList.FirstOrDefault().EACH_QUESTION_MARKS = @Model.liOnlineExaminationList.FirstOrDefault().TOTAL_MARK) 
                                        </b>
                                    </div>

                                </div>
                               
                                <br /><br />
                                <br />
                                
                                    <!-- Hidden Filed -->
                                    <input type="text" value="@Model.sTime" id="hdQuizTime" class="hidden" />
                                    <input type="text" value="@Model.liOnlineExaminationList.FirstOrDefault().STUDENT_ID" id="hdStudentId" class="hidden" />
                                    <input type="text" value="@Model.liOnlineExaminationList.FirstOrDefault().ACADEMIC_YEAR" id="hdAcademicYear" class="hidden" />
                                    <input type="text" id="hdQuestionId" class="hidden" />
                                    <input type="text" value="@Model.liOnlineExaminationList.FirstOrDefault().CLASS_ID" id="hdClassId" class="hidden" />
                                    <input type="text" value="@Model.liOnlineExaminationList.FirstOrDefault().COURSE_ID" id="hdCourseId" class="hidden" />
                                    <input type="text" value="@Model.liOnlineExaminationList.FirstOrDefault().EXAM_SETTING_ID" id="hdExamSettingId" class="hidden" />
                                    <input type="text" value="@Model.liOnlineExaminationList.FirstOrDefault().SEMESTER_ID" id="hdSemesterId" class="hidden" />
                                    <input type="text"  id="hdExamAnswerId" class="hidden" />
                                    <!-- Hidden Filed -->
                               }
                             }
                    
                    
                </div>

                <div class="col-md-12 form-group" id="dvOnlineQuestions">
                    @if (!string.IsNullOrEmpty(Model.sErrorMessage))
                    {
                        <div> @Model.sErrorMessage</div>
                    }
                    else
                    {
                        if (Model.liOnlineExamQuestions != null && Model.liOnlineExamQuestions.Count > 0)
                        {
                            <div class="col-md-12 form-group">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Question</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            foreach (var item in Model.liOnlineExamQuestions)
                                            {
                                                <tr>
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.QUESTION</td>
                                                    <td>
                                                        <a class="btn btn-primary" href="javascript:;" onclick="BindAnswerPage('@item.EXAM_QUESTIONS_ID','@item.QUESTION');"> Write Answers</a>
                                                    </td>
                                                </tr>
                                             }
                                        }
                                    </tbody>
                                </table>
                            </div>
                         }
                     }

                    <div class="col-md-12 form-inline">
                        <button id="btnSubmit" class="btn btn-primary pull-right" cms-value="1" value="1"> Finish Exam </button>
                    </div>
                </div>

                <div class="col-md-12 form-group hidden" id="dvOnlineAnswers">
                    <div class="col-md-12 form-group pull-right">
                        <a class="btn btn-default" href="javascript:;" onclick="BackToQuestions();">Back</a>
                    </div>
                    <div class="col-md-12 form-group">
                        <label id="lblQuestion"></label>
                        <br />
                        <hr />
                        <div class="col-md-10 form-group">
                            <a href="#Image-dialog" id="btnDraw" data-toggle="modal"  class="btn btn-primary">Draw Image</a>
                            <textarea class="summernote table-bordered" style="width:90%; height:50%" rows="50" id="txtSummorNoteAnswer" name="content"></textarea>
                        </div>
                    </div>
                    <div class="col-md-12 form-group">
                        <a cms-value="1" class="btn btn-primary" onclick="SubmitAnswers();"> Submit </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


