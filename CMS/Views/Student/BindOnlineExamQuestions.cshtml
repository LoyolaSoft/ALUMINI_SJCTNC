<script>
    function ContentLoad()
    {
        $(".summernote").summernote();

        // Document Ready Function ,..
        $('#panel-expand').click();
       // prettyPrint();
        //InitThis();
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');



    }
    //$(document).keydown(function (e) {
    //    return false;

    //});

    //$(document).on("keydown", function (ev) {
    //    console.log(ev.keyCode);
    //    if (ev.keyCode === 27 || ev.keyCode === 122) return false
    //})
  
    function blink_text() {
        $('.blink').fadeOut(500);
        $('.blink').fadeIn(500);
    }
    var refreshTimerId, BlinkTimer;

    function startTimer(duration, display) {
        var timer = duration, hours, minutes, seconds, ManageTime;
        refreshTimerId = setInterval(function () {
            hours = parseInt(timer / 3600, 10);
            minutes = parseInt(timer / 60, 10);
            minutes = parseInt(minutes % 60, 10);
            seconds = parseInt(timer % 60, 10);

            //hours = hours < 10 ? "0" + hours : hours;
            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;
            ManageTime = $('#hdQuizTime').val() - hours;
            if (ManageTime != 0)
            {
                document.getElementById("lblQuizTimeRunner").innerHTML = "0" + hours + " : " + minutes + " : " + seconds + " ";
                if (ManageTime <= 1 && minutes > 30)
                {
                    BlinkTimer = setInterval(blink_text, 1000);
                    //$('#hdQuizTime').addClass('text-danger');
                }
            } else
            {
                alert("Time's Up");
                StopTimer();
                SubmitAnswers();
                $("#btnSubmit").attr('cms-value',2);
                $("#btnSubmit").click();
            }

            if (++timer < 0) {
                timer = duration;
            }
        }, 1000);
    }

    function LoadTimer() {
        var fiveMinutes = 0;
        //fiveMinutes = 60 * 60;
        display = document.querySelector('#hdQuizTime');
        startTimer(fiveMinutes, display);
    };

    function StopTimer() {
        clearInterval(refreshTimerId);
        clearInterval(BlinkTimer);

    };

</script>

<script>
    if ($('#hdQuizCount').val() != 0) {
        StopTimer();
        LoadTimer();
        //$('#liQuizTimeRunner').removeClass('hidden');
    }

    $(function () {
        $(document).keydown(function (e) {
            return  (e.which || e.keyCode) != 122;
        }); 
    });

    // Bind Data When Click Questions ,...
    function BindAnswerPage(Id, Question)
    {
        $('#lblQuestion').text(Question);
        $('#dvOnlineQuestions').addClass('hidden');
        $('#dvOnlineAnswers').removeClass('hidden');
        $('#hdQuestionId').val(Id);

        // Fetch Answers By Question Id ,...
        $.ajax({
            url:'@Url.Action("FetchAnswerByQuestionId", "Student")',
            method:'POST',
            datatype:'json',
            data: { sExamQuestionsId: Id, sStudentId: $('#hdStudentId').val(), sAcademicYear: $('#hdAcademicYear').val() },
            success: function (data)
            {
                $('#txtSummorNoteAnswer').empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#hdExamAnswerId').val(data.ErrorCode);
                    $('#txtSummorNoteAnswer').summernote('code',data.sResult);
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }

    // Back To Questions When Click Back Button ,...
    function BackToQuestions()
    {
        $('#dvOnlineAnswers').addClass('hidden');
        $('#dvOnlineQuestions').removeClass('hidden');
    }

    function SubmitAnswers(elem)
    {

        //if ((document.fullScreenElement !== undefined && document.fullScreenElement === null) || (document.msFullscreenElement !== undefined && document.msFullscreenElement === null) || (document.mozFullScreen !== undefined && !document.mozFullScreen) || (document.webkitIsFullScreen !== undefined && !document.webkitIsFullScreen)) {
        //    // alert(elem);
        //    if (elem.requestFullScreen) {
        //        elem.requestFullScreen();
        //    } else if (elem.mozRequestFullScreen) {
        //        elem.mozRequestFullScreen();
        //    } else if (elem.webkitRequestFullScreen) {
        //        elem.webkitRequestFullScreen(Element.ALLOW_KEYBOARD_INPUT);
        //    } else if (elem.msRequestFullscreen) {
        //        elem.msRequestFullscreen();
        //    }
        //}
        var SummerNote = $('#txtSummorNoteAnswer').summernote('code');
        
        var str = btoa(SummerNote);
        if (str != null && str != '')
        {
            var sJsonData = null;
            sJsonData = '{"EXAM_ANSWER_ID":"' + $('#hdExamAnswerId').val() + '",\
                      "CLASS_ID":"' + $('#hdClassId').val() + '",\
                      "COURSE_ID":"' + $('#hdCourseId').val() + '",\
                      "STUDENT_ID":"' + $('#hdStudentId').val() + '",\
                      "EXAM_SETTING_ID":"' + $('#hdExamSettingId').val() + '",\
                      "QUESTION_ID":"' + $('#hdQuestionId').val() + '",\
                      "ANSWER":"' + str + '",\
                      "SEMESTER_ID":"' + $('#hdSemesterId').val() + '",\
                      "TIME_DURATION":"' + $('#lblQuizTimeRunner').text() + '",\
                      "ACADEMIC_YEAR":"' + $('#hdAcademicYear').val() + '"}';
            $.ajax({
                url: '@Url.Action("SaveOnlineExamAnswers", "Student")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonSaveExamAnswers: sJsonData },
                success: function (data) {
                    alert(data.Message);
                    if (data.ErrorCode != null && data.ErrorCode != '') {
                        $('#hdExamAnswerId').val(data.sResult);
                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
        else
        {
            alert('No Changes Made !');
            return false;
        }
        //alert(SummerNote);
       
    };


    // On Finish Exam / Time's Out Exam ,...
    $('#btnSubmit').on('click', function ()
    {
        $('#panel-expand').click();
        var sJsonData = null;
        sJsonData = '{"CLASS_ID":"' + $('#hdClassId').val() + '",\
                      "COURSE_ID":"' + $('#hdCourseId').val() + '",\
                      "STUDENT_ID":"' + $('#hdStudentId').val() + '",\
                      "EXAM_SETTING_ID":"' + $('#hdExamSettingId').val() + '",\
                      "SEMESTER_ID":"' + $('#hdSemesterId').val() + '",\
                      "TIME_DURATION":"' + $('#lblQuizTimeRunner').text() + '",\
                      "STATUS":"' + $('#btnSubmit').attr('cms-value') + '",\
                      "ACADEMIC_YEAR":"' + $('#hdAcademicYear').val() + '"}';
        $.ajax({
            url:'@Url.Action("SubmitOnlineExam", "Student")',
            method:'POST',
            datatype: 'json',
            data: { sJsonSubmitExam:sJsonData },
            success: function (data)
            {
                alert(data.Message);
                loadContent('/Student/OnlineExamEntry');
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    });
</script>


