@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "ListStudentLeaveApply";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Leave Applied</li>
    </ol>
    <h1 class="page-header">List Leave Applied</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Leave Applied</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#applyleave" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Apply</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblleaveapply">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Roll No</th>
                            <th>Leave type</th>
                            <th>Date</th>
                            <th>Description</th>
                            
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lileaveapply != null && Model.lileaveapply.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lileaveapply)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td>@item.ROLL_NO</td>
                                    <td>@item.LEAVE_TYPE</td>
                                    <td>@item.FROM_DATE to @item.TO_DATE</td>
                                    <td>@item.DESCRIPTION</td>
                                    @if (@item.STATUS_ID == "0")
                                    {
                                        <td><span style="color:blue">@item.STATUS</span></td>
                                    }
                                    else if (@item.STATUS_ID == "1")
                                    {
                                        <td><span style="color:green">@item.STATUS</span></td>
                                    }
                                    else
                                    {
                                        <td><span style="color:red">@item.STATUS</span></td>
                                    }
                                  
                                    @if (@item.STATUS_ID != "0")
                                    {
                                        <td>
                                            Viewd
                                        </td>
                                    }
                                    else
                                    {
                                    <td>         
                                        <a href="#applyleave" onclick="FetchLeaveApplied(@item.LEAVE_APPLY_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>                            
                                        <a href="javascrip:;" onclick="GetConfirm(@item.LEAVE_APPLY_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                    }
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="applyleave">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Apply Leave</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                  <input type="text"   id="leaveapplyid" class="hidden"> 
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Leave Type", htmlAttributes: new { @class = "col-md-4 control-label " })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.LeaveType, (Model.LeaveType != null) ? Model.LeaveType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.LeaveType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">From Date</label>

                                        <div class="col-md-8">
                                            <input type="text" id="fromdate" class="form-control"  data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">To Date</label>

                                        <div class="col-md-8">
                                            <input type="text" id="todate" class="form-control"  data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Description</label>

                                        <div class="col-md-8">
                                            <textarea id="description" class="form-control"  data-parsley-required="true"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }
        $("#fromdate").datepicker({
            todayHighlight: true,
            autoclose: true,
            //  endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $("#todate").datepicker({
            todayHighlight: true,
            autoclose: true,
            //endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

        var tbl = $('#tblleaveapply').DataTable();
        $('#tblleaveapply').DataTable();
        function FetchLeaveApplied(ID)
        {
            if (ID != null)
            {
                $.ajax({
                    url: "@Url.Action("FetchLeaveAppliedById", "Student")",
                    type:"post",
                    data: { sleaveid: ID },
                    success:function(data)
                    {
                           if (data != null)
                           {
                               $('#leaveapplyid').attr('value', data.LEAVE_APPLY_ID);
                               $('#LeaveType').val(data.LEAVE_TYPE_ID);
                               $('#fromdate').attr('value', data.FROM_DATE);
                               $('#todate').attr('value', data.TO_DATE);
                               $('#description').attr('value', data.DESCRIPTION);
                                $('.selectpicker').selectpicker('refresh');
                            }
                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }
        $('#btnSubmit').click(function ()
        {
            var isValid = true;
            var JsonData = null;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid)
            {

                return false;
            }
            JsonData = '{"LEAVE_APPLY_ID":"' + $('#leaveapplyid').val() + '","LEAVE_TYPE_ID":"' + $('#LeaveType').val() + '","FROM_DATE":"' + $('#fromdate').val() + '","TO_DATE":"' + $('#todate').val() + '","DESCRIPTION":"' + $('#description').val() + '"}';
              var req=  $.ajax({
                  url: "@Url.Action("SaveorUpdateStudentLeaveApply", "Student")",
                    type: "post",
                    data: { sJsonData: JsonData },
                    success: function (data)
                    {
                                
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/Student/ListStudentLeaveApply');

                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
              });
        });

    GetConfirm = function (ID)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteAppliedLeave", "Student")",
        type: "post",
        data: { sleaveid: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Student/ListStudentLeaveApply');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }

</script>





