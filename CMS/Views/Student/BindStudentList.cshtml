@model CMS.ViewModel.ViewModel.StudentViewModel
@{ 
    Layout = null;
    int count = 0;
 }
<div class="col-md-12">
<div class="form-group">
    <a class="btn bg-green pull-right" title="Add Student" href="#" onclick="loadContent('@Url.Action("AddStudent","Student")')"><i class="fa fa-plus"></i> Add</a>
</div><br /><br />
<table class="table table-hover table-bordered" id="StudentList">
    <thead>
        <tr>
            <th>S.No</th>
            @*<th>Photo</th>*@
            <th>Roll No</th>
            <th>Register No</th>
            <th>First Name</th>
            <th>Department</th>
            <th>Class</th>
            <th>Shift</th>
            <th>Is Left</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
            @if (Model.liStudentList != null)
            {
                foreach (var item in Model.liStudentList)
                {
                    <tr id="@item.STUDENT_ID">
                        <td>
                            @{count++;} @count
                        </td>
                        @*<td>
                            @if (string.IsNullOrEmpty(item.PHOTO))
                            {

                                <img src="~/Content/assets/img/transparent/e-user.jpg" alt="Image" class="img-thumbnail" />

                            }
                            else
                            {
                                <img src="@item.PHOTO" alt="Image" class="img-thumbnail" />

                            }
                        </td>*@
                        <td>

                            @Html.DisplayFor(modelItem => item.ROLL_NO)
                        </td>
                        <td>

                            @Html.DisplayFor(modelItem => item.REGISTER_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FIRST_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DEPARTMENT)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CLASS_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SHIFT_NAME)
                        </td>

                        <td>@Html.DisplayFor(modelItem => item.IS_LEFT)</td>
                        <td>
                            <a href="#" onclick="loadContent('/Student/EditStudentInfomation/@item.STUDENT_ID')" title="Click To Edit"><i class="fa fa-edit text-primary"></i></a>
                            <a onclick="GetConfirm('@item.STUDENT_ID', '@item.ROLL_NO')" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                        </td>
                    </tr>
                }
            }


        </tbody>
</table>
</div>
