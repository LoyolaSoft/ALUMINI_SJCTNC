@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
}
<div class="col-md-12">
    <br><br>
    <table class="table table-hover table-bordered" id="tblCertificateRequest">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Class</th>
                <th>Register No</th>
                <th>Requested Date</th>
                <th>Certificate</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.licertificateapply != null && Model.licertificateapply.Count > 0)
            {
                int count = 0;
                foreach (var item in Model.licertificateapply)
                {
                    <tr applyid="@item.APPLY_ID" studentid="@item.STUDENT_ID" feemainheadis="@item.FEE_MAINHEAD_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.HEAD</td>
                        
                        
                        <td>
                            <select class="selectpicker form-control status" data-live-search="true" data-parsley-required="true">
                                <option value="">--Select--</option>
                                @foreach (SelectListItem option in Model.Status)
                                {
                                    <option value="@option.Value" examsettingid="@item.STATUS" @(option.Value == item.STATUS ? "selected='selected'" : "")>@option.Text</option>

                                }
                            </select>
                        </td>
                    </tr>
                                }

                            }

        </tbody>
    </table>
</div>
