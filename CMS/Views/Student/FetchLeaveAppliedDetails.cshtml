@model CMS.ViewModel.ViewModel.StudentViewModel
@{ 
    Layout = null;
}
<div class="table-responsive">
    @if (Model.lileaveapply != null && Model.lileaveapply.Count > 0)
    {
      
        @Html.Hidden("leaveapplyid", Model.lileaveapply.FirstOrDefault().LEAVE_APPLY_ID);

        <div class="">
           <center>
               <img src="@Model.lileaveapply.FirstOrDefault().PHOTO" style="height:80px;width:110px">
           </center>
            <br>
            <br>
            <div class="col-md-12">
               
                    <div class="form-group col-md-12">
                    @Html.Label("Roll NO", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                          <label>@Model.lileaveapply.FirstOrDefault().ROLL_NO</label>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                       @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <label>@Model.lileaveapply.FirstOrDefault().CLASS_NAME</label>
                        </div>
                    </div>
                
                
                    <div class="form-group col-md-12">
                        @Html.Label("Name", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <label>@Model.lileaveapply.FirstOrDefault().FIRST_NAME</label>
                        </div>
                    </div>
               
            </div>

            <div class="col-md-12">
                <div class="form-group col-md-12">
                    @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        <div class="alert alert-info">@Model.lileaveapply.FirstOrDefault().DESCRIPTION</div>
                    </div>
                </div>
                <div class="col-md-12 form-group">
                    @Html.Label("Status", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-8">
                        @Html.DropDownListFor(m => m.LeaveStatus, (Model.LeaveStatus != null) ? Model.LeaveStatus : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.LeaveStatus, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            </div>
    }
    else
    {
        <div class="alert alert-info">
            No  Record Found..!
        </div>
    }
</div>