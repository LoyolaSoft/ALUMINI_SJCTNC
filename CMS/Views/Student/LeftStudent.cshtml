@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "LeftStudent";

    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("ADMIN","DashBoard")">Home</a></li>
        <li class="active">Left Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin #page-loader -->
    @*<div id="page-loader" class="fade in"><span class="spinner"></span></div>*@
    <!-- end #page-loader -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Information</h1>
    <!-- end page-header -->
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Left Student List</h3>
        </div>
        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12">
                <div class="form-group col-md-6">
                    @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true",data_actions_box="true",@multiple= "@multiple" })
                        @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                    </div>
                </div>


                @*<div class="col-md-2">
                <button class="btn btn-primary" id="btnget" onclick="BindStudent()">Get</button>
            </div>*@
                <div class="col-md-2">
                    <button class="btn btn-success hidden" style="float:right;" id="btnprint" onclick="printDiv()">Print</button>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-success hidden" style="float:right;" id="btnExport">Export</button>
                </div>
            </div>
            <div class="col-md-12" id="dvBind">

            </div>
        </div>
    </div>


</div>
<div class="modal" id="StudentList-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add  Student Details</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="StudentRejoin">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Year </label>

                                        <div class="col-md-8">

                                            @Html.DropDownListFor(m => m.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true", id = "AcYear" })
                                            @Html.ValidationMessageFor(m => m.AcademicYear, "", new { @class = "text-danger" })

                                            @*<input type="text" id="Gyear" class="form-control" placeholder="Ex:@CurrentYear" data-parsley-required="true" data-parsley-maxlength="50">*@
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Class List </label>

                                        <div class="col-md-8">

                                            @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })

                                            @*<input type="text" id="Gyear" class="form-control" placeholder="Ex:@CurrentYear" data-parsley-required="true" data-parsley-maxlength="50">*@
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Semester </label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.semesterList, (Model.semesterList != null) ? Model.semesterList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(m => m.semesterList, "", new { @class = "text-danger" })

                                            @*<input type="text" id="Gyear" class="form-control" placeholder="Ex:@CurrentYear" data-parsley-required="true" data-parsley-maxlength="50">*@
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Roll No</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtRollNo" onchange="checkRollNoExistOrNot()" class="form-control" placeholder=" Roll No" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Old Roll No</label>

                                        <div class="col-md-8">
                                            <input type="text" id="OldRoll_No" class="form-control" placeholder=" Roll No" data-parsley-required="true" disabled>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Any Remarks</label>

                                        <div class="col-md-8">
                                            <textarea type="text" id="remarks" class="form-control" data-parsley-required="true"></textarea>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="Student_id" value="" />
    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>

    $('.selectpicker').selectpicker({
        size: 4
    });

    function checkRollNoExistOrNot()
    {
        var RollNo = $("#txtRollNo").val();
        var StudentID = $('#Student_id').val();

        if ($("#txtRollNo").val() && $('#Student_id').val())
 {
     $.ajax({
         url: "@Url.Action("CheckRollNoExist", "Student")",
         method: "POST",
         data: { sRollNo: RollNo, sStudentID: StudentID },
         success: function (data)
         {
             if (data.oResult == "Roll No Exist") {
                  swal({ title: "Warning", text: "Given Roll No Already Exist", showConfirmButton: false, timer: 2000, type: 'error', animation: true });

             }
            
         }, error: function (error)
         {
             alert('Try Again!!');
         }
     });
 }


    }

</script>

<script>
    $("#AcademicYear").on('change', function () {
        BindStudent();
    })
    function BindStudent()
    {
        var Academicyear = $("#AcademicYear option:selected").map(function () {
            return $(this).text();
        }).get().join(",");
        if (Academicyear != null && Academicyear != '' )
        {
            $('#loader').show();
            $.ajax({
                url: "@Url.Action("BindLeftStudentInfo", "Student")",
                method: "POST",
                data: { sAcademicyear: Academicyear.toString()},
                success: function (data)
                {
                    $('#loader').hide();
                    var ddl = $('#dvBind');
                    ddl.empty();
                    ddl.append(data);
                    $('#btnprint').removeClass('hidden');
                    $('#btnExport').removeClass('hidden');

                }, error: function (error)
                {
                    alert('Try Again!!');
                }
            });
        }
       
    }

    $("#btnExport").click(function (e) {
        var Academicyear = $("#AcademicYear option:selected").text();
        let file = new Blob([$('#dvBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "Left Student List" + Academicyear+".xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
    function printDiv() {

        var printContents = document.getElementById('dvBind').innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;
        window.print();

        document.body.innerHTML = originalContents;

        BindStudent();
    }
    function FetchstudentDetailsForRejoin(sID) {
    //$('#pBody').parsley().destroy();

        if (sID != null) {
        $.ajax({

             url: '@Url.Action("FetchstudentDetailsForRejoin", "Student")',
            type: "POST",
            datatype: 'json',
            data: { sStudentId: sID },
            success: function (data)
            {
                if (data.Message != null) {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
                else
                {
                    if (data.oResult[0] != null)
                    {
                        $('#OldRoll_No').attr('value', data.oResult[0].ROLL_NO);
                        $('#Student_id').attr('value', data.oResult[0].STUDENT_ID);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }
            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
    }
function SaveData() {

    var isValid = true;
    if ($('#StudentRejoin').parsley().validate() !== true) isValid = false;
    if (!isValid) {

        swal({ title: "Warning", text: "Something went wrong ! Please check your inputs !", showConfirmButton: false, timer: 2000, type: 'error', animation: true });
        return false;
    }
    var DeptFilePath = '';
    var FilePath = '';
    var fCount = 0;
    var iCount = 0;



    var AYear = $("#AcYear option:selected").text();
    var StrudentID = $('#Student_id').val();
    var oldRollNO = $('#OldRoll_No').val();
    var txtRoll = $('#txtRollNo').val();
    var Semester = $('#semesterList').val();
    var classId = $('#ClassList').val();
    var Remarks = $('#remarks').val();

    var sJsonData = '{"STUDENT_ID":"' + StrudentID + '","ROLL_NO":"' + txtRoll + '","OLD_ROLL_NO":"' + oldRollNO + '","ACADEMIC_YEAR":"' + AYear + '","SEMESTER":"' + Semester + '","CLASS_ID":"' + classId + '","REMARKS":"' + Remarks + '"}';


        $.ajax({
            url: '@Url.Action("AddRejoinStudent", "Student")',
            method: 'POST',
            datatype:'json',
            data: { sJsonData: sJsonData },
            success: function (data) {
                if (data.Message != null && data.Message != "") {
                    if (data.ErrorCode == "200")
                    {
                        $('#btnCancel').click();
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                        BindStudent()
                    }
                    if (data.ErrorCode == "417")
                    {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                    if (data.ErrorCode == "503")
                    {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }
                    if (data.ErrorCode == "406")
                    {
                        swal({ title: "Warning", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }

                }


            },
            error: function (error) {
                alert('Internal Server Error !');
                return false;
            }
        });

};
</script>

