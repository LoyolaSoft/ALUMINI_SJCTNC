 @model CMS.ViewModel.ViewModel.StudentViewModel

@{ 
    Layout = null;
}


@if (Model.liAdmissionRegister != null && Model.liAdmissionRegister.Count > 0)
{
    foreach (var item in Model.liAdmissionRegister)
    {
        <div class="col-md-12 form-group"  style="page-break-after:avoid !important;page-break-inside:avoid !important;">
            <div class="row">
                <div class="col-md-2 pull-left">             
                    <img src="~/Content/assets/img/hcc-img/hcclogo.jpg" style="width:150px; height:150px" />
                </div>
                <div class="col-md-10 pull-left text-center">
                    <h3>@Model.liCollgeDetails.FirstOrDefault().COLLEGE_NAME </h3>
                    <h4>College with Potential for Execellence by UGC</h4>
                    <h4>@Model.liCollgeDetails.FirstOrDefault().PLACE .</h4>
                    <h5>
                        ADMISSION REGISTER  @item.ACADEMIC_YEARS<br />
                    </h5>
                </div>
            </div>
            <table class="row table table-bordered" border="1">
                <tbody>
                    <tr>
                        <td></td>
                        <td> Serial No : </td>
                        <td> <b class="pull-right">Admission No : @item.ADMISSION_NO</b> </td>
                    </tr>
                    <tr>
                        <td> 1 .</td>
                        <td> NAME OF THE STUDENT</td>
                        <td>@item.FIRST_NAME</td>
                    </tr>
                    <tr>
                        <td> 2 .</td>
                        <td> NAME OF THE PARENT/GUARDIAN</td>
                        <td> @item.FATHER_NAME</td>
                    </tr>
                    <tr>
                        <td>3.</td>
                        <td> NATIONALITY AND RELIGION</td>
                        <td> @item.NATIONALITY</td>
                    </tr>
                    <tr>
                        <td>4.</td>
                        <td> CASTE AND COMMUNITY</td>
                        <td> @item.CASTE @item.COMMUNITY</td>
                    </tr>
                    <tr>
                        <td>5.</td>
                        <td> SEX</td>
                        <td> @item.GENDER</td>
                    </tr>
                    <tr>
                        <td>6.</td>
                        <td> DATE OF BIRTH (in figure and words)</td>
                        <td> @item.DATE_OF_BIRTH</td>
                    </tr>
                    <tr>
                        <td>7.</td>
                        <td> PERSONAL MARKS OF IDENTIFICATION</td>
                        <td> 
                            @item.IDENTIFICATION_MARK1 <br />
                            @item.IDENTIFICATION_MARK2
                        </td>
                    </tr>
                    <tr>
                        <td>8.</td>
                        <td> DATE ON ADMISSION & CLASS IN WHICH ADMITTED</td>
                        <td> @item.ADMITTED_DATE</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>a) Class on Leaving</td>
                        <td>@item.LEAVING_CLASS</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            b) Courses Offered - MAIN <br />
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            &nbsp;&nbsp;&nbsp;&nbsp;ALLIED
                        </td>
                        <td>
                            @item.MAIN_COURSE <br /> 
                            @item.ALLIED
                        </td>
                    </tr>
                    <tr>
                        <td>9.</td>
                        <td> WHETHER THE STUDENT HAS PAID ALL THE FEES DUE TO THE COLLEGE</td>
                        <td> @item.FEE_PAID</td>
                    </tr>
                    <tr>
                        <td>10.</td>
                        <td> WHETHER THE STUDENT WAS IN RECEIPT OF ANY SCHOLARSHIP</td>
                        <td> @item.SCHOLAR_SHIP</td>
                    </tr>
                    <tr>
                        <td>11.</td>
                        <td> DATE ON WHICH THE STUDENT LEFT THE COLLEGE</td>
                        <td> @item.LEAVING_DATE</td>
                    </tr>
                    <tr>
                        <td>12.</td>
                        <td> THE STUDENT'S CONDUCT AND CHARACTER</td>
                        <td> @item.CONDUCT </td>
                    </tr>
                    <tr>
                        <td>13.</td>
                        <td> DATE ON WHICH APPLICATION FOR TRANSFER CERTIFICATE WAS MADE BY THE STUDENT</td>
                        <td> @item.TC_APPLIED_DATE</td>
                    </tr>
                    <tr>
                        <td>14.</td>
                        <td> DATE OF THE TRANSFER CERTIFICATE</td>
                        <td> @item.TC_GIVEN_DATE</td>
                    </tr>
                    <tr>
                        <td>15.</td>
                        <td> ACADEMIC YEARS</td>
                        <td> @item.ACADEMIC_YEARS</td>
                    </tr>
                    <tr>
                        <td>16.</td>
                        <td> CLASSES STUDIED</td>
                        <td> @item.CLASSES_STUDEIED</td>
                    </tr>
                    <tr>
                        <td>17.</td>
                        <td> FIRST LANGUAGE</td>
                        <td> @item.FIRST_LANGUAGE</td>
                    </tr>
                    <tr>
                        <td>18.</td>
                        <td> MEDIUM OF INSTRUCTION</td>
                        <td> @item.MEDIUM_OF_INSTRUCTION</td>
                    </tr>
                    <tr>
                        <td>19.</td>
                        <td> SCHOOL OR COLLEGE FRON WHICH THE PUPIL HAS COME</td>
                        <td> @item.STUDIED_FROM</td>
                    </tr>
                    <tr>
                        <td>20.</td>
                        <td> CONTACT PHONE NO </td>
                        <td> @item.CONTACT_NO</td>
                    </tr>
                    <tr>
                        <td>21.</td>
                        <td> ADDRESS</td>
                        <td> @item.ADDRESS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}
