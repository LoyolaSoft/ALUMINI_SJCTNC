@* Dropdown & Button Change *@
<script>
    // Bind Course By DepartmentID
    $("#DEPT_ID").on("change", function ()
    {
        var Department = $("#DEPT_ID").val();

        $.ajax({
            url:"@Url.Action("FetchProgrammeByID", "Student")",
            method: "POST",
            datatype: "html",
            data: { Department: Department },
            success:function(data)
            {
                var select = $("#PROGRAM_ID");
                select.empty();
                if (data.sResult != null && data.sResult != '')
                {
                    select.append('<option value="">-- select --</option>' + data.sResult);
                } else {
                    myAlert(data.Message, 'gritter-danger', '');
                }
                $('#PROGRAM_ID').selectpicker('refresh');
            },error:function(error)
            {
                myAlert('Internal Server Error ...!', 'gritter-danger', '');
            }
        });
    });

    // Fetch Class By ShiftID
    $("#SHIFT").on("change", function ()
    {
        var Shift = $("#SHIFT").val();

        $.ajax({
            url:"@Url.Action("FetchClassByID", "Student")",
            method: "POST",
            datatype: "html",
            data: { ShiftID: Shift, sProgramId:$("#PROGRAM_ID").val() },
