<style>
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    #btnImage {
        border: 1px solid gray;
        color: gray;
        background-color: white;
        padding: 7px 15px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }

    .centerAlign {
        display: flex;
        justify-content: center;
    }
    .uppercase {
        text-transform: uppercase;
    }

    .lowercase {
        text-transform: lowercase;
    }
</style>
<style>
    .disabled {
        pointer-events: none;
        opacity: 0.4;
    }
</style>
