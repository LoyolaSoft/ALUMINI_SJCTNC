@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "AssignmentSubmission";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">Assignment Submission </li>
        </ol>
        <h1 class="page-header">Assignment Submission </h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Assignment Submission</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="col-md-offset-3 col-md-6">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @*@Html.HiddenFor(model => model.AssignmentSubmission.ASSIGNMENT_ID)
                                @Html.HiddenFor(model => model.AssignmentSubmission.ASSIGNMENT_NAME)
                                @Html.HiddenFor(model => model.AssignmentSubmission.COURSE_ID)*@

                            <div class="col-md-12 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <br><br>
                            <div class="col-md-12 form-group">
                                @Html.Label("Assignment", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.AssignmentList, (Model.AssignmentList != null) ? Model.AssignmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.AssignmentList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <br><br>
                            @*<div class="form-group">
                                    @Html.LabelFor(model => model.AssignmentSubmission.S_CLASS_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.AssignmentSubmission.S_CLASS_ID, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.AssignmentSubmission.S_CLASS_ID, "", new { @class = "text-danger" })
                                    </div>
                                </div>*@

                            <div class="col-md-12 form-group">
                                @Html.LabelFor(model => model.AssignmentSubmission.FILE_PATH, "Choose File", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    <input class="btn btn-success" type="file" name="files" id="InputFile" onchange="encodefiletoBase64();" />
                                </div>
                            </div>
                            <br><br>
                            <div class="form-group pull-right ">
                                <div class="col-md-12">
                                    <a id="btnSubmit" value="SUBMIT" class="btn btn-primary">Submit</a>
                                    <a id="" @*href="@Url.Action("Student","Dashboard")"*@ href="javascript:;" value="" class="btn btn-danger">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('#CourseList').on('change', function () {
        var courseid = $(this).val();
        $.ajax({
            url: "@Url.Action("FetchAssignmentList", "Student")",
            type: "POST",
            data: { sCourseId: courseid },
            success: function (data) {
                $('#AssignmentList').empty();
                $('#AssignmentList').append(data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (err) {
                alert(err.statusText);
            }
        });
    });

        $('#btnSubmit').click(function ()
        {

            // Checking whether FormData is available in browser
            if ($('#AssignmentList').val() && $('#CourseList').val() )
            {
                var AssignmentId = $('#AssignmentList').val();
                var AssignmentName = $('#AssignmentList').find('option:selected').text();
               
                var fileUpload = $("#InputFile").get(0);
                var files = fileUpload.files;

                // Create FormData object
                var fileData = new FormData();

                // Looping over all files and add it to FormData object
                for (var i = 0; i < files.length; i++) 
                {
                    fileData.append(files[i].name, files[i]);
                }

                // Adding one more key to FormData object
                fileData.append('ASSIGNMENT_ID', AssignmentId);
                fileData.append('ASSIGNMENT_NAME', AssignmentName);

                $.ajax({
                    url: "@Url.Action("SaveAssignmentSubmission", "Student")",
                    type: "POST",
                    contentType: false, // Not to set any content header
                    processData: false, // Not to process data
                    data: fileData,
                    success: function (objResult) {
                        alert(objResult.Message);
                    },
                    error: function (err) {
                        alert(err.statusText);
                    }
                });
            } 
            else
            {
                alert("FormData is not supported.");
            }
        
        });
</script>
