@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "StudentInformationForStaff";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">StudentInformationForStaff</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">StudentInformationForStaff</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">StudentInformationForStaff</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="cpl-md-12">
                        <div class="form-group col-md-5">
                            @Html.LabelFor(model => model.ClassList, "Class List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-5">
                            @Html.LabelFor(model => model.liStudent, "Student List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", })
                                @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                            </div>
                        </div>                     
                        <div class="form-group col-md-2">
                            <a class="btn btn-primary" id="btnGetStudentInfo" title="Click to Get the Student Information">Get</a>
                            @*<a href="javascript:;" id="sPrint" onclick="printDiv('dvIndividualCIAMark')" class="btn btn-success m-b-10 pull-right hidden"><i class="fa fa-print m-r-5"></i>Get PDF</a>*@
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div id="dvBindStudentInformation"></div>
                        <div class="form-group col-md-2">
                            <a class="btn btn-primary" id="save" title="Click to Get the Student Information">Get</a>
                            @*<a href="javascript:;" id="sPrint" onclick="printDiv('dvIndividualCIAMark')" class="btn btn-success m-b-10 pull-right hidden"><i class="fa fa-print m-r-5"></i>Get PDF</a>*@
                        </div>
                    </div>
                </div>                
            }
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad() {
            handleDatepicker = function () {
                "use strict";
                $("#dob").datepicker({
                    todayHighlight: true,
                    autoclose: true,
                    endDate: new Date(),
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                }
                )
            }
            handleDatepicker();
        }
        $('.selectpicker').selectpicker({
            size: 4
        });

    //ClassOnChange
        $("#btnGetStudentInfo").on("click", function () {
            var sStudentId = $('#StudentList').val();
            if (sStudentId == '' || sStudentId == '0' || sStudentId == null) {
                alert('Please Choose Student...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("BindStudentInformationForStaff", "Student")",
                method: "POST",
            datatype: "json",
            data: { sStudentId: $('#StudentList').val() },
            success: function (data) {               
                $("#dvBindStudentInformation").empty();
                $("#dvBindStudentInformation").append(data);
                $('.selectpicker').selectpicker('refresh');               
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
        });
    $("#save").on("click", function () {
        alert($("#FIRST_NAME").val());
    });
    $("#ClassList").on("change", function () {
        var sClass = $('#ClassList').val();
        if (sClass == '' || sClass == '0' || sClass == null) {
            alert('Please Choose Class...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindStudentByClassId", "Student")",
            method: "POST",
        datatype: "json",
        data: { sClassId: $('#ClassList').val()},
        success: function (data) {
            $("#StudentList").empty();
            $("#StudentList").append(data);
            $('.selectpicker').selectpicker('refresh');
            $('#btnGetIndvidualCIAMark').removeClass("disabled");
        }, error: function (error) {
            alert('Internal Server Error !');
        }
    });
    });
</script>