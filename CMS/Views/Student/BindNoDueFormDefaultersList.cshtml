
@model CMS.ViewModel.ViewModel.StudentViewModel


<div class="form-group table-responsive">
    @{ int count = 0;}
    <table class="table table-hover table-bordered" id="tblMalpracticeList">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Reason</th>
                <th>Date</th>
                <th>Active</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liNodueDefaulters != null)
            {
                foreach (var item in Model.liNodueDefaulters)
                {
                    <tr id="@item.STUDENT_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.REASON</td>
                        <td>@item.ENTRY_DATE</td>
                        <td> 
                            @if (item.IS_ACTIVE == "1")
                            {
                                <a href="javascrip:;" onclick="SetDeActive(@item.STU_NODUE_DEFALTER_ID)" class="text-success"><i class="fa fa-unlock text-green"></i></a>
                            }
                            else
                            {
                                <a href="javascrip:;" onclick="SetActive(@item.STU_NODUE_DEFALTER_ID)" class="text-danger"><i class="fa fa-lock text-danger"></i></a>
                            }
                        </td>

                        <td>
                            <a href="#malpratice-dialog" data-toggle="modal" onclick="FetchMalpracticeById(@item.STU_NODUE_DEFALTER_ID);"><i class="fa fa-edit" title="Click To Update"></i></a>
                            <a href="#" onclick="GetConfirm(@item.STU_NODUE_DEFALTER_ID);"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>


