@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "SeepHallTicket";
    Layout = null;
    string currentDate = DateTime.Now.ToString("dd/MM/yyyy hh:mm tt", System.Globalization.CultureInfo.InvariantCulture);
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<style>
    html, body, table, tr, td, th, div, span, h1, h2, h3, h4, h5, h6, p, a, button {
        font-family: 'Times New Roman', Times, Georgia, serif !important;
    }

    html, body {
        height: 100%; /* Ensure the body fills the entire height */
        margin: 0;
    }

    .SignDiv {
        position: absolute;
        bottom: 186px;
        width: 730px;
        box-sizing: border-box;
        border-top: 2px solid black;
        padding-top: 15px;
    }

    .alignSpaceBetween {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    table {
        width: 100%;
    }

    td {
        padding: 1px;
    }

    th {
        padding: 8px
    }

    .RollNumberPart {
        margin-top: 10px;
        margin-bottom: 5px;
    }

        .RollNumberPart table {
            width: 100%; /* Stretch the table to the available space */
            border-collapse: collapse;
            table-layout: fixed; /* Uniform cell sizes */
        }

        .RollNumberPart td {
            vertical-align: middle;
        }

        .RollNumberPart img {
            display: block;
            max-height: 90px;
            margin: auto;
        }

    .instructionDiv {
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("STUDENT","DashBoard")">Home</a></li>
        <li><a href="@Url.Action("","Student")">Exam Hall Ticket</a></li>
        <li class="active">Exam Hall Ticket</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam Hall Ticket</h1>
    <!-- end page-header -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam Hall Ticket</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="pull-right">
                        <div class="col-sm-6 col-md-2">
                            <button class="btn btn-primary btnPrint" onclick="printDiv('dvBindHallTicket')"> Print </button>
                        </div>
                    </div>
                    <br />
                    <hr />
                    <div class="col-md-12 table-responsive">
                        <div id="dvBindHallTicket">

                            @if (Model.lihallticketValidation == null)
                            {
                                if (Model.liFetchExamHallTicket != null)
                                {
                                    var roll_code = Model.liFetchExamHallTicket.FirstOrDefault().ROLL_NO;
                                    var name = Model.liFetchExamHallTicket.FirstOrDefault().FIRST_NAME;
                                    string SecretCode = roll_code.Substring(0, 3) + roll_code.Substring(roll_code.Length - 2);
                                    name = name.Substring(0, 2);
                                    SecretCode = SecretCode.Substring(3, 2) + name + SecretCode.Substring(0, 3);

                                    var photoUrl = "";
                                    var firstItem = Model.liFetchExamHallTicket.FirstOrDefault();
                                    if (firstItem != null)
                                    {
                                        if (string.IsNullOrEmpty(firstItem.PHOTO))
                                        {
                                            photoUrl = Url.Content("~/Content/assets/img/transparent/e-user.jpg");
                                        }
                                        else
                                        {
                                            photoUrl = Url.Content(firstItem.PHOTO);
                                        }
                                    }

                                    <div style="height: 1130PX !important; width: 815px !important; page-break-after: always !important;">
                                        <div style=" background: url('@Url.Content("~/Content/hcc_img/ExamHallTicket.png")') no-repeat !important; background-size: cover;">
                                            <div style="display: flex; justify-content: end; align-items: center;  padding-right: 70px; padding-top: 14px;">
                                                <span style="font-size: 7px;">
                                                    <b>Printed on : @currentDate </b>
                                                </span>
                                                <span style="font-size: 6px;padding-left:3px"><b>@SecretCode</b></span>
                                            </div>
                                            <div style="height:1160px;margin-left: 45px; padding-right: 40Px ">

                                                @if (Model.liCollegeDetails != null)
                                                {
                                                    <div class="col-md-12 text-center clgInfoDiv" style="padding-top: 20px !important; padding-bottom: 10px; ">
                                                        <table>
                                                            <tr>
                                                                <td colspan="2" style=" text-align: center; font-size: 15px;"><b>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME :: CUDDALORE - 1</b></td>
                                                            </tr>
                                                            <tr>
                                                                <td rowspan="5">
                                                                    <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="height: 70px" />
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="text-align: center;">(@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY)</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="text-align: center;">Recognised under section 2(f) & 12(B) of the UGC Act,1956</td>
                                                            </tr>
                                                            <tr>
                                                                <td style="text-align: center;">@Model.liCollegeDetails.FirstOrDefault().GRADE</td>
                                                            </tr>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                }
                                                <div>
                                                    <h4 style="text-transform: uppercase; text-align: center; font-size: 18px"><b> @Model.liFetchExamHallTicket.FirstOrDefault().EXAM_NAME EXAMINATION HALL TICKET</b></h4>
                                                </div>
                                                <div class="RollNumberPart" style="font-size: 11px;">
                                                    <table>
                                                        <tr style="text-transform: uppercase !important;">
                                                            <td><b>Roll Number</b></td>
                                                            <td>: <b>@Model.liFetchExamHallTicket.FirstOrDefault().ROLL_NO</b></td>
                                                            <td><b>Register No</b></td>
                                                            <td>
                                                                : <b>@Model.liFetchExamHallTicket.FirstOrDefault().REGISTER_NO</b>
                                                            </td>
                                                            <td rowspan="3">
                                                                <img src="@photoUrl" onerror="this.onerror=null;this.src='@Url.Content("~/Content/assets/img/transparent/e-user.jpg")';" style="height: 90px;" />
                                                            </td>
                                                        </tr>
                                                        <tr style="text-transform: uppercase !important;">
                                                            <td><b>Student Name</b></td>
                                                            <td>: @Model.liFetchExamHallTicket.FirstOrDefault().FIRST_NAME</td>
                                                            <td><b>UMIS No</b></td>
                                                            <td>: @Model.liFetchExamHallTicket.FirstOrDefault().UMIS_NO</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-transform: uppercase !important;"><b>Course Name</b></td>
                                                            <td>: @Model.liFetchExamHallTicket.FirstOrDefault().CLASS_NAME</td>
                                                            <td style="text-transform: uppercase !important;"><b>Date of Birth</b></td>
                                                            <td>: @Model.liFetchExamHallTicket.FirstOrDefault().DATE_OF_BIRTH</td>
                                                        </tr>
                                                    </table>
                                                </div>
                                                <div class="margin-top:10px">
                                                    <table>
                                                        <thead style="border-top: 2px solid black; border-bottom: 2px solid black; text-transform: uppercase;">
                                                            <tr>
                                                                <th><b>Subject Code </b></th>
                                                                <th><b>Date of Exam</b></th>
                                                                <th><b>Hall Name</b></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody style="font-size: 12px;">
                                                            @foreach (var item in Model.liFetchExamHallTicket)
                                                            {
                                                                <tr>
                                                                    <td style="text-transform: uppercase;">@item.COURSE_CODE</td>
                                                                    <td>@item.DATE_OF_EXAM - @item.SESSION_NAME</td>
                                                                    <td>@item.HALL_NAME</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="SignDiv">
                                                    <table>
                                                        <tr>
                                                            <td rowspan="4"><img src="@Model.QRCodeData" style="height: 90px;" /></td>
                                                        </tr>
                                                        <tr>
                                                            <td></td>
                                                            <td style=" text-align: center;">
                                                                <img src="@Url.Content("~/Content/hcc_img/sign/SJC_PRINCIPAL_Singn_RBG.png")" />
                                                            </td>
                                                            <td style=" text-align: center;">
                                                                <img src="@Url.Content("~/Content/hcc_img/sign/SJC_COE_SIGN.png")" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td><b>Signature of the Candidate</b></td>
                                                            <td style=" text-align: center; font-size: 14px"><b>(Dr. M. Arumaiselvam)</b></td>
                                                            <td style="text-align: center; font-size: 14px">
                                                                <b> (Dr. M. Vanathaian)</b>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:14px"><b>DATE: @Model.liFetchExamHallTicket.FirstOrDefault().HALL_TICKET_PUBLICATION_DATE</b></td>
                                                            <td style="font-size: 14px; text-align: center;"><b>PRINCIPAL</b></td>
                                                            <td style="font-size: 14px; text-align: center;"><b>CONTOLLER OF EXAMINATIONS</b></td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="container instructionDiv">
                                        <br />
                                        <div class="instructionInsideDiv">
                                            <h3 class="text-center">INSTRUCTION</h3><br />
                                            <div>1. Mobile phones / Electronic gadgets are prohibited inside the examination hall.</div><br />
                                            <div>2. Possession of electronic gadgets / Misbehavior will be booked under malpratice act and the device will be confiscated for evidence.</div><br />
                                            <div>3. Management will not be responsible for the safety of electronic gadgets kept outside the examination hall.</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <h3 class="bg-warning text-center" style=" padding: 10px;">Examination Hall Ticket will be coming soon. If there is any issue, please meet the COE.</h3>
                                    </div>
                                }
                            }
                            else
                            {
                                <div>
                                    <h3 class="bg-warning text-center" style=" padding: 10px;">Your hall ticket is not available due to a<b> @Model.lihallticketValidation.FirstOrDefault().REASON</b></h3>
                                </div>
                            }




                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>

<script>
    function printDiv(divId) {
        var content = document.getElementById(divId).innerHTML;
        var printWindow = window.open('', '', 'height=600,width=800');
        printWindow.document.write('<html><head><title>Examination Hall Ticket</title>');
        printWindow.document.write('<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">');
        printWindow.document.write('<style>');

        printWindow.document.write(`
                                                                    @@media print {
                                                                        * {
                                                                -webkit-print-color-adjust: exact;
                                                                print-color-adjust: exact;
                                                              }
                                                                        body, table, tr, td, th, div, span, h1, h2, h3, h4, h5, h6, p, a, button {
                                                                            font-family: 'Times New Roman', Times, Georgia, serif !important;
                                                                        }
                                                                        body {
                                                                            margin: 0;
                                                                            padding: 0;

                                                                        }
                                                            .notEligibleDiv{
                                                                color:#ff0101 !important;
                                                            }
                                                            .instructionDiv{
                                                                Height:1180px !important;
                                                                    font-size: 20px;

                                                                        text-align: justify;
                                                            }
                                                            .instructionInsideDiv{
                                                                margin-left: 50px !important;
                                                                margin-right: 50px !important ;
                                                            }

.SignDiv {
                                                                position: absolute;
                                                                bottom: 50px; /* Align at the bottom of the page */
                                                                width: 730px;
                                                                box-sizing: border-box;
                                                                border-top: 2px solid black; /* Optional */
                                                                padding-top: 5px;
}

                                                                .SignDiv > div {
                                                                    text-align: center;
                                                                }
                                                                 .clgInfoDiv{

                                                             text-align: center !important;
                                                             }
.alignSpaceBetween{
                                                                display:flex;
                                                                justify-content:space-between;
                                                                align-items:flex-start;

}
.RollNumberPart {
                                            margin-top: 10px;
                                            margin-bottom: 5px;
                                            }
                                                         .instructionDiv {
                                                              display: flex;
                                                              justify-content: center;
                                                              align-items: center;
                                                          }
                                                                        .container {
                                                                            width: 100%;

                                                                        }
                                                                        table {
                                                                            width: 100%;

                                                                        }
                                                                        td {

                                                                            padding: 1px;
                                                                        }
                                                                         th{
                                                                              padding: 8px;
                                                                         }
                                                                        @@page {
                                                                            size: A4;
                                                                            margin: 1mm;
                                                                        }
                                                                    }
                                                                `);

        printWindow.document.write('</style></head><body>');
        printWindow.document.write('<div class="">');
        printWindow.document.write(content);
        printWindow.document.write('</div>');
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        printWindow.print();
        document.body.innerHTML = document.body.innerHTML
        loadGird();
    }
</script>
