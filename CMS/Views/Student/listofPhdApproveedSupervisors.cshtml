                extend: "pdf", className: "btn-sm"
            }
            ], responsive: !0, "paging": true, "ordering": true
        });
    });
    function FetchstuPlacementById(sPlacement) {
        //$('#pBody').parsley().destroy();

        if (sPlacement != null) {
            $.ajax({

                 url: '@Url.Action("FetchPhdSupervisorsInfoById", "Student")',
                type: "POST",
                datatype: 'json',
                data: { sId: sPlacement },
                success: function (data)
                {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    else
                    {
                        if (data.oResult[0] != null)
                        {
                           

                            $('#StaffList').attr('value', data.oResult[0].STAFF_ID);
                            $('#liphdDepartment').attr('value', data.oResult[0].PHD_DEPARTMENT);
                            $('#Position').attr('value', data.oResult[0].POSITION);
                            $('#Reference').attr('value', data.oResult[0].REFERENCE_ID);
                            $('#Email').attr('value', data.oResult[0].EMAIL);
                            $('#Contact').attr('value', data.oResult[0].CONTACT_NO);
                            $('#Strength').attr('value', data.oResult[0].APPROVED_STRENGTH);
                            $('#Completed').attr('value', data.oResult[0].COMPLETED);
                            $('#Inprogress').attr('value', data.oResult[0].IN_PROGRESS);
                            $('#Vacancies').attr('value', data.oResult[0].VACANCIES_AVAILABLE);
                            $('#supervisorsID').attr('value', data.oResult[0].SUPERVISOR_ID);
                            $('#img').attr("src", data.oResult[0].IMG_PATH);

                            //BindFileInfo(data.oResult[0].FILE_PATH, 'tbActivityUpload', 'dvActivityUpload');
                            //BindImageInfo(data.oResult[0].IMG_PATH, 'tbimageUpload', 'dvImageUpload');
                           /* $('#img').attr('src', data.IMG_PATH);*/
                            $('.selectpicker').selectpicker('refresh');

                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
