@model CMS.ViewModel.ViewModel.StudentViewModel

<div style="page-break-after:always !important;page-break-inside:avoid !important;">
    <br /><br /><br /><br /><br /><br /><br /><br /><br /> <br />
    @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
    {
        <div class="col-md-12">
            <table align="center" width="98%">
                <tr>
                    <td style="width:50%"><b>Name</b> : &nbsp;@Model.liStudentList.FirstOrDefault().FIRST_NAME</td>
                    <td style="width:50%" align="right"><b>Register No</b> : &nbsp;@Model.liStudentList.FirstOrDefault().REGISTER_NO</td>
                </tr>
                <tr>
                    <td style="width:60%"><b>Degree & Major</b> : &nbsp;@Model.liStudentList.FirstOrDefault().PROGRAMME_NAME </td>
                    <td style="width:40%" align="right"><b>Roll No</b> : &nbsp;@Model.liStudentList.FirstOrDefault().ROLL_NO</td>
                </tr>
                <tr>
                    <td style="width:50%"></td>
                    <td style="width:50%" align="right"><b>Month & Year</b> : &nbsp;11/12/2018</td>
                </tr>
            </table>
        </div>
    }
    <br />
    <div class="col-md-12">
        <table align="center" style="width:98%; border:1px solid;">
            <thead>
                <tr>
                    <th style="border:1px solid;width:5% !important;padding-left:3px;" align="left">Sem</th>
                    <th style="border:1px solid;width:15% !important;padding-left:3px;" align="left">Course Code</th>
                    <th style="border:1px solid;width:37% !important;padding-left:3px;" align="left">Course Title</th>
                    <th style="width:5% !important;border:1px solid ;padding-left:3px;" align="left">Max.</th>
                    <th style="width:5% !important;border:1px solid ;padding-left:3px;" align="left">Sec.</th>
                    <th style="width:5% !important;border:1px solid ;padding-left:3px;" align="left">Credit</th>
                    <th style="width:5% !important;border:1px solid ;padding-left:3px;" align="left">Grade Point</th>
                    <th style="width:5% !important;border:1px solid ;padding-left:3px;" align="left">Grade</th>
                    <th style="width:8% !important;border:1px solid ;padding-left:3px;" align="left">Passed Month</th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var items in Model.liSemestermark)
                    {
                        <tr>
                            <td style="width:5% !important; padding-left:3px;  border-right:1px solid ;" align="left">@items.SEMESTER_NAME</td>
                            <td style="width:15% !important;padding-left:3px;  border-right:1px solid ;" align="left">@items.COURSE_CODE</td>
                            <td style="width:37% !important;padding-left:3px;  border-right:1px solid ;" align="left">@items.COURSE_TITLE</td>
                            <td style="width:5% !important; padding-left:3px;  border-right:1px solid ;" align="left">@items.MAXIMUM</td>
                            <td style="width:5% !important; padding-left:3px;  border-right:1px solid ;" align="left">@items.TOTAL</td>
                            <td style="width:5% !important; padding-left:3px;  border-right:1px solid ;" align="left">@items.CREDIT</td>
                            <td style="width:3% !important; padding-left:3px;  border-right:1px solid ;" align="left">@items.GRADE_POINT</td>
                            <td style="width:3% !important; padding-left:3px;  border-right:1px solid ;align-content:flex-start;">@items.GRADE</td>
                            <td style="width:8% !important; padding-left:3px;  border-right:1px solid ;align-content:flex-start;">@items.M_PASS</td>
                        </tr>
                    }
                }
            </tbody>
            <thead>
                <tr style="border:1px solid; padding:5px;">
                    <th colspan="5" style="border:1px solid; padding-left:5px;"><b>Total</b></th>
                    <th style="border:1px solid; padding:5px;">45</th>
                    <th style="border:1px solid; padding-left:5px;"></th>
                    <th style="border:1px solid; padding-left:5px;"></th>
                    <th style="border:1px solid; padding-left:5px;"></th>
                </tr>
            </thead>
        </table>
    </div>
    <br />
    <div class="col-md-12">
        <div class="col-md-6" style="table-layout: fixed;">
            <table class="table-condensed" align="left" style="width:30%;">
                <caption>Cumulative</caption>
                <thead>
                    <tr>
                        <th>WAM</th>
                        <th>GPA</th>
                        <th>GRADE</th>
                        <th>CR</th>
                    </tr>
                </thead>

                <tr>
                    <td>dd</td>
                    <td>dd</td>
                    <td>dd</td>
                    <td>dd</td>
                </tr>

            </table>
        </div>
        <div class="col-md-5" style="table-layout: fixed;">
            <table class="table-condensed" align="right" style="width:30%;">
                <caption></caption>
                <thead>
                    <tr>
                        <th>Total Marks</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1212/4545</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>