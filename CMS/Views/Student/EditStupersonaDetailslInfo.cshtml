<script>
    $(document).ready(function () {
        $('#txttTName').on('keydown', function (event) {
            if (event.which == 121) {
                $(this).toggleClass('tamil');
                return false;
            }
            if ($(this).hasClass('tamil')) {
                toggleKBMode(event);
            } else {
                return true;
            }
        });
        $('#txttTName').on('keypress', function (event) {
            if ($(this).hasClass('tamil')) {
                convertThis(event);
            }
        });
    });

    function showtAlert() {
        var spanElement = document.getElementById('nametamilspan');
        if (spanElement.classList.contains('hidden')) {
            spanElement.classList.remove('hidden');
        } else {
            spanElement.classList.add('hidden');
        }
    }
    $(document).ready(function () {
        $('.complusary').each(function () {
            // Append the asterisk only if it's not already present
            if (!$(this).find('.asterisk').length) {
                $(this).append('<span class="asterisk" style="color: red; margin-left: 5px;">*</span>');
            }
        });
    });
    $(document).ready(function () {
        $('input[type="text"], textarea').on('input', function () {
            this.value = this.value.toUpperCase();
        });
    });
</script>
