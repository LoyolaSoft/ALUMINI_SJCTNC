
@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "CommunityBasedReligionCount";

    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("ADMIN","DashBoard")">Home</a></li>
        <li class="active">Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin #page-loader -->
    @*<div id="page-loader" class="fade in"><span class="spinner"></span></div>*@
    <!-- end #page-loader -->
    <!-- begin page-header -->
    <h1 class="page-header">Data Statistics</h1>
    <!-- end page-header -->
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Data Statistics</h3>
        </div>
        <div class="panel-body">

            <div class="col-md-12">
                <div class="form-group col-md-4">
                    @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-4">
                    @Html.Label("Application Type", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-4">
                    @Html.Label("Year", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple" })
                        @Html.ValidationMessageFor(model => model.ClassYear, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-4">
                    @Html.LabelFor(model => model.ProgrammeList, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple" })
                        @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-4">
                    @Html.LabelFor(model => model.Fields, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.Fields, (Model.Fields != null) ? Model.Fields : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.Fields, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-4">
                    <input type="checkbox" id="includeleft" />
                    <label class="control-label">Include left</label>
                    <br />
                    <input type="checkbox" id="emptyfields" class="hidden" />
                    <label class="control-label hidden">Omit Empty Fields</label>

                </div>


                <div class="col-md-2">
                    <button class="btn btn-primary" id="btnget" onclick="BindStudent()">Get</button>
                </div>
                <div class="form-group col-md-1">
                    <a href="#" class="btn btn-success" id="btnPrint" onclick="printDiv('printtable')">Print</a>
                </div>

            </div>
            <div class="col-md-12" id="dvBind">

            </div>
        </div>
    </div>


</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>

    $('.selectpicker').selectpicker({
        size: 4
    });
    $('#studentlist').DataTable({});
    $('#ApplicationType').on('change', function ()
    {
        var Apptype = $('#ApplicationType').val();
        if(Apptype!=null && Apptype!='')
          {
            $.ajax({
            url: "@Url.Action("FetchProgrammesByAppType", "Student")",
            method: "POST",
            data: { sApptypeId: Apptype },
            success: function (JsonData)
            {
                    var dd = JSON.parse(JsonData);
                    var ddl = $('#ProgrammeList');
                    ddl.empty();
                    ddl.append(dd.ALICE_NAME);
                    /*$('#Fields').empty();
                    $('#Fields').append(dd.FIELD_ID);*/
                    $('.selectpicker').selectpicker('refresh');
            }, error: function (error)
        {
            alert('Error Occured Please Try Again!!');
        }
      });
        }
        else
        {
            alert('Please Choose the Option..!');
        }
    });

</script>

<script>
    function BindStudent()
    {
        var Academicyear = $("#AcademicYear option:selected").text();
        var programme = $('#ProgrammeList').val();
        var classlevel = $('#ApplicationType').val();
        var classyear = $('#ClassYear').val();
        var fields = $('#Fields').val();
        var selectedName = $('#Fields option:selected').text();
        console.log(selectedName);
        var includeleft = $('#includeleft').is(':checked') ? 1 : 0;
        var emptyfields = $('#emptyfields').is(':checked') ? 1 : 0;
        $('#page-loader').removeClass('fade in hide');
        $('#page-loader').addClass('fade in ');
        if (programme != null && programme != '' )
        {
            $.ajax({
                url: "@Url.Action("BindCommunityBasedReligionCount", "Student")",
                method: "POST",
                data: { sAcademicyear: Academicyear.toString(), sProgramme: programme.toString(), sClassyear: classyear.toString(), sincludeleft: includeleft.toString(), sfields: fields.toString(), sclasslevel: classlevel.toString(), semptyfields: emptyfields.toString(), sfieldname: selectedName.toString() },
                success: function (data)
                {
                    $('#page-loader').removeClass('fade in ');
                    $('#page-loader').addClass('fade in hide');
                    var ddl = $('#dvBind');
                    ddl.empty();
                    ddl.append(data);
                    $("#studentlist").DataTable({
                        paging: false,
                        ordering: false,
                        searching: false,
                        info: false,
                        lengthChange: false,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm"
                            },
                            {
                                extend: "excel",
                                className: "btn-sm"
                            },
                            {
                                extend: "pdf",
                                className: "btn-sm"
                            }
                        ],
                        responsive: true
                    });




                }, error: function (error)
                {
                    $('#page-loader').removeClass('fade in ');
                    $('#page-loader').addClass('fade in hide');
                    alert('An Error Occured Please Try Again!!');
                }
            });
        }
        else
        {
            alert('Please Select the Options..!');
        }
    }
    function printDiv(printtable) {
        var printContents = document.getElementById(printtable).innerHTML;
        var myWindow = window.open('', '', 'width=900,height=600');

        // Write the contents to the new window
        myWindow.document.write('<html><head><title>Print</title>');

        // Inject custom CSS for better print formatting
        myWindow.document.write('<style>');
        myWindow.document.write(`
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border: 1px solid black;
            padding: 8px;
            text-align: center;
        }
        th {
            background-color: #f2f2f2;
        }
        td {
            font-size: 14px;
        }
        /* Additional styles for hiding non-essential elements */
        .dt-buttons, .btn-group {
            display: none !important;
        }
    `);
        myWindow.document.write('</style>');

        myWindow.document.write('</head><body>');
        myWindow.document.write(printContents);
        myWindow.document.write('</body></html>');

        // Close the document and focus the window
        myWindow.document.close();
        myWindow.focus();

        // Trigger the print
        myWindow.print();
    }

</script>

