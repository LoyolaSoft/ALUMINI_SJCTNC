@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "StudentUMISNOUpdation";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">UMIS No Updation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">UMIS No Updation</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">UMIS No Updation</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group col-md-4">
                                @Html.LabelFor(model => model.BatchList, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.BatchList, (Model.BatchList != null) ? Model.BatchList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.BatchList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true " })
                                    @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3 hidden exportbuttonDiv">

                                <input class="pull-left fileinput-button btn btn-info" type="file" />
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-2 hidden exportbuttonDiv">
                                    <div class="pull-right"> <a class="btn btn-primary savedata"> Save</a></div>
                                </div>

                                <div class="row pull-right col-md-2 hidden exportbuttonDiv">
                                    <div class="col-md-6 btnPrintDiv">
                                        <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                                    </div>
                                    @*<div class="col-md-6 btnExcelDiv">
                                            <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                                        </div>*@
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                        </div>

                    </div>
                </div>
            }

            <div id="dvbinddata">

            </div>

        </div>
    </div>
    <!-- end panel -->
</div>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>

    // Store original values when page loads

        $('.selectpicker').selectpicker({
            size: 4
        });

    $("#BatchList").on("change", function () {
        fetchdataback();
    });
    $("#ClassList").on("change", function () {
        fetchdataback();
    });

    function fetchdataback() {
        $('#page-loader').addClass('hide fade in');
        $('#page-loader').removeClass('hide');
        var Batch = $("#BatchList option:selected").text();
        var Class = String($("#ClassList").val());

        if (Batch != "--select--" && Batch != " " && Class != "" && Class != "--select--" && Class != "null") {
            $.ajax({
                url: "@Url.Action("BindStudentUMISNo", "Student")",
                method: "POST",
                datatype: "json",
                data: { sBatch: Batch, sClass: Class },
                success: function (data) {
                    $('#page-loader').removeClass('hide fade in');
                    $('.exportbuttonDiv').removeClass('hidden');
                    $('#page-loader').addClass('hide');
                    $('#dvbinddata').empty();
                    $('#dvbinddata').append(data);
                    $("#tableforupdation").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "excel",
                            className: "btn-sm btn-danger",
                            text: "Excel Template",
                            title: "UMIS Excel Template"  // This changes the tooltip text
                        }
                        ], "paging": false,
                    });
                }, error: function (error) {
                    $('#page-loader').removeClass('hide fade in');
                    $('#page-loader').addClass('hide');
                    alert('Internal Server Error !');
                }
            });
        }
        else {
            $('#page-loader').removeClass('hide fade in');
            $('#page-loader').addClass('hide');

        }

    };

    function printDiv() {
        var table = $('#tableforupdation').DataTable();
        table.destroy();
        var printContents = document.getElementById('dvbinddata').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;

        loadContent('/Student/StudentUMISNOUpdation');
    }
    function Export() {
        var title = "UMISNoExcelFile";
        var table = $('#tableforupdation').DataTable();
        table.destroy();
        let file = new Blob([$('#dvbinddata').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        table = $("#tableforupdation").DataTable({ "bPaginate": true });//{ "bPaginate": false }
        $("#tableforupdation_filter").addClass("dataTables_filter pull-right");
        $(".pagination").addClass("pagination pull-right");
    }
    function Export() {
        // Create a clone of the table
        var $tableClone = $('#tableforupdation').clone();

        // Replace input fields with their values in the clone
        $tableClone.find('input').each(function () {
            var $input = $(this);
            $input.replaceWith($input.val());
        });

        // Create Excel file
        var html = $tableClone[0].outerHTML;
        var blob = new Blob([html], { type: "application/vnd.ms-excel" });
        var url = URL.createObjectURL(blob);

        // Create download link
        var a = document.createElement('a');
        a.href = url;
        a.download = "Umis no Updation File.xls";
        a.style.display = 'none';
        document.body.appendChild(a);
            // Clean up
        setTimeout(function () {
                URL.revokeObjectURL(url);
                document.body.removeChild(a);

                // Navigate to the new URL
                loadContent('/Student/StudentUMISNOUpdation');
            }, 100);


    }
</script>

