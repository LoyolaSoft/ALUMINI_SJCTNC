    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;

        loadContent('/student/studentStrenghReportAcYearWiseSeprateMF');
    }
    function Export() {
        var title = "";
        //var sSatff = $('#StaffListByDepartmet option:selected').text();
        title = "StudentStrengthReportGenderWise";
        let file = new Blob([$('#dvStudentStrength').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        //$('#btnGet').click();
        loadContent('/student/studentStrenghReportAcYearWiseSeprateMF');

    }
</script>





