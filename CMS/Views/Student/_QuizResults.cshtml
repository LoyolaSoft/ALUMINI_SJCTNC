@model List<CMS.ViewModel.Model.QUIZ_CERTIFICATE_RESULT>

@if (Model != null && Model.Count > 0)
{
    int index = 0;
    foreach (var item in Model)
    {
        index++;
        double percentage = 0;
        double.TryParse(item.PERCENTAGE, out percentage);
        bool isEligible = percentage >= 60;
        string statusColor = isEligible ? "#10b981" : "#ef4444"; // emerald-500 : red-500
        string statusText = isEligible ? "Qualified" : "Not Qualified";
        string statusBg = isEligible ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)";
        
        <div class="col-12 col-lg-6 animate-in" style="animation-delay: @(index * 0.1)s">
            <div class="card h-100 glass-card border-0 shadow-sm overflow-hidden premium-quiz-card">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="flex-grow-1 me-3">
                            <span class="text-uppercase tracking-wider small fw-bold opacity-50 d-block mb-1">Course ID: @item.COURSE_ID</span>
                            <h4 class="fw-bold text-slate-800 m-0">@item.SETTING_NAME</h4>
                        </div>
                        <div class="status-badge" style="background: @statusBg; color: @statusColor;">
                            @if (isEligible) { <i class="fas fa-check-circle me-1"></i> }
                            else { <i class="fas fa-exclamation-circle me-1"></i> }
                            @statusText
                        </div>
                    </div>

                    <div class="row align-items-center mb-5">
                        <div class="col-auto">
                            <!-- Circular Progress Indicator -->
                            <div class="circular-progress" style="--percent: @item.PERCENTAGE; --color: @statusColor;">
                                <div class="inner-value">@item.PERCENTAGE%</div>
                            </div>
                        </div>
                        <div class="col border-start ps-4">
                            <div class="row g-3">
                                <div class="col-6">
                                    <span class="d-block small text-muted mb-1">Obtained</span>
                                    <span class="h3 fw-bold m-0 text-slate-800">@item.SCORE_MARK</span>
                                </div>
                                <div class="col-6">
                                    <span class="d-block small text-muted mb-1">Total Mark</span>
                                    <span class="h4 fw-bold m-0 opacity-50">@item.TOTAL_MARK</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <button class="btn btn-premium-secondary flex-grow-1 py-3 px-4 rounded-xl fw-bold" onclick="viewResultDetail('@item.SETTING_ID', '@item.SETTING_NAME', '@item.COURSE_ID')">
                            <i class="fas fa-chart-line me-2"></i>Detailed Analysis
                        </button>
                        
                        @if (isEligible)
                        {
                            <button class="btn btn-premium-primary flex-grow-1 py-3 px-4 rounded-xl fw-bold" onclick="downloadCert('@item.SETTING_ID', '@item.SCORE_MARK', '@item.TOTAL_MARK')">
                                <i class="fas fa-award me-2"></i>Get Certificate
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-light flex-grow-1 py-3 px-4 rounded-xl fw-bold text-muted cursor-not-allowed" disabled title="60% required for certificate">
                                <i class="fas fa-lock me-2 text-danger"></i>Locked
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

<style>
    .premium-quiz-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255,255,255,0.4) !important;
    }

    .premium-quiz-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
        border: 1px solid rgba(59, 130, 246, 0.2) !important;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    /* Circular Progress CSS */
    .circular-progress {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: conic-gradient(var(--color) calc(var(--percent) * 1%), #e2e8f0 0);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
    }

    .circular-progress::after {
        content: "";
        position: absolute;
        width: 80px;
        height: 80px;
        background: white;
        border-radius: 50%;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }

    .inner-value {
        position: relative;
        z-index: 10;
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
    }

    .btn-premium-primary {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border: none;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        transition: all 0.3s ease;
    }

    .btn-premium-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
        color: white;
    }

    .btn-premium-secondary {
        background: white;
        color: #3b82f6;
        border: 2px solid #3b82f6;
        transition: all 0.3s ease;
    }

    .btn-premium-secondary:hover {
        background: #eff6ff;
        transform: translateY(-2px);
    }

    .rounded-xl { border-radius: 12px !important; }
    .text-slate-800 { color: #1e293b; }
    .tracking-wider { letter-spacing: 0.05em; }
    .cursor-not-allowed { cursor: not-allowed; }
</style>
