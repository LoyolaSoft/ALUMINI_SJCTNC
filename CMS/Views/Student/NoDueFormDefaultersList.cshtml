@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "NoDueFormDefaultersList";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">No due Form Defaulters</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">No due Form Defaulters</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">No due Form Defaulters</h4>
        </div>
        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12 form-horizontal">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Academic Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ADAcademicYear" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Semester Type</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.liSemesterType, (Model.liSemesterType != null) ? Model.liSemesterType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "AdSemesterType" })
                                @Html.ValidationMessageFor(model => model.liSemesterType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <button id="btnGet" class="btn btn-primary">Get</button>
                        </div>

                        <div class="col-md-1 btnPrintDiv hidden">
                            <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                        </div>
                        <div class="col-md-1 btnExcelDiv hidden">
                            <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                        </div>
                        <div class="form-group col-md-1 pull-right">
                            <a href="#malpratice-dialog" data-toggle="modal" class="btn btn-danger" id="btnAdd">+Add</a>
                        </div>
                    </div>

                </div>

            </div>

            <hr />
            <br />
            <div class="form-group col-md-12">
                <div id="divbind"></div>
            </div>
        </div>
        <div class="modal fade" id="malpratice-dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <h4 class="modal-title">No Due form defaulterss </h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="form-horizontal">
                                    <div class="">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4"> Roll No </label>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control input-sm" id="txtRollNO" placeholder="Enter roll No " maxlength="98" />
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4">Academic Year</label>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "AcademicYear" })
                                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4"> Semester Type</label>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.liSemesterType, (Model.liSemesterType != null) ? Model.liSemesterType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "SemesterType" })
                                                @Html.ValidationMessageFor(model => model.liSemesterType, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label class="control-label col-md-4"> Reason </label>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control input-sm" id="txtReason" placeholder="Enter Reson for block the no due form " maxlength="98" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
        <input type="text" id="txtNodueId" class="hidden" value="" />

    </div>
    <!-- end panel -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>



<script>
    $('.selectpicker').selectpicker({
        size: 4
    });

    $("#ADAcademicYear").on("change", function () {
        FetchCIAMalPractice();
    });

    $("#AdSemesterType").on("change", function () {
        FetchNodueDefaulters();
    });

    $("#btnGet").on("click", function () {
        FetchNodueDefaulters();
    });


    function FetchNodueDefaulters()
    {
        debugger;
        var semesterTypeID = $("#AdSemesterType").val();
        var AcademicYear = $('#ADAcademicYear option:selected').text();
        if ($("#AdSemesterType").val() && $('#ADAcademicYear option:selected').text())
            {

            $('#loader').show();
                $.ajax({
                    url: "@Url.Action("BindNoDueFormDefaultersList", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sAcademicYear: AcademicYear, SemesterType: semesterTypeID },
                    success: function (data) {
                        $("#divbind").empty();
                        $("#divbind").append(data);
                        $(".btnPrintDiv").removeClass('hidden');
                        $(".btnExcelDiv").removeClass('hidden');
                        table = $("#tblMalpracticeList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
                        $("#tblMalpracticeList_filter").addClass("dataTables_filter pull-right");
                        $(".pagination").addClass("pagination pull-right");
                        $('#loader').hide();
                    }, error: function (error) {
                        alert('Internal Server Error !');
                        $('#loader').hide();
                    }
                });
            }
    };


 GetConfirm = function (ID)
 {
     swal({
         title: "Are you sure want to Delete?",
         text: "",
         type: "warning",
         showCancelButton: true,
         confirmButtonClass: "btn-danger",
         confirmButtonText: "Yes, I agree!",
         closeOnConfirm: false
     },
         function () {

             $.ajax({
                 url: "@Url.Action("DeleteNodueDefaultersByID", "Student")",
                 method: "POST",
                 datatype: "html",
                 data: { sDefaultersId: ID },
                 success: function (ObjJsonData) {
                     if (ObjJsonData.ErrorCode == "200") {
                         swal({ title: "Success !", text: ObjJsonData.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });
                         FetchNodueDefaulters();
                     }
                     else {
                         swal({ title: "Fail !", text: ObjJsonData.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                     }

                 }, error: function (error) {
                     alert('Internal Server Error ! ');
                 }
             });
         });
    }

    $("#btnSubmit").on('click', function () {
        var roll_no = $("#txtRollNO").val();
        var SemesterType = $("#SemesterType").val();
        var acYear = $("#AcademicYear option:selected").text();
        var NodueID = $("#txtNodueId").val();
        var Reason = $("#txtReason").val();
        $.ajax({
            url: "@Url.Action("SaveOrUpdateNodueDefaulters", "Student")",
            method: "POST",
            datatype: "html",
            data: { NodueID: NodueID, rollNO: roll_no, sSemesterType: SemesterType, sacYear: acYear, sReason: Reason },
            success: function (data)
            {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });

                    FetchNodueDefaulters();
                }
                else if (data.ErrorCode == "404") {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 4000, type: 'info', animation: true });

                }
                else {
                    swal({ title: "Fail !", text: data.Message, showConfirmButton: false, timer: 4000, type: 'error', animation: true });
                }

            }, error: function ()
            {
                swal({ title: "Fail !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 4000, type: 'error', animation: true });

            }
        })
    });

    $("#btnAdd").on('click', function () {
    
        $("#txtRollNO").val('');
        $("#txtNodueId").val('');
        $("#txtReason").val('');
        $("#AcademicYear option[value='']").attr("selected", "selected");
        $("#SemesterType option[value='']").attr("selected", "selected");
        $('.selectpicker').selectpicker('refresh');
    });

        function FetchMalpracticeById(smalID) {
            if (smalID != null) {
            $.ajax({

                 url: '@Url.Action("FetchNodueDefaulterstById", "Student")',
                type: "POST",
                datatype: 'json',
                data: { sDefaulterId: smalID },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                    }
                    else {
                        if (data[0] != null) {
                            $('#txtRollNO').attr('value', data[0].ROLL_NO);
                            $('#AcademicYear option').filter(function () {
                                return $(this).text().trim() === data[0].ACADEMIC_YEAR.trim();
                            }).prop('selected', true);
                            //$('#AcademicYear').text(data[0].ACADEMIC_YEAR);
                            $('#SemesterType').val(data[0].SEMESTER_TYPE);
                            $('#txtReason').val(data[0].REASON);
                            $('#txtNodueId').attr('value', data[0].STU_NODUE_DEFALTER_ID);


                            $('.selectpicker').selectpicker('refresh');

                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                }
            });
        }
    }


</script>
<script>
            function SetActive(ID)
    {
                swal({
                    title: "Are you sure?",
                    text: "Are you sure to Activate. ?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "btn-danger",
                    confirmButtonText: "Yes, Activate it!",
                    closeOnConfirm: false
                },
                    function () {
                $.ajax({
                    url: "@Url.Action("UpdateActiveNodueDefaulters", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sSettingId: ID, sActive: '1' },
                    success: function (data) {
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                            FetchNodueDefaulters();
                        }
                        else {
                           
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                        }
                    }, error: function (error) {
                       
                        swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
}
                });

        });

}

// De - Activate Setting ...
function SetDeActive(ID)
{
            swal({
                title: "Are you sure?",
                text: "Are you sure to De - Activate. ?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, De - Activate it!",
                closeOnConfirm: false
            },
                function () {

            $.ajax({
                url: "@Url.Action("UpdateActiveNodueDefaulters", "Student")",
                method: "POST",
                datatype: "json",
                data: { sSettingId: ID, sActive: '0' },
                success: function (data) {
                    if (data.ErrorCode == "200") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                        FetchNodueDefaulters();
                    }
                    else {

                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                    }
                }, error: function (error) {
                    swal({ title: "Error !", text: 'Internal Server Error ! ', showConfirmButton: false, timer: 2500, type: 'error', animation: true });

                }
            });
        
    });
    }
</script>
<script>

    function Export() {
        var title = "CIA Malpractice";
        var table = $('#tblMalpracticeList').DataTable();
        table.destroy();
        let file = new Blob([$('#divbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        table = $("#tblMalpracticeList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
        $("#tblMalpracticeList_filter").addClass("dataTables_filter pull-right");
        $(".pagination").addClass("pagination pull-right");
    }

    function printDiv() {
        var table = $('#tblMalpracticeList').DataTable();
        table.destroy();
        var printContents = document.getElementById('divbind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/CIAMalpracticeList')
    }
</script>



