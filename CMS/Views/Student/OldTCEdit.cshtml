<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>

    ContentLoad = function ()
    {
        //Ready Function()
        $('.selectpicker').selectpicker('refresh');
        //$("#btnTCIssueUpdate").hide();            
        handleDatepicker = function () {
            "use strict";
            $("#DateOfBirth,#AdmissionDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            })
        }
        handleDatepicker();
        handlepicker = function () {
            "use strict";
            $("#LeavingDate,#TCIssueDate,#StuTCApplyDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            })
        }
        handlepicker();
    }
    $('.selectpicker').selectpicker({
        size: 4
    });

    $('.selectpicker').selectpicker('refresh');

    $('#btnGet').on('click', function () {
        var admno = $('#Admission_No').val();
        $.ajax({
            url: "@Url.Action("FetchStudentInfoForOldTCEdit", "Student")",
            method: "POST",
            datatype: "json",
            data: { sAdmissionno: admno },
            success: function (data)
            {
                $('#TCEdit').removeClass('hidden');
                $("#dvCertificate").val(data.CERTIFICATE_ID);
                $("#StudentName").val(data.FIRST_NAME);
                $("#ParentName").val(data.FATHER_NAME);
                $("#AdmissionNo").val(data.ADMISSION_NO);
                $("#Guardian").val(data.GUARDIAN_NAME);
                $("#nation").val(data.NATIONALITY);
                $("#religi").val(data.RELIGION);
                $("#Caste").val(data.CASTE);
                $("#comm").val(data.COMMUNITY);
                $("#gender").val(data.GENDER);
                $("#DateOfBirth").val(data.DATE_OF_BIRTH);
                $("#DateToWords").val(data.DATETOWORDS);
                $("#IdentificationMark1").val(data.IDENTIFICATION_MARK1);
                $("#IdentificationMark2").val(data.IDENTIFICATION_MARK2);
                $("#AdmissionDate").val(data.ADMISSION_DATE);
                $("#AdmittedClass").val(data.ADMITTED_CLASS);
                $("#LeavingTime").val(data.LEAVING_DATE);
                $("#MainCourse").val(data.MAIN_COURSE);
                $("#AlliedCourse").val(data.ALLIED);
                $("#FeesPaid").val(data.FEE_PAID);
                $("#StuScholarship").val(data.SCHOLAR_SHIP);
               
                $("#LeavingDate").val(data.LEAVING_DATE);
                $("#Conduct").val(data.CONDUCT);
                $("#StuTCApplyDate").val(data.TC_APPLIED_DATE);
                $("#TCIssueDate").val(data.TC_GIVEN_DATE);
                $("#CourseOfStudy").val(data.COURSE_OF_STUDY);
                $("#AcademicYears").val(data.ACADEMIC_YEARS);
                $("#ClassesStudied").val(data.CLASSES_STUDEIED);
                $("#FirstLanguage").val(data.FIRST_LANGUAGE);
                $('.selectpicker').selectpicker('refresh');
                            
            }, error: function (error) {
                alert('Internal Server Error !');

            }
        });
    });
    // Save Or Update ...
    $("#btnTCIssue").on("click", function () {
        var isValid = true;
        if ($('#TransferCertificate').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            alert('Something went wrong ! Please check your inputs !');
            return false;
        }
            
        var CertificateId = $("#dvCertificate").val();
        var StuName = "0";
        var StudentName = $("#StudentName").val();
        var ParentName = $("#ParentName").val();
        var SerialNo = '';
        SerialNo = $("#SerialNo").val();
        var AdmissionNo = '';
        AdmissionNo = $("#AdmissionNo").val();
        var Guardian = $("#Guardian").val();
        var Nationality = $("#nation").val();
    
        var Religion = $("#religi").val();
       
        var Caste = $("#Caste").val();
        var Community = $("#comm").val();
      
        var Sex = $("#gender").val();
    
        var DateOfBirth = $("#DateOfBirth").val();

        var IdentificationMark1 = $("#IdentificationMark1").val();
        var IdentificationMark2 = $("#IdentificationMark2").val();
        var AdmissionDate = $("#AdmissionDate").val();
        var AdmittedClass = $("#AdmittedClass").val();
        var LeavingTime = $("#LeavingTime").val();
        var MainCourse = $("#MainCourse").val();
        var AlliedCourse = $("#AlliedCourse").val();
        var FeesPaid = $("#FeesPaid").val();
        var StuScholarship = $("#StuScholarship").val();
        var LeavingDate = $("#LeavingDate").val();
        var Conduct = $("#Conduct").val();
        var StuTCApplyDate = $("#StuTCApplyDate").val();
        var TCIssueDate = $("#TCIssueDate").val();
        var CourseOfStudy = $("#CourseOfStudy").val();
        var AcademicYears = $("#AcademicYears").val();
        var ClassesStudied = $("#ClassesStudied").val();
        var FirstLanguage = $("#FirstLanguage").val();
        var ClassId = $("#ClassName").val();
        var DatetoWords = $("#DateToWords").val();
        // var AlliedCourse2 =  $("#AlliedCourse2").val();
        var JsonData;
        if (JsonData == null)
        {
            JsonData = '{"CERTIFICATE_ID":"' + CertificateId + '",\
                            "DATETOWORDS":"' + DatetoWords + '",\
                            "ACADEMIC_YEARS":"' + AcademicYears + '",\
                            "CLASSES_STUDEIED":"' + ClassesStudied + '",\
                            "FIRST_LANGUAGE":"' + FirstLanguage + '",\
                            "GENDER":"' + Sex + '",\
                            "COMMUNITY":"' + Community + '",\
                            "RELIGION":"' + Religion + '",\
                            "NATIONALITY":"' + Nationality + '",\
                            "STUDENT_ID":"0",\
                            "FIRST_NAME":"' + StudentName + '",\
                            "FATHER_NAME":"' + ParentName + '",\
                            "ADMISSION_NO":"' + AdmissionNo + '",\
                            "GUARDIAN_NAME":"' + Guardian + '",\
                            "NATIONALITY":"' + Nationality + '",\
                            "RELIGION":"' + Religion + '",\
                            "CASTE":"' + Caste + '",\
                            "COMMUNITY":"' + Community + '",\
                            "GENDER":"' + Sex + '",\
                            "DATE_OF_BIRTH":"' + DateOfBirth + '",\
                            "IDENTIFICATION_MARK1":"' + IdentificationMark1 + '",\
                            "IDENTIFICATION_MARK2":"' + IdentificationMark2 + '",\
                            "ADMISSION_DATE":"' + AdmissionDate + '",\
                            "ADMITTED_CLASS":"' + AdmittedClass + '",\
                            "LEAVING_CLASS":"' + LeavingTime + '",\
                            "MAIN_COURSE":"' + MainCourse + '",\
                            "ALLIED":"' + AlliedCourse + '",\
                            "FEE_PAID":"' + FeesPaid + '",\
                            "SCHOLAR_SHIP":"' + StuScholarship + '",\
