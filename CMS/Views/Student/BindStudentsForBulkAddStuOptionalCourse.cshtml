@model CMS.ViewModel.ViewModel.StudentViewModel
@{ int count = 0;}

@if (Model.liStudent != null && Model.liStudent.Count > 0)
{
    <table class="table table-hover table-bordered" width="100%" id="StudentOptCourseList">
        <thead>
            <tr>
                <th>#</th>
                <th>
                    <div class="checkbox checkbox-css">
                        <input type="checkbox" value="" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" />
                        <label for="AllchkID"></label>
                    </div>
                </th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>First Name</th>
                <th>Class Name</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStudent != null)
            {
                foreach (var item in Model.liStudent)
                {
                    <tr>
                        <td>
                            @{ count++;}@count
                        </td>
                        <td>
                            <div class="checkbox checkbox-css checkbox-inline">
                                <input type="checkbox" name="myTextEditBox" id="@item.STUDENT_ID" cms-studentid="@item.STUDENT_ID" />
                                <label for="@item.STUDENT_ID"></label>
                            </div>
                        </td>
                        <td>
                            @item.ROLL_NO
                        </td>
                        <td>
                            @item.REGISTER_NO
                        </td>
                        <td>
                            @item.FIRST_NAME
                        </td>
                        <td>
                            @item.CLASS_NAME
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else
{
    <div class="col-md-12 bg-danger">No Records Found..!</div>
}



