<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>

<script>
    $(document).ready(function () {

        $("#btnGetReport").click(function () {
            var rollNo = $("#txtRollNo").val().trim();
            if (!rollNo) {
                alert("Please enter a student Roll Number.");
                return;
            }
            LoadConsolidatedReport(rollNo);
        });

        // Trigger load on enter key
        $("#txtRollNo").keypress(function (e) {
            if (e.which == 13) {
                $("#btnGetReport").click();
            }
        });

        // Load correct tab dynamically on click
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var targetTab = $(e.target).attr("href");
            var rollNo = $("#txtRollNo").val().trim();
            if (!rollNo) return;

            if (targetTab === "#tabPersonal") {
                LoadPersonalInfo(rollNo);
            } else if (targetTab === "#tabAcademic") {
                LoadAcademicInfo(rollNo);
            } else if (targetTab === "#tabCIAMarks") {
                LoadCIAMarksInfo(rollNo);
            } else if (targetTab === "#tabLateEntry") {
                LoadLateEntryInfo(rollNo);
            } else if (targetTab === "#tabAbsent") {
                LoadAbsentInfo(rollNo);
            } else if (targetTab === "#tabFee") {
                LoadFeeInfo(rollNo);
            }
        });

    });

    function LoadConsolidatedReport(rollNo) {
        // Show loading or transition
        $("#divConsolidatedDashboard").hide();

        // 1. Fetch personal details first to verify student existence
        $.ajax({
            url: '@Url.Action("GetConsolidatedPersonalInfo", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo },
            success: function (data) {
                if ($(data).find('.no-records').length > 0 || data.trim() === "" || $(data).find('#hdnStudentExists').val() === "false") {
                    alert("No student record found for Roll Number: " + rollNo);
                    $("#divConsolidatedDashboard").hide();
                    return;
                }

                // Show dashboard wrapper
                $("#divConsolidatedDashboard").show();

                // Load Personal info content
                $("#divPersonalContent").html(data);

                // Set up the Header Profile Card from the personal info model
                var name = $("#hdnStudentName").val();
                var roll = $("#hdnStudentRollNo").val();
                var reg = $("#hdnStudentRegisterNo").val();
                var classname = $("#hdnStudentClassName").val();
                var dept = $("#hdnStudentDept").val();
                var shift = $("#hdnStudentShift").val();
                var photo = $("#hdnStudentPhoto").val();
                var isLeft = $("#hdnStudentIsLeft").val();
                var isRejoined = $("#hdnStudentIsRejoined").val();
                var mobile = $("#hdnStudentMobile").val();
                var fatherMobile = $("#hdnStudentFatherMobile").val();
                var isCourseCompleted = $("#hdnStudentIsCourseCompleted").val();

                if (!photo) {
                    photo = "/Content/assets/img/transparent/e-user.jpg"; // Default image
                }

                var statusBadge = "";
                if (isLeft === "1") {
                    statusBadge = ' <span class="badge" style="background-color: #ef4444 !important; color: #ffffff !important; padding: 5px 12px; font-size: 0.8rem; border-radius: 20px; font-weight: 700; margin-left: 15px; vertical-align: middle; display: inline-flex; align-items: center; gap: 4px;"><i class="fa fa-sign-out"></i> LEFT STUDENT</span>';
                } else if (isRejoined === "1") {
                    statusBadge = ' <span class="badge" style="background-color: #f59e0b !important; color: #ffffff !important; padding: 5px 12px; font-size: 0.8rem; border-radius: 20px; font-weight: 700; margin-left: 15px; vertical-align: middle; display: inline-flex; align-items: center; gap: 4px;"><i class="fa fa-refresh"></i> REJOINED STUDENT</span>';
                } else if (isCourseCompleted === "1") {
                    statusBadge = ' <span class="badge" style="background-color: #3b82f6 !important; color: #ffffff !important; padding: 5px 12px; font-size: 0.8rem; border-radius: 20px; font-weight: 700; margin-left: 15px; vertical-align: middle; display: inline-flex; align-items: center; gap: 4px;"><i class="fa fa-graduation-cap"></i> COURSE COMPLETED</span>';
                } else {
                    statusBadge = ' <span class="badge" style="background-color: #22c55e !important; color: #ffffff !important; padding: 5px 12px; font-size: 0.8rem; border-radius: 20px; font-weight: 700; margin-left: 15px; vertical-align: middle; display: inline-flex; align-items: center; gap: 4px;"><i class="fa fa-check-circle"></i> CURRENTLY STUDYING</span>';
                }

                var headerHtml = '<div class="profile-card">' +
                    '   <div class="profile-img-container">' +
                    '       <img class="profile-img" src="' + photo + '" alt="Student Photo" onerror="this.onerror=null;this.src=\'/Content/assets/img/transparent/e-user.jpg\'" />' +
                    '   </div>' +
                    '   <div class="profile-details">' +
                    '       <h2 class="profile-name" style="margin-top: 0; margin-bottom: 12px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px;">' + name + statusBadge + '</h2>' +
                    '       <div class="profile-meta-grid">' +
                    '           <div class="profile-meta-item"><strong>Roll No:</strong> ' + roll + '</div>' +
                    '           <div class="profile-meta-item"><strong>Register No:</strong> ' + reg + '</div>' +
                    '           <div class="profile-meta-item"><strong>Class:</strong> ' + classname + '</div>' +
                    '           <div class="profile-meta-item"><strong>Department:</strong> ' + dept + '</div>' +
                    '           <div class="profile-meta-item"><strong>Shift:</strong> ' + shift + '</div>' +
                    '           <div class="profile-meta-item"><strong>Mobile No:</strong> ' + (mobile || '-') + '</div>' +
                    '           <div class="profile-meta-item"><strong>Father Mobile:</strong> ' + (fatherMobile || '-') + '</div>' +
                    '       </div>' +
                    '   </div>' +
                    '</div>';

                $("#divStudentHeaderProfile").html(headerHtml);

                // Default switch to Personal Details tab
                $('.premium-tabs a[href="#tabPersonal"]').tab('show');
            },
            error: function () {
                alert("Error searching student details. Please try again.");
            }
        });
    }

    function LoadPersonalInfo(rollNo) {
        // Already loaded during verification, but refresh if needed
    }

    function LoadAcademicInfo(rollNo) {
        $("#divAcademicContent").html('<div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading academic details...</div>');
        $.ajax({
            url: '@Url.Action("GetConsolidatedAcademicInfo", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo },
            success: function (html) {
                $("#divAcademicContent").html(html);
            },
            error: function () {
                $("#divAcademicContent").html('<div class="text-danger">Failed to load academic records.</div>');
            }
        });
    }

    function LoadCIAMarksInfo(rollNo) {
        $("#divCIAContent").html('<div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading CIA marks...</div>');
        $.ajax({
            url: '@Url.Action("GetConsolidatedCIAMarks", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo },
            success: function (html) {
                $("#divCIAContent").html(html);
            },
            error: function () {
                $("#divCIAContent").html('<div class="text-danger">Failed to load CIA marks.</div>');
            }
        });
    }

    function LoadLateEntryInfo(rollNo) {
        $("#divLateEntryContent").html('<div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading late entry logs...</div>');
        $.ajax({
            url: '@Url.Action("GetConsolidatedLateEntryInfo", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo },
            success: function (html) {
                $("#divLateEntryContent").html(html);
            },
            error: function () {
                $("#divLateEntryContent").html('<div class="text-danger">Failed to load late entry logs.</div>');
            }
        });
    }

    function LoadAbsentInfo(rollNo) {
        LoadSemesterAttendance("");
    }

    function LoadSemesterAttendance(semesterId, academicYear) {
        var rollNo = $("#txtRollNo").val().trim();
        $("#divAbsentContent").html('<div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading attendance details...</div>');
        $.ajax({
            url: '@Url.Action("GetConsolidatedAttendanceInfo", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo, semesterId: semesterId, academicYear: academicYear || '' },
            success: function (html) {
                $("#divAbsentContent").html(html);
            },
            error: function () {
                $("#divAbsentContent").html('<div class="text-danger">Failed to load absent details.</div>');
            }
        });
    }

    function ShowAbsentDatesModal(semesterId, academicYear) {
        var rollNo = $("#txtRollNo").val().trim();
        $("#modalAbsentDatesBody").html('<div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading absent dates...</div>');
        $("#modalAbsentDates").modal('show');
        $.ajax({
            url: '@Url.Action("GetConsolidatedAttendanceInfo", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo, semesterId: semesterId, academicYear: academicYear || '' },
            success: function (html) {
                $("#modalAbsentDatesBody").html(html);
            },
            error: function () {
                $("#modalAbsentDatesBody").html('<div class="text-danger p-3">Failed to load absent dates.</div>');
            }
        });
    }

    function LoadFeeInfo(rollNo) {
        $("#divFeeContent").html('<div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading fee summary...</div>');
        $.ajax({
            url: '@Url.Action("GetConsolidatedFeeInfo", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo },
            success: function (html) {
                $("#divFeeContent").html(html);
            },
            error: function () {
                $("#divFeeContent").html('<div class="text-danger">Failed to load fee summaries.</div>');
            }
        });
    }
</script>
