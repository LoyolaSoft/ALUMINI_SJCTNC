                        `);

        printWindow.document.write('</style></head><body>');
        printWindow.document.write('<div class="" style="background: linear-gradient(#e7f3fd, #e7f3fd, #e7f3fd);">');
        printWindow.document.write(content);
        printWindow.document.write('</div>');
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        printWindow.print();
        document.body.innerHTML = document.body.innerHTML
    }


    $('#txtRollNo').on("keypress", function (event) {
        var keycode = event.keyCode || event.which;
        if (keycode == 13) {
            event.preventDefault();
            BindData();
        }
    });

     function BindData()
     {
     var isArrear = $('#txtArrear').is(':checked') ? 1 : 0;

         if ($('#txtRollNo').val())
     {
         $.ajax({
             url: '@Url.Action("FetchExamHallTicketByRollNO", "Student")',
             method: 'POST',
             datatype: 'Json',
             data: { sRollNo: $('#txtRollNo').val(), sArrear: isArrear },
             success: function (data)
             {
                 $('#dvBindHallTicket').empty();
                 $('#dvBindHallTicket').append(data);
             }, error: function (error)
             {
                 swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
             }
         });
     } else
     {
         swal({ title: "Warning !", text: "Something went wrong try again !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
     }
 }
</script>
