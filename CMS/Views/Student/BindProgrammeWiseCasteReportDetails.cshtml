@model CMS.ViewModel.ViewModel.StudentViewModel
    @using CMS.Utility
@{
    ViewBag.Title = "BindDayWiseGrievanceReport";
    Layout = null;
}



        <div class="invoice" style="background-color:#F6F6F6 !important;">
            @if (Model.liProgramme != null && Model.liCaste != null)
            {

            <div class="col-md-1 pull-right">
                <button class="btn btn-success" onclick="" id="btnExport"> Export </button>
            </div>
            <div class="invoice-company" id="dvHead">
                @Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME ,<small>
                    PROGRAMME WISE CASTE REPORT REPORT(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                        { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } })
                </small>
            </div>
            <div class="form-group col-md-12">
                <table class="table table-bordered table-hover" id="tblReportForProgrammeWise" border="1">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Programme Name</th>
                            @foreach (var item in Model.liCommunity)
                            {
                                <th>@item.COMMUNITY_NAME</th>
                            }

                        </tr>
                    </thead>
                    <tbody id="tBodyForProgramme">
                        @{ int count = 0;}
                        @foreach (var item in Model.liProgramme)
                {
                    count += 1;
                            <tr>
                                <td>@count</td>
                                <td>@item.PROGRAMME_NAME</td>


                                @foreach (var community in Model.liCommunity)
                                {
                                    var liGroupProgramme = Model.liCaste.Where(x => x.PROGRAMME_GROUP_ID == item.PROGRAMME_GROUP_ID && x.COMMUNITY == community.COMMUNITY).ToList();

                                    if (liGroupProgramme != null && liGroupProgramme.Count > 0)
                                    {
                                        foreach (var itemDetails in liGroupProgramme)
                                        {
                                            <td>@itemDetails.COUNT</td>

                                        }
                                    }
                                    else
                                    {
                                        <td>0</td>
                                    }
                                }

                            </tr>
                        }
                    </tbody>


                </table>
            </div>

            }
            else
            {
            <div class="alert alert-danger">No Record(s) Found !</div>
            }
        </div>
            
            <script>
    $("#btnExport").click(function (e) {

        var printContents = document.getElementById('divProgramme');
        var sAcademic = $('#dAcademic Option:selected').text();
        var sShift = $('#dShift option:selected').text();
        var sProgrammeMode = $('#dProgrammeMode option:selected').text();
        let file = new Blob([$(printContents).html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "ProgrammeWise" + "_" + sProgrammeMode + "_" + sAcademic + "_Year.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
            </script>
