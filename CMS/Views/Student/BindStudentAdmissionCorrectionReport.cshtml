
@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "BindStudentAdmissionCorrectionReport";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

@if (Model.liStudent != null && Model.liStudent.Count > 0)
{
    <div class="form-group col-md-12 table-responsive">
        @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
        {
            <div class="text-center">
                <img class="image" />
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
            </div>
            <div class="text-center">

                <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
              
            </div>
        }


        <div class="col-md-8 col-lg-offset-2">
            <table class="" id="tblLiFbReport" cellpadding="50" width="100%" border="1">
                <thead>
                    <tr>S.No</tr>
                    <tr>Admission No</tr>
                    <tr>Student Name</tr>
                    <tr>Name of the parent or Gaurdian/ Residence</tr>
                    <tr>Parent Institution</tr>
                    <tr>Date of Birth</tr>
                    <tr>Hsc.RegNo 
                        Year
                        Marks</tr>
                    <tr>Religion
                        Caste
                        Community</tr>
                    <tr>Date of Admn</tr>
                    <tr>Class and
                        Date of
                        Leaving</tr>
                    <tr>Identificatoin</tr>
                    <tr>TC No & Dt.</tr>
                    <tr>Remarks</tr>
                </thead>
                <tbody style="text-align:center;">
                    @{ int icount = 0;}
              
                       @foreach (var item in Model.liStudent)
                       {
                           @{ icount = icount + 1;}
                    <tr>
                        <td>@icount</td>
                        <td>@item.ADMISSION_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>
                            @item.FATHER_NAME
                            @item.GUARDIAN_NAME

                            @item.C_DOOR_DETAIL
                            @item.C_STREET
                            @item.C_CITY
                            @item.C_DISTRICT
                        </td>
                        <td>@item.DATE_OF_BIRTH</td>
                        <td>
                            @item.Q_REGISTER_NO
                            @item.YEAR_OF_PASSING
                            @item.TOTAL_MARK
                        </td>
                        <td>@item.RELIGION
                        @item.CASTE
                        @item.COMMUNITY</td>

                        <td>@item.ADMISSION_DATE</td>
                    </tr>
                               }

                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">No Record(s) Found !</div>
}










