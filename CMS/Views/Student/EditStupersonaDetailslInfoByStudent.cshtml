           document.getElementById("inputimg").disabled = true;

            function checkPhoto(target) {
                var file = target.files[0];

                var img = new Image();
                img.onload = function () {

                    if (img.width != 150 ||   img.height != 150) {
                        alert("**Passport Size :**\nImage dimensions must be 150 pixels in width and 150 pixels in height.");
                        $('#img').attr('src', '');
                        return false;
                    }
                    //// Check if the image dimensions are 250x250px
                    //if (img.width !== 250 || img.height !== 250) {
                    //    alert("Image dimensions must be 250x250 pixels");
                    //    $('#img').attr('src', '');
                    //    return false;
                    /*} */
                    else {
                        // If both conditions are met, display the image and show information
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            $('#img').attr('src', e.target.result);
                            alert("Image uploaded successfully!");
                        };
                        reader.readAsDataURL(file);
                    }
                };
                img.src = URL.createObjectURL(file);
            }

