<script>

    handleDatepicker = function () {
        alert('date')
        "use strict";
        $("#dob").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        }
        )
    }
    handleDatepicker();
    $('#chkSameAddress').click(function (event) {
        if (this.checked) {
            $('#permanantAdd').hide(500)
        } else {
            $('#permanantAdd').show(500)
        }
    });
</script>