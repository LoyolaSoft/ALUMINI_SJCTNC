<div class="modal fade" id="modalDynamicReport" tabindex="-1" role="dialog" aria-labelledby="dynamicReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <button type="button" class="close text-white" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title text-white" id="dynamicReportModalLabel">Dynamic Student Report Selection</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">Available Fields (Click to Select)</h4>
                            </div>
                            <div class="panel-body">
                                <div style="display:flex; gap:10px; margin-bottom: 10px;">
                                    <input type="text" id="searchDynFields" class="form-control" placeholder="Search fields..." style="flex:1;" />
                                    <button type="button" class="btn btn-success btn-sm" onclick="AddDynEmptyColumn()"><i class="fa fa-plus"></i> Empty Column</button>
                                </div>
                                <div id="availableDynFieldsList" style="max-height: 350px; overflow-y: auto; border: 1px solid #ddd; padding: 5px; border-radius: 4px;">
                                    <!-- List of fields -->
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">Selected Columns Order</h4>
                            </div>
                            <div class="panel-body">
                                <div id="selectedDynFieldsList" style="max-height: 395px; overflow-y: auto; border: 1px solid #ddd; padding: 5px; border-radius: 4px; min-height: 100px;">
                                    <div class="text-muted text-center p-t-20" id="emptyDynSelectionMsg">No fields selected yet. Click fields on the left to add them in your desired column order.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label col-md-3">Report Grouping:</label>
                            <div class="col-md-9">
                                <label class="radio-inline">
                                    <input type="radio" name="radReportType" value="full" checked onclick="ToggleReportTitleInput(false)" /> Full Report (Single Table)
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="radReportType" value="classwise" onclick="ToggleReportTitleInput(true)" /> Class-Wise Separate Report
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" id="divReportTitle" style="display: none; margin-top: 10px;">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label col-md-3">Report Title for Printing:</label>
                            <div class="col-md-9">
                                <input type="text" id="txtReportTitle" class="form-control" placeholder="Enter Report Title (e.g. EX-SERVICEMEN LIST)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="GenerateDynamicReport()">Generate Report</button>
            </div>
        </div>
    </div>
</div>

<script>
    var availableFields = [
        { id: "ROLL_NO", name: "Roll No" },
        { id: "FIRST_NAME", name: "First Name" },
        { id: "UMIS_NO", name: "UMIS No" },
        { id: "ENROLLMENT_NO", name: "Enrollment No" },
        { id: "DATE_OF_BIRTH", name: "Date Of Birth" },
        { id: "DEPARTMENT", name: "Department" },
        { id: "CLASS_NAME", name: "Class Name" },
        { id: "CLASS_LEVEL", name: "Class Level" },
        { id: "PROGRAMME_NAME", name: "Programme Name" },
        { id: "ADMISSION_NO", name: "Admission No" },
        { id: "ADMISSION_DATE", name: "Admission Date" },
        { id: "BATCH", name: "Batch" },
        { id: "AADHAR_NUMBER", name: "Aadhar Number" },
        { id: "FR_MOBILE", name: "Father Mobile" },
        { id: "STU_MOBILENO", name: "Student Mobile No" },
        { id: "GENDER", name: "Gender" },
        { id: "RELIGION", name: "Religion" },
        { id: "COMMUNITY", name: "Community" },
        { id: "CASTE", name: "Caste" },
        { id: "BLOOD_GROUP", name: "Blood Group" },
        { id: "SPECIALLY_ABLED", name: "Specially Abled" },
        { id: "FATHER_NAME", name: "Father Name" },
        { id: "MOTHER_NAME", name: "Mother Name" },
        { id: "FR_OCCUPATION", name: "Father Occupation" },
        { id: "MO_OCCUPATION", name: "Mother Occupation" },
        { id: "FR_INCOME", name: "Father Income" },
        { id: "MO_INCOME", name: "Mother Income" },
        { id: "ANNUAL_INCOME", name: "Annual Income" },
        { id: "IDENTIFICATION_MARK1", name: "Identification Mark 1" },
        { id: "IDENTIFICATION_MARK2", name: "Identification Mark 2" },
        { id: "STATE_NAME", name: "State Name" },
        { id: "DISTRICT", name: "District" },
        { id: "CITY", name: "City" },
        { id: "PINCODE", name: "Pincode" },
        { id: "ADDRESS_LINE1", name: "Address" },
        { id: "HSS_NO", name: "HSS No" },
        { id: "EX_SERVICE_MAN", name: "Ex Service Man" },
        { id: "HSS_GROUP_CODE", name: "HSS Group Code" },
        { id: "EMIS_NO", name: "EMIS No" },
        { id: "STUDY_BOARD", name: "Study Board" },
        { id: "HSS_TOTAL", name: "HSS Total" },
        { id: "LAST_SCHOOL_OR_COLLEGE", name: "Last School/College" },
        { id: "MEDIUM_STUDY", name: "Medium of Study" },
        { id: "EXTRA_CURRRICULAR", name: "Extra Curricular" },
        { id: "SPORTS", name: "Sports" },
        { id: "FIRSTGRADUATE", name: "First Graduate" },
        { id: "PART_1_LANGUAGE", name: "Part 1 Language" },
        { id: "LAST_STUDIED_UNIVERSITY", name: "Last Studied University" },
        { id: "YEAR_OF_PASSING", name: "Year of Passing" },
        { id: "PERCENTAGE", name: "Percentage" },
        { id: "ALLIED_1", name: "Allied 1" },
        { id: "ALLIED_2", name: "Allied 2" },
        { id: "MAIN_SUBJECT", name: "Main Subject" },
        { id: "ACCOUNT_NO", name: "Account No" },
        { id: "BANK_NAME", name: "Bank Name" },
        { id: "BRANCH_NAME", name: "Branch Name" },
        { id: "IFSC_CODE", name: "IFSC Code" },
        { id: "GSUITE_MAIL_ID", name: "College Email" },
        { id: "STU_EMAILID", name: "Student Email" }
    ];

    var selectedFields = [];

    // Cascade dropdown for Dynamic Report tab
    $("#DynProgramName").on("change", function () {
        FetchDynClass();
    });
    $("#DynClassYear").on("change", function () {
        FetchDynClass();
    });
    function FetchDynClass()
    {
        var ProgramName = String($("#DynProgramName").val());
        var classyear = String($("#DynClassYear").val());
        var sShift = $("#DynShiftList").val();
        if ($("#DynClassYear").val() && $("#DynShiftList").val() && $("#DynProgramName").val())
        {
            $.ajax({
                url: "@Url.Action("BindDDLClassListbyClassYear", "Student")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                success: function (data) {
                    $("#DynClassName").empty();
                    $("#DynClassName").append(data);
                    $('#DynClassName').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    $("#DynShiftList").on("change", function ()
    {
        fetchDynProgramme();
    });
    $("#DynprogrammeLevel").on("change", function ()
    {
        fetchDynProgramme();
    });
    function fetchDynProgramme()
    {
        var sShift = $("#DynShiftList").val();
        var pLevel = $("#DynprogrammeLevel").val();
        if ($("#DynShiftList").val() && $("#DynprogrammeLevel").val())
        {
            $.ajax({
                url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift, programmeLevel: pLevel },
                success: function (data) {
                    $("#DynProgramName").empty();
                    $("#DynProgramName").append(data);
                    $('#DynProgramName').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    function AddDynEmptyColumn() {
        var id = "EMPTY_COLUMN_" + Math.random().toString(36).substr(2, 9);
        selectedFields.push({ id: id, header: "Empty Column" });
        RenderSelectedDynFields();
    }

    function OpenDynamicReportModal() {
        var acYear = $('#DynAcademicYear option:selected').text();
        var classIDs = String($("#DynClassName").val());
        if (!acYear || !classIDs || classIDs === "null" || classIDs === "") {
            swal({ title: "Error !", text: "Please select Academic Year and Class Name.", type: "error" });
            return;
        }
        selectedFields = [];
        $('#searchDynFields').val('');
        $('#txtReportTitle').val('');
        $('input[name="radReportType"][value="full"]').prop('checked', true);
        ToggleReportTitleInput(false);
        RenderAvailableDynFields();
        RenderSelectedDynFields();
        $('#modalDynamicReport').modal('show');
    }

    function RenderAvailableDynFields() {
        var searchVal = $('#searchDynFields').val().toLowerCase();
        var list = $('#availableDynFieldsList');
        list.empty();
        
        $.each(availableFields, function(i, field) {
            var isSelected = selectedFields.findIndex(f => f.id === field.id) !== -1;
            if (!isSelected) {
                if (!searchVal || field.name.toLowerCase().indexOf(searchVal) !== -1) {
                    var item = $('<div class="list-group-item" style="cursor:pointer; padding: 8px 12px; margin-bottom: 4px; border: 1px solid #eee; border-radius: 4px; background:#fafafa;">' + field.name + '</div>');
                    item.click(function() {
                        selectedFields.push({ id: field.id, header: field.name });
                        RenderAvailableDynFields();
                        RenderSelectedDynFields();
                    });
                    list.append(item);
                }
            }
        });
    }

    function RenderSelectedDynFields() {
        var list = $('#selectedDynFieldsList');
        list.empty();
        
        if (selectedFields.length === 0) {
            list.append('<div class="text-muted text-center p-t-20" id="emptyDynSelectionMsg">No fields selected yet. Click fields on the left to add them in your desired column order.</div>');
            return;
        }
        
        $.each(selectedFields, function(index, itemObj) {
            var labelText = itemObj.id.indexOf("EMPTY_COLUMN_") === 0 ? "Empty Column" : itemObj.id;
            var item = $('<div class="list-group-item" data-index="' + index + '" style="padding: 6px 12px; margin-bottom: 4px; border: 1px solid #ddd; border-radius: 4px; background:#fff; display: flex; justify-content: space-between; align-items: center; cursor: move;">' +
                '<span><i class="fa fa-bars text-muted m-r-10"></i> <b>' + (index + 1) + '.</b> ' +
                '  <input type="text" class="form-control col-header-input" data-index="' + index + '" value="' + itemObj.header + '" placeholder="Column Header" style="width: 160px; display: inline-block; height: 26px; padding: 2px 6px; font-size: 11px; margin-left: 5px; font-weight: bold; border-color: #348fe2;" />' +
                '  <small class="text-muted m-l-5">(' + labelText + ')</small>' +
                '</span>' +
                '<div>' +
                '  <button type="button" class="btn btn-xs btn-default" onclick="MoveDynField(' + index + ', -1)" style="margin-right:2px; padding: 2px 5px;"><i class="fa fa-arrow-up"></i></button>' +
                '  <button type="button" class="btn btn-xs btn-default" onclick="MoveDynField(' + index + ', 1)" style="margin-right:4px; padding: 2px 5px;"><i class="fa fa-arrow-down"></i></button>' +
                '  <button type="button" class="btn btn-xs btn-danger" onclick="RemoveDynField(' + index + ')" style="padding: 2px 5px;"><i class="fa fa-times"></i></button>' +
                '</div>' +
                '</div>');
            
            // Bind input change
            item.find('.col-header-input').on('change keyup', function() {
                selectedFields[index].header = $(this).val();
            });
            
            list.append(item);
        });
        AddDragAndDropHandlersForDyn();
    }

    function AddDragAndDropHandlersForDyn() {
        var items = document.querySelectorAll('#selectedDynFieldsList .list-group-item');
        var dragSrcEl = null;

        items.forEach(function(item) {
            item.setAttribute('draggable', 'true');
            
            item.addEventListener('dragstart', function(e) {
                dragSrcEl = this;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/html', this.innerHTML);
                this.style.opacity = '0.4';
            });

            item.addEventListener('dragover', function(e) {
                if (e.preventDefault) {
                    e.preventDefault();
                }
                e.dataTransfer.dropEffect = 'move';
                return false;
            });

            item.addEventListener('dragenter', function(e) {
                this.classList.add('over');
            });

            item.addEventListener('dragleave', function(e) {
                this.classList.remove('over');
            });

            item.addEventListener('drop', function(e) {
                if (e.stopPropagation) {
                    e.stopPropagation();
                }
                if (dragSrcEl !== this) {
                    var srcIndex = parseInt(dragSrcEl.getAttribute('data-index'));
                    var destIndex = parseInt(this.getAttribute('data-index'));
                    
                    var temp = selectedFields[srcIndex];
                    selectedFields.splice(srcIndex, 1);
                    selectedFields.splice(destIndex, 0, temp);
                    
                    RenderSelectedDynFields();
                }
                return false;
            });

            item.addEventListener('dragend', function(e) {
                this.style.opacity = '1.0';
                items.forEach(function(item) {
                    item.classList.remove('over');
                });
            });
        });
    }

    function MoveDynField(index, direction) {
        var targetIndex = index + direction;
        if (targetIndex >= 0 && targetIndex < selectedFields.length) {
            var temp = selectedFields[index];
            selectedFields[index] = selectedFields[targetIndex];
            selectedFields[targetIndex] = temp;
            RenderSelectedDynFields();
        }
    }

    function RemoveDynField(index) {
        selectedFields.splice(index, 1);
        RenderAvailableDynFields();
        RenderSelectedDynFields();
    }

    $('#searchDynFields').on('keyup', function() {
        RenderAvailableDynFields();
    });

    function ToggleReportTitleInput(show) {
        if (show) {
            $('#divReportTitle').show();
        } else {
            $('#divReportTitle').hide();
        }
    }

    function getStudentPropValue(student, field) {
        if (!student) return '';
        if (student[field] !== undefined && student[field] !== null) {
            return student[field];
        }
        var upper = field.toUpperCase();
        if (student[upper] !== undefined && student[upper] !== null) {
            return student[upper];
        }
        var lower = field.toLowerCase();
        if (student[lower] !== undefined && student[lower] !== null) {
            return student[lower];
        }
        var keys = Object.keys(student);
        for (var i = 0; i < keys.length; i++) {
            if (keys[i].toLowerCase() === field.toLowerCase()) {
                return student[keys[i]] !== null ? student[keys[i]] : '';
            }
        }
        return '';
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function renderTable(students, fields) {
        var tbl = '<div class="table-responsive">';
        tbl += '  <table class="table table-bordered table-striped table-hover">';
        tbl += '    <thead>';
        tbl += '      <tr>';
        tbl += '        <th style="width: 50px; text-align: center;">S.No</th>';
        $.each(fields, function(i, field) {
            tbl += '    <th>' + escapeHtml(field.header) + '</th>';
        });
        tbl += '      </tr>';
        tbl += '    </thead>';
        tbl += '    <tbody>';
        
        $.each(students, function(idx, student) {
            tbl += '    <tr>';
            tbl += '      <td style="text-align: center;">' + (idx + 1) + '</td>';
            $.each(fields, function(i, field) {
                var val = '';
                if (field.id.indexOf("EMPTY_COLUMN_") === 0) {
                    val = '';
                } else {
                    val = getStudentPropValue(student, field.id);
                }
                tbl += '  <td>' + escapeHtml(val) + '</td>';
            });
            tbl += '    </tr>';
        });
        
        tbl += '    </tbody>';
        tbl += '  </table>';
        tbl += '</div>';
        return tbl;
    }

    function GenerateDynamicReport() {
        var acYear = $('#DynAcademicYear option:selected').text();
        var classIDs = String($("#DynClassName").val());
        
        if (!acYear || !classIDs || classIDs === "null" || classIDs === "") {
            swal({ title: "Error !", text: "Please select Academic Year and Class Name.", type: "error" });
            return;
        }
        if (selectedFields.length === 0) {
            swal({ title: "Error !", text: "Please select at least one field.", type: "error" });
            return;
        }
        
        var reportType = $("input[name='radReportType']:checked").val();
        var reportTitle = $("#txtReportTitle").val().trim();
        
        if (reportType === "classwise" && !reportTitle) {
            swal({ title: "Error !", text: "Please enter a Report Title for Class-Wise Report.", type: "error" });
            return;
        }
        
        $('#modalDynamicReport').modal('hide');
        $('#loader').show();
        
        $.ajax({
            url: '@Url.Action("GetStudentDetailsForDynamicReport", "Student")',
            method: 'POST',
            data: { sAcYear: acYear, sClassIDs: classIDs },
            success: function(res) {
                $('#loader').hide();
                if (res.ErrorCode === "Ok" && res.Data && res.Data.length > 0) {
                    var html = '';
                    
                    html += '<style>';
                    html += '  .class-wise-report-block { margin-bottom: 30px; }';
                    html += '  @@media print {';
                    html += '    .class-wise-report-block { page-break-after: always !important; break-after: page !important; margin-bottom: 0 !important; }';
                    html += '    .class-wise-report-block:last-child { page-break-after: avoid !important; break-after: avoid !important; }';
                    html += '    .report-title-container { text-align: center; margin-bottom: 20px; }';
                    html += '    .report-title-main { font-size: 20px; font-weight: bold; text-transform: uppercase; margin: 5px 0; }';
                    html += '    .report-title-class { font-size: 16px; font-weight: bold; margin: 5px 0; }';
                    html += '  }';
                    html += '</style>';
                    
                    if (reportType === "classwise") {
                        var groups = {};
                        $.each(res.Data, function(i, student) {
                            var className = getStudentPropValue(student, "CLASS_NAME") || "Unknown Class";
                            if (!groups[className]) {
                                groups[className] = [];
                            }
                            groups[className].push(student);
                        });
                        
                        var classNames = Object.keys(groups).sort();
                        $.each(classNames, function(idx, className) {
                            var students = groups[className];
                            html += '<div class="class-wise-report-block">';
                            html += '  <div class="report-title-container">';
                            html += '    <div class="report-title-main">' + escapeHtml(reportTitle) + '</div>';
                            html += '    <div class="report-title-class">' + escapeHtml(className) + '</div>';
                            html += '  </div>';
                            html += renderTable(students, selectedFields);
                            html += '</div>';
                        });
                    } else {
                        html += '<div class="report-title-container">';
                        html += '  <div class="report-title-main">Student Dynamic Report</div>';
                        html += '</div>';
                        html += renderTable(res.Data, selectedFields);
                    }
                    
                    $("#divbind").empty().append(html);
                    $(".btnPrintDiv").show();
                    $(".btnExcelDiv").show();
                } else {
                    swal({ title: "Error !", text: res.Message || "No data found.", type: "error" });
                }
            },
            error: function() {
                $('#loader').hide();
                swal({ title: "Error !", text: "Internal Server Error occurred during report generation.", type: "error" });
            }
        });
    }
</script>

<!-- ================== Consolidate Admission Details Report Script ================== -->
<script>
    function initConsolidateAdmissionDefaults() {
        $('#divbind').html('');
        $(".btnPrintDiv").hide();
        $(".btnExcelDiv").hide();

        // Default selection for ClassLevel if not selected
        if (!$("#ConsolidateClassLevel").val() || $("#ConsolidateClassLevel").val().length === 0) {
            $("#ConsolidateClassLevel option").prop("selected", true);
            $("#ConsolidateClassLevel").selectpicker('refresh');
        }

        // Default selection for ClassYear if not selected (defaults to Year 1)
        if (!$("#ConsolidateClassYear").val() || $("#ConsolidateClassYear").val().length === 0) {
            var optYear1 = $("#ConsolidateClassYear option").filter(function () { return $(this).text().trim() === "I" || $(this).val() === "1"; });
            if (optYear1.length > 0) {
                optYear1.prop("selected", true);
            } else {
                $("#ConsolidateClassYear option").prop("selected", true);
            }
            $("#ConsolidateClassYear").selectpicker('refresh');
        }

        // Default selection for Shift if not selected
        if (!$("#ConsolidateShift").val() || $("#ConsolidateShift").val().length === 0) {
            $("#ConsolidateShift option").prop("selected", true);
            $("#ConsolidateShift").selectpicker('refresh');
        }

        // Default Academic Year to current if not set
        if (!$("#ConsolidateAcYear").val() || $("#ConsolidateAcYear").val() === "" || $("#ConsolidateAcYear").val() === "0") {
            var optCurrent = $("#ConsolidateAcYear option").filter(function () { return $(this).text().trim() === "2026"; });
            if (optCurrent.length > 0) {
                $("#ConsolidateAcYear").val(optCurrent.val());
            } else if ($("#ConsolidateAcYear option").length > 1) {
                $("#ConsolidateAcYear").prop('selectedIndex', 1);
            }
            $("#ConsolidateAcYear").selectpicker('refresh');
        }

        loadConsolidateAdmissionReport();
    }

    $('#ConsolidateAdmissionDetailsTab').on('click', function () {
        initConsolidateAdmissionDefaults();
    });

    $('a[href="#BindConsolidateAdmissionDetails"]').on('shown.bs.tab', function () {
        initConsolidateAdmissionDefaults();
    });

    if (window.location.hash === '#BindConsolidateAdmissionDetails') {
        setTimeout(function () {
            $('a[href="#BindConsolidateAdmissionDetails"]').tab('show');
            initConsolidateAdmissionDefaults();
        }, 200);
    }

    $("#ConsolidateAcYear").on("change", function () {
        loadConsolidateAdmissionReport();
    });
    $("#ConsolidateClassLevel").on("change", function () {
        loadConsolidateAdmissionReport();
    });
    $("#ConsolidateClassYear").on("change", function () {
        loadConsolidateAdmissionReport();
    });
    $("#ConsolidateShift").on("change", function () {
        loadConsolidateAdmissionReport();
    });

    function loadConsolidateAdmissionReport() {
        var acYear = $('#ConsolidateAcYear option:selected').text().trim();
        if (acYear === "-- Select --" || acYear === "--select--" || acYear === "0") {
            acYear = '';
        }
        var classLevel = $("#ConsolidateClassLevel").val() ? String($("#ConsolidateClassLevel").val()) : '';
        var classYear = $("#ConsolidateClassYear").val() ? String($("#ConsolidateClassYear").val()) : '';
        var shift = $("#ConsolidateShift").val() ? String($("#ConsolidateShift").val()) : '';

        $('#loader').show();
        $.ajax({
            url: "@Url.Action("BindConsolidateAdmissionDetails", "Student")",
            method: "POST",
            datatype: "json",
            data: { sAcYear: acYear, sClassLevel: classLevel, sShift: shift, sClassYear: classYear },
            success: function (data) {
                $('#loader').hide();
                $("#divbind").empty().append(data);
                $(".btnPrintDiv").show();
                $(".btnExcelDiv").show();
            },
            error: function (error) {
                $('#loader').hide();
                alert('Internal Server Error !');
            }
        });
    }
</script>



