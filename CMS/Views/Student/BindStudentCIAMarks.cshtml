@model CMS.ViewModel.ViewModel.StudentViewModel
@{ Layout = null; int count = 0; int rcount = 0;  }
<div class="table table-responsive">
    <table class="table table-bordered table-hover" id="tblBindStudent">
        <thead>
            <tr>
                <th>#</th>
                <th>Course</th>
                <th>Component</th>
                <th>Mark</th>                
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.liCIA_Marks_Info != null && Model.liCIA_Marks_Info.Count > 0)
                {
                    var Courselist = Model.liCIA_Marks_Info.GroupBy(o => o.COURSE_ROOT_ID).ToList();

                    foreach (var item in Courselist)
                    {
                        var Component = (Model.liCIA_Marks_Info.Where(o => o.COURSE_ROOT_ID == item.FirstOrDefault().COURSE_ROOT_ID).ToList());
                        rcount = Component.Count+1;
                        <tr>
                            <td rowspan="@rcount">@{count++;}@count</td>
                            <td rowspan="@rcount">@Component.FirstOrDefault().COURSE_TITLE</td>
                           @{ 
                               foreach (var comitem in Component)
                               {
                                   <tr>
                                       <td>@comitem.COMPONENT-@comitem.MAX_MARK</td>
                                       <td>@comitem.COURSE_GROUP_MARK</td>
                                  </tr>
                               }                              
                           }                                                
                        </tr>
                                   }
                               }

            }
        </tbody>
    </table>
</div>