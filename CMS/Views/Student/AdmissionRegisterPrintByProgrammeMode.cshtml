<div id="content" class="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">AdmissionRegisterPrintByProgrammeMode</li>
    </ol>
    <h1 class="page-header">AdmissionRegisterPrintByProgrammeMode<small></small></h1>
    <div class="panel panel-primary">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">AdmissionRegisterPrintByProgrammeMode</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            <label class="control-label col-md-4">AcademicYear</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="control-label col-md-4">ApplicationType</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ApplicationType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            <label class="control-label col-md-4">Shift</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="control-label col-md-4">Programme Mode</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ProgrammeMode, (Model.ProgrammeMode != null) ? Model.ProgrammeMode : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ProgrammeMode, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            <label class="control-label col-md-4">Programme</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" , multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" class="btn btn-success" id="btnPrint" onclick="printDiv('dvAdmissionRegisterbyProgrammeMode')">Print</a>
                        </div>
                       
                        
                    </div>
                    <div class="col-md-12 table-responsive">
                        <div id="dvAdmissionRegisterbyProgrammeMode">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script>
    ContentLoad = function () {
    }
    $('.selectpicker').selectpicker({
        size: 4
    });

    $('#ShiftList').on("change", function () {
        LoadProgramme();
    });

    $('#ApplicationType').on("change", function () {
        LoadProgramme();
    });

    $('#ProgrammeMode').on("change", function () {
        LoadProgramme();
    });

    LoadProgramme = function () {
        var ShiftList = $('#ShiftList').val();
        var ProgrammeModeList = $('#ProgrammeMode').val();
        var ApplicationType = $('#ApplicationType').val();
        if (ShiftList != 0 && ProgrammeModeList != 0 && ApplicationType != 0) {
            $.ajax({
                url: "@Url.Action("BindProgrammeGroupByShiftAndProgrammeModeAndAppType", "Fee")",
                method: "POST",
            datatype: "json",
            data: { sShift: ShiftList, sProgrammeMode: ProgrammeModeList, sApplicationType: ApplicationType },
            success: function (data) {
                $("#ProgrammeList").empty();
                $("#ProgrammeList").append(data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    } else {
        $('.selectpicker').selectpicker('refresh');
        return false;
    }
    };
    $('#btnGet').on('click', function () {
        var vApplicationType = String($('#ApplicationType').val());
        var vProgrammeList = String($('#ProgrammeList').val());
        $.ajax({
            url: "@Url.Action("PrintAdmissionRegisterByProgrammeMode", "Student")",
            method: "POST",
            datatype: "json",
            data: { sAcademicYear: $('#AcademicYearList').val(), sApplicationType: vApplicationType, sShift: $('#ShiftList').val(), sProgrammeMode: $('#ProgrammeMode').val(), sProgrammeGroupId: vProgrammeList },
            success: function (data) {
                var AdmissionRegister = $('#dvAdmissionRegisterbyProgrammeMode');
                AdmissionRegister.empty();
                AdmissionRegister.append(data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        })
    });   
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        //loadContent('/Student/SemesterMarkSheetPrint');
    }
</script>
