@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "OnlineExamEntry";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
}





<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Online Exam Entry</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Online Exam Entry</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" id="panel-expand" class="btn btn-xs btn-icon btn-circle btn-default disabled" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success disabled" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning disabled" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger disabled" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Online Exam Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal" id="dvListOnlineQuizQuestions">
                    <div class="note note-secondary m-b-15">
                        <h4><b>Importent Notes!</b></h4>
                        <p>
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                            Maecenas id gravida libero. Etiam semper id sem a ultricies.
                        </p>
                    </div>
                    <div class="col-md-12 table-responsive">
                        @{
                            if (Model.liOnlineExaminationList != null && Model.liOnlineExaminationList.Count > 0)
                            {
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Date</th>
                                            <th>Course</th>
                                            <th>Time</th>
                                            <th>Action</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            foreach (var item in Model.liOnlineExaminationList)
                                            {
                                                <tr>
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.EXAM_DATE</td>
                                                    <td>@item.COURSE_CODE - @item.COURSE_TITLE</td>
                                                    <td>@item.TIME</td>
                                                    <td>
                                                        @{
                                                            if (item.STATUS == "1")
                                                            {
                                                                @*<a class="btn btn-success" onclick="GetQuizResult(@item.COURSE_ID,@item.STAFF_ID,@item.SETTING_ID);" href="javascript:;">Quiz Result</a>*@
                                                                <a class="btn btn-success" href="javascript:;">Answers Submitted</a>
                                                            }
                                                            else
                                                            {
                                                                @*<a class="btn btn-primary" onclick="GetQuizQuestions(document.body,@item.CLASS_ID,@item.COURSE_ID,@item.SETTING_ID,@item.STAFF_ID,@item.TIME);" href="javascript:;">Quiz Entry</a>*@
                                                                <a class="btn btn-primary" onclick="GetQuizQuestions(document.body,@item.EXAM_SETTING_ID,@item.TIME )">Ready To Write</a>
                                                            }
                                                        }
                                                    <td>
                                                        @{
                                                            if (item.STATUS == "1")
                                                            {
                                                                <i class="ion-ios-checkmark-outline fa-2x text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="ion-ios-close-outline fa-2x text-danger"></i>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                                            }
                                        }
                                    </tbody>
                                </table>
                                                            }
                        }
                    </div>
                </div>
                                                            }

            <div class="col-md-12" id="dvOnlineQuiz">

            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
        //mKeyF11();
        //$('#panel-expand').click();
        window.personalbar = false;
       
    }

    

    function GetQuizQuestions(elem, sSettingId, sTime) {

        if ((document.fullScreenElement !== undefined && document.fullScreenElement === null) || (document.msFullscreenElement !== undefined && document.msFullscreenElement === null) || (document.mozFullScreen !== undefined && !document.mozFullScreen) || (document.webkitIsFullScreen !== undefined && !document.webkitIsFullScreen))
        {
           // alert(elem);
            if (elem.requestFullScreen)
            {
                elem.requestFullScreen();
            } else if (elem.mozRequestFullScreen)
            {
                elem.mozRequestFullScreen();
            } else if (elem.webkitRequestFullScreen)
            {
                elem.webkitRequestFullScreen(Element.ALLOW_KEYBOARD_INPUT);
            } else if (elem.msRequestFullscreen)
            {
                elem.msRequestFullscreen();
            }
        }


        loadContent('/Student/BindOnlineExamQuestions?sExamSettingId=' + sSettingId + '&sTime=' + sTime + '');

        //var e = new Event('keypress');
        //e.which = 122; // Character F11 equivalent.
        //e.altKey = false;
        //e.ctrlKey = false;
        //e.shiftKey = false;
        //e.metaKey = false;
        //e.bubbles = true;
        //document.dispatchEvent(e);
        @*$.ajax({
                url: '@Url.Action("BindOnlineQuizForSetWise", "Student")',
                method:'POST',
                datatype:'json',
                data: { sClassId: ClassId, sCourseId: CourseId, sSettingId: SettingId, sStaffId: StaffId, sTime: Time },
                success: function (data)
                {
                    if (data.Message!=null && data.Message!='')
                    {
                        alert(data.Message);
                        if (data.sResult == "1")
                        {
                            $('#dvListOnlineQuizQuestions').addClass('hidden');
                            //$('#panel-expand').click();
                            GetQuizResult(CourseId, StaffId, SettingId);
                            //loadContent('/Student/BindOnlineQuizResultForStudent?sClassId=' + ClassId + '&sCourseId=' + CourseId + '&sSettingId=' + SettingId + '&sStaffId=' + StaffId + '');
                        }
                    } else
                    {
                        loadContent('/Student/BindOnlineQuizForSetWise?sClassId=' + ClassId + '&sCourseId=' + CourseId + '&sSettingId=' + SettingId + '&sStaffId=' + StaffId + '&sTime=' + Time + '');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });*@
    }

    function mKeyF11() {

        var e = new Event('keypress');
        e.which = 122; // Character F11 equivalent.
        e.altKey = false;
        e.ctrlKey = false;
        e.shiftKey = false;
        e.metaKey = false;
        e.bubbles = true;
        document.dispatchEvent(e);
        alert('Test');
    }

</script>
