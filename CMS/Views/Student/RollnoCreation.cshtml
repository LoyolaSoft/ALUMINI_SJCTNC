
@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "TCSerialNoUpdate";
    Layout = null;
}
<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">Bulk Roll No Creation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Bulk Roll No Creation</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Bulk Roll No Creation </h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.programmeLevel, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.programmeLevel, (Model.programmeLevel != null) ? Model.programmeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.programmeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgramName, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ClassName, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-2">
                                <a id="btnGet" class="btn btn-info" onclick="fetchStudentDetails()">Get</a>
                        </div>
                    </div>
                    <br />
                   
                    <hr />
                    <div class="col-md-12" id="divbind">

                    </div>

                </div>
            }


        </div>
    </div>
    <!-- end panel -->
</div>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->

<script>
        $('.selectpicker').selectpicker({
            size: 4
        });
        ContentLoad = function () {

                $("#TransferCertificate").hide();
                $("#tittle").hide();

                var sOption = '<option value="">-- Select --</option>';

                $("#ClassName").empty();
                $("#ClassName").append(sOption);
                $("#ProgramName").empty();
                $("#ProgramName").append(sOption);
                $("#StuName").empty();
                $("#StuName").append(sOption);
                $('.selectpicker').selectpicker('refresh');
                //$("#btnTCIssueUpdate").hide();
                handleSelect2 = function () {
                    $(".default-select2").select2(), $(".multiple-select2").select2({
                        placeholder: "Select a Sudent"
                    })
                }
        }
        $("#ProgramName").on("change", function () {
            FetchClass();
        });
        
        function FetchClass()
        {
                var ProgramName = String($("#ProgramName").val());
                
            var sShift = $("#ShiftList").val();
            if ( $("#ShiftList").val() && $("#ProgramName").val())
            {
                $.ajax({
                    url: "@Url.Action("BindDDLClassListonlyFirstYear", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sProgramId: ProgramName, sShiftId: sShift},
                    success: function (data) {
                        $("#ClassName").empty();
                        $("#ClassName").append("<option value=''>--- Select ---</option>"+ data);
                        $('.selectpicker').selectpicker('refresh');
                    }, error: function (error) {
                        alert('Internal Server Error ! ');
                    }
                });
            }
        };

    $("#ShiftList").on("change", function ()
    {
        fetchProgramme();
    });
    $("#programmeLevel").on("change", function ()
    {
        fetchProgramme();
    });
    function fetchProgramme()
    {
        var sShift = $("#ShiftList").val();
        var pLevel = $("#programmeLevel").val();
        if ($("#ShiftList").val() && $("#programmeLevel").val())
        {
            $.ajax({
                url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift, programmeLevel: pLevel },
                success: function (data) {
                    $("#ProgramName").empty();
                    $("#ProgramName").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    $("#ClassName").on("change", function () {
        fetchStudentDetails();
    });
    $("#AcademicYear").on("change", function () {
        fetchStudentDetails();
    });
    function fetchStudentDetails()
    {
            var ProgramName = $("#ProgramName").val();
        var programmLevel = $("#programmeLevel").val();
            var ClassName = String($("#ClassName").val());
            var AcademicYear = $('#AcademicYear option:selected').text();
            if ($("#ClassName").val() && $('#AcademicYear option:selected').text())
            {
                if (AcademicYear == '' || AcademicYear == '0') {
                    alert('Please Choose All The Values...!!!');
                    return false;
                }
                $.ajax({
                    url: "@Url.Action("BindStudents", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sClassId: ClassName, sProgrammLevel: programmLevel, sAcademicYear: AcademicYear },
                    success: function (data) {
                        $("#divbind").empty();
                        $("#divbind").append(data);

                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }
    };

</script>




