@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "FetchNodueCertificate";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    string pdfname = ViewBag.stuid + ".pdf#view=FitH&scrollbar=0&toolbar=0&statusbar=0&messages=0&navpanes=0";
    string pdfnamed = ViewBag.stuid + ".pdf";
}
<link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("STUDENT","DashBoard")">Home</a></li>
        <li><a href="@Url.Action("","Student")">No Due Form</a></li>
        <li class="active">No Due Form</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">No Due Form</h1>
    <!-- end page-header -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">No Due Form</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                if (Model.liNodueDefaulters != null && Model.liNodueDefaulters.Count > 0)
                {
                    <div style="background: #f5d9b3; padding: 10px; ">
                        Your No Due Form is unavailable Reason:
                        <div style="margin-left:30px">
                            <br /> <span class="text-center">@Model.liNodueDefaulters.FirstOrDefault().REASON</span>
                        </div>
                        <br />
                    </div>

                }
                else
                {
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="col-md-12 mb-2">
                            <div class="pull-right"> <a href="/Content/NoDueFrom/@pdfnamed" target="_blank" class="btn btn-primary">Print</a></div>
                        </div>
                        <br />  <br />
                        <div class="col-md-12">
                            <iframe src="~/Content/NoDueFrom/@pdfname" width="100%" height="700" allowfullscreen
                                    type="application/pdf"></iframe>
                        </div>

                    </div>
                }

            }
        </div>
    </div>

</div>

<script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

