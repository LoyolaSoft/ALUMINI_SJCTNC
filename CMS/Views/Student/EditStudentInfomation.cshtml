<script>
    
    function ContentLoad() {        
          Notification.init();
        handleDatepicker = function () {
            "use strict";
            $("#txtAdmissionDate,#txtsRegisterdate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
               // 'top': top,
               // 'left': left
            }
            )
        }
        handleDatepicker();

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

        // Fetch Academic ...
        AcadamicInfo=function()
        {
            $.ajax({
                url:"@Url.Action("FetchAcadamicInfo", "Student")",
                method: "POST",
                dtatype: "html",
                success: function (data)

                {
                    $("#txtRegNo").val(data.RegisterNo);
                    $("#txtRollNo").val(data.RollNo);
                    $("#txtURollNo").val(data.URollNo);
                    $("#txtAdmissionNo").val(data.AdmissionNo);
                    $("#txtAdmissionDate").val(data.AdmissionDate);
                    $("#txtAdmitClass").val(data.AdmittedClass);
                    $("#txtsRegisterdate").val(data.sRegisterDate);
                    $("#txtRemark").val(data.Remarks);
                    $("#ddlBatch").val(data.Batch);
                    $("#ddlClass").val(data.Class);
                    $("#FIRSTNAME").val(data.FIRST_NAME);
                    $("#LASTNAME").val(data.LAST_NAME);
                    $("#ddlCurrentBatch").val(data.CurrentBatch);
                    //$("#ddlDeprt").val(data.Department);
                    //$("#ddlProgram").val(data.Program);
                    $("#txtTcSNo").val(data.TCSerialNo);
                    //$("#txtShift").val(data.Shift);
                    $("#txtEmail").val(data.Stu_Email);
                    //$("#Role").val(data.Role);
                    //$("#UserType").val(data.UserType);
                    $('#img').attr('src', data.PHOTO);
                    if (data.IsLeft=="1") 
                    {
                        $("#chLeft").attr("checked","checked");
                    }
                    $('.selectpicker').selectpicker('refresh');
                },error:function(error)
                {
                    myAlert('Internal Server Error ..!', 'gritter-danger', '');
                }
            });
      }
        AcadamicInfo();
    }
</script>

<script>

    // Update Academic info ...
    $("#btnEditStudentAcadamic").on("click",function()
    {
        var isValid = true;
        if ($('#nav-tab2-1').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }
        var RegisterNo= $("#txtRegNo").val();
        var RollNo= $("#txtRollNo").val();
        var URollNo= $("#txtURollNo").val();
        var AdmissionNo= $("#txtAdmissionNo").val();
        var AdmissionDate= $("#txtAdmissionDate").val();
        var AdmittedClass= $("#txtAdmitClass").val();
        var sRegisterDate= $("#txtsRegisterdate").val();
        var Remarks= $("#txtRemark").val();
        var Batch= $("#ddlBatch").val();
        var Class = $("#ddlClass").val();
        var FIRST_NAME = $("#FIRSTNAME").val();
        var LAST_NAME = $("#LASTNAME").val();
        //var Department= $("#ddlDeprt").val();
        //var Program= $("#ddlProgram").val();
        var TCSerialNo= $("#txtTcSNo").val();
        //var Shift= $("#txtShift").val();
        var Email= $("#txtEmail").val();
        //var Role = '';
        //Role = $("#Role").val();
        //var UserType = '';

        //UserType = $("#UserType").val();
        var IsLeft = 0;
        if ($('#chLeft').attr('checked'))
        {
            IsLeft=$("#chLeft").val();
        }
        else
        {
            IsLeft=0;
        }
        var fileUpload = $("#inputimg").get(0);
        var files = fileUpload.files;
        // Create FormData object
        var fileData = new FormData();

        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }
        fileData.append("RollNo", RollNo);
        var JsonData;
        if (JsonData==null)
        {
            JsonData = '{"LAST_NAME":"' + LAST_NAME + '","FIRST_NAME":"' + FIRST_NAME + '","IsLeft":"' + IsLeft + '","Stu_Email":"' + Email + '","RollNo":"' + RollNo + '","URollNo":"' + URollNo + '","AdmissionNo":"' + AdmissionNo + '","AdmissionDate":"' + AdmissionDate + '","AdmittedClass":"' + AdmittedClass + '","sRegisterDate":"' + sRegisterDate + '","Remarks":"' + Remarks + '","Batch":"' + Batch + '","CLASS_ID":"' + Class + '","TCSerialNo":"' + TCSerialNo + '","RegisterNo":"' + RegisterNo + '","CurrentBatch":"' + $('#ddlCurrentBatch').val() + '"}';
        }
        fileData.append("str", JsonData);
        $.ajax({
            url:"@Url.Action("EditAcadamicInfo", "Student")",
            method:"POST",
            contentType: false, 
            processData: false,
            data: fileData,
            success:function(data)
            {
                if (data == "200")
                    swal({ title: "Success !", text: 'Record(s) saved successfully !', showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                else if (data == "406")
                    swal({ title: "Failed !", text: 'Failed to save Records !', showConfirmButton: false, timer: 2000, type: 'error', animation: true });
            },error:function(error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    // Bind Course By DepartmentID
    $("#ddlDeprt").on("change", function ()
    {
        var Department = $("#ddlDeprt").val();

        $.ajax({
            url:"@Url.Action("FetchProgrammeByID", "Student")",
            method: "POST",
            datatype: "html",
            data: { Department: Department },
            success:function(option)
            {
                var select = $("#ddlProgram");
                select.empty();
                select.append('<option value="">-- select --</option>' + option);
                $('.selectpicker').selectpicker('refresh');
            },error:function(error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    // Fetch Class By ShiftID
    $("#Shift").on("change", function ()
    {
        var Shift = $("#Shift").val();

        $.ajax({
            url:"@Url.Action("FetchClassByID", "Student")",
            method: "POST",
            datatype: "html",
            data: { ShiftID: Shift },
            success: function (option)
            {
                var select = $("#ddlClass");
                select.empty();
                select.append('<option value="">-select--</option>' + option);
                $('.selectpicker').selectpicker('refresh');
            },error:function(error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

</script>
    
