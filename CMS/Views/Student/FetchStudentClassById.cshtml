
@model CMS.ViewModel.ViewModel.StudentViewModel


<div class="form-group">
    <div class="col-md-12 table-responsive">
        @{int count = 0; }
        <table id="tblStudentList" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Name in Tamil</th>
                    <th>Date Of Birth</th>
                    <th>Class</th>
               
                </tr>
            </thead>
            <tbody>
                @if (Model.liStudent != null)
                {
                    foreach (var item in Model.liStudent)
                    {
                        <tr>
                            <td>@{count++;} @count</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td style="font-family: 'Bamini Tamil';">@item.NAME_IN_NATIVE</td>
                            <td>@item.DATE_OF_BIRTH</td>
                            <td>@item.CLASS_ID</td>             

                        </tr>
                                    }
                                }

            </tbody>
        </table>
    </div>

</div>