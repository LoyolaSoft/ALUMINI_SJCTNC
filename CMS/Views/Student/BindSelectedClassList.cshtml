@model CMS.ViewModel.ViewModel.StudentViewModel

@{ Layout = null; int count = 0;}
<table class="table table-responsive table-hover table-bordered" id="ClassList">
    <thead>
        <tr>
            <th>#</th>
            <th>Current Class</th>
            <th class="hidden">Current ClassId</th>
            <th>Class For Promotion</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.lstStudentPromotion != null && Model.lstStudentPromotion.Count>0)
        {
            foreach (var item in Model.lstStudentPromotion)
            {
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>@item.CLASS_CODE</td>
                    <td class="hidden" cms-cclassid="@item.CLASS_ID">@item.CLASS_ID</td>
                    <td>
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlClassForPromotion" })
                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                        </div>
                    </td>
                </tr>
                                }
                            }
    </tbody>
</table>
