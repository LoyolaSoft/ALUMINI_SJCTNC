@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
    int count = 0;
}

<style>
    #tblTransferLogs {
        font-size: 13px;
    }
    #tblTransferLogs th {
        font-size: 13px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        background-color: #f1f5f9 !important;
        vertical-align: middle !important;
        text-align: center;
        padding: 10px 8px !important;
    }
    #tblTransferLogs td {
        font-size: 13px !important;
        color: #1e293b !important;
        vertical-align: middle !important;
        padding: 10px 8px !important;
    }
    .badge-roll-old {
        background-color: #fee2e2 !important;
        color: #991b1b !important;
        border: 1px solid #f87171 !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        padding: 5px 8px !important;
        text-decoration: line-through !important;
        border-radius: 4px;
        display: inline-block;
    }
    .badge-roll-new {
        background-color: #dbeafe !important;
        color: #1e40af !important;
        border: 1px solid #3b82f6 !important;
        font-size: 13px !important;
        font-weight: 800 !important;
        padding: 5px 10px !important;
        border-radius: 4px;
        display: inline-block;
    }
    .class-text-prev {
        font-weight: 600;
        color: #475569;
        font-size: 13px;
    }
    .class-text-next {
        font-weight: 700;
        color: #1d4ed8;
        font-size: 13px;
    }
</style>

<div class="table-responsive">
    <table class="table table-hover table-bordered table-striped" id="tblTransferLogs" width="100%">
        <thead>
            <tr>
                <th style="width: 40px;">#</th>
                <th style="width: 140px;">Date & Time</th>
                <th>Student Name</th>
                <th style="width: 230px;">Roll No Transition</th>
                <th>Previous Class</th>
                <th>Transferred Class</th>
                <th style="width: 100px;">Academic Year</th>
                <th>Remarks</th>
                <th style="width: 110px;">Transferred By</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liProgrammeTransferLogs != null && Model.liProgrammeTransferLogs.Count > 0)
            {
                foreach (var log in Model.liProgrammeTransferLogs)
                {
                    count++;
                    <tr>
                        <td class="text-center font-bold" style="font-size: 14px;">@count</td>
                        <td class="text-center" style="white-space: nowrap;">
                            <div style="font-weight: 600; font-size: 12px; color: #1e293b;">
                                <i class="fa fa-calendar text-primary"></i> @log.TRANSFER_DATE
                            </div>
                        </td>
                        <td>
                            <div style="font-weight: 700; color: #0f172a; font-size: 14px;">
                                @log.STUDENT_NAME
                            </div>
                        </td>
                        <td class="text-center" style="white-space: nowrap;">
                            <span class="badge-roll-old" title="Previous Roll No">@log.CURRENT_ROLL_NO</span>
                            <i class="fa fa-arrow-right text-success" style="font-size: 13px; margin: 0 5px; font-weight: bold;"></i>
                            <span class="badge-roll-new" title="New Roll No">@log.NEW_ROLL_NO</span>
                        </td>
                        <td>
                            <div class="class-text-prev">
                                @log.CURRENT_CLASS_NAME
                            </div>
                        </td>
                        <td>
                            <div class="class-text-next">
                                <i class="fa fa-check-circle text-primary" style="font-size: 12px;"></i> @log.TRANSFER_CLASS_NAME
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="label label-primary" style="font-size: 12px; font-weight: 700; padding: 4px 8px; border-radius: 4px;">
                                @log.ACADEMIC_YEAR
                            </span>
                        </td>
                        <td>
                            <div style="font-size: 13px; color: #334155; line-height: 1.4;">
                                @(string.IsNullOrEmpty(log.REMARKS) ? "-" : log.REMARKS)
                            </div>
                        </td>
                        <td class="text-center">
                            <div style="font-weight: 600; color: #475569; font-size: 12px;">
                                <i class="fa fa-user text-muted"></i> @log.TRANSFERRED_BY
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted" style="padding: 35px; font-size: 14px;">
                        <i class="fa fa-history text-muted" style="font-size: 30px; display: block; margin-bottom: 10px;"></i>
                        No programme transfer log records found for the selected academic year.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
