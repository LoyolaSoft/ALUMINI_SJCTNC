@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
}
<div class="table-responsive">
    <center><h4>Date:@ViewBag.Date</h4></center>
    <table class="table table-bordered">
        <thead>
            <tr>
                
                @if(Model.liHours!=null && Model.liHours.Count>0)
                {
                    foreach(var item in Model.liHours)
                    {
                        <td>@item.HOUR</td>
                    }
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                @if (Model.liHours != null && Model.liHours.Count > 0)
                {
                    foreach (var item in Model.liHours)
                    {

                        if (Model.liAttendance != null && Model.liAttendance.Count > 0)
                        {
                            var hour = Model.liAttendance.Where(o => o.HOUR_FROM == item.HOUR_ID).ToList();
                            if (hour != null && hour.Count > 0)
                            {
                                <td>@hour.FirstOrDefault().ATTENDANCE_TYPE</td>
                            }
                            else
                            {
                                <td>Present</td>
                            }
                        }
                        else
                        {
                            <td>Present</td>
                        }

                    }
                }
            </tr>
            </tbody>
    </table>
</div>