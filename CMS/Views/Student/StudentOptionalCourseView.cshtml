@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "StudentOptionalCourseView";
    Layout = null;
}
<style>

    /* Style the checkbox */
    input[type="checkbox"] {
        width: 20px;
        height: 20px;
        appearance: none; /* Remove default styling */
        border: 2px solid #ccc;
        border-radius: 5px;
        outline: none;
        cursor: pointer;
        transition: background-color 0.3s, border-color 0.3s;
    }

        /* When checkbox is checked */
        input[type="checkbox"]:checked {
            background-color: #4caf50; /* Green background when checked */
            border-color: #4caf50; /* Green border when checked */
        }

        /* When checkbox is unchecked */
        input[type="checkbox"]:not(:checked) {
            background-color: white;
        }

        /* Add a custom check mark */
        input[type="checkbox"]:checked::before {
            content: '✔'; /* Check mark symbol */
            color: white;
            font-size: 16px;
            position: absolute;
            top: 2px;
            left: 5px;
        }

    /* Offcanvas modal styling to simulate sidebar drawer */
    .modal.offcanvas {
        overflow: hidden;
    }
    .modal.offcanvas .modal-dialog {
        position: fixed;
        margin: auto;
        width: 600px;
        height: 100%;
        right: -600px;
        top: 0;
        bottom: 0;
        transition: right 0.3s ease-out;
    }
    .modal.offcanvas.in .modal-dialog {
        right: 0;
    }
    .modal.offcanvas .modal-content {
        height: 100%;
        border-radius: 0;
        border: none;
        box-shadow: -5px 0 15px rgba(0,0,0,0.15);
        overflow-y: auto;
    }
    .modal.offcanvas .modal-header {
        background-color: #244895;
        color: #fff;
        border-radius: 0;
    }
    .modal.offcanvas .modal-header .modal-title {
        color: #fff !important;
    }
    .modal.offcanvas .modal-header .close {
        color: #fff !important;
        opacity: 1 !important;
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Student Optional Course View </li>
    </ol>
    <h2 class="page-header">Student Optional Course View </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Optional Course View </h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.AcademicYear, "Year ", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ClassList, "Classes ", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4" style="display: flex; gap: 5px; flex-wrap: wrap;">
                        <a class="btn bg-green" title="Add" id="BulkAdd">
                            <i class="fa fa-plus"></i>Bulk Add
                        </a>
                        <a class="btn bg-blue" title="Bulk Excel Upload" id="BulkExcelUploadBtn" style="cursor: pointer;">
                            <i class="fa fa-file-excel-o"></i>Bulk Excel Upload
                        </a>
                    </div>



                </div>

                <div class="col-md-12 table-responsive">
                    <div id="divBind">
                        <!--Need to use this fied to bind Student List-->
                    </div>
                </div>
            </div>
        </div>
    </div>

}
</div>
<div class="modal fade" id="AddModal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-orange-lighter">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <p class="modal-title f-s-15 f-w-200 text-white">Add Student Optional Course</p>
            </div>
            <div class="modal-body">
                <div class="form-horizontal" style="display: flex; justify-content: center; align-items: center;">
                    <div style="max-width: 600px; width: 100%;">
                        <input type="hidden" class="form-control" id="studentid" />
                        <input type="hidden" class="form-control" id="semId" />

                        <!-- Name Input -->
                        <div class="form-group">
                            @Html.Label("Name", htmlAttributes: new { @class = "col-md-4 control-label text-center" })
                            <div class="col-md-8">
                                <input type="text" class="form-control" id="txtstudentname" disabled />
                            </div>
                        </div>

                        <!-- Reg No Input -->
                        <div class="form-group">
                            @Html.Label("Reg No", htmlAttributes: new { @class = "col-md-4 control-label text-center" })
                            <div class="col-md-8">
                                <input type="text" class="form-control" id="txtreg" disabled />
                            </div>
                        </div>

                        <!-- Is Tamil Checkbox -->
                        <div class="form-group text-center">
                            <div>
                                <label>
                                    <input type="checkbox" id="RegularClassOptionalCheckbox"> Is Tamil.?
                                </label>
                            </div>

                        </div>

                        <!-- Optional Course Dropdown -->
                        <div class="form-group">
                            @Html.Label("Courses", htmlAttributes: new { @class = "col-md-4 control-label text-center" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.OptionalCourseList,
                                    (Model.OptionalCourseList != null) ? Model.OptionalCourseList : Enumerable.Empty<SelectListItem>(),
                                    "--select--",
                                    new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.OptionalCourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <!-- Class Dropdown -->
                        <div class="form-group">
                            @Html.Label("Class", htmlAttributes: new { @class = "col-md-4 control-label text-center" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.SClassList,
                                    (Model.SClassList != null) ? Model.SClassList : Enumerable.Empty<SelectListItem>(),
                                    "--select--",
                                    new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.SClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="submit" id="btnSubmit" class="btn btn-sm btn-primary">Submit</button>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Excel Upload Offcanvas Modal -->
<div class="modal fade offcanvas" id="ExcelUploadModal-dialog" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-file-excel-o"></i> Student Optional Course Excel Upload</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <!-- Academic Year -->
                    <div class="form-group">
                        <label class="control-label col-md-4">Academic Year</label>
                        <div class="col-md-8">
                            @Html.DropDownList("UploadAcademicYear", (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "UploadAcademicYear", @data_live_search = "true" })
                        </div>
                    </div>

                    <!-- Semester -->
                    <div class="form-group">
                        <label class="control-label col-md-4">Semester</label>
                        <div class="col-md-8">
                            @Html.DropDownList("UploadSemester", (Model.SemesterList != null) ? Model.SemesterList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "UploadSemester", @data_live_search = "true" })
                        </div>
                    </div>

                    <!-- Course -->
                    <div class="form-group">
                        <label class="control-label col-md-4">Course</label>
                        <div class="col-md-8">
                            <select id="UploadCourse" class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" data-live-search="true">
                                <option value="">--select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Optional Class -->
                    <div class="form-group">
                        <label class="control-label col-md-4">Optional Class</label>
                        <div class="col-md-8">
                            <select id="UploadOptionalClass" class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" data-live-search="true">
                                <option value="">--select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Staff List -->
                    <div class="form-group">
                        <label class="control-label col-md-4">Staff List</label>
                        <div class="col-md-8">
                            <select id="UploadStaffList" class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" data-live-search="true">
                                <option value="">--select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Hidden file upload element -->
                    <input type="file" id="UploadExcelFileInput" accept=".xlsx, .xls" style="display: none;" />

                    <!-- Selected Filename Display -->
                    <div class="form-group" id="DivSelectedFile" style="display: none;">
                        <label class="control-label col-md-4">Selected File</label>
                        <div class="col-md-8" style="padding-top: 7px;">
                            <span class="label label-success" id="lblFileName" style="font-size: 12px; display: inline-block; white-space: normal; word-break: break-all;"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <a href="@Url.Action("DownloadOptionalCourseTemplate", "Student")" class="btn btn-success" id="btnDownloadTemplate" title="Download Template">
                    <i class="fa fa-download"></i> Download Template
                </a>
                <button type="button" class="btn btn-primary" id="btnSelectExcel" title="Select Excel">
                    <i class="fa fa-file-excel-o"></i> Select Excel
                </button>
                <button type="button" class="btn btn-info" id="btnUploadExcelSubmit" title="Submit">
                    <i class="fa fa-upload"></i> Submit
                </button>
            </div>
        </div>
    </div>
</div>




<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>

    function ContentLoad()
    {

    }
    $('.selectpicker').selectpicker({
        size: 6
    });

    $('#UserAccountList').DataTable();

    $('#ClassList').on('change', function () {

            loadGird();
    });



    function FetchStudentToAdd(studentId, registerNo, firstName, semesterId, ClassLevel) {
        $('#studentid').val(studentId);
        $('#semId').val(semesterId);
        $('#ClassLevel').val(ClassLevel);
        $('#txtstudentname').val(firstName);
        $('#txtreg').val(registerNo);
         $.ajax({
                    url: '@Url.Action("FetchOptionalCourseBySemester", "Student")',
             data: { sSemesterId: semesterId, sClassLevel: ClassLevel},
                    success: function (option)
                    {
                        $('#OptionalCourseList').empty();
                        $('#OptionalCourseList').append(option.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });

        $('.selectpicker').selectpicker('refresh');
    }
    $('#OptionalCourseList').on('change', function () {
        var vCourseId = $('#OptionalCourseList').val();
        var vSemId = $('#semId').val();
        var vClassId = $('#ClassList').val();
        var isChecked = "";
        var checkbox = document.getElementById("RegularClassOptionalCheckbox");
        if (checkbox.checked) {
            isChecked = "1";
        } else {
            isChecked = "0";
        }

        if (vCourseId != 0 && vCourseId != "") {

                $.ajax({
                    url: '@Url.Action("FetchClassListForAddindStuOptCourse", "Student")',
                    data: { sCourseId: vCourseId, sIsRegularClassOptional: isChecked, sSemesterId: vSemId, sClassId: vClassId},
                    success: function (option)
                    {
                        var dd = $('#SClassList');
                        dd.empty();
                        dd.append(option.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });

        }
        else {
                alert('Please Select Class...!!!');
            }
    });
    function loadGird()
    {
        var vClassId = $('#ClassList').val();
        var vAcYear = $('#AcademicYear option:selected').text();
        if (vClassId != 0 && vClassId != "" && vAcYear != 0 && vAcYear != ""  ) {
                $.ajax({
                    url: '@Url.Action("BindStudentOptionalCourseView", "Student")',
                    data: { sclassId: vClassId, sAcyear: vAcYear},
                    success: function (option)
                    {
                        var dvBind = $('#divBind');
                        dvBind.empty();
                        dvBind.append(option);
                        $("#tblOptCourse").DataTable({ "bPaginate": false });
                    },
                    error: function (xhr, textStatus, error) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });

            } else {
                alert('Please Select Class...!!!');
            }
    }
    function GetConfirmToDelete(strudentId, CourseId, SClassId) {
        var vAcYear = $('#AcademicYear option:selected').text();
        var vStudentId = strudentId;
        var vCourseId = CourseId;
        var vSClassId = SClassId;
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


            function () {
                $.ajax({
                    url: '@Url.Action("DeleteStuOptCourse", "Student")',
                    type: "post",
                    data: { sStudentId: vStudentId, sAcYear: vAcYear, sCourseId: vCourseId, sSClassId: vSClassId},
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadGird();
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }
                });
            });
    }
    $('#btnSubmit').on('click', function ()
    {
        var vClassId = $('#ClassList').val();
        var vAcYear = $('#AcademicYear option:selected').text();
        if ((vClassId == null || vClassId == "") && ( vAcYear == null || vAcYear=="")) {
            swal({ title: "Warning !", text: 'Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        SaveStudentOptCourse();
      });
    function SaveStudentOptCourse()
    {

        var vClassId = $('#ClassList').val();
        var vAcYear = $('#AcademicYear option:selected').text();
        var vCourse = $('#OptionalCourseList').val();
        var vSClass = $('#SClassList').val();
        var vStudentId = $('#studentid').val();
        var vsemId = $('#semId').val();

                $.ajax({
                    url: '@Url.Action("SaveStudentOptionalCourse", "Student")',
                    data: { sClassId: vClassId, sAcYear: vAcYear, sCourse: vCourse, sSClass: vSClass, sStudentId: vStudentId, sSemId: vsemId },
                    success: function (objResult)
                    {
                        swal({ title: "Success!", text: objResult.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        $('#AddModal-dialog').modal('hide');
                        $('#RegularClassOptionalCheckbox').attr("checked", false);
                        loadGird();

                    },
                    error: function (xhr, textStatus, error)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });

    }

    $("#AddModal-dialog").modal({
        backdrop: 'static',
        keyboard: false,
        show: false
    });
    $('#AddModal-dialog').on("hidden.bs.modal", function () {
        loadGird();
    });
    $('#BulkAdd').on("click", function () {
        loadContent('/Student/BulkAddStuOptionalCourse');
    });

    // Show Bulk Excel Upload offcanvas
    $('#BulkExcelUploadBtn').on('click', function () {
        // Clear inputs and selected file
        $('#UploadExcelFileInput').val('');
        $('#lblFileName').text('');
        $('#DivSelectedFile').hide();
        
        // Reset dropdowns
        $('#UploadSemester').val('').change();
        $('#UploadCourse').empty().append('<option value="">--select--</option>');
        $('#UploadOptionalClass').empty().append('<option value="">--select--</option>');
        
        // Match the Academic Year value from the page's main dropdown
        var mainAcYear = $('#AcademicYear').val();
        if (mainAcYear) {
            $('#UploadAcademicYear').val(mainAcYear);
        } else {
            $('#UploadAcademicYear').val('');
        }
        $('#UploadAcademicYear').selectpicker('refresh');
        
        // Fetch all teaching staff to populate the Staff List dropdown
        $.ajax({
            url: '@Url.Action("FetchStaffList", "Student")',
            success: function (data) {
                var dd = $('#UploadStaffList');
                dd.empty();
                dd.append('<option value="">--select--</option>');
                if (data.sResult) {
                    dd.append(data.sResult);
                }
                dd.selectpicker('refresh');
            },
            error: function () {
                swal({ title: "Error", text: "Failed to load staff list.", type: "error", timer: 1500 });
            }
        });
        
        // Open modal
        $('#ExcelUploadModal-dialog').modal('show');
    });

    // Populate Course dropdown based on Academic Year and Semester
    function checkAndLoadCourses() {
        var vAcYear = $('#UploadAcademicYear option:selected').text();
        var vSemId = $('#UploadSemester').val();
        
        var ddCourse = $('#UploadCourse');
        ddCourse.empty().append('<option value="">--select--</option>');
        $('#UploadOptionalClass').empty().append('<option value="">--select--</option>');
        $('#UploadCourse').selectpicker('refresh');
        $('#UploadOptionalClass').selectpicker('refresh');
        
        if (vAcYear && vAcYear != "--select--" && vSemId) {
            $.ajax({
                url: '@Url.Action("FetchOptionalCourseListForUpload", "Student")',
                data: { sSemId: vSemId, sAcYear: vAcYear },
                success: function (option) {
                    if (option.sResult) {
                        ddCourse.append(option.sResult);
                    }
                    ddCourse.selectpicker('refresh');
                },
                error: function () {
                    swal({ title: "Error", text: "Failed to load courses.", type: "error", timer: 1500 });
                }
            });
        }
    }

    $('#UploadAcademicYear').on('change', function () {
        checkAndLoadCourses();
    });

    $('#UploadSemester').on('change', function () {
        checkAndLoadCourses();
    });

    // Populate Optional Classes based on Course selection
    $('#UploadCourse').on('change', function () {
        var vCourseId = $('#UploadCourse').val();
        var ddClass = $('#UploadOptionalClass');
        ddClass.empty().append('<option value="">--select--</option>');
        ddClass.selectpicker('refresh');
        
        if (vCourseId) {
            $.ajax({
                url: '@Url.Action("FetchClassListForAddindStuOptCourse", "Student")',
                data: { sCourseId: vCourseId, sIsRegularClassOptional: "0", sSemesterId: "", sClassId: "" },
                success: function (option) {
                    if (option.sResult) {
                        ddClass.append(option.sResult);
                    }
                    ddClass.selectpicker('refresh');
                },
                error: function () {
                    swal({ title: "Error", text: "Failed to load optional classes.", type: "error", timer: 1500 });
                }
            });
        }
    });

    // Automatically select assigned Staff member when Optional Class & Course are selected
    function autoSelectStaff() {
        var vCourseId = $('#UploadCourse').val();
        var vSClassId = $('#UploadOptionalClass').val();
        
        if (vCourseId && vSClassId) {
            $.ajax({
                url: '@Url.Action("FetchAssignedStaffForOptionalCourse", "Student")',
                data: { sCourseId: vCourseId, sSClassId: vSClassId },
                success: function (data) {
                    if (data.sResult) {
                        $('#UploadStaffList').val(data.sResult);
                    } else {
                        $('#UploadStaffList').val('');
                    }
                    $('#UploadStaffList').selectpicker('refresh');
                }
            });
        }
    }

    $('#UploadOptionalClass').on('change', function () {
        autoSelectStaff();
    });

    // File Selection triggers
    $('#btnSelectExcel').on('click', function () {
        $('#UploadExcelFileInput').click();
    });

    $('#UploadExcelFileInput').on('change', function () {
        var fileInput = document.getElementById('UploadExcelFileInput');
        if (fileInput.files.length > 0) {
            var fileName = fileInput.files[0].name;
            $('#lblFileName').text(fileName);
            $('#DivSelectedFile').show();
        } else {
            $('#lblFileName').text('');
            $('#DivSelectedFile').hide();
        }
    });

    // Submit Action
    $('#btnUploadExcelSubmit').on('click', function () {
        var vAcYear = $('#UploadAcademicYear option:selected').text();
        var vSemId = $('#UploadSemester').val();
        var vCourseId = $('#UploadCourse').val();
        var vSClassId = $('#UploadOptionalClass').val();
        var vStaffId = $('#UploadStaffList').val();
        var fileInput = document.getElementById('UploadExcelFileInput');
        
        if (!vAcYear || vAcYear == "--select--" || !vSemId || !vCourseId || !vSClassId || !vStaffId) {
            swal({ title: "Warning!", text: "Please select all required fields.", type: "warning", timer: 2000 });
            return;
        }
        
        if (fileInput.files.length === 0) {
            swal({ title: "Warning!", text: "Please select an Excel file to upload.", type: "warning", timer: 2000 });
            return;
        }
        
        var formData = new FormData();
        formData.append("excelFile", fileInput.files[0]);
        formData.append("sAcYear", vAcYear);
        formData.append("sSemId", vSemId);
        formData.append("sCourseId", vCourseId);
        formData.append("sSClassId", vSClassId);
        formData.append("sStaffId", vStaffId);
        
        // Show loading spinner
        swal({
            title: "Uploading...",
            text: "Please wait while we process the excel sheet.",
            type: "info",
            showConfirmButton: false,
            allowOutsideClick: false
        });
        
        $.ajax({
            url: '@Url.Action("UploadOptionalCourseExcel", "Student")',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                swal.close();
                if (response.ErrorCode === "200") {
                    $('#ExcelUploadModal-dialog').modal('hide');
                    setTimeout(function () {
                        swal({ title: "Success!", text: response.Message, type: "success" });
                    }, 500);
                    if ($('#ClassList').val()) { loadGird(); }
                } else if (response.ErrorCode === "206") {
                    $('#ExcelUploadModal-dialog').modal('hide');
                    setTimeout(function () {
                        swal({ title: "Completed with Warnings", text: response.Message, type: "warning" });
                    }, 500);
                    if ($('#ClassList').val()) { loadGird(); }
                } else {
                    swal({ title: "Error!", text: response.Message, type: "error" });
                }
            },
            error: function () {
                swal.close();
                swal({ title: "Error!", text: "Internal Server Error or network issue.", type: "error" });
            }
        });
    });
</script>
