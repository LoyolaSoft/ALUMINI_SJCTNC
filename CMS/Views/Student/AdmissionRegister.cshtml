            $.ajax({
                url: "@Url.Action("FetchStudentForAdmissionRegister", "Student")",
                method: "POST",
                datatype: "json",
                data: { sStudentId: StuName, AcademicYear: sAcademicYear },
                success: function (data) {
                    if (data == "1")
                    {
                        alert('No Records Found !');
                    } else
                    {
                        if (data.CertificateId != null && data.CertificateId!='')
                        {
                            $('#btnPrint').removeClass('disabled');
                            $('#hdCertificateId').val(data.CertificateId);
                        }
                        $('#tittle').show();
                        $("#TransferCertificate").show();
                        $("#tittle").show();
                        $("#StudentName").val(data.StudentName);
                        $("#ParentName").val(data.ParentName);
                        $("#SerialNo").val(data.SerialNo);
                        $("#AdmissionNo").val(data.AdmissionNo);
                        $("#Guardian").val(data.Guardian);
