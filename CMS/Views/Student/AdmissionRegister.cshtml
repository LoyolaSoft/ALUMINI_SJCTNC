    $('#btnPrint').on('click',function ()
    {
        var ProgramName = $("#ProgramName").val();
        var ClassName = $("#ClassName").val();
        var StuName = $("#StuName").val();
        var AcademicYear = $('#AcademicYear option:selected').text();
        if (AcademicYear == '' || AcademicYear == '0' || StuName == 0)
        {
            alert('Please Choose All The Values...!!!');
            return false;
        }

        $.ajax({
            url:'@Url.Action("PrintAdmissionRegister", "Student")',
            method:'POST',
            datatype:'json',
            data: { sStudentIds: StuName, AcademicYear: AcademicYear },
            success:function (data)
            {
                $('#dvPrintAdmissionRegister').empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#dvPrintAdmissionRegister').append(data);
                    $('#dvPrintAdmissionRegister').removeClass('hidden');
                    PrintDiv();
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    });


    function PrintDiv()
    {
        var printContents = document.getElementById('dvPrintAdmissionRegister').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Student/AdmissionRegister');
    }
</script>


