@model CMS.ViewModel.ViewModel.StudentViewModel
@using CMS.Utility
@{double dGpa = 0;
    double dwam = 0;
    double dmulti = 0;
    double wam = 0;
    double credit = 0;
    double max = 0;
    double sec = 0;

    
    
    var MphillCourse = Model.LiMphillStudentProject;
    //double dGpaS = 0;
}
@if (Model.liSemestermark != null && Model.liSemestermark.Count > 0)
{
    var StudentList = Model.liSemestermark.GroupBy(s => s.STUDENT_ID).ToList();
    //var StudentListForOverAll = Model.liOverAllSemestermark.GroupBy(s => s.STUDENT_ID).ToList();
    if (StudentList.Count > 0 && StudentList != null)
    {
        foreach (var item in StudentList)
        {
            var Individual = Model.liSemestermark.Where(s => s.STUDENT_ID == item.FirstOrDefault().STUDENT_ID).ToList();
            //var CumulativeIndividual = Model.liOverAllSemestermark.Where(s => s.STUDENT_ID == item.FirstOrDefault().STUDENT_ID).ToList();
            var Partlist = Model.liSemestermark.GroupBy(s => s.PART).ToList();
            //var Individual = from x in Ind orderby int.Parse(x.COURSE_ORDER) select x;
            //Individual.OrderBy(x => x.PART).ThenBy(x=>x.COURSE_ORDER).ThenBy(x=>x.SEMESTER).ToList();
            var datelist = Individual;
            var Date = datelist.OrderByDescending(x => DateTime.Parse(x.START_DATE)).ToList();
            // Individual.OrderBy(x => x.UGC_COURSE_TYPE).ToList();
            //var CumulativePartlist = Model.liOverAllSemestermark.GroupBy(s => s.PART).ToList();

            if (Individual != null && Individual.Count() > 0)
            {
                <div style="page-break-after:always !important;page-break-inside:avoid !important;">
                    <div style="height: 1344px;  width: 816px;">
                        <br /><br /><br /><br /><br /><br /><br /><br /><br /><br /> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;
                        <div class="col-md-12">
                            <table align="center" style="width:100%;">
                                <tr>
                                    <td style="width:50%"><b>Name</b> : &nbsp;@Individual.FirstOrDefault().NAME.ToUpper()</td>
                                    <td style="width:50%" align="right"><b>Register No</b> : &nbsp;@Individual.FirstOrDefault().REGISTER_NO</td>
                                </tr>
                                <tr>
                                    <td style="width:60%"><b>Degree & Major</b> : &nbsp;@Individual.FirstOrDefault().PROGRAMME_NAME </td>
                                    <td style="width:40%" align="right"><b>Roll No</b> : &nbsp;@Individual.FirstOrDefault().ROLL_NO</td>
                                </tr>
                                <tr>
                                    <td style="width:50%"></td>
                                    <td style="width:50%" align="right"><b>Month & Year</b> : &nbsp;@Date.FirstOrDefault().M_EXAM</td>

                                </tr>
                            </table>
                        </div>
                        &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;
                        @if (Individual.FirstOrDefault().APPLICATION_TYPE_ID == "5")
                        {
                            <div class="col-md-12">
                                <table align="center" style="width:98%; border:1px solid;">
                                    <thead>
                                        <tr>
                                            <th style="border:1px solid;width:5% !important;padding-left:5px;" align="left">Sem</th>
                                            <th style="border:1px solid;width:15% !important;padding-left:5px;" align="left">Course Code</th>
                                            <th style="border:1px solid;width:37% !important;padding-left:5px;" align="left">Course Title</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Max.</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Sec.</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Credit</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Grade Point</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Grade</th>
                                            <th style="width:8% !important;border:1px solid ;padding-left:5px;" align="left">Passed Month</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            foreach (var items in Individual)
                                            {
                                                <tr>
                                                    <td style="width:5% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.SEMESTER_NAME</td>
                                                    <td style="width:15% !important;padding-left:5px;  border-right:1px solid ;" align="left">@items.COURSE_CODE</td>
                                                    <td style="width:37% !important;padding-left:5px;  border-right:1px solid ;" align="left">@items.COURSE_TITLE</td>
                                                    <td style="width:5% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.MAXIMUM</td>
                                                    <td style="width:5% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.TOTAL</td>
                                                    <td style="width:5% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.CREDIT</td>
                                                    <td style="width:3% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.GRADE_POINT</td>
                                                    <td style="width:3% !important; padding-left:5px;  border-right:1px solid ;align-content:flex-start;">@items.GRADE</td>
                                                    <td style="width:8% !important; padding-left:5px;  border-right:1px solid ;align-content:flex-start;">@items.M_PASS</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <thead>
                                        <tr style="border:1px solid; padding:5px;">
                                            <th colspan="5" style="border:1px solid; padding-left:5px;"><b>Total</b></th>
                                            <th style="border:1px solid; padding:5px;">@Individual.Sum(o => Convert.ToDouble(o.CREDIT))</th>
                                            @*<th>@Individual.Sum(o => Convert.ToDouble(o.GRADE_POINT))</th>*@
                                            <th style="border:1px solid; padding-left:5px;"></th>
                                            <th style="border:1px solid; padding-left:5px;"></th>
                                            <th style="border:1px solid; padding-left:5px;"></th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <br />
                            <div class="col-md-12">
                                <div class="col-md-6" style="table-layout: fixed;">
                                    <table class="table-condensed" align="left" style="width:30%;">
                                        <caption>Cumulative</caption>
                                        <thead>
                                            <tr>
                                                <th>WAM</th>
                                                <th>GPA</th>
                                                <th>GRADE</th>
                                                <th>CR</th>
                                            </tr>
                                        </thead>
                                        @if (Individual.Count() > 0)
                                        {
                                            dmulti = 0;
                                            wam = 0;
                                            credit = 0;
                                            max = 0;
                                            sec = 0;
                                            dGpa = 0;
                                            dwam = 0;
                                            foreach (var sitem in Individual)
                                            {
                                                if (sitem.RESULT.ToUpper().Contains("A") || sitem.RESULT.ToUpper().Contains("F") || sitem.UGC_COURSE_TYPE == "49" || sitem.UGC_COURSE_TYPE == "128")
                                                {

                                                }
                                                else
                                                {
                                                    dmulti += (Convert.ToDouble(sitem.CREDIT) * Convert.ToDouble(sitem.GRADE_POINT));
                                                    wam += (Convert.ToDouble(sitem.CREDIT) * Convert.ToDouble(sitem.TOTAL));
                                                    credit += Convert.ToDouble(sitem.CREDIT);
                                                    max += Convert.ToDouble(sitem.MAXIMUM);
                                                    sec += Convert.ToDouble(sitem.TOTAL);
                                                }
                                            }
                                            dGpa = dmulti / credit;
                                            dwam = wam / credit;
                                        }
                                        <tr>
                                            <td>@dwam.ToString("#.##")</td>
                                            <td>@dGpa.ToString("#.##")</td>
                                            @if (dGpa >= 9.00)
                                            {
                                                <td>O</td>
                                            }
                                            else
                                            {
                                                if (dGpa >= 8.00)
                                                {
                                                    <td>A+</td>
                                                }
                                                else
                                                {
                                                    if (dGpa >= 7.00)
                                                    {
                                                        <td>A</td>
                                                    }
                                                    else
                                                    {
                                                        if (dGpa >= 6.00)
                                                        {
                                                            <td>B+</td>
                                                        }
                                                        else
                                                        {
                                                            if (dGpa >= 5.00)
                                                            {
                                                                <td>B</td>
                                                            }
                                                            else
                                                            {
                                                                if (dGpa < 5.00)
                                                                {
                                                                    <td>R.A</td>
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            <td>@credit</td>
                                        </tr>

                                    </table>
                                </div>
                                <div class="col-md-5" style="table-layout: fixed;">
                                    <table class="table-condensed" align="right" style="width:30%;">
                                        <caption></caption>
                                        <thead>
                                            <tr>
                                                <th>Total Marks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    @sec/@max
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                                            }
                                           
                                           
                    </div>
                    <div class="form-group pull-right">
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img src="~/Content/hcc_img/sign/Principal-E-Sign_1.png" width="150px;" class="pull-right" />
                    </div>
                </div>

                                                                            }
                                                                        }
                                                                    }
                                                                }

