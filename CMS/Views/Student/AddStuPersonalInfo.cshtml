                var HomePhone = $("#HOMEPHONE").val();
                var AadharNumber = $("#AADHARNUMBER").val();
                var StuMobileNo = $("#STUMOBILENO").val();
                var PlaceOfBirth = $("#PLACEOFBIRTH").val();
                var MaritalStatus = $("#MARITALSTATUS").val();
                var Gender = $("#GENDERID").val();
                var Community = $("#COMMUNITY").val();
                var MotherTongue = $("#MOTHERTONGUE").val();
                var BloodGroup = $("#BLOODGROUP").val();
                var Religion = $("#RELIGION").val();
                var Nationality = $("#NATIONALITY").val();
                var SplyAbledStudent = $("#SPECIALLYABLED").val();
                var ResidencyType = $("#RESIDENCYTYPE").val();
                var FirstLanguage = $("#FIRSTLANGUAGE").val();
                var SecondLanguage = $("#SECONDLANGUAGE").val();
                var JsonData;
                if (JsonData==null) 
                {
                    //JsonData = '{"SecondLanguage":"' + SecondLanguage + '",\
                    //             "FirstLanguage":"' + FirstLanguage + '","ResidencyType":"' + ResidencyType + '","SpecillyAblled":"' + SplyAbled + '",\
                    //             "firstName":"' + firstName + '","LastName":"' + LastName + '","Caste":"' + Caste + '","DateOfBirth":"' + DateOfBirth + '",\
                    //             "AnnulIncome":"' + AnnulIncome + '","ResidencyNo":"' + ResidencyNo + '","PossportNo":"' + PossportNo + '",\
                    //             "PhotoPath":"' + PhotoPath + '","VisaSponser":"' + VisaSponser + '","VisaNumber":"' + VisaNumber + '","Identity1":"' + Identity1 + '",\
                    //             "Identity2":"' + Identity2 + '","HomePhone":"' + HomePhone + '","AadharNumber":"' + AadharNumber + '",\
                    //             "StuMobileNo":"' + StuMobileNo + '","PlaceOfBirth":"' + PlaceOfBirth + '","MaritalStatus":"' + MaritalStatus + '",\
                    //             "Gender":"' + Gender + '","Community":"' + Community + '","MotherTongue":"' + MotherTongue + '","BloodGroup":"' + BloodGroup + '",\
                    //             "Religion":"' + Religion + '","Nationality":"' + Nationality + '"}';
                    JsonData = '{"SECOND_LANGUAGE":"' + SecondLanguage + '"\
                                ,"FIRST_LANGUAGE":"' + FirstLanguage + '"\
                                ,"RESIDENCY_TYPE":"' + ResidencyType + '"\
                                ,"SPECIALLY_ABLED":"' + SplyAbledStudent + '"\
                                ,"FIRST_NAME":"' + firstName + '"\
                                ,"LAST_NAME":"' + LastName + '"\
                                ,"CASTE":"' + Caste + '"\
                                ,"DATE_OF_BIRTH":"' + DateOfBirth + '"\
                                ,"ANNUAL_INCOME":"' + AnnulIncome + '"\
                                ,"RESIDENCE_NO":"' + ResidencyNo + '"\
                                ,"PASSPORT_Number":"' + PossportNo + '"\
                                ,"PHOTO":"' + PhotoPath + '"\
                                ,"IDENTIFICATION_MARK1":"' + Identity1 + '"\
                                ,"IDENTIFICATION_MARK2":"' + Identity2 + '"\
                                ,"HOME_PHONE":"' + HomePhone + '"\
                                ,"AADHAR_NUMBER":"' + AadharNumber + '"\
                                ,"STU_MOBILENO":"' + StuMobileNo + '"\
                                ,"PLACE_OF_BIRTH":"' + PlaceOfBirth + '"\
                                ,"MARITAL_STATUS":"' + MaritalStatus + '"\
                                ,"GENDER":"' + Gender + '"\
                                ,"COMMUNITY":"' + Community + '"\
                                ,"MOTHER_TONGUE":"' + MotherTongue + '"\
                                ,"BLOOD_GROUP":"' + BloodGroup + '"\
                                ,"RELIGION":"' + Religion + '"\
                                ,"NATIONALITY":"' + Nationality + '"}';
                }
        
                $.ajax({
                    url:"@Url.Action("SavePersonalInfo", "Student")",
                    method: "POST",
                    datatype: "html",
                    data: { str: JsonData },
                    success:function(data)
                    {
                        if (data.Message == "200")
                            myAlert('Record(s) saved successfully ...!', 'gritter-success', '');
                        else 
                            myAlert(data.Message, 'gritter-warning', '');
                    },error:function(error)
                    {
                        myAlert('Internal Server Error ...!', 'gritter-warning', '');
                    }
                });
