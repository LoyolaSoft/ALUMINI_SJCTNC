        <script>
            // Ready Function ...
            $(document).ready(function () {
                handleDatepicker = function ()
                {
                    "use strict";
                    $("#DATEOFBIRTH").datepicker({
                        todayHighlight: true,
                        autoclose: true,
                        endDate: new Date(),
                        format: "dd/mm/yyyy",
                        orientation: "right bottom"
                    });
                }
                handleDatepicker();
               
                GetPersonal();
                $('.selectpicker').selectpicker('refresh');
            });

