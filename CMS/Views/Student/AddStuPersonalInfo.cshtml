            // Fetch Personal Infomation ...
            function GetPersonal()
            {
                var TempData = 'Test';
                $.ajax({
                    url:"@Url.Action("FetchPersonalInfo", "Student")",
                    method:"POST",
                    datatype: "json",
                    data: {sTempData: TempData },
                    success:function(data)
                    {
                        if (data.firstName != null && data.firstName != '')
                        {
                            $("#txtFirstName").val(data.firstName);
                            $("#txtLastName").val(data.LastName);
                            $("#CASTE").val(data.Caste);
                            $("#DATEOFBIRTH").val(data.DateOfBirth);
                            $("#IDENTIFICATIONMARK1").val(data.Identity1);
                            $("#IDENTIFICATIONMARK2").val(data.Identity2);
                            $("#HOMEPHONE").val(data.HomePhone);
                            $("#AADHARNUMBER").val(data.AadharNumber);
                            $("#STUMOBILENO").val(data.StuMobileNo);
                            $("#PLACEOFBIRTH").val(data.PlaceOfBirth);
                            $("#MARITALSTATUS").val(data.MaritalStatus);
                            $("#GENDERID").val(data.Gender);
                            $("#COMMUNITY").val(data.Community);
                            $("#MOTHERTONGUE").val(data.MotherTongue);
                            $("#BLOODGROUP").val(data.BloodGroup);
                            $("#RELIGION").val(data.Religion);
                            $("#NATIONALITY").val(data.Nationality);
                          
                            $("#RESIDENCYTYPE").val(data.ResidencyType);
                            $("#FIRSTLANGUAGE").val(data.FirstLanguage);
                            $("#SECONDLANGUAGE").val(data.SecondLanguage);
                            $("#SPECIALLYABLED").val(data.SpecillyAblled);
                        }
                        $('.selectpicker').selectpicker('refresh');
                    },error:function(error)
                    {
                        myAlert('Internal Server Error !', 'gritter-danger', '');
                    }
                });
            }
         
            // Student Personal Details ...
            $("#btnPersonalInfo").on("click", function ()
            {
                var isValid = true;
                if ($('#nav-tab1-2').parsley().validate() !== true) isValid = false;
                if (!isValid) {
                    //gritter-info,danger,success,warning,default
                    myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                    return false;
                }
                var firstName = $("#txtFirstName").val();
                var LastName = $("#txtLastName").val();
                var Caste = $("#CASTE").val();
                var DateOfBirth = $("#DATEOFBIRTH").val();
                //var AnnulIncome = $("#ANNUALINCOME").val();
                var AnnulIncome = "0";
                var ResidencyNo = $("#RESIDENCENO").val();
                var PossportNo = $("#PASSPORTNUMBER").val();
