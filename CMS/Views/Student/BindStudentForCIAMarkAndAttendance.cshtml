@model CMS.ViewModel.ViewModel.StudentViewModel
@{ Layout = null; int count = 0; }
<div class="table table-responsive">
    <table class="table table-bordered table-hover" id="tblBindStudent">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.liStudentList != null && Model.liStudentList.Count > 0)
                {
                    foreach (var item in Model.liStudentList)
                    {
                        <tr>
                            <td>@{count++;}@count</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.REGISTER_NO</td>
                            <td>
                                <a onclick="FetchStudentMark(@item.STUDENT_ID)"  class="btn btn-primary" id="btnGetStudentMak"  data-toggle="modal" data-target="#Mark-dialog" title="Click To Edit">Mark</a>
                                <a onclick="FetchStudentAttendance(@item.STUDENT_ID)" class="btn btn-primary" data-toggle="modal" data-target="#Attendance-dialog" id="btnGetAttendance" title="Click To Edit">Attendance</a>
                            </td>
                        </tr>
                                    }
                                }

            }
        </tbody>
    </table>
</div>