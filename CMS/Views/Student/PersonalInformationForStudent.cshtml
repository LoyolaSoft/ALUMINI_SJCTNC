<script>

    function printDiv() {
        var divContents = document.getElementById("studentDetailsBody").innerHTML;
        var printWindow = window.open('', '', 'height=800,width=800');

        printWindow.document.write('<html><head><title>Student Details</title>');
        // Load Bootstrap CSS
        printWindow.document.write('<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">');
        // Load your own styles if needed
        printWindow.document.write('<style>');
        printWindow.document.write(`
     body { font-family: Arial, sans-serif; margin: 20px; }
     .student-photo { width: 200px; height: 200px; margin-bottom: 15px; }
     .section-title { background: #2c9dbf !important; color: white; padding: 10px; margin: 20px 0 10px; font-weight: bold; }
     .detail-row { display: flex; flex-wrap: wrap; margin-bottom: 8px; }
     .detail-label { flex: 0 0 40%; max-width: 40%; font-weight: bold; color: #555; }
     .detail-value { flex: 0 0 60%; max-width: 60%; white-space: normal; word-wrap: break-word; }
 `);
        printWindow.document.write('</style></head><body>');
        printWindow.document.write(divContents);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.print();
    }


    function Export() {
        var title = "";

        title = "Student_Report";
        let file = new Blob([$('#studentDetailsBody').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();

    }
</script>