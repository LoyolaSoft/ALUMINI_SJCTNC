@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.ViewModel.Model;
@{
    Layout = null;
    int nCount = 0;
    int tdCount = 3;
    string sIsCorrect = string.Empty;
    string sIsRightAnswer = string.Empty;
    string sIsMarkShow = string.Empty;
    string sHidden = "hidden";
}

<div class="row g-3">
    @if (Model.liQuizSetting != null && Model.liQuizSetting.Count > 0)
    {
        var setting = Model.liQuizSetting.FirstOrDefault();
        sIsCorrect = setting.IS_CORRECT;
        sIsMarkShow = setting.IS_SHOW_MARKS;
        sIsRightAnswer = setting.IS_SHOW_RIGHT_ANSWER;
        
        <div class="col-12 text-center mb-3">
            <h4 class="fw-bold text-primary mb-1">@setting.SETTING_NAME</h4>
            <span class="badge bg-light text-dark border">Academic Year: @setting.ACADEMIC_YEAR</span>
        </div>
    }

    @if (Model.liCourseInfo != null && Model.liCourseInfo.Count > 0)
    {
        var course = Model.liCourseInfo.FirstOrDefault();
        <div class="col-12">
            <div class="card bg-light border-0 rounded-3 mb-3">
                <div class="card-body p-3">
                    <div class="row text-center text-md-start">
                        <div class="col-md-4 mb-2 mb-md-0">
                            <span class="text-muted small d-block">Course</span>
                            <span class="fw-semibold">(@course.COURSE_CODE) @course.COURSE_TITLE</span>
                        </div>
                        <div class="col-md-4 mb-2 mb-md-0">
                            <span class="text-muted small d-block">Incharge</span>
                            <span class="fw-semibold">@course.STAFF_NAME</span>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted small d-block">Date</span>
                            <span class="fw-semibold">@course.DATE</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered align-middle" id="tblOnlineQuiz">
                <thead class="table-dark">
                    <tr>
                       <th style="width: 50px;">#</th>
                       <th>Questions & Answers</th>
                       <th class="@if (sIsRightAnswer != "1") { @sHidden} " style="width: 250px;">Correct Answer</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int nQuestionCount = 0;
                        double nTotalMarks = 0;

                        // Match The Following
                        if (Model.liOnlineQuiz != null && Model.liOnlineQuiz.Count > 0)
                        {
                            var liGroupQuesions = Model.liOnlineQuiz.GroupBy(x => x.QUIZ_ID).Select(x => new OnlineQuizTest() { QUIZ_ID = x.FirstOrDefault().QUIZ_ID, QUESTION_TYPE = x.FirstOrDefault().QUESTION_TYPE, QUIZ_QUESTION = x.FirstOrDefault().QUIZ_QUESTION, MARK = x.FirstOrDefault().MARK }).ToList();
                            foreach (var item in liGroupQuesions)
                            {
                                nCount++;
                                <tr class="table-active">
                                    <td class="fw-bold">@nCount</td>
                                    <td colspan="@(sIsRightAnswer == "1" ? 2 : 1)"><strong>@Html.Raw(Model.GetStrigFromBase64String(item.QUIZ_QUESTION))</strong></td>
                                </tr>
                                var liGroupOptions = Model.liOnlineQuiz.Where(x => x.QUIZ_ID == item.QUIZ_ID).ToList();
                                foreach (var GpOptionitem in liGroupOptions)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <div class="mb-1 text-muted small">Sub-Question: @Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.QUESTION))</div>
                                            <div class="ps-3 border-start border-3 @(GpOptionitem.STATUS == "1" ? "border-success text-success" : "border-danger text-danger")">
                                                <i class="fas @(GpOptionitem.STATUS == "1" ? "fa-check-circle" : "fa-times-circle") me-2"></i>
                                                @Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.SELECTED_ANSWER))
                                            </div>
                                        </td>
                                        @if (sIsRightAnswer == "1")
                                        {
                                            <td><span class="text-success fw-bold">@Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.ANSWER))</span></td>
                                        }
                                     </tr>
                                }
                                nQuestionCount += 1;
                                if (liGroupOptions.Count == liGroupOptions.Count(x => x.STATUS == "1")) { nTotalMarks += Convert.ToDouble(item.MARK); }
                            }
                        }

                        // Objective Type
                        if (Model.liOnlineQuizQuestions != null && Model.liOnlineQuizQuestions.Count > 0)
                        {
                            var liGroupQuesions = Model.liOnlineQuizQuestions.GroupBy(x => x.QUIZ_ID).Select(x => new OnlineQuizTest() { QUIZ_ID = x.FirstOrDefault().QUIZ_ID, QUESTION_TYPE = x.FirstOrDefault().QUESTION_TYPE, MARK = x.FirstOrDefault().MARK, QUIZ_QUESTION = x.FirstOrDefault().QUIZ_QUESTION }).ToList();
                            foreach (var item in liGroupQuesions)
                            {
                                nCount++;
                                <tr class="table-active">
                                    <td class="fw-bold">@nCount</td>
                                    <td colspan="@(sIsRightAnswer == "1" ? 2 : 1)"><strong>@Html.Raw(Model.GetStrigFromBase64String(item.QUIZ_QUESTION))</strong></td>
                                </tr>
                                var liGroupOptions = Model.liOnlineQuizQuestions.Where(x => x.QUIZ_ID == item.QUIZ_ID).ToList();
                                foreach (var GpOptionitem in liGroupOptions)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <div class="ps-3 border-start border-3 @(GpOptionitem.STATUS == "1" ? "border-success text-success" : "border-danger text-danger")">
                                                <i class="fas @(GpOptionitem.STATUS == "1" ? "fa-check-circle" : "fa-times-circle") me-2"></i>
                                                @Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.SELECTED_ANSWER))
                                            </div>
                                        </td>
                                        @if (sIsRightAnswer == "1")
                                        {
                                            <td><span class="text-success fw-bold">@Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.OPTION))</span></td>
                                        }
                                    </tr>
                                }
                                nQuestionCount += 1;
                                if (liGroupOptions.Count(x => x.STATUS == "1") > 0) { nTotalMarks += Convert.ToDouble(item.MARK); }
                            }
                        }

                        // Fill In The Blank
                        if (Model.liOnlineQuizOptions != null && Model.liOnlineQuizOptions.Count > 0)
                        {
                            var liGroupQuesions = Model.liOnlineQuizOptions.GroupBy(x => x.QUIZ_ID).Select(x => new OnlineQuizTest() { QUIZ_ID = x.FirstOrDefault().QUIZ_ID, QUESTION_TYPE = x.FirstOrDefault().QUESTION_TYPE, MARK = x.FirstOrDefault().MARK, QUIZ_QUESTION = x.FirstOrDefault().QUIZ_QUESTION }).ToList();
                            foreach (var item in liGroupQuesions)
                            {
                                nCount++;
                                <tr class="table-active">
                                    <td class="fw-bold">@nCount</td>
                                    <td colspan="@(sIsRightAnswer == "1" ? 2 : 1)"><strong>@Html.Raw(Model.GetStrigFromBase64String(item.QUIZ_QUESTION))</strong></td>
                                </tr>
                                var liGroupOptions = Model.liOnlineQuizOptions.Where(x => x.QUIZ_ID == item.QUIZ_ID).ToList();
                                foreach (var GpOptionitem in liGroupOptions)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <div class="ps-3 border-start border-3 @(GpOptionitem.STATUS == "1" ? "border-success text-success" : "border-danger text-danger")">
                                                <i class="fas @(GpOptionitem.STATUS == "1" ? "fa-check-circle" : "fa-times-circle") me-2"></i>
                                                @Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.SELECTED_ANSWER))
                                            </div>
                                        </td>
                                        @if (sIsRightAnswer == "1")
                                        {
                                            <td><span class="text-success fw-bold">@Html.Raw(Model.GetStrigFromBase64String(GpOptionitem.OPTION))</span></td>
                                        }
                                    </tr>
                                }
                                nQuestionCount += 1;
                                if (liGroupOptions.Count(x => x.STATUS == "1") > 0) { nTotalMarks += Convert.ToDouble(item.MARK); }
                            }
                        }

                        if (Model.liOnlineQuizResult != null && Model.liOnlineQuizResult.Count > 0)
                        {
                            <tr>
                                <td colspan="@(sIsRightAnswer == "1" ? 3 : 2)" class="text-danger fw-bold">
                                    <i class="fas fa-hourglass-end me-2"></i> Your Time's Up! Please contact the Incharge.
                                </td>
                            </tr>
                        }
                    }

                    @if (sIsMarkShow == "1" && Model.liQuizSetting != null && Model.liQuizSetting.Count > 0)
                    {
                        var setting = Model.liQuizSetting.FirstOrDefault();
                        <tr class="table-light">
                            <td colspan="@(sIsRightAnswer == "1" ? 3 : 2)" class="p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-4 text-center text-md-start mb-2 mb-md-0">
                                        <div class="text-muted small">Total Questions</div>
                                        <div class="h6 mb-0 fw-bold">@setting.NO_OF_QUESTIONS</div>
                                    </div>
                                    <div class="col-md-4 text-center mb-2 mb-md-0">
                                        <div class="text-muted small">Answered</div>
                                        <div class="h6 mb-0 fw-bold text-success">@nQuestionCount</div>
                                    </div>
                                    <div class="col-md-4 text-center text-md-end">
                                        <div class="text-muted small">Secured Mark</div>
                                        <div class="h6 mb-0 fw-bold text-primary">@nTotalMarks / @setting.TOTAL_MARK</div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    #tblOnlineQuiz td, #tblOnlineQuiz th {
        padding: 0.75rem;
    }
    .table-active {
        --bs-table-accent-bg: rgba(0, 0, 0, 0.03) !important;
    }
    .ps-3 { padding-left: 1rem !important; }
    .border-start { border-left: 3px solid !important; }
    .border-success { border-color: #28a745 !important; }
    .border-danger { border-color: #dc3545 !important; }
</style>
