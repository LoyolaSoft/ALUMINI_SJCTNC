@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "StudentSemesterMarkAndCourse";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}
@{ int count = 0;}
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">StudentCIA Marks</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">StudentCIA Marks</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">StudentCIA Marks</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 table-responsive">
                <div class="">
                    <table class="table table-bordered table-responsive">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Course Title</th>
                                <th>Semester</th>
                                <th>Academic Year</th>
                                <th>Mark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.LiStudentCourseInfo != null && Model.LiStudentCourseInfo.Count > 0)
                                {
                                    foreach (var item in Model.LiStudentCourseInfo)
                                    {
                                        <tr>
                                            <td>
                                                @{ count++;}@count
                                            </td>
                                            <td>@item.COURSE_TITLE</td>
                                            <td>@item.SEMESTER_ID</td>
                                            <td>@item.ACADEMIC_YEAR</td>
                                <td>@item.TOTAL</td>
                            </tr>
                                    }

                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
