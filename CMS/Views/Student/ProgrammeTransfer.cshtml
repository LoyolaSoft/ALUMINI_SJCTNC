@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "ProgrammeTransfer";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<style>
    .filter-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .verification-card-success {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 6px;
        padding: 10px 14px;
        margin-top: 8px;
        color: #065f46;
        font-size: 13px;
    }

    .verification-card-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 10px 14px;
        margin-top: 8px;
        color: #991b1b;
        font-size: 13px;
    }

    .current-info-box {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 16px;
    }

    .nav-tabs > li.active > a,
    .nav-tabs > li.active > a:focus,
    .nav-tabs > li.active > a:hover {
        font-weight: 700;
        border-top: 3px solid #3b82f6;
    }

    .font-bold {
        font-weight: 700 !important;
    }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("ADMIN", "DashBoard")">Home</a></li>
        <li><a href="javascript:;">Student</a></li>
        <li class="active">Programme Transfer</li>
    </ol>
    <h1 class="page-header">Student Programme Transfer</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" onclick="reloadStudentList()"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"><i class="fa fa-exchange"></i> Programme Transfer Management</h4>
        </div>
        <div class="panel-body">
            <!-- Filter & Quick Verification Section -->
            <div class="filter-card">
                <div class="row">
                    <div class="form-group col-md-4">
                        <label class="control-label col-md-4">Academic Year</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", id = "ddlAcademicYear" })
                        </div>
                    </div>

                    <!-- Quick Roll No Search with Verification button matching user design -->
                    <div class="form-group col-md-8">
                        <label class="control-label col-md-3 text-right">Roll No <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <div class="input-group">
                                <input type="text" class="form-control input-sm" id="txtQuickRollNo" placeholder="Enter Student Roll No (e.g., A24AID01)" />
                                <span class="input-group-btn">
                                    <button class="btn btn-sm btn-primary" type="button" id="btnQuickVerify" onclick="VerifyQuickRollNo()">
                                        <i class="fa fa-search"></i> Verify
                                    </button>
                                </span>
                            </div>
                            <!-- Verification Card Result -->
                            <div id="quickVerifyResult" style="display: none;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab Navigation -->
            <ul class="nav nav-tabs" id="transferTabs" role="tablist">
                <li class="active">
                    <a href="#tabStudents" data-toggle="tab" aria-expanded="true">
                        <i class="fa fa-users"></i> Student List
                    </a>
                </li>
                <li>
                    <a href="#tabLogs" data-toggle="tab" aria-expanded="false" onclick="loadTransferLogs()">
                        <i class="fa fa-history"></i> Transfer History Logs
                    </a>
                </li>
            </ul>

            <div class="tab-content" style="padding-top: 15px;">
                <!-- Tab 1: Student List -->
                <div class="tab-pane fade active in" id="tabStudents">
                    <div id="transferLoadingSpinner" style="display: none; text-align: center; padding: 25px;">
                        <i class="fa fa-spinner fa-spin fa-2x text-primary"></i>
                        <div style="margin-top: 8px; font-weight: 600;">Loading student details...</div>
                    </div>
                    <div id="dvProgrammeTransferStudentList">
                        @Html.Partial("BindProgrammeTransferList", Model)
                    </div>
                </div>

                <!-- Tab 2: Transfer History Logs -->
                <div class="tab-pane fade" id="tabLogs">
                    <div class="well well-sm" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; margin-bottom: 15px; padding: 10px 15px;">
                        <div class="row" style="display: flex; align-items: center; flex-wrap: wrap;">
                            <div class="col-md-7 col-xs-12 form-inline" style="margin-bottom: 5px;">
                                <label style="font-weight: 600; margin-right: 8px;">
                                    <i class="fa fa-calendar text-primary"></i> Filter Academic Year:
                                </label>
                                @Html.DropDownList("ddlLogsAcademicYear", (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select Academic Year --", new { @class = "form-control input-sm selectpicker", @data_live_search = "true", @data_width = "180px", id = "ddlLogsAcademicYear" })
                                <button type="button" class="btn btn-sm btn-primary" onclick="loadTransferLogs()" style="margin-left: 6px;">
                                    <i class="fa fa-filter"></i> Filter
                                </button>
                                <button type="button" class="btn btn-sm btn-default" onclick="loadAllTransferLogs()" style="margin-left: 4px;" title="Show All Academic Years">
                                    <i class="fa fa-globe"></i> All Years
                                </button>
                            </div>
                            <div class="col-md-5 col-xs-12 text-right" style="margin-bottom: 5px;">
                                <span class="label label-info" style="font-size: 11px; padding: 5px 10px; margin-right: 8px;">
                                    Logs for: <b id="lblCurrentLogYear">-</b>
                                </span>
                                <button type="button" class="btn btn-sm btn-success" onclick="loadTransferLogs()">
                                    <i class="fa fa-refresh"></i> Refresh
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="logsLoadingSpinner" style="display: none; text-align: center; padding: 25px;">
                        <i class="fa fa-spinner fa-spin fa-2x text-primary"></i>
                        <div style="margin-top: 8px; font-weight: 600;">Loading transfer history logs...</div>
                    </div>
                    <div id="dvProgrammeTransferLogs">
                        <div class="alert alert-info text-center">Click tab or refresh to load transfer logs.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PROGRAMME TRANSFER MODAL -->
<div class="modal fade" id="modalProgrammeTransfer" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><i class="fa fa-exchange text-primary"></i> Transfer Student Programme</h4>
            </div>
            <div class="modal-body">
                <!-- Current Info Box -->
                <div class="current-info-box">
                    <h5 style="margin-top: 0; margin-bottom: 10px; color: #334155; font-weight: 700;">
                        <i class="fa fa-id-card-o text-primary"></i> Current Student Details
                    </h5>
                    <input type="hidden" id="modalStudentId" />
                    <input type="hidden" id="modalCurrentProgGroupId" />
                    <input type="hidden" id="modalCurrentClassId" />
                    <input type="hidden" id="modalCurrentClassYear" />
                    <div class="row">
                        <div class="col-md-3">
                            <label class="text-muted" style="font-size: 11px;">CURRENT ROLL NO</label>
                            <div><b id="modalCurrentRollNo" class="text-primary font-bold" style="font-size: 14px;">-</b></div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted" style="font-size: 11px;">STUDENT NAME</label>
                            <div><b id="modalStudentName" style="font-size: 14px;">-</b></div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted" style="font-size: 11px;">CURRENT PROGRAMME</label>
                            <div><span id="modalCurrentProgramme" class="badge badge-default" style="background: #e0e7ff; color: #3730a3;">-</span></div>
                        </div>
                        <div class="col-md-2">
                            <label class="text-muted" style="font-size: 11px;">CURRENT CLASS</label>
                            <div><b id="modalCurrentClass">-</b></div>
                        </div>
                    </div>
                </div>

                <hr style="margin: 15px 0;" />

                <!-- Transfer Destination Form -->
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">Transfer Programme <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <div id="lblProgrammeFilterInfo" style="display: none; margin-bottom: 6px;">
                                <span class="label label-info" style="font-size: 11px; padding: 4px 8px;">
                                    <i class="fa fa-filter"></i> <span id="lblFilterText">-</span>
                                </span>
                            </div>
                            <select class="form-control input-sm selectpicker" data-live-search="true" data-width="100%" id="ddlTransferProgramme">
                                <option value="">-- Select Target Programme --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Transfer Class <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <select class="form-control input-sm selectpicker" data-live-search="true" data-width="100%" id="ddlTransferClass">
                                <option value="">-- Select Target Class --</option>
                            </select>
                        </div>
                    </div>

                    <!-- New Roll No with Verify button matching user design -->
                    <div class="form-group">
                        <label class="control-label col-md-3">New Roll No <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <div class="input-group">
                                <input type="text" class="form-control input-sm font-bold" id="txtNewRollNo" placeholder="Enter New Roll No" />
                                <span class="input-group-btn">
                                    <button class="btn btn-sm btn-primary" type="button" id="btnVerifyNewRollNo" onclick="VerifyModalNewRollNo()">
                                        <i class="fa fa-search"></i> Verify
                                    </button>
                                </span>
                            </div>
                            <!-- Helper Info showing Last Roll No in this class & Quick Set options -->
                            <div id="divClassRollNoSuggestion" style="display: none; margin-top: 6px; padding: 8px 12px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px;">
                                <div style="font-size: 12px; color: #0369a1;">
                                    <i class="fa fa-info-circle"></i> Last Roll No in selected class: <b id="lblLastRollNo" class="text-primary font-bold">-</b>
                                    <span style="margin-left: 10px; color: #64748b;">(Students: <span id="lblClassStudentCount">0</span>)</span>
                                </div>
                                <div style="margin-top: 6px; font-size: 11px;">
                                    <button type="button" class="btn btn-xs btn-success" id="btnUseNextRollNo" onclick="applySuggestedRollNo('next')">
                                        <i class="fa fa-magic"></i> Auto-Set Next: <b id="lblNextRollNoVal">-</b>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-default" id="btnUseLastRollNo" style="margin-left: 4px;" onclick="applySuggestedRollNo('last')">
                                        <i class="fa fa-clone"></i> Set Last: <span id="lblLastRollNoVal">-</span>
                                    </button>
                                </div>
                            </div>
                            <div id="modalRollNoVerifyResult" style="display: none;"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Remarks / Reason <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <textarea class="form-control" id="txtTransferRemarks" rows="2" placeholder="Enter reason for programme transfer"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-success" id="btnSubmitTransfer" onclick="SubmitProgrammeTransfer()">
                    <i class="fa fa-check"></i> Confirm Transfer
                </button>
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script>
    var studentTable;
    var isNewRollNoVerified = false;

    function ContentLoad() {
        $('.selectpicker').selectpicker({ size: 6 });

        initStudentDataTable();

        // Sync default academic year to logs filter
        var defaultTopYear = $('#ddlAcademicYear').val();
        if (defaultTopYear) {
            $('#ddlLogsAcademicYear').val(defaultTopYear).selectpicker('refresh');
        }

        $('#ddlAcademicYear').on('change', function () {
            reloadStudentList();
            var val = $(this).val();
            if (val) {
                $('#ddlLogsAcademicYear').val(val).selectpicker('refresh');
            }
            if ($('#tabLogs').hasClass('active') || $('#tabLogs').hasClass('in')) {
                loadTransferLogs();
            }
        });

        $('#ddlLogsAcademicYear').on('change', function () {
            loadTransferLogs();
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href");
            if (target === "#tabLogs") {
                loadTransferLogs();
            }
        });

        $('#modalProgrammeTransfer').on('shown.bs.modal', function () {
            $('#ddlTransferProgramme').selectpicker('refresh');
            $('#ddlTransferClass').selectpicker('refresh');
        });

        $('#ddlTransferProgramme').on('change', function () {
            loadClassesForProgramme($(this).val());
        });

        $('#ddlTransferClass').on('change', function () {
            var classId = $(this).val();
            var acYear = $('#ddlAcademicYear option:selected').text();
            fetchClassRollNoDetails(classId, acYear);
        });

        $('#txtNewRollNo').on('input', function () {
            isNewRollNoVerified = false;
            $('#modalRollNoVerifyResult').hide().empty();
        });
    }

    function initStudentDataTable() {
        if ($.fn.DataTable.isDataTable('#tblTransferStudentList')) {
            $('#tblTransferStudentList').DataTable().destroy();
        }
        studentTable = $('#tblTransferStudentList').DataTable({
            responsive: true,
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            order: [[2, "asc"]]
        });
    }

    function reloadStudentList() {
        var acYear = $('#ddlAcademicYear option:selected').text();
        $('#transferLoadingSpinner').show();
        $('#dvProgrammeTransferStudentList').hide();

        $.ajax({
            url: '@Url.Action("BindProgrammeTransferStudentList", "Student")',
            type: 'GET',
            data: { sAcYear: acYear },
            success: function (data) {
                $('#transferLoadingSpinner').hide();
                $('#dvProgrammeTransferStudentList').html(data).show();
                initStudentDataTable();
            },
            error: function () {
                $('#transferLoadingSpinner').hide();
                $('#dvProgrammeTransferStudentList').show();
                swal("Error", "Failed to load student list.", "error");
            }
        });
    }

    function loadTransferLogs(forceYear) {
        var acYear = forceYear;
        if (!acYear) {
            acYear = $('#ddlLogsAcademicYear option:selected').text();
            if (!acYear || acYear.indexOf('--') >= 0) {
                acYear = $('#ddlAcademicYear option:selected').text();
            }
        }

        if (!acYear || acYear.indexOf('--') >= 0) {
            acYear = '';
        }

        if (acYear === 'ALL') {
            $('#lblCurrentLogYear').text('All Academic Years');
        } else if (acYear) {
            $('#lblCurrentLogYear').text(acYear);
        } else {
            $('#lblCurrentLogYear').text('Current Year');
        }

        $('#logsLoadingSpinner').show();
        $('#dvProgrammeTransferLogs').hide();

        $.ajax({
            url: '@Url.Action("BindProgrammeTransferLogs", "Student")',
            type: 'GET',
            data: { sAcYear: acYear },
            success: function (data) {
                $('#logsLoadingSpinner').hide();
                $('#dvProgrammeTransferLogs').html(data).show();
                if ($.fn.DataTable.isDataTable('#tblTransferLogs')) {
                    $('#tblTransferLogs').DataTable().destroy();
                }
                $('#tblTransferLogs').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [[0, "asc"]]
                });
            },
            error: function () {
                $('#logsLoadingSpinner').hide();
                $('#dvProgrammeTransferLogs').show();
            }
        });
    }

    function loadAllTransferLogs() {
        $('#ddlLogsAcademicYear').val('').selectpicker('refresh');
        loadTransferLogs('ALL');
    }

    // Quick Roll No Verification matching user screenshot
    function VerifyQuickRollNo() {
        var rollNo = $('#txtQuickRollNo').val();
        if (!rollNo || rollNo.trim() === "") {
            swal("Enter Roll No", "Please enter a Roll No to verify.", "warning");
            return;
        }

        rollNo = rollNo.trim();
        $.ajax({
            url: '@Url.Action("VerifyRollNumber", "Student")',
            type: 'GET',
            data: { sRollNo: rollNo },
            success: function (res) {
                var $container = $('#quickVerifyResult');
                if (res && res.StudentId) {
                    var html = '<div class="verification-card-success">' +
                        '<div><i class="fa fa-check-circle" style="color: #10b981; font-size: 15px;"></i> <b>Name:</b> <span class="font-bold text-success">' + res.StudentName + '</span></div>' +
                        '<div style="margin-top: 3px;"><b>Details:</b> ' + (res.ClassName || '') + ' - ' + (res.ProgrammeName || '') + '</div>' +
                        '<div style="margin-top: 8px;">' +
                        '<button type="button" class="btn btn-xs btn-success" onclick="openTransferModalFromVerify(\'' + res.StudentId + '\', \'' + res.RollNo + '\', \'' + escapeHtml(res.StudentName) + '\', \'' + (res.ProgrammeGroupId || '') + '\', \'' + escapeHtml(res.ProgrammeName) + '\', \'' + (res.ClassId || '') + '\', \'' + escapeHtml(res.ClassName) + '\')"><i class="fa fa-exchange"></i> Proceed to Transfer</button>' +
                        '</div>' +
                        '</div>';
                    $container.html(html).slideDown();
                } else {
                    var html = '<div class="verification-card-danger">' +
                        '<i class="fa fa-times-circle text-danger"></i> <b>No Student Found:</b> Roll No "' + rollNo + '" does not match any active student record.' +
                        '</div>';
                    $container.html(html).slideDown();
                }
            },
            error: function () {
                swal("Error", "Error verifying roll number.", "error");
            }
        });
    }

    function openTransferModalFromVerify(studentId, rollNo, studentName, progGroupId, progName, classId, className) {
        openTransferModal(studentId, rollNo, studentName, progGroupId, progName, classId, className);
    }

    function openTransferModal(studentId, rollNo, studentName, progGroupId, progName, classId, className) {
        $('#modalStudentId').val(studentId);
        $('#modalCurrentRollNo').text(rollNo);
        $('#modalStudentName').text(studentName);
        $('#modalCurrentProgGroupId').val(progGroupId);
        $('#modalCurrentProgramme').text(progName || "Not Assigned");
        $('#modalCurrentClassId').val(classId);
        $('#modalCurrentClass').text(className || "-");
        $('#modalCurrentClassYear').val('');

        $('#ddlTransferProgramme').empty().append('<option value="">Loading allowed programmes...</option>').selectpicker('refresh');
        $('#ddlTransferClass').empty().append('<option value="">-- Select Target Class --</option>').selectpicker('refresh');
        $('#lblProgrammeFilterInfo').hide();
        $('#txtNewRollNo').val('');
        $('#txtTransferRemarks').val('');
        $('#modalRollNoVerifyResult').hide().empty();
        $('#divClassRollNoSuggestion').hide();
        $('#lblLastRollNo').text('-');
        $('#lblLastRollNoVal').text('-');
        $('#lblNextRollNoVal').text('-');
        $('#lblClassStudentCount').text('0');
        isNewRollNoVerified = false;

        $('#modalProgrammeTransfer').modal('show');

        // Dynamically fetch programmes matching student's Shift and UG/PG level
        if (classId) {
            $.ajax({
                url: '@Url.Action("GetTransferProgrammesByClass", "Student")',
                type: 'GET',
                data: { sClassId: classId },
                success: function (res) {
                    if (res && res.success) {
                        $('#ddlTransferProgramme').html(res.options).selectpicker('refresh');
                        $('#modalCurrentClassYear').val(res.classYear || '');
                        var filterLabel = 'Matching: ';
                        if (res.shiftName) { filterLabel += 'Shift ' + res.shiftName; }
                        if (res.levelName) { filterLabel += ' - ' + res.levelName; }
                        filterLabel += ' (' + res.count + ' programmes)';
                        $('#lblFilterText').text(filterLabel);
                        $('#lblProgrammeFilterInfo').show();
                    } else {
                        $('#ddlTransferProgramme').html('<option value="">-- No Matching Programmes Found --</option>').selectpicker('refresh');
                    }
                },
                error: function () {
                    $('#ddlTransferProgramme').html('<option value="">-- Error Loading Programmes --</option>').selectpicker('refresh');
                }
            });
        }
    }

    function loadClassesForProgramme(progGroupId) {
        $('#divClassRollNoSuggestion').hide();
        $('#txtNewRollNo').val('');
        $('#modalRollNoVerifyResult').hide().empty();
        isNewRollNoVerified = false;

        if (!progGroupId) {
            $('#ddlTransferClass').empty().append('<option value="">-- Select Target Class --</option>').selectpicker('refresh');
            return;
        }

        var classYear = $('#modalCurrentClassYear').val();
        $.ajax({
            url: '@Url.Action("GetClassesByProgrammeGroup", "Student")',
            type: 'GET',
            data: { sProgrammeGroupId: progGroupId, sClassYear: classYear },
            success: function (data) {
                $('#ddlTransferClass').html(data).selectpicker('refresh');
            },
            error: function () {
                swal("Error", "Failed to load classes for selected programme.", "error");
            }
        });
    }

    function fetchClassRollNoDetails(classId, acYear) {
        if (!classId) {
            $('#divClassRollNoSuggestion').hide();
            $('#txtNewRollNo').val('');
            $('#modalRollNoVerifyResult').hide().empty();
            isNewRollNoVerified = false;
            return;
        }

        $.ajax({
            url: '@Url.Action("GetLastRollNoByClass", "Student")',
            type: 'GET',
            data: { sClassId: classId, sAcYear: acYear },
            success: function (res) {
                if (res && res.success) {
                    if (res.lastRollNo) {
                        $('#lblLastRollNo').text(res.lastRollNo);
                        $('#lblLastRollNoVal').text(res.lastRollNo);
                        $('#lblNextRollNoVal').text(res.nextRollNo || res.lastRollNo);
                        $('#lblClassStudentCount').text(res.totalStudents);
                        $('#divClassRollNoSuggestion').slideDown();

                        // Automatically populate the New Roll No with the next sequential number (or last one)
                        var autoRollNo = res.nextRollNo ? res.nextRollNo : res.lastRollNo;
                        $('#txtNewRollNo').val(autoRollNo);

                        // Automatically trigger verification to show the green confirmation card
                        VerifyModalNewRollNo();
                    } else {
                        $('#lblLastRollNo').text("None (Class is empty)");
                        $('#lblClassStudentCount').text("0");
                        $('#lblNextRollNoVal').text("-");
                        $('#lblLastRollNoVal').text("-");
                        $('#divClassRollNoSuggestion').slideDown();
                        $('#txtNewRollNo').val('');
                        $('#modalRollNoVerifyResult').hide().empty();
                        isNewRollNoVerified = false;
                    }
                }
            },
            error: function () {
                $('#divClassRollNoSuggestion').hide();
            }
        });
    }

    function applySuggestedRollNo(type) {
        var rollNo = (type === 'last') ? $('#lblLastRollNoVal').text() : $('#lblNextRollNoVal').text();
        if (rollNo && rollNo !== "-" && rollNo !== "None") {
            $('#txtNewRollNo').val(rollNo);
            VerifyModalNewRollNo();
        }
    }

    // Modal New Roll No Verification
    function VerifyModalNewRollNo() {
        var newRollNo = $('#txtNewRollNo').val();
        var currentStuId = $('#modalStudentId').val();

        if (!newRollNo || newRollNo.trim() === "") {
            swal("Enter New Roll No", "Please enter a new roll number to verify.", "warning");
            return;
        }

        newRollNo = newRollNo.trim();
        $.ajax({
            url: '@Url.Action("VerifyRollNumber", "Student")',
            type: 'GET',
            data: { sRollNo: newRollNo, sCurrentStudentId: currentStuId },
            success: function (res) {
                var $box = $('#modalRollNoVerifyResult');
                if (res && res.IsAssigned) {
                    isNewRollNoVerified = false;
                    var html = '<div class="verification-card-danger">' +
                        '<i class="fa fa-times-circle text-danger"></i> <b>Already in use:</b> Assigned to ' + (res.StudentName || '') + ' (' + (res.ClassName || '') + ')' +
                        '</div>';
                    $box.html(html).slideDown();
                } else {
                    isNewRollNoVerified = true;
                    var html = '<div class="verification-card-success">' +
                        '<i class="fa fa-check-circle" style="color: #10b981;"></i> <b>Available:</b> Roll No "' + newRollNo + '" is free and ready to assign.' +
                        '</div>';
                    $box.html(html).slideDown();
                }
            },
            error: function () {
                swal("Error", "Error verifying roll number.", "error");
            }
        });
    }

    function SubmitProgrammeTransfer() {
        var studentId = $('#modalStudentId').val();
        var studentName = $('#modalStudentName').text();
        var currentRollNo = $('#modalCurrentRollNo').text();
        var currentProgGroupId = $('#modalCurrentProgGroupId').val();
        var currentProgName = $('#modalCurrentProgramme').text();
        var currentClassId = $('#modalCurrentClassId').val();
        var currentClassName = $('#modalCurrentClass').text();

        var transferProgGroupId = $('#ddlTransferProgramme').val();
        var transferProgName = $('#ddlTransferProgramme option:selected').text();
        var transferClassId = $('#ddlTransferClass').val();
        var transferClassName = $('#ddlTransferClass option:selected').text();

        var newRollNo = $('#txtNewRollNo').val();
        var remarks = $('#txtTransferRemarks').val();
        var acYear = $('#ddlAcademicYear option:selected').text();

        if (!transferProgGroupId) {
            swal("Select Programme", "Please select a Target Programme.", "warning");
            return;
        }

        if (!transferClassId) {
            swal("Select Class", "Please select a Target Class.", "warning");
            return;
        }

        if (!newRollNo || newRollNo.trim() === "") {
            swal("Enter Roll No", "Please enter the New Roll No.", "warning");
            return;
        }

        if (!remarks || remarks.trim() === "") {
            swal("Enter Remarks", "Please enter remarks or reason for the programme transfer.", "warning");
            return;
        }

        swal({
            title: "Confirm Programme Transfer?",
            text: "Transfer student '" + studentName + "' (" + currentRollNo + ") to '" + transferProgName + "' with New Roll No: '" + newRollNo + "'?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-success",
            confirmButtonText: "Yes, Transfer!",
            closeOnConfirm: false
        }, function () {
            var postData = {
                StudentId: studentId,
                StudentName: studentName,
                CurrentRollNo: currentRollNo,
                NewRollNo: newRollNo.trim(),
                CurrentProgrammeGroupId: currentProgGroupId,
                CurrentProgrammeName: currentProgName,
                CurrentClassId: currentClassId,
                CurrentClassName: currentClassName,
                TransferProgrammeGroupId: transferProgGroupId,
                TransferProgrammeName: transferProgName,
                TransferClassId: transferClassId,
                TransferClassName: transferClassName,
                AcademicYear: acYear,
                Remarks: remarks
            };

            $.ajax({
                url: '@Url.Action("SubmitProgrammeTransfer", "Student")',
                type: 'POST',
                data: postData,
                success: function (res) {
                    if (res && res.ErrorCode == "200") {
                        $('#modalProgrammeTransfer').modal('hide');
                        swal("Transferred!", res.Message, "success");
                        reloadStudentList();
                    } else {
                        swal("Transfer Failed", (res ? res.Message : "Failed to transfer student."), "error");
                    }
                },
                error: function () {
                    swal("Error", "Internal server error occurred.", "error");
                }
            });
        });
    }

    function escapeHtml(text) {
        if (!text) return "";
        return text.replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }
</script>
