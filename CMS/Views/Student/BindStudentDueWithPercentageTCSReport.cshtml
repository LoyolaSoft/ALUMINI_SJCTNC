

@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@using System.Globalization;
@{
    ViewBag.Title = "BindStudentDueWithPercentageTCSReport";
    Layout = null;
    int count = 0;

    var currentDate = DateTime.Now.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
}


@if (Model.liFeeDueReport != null && Model.liFeeDueReport.Count > 0)
{
    var liGroupClass = Model.liFeeDueReport.GroupBy(x => x.CLASS_ID).ToList();
    foreach (var Classitem in liGroupClass)
    {
        count = 0;
        var liDue = Model.liFeeDueReport.Where(x => x.CLASS_ID == Classitem.FirstOrDefault().CLASS_ID).ToList();
        if (liDue != null && liDue.Count > 0)
        {
            <div style="page-break-after:always !important;">
                <table class="table table-hover table-bordered" width="100%" id="StudentList">
                    <thead>
                        <tr>
                            <th class="text-center" colspan="7">ST.JOSEPH'S COLLEGE OF ARTS AND SCIENCE (AUTONOMOUS), CUDDALORE</th>
                        </tr>
                        <tr>
                            <th>
                            </th>
                            <th colspan="5" class="text-center">
                                <b> @liDue.FirstOrDefault().CLASS_NAME  - @currentDate</b>
                            </th>
                            <th>

                            </th>
                        </tr>
                        <tr>
                            <th><b>#</b></th>
                            <th><b>Roll No</b></th>
                            <th><b>Umis No</b></th>
                            <th><b>Name</b></th>
                            <th><b>Dues</b></th>
                            <th><b>Percentage</b></th>
                            <th><b>Signature</b></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (liDue != null)
                        {
                            foreach (var item in liDue)
                            {
                                var sPercentage = 0.0;
                                var absentCount = 0;
                                if (Model.liAttendanceReport != null)
                                {
                                    var findStuId = Model.liAttendanceReport.Where(o => o.STUDENT_ID == item.STUDENT_ID).OrderBy(o => o.STUDENT_ID);
                                    if (findStuId != null)
                                    {
                                        var sAbseentCount = Convert.ToInt32(findStuId.FirstOrDefault().DAYS_COUNT) - Convert.ToInt32(findStuId.FirstOrDefault().ABSENT_COUNT);
                                        sPercentage = Convert.ToDouble(sAbseentCount) / Convert.ToDouble(findStuId.FirstOrDefault().DAYS_COUNT) * 100;
                                        absentCount = Convert.ToInt32(findStuId.FirstOrDefault().ABSENT_COUNT);
                                    }
                                }
                                <tr>
                                    <td>
                                        @{ count++;} <b>@count</b>
                                    </td>

                                    <td>
                                        @item.ROLL_NO
                                    </td>
                                    <td>
                                        @item.UMIS_NO
                                    </td>
                                    <td>
                                        @item.FIRST_NAME
                                    </td>
                                    <td>
                                        @item.TOTAL_DUE_AMOUNT  @item.REASON
                                    </td>
                                    <td>
                                        <b> @Math.Round(sPercentage, 2) % </b>

                                    </td>
                                    <td>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        }
    }
}