@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;

}
@if (Model.liStudent != null && Model.liStudent.Count > 0)
{
    var ligrouppro = Model.liStudent.GroupBy(x => x.PROGRAMME_GROUP_ID).ToList();
    foreach (var grouppro in ligrouppro)
    {
        var liGroupclass = Model.liStudent.Where(x => x.PROGRAMME_GROUP_ID == grouppro.FirstOrDefault().PROGRAMME_GROUP_ID).GroupBy(x => x.CLASS_ID).ToList();
        <h3 class="text-center">@grouppro.FirstOrDefault().PROGRAMME_NAME</h3>
        <div style="page-break-after:always !important;page-break-inside:avoid !important;">
            @foreach (var classitem in liGroupclass)
            {
                int nCount = 0;
                var listu = Model.liStudent.Where(x => x.PROGRAMME_GROUP_ID == grouppro.FirstOrDefault().PROGRAMME_GROUP_ID && x.CLASS_ID == classitem.FirstOrDefault().CLASS_ID).OrderBy(x => x.REGISTER_NO).ToList();
                <h3>@classitem.FirstOrDefault().CLASS_NAME</h3>
                <table class="table table-bordered" id="studentlist">
                    <thead>
                        <tr>
                            <td>S.No.</td>
                            <td>Admission No.</td>
                            <td>Roll No.</td>
                            <td>Student Name</td>
                            <td>Date Of Birth</td>
                            <td>Action</td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listu)
                        {
                            <tr>
                                <td>@{nCount++;}@nCount</td>
                                <td>@item.ADMISSION_NO</td>
                                <td>@item.ROLL_NO</td>
                                <td>@item.FIRST_NAME</td>
                                <td>@item.DATE_OF_BIRTH</td>
                                <td>
                                    <a class="btn btn-danger" href="#StudentList-dialog" onclick="FetchstudentDetailsForRejoin(@item.STUDENT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i>Rejoin</a>
                                </td>
                            </tr>


                        }
                    </tbody>
                </table>
            }
        </div>

    }
}
else
{
    <div class="bg-warning">
        <h3 >No Record's Found </h3>
    </div>
}




