


@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "Malpractice";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    /* Layout = null;*/
}



@*<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />*@
<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->



<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("ADMIN","DashBoard")">Home</a></li>
        <li class="active">Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin #page-loader -->
    @*<div id="page-loader" class="fade in"><span class="spinner"></span></div>*@
    <!-- end #page-loader -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Malpractice</h1>
    <!-- end page-header -->
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Student List</h3>
        </div>
        <div class="panel-body">

            <div class="form-group">
                <a class="btn bg-green pull-right" title="Add Student" href="#" onclick="loadContent('@Url.Action("Malpractice","Student")')"><i class="fa fa-plus"></i> Add</a>
            </div><br /><br />

            <div class="form-group table-responsive">

                <table class="table table-hover table-bordered" id="StudentList">
                    <thead>
                        <tr>

                            <th>Register No</th>
                            <th>Student Name</th>
                            <th>Class Name</th>
                            <th>Course Title</th>
                            @*<th>Date</th>*@
                            @*     <th>Shift</th>
                                <th>Is Left</th>
                                <th>Action</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.limalpractice != null && Model.limalpractice.Any())
                        {
                            foreach (var item in Model.limalpractice)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.ROLL_NO)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FIRST_NAME)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CLASS_NAME)</td>
                                    <td>@Html.DisplayFor(modelItem => item.COURSE_TITLE)</td>
                                    @*<td>@Html.DisplayFor(modelItem => item.ENTRY_DATE)</td>*@
                                    @*  <td>
                                            <a href="#" onclick="loadContent('/Student/EditStudentInfomation/@item.STUDENT_ID')" title="Click To Edit">
                                                <i class="fa fa-edit text-primary"></i>
                                            </a>
                                            <a onclick="GetConfirm('@item.STUDENT_ID')" title="Click To Delete">
                                                <i class="fa fa-trash text-danger"></i>
                                            </a>
                                        </td>*@
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">No records found.</td>
                            </tr>
                        }



                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @*<div id="dvStudentList"></div>*@

</div>


