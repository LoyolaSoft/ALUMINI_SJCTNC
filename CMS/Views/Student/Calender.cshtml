    // Fetch DayId By Day order date and day order end date
    function DayIdByDayOrderDateandDayOrderEndDate(dayOrderDate,dayOrderEndDate)
    {
        if (dayOrderDate != null && dayOrderEndDate!=null)
        {
            $.ajax({

                url: "@Url.Action("FetchDayIdByDayOrderDate", "Student")",
                method: "POST",
            datatype: "json",
            data: { sDayOrderDate: dayOrderDate, sdayOrderEndDate: dayOrderEndDate },
            success:function(data)
            {
                if(data.Message!=null)
                {
                    alert(data.Message);
                }
                else
                {
                    //alert("FROM SERVER" + data.sResult);
                    $('#dayId').attr('value', data.sResult);

                    //return data.sResult;
                }
            },
            error: function (error) {
                alert("Internal Server Error ...!");
            }
        });
    }
        else
        {
            alert("Please select all the fields");
        }
    }

    $('#ddlDayOrderList').on('change', function ()
    {

        $('#cbxIsHoliday').attr('checked',false);
        
    });
</script>



