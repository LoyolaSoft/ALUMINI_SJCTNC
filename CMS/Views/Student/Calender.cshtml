@* Ready Function *@
<script>
    function ContentLoad()
    {

        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');

            var events = [];
            $("#btnEventUpdate").hide();
            $("#btnDelete").hide();
            handleDatePicker = function () {
                "use strict";
                $("#StartDate,#EndDate").datepicker({
                    todayHighlight: true,
                    autoclose: true,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                });
            }
            handleDatePicker();

            App.init();
            //GetCalender DayOrder....
            GetCalender = function () {
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("GetCalender", "Student")",
                    success: function (data) {
                        $.each(data, function (i, v) {
                            events.push({
                                id: v.DAY_ID,
                                dayorderid: v.DAY_ORDER_ID,
                                title: v.DAY_ORDER,
                                start: v.SYEAR + "-" + v.SMONTH + v.SDAY,
                                end: v.EYEAR + "-" + v.EMONTH + v.EDAY,
                                color: v.COLOR,
                                holiday: v.IS_HOLIDAY,
                                allDay: v.DAY_ORDER
                            });
                        })
                        handleCalendarDemo(events);
                    }, error: function (error) {
                        alert('Falied To Get Record ...!');
                    }
                });
            }

            // GetCalenderEvents ...\
            GetCalenderEvent = function () {
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("GetCalenderEvent", "Student")",
                    success: function (data) {
                        $.each(data, function (i, v) {
                            if (v.EVENT_ID != '')
                            {
                                if (v.DAY_ORDER != '')
                                {
                                    events.push({
                                        id: v.EVENT_ID,
                                        title: v.DAY_ORDER,
                                        start: v.SYEAR + "-" + v.SMONTH + v.SDAY,
                                        end: v.EYEAR + "-" + v.EMONTH + v.EDAY,
                                        color: v.COLOR,
                                        description: v.EVENT_DESCRIPTION,
                                        EventType: v.EVENT_TYPE,
                                        type: "event",
                                        allDay: true
                                    });
                                }
                            } else
                            {
                                if (v.DAY_ORDER != '')
                                {
                                    events.push({
                                        id: v.DAY_ID,
                                        dayorderid: v.DAY_ORDER_ID,
                                        title: v.DAY_ORDER,
                                        start: v.SYEAR + "-" + v.SMONTH + v.SDAY,
                                        end: v.EYEAR + "-" + v.EMONTH + v.EDAY,
                                        color: v.COLOR,
                                        description: v.EVENT_DESCRIPTION,
                                        holiday: v.IS_HOLIDAY,
                                        EventType: v.EVENT_TYPE,
                                        type:"dayorder",
                                        allDay: true
                                    });

                                }
                            //alert('day_order');
                            }

                        })
                        handleCalendarDemo(events);
                    }, error: function (error) {
                        alert('Falied To Get Record ...!');
                    }
                });
            }
            GetCalenderEvent();
            FetchDepartment();
    }
