    //function for
    function GetDayIdForDayOrderUpdate(Data) {

        if (Data.type == "0") {
            //before getting dayId for this start date and end date update day order 0
            if (Data.dayId != null && Data.dayId != "")
            {
                var JsonData;
                if (JsonData == null) {
                    JsonData = '{"DAY_ID":"' + Data.dayId + '","DAY_ORDER":"0","DAY_ORDER_DATE":"' + Data.startDate + '","DAY_ORDER_END_DATE":"' + Data.endDate + '","IS_HOLIDAY":"' + Data.isHoliday + '"}';
                }
                $.ajax({
                    url: "@Url.Action("UpdateDayOrder", "Student")",
                    method: "POST",
                datatype: "json",
                data: { Event: JsonData },
                success: function (data) {
                    if(data.Message!=null)
                    {
                        alert(data.Message);
                    }
                    else
                    {
                       // alert("success fully update dayorder 0");
                    }
                }, error: function (error) {
                    alert('Internal Server Error ...!');
                }
            });

            }


            if (Data.dayId != null && Data.dayId != "") {
                $.ajax({

                    url: "@Url.Action("FetchDayIdByDayOrderDate", "Student")",
                    method: "POST",
                    datatype: "json",
                    data: { sDayOrderDate: Data.startDate, sdayOrderEndDate: Data.endDate },
                    success: function (data) {
                        if (data.Message != null) {
                            alert(data.Message);
                        }
                        else {

                            $('#dayId').attr('value', data.sResult);
                            Data.dayId = $('#dayId').val();


                            if (Data.dayId != null && Data.dayId != "" && Data.dayId != "0") {
                                UpdateDayOrder(Data);
                            }
                            //return data.sResult;
                        }
                    },
                    error: function (error) {
                        alert("Internal Server Error ...!");
                    }
                });
            }
        }
    }

