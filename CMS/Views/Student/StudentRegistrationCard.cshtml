
@model CMS.ViewModel.ViewModel.StudentViewModel
@using CMS.ViewModel.Model;
@using CMS.Utility
@{
    ViewBag.Title = "StudentRegistrationCard";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">StudentRegistrationCard</li>
    </ol>
    <h1 class="page-header">Student Registration Card</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Registration Card</h4>
        </div>
        <div class="panel-body">
            @*<div class="form-group col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#ERRegistration-dialog" data-toggle="modal" id="btnAdd"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>*@

            <div class="col-md-12" id="divPrint">
                @if (Model.liExamRegistrationList != null && Model.liExamRegistrationList.Count > 0)
                {


                    if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
                    {
                        <div class="text-center hidden">
                            @*<img class="image" />*@
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
                        </div>
                        <div class="text-center">

                            <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                            <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                            <h5>
                                STUDENT REGISTRATION CARD &nbsp;-(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                                    { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } }) <br />

                            </h5>
                        </div>
                        <div class="col-md-12">

                            <div class="col-md-6">
                                <h5>Name of the Student : @Model.liExamRegistrationList.FirstOrDefault().FIRST_NAME</h5>
                                <h5>Major Discipline : @Model.liExamRegistrationList.FirstOrDefault().PROGRAMME_NAME</h5>
                                <h5>Roll No : @Model.liExamRegistrationList.FirstOrDefault().ROLL_NO</h5>
                                <h5>Class  : @Model.liExamRegistrationList.FirstOrDefault().CLASS_NAME</h5>

                            </div>

                        </div>


                                    }
                                    <br />
                                    <hr />


                                    <center>
                                        <div class="col-lg-12 table-responsive">
                                            <div id="dvbind_@Model.liExamRegistrationList.FirstOrDefault().STUDENT_ID" style="page-break-after:always !important;page-break-inside:avoid !important;">
                                                <table border="1" id='tblCourses' cellpadding="5">
                                                    <thead class="semi-bold">
                                                        <tr>
                                                            <th>Part and Title of the Course</th>
                                                            <th>Code</th>
                                                            <th>Credit Hours</th>
                                                            <th>
                                                                Sign of the Staff
                                                            </th>

                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.liExamRegistrationList != null && Model.liExamRegistrationList.Count > 0)
                                                        {
                                                            //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                                                            //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                                                            var count = 0;
                                                            foreach (var item in Model.liExamRegistrationList)
                                                            {
                                                                count = count + 1;
                                                                <tr>
                                                                    @*<td>@count</td>*@

                                                                    <td>@item.COURSE_TITLE</td>
                                                                    <td>@item.COURSE_CODE</td>
                                                                    <td style="text-align:center;">@item.CREDITS</td>
                                                                    <td>

                                                                        @if (!string.IsNullOrEmpty(item.SIGN_PATH))
                                                                        {
                                                                            <img src="@item.SIGN_PATH" width=200 height=50></img>
                                                                        }
                                                                        else
                                                                        {

                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }

                                                        }
                                                        else
                                                        {
                                                            <tr><td> No Records Found..! </td> </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                                @if (Model.liExamRegistrationList != null && Model.liExamRegistrationList.Count > 0)
                                                {
                                                    <table class="col-md-12 table-condensed">
                                                        <tr>
                                                            <td width="500px">

                                                                <p>Signature of the Student</p>


                                                            </td>

                                                            <td>
                                                                @if (!string.IsNullOrEmpty(Model.liExamRegistrationList.FirstOrDefault().CS_SIGN_PATH))
                                                                {
                                                                    <img src="@Model.liExamRegistrationList.FirstOrDefault().CS_SIGN_PATH" width=200 height=50></img>
                                                                }


                                                                <p>Signature of the Teacher Counsellor</p>
                                                             

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td width="500px">
                                                                @if (!string.IsNullOrEmpty(Model.liExamRegistrationList.FirstOrDefault().HOD_SIGN_PATH))
                                                                {
                                                                    <img src="@Model.liExamRegistrationList.FirstOrDefault().HOD_SIGN_PATH" width=200 height=50></img>
                                                                }
                                                                <p>Signature of the H.O.D.</p>
                                                              

                                                            </td>

                                                            <td>

                                                                <p>Date: @Model.liExamRegistrationList.FirstOrDefault().CUR_DATE </p>

                                                            </td>
                                                        </tr>
                                                    </table>
                                                }

                                                @*<div class="col-md-12">
                    <div class="col-md-12">

                        <div class="col-md-6">
                            <p>Signature of the Student</p>
                        </div>

                        <div class="col-md-6">
                            <p>Signature of the Teacher Counsellor</p>
                        </div>

                    </div>
                    <br />
                    <div class="col-md-12">

                        <div class="col-md-6">
                            <p>Signature of the H.O.D.</p>
                        </div>

                        <div class="col-md-6">
                            <p>Date:</p>
                        </div>
                    </div>
                </div>*@


                                            </div>


                                            <div class="col-md-12"><button class="btn bg-green pull-right m-b-5" onclick="printDiv('divPrint')">Print</button></div>
                                        </div>
                                    </center>
                                   



                                    }
                                    else
                                    {
                                        <div class="alert alert-danger">No Record(s) Found !</div>
                                    }


            </div>

          
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }

    //var tbl = $('#tblLiERSetting').DataTable();
    $('.selectpicker').selectpicker('refresh');
    

    function printDiv(divName) {

        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;

    }

</script>






