
@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "StudentDetailsList";
    int count = 0;
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}



@*<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />*@
<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<!-- ================== END PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/css/lightbox.min.css" rel="stylesheet" />
<style>
    .img-thumb {
        padding: 4px;
        line-height: 1.42857143;
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        -webkit-transition: all .2s ease-in-out;
        transition: all .2s ease-in-out;
        display: inline-block;
        max-width: 100%;
        height: 80px;
    }
</style>


<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("ADMIN","DashBoard")">Home</a></li>
        <li class="active">Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin #page-loader -->
    @*<div id="page-loader" class="fade in"><span class="spinner"></span></div>*@
    <!-- end #page-loader -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Information</h1>
    <!-- end page-header -->
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Student List</h3>
        </div>
        <div class="panel-body">
            <div>
                <div class="form-group col-md-4">
                    @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <a class="btn bg-green pull-right" title="Add Student" href="#" onclick="loadContent('@Url.Action("AddStudentDetailsInfo","Student")')"><i class="fa fa-plus"></i> Add</a>
            </div>

            <br />
            <hr />
            <br />
            <div id="bindstudentlistforEdit">


                <div class="form-group table-responsive">

                    <table class="table table-hover table-bordered" id="StudentList">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Photo</th>
                                <th>Roll No</th>
                                <th>Student Name</th>
                                <th>Adm No</th>
                                <th>Class</th>
                                <th>Shift</th>
                                <th>Is Left</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.liStudentList != null && Model.liStudentList.Count>0)
                            {
                                foreach (var item in Model.liStudentList)
                                {
                                    <tr id="@item.STUDENT_ID">
                                        <td>
                                            @{count++;} @count
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.PHOTO))
                                            {
                                                <img src="@item.PHOTO" itemprop="thumbnail" class="img-thumb" alt="@item.ROLL_NO" onerror="this.onerror=null;this.src='@Url.Content("~/Content/assets/img/transparent/e-user.jpg")';" />
                                            }
                                            else
                                            {
                                                <img src="@Url.Content("~/Content/assets/img/transparent/e-user.jpg")" itemprop="thumbnail" class="img-thumb" alt="@item.ROLL_NO Icon" />
                                            }
                                            @*<img src="@item.PHOTO" itemprop="thumbnail" class="img-thumb" alt="@item.ROLL_NO Icon" onerror="this.onerror=null;this.src='@Url.Content("~/Content/assets/img/transparent/e-user.jpg")';" />*@

                                        </td>
                                        <td>

                                            @Html.DisplayFor(modelItem => item.ROLL_NO)
                                        </td>
                                        @*<td>

                                                @Html.DisplayFor(modelItem => item.REGISTER_NO)
                                            </td>*@
                                        <td>
                                            @Html.DisplayFor(modelItem => item.FIRST_NAME)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ADMISSION_NO)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.CLASS_NAME)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.SHIFT_NAME)
                                        </td>
                                        @if (item.IS_LEFT == "YES")
                                        {
                                            <td class="text-danger">
                                                <b>
                                                    @Html.DisplayFor(modelItem => item.IS_LEFT)
                                                </b>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>

                                                @Html.DisplayFor(modelItem => item.IS_LEFT)
                                            </td>
                                        }
                                        <td>
                                            @*<a href="#" onclick="loadContent('/Student/EditStudentPersonalInfomation/'+@item.STUDENT_ID +,+$('#AcademicYear option:selected').text())" title="Click To Edit"><i class="fa fa-edit text-primary"></i></a>*@
                                            <a href="#"
                                               onclick="loadContent('/Student/EditStudentPersonalInfomation?ID=@item.STUDENT_ID&sAcyear=' + encodeURIComponent($('#AcademicYear').val()))"
                                               title="Click To Edit">
                                                <i class="fa fa-edit text-primary"></i>
                                            </a>

                                            <a onclick="GetConfirm('@item.STUDENT_ID', '@item.ROLL_NO')" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                                        </td>
                                    </tr>
                                }
                            }


                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    @*<div id="dvStudentList"></div>*@

</div>


@*<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>*@

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/js/lightbox.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad()
    {
        $("#StudentList").DataTable({
            dom: "lBfrtip", buttons: [{
                extend: "copy", className: "btn-sm"
            }
                , {
                extend: "excel", className: "btn-sm"
            }
                , {
                extend: "pdf", className: "btn-sm"
            }
            ], responsive: !0, "paging": true, "ordering": true
        });
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

    }

    $('#AcademicYear').on('change', function () {

        $.ajax({

             url: '@Url.Action("BindAcYearWiseStudentList", "Student")',
            type: "POST",
            datatype: 'json',
            data: { sAcYear: $("#AcademicYear option:selected").text() },
            success: function (data) {
                $("#bindstudentlistforEdit").empty();
                $("#bindstudentlistforEdit").append(data);
                $("#tblStudentList").DataTable({
                    dom: "lBfrtip", buttons: [{
                        extend: "copy", className: "btn-sm"
                    }
                        , {
                        extend: "excel", className: "btn-sm"
                    }
                        , {
                        extend: "pdf", className: "btn-sm"
                    }
                    ], responsive: !0, "paging": true, "ordering": true
                });

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

})
    // Delete Student ...
    function GetConfirm(STUDENTID, ROLLNO)
    {

        //$('.table tbody').find('#' + STUDENTID).parents
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        } else
        {
            var remark = prompt('Please enter a reason for deleting this account:');

            // If the user cancels the remark prompt or leaves it empty
            if (remark === null || remark.trim() === "") {
                alert("Deletion requires a valid reason. Operation cancelled.");
                return false;
            }
            $.ajax({
                url:"@Url.Action("DeleteStudentPersonalInfo", "Student")",
                method: "POST",
                datatype:"json",
                data: { sStudentId: STUDENTID, UserName: ROLLNO ,deleteRemark: remark },
                success:function(data)
                {
                    alert(data);
                    loadContent('/Student/StudentDetailsList');
                },error:function(error)
                {
                    alert('Internal Serer Error ');
                }
            });
        }
    }
</script>










