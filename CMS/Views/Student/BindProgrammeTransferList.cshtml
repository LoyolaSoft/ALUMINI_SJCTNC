@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
    int count = 0;
}

<div class="table-responsive">
    <table class="table table-hover table-bordered table-striped" id="tblTransferStudentList" width="100%">
        <thead>
            <tr style="background-color: #f1f5f9; color: #1e293b;">
                <th style="width: 40px;" class="text-center">#</th>
                <th style="width: 60px;" class="text-center">Photo</th>
                <th class="text-center">Roll No</th>
                <th class="text-center">Student Name</th>
                <th class="text-center">Adm No</th>
                <th class="text-center">Current Class</th>
                <th class="text-center">Shift</th>
                <th class="text-center">Status</th>
                <th style="width: 90px;" class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
            {
                foreach (var item in Model.liStudentList)
                {
                    count++;
                    <tr>
                        <td class="text-center font-bold">@count</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.PHOTO))
                            {
                                <img src="@item.PHOTO" class="img-thumb" style="height: 50px; border-radius: 4px;" alt="@item.ROLL_NO" onerror="this.onerror=null;this.src='@Url.Content("~/Content/assets/img/transparent/e-user.jpg")';" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/Content/assets/img/transparent/e-user.jpg")" class="img-thumb" style="height: 50px; border-radius: 4px;" alt="User" />
                            }
                        </td>
                        <td><b class="text-primary">@item.ROLL_NO</b></td>
                        <td><b>@item.FIRST_NAME</b></td>
                        <td>@(string.IsNullOrEmpty(item.ADMISSION_NO) ? "-" : item.ADMISSION_NO)</td>
                        <td>@(string.IsNullOrEmpty(item.CLASS_NAME) ? "-" : item.CLASS_NAME)</td>
                        <td>@(string.IsNullOrEmpty(item.SHIFT_NAME) ? "-" : item.SHIFT_NAME)</td>
                        <td class="text-center">
                            @if (item.IS_LEFT == "YES")
                            {
                                <span class="label label-danger">Left</span>
                            }
                            else
                            {
                                <span class="label label-success">Active</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-xs btn-primary"
                                    title="Transfer Programme"
                                    onclick="openTransferModal('@item.STUDENT_ID', '@item.ROLL_NO', '@HttpUtility.JavaScriptStringEncode(item.FIRST_NAME)', '@item.PROGRAMME_GROUP_ID', '@HttpUtility.JavaScriptStringEncode(item.PROGRAMME_NAME ?? "")', '@item.CLASS_ID', '@HttpUtility.JavaScriptStringEncode(item.CLASS_NAME ?? "")')">
                                <i class="fa fa-exchange"></i> Transfer
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted" style="padding: 25px;">
                        <i class="fa fa-info-circle text-info" style="font-size: 20px;"></i> No student records found for the selected criteria.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
