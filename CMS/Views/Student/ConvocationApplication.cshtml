        }
        // Get Photo Extention ....
        var photo = ''; photo = getBase64AndExtension();
        var Rollno = $('#Rollno').val();
        $.ajax({
            url: "@Url.Action("SaveConvocationApplication", "Student")",
            method: "POST",
            datatype: "html",
            data: { ConvocationApplication: JsonData, sBaseImage: photo.base64String, sExtension: photo.sextension, sRollno: Rollno },
            success: function (data)
            {

                if (data != 'False')
                {
                    alert('Record Updated successfully..!');
                    Validate();
                } else {
                    alert('Record not Updated try again ..!');
                }

            }, error: function (error) {
                alert('Record not Updated try again ..!');
            }
    });
    })
