<script>
    function ContentLoad()
    {        
        $('#objConvocationApplication_TAMIL_NAME').on('keydown', function (event)
        {
            if (event.which == 121)
            {
                $(this).toggleClass('tamil');
                return false;
            }
            if ($(this).hasClass('tamil'))
            {
                toggleKBMode(event);
            } else {
                return true;
            }
        });
        $('#objConvocationApplication_TAMIL_NAME').on('keypress', function (event)
        {           
            if ($(this).hasClass('tamil'))
            {
                convertThis(event);
            }
        });
        handleDatepicker();
        Validate();
    }
    function Validate()
    {
        $.ajax({
            url: "@Url.Action("Convacationvalidate", "Student")",
            method: "POST",
            datatype: "html",
            data: {},
            success: function (data)
            {
                if(data.Message=="0")
                {
                    $('#Registereddiv').addClass('hidden');                   
                    FetchApplicantInfo();
                }
                else if(data.Message=="1")
                {
                    $('#Registereddiv').removeClass('hidden');
                    FetchApplicantInfo();
                }               
            }, error: function (error)
            {
                alert('Internal Server Error ..!');
            }
        });
      }
    function FetchApplicantInfo()
    {
        $.ajax({
            url:"@Url.Action("FetchConvocationApplicantInfo", "Student")",
            method:"POST",
            datatype: "json",            
        success:function(data)
        {        
            if (data[0].STUDENT_ID != null && data[0].STUDENT_ID != '')
            {
                var tamilname = decodeURI(data[0].TAMIL_NAME1);      
                $("#objConvocationApplication_FIRST_NAME").val(data[0].FIRST_NAME);
                $("#objConvocationApplication_DATE_OF_BIRTH").val(data[0].DATE_OF_BIRTH);
                $("#objConvocationApplication_GENDER").val(data[0].GENDER);
                $("#objConvocationApplication_RELIGION").val(data[0].RELIGION);
                $("#objConvocationApplication_CASTE").val(data[0].CASTE);
                $("#objConvocationApplication_COMMUNITY").val(data[0].COMMUNITY);
                $("#objConvocationApplication_FATHER_NAME").val(data[0].FATHER_NAME);
                $("#objConvocationApplication_MOTHER_NAME").val(data[0].MOTHER_NAME);
                $("#objConvocationApplication_P_DOOR_DEATAIL").val(data[0].P_DOOR_DEATAIL);
                $("#objConvocationApplication_P_STREET").val(data[0].P_STREET);
                $("#objConvocationApplication_P_VILLAGE_AREA").val(data[0].P_VILLAGE_AREA);
