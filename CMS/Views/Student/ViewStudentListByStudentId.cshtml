@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
}


<style>
    .section-title {
        font-weight: bold;
        background: #2c9dbf;
        margin-top: 20px;
        margin-bottom: 10px;
        /* border-bottom: 2px solid #ddd; */
        padding: 10px;
        color: white;
    }

    .detail-row {
        display: flex;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .detail-label {
        flex: 0 0 40%;
        max-width: 40%;
        font-weight: bold;
        color: #555;
    }

    .detail-value {
        flex: 0 0 60%;
        max-width: 60%;
        word-wrap: break-word;
        white-space: normal;
    }

    @@media (max-width: 767px) {
        .detail-label, .detail-value {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .detail-label {
            margin-bottom: 2px;
        }
    }

    .student-photo {
        width: 200px;
        height: 200px;
        margin-bottom: 15px;
    }
</style>

<div class="">
    @if (Model.liStudent != null && Model.liStudent.Count > 0)
    {
        var s = Model.liStudent.FirstOrDefault();
        <div class="row">
            <div class="col-md-12 text-center">
                @if (!string.IsNullOrEmpty(s.PHOTO))
                {
                    <img src="@s.PHOTO" itemprop="thumbnail" class="img-thumb img-thumbnail student-photo" alt="@s.ROLL_NO" />
                }
                else
                {
                    <img src="~/Content/assets/img/transparent/e-user.jpg" itemprop="thumbnail" class="img-thumb student-photo" alt="@s.ROLL_NO Icon" />
                }
                <h4>@s.FIRST_NAME</h4>
                <p class="text-muted">@s.ROLL_NO</p>
            </div>
            <div class="col-md-12">
                <div class="section-title">Academic Details</div>
                <div class="detail-row"><div class="detail-label">Register No:</div><div class="detail-value">@s.REGISTER_NO</div></div>
                <div class="detail-row"><div class="detail-label">Admission No:</div><div class="detail-value">@s.ADMISSION_NO</div></div>
                <div class="detail-row"><div class="detail-label">Admission Date:</div><div class="detail-value">@s.ADMISSION_DATE</div></div>
                <div class="detail-row"><div class="detail-label">Programme:</div><div class="detail-value">@s.PROGRAMME_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Class:</div><div class="detail-value">@s.CLASS_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Batch:</div><div class="detail-value">@s.BATCH</div></div>
                <div class="detail-row"><div class="detail-label">Last School:</div><div class="detail-value">@s.LAST_SCHOOL_OR_COLLEGE</div></div>
                <div class="detail-row"><div class="detail-label">Last Studied Place:</div><div class="detail-value">@s.LAST_STUDIED_PLACE</div></div>

                <div class="section-title">Personal Details</div>
                <div class="detail-row"><div class="detail-label">Tamil Name:</div><div class="detail-value">@s.TAMIL_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Gender:</div><div class="detail-value">@s.GENDER</div></div>
                <div class="detail-row"><div class="detail-label">Date of Birth:</div><div class="detail-value">@s.DATE_OF_BIRTH</div></div>
                <div class="detail-row"><div class="detail-label">Religion:</div><div class="detail-value">@s.RELIGION</div></div>
                <div class="detail-row"><div class="detail-label">Community:</div><div class="detail-value">@s.COMMUNITY</div></div>
                <div class="detail-row"><div class="detail-label">Caste:</div><div class="detail-value">@s.CASTE</div></div>
                <div class="detail-row"><div class="detail-label">Mother Tongue:</div><div class="detail-value">@s.MOTHER_TONGUE</div></div>
                <div class="detail-row"><div class="detail-label">Blood Group:</div><div class="detail-value">@s.BLOOD_GROUP</div></div>
                <div class="detail-row"><div class="detail-label">Nationality:</div><div class="detail-value">@s.NATIONALITY</div></div>
                <div class="detail-row"><div class="detail-label">Residency Type:</div><div class="detail-value">@s.RESIDENCY_TYPE</div></div>
                <div class="detail-row"><div class="detail-label">Specially Abled:</div><div class="detail-value">@s.SPECIALLY_ABLED</div></div>

                <div class="section-title">Parent Details</div>
                <div class="detail-row"><div class="detail-label">Father Name:</div><div class="detail-value">@s.FATHER_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Father Occupation:</div><div class="detail-value">@s.FR_OCCUPATION</div></div>
                <div class="detail-row"><div class="detail-label">Father Income:</div><div class="detail-value">@s.FR_INCOME</div></div>
                <div class="detail-row"><div class="detail-label">Father Mobile:</div><div class="detail-value">@s.FR_MOBILE</div></div>
                <div class="detail-row"><div class="detail-label">Mother Name:</div><div class="detail-value">@s.MOTHER_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Mother Occupation:</div><div class="detail-value">@s.MO_OCCUPATION</div></div>
                <div class="detail-row"><div class="detail-label">Mother Income:</div><div class="detail-value">@s.MO_INCOME</div></div>

                <div class="section-title">Contact Details</div>
                <div class="detail-row"><div class="detail-label">Email:</div><div class="detail-value">@s.STU_EMAILID</div></div>
                <div class="detail-row"><div class="detail-label">Mobile No:</div><div class="detail-value">@s.STU_MOBILENO</div></div>
                <div class="detail-row"><div class="detail-label">Address:</div><div class="detail-value">@s.ADDRESS_LINE1, @s.CITY, @s.DISTRICT, @s.STATE_NAME - @s.PINCODE</div></div>
                <div class="detail-row"><div class="detail-label">Aadhar Number:</div><div class="detail-value">@s.AADHAR_NUMBER</div></div>

                <div class="section-title">Academic Records</div>
                <div class="detail-row"><div class="detail-label">HSS No:</div><div class="detail-value">@s.HSS_NO</div></div>
                <div class="detail-row"><div class="detail-label">Group Code:</div><div class="detail-value">@s.HSS_GROUP_CODE</div></div>
                <div class="detail-row"><div class="detail-label">EMIS No:</div><div class="detail-value">@s.EMIS_NO</div></div>
                <div class="detail-row"><div class="detail-label">Study Board:</div><div class="detail-value">@s.STUDY_BOARD</div></div>
                <div class="detail-row"><div class="detail-label">HSS Total:</div><div class="detail-value">@s.HSS_TOTAL</div></div>
                <div class="detail-row"><div class="detail-label">Medium of Study:</div><div class="detail-value">@s.MEDIUM_STUDY</div></div>
                <div class="detail-row"><div class="detail-label">Extra Curricular:</div><div class="detail-value">@s.EXTRA_CURRRICULAR</div></div>
                <div class="detail-row"><div class="detail-label">Sports:</div><div class="detail-value">@s.SPORTS</div></div>
                <div class="detail-row"><div class="detail-label">First Graduate:</div><div class="detail-value">@s.FIRSTGRADUATE</div></div>

                <div class="section-title">Bank & Other Details</div>
                <div class="detail-row"><div class="detail-label">Bank Name:</div><div class="detail-value">@s.BANK_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Branch Name:</div><div class="detail-value">@s.BRANCH_NAME</div></div>
                <div class="detail-row"><div class="detail-label">Account No:</div><div class="detail-value">@s.ACCOUNT_NO</div></div>
                <div class="detail-row"><div class="detail-label">IFSC Code:</div><div class="detail-value">@s.IFSC_CODE</div></div>
                <div class="detail-row"><div class="detail-label">UMIS No:</div><div class="detail-value">@s.UMIS_NO</div></div>
                <div class="detail-row"><div class="detail-label">Enrollment No:</div><div class="detail-value">@s.ENROLLMENT_NO</div></div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center text-danger">No student details found.</div>
    }
</div>

