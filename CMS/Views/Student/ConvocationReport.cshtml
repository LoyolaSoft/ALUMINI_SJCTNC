
@{
    ViewBag.Title = "ConvocationReport";
    Layout =null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Convocation Application Registred</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Convocation Application Registred<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken();
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Convocation Application Registred</h4>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <div class="col-md-12">
                            <div class="form-group col-md-1"><a id="excel" class="btn btn-success">Excel</a></div>
                            @*<div class="col-md-1"><a id="print" onclick="printDiv('loaddiv')" class="form-control btn btn-success">Print</a></div>*@
                        </div>
                        @{var count = 0; }
                        <div class="form-group col-md-12" id="loaddiv">
                            <table class="table table-hover table-bordered" border="1" id="StudentReporttbl">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Center No</th>
                                        <th>Register No</th>
                                        <th>Name(English)</th>
                                        <th>Name(Tamil)</th>
                                        <th>Degree Name</th>
                                        <th>Gender</th>
                                        <th>DOB</th>
                                        <th>Caste</th>                                      
                                        <th>Community</th>
                                        <th>Father Name</th>
                                        <th>DOFAD</th>
                                        <th>Mobile Number</th>
                                        <th>Religion</th>
                                        <th>Physically</th>   
                                        <th>Email Id</th>                                                                                              
                                        <th>YearofPassed</th>
                                        <th>Aadhar No</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LiConvocationApplicationRegister != null && Model.LiConvocationApplicationRegister.Count > 0)
                                    {
                                        foreach (var item in Model.LiConvocationApplicationRegister)
                                        {
                                            <tr>
                                                <td>@{count++;} @count</td>
                                                <td>@item.CENTER_NO</td>
                                                <td>@item.REGISTER_NO</td>
                                                <td>@item.FIRST_NAME</td>
                                                <td>@HttpUtility.UrlDecode(item.TAMIL_NAME1)</td>
                                                <td>@item.PROGRAMME_NAME</td>
                                                <td>@item.GENDER_NAME</td>
                                                <td>@item.DATE_OF_BIRTH</td>
                                                <td>@item.CASTE</td>
                                                <td>@item.COMMUNITY</td>
                                                <td>@item.FATHER_NAME</td>
                                                <td>@item.DOA</td>
                                                <td>@item.STUDENT_MOBILE_NO</td>
                                                <td>@item.RELIGION</td>
                                                <td>@item.IS_DISABLED</td>
                                                <td>@item.EMAIL_ID</td>
                                                <td>@item.YEAR_OF_PASSING</td>
                                                <td>@item.AADHAR_NO</td>
                                                <td>@item.AMOUNT</td>                                                                                         
                                            </tr>
                                                        }

                                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
                                                    }
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
  
    function ContentLoad()
    {

    }
    
    $("#excel").click(function (e) {
        alert('clicked');
        let file = new Blob([$('#loaddiv').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "ConvocationRegisteredList.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
</script>

