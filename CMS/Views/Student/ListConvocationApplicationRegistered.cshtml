@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "ListConvocationApplicationRegistered";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Convocation Application Registred</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Convocation Application Registred<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken();
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Convocation Application Registred</h4>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <div class="col-md-12">
                            <div class="form-group col-md-1"><a id="excel" class="btn btn-success">Excel</a></div>
                            @*<div class="col-md-1"><a id="print" onclick="printDiv('loaddiv')" class="form-control btn btn-success">Print</a></div>*@
                        </div>
                        @{var count = 0; }
                        <div class="form-group col-md-12" id="loaddiv">
                            <table class="table table-hover table-bordered" border="1" id="StudentReporttbl">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Student Name</th>
                                        <th>Tamil Name</th>
                                        <th>DOB</th>
                                        <th>RollNo</th>
                                        <th>RegisterNo</th>
                                        <th>Gender</th>
                                        <th>Religion</th>
                                        <th>Community</th>
                                        <th>Caste</th>
                                        <th>Father Name</th>
                                        <th>Mother Name</th>
                                        <th>Programme</th>
                                        <th>Student Mobile</th>
                                        <th>Parent Mobile</th>
                                        <th>Email</th>
                                        <th>Aadhar/Passport</th>
                                        <th>YearofJoin</th>
                                        <th>YearofPassed</th>
                                        <th>Door</th>
                                        <th>Village/Area</th>
                                        <th>Post/Town</th>
                                        <th>Taluk</th>
                                        <th>District</th>
                                        <th>PinCode</th>
                                        <th>State</th>
                                        <th>Country</th>
                                        <th>PDF</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LiConvocationApplicationRegister != null && Model.LiConvocationApplicationRegister.Count > 0)
                                    {
                                        foreach (var item in Model.LiConvocationApplicationRegister)
                                        {
                                            <tr>
                                                <td>@{count++;} @count</td>
                                                <td>@item.FIRST_NAME</td>
                                                <td>@item.TAMIL_NAME</td>
                                                <td>@item.DATE_OF_BIRTH</td>
                                                <td>@item.ROLL_NO</td>
                                                <td>@item.REGISTER_NO</td>
                                                <td>@item.GENDER_NAME</td>
                                                <td>@item.RELIGION_NAME</td>
                                                <td>@item.COMMUNITY_NAME</td>
                                                <td>@item.CASTE</td>
                                                <td>@item.FATHER_NAME</td>
                                                <td>@item.MOTHER_NAME</td>
                                                <td>@item.PROGRAMME_NAME</td>
                                                <td>@item.STUDENT_MOBILE_NO</td>
                                                <td>@item.PARENT_MOBILE</td>
                                                <td>@item.EMAIL_ID</td>
                                                <td>@item.AADHAR_NO</td>
                                                <td>@item.YEAR_OF_JOIN</td>
                                                <td>@item.YEAR_OF_PASSING</td>
                                                <td>@item.P_DOOR_DEATAIL</td>
                                                <td>@item.P_VILLAGE_AREA</td>
                                                <td>@item.P_POST_PLACE_TOWN</td>
                                                <td>@item.P_TALUK</td>
                                                <td>@item.P_DISTRICT</td>
                                                <td>@item.P_PINCODE</td>
                                                <td>@item.STATE_NAME</td>
                                                <td>@item.COUNTRY_NAME</td>
                                                <td></td>
                                            </tr>
                                                        }

                                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
                                                    }
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    $("#StudentReporttbl").DataTable({});
    function ContentLoad() {

    }
    //function printDiv(divName) {
    //    var printContents = document.getElementById(divName).innerHTML;
    //    var originalContents = document.body.innerHTML;
    //    document.body.innerHTML = printContents;
    //    window.print();
    //    document.body.innerHTML = originalContents;
    //    loadContent('/Student/ListConvocationApplicationRegistered');
    //}
    $("#excel").click(function (e) {
        alert('clicked');
        let file = new Blob([$('#loaddiv').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "ConvocationRegisteredList.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
</script>



