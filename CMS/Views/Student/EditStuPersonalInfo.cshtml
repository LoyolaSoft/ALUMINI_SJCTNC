    $('#txtTamilName').on('keydown', function (event) {

        if (event.which == 121) {
            $(this).toggleClass('tamil');
            return false;
        }
        if ($(this).hasClass('tamil')) {
            toggleKBMode(event);
        } else {
            return true;
        }
    });
    $('#txtTamilName').on('keypress', function (event) {

        if ($(this).hasClass('tamil')) {
            convertThis(event);
        }
    });


