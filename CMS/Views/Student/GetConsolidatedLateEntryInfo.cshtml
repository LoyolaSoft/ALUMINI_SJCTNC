@model List<CMS.ViewModel.Model.ConsolidatedLateEntry>

<div class="table-responsive">
    <h4 class="m-b-15" style="font-weight: 800; font-size: 1.25rem; color: #1e3a8a;"><i class="fa fa-clock-o"></i> Late Entry Logs</h4>
    
    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-bordered table-hover" id="tblConsolidatedLateEntry" width="100%" style="font-size: 1.05rem; color: #0f172a;">
            <thead>
                <tr style="background-color: #f8fafc; font-weight: 700; color: #1e293b;">
                    <th><b>#</b></th>
                    <th><b>Entry Date</b></th>
                    <th><b>Entry Time</b></th>
                    <th><b>Roll No</b></th>
                    <th><b>Student Name</b></th>
                    <th><b>Class Name</b></th>
                    <th><b>Student Mobile</b></th>
                    <th><b>Father Mobile</b></th>
                </tr>
            </thead>
            <tbody>
                @{ int count = 0; }
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.ENTRY_DATE</td>
                        <td>@item.ENTRY_TIME</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.STU_MOBILENO</td>
                        <td>@item.FR_MOBILE</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center text-muted p-5">
            <i class="fa fa-smile-o fa-3x text-success m-b-10"></i>
            <p>Good job! No late entry records found for this student.</p>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#tblConsolidatedLateEntry')) {
            $('#tblConsolidatedLateEntry').DataTable().destroy();
        }
        $('#tblConsolidatedLateEntry').DataTable({
            responsive: true,
            paging: true,
            pageLength: 10,
            ordering: true,
            dom: 'lBfrtip',
            buttons: [
                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel-o"></i> Export Dues',
                    className: 'btn btn-primary btn-sm'
                }
            ]
        });
    });
</script>
