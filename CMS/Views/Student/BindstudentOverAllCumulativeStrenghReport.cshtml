                <h4><b>Religion wise Total</b></h4>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Religion</th>
                            <th>Male</th>
                            <th>Female</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            double gRMale = 0, gRFemale = 0, gRTotal = 0;

                            var religionGroups = Model.liStudentList
                                .GroupBy(x => x.RELIGION)
                                .OrderBy(x => x.Key);

                            foreach (var rel in religionGroups)
                            {
                                var male = rel
                                    .Where(x => x.GENDER_NAME == "Male")
                                    .Sum(x => Convert.ToDouble(x.STUDENT_COUNT));

                                var female = rel
                                    .Where(x => x.GENDER_NAME == "Female")
                                    .Sum(x => Convert.ToDouble(x.STUDENT_COUNT));

                                var total = male + female;

                                gRMale += male;
                                gRFemale += female;
                                gRTotal += total;
                                <tr>
                                    <td>@(rel.Key ?? "Others")</td>
                                    <td>@male</td>
                                    <td>@female</td>
                                    <td>@total</td>
                                </tr>
                            }

                            <!-- Grand Total -->
                            <tr class="table-success">
                                <td><b>Grand Total</b></td>
                                <td><b>@gRMale</b></td>
                                <td><b>@gRFemale</b></td>
                                <td><b>@gRTotal</b></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Religion wise -->

                <h4><b>Gender wise Total</b></h4>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Class Level</th>
                            <th>Shift</th>
                            <th>Class Year</th>
                            <th>Male</th>
                            <th>Female</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            double grandMale = 0, grandFemale = 0, grandGTotal = 0;

                            var LevelGroups = Model.liStudentList
                                .GroupBy(x => x.CLASSLEVELID)
                                .OrderBy(x => x.Key);

                            foreach (var classLevel in LevelGroups)
                            {
                                <tr class="table-primary">
                                    <td colspan="6"><b>Class Level : @classLevel.First().CLASSLEVEL</b></td>
                                </tr>

                                var shiftGroups = classLevel.GroupBy(x => x.SHIFT).OrderBy(x => x.Key);

                                foreach (var shift in shiftGroups)
                                {
                                    double shiftMale = 0, shiftFemale = 0, shiftTotal = 0;

                                    var classYearGroups = shift
                                        .GroupBy(x => x.CLASS_YEAR)
                                        .OrderBy(x => x.Key);

                                    foreach (var year in classYearGroups)
                                    {
                                        var male = year
                                            .Where(x => x.GENDER_NAME == "Male")
                                            .Sum(x => Convert.ToDouble(x.STUDENT_COUNT));

                                        var female = year
                                            .Where(x => x.GENDER_NAME == "Female")
                                            .Sum(x => Convert.ToDouble(x.STUDENT_COUNT));

                                        var total = male + female;

                                        shiftMale += male;
                                        shiftFemale += female;
                                        shiftTotal += total;

                                        grandMale += male;
                                        grandFemale += female;
                                        grandGTotal += total;

                                        <tr>
                                            <td></td>
                                            <td>@(shift.Key == "1" ? "Shift I" : "Shift II")</td>
                                            <td>@year.Key</td>
                                            <td>@male</td>
                                            <td>@female</td>
                                            <td>@total</td>
                                        </tr>
                                    }

                                    <!-- Shift Total -->
                                    <tr class="table-secondary">
                                        <td></td>
                                        <td colspan="2"><b>@(shift.Key == "1" ? "Shift I Total" : "Shift II Total")</b></td>
                                        <td><b>@shiftMale</b></td>
                                        <td><b>@shiftFemale</b></td>
                                        <td><b>@shiftTotal</b></td>
                                    </tr>
                                }
                            }

                            <!-- Grand Total -->
                            <tr class="table-success">
                                <td colspan="3"><b>Grand Total</b></td>
                                <td><b>@grandMale</b></td>
                                <td><b>@grandFemale</b></td>
                                <td><b>@grandGTotal</b></td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    }
    else
    {
        <div class="bg-warning text-center">
            <h4>No Records Found</h4>
        </div>
    }
</div>
