@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "StudentCIAMarksAndAttendanceForPrincipal";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">StudentCIA Marks</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">StudentCIA Marks</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">StudentCIA Marks</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="cpl-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.DepartmentList, "Department", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.DepartmentList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.ShiftList, "Shift List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", })
                                @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ClassList, "Class List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-2">
                            <a class="btn btn-primary" id="btnGetClassStudent" title="Click to Get the MarkSheet">Get</a>
                            @*<a href="javascript:;" id="sPrint" onclick="printDiv('dvIndividualCIAMark')" class="btn btn-success m-b-10 pull-right hidden"><i class="fa fa-print m-r-5"></i>Get PDF</a>*@
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div id="dvClassStudent"></div>
                </div>
            }
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });

        $("#ShiftList").on("change", function () {
            $.ajax({
                url: "@Url.Action("BindClassByDepartmentIdAndShitId", "Student")",
                method: "POST",
                datatype: "json",
                data: { sDeparmentId: $('#DepartmentList').val(), sShiftId: $('#ShiftList').val() },
                success: function (data) {
                    $("#ClassList").empty();
                    $("#ClassList").append("<option value='0'>--Select--</option>"+data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        });

        $("#btnGetClassStudent").on("click", function () {
            var sClass = $('#ClassList').val();
            if (sClass == '' || sClass == '0' || sClass == null) {
                alert('Please Choose Class...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("BindStudentForCIAMarkAndAttendance", "Student")",
                method: "POST",
                datatype: "json",
                data: { sClassId: $('#ClassList').val() },
                success: function (data) {
                    $("#dvClassStudent").empty();
                    $("#dvClassStudent").append(data);
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        });
        function FetchStudentMark(ID) {
            $.ajax({
                url: "@Url.Action("BindStudentCIAMarks", "Student")",
                method: "POST",
                datatype: "json",
                data: { sClassId: $('#ClassList').val(), sStudentId: ID },
                success: function (data) {
                    $("#dvMarkStudent").empty();
                    $("#dvMarkStudent").append(data);
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }

        function FetchStudentAttendance(ID) {
            $.ajax({
                url: "@Url.Action("BindStudentAttendanceReport", "Student")",
                method: "POST",
                datatype: "json",
                data: { sClassId: $('#ClassList').val(), sStudentId: ID },
                success: function (data) {
                    $("#dvAttendanceStudent").empty();
                    $("#dvAttendanceStudent").append(data);
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    </script>



<div class="modal fade" id="Attendance-dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Attendance</h4>
            </div>
            <div class="form-horizontal">
                <div class="modal-body">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div id="dvAttendanceStudent"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Mark-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Mark</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <div class="col-md-12">
                        <div id="dvMarkStudent"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>



