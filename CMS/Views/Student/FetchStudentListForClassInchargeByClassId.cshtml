
@model CMS.ViewModel.ViewModel.StudentViewModel
@{ Layout = null; int count = 0; }

<div class="form-group">
    <div class="col-md-12 table-responsive">
        @if (Model.liStudent != null)
        {
            <table id="tblStudent" class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Roll No</th>
                        <th>Register No</th>
                        <th>Admission No</th>
                        <th>Student Name</th>
                        <th>Dob</th>
                        @*<th>Class</th>*@
                        <th>Mobile</th>
                        <th>View</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.liStudent)
                    {
                        <tr>
                            <td>@{count++;} @count</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.REGISTER_NO</td>
                            <td>@item.ADMISSION_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.DATE_OF_BIRTH</td>
                            @*<td>@item.CLASS_NAME</td>*@
                            <td>@item.MOBILE</td>
                            <td>
                                <a onclick="ViewStudentDetails('@item.STUDENT_ID')" title="CliCk To View"><i class="fa fa-eye text-primary"></i></a>
                            </td>
                        </tr>
                    }




                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-danger"> No students found for this class.</div>
        }

    </div>

</div>