@model List<CMS.ViewModel.Model.ConsolidatedAcademicMark>

<div class="m-b-30">
    <h4 class="m-b-15" style="font-weight: 800; font-size: 1.25rem; color: #1e3a8a;">
        <i class="fa fa-list-alt"></i> Academic Analysis - Semester Summary
    </h4>
    <div class="table-responsive">
        <table class="table table-bordered table-striped" style="font-size: 1.05rem; color: #0f172a;">
            <thead>
                <tr style="background-color: #f8fafc; font-weight: 700; color: #1e293b;">
                    <th>Semester</th>
                    <th class="text-center">Total no.of Subjects</th>
                    <th class="text-center">No.of Subjects Passed</th>
                    <th class="text-center">No.of Arrears</th>
                    <th class="text-center">Percentage</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    var groupMarks = Model.GroupBy(x => x.SEMESTER_NAME).ToList();
                    foreach (var group in groupMarks)
                    {
                        var total = group.Count();
                        var passed = group.Count(x => x.RESULT != null && (x.RESULT.Trim().ToUpper() == "P" || x.RESULT.Trim().ToUpper() == "M" || x.RESULT.Trim().ToUpper() == "PASS"));
                        var arrears = total - passed;
                        var percentage = total > 0 ? (Math.Round((double)passed / total * 100, 2)) : 0;

                        <tr>
                            <td><b>@group.Key</b></td>
                            <td class="text-center">@total</td>
                            <td class="text-center">@passed</td>
                            <td class="text-center">@arrears</td>
                            <td class="text-center"><b>@percentage %</b></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No summary available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<hr style="border-top: 1px solid #e2e8f0; margin-top: 25px; margin-bottom: 25px;" />

<div class="table-responsive">
    <h4 class="m-b-15" style="font-weight: 800; font-size: 1.25rem; color: #1e3a8a;"><i class="fa fa-graduation-cap"></i> Semester Wise Academic Performance</h4>
    
    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-striped table-bordered table-hover" id="tblConsolidatedAcademic" width="100%" style="font-size: 1.05rem; color: #0f172a;">
            <thead>
                <tr style="background-color: #f8fafc; font-weight: 700; color: #1e293b;">
                    <th><b>Semester</b></th>
                    <th><b>Course Code</b></th>
                    <th><b>Course Title</b></th>
                    <th><b>Internal Mark</b></th>
                    <th><b>External Mark</b></th>
                    <th><b>Total</b></th>
                    <th><b>Grade</b></th>
                    <th><b>Result</b></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><b>@item.SEMESTER_NAME</b></td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.COURSE_TITLE</td>
                        <td>@item.INTERNAL_MARK</td>
                        <td>@item.EXTERNAL_MARK</td>
                        <td><b>@item.TOTAL</b></td>
                        <td>@item.GRADE</td>
                        <td>
                            @if (item.RESULT != null && (item.RESULT.Trim().ToUpper() == "P" || item.RESULT.Trim().ToUpper() == "M" || item.RESULT.Trim().ToUpper() == "PASS"))
                            {
                                <span class="label label-success" style="font-size: 0.85rem; padding: 4px 8px; border-radius: 4px;">PASS</span>
                            }
                            else if (item.RESULT != null && (item.RESULT.Trim().ToUpper() == "FAIL" || item.RESULT.Trim().ToUpper() == "RA" || item.RESULT.Trim().ToUpper() == "F"))
                            {
                                <span class="label label-danger" style="font-size: 0.85rem; padding: 4px 8px; border-radius: 4px;">@item.RESULT</span>
                            }
                            else
                            {
                                <span class="label label-warning" style="font-size: 0.85rem; padding: 4px 8px; border-radius: 4px;">@item.RESULT</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center text-muted p-5">
            <i class="fa fa-info-circle fa-2x m-b-10"></i>
            <p>No academic marks or results recorded for this student in the selected academic year.</p>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#tblConsolidatedAcademic')) {
            $('#tblConsolidatedAcademic').DataTable().destroy();
        }
        $('#tblConsolidatedAcademic').DataTable({
            responsive: true,
            paging: true,
            pageLength: 10,
            ordering: true,
            order: [[0, "asc"]],
            dom: 'lBfrtip',
            buttons: [
                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel-o"></i> Export to Excel',
                    className: 'btn btn-primary btn-sm'
                },
                {
                    extend: 'pdf',
                    text: '<i class="fa fa-file-pdf-o"></i> Export to PDF',
                    className: 'btn btn-danger btn-sm'
                }
            ]
        });
    });
</script>
