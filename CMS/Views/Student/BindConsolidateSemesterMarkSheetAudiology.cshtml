@model CMS.ViewModel.ViewModel.StudentViewModel
@using CMS.Utility
@{
    double Gradem = 0;
    double Percentage = 0;
    double max = 0;
    double sec = 0;
    int licount = 0;
}
@if (Model.liSemestermark != null && Model.liSemestermark.Count > 0)
{
    var StudentList = Model.liSemestermark.GroupBy(s => s.STUDENT_ID).ToList();
    //var StudentListForOverAll = Model.liOverAllSemestermark.GroupBy(s => s.STUDENT_ID).ToList();
    if (StudentList.Count > 0 && StudentList != null)
    {
        foreach (var item in StudentList)
        {
            var Individual = Model.liSemestermark.Where(s => s.STUDENT_ID == item.FirstOrDefault().STUDENT_ID).ToList();
            var datelist = Individual;
            var Date = datelist.OrderByDescending(x => DateTime.Parse(x.START_DATE)).ToList();
            if (Individual != null && Individual.Count() > 0)
            {
                <div style="page-break-after:always !important;page-break-inside:avoid !important;">
                    <div style="height: 1330px;  width: 816px;">
                        <br /><br /><br /><br /><br /><br /><br /><br /><br /><br /><br /> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;
                        <div class="col-md-12">
                            <table align="center" style="width:100%;">
                                <tr>
                                    <td style="width:50%"><b>Name</b> : &nbsp;@Individual.FirstOrDefault().NAME.ToUpper()</td>
                                    <td style="width:50%" align="right"><b>Register No</b> : &nbsp;@Individual.FirstOrDefault().REGISTER_NO</td>
                                </tr>
                                <tr>
                                    <td style="width:60%"><b>Degree & Major</b> : &nbsp;@Individual.FirstOrDefault().PROGRAMME_NAME </td>
                                    <td style="width:40%" align="right"><b>Roll No</b> : &nbsp;@Individual.FirstOrDefault().ROLL_NO</td>
                                </tr>
                                <tr>
                                    <td style="width:50%"></td>
                                    <td style="width:50%" align="right"><b>Month & Year</b> : &nbsp;@Date.FirstOrDefault().M_EXAM</td>

                                </tr>
                            </table>
                        </div>
                        &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;
                        @if (Individual.FirstOrDefault().APPLICATION_TYPE_ID == "3")
                        {
                            <table align="center" style="width:100%; border:1px solid;">
                                <thead>
                                    <tr>
                                        <th style="border:1px solid;width:5% !important;padding-left:5px;" align="left">Sem</th>
                                        <th style="border:1px solid;width:15% !important;padding-left:5px;" align="left">Course Code</th>
                                        <th style="border:1px solid;width:52% !important;padding-left:5px;" align="left">Course Title</th>
                                        <th style="width:6% !important;border:1px solid ;padding-left:5px;" align="left">Max.</th>
                                        <th style="width:6% !important;border:1px solid ;padding-left:5px;" align="left">Sec.</th>
                                        <th style="width:6% !important;border:1px solid ;padding-left:5px;" align="left">Grade</th>
                                        <th style="width:10% !important;border:1px solid ;padding-left:5px;" align="left">Passed Month</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var items in Individual)
                                    {
                                        licount++;
                                        if (items.COURSE_CODE != "U16AS8INT01")
                                        {
                                            <tr>
                                                <td style="width:5% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.SEMESTER_NAME</td>
                                                <td style="width:15% !important;padding-left:5px;  border-right:1px solid ;" align="left">@items.COURSE_CODE</td>
                                                <td style="width:52% !important;padding-left:5px;  border-right:1px solid ;" align="left">@items.COURSE_TITLE</td>
                                                <td style="width:6% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.MAXIMUM</td>
                                                <td style="width:6% !important; padding-left:5px;  border-right:1px solid ;" align="left">@items.TOTAL</td>
                                                <td style="width:6% !important; padding-left:5px;  border-right:1px solid ;align-content:flex-start;">@items.GRADE</td>
                                                <td style="width:10% !important; padding-left:5px;  border-right:1px solid ;align-content:flex-start;">@items.M_PASS</td>
                                            </tr>
                                        }

                                        if (licount == Individual.Count())
                                        {
                                            licount = 0;
                                            var liinternship = Individual.Where(o => o.COURSE_CODE == "U16AS8INT01").ToList();
                                            if (liinternship != null && liinternship.Count > 0)
                                            {
                                                foreach (var internmark in liinternship)
                                                {
                                                    <tr>
                                                        <td style="width:5% !important; padding-left:5px;  border-right:1px solid ;" align="left"></td>
                                                        <td style="width:15% !important;padding-left:5px;  border-right:1px solid ;" align="left"></td>
                                                        <td style="width:52% !important;padding-left:5px;  border-right:1px solid ;" align="left">INTERNSHIP</td>
                                                        <td style="width:6% !important; padding-left:5px;  border-right:1px solid ;" align="left"></td>
                                                        <td style="width:6% !important; padding-left:5px;  border-right:1px solid ;" align="left"></td>
                                                        <td style="width:6% !important; padding-left:5px;  border-right:1px solid ;align-content:flex-start;">@internmark.GRADE</td>
                                                        <td style="width:10% !important; padding-left:5px; border-right:1px solid ;align-content:flex-start;">@internmark.M_PASS</td>
                                                    </tr>
                                                }
                                            }

                                        }
                                    }
                                </tbody>
                            </table>
                            <table align="center" style="width:100%; border:1px solid; text-align:center">
                                <thead>
                                    <tr>
                                        <th style="border:1px solid; text-align:center">Total Marks</th>
                                        <th style="border:1px solid;text-align:center">Marks Secured</th>
                                        <th style="border:1px solid;text-align:center">Percentage</th>
                                        <th style="border:1px solid;text-align:center">Grade</th>
                                    </tr>
                                    <tr>
                                        @if (Individual.Count() > 0)
                                        {
                                            max = 0;
                                            sec = 0;
                                            foreach (var sitem in Individual)
                                            {
                                                if (sitem.RESULT.ToUpper().Contains("A") || sitem.RESULT.ToUpper().Contains("F") || sitem.UGC_COURSE_TYPE == "48" || sitem.UGC_COURSE_TYPE == "76" || sitem.UGC_COURSE_TYPE == "95" || sitem.UGC_COURSE_TYPE == "103" || sitem.COURSE_CODE == "U16AS8INT01")
                                                {

                                                }
                                                else
                                                {
                                                    max += Convert.ToDouble(sitem.MAXIMUM);
                                                    sec += Convert.ToDouble(sitem.TOTAL);
                                                }
                                            }
                                            Percentage = Math.Round(sec / max * 100, 2);
                                            Gradem = Math.Round(Percentage / 100 * 10, 2);
                                        }
                                        <td style="border:1px solid;">@max</td>
                                        <td style="border:1px solid;">@sec</td>
                                        <td style="border:1px solid;">@Percentage.ToString("0.00")</td>
                                        @if (Gradem >= 9.00)
                                        {
                                            <td style="border:1px solid;">O</td>
                                        }
                                        else
                                        {
                                            if (Gradem >= 8.00)
                                            {
                                                <td style="border:1px solid;">A+</td>
                                            }
                                            else
                                            {
                                                if (Gradem >= 7.00)
                                                {
                                                    <td style="border:1px solid;">A</td>
                                                }
                                                else
                                                {
                                                    if (Gradem >= 6.00)
                                                    {
                                                        <td style="border:1px solid;">B+</td>
                                                    }
                                                    else
                                                    {
                                                        if (Gradem >= 5.00)
                                                        {
                                                            <td style="border:1px solid;">B</td>
                                                        }
                                                        else
                                                        {
                                                            if (Gradem < 5.00)
                                                            {
                                                                <td style="border:1px solid;">R.A</td>
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    </tr>
                                </thead>
                            </table>
                        }
                    </div>
                    <div class="form-group pull-right">
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img src="~/Content/hcc_img/sign/Principal-E-Sign_1.png" width="150px;" class="pull-right" />
                    </div>
                </div>

            }
        }
    }
}
