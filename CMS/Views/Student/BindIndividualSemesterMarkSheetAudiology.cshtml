@model CMS.ViewModel.ViewModel.StudentViewModel
@using CMS.Utility
@{
    string MaksWord = string.Empty;
    string sResult = string.Empty;
}
@if (Model.liSemestermark != null && Model.liSemestermark.Count > 0)
{
    //List<CMS.ViewModel.Model.SEMESTER_MARKS>liSemesterMark = new List<CMS.ViewModel.Model.SEMESTER_MARKS>();
    var StudentList = Model.liSemestermark.GroupBy(s => s.STUDENT_ID).ToList();   
    if (StudentList.Count > 0 && StudentList != null)
    {
        foreach (var item in StudentList)
        {
            var Ind = Model.liSemestermark.Where(s => s.STUDENT_ID == item.FirstOrDefault().STUDENT_ID).ToList();                        
            var Individual = Ind.OrderByDescending(x => x.SEMESTER).ToList();
            if (Individual != null && Individual.Count > 0)
            {
                <div style="page-break-after:always !important;page-break-inside:avoid !important;">
                    <div style="height: 1100px;  width: 793px;">
                        <br /><br /><br /><br /><br /><br /><br /><br /><br /><br /> <br />
                        <div class="col-md-12">
                            <table align="center" width="95%">
                                <tr>
                                    <td style="width:50%"><b>Name</b> : &nbsp;@Individual.FirstOrDefault().NAME.ToUpper()</td>
                                    <td style="width:50%" align="right"><b>Register No</b> : &nbsp;@Individual.FirstOrDefault().REGISTER_NO</td>
                                </tr>
                                <tr>
                                    <td style="width:50%"><b>Semester </b> : &nbsp;@Individual.FirstOrDefault().SEMESTER_NAME</td>
                                    <td style="width:50%" align="right"><b>Roll No</b> : &nbsp;@Individual.FirstOrDefault().ROLL_NO</td>
                                </tr>
                                <tr>
                                    <td style="width:60%"><b>Degree & Major</b> : &nbsp;@Individual.FirstOrDefault().PROGRAMME_NAME </td>
                                    <td style="width:40%" align="right"><b>Month & Year</b> : &nbsp;@Individual.FirstOrDefault().M_EXAM</td>
                                </tr>
                            </table>
                        </div>
                        <br />
                        @if (Individual.FirstOrDefault().APPLICATION_TYPE_ID == "3")
                        {
                            <div class="col-md-12">
                                <table align="center" style="width:95%; border:1px solid;">
                                    <thead>
                                        <tr>
                                            <th style="border:1px solid;width:5% !important;padding-left:5px;"></th>
                                            <th style="border:1px solid;width:15% !important;padding-left:5px;"></th>
                                            <th style="border:1px solid;width:35% !important;padding-left:5px;"></th>
                                            <th style="width:10% !important;border:1px solid ;padding-left:5px;" colspan="2">CIA</th>
                                            <th style="width:10% !important;border:1px solid ;padding-left:5px;" colspan="2">ESE</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;"></th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;"></th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;"></th>
                                        </tr>
                                        <tr>
                                            <th style="border:1px solid;width:5% !important;padding-left:5px; " align="left">Sem</th>
                                            <th style="border:1px solid;width:15% !important;padding-left:5px;" align="left">Course Code</th>
                                            <th style="border:1px solid;width:35% !important;padding-left:5px;" align="left">Course Title</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Max Mark</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Marks Sec.</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Max Mark</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Marks Sec.</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Aggre gate</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Grade</th>
                                            <th style="width:5% !important;border:1px solid ;padding-left:5px;" align="left">Result</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            foreach (var items in Individual)
                                            {
                                                <tr>
                                                    <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">@items.SEMESTER_NAME</td>
                                                    <td style="width:15% !important;padding:5px 5px;  border-right:1px solid;" align="left">@items.COURSE_CODE</td>
                                                    <td style="width:35% !important;padding:5px 5px;  border-right:1px solid;" align="left">@items.COURSE_TITLE</td>                                                    
                                                    @if (items.INTERNAL != "0")
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">@items.INTERNAL</td>
                                                    }
                                                    else
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">-</td>
                                                    }
                                                    @if (items.INTERNAL_MARK != "0" && items.INTERNAL_MARK != "")
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">@items.INTERNAL_MARK</td>
                                                    }
                                                    else
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">-</td>
                                                    }
                                                    @if (items.EXTERNAL != "0" && items.EXTERNAL != "")
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">@items.EXTERNAL</td>
                                                    }
                                                    else
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">-</td>
                                                    }
                                                    @if (items.EXTERNAL_MARK != "0" && items.EXTERNAL_MARK != "")
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid ;" align="left">@items.EXTERNAL_MARK</td>
                                                    }
                                                    else
                                                    {
                                                        <td style="width:5% !important; padding:5px 5px;  border-right:1px solid;" align="left">-</td>
                                                    }                                                                                                    
                                                    <td style="width:5% !important; padding:5px 5px;  border-right:1px solid ;" align="left">@items.TOTAL</td>
                                                    <td style="width:5% !important; padding:5px 5px;  border-right:1px solid ;align-content:flex-start;">@items.GRADE</td>
                                                    <td style="width:5% !important; padding:5px 5px;  border-right:1px solid ;align-content:flex-start;">@items.RESULT</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <thead>
                                        <tr style="border:1px solid; padding:5px;">
                                            <th colspan="7" style="border:1px solid; padding:5px 5px;"><b>Total</b></th>
                                            <th style="border:1px solid; padding:5px 5px;">
                                                @{
                                                    var totalMarks = Individual.Where(o => o.TOTAL != "A").Sum(o => Convert.ToDouble(o.TOTAL));
                                                    int Marks = Convert.ToInt16(totalMarks);
                                                    MaksWord = CMS.Utility.CommonMethods.IndividualNumberToWords(Marks);
                                                    if (totalMarks != 0)
                                                    { @totalMarks}
                                                    else
                                                    {@Common.Delimiter.IPHEN}
                                                }
                                            </th>
                                            <th style="border:1px solid; padding:5px 5px;"></th>
                                            <th style="border:1px solid; padding:5px 5px;"></th>

                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <br />
                                                        <div class="col-md-12">
                                                            <table align="center" width="95%">
                                                                <tr>
                                                                    <td align="left"><b>GRAND TOTAL (IN WORDS)</b> : &nbsp;@MaksWord</td>                                                                    
                                                                </tr>
                                                                
                                                               
                                                                <tr>
                                                                    <td align="left"><b>RESULT</b> : &nbsp;
                                                                    @{
                                                                        var Result = Individual.Where(o => o.RESULT == "F" || o.RESULT == "A").ToList();
                                                                        if (Result.Count>0)
                                                                        {
                                                                            sResult = "FAIL";
                                                                        }
                                                                        else
                                                                        {
                                                                            sResult = "PASS";
                                                                        }
                                                                    }@sResult</td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                                    }

                    </div>
                    <div class="form-group pull-right">
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img src="~/Content/hcc_img/sign/Principal-E-Sign_1.png" width="150px;" class="pull-right" style="margin-right:-15px;" />
                    </div>
                </div>
                                                                }
                                                            }
                                                        }
                                                    }
