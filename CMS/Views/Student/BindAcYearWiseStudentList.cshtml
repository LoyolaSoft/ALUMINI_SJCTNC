@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    Layout = null;
    int ncount = 0;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/css/lightbox.min.css" rel="stylesheet" />

<div class="form-group table-responsive">

    <table class="table table-hover table-bordered" id="tblStudentList">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Photo</th>
                <th>Roll No</th>
                <th>Student Name</th>
                <th>Adm No</th>
                <th>Class</th>
                <th>Shift</th>
                <th>Is Left</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStudentList != null)
            {
                foreach (var item in Model.liStudentList)
                {
                    <tr id="@item.STUDENT_ID">
                        <td>
                            @{ncount++;} @ncount
                        </td>
                        <td>
                            <img src="@item.PHOTO" itemprop="thumbnail" class="img-thumb" alt="@item.ROLL_NO Icon" onerror="this.onerror=null;this.src='@Url.Content("/Content/assets/img/transparent/e-user.jpg")'">
                        </td>
                        <td>

                            @Html.DisplayFor(modelItem => item.ROLL_NO)
                        </td>
                        @*<td>

                                @Html.DisplayFor(modelItem => item.REGISTER_NO)
                            </td>*@
                        <td>
                            @Html.DisplayFor(modelItem => item.FIRST_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ADMISSION_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CLASS_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SHIFT_NAME)
                        </td>
                        @if (item.IS_LEFT == "YES")
                        {
                            <td class="text-danger">
                                <b>
                                    @Html.DisplayFor(modelItem => item.IS_LEFT)
                                </b>
                            </td>
                        }
                        else
                        {
                            <td>

                                @Html.DisplayFor(modelItem => item.IS_LEFT)
                            </td>
                        }
                    <td>
                        @*<a href="#" onclick="loadContent('/Student/EditStudentPersonalInfomation/@item.STUDENT_ID')" title="Click To Edit"><i class="fa fa-edit text-primary"></i></a>*@
                        <a href="#"
                           onclick="loadContent('/Student/EditStudentPersonalInfomation?ID=@item.STUDENT_ID&sAcyear=' + encodeURIComponent($('#AcademicYear option:selected').text()))"
                           title="Click To Edit">
                            <i class="fa fa-edit text-primary"></i>
                        </a>
                        <a onclick="GetConfirm('@item.STUDENT_ID', '@item.ROLL_NO')" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                    </td>
                    </tr>
                }
            }


        </tbody>
    </table>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/js/lightbox.min.js"></script>