@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
    var college = (Model.liCollgeDetails != null && Model.liCollgeDetails.Count > 0) ? Model.liCollgeDetails.FirstOrDefault() : null;
    string collegeCode = college != null ? college.COLLEGE_CODE : "SJC";
    string collegeName = college != null ? college.COLLEGE_NAME : "St. Joseph's College of Arts & Science (Autonomous), Cuddalore";
}

<style>
    .table-consolidate {
        width: 100% !important;
        border-collapse: collapse !important;
        font-size: 11px !important;
        font-family: Arial, sans-serif !important;
    }
    .table-consolidate th, .table-consolidate td {
        border: 1px solid #7f7f7f !important;
        padding: 3px 4px !important;
        text-align: center !important;
        vertical-align: middle !important;
    }
    .th-header-main {
        background-color: #c6e0b4 !important;
        color: #000 !important;
        font-weight: bold !important;
    }
    .th-diff-abled {
        background-color: #fce4d6 !important;
        color: #000 !important;
        font-weight: bold !important;
    }
    .th-candidate-adm {
        background-color: #fff2cc !important;
        color: #000 !important;
        font-weight: bold !important;
    }
    .th-male-cat {
        background-color: #ffff99 !important;
        color: #000 !important;
        font-weight: bold !important;
    }
    .td-male-cat {
        background-color: #ffffcc !important;
    }
    .th-female-cat {
        background-color: #bdd7ee !important;
        color: #000 !important;
        font-weight: bold !important;
    }
    .td-female-cat {
        background-color: #ddebf7 !important;
    }
    .th-trans-cat {
        background-color: #f8cbad !important;
        color: #000 !important;
        font-weight: bold !important;
    }
    .td-trans-cat {
        background-color: #fce4d6 !important;
    }
    .tr-level-header {
        background-color: #d9edf7 !important;
        font-weight: bold !important;
        text-align: left !important;
        font-size: 12px !important;
    }
    .tr-grand-total {
        background-color: #c6e0b4 !important;
        font-weight: bold !important;
        font-size: 11px !important;
    }
    .text-left-align {
        text-align: left !important;
    }
    @@media print {
        body * {
            visibility: hidden;
        }
        #divbind, #divbind * {
            visibility: visible;
        }
        #divbind {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        @@page {
            size: A3 landscape;
            margin: 5mm;
        }
        .table-consolidate {
            font-size: 9px !important;
        }
        .table-consolidate th, .table-consolidate td {
            padding: 2px 2px !important;
        }
    }
</style>

@if (Model.liConsolidateAdmission != null && Model.liConsolidateAdmission.Count > 0)
{
    <div class="table-responsive" style="margin-top: 15px;">
        <!-- Title Section -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px;">
            <tr>
                <td colspan="38" style="text-align: center; color: red; font-size: 16px; font-weight: bold; border: none; padding: 3px;">
                    Annamalai University - Affiliated Colleges
                </td>
            </tr>
            <tr>
                <td colspan="38" style="text-align: center; color: blue; font-size: 14px; font-weight: bold; border: none; padding: 3px;">
                    Consolidate Admission details for @(ViewBag.ClassYearText ?? "I Year") UG &amp; PG ( Admitted during @(ViewBag.AcademicYearShort ?? ViewBag.AcademicYear))
                </td>
            </tr>
        </table>

        <!-- Metadata Section -->
        <table style="width: 40%; border-collapse: collapse; margin-bottom: 10px; font-size: 12px;">
            <tr>
                <td style="border: 1px solid #999; font-weight: bold; width: 35%; padding: 4px; background-color: #f2f2f2;">College Code</td>
                <td style="border: 1px solid #999; padding: 4px; font-weight: bold;">@collegeCode</td>
            </tr>
            <tr>
                <td style="border: 1px solid #999; font-weight: bold; padding: 4px; background-color: #f2f2f2;">College Name</td>
                <td style="border: 1px solid #999; padding: 4px; font-weight: bold;">@collegeName</td>
            </tr>
        </table>

        <!-- Main Consolidate Admission Table -->
        <table class="table table-bordered table-consolidate" id="tblConsolidateAdmission">
            <thead>
                <!-- Row 1 -->
                <tr>
                    <th rowspan="3" class="th-header-main" style="width: 30px;">Sl. No.</th>
                    <th rowspan="3" class="th-header-main" style="width: 60px;">Programme Code</th>
                    <th rowspan="3" class="th-header-main" style="min-width: 180px;">Programme Name</th>
                    <th rowspan="3" class="th-header-main" style="width: 50px;">Medium TM/EM</th>
                    <th rowspan="3" class="th-header-main" style="width: 65px;">Sanctioned Intake</th>
                    <th rowspan="3" class="th-header-main" style="width: 70px;">No.of Additional Intake Permitted</th>
                    <th colspan="6" class="th-header-main">No.of Candidates admitted inculding Foreign Students</th>
                    <th rowspan="3" class="th-header-main" style="width: 65px;">Total No.of Students admitted</th>
                    <th rowspan="3" class="th-header-main" style="width: 60px;">No.of Seats vacant if any</th>
                    <th colspan="8" class="th-header-main">No.of Male Students admitted under the category</th>
                    <th colspan="8" class="th-header-main">No.of Female Students admitted under the category</th>
                    <th colspan="8" class="th-header-main">No.of Transgender Students admitted under the category</th>
                </tr>

                <!-- Row 2 -->
                <tr>
                    <th rowspan="2" class="th-candidate-adm" style="width: 40px;">Male</th>
                    <th rowspan="2" class="th-candidate-adm" style="width: 40px;">Female</th>
                    <th rowspan="2" class="th-candidate-adm" style="width: 45px;">Trans gender</th>
                    <th colspan="3" class="th-diff-abled">Differently abled</th>
                    <th colspan="8" class="th-male-cat">Male</th>
                    <th colspan="8" class="th-female-cat">Female</th>
                    <th colspan="8" class="th-trans-cat">Transgender</th>
                </tr>

                <!-- Row 3 -->
                <tr>
                    <th class="th-diff-abled" style="width: 35px;">Male</th>
                    <th class="th-diff-abled" style="width: 35px;">Female</th>
                    <th class="th-diff-abled" style="width: 40px;">Trans gender</th>
                    <!-- Male Categories -->
                    <th class="th-male-cat" style="width: 30px;">OC</th>
                    <th class="th-male-cat" style="width: 30px;">BC</th>
                    <th class="th-male-cat" style="width: 30px;">BCM</th>
                    <th class="th-male-cat" style="width: 30px;">DNC</th>
                    <th class="th-male-cat" style="width: 30px;">MBC</th>
                    <th class="th-male-cat" style="width: 30px;">SC</th>
                    <th class="th-male-cat" style="width: 30px;">ST</th>
                    <th class="th-male-cat" style="width: 30px;">SCA</th>
                    <!-- Female Categories -->
                    <th class="th-female-cat" style="width: 30px;">OC</th>
                    <th class="th-female-cat" style="width: 30px;">BC</th>
                    <th class="th-female-cat" style="width: 30px;">BCM</th>
                    <th class="th-female-cat" style="width: 30px;">DNC</th>
                    <th class="th-female-cat" style="width: 30px;">MBC</th>
                    <th class="th-female-cat" style="width: 30px;">SC</th>
                    <th class="th-female-cat" style="width: 30px;">ST</th>
                    <th class="th-female-cat" style="width: 30px;">SCA</th>
                    <!-- Transgender Categories -->
                    <th class="th-trans-cat" style="width: 30px;">OC</th>
                    <th class="th-trans-cat" style="width: 30px;">BC</th>
                    <th class="th-trans-cat" style="width: 30px;">BCM</th>
                    <th class="th-trans-cat" style="width: 30px;">DNC</th>
                    <th class="th-trans-cat" style="width: 30px;">MBC</th>
                    <th class="th-trans-cat" style="width: 30px;">SC</th>
                    <th class="th-trans-cat" style="width: 30px;">ST</th>
                    <th class="th-trans-cat" style="width: 30px;">SCA</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int gSanctioned = 0, gAddl = 0, gMale = 0, gFemale = 0, gTrans = 0;
                    int gDiffM = 0, gDiffF = 0, gDiffT = 0, gTotalAdm = 0, gVacant = 0;
                    int gM_OC = 0, gM_BC = 0, gM_BCM = 0, gM_DNC = 0, gM_MBC = 0, gM_SC = 0, gM_ST = 0, gM_SCA = 0;
                    int gF_OC = 0, gF_BC = 0, gF_BCM = 0, gF_DNC = 0, gF_MBC = 0, gF_SC = 0, gF_ST = 0, gF_SCA = 0;
                    int gT_OC = 0, gT_BC = 0, gT_BCM = 0, gT_DNC = 0, gT_MBC = 0, gT_SC = 0, gT_ST = 0, gT_SCA = 0;

                    var levelGroups = Model.liConsolidateAdmission
                        .GroupBy(x => x.CLASSLEVEL)
                        .OrderBy(g => g.First().CLASSLEVELID)
                        .ToList();

                    int globalSno = 0;
                }

                @foreach (var lvlGroup in levelGroups)
                {
                    <tr class="tr-level-header">
                        <td colspan="38"><b>PROGRAMME LEVEL: @lvlGroup.Key</b></td>
                    </tr>

                    foreach (var item in lvlGroup)
                    {
                        globalSno++;
                        gSanctioned += item.SANCTIONED_INTAKE;
                        gAddl += item.ADDITIONAL_INTAKE;
                        gMale += item.MALE_COUNT;
                        gFemale += item.FEMALE_COUNT;
                        gTrans += item.TRANS_COUNT;
                        gDiffM += item.DIFF_MALE;
                        gDiffF += item.DIFF_FEMALE;
                        gDiffT += item.DIFF_TRANS;
                        gTotalAdm += item.TOTAL_ADMITTED;
                        gVacant += item.SEATS_VACANT;

                        gM_OC += item.M_OC; gM_BC += item.M_BC; gM_BCM += item.M_BCM; gM_DNC += item.M_DNC;
                        gM_MBC += item.M_MBC; gM_SC += item.M_SC; gM_ST += item.M_ST; gM_SCA += item.M_SCA;

                        gF_OC += item.F_OC; gF_BC += item.F_BC; gF_BCM += item.F_BCM; gF_DNC += item.F_DNC;
                        gF_MBC += item.F_MBC; gF_SC += item.F_SC; gF_ST += item.F_ST; gF_SCA += item.F_SCA;

                        gT_OC += item.T_OC; gT_BC += item.T_BC; gT_BCM += item.T_BCM; gT_DNC += item.T_DNC;
                        gT_MBC += item.T_MBC; gT_SC += item.T_SC; gT_ST += item.T_ST; gT_SCA += item.T_SCA;

                        <tr>
                            <td>@globalSno</td>
                            <td>@item.PROGRAMME_CODE</td>
                            <td class="text-left-align">@item.PROGRAMME_NAME (@item.SHIFT_NAME)</td>
                            <td>@item.MEDIUM</td>
                            <td>@item.SANCTIONED_INTAKE</td>
                            <td>@item.ADDITIONAL_INTAKE</td>
                            <td>@item.MALE_COUNT</td>
                            <td>@item.FEMALE_COUNT</td>
                            <td>@item.TRANS_COUNT</td>
                            <td>@item.DIFF_MALE</td>
                            <td>@item.DIFF_FEMALE</td>
                            <td>@item.DIFF_TRANS</td>
                            <td style="font-weight: bold;">@item.TOTAL_ADMITTED</td>
                            <td style="font-weight: bold;">@item.SEATS_VACANT</td>

                            <!-- Male Categories -->
                            <td class="td-male-cat">@item.M_OC</td>
                            <td class="td-male-cat">@item.M_BC</td>
                            <td class="td-male-cat">@item.M_BCM</td>
                            <td class="td-male-cat">@item.M_DNC</td>
                            <td class="td-male-cat">@item.M_MBC</td>
                            <td class="td-male-cat">@item.M_SC</td>
                            <td class="td-male-cat">@item.M_ST</td>
                            <td class="td-male-cat">@item.M_SCA</td>

                            <!-- Female Categories -->
                            <td class="td-female-cat">@item.F_OC</td>
                            <td class="td-female-cat">@item.F_BC</td>
                            <td class="td-female-cat">@item.F_BCM</td>
                            <td class="td-female-cat">@item.F_DNC</td>
                            <td class="td-female-cat">@item.F_MBC</td>
                            <td class="td-female-cat">@item.F_SC</td>
                            <td class="td-female-cat">@item.F_ST</td>
                            <td class="td-female-cat">@item.F_SCA</td>

                            <!-- Transgender Categories -->
                            <td class="td-trans-cat">@item.T_OC</td>
                            <td class="td-trans-cat">@item.T_BC</td>
                            <td class="td-trans-cat">@item.T_BCM</td>
                            <td class="td-trans-cat">@item.T_DNC</td>
                            <td class="td-trans-cat">@item.T_MBC</td>
                            <td class="td-trans-cat">@item.T_SC</td>
                            <td class="td-trans-cat">@item.T_ST</td>
                            <td class="td-trans-cat">@item.T_SCA</td>
                        </tr>
                    }
                }

                <!-- Grand Total Row -->
                <tr class="tr-grand-total">
                    <td colspan="4" style="text-align: right; font-weight: bold;">TOTAL:</td>
                    <td>@gSanctioned</td>
                    <td>@gAddl</td>
                    <td>@gMale</td>
                    <td>@gFemale</td>
                    <td>@gTrans</td>
                    <td>@gDiffM</td>
                    <td>@gDiffF</td>
                    <td>@gDiffT</td>
                    <td>@gTotalAdm</td>
                    <td>@gVacant</td>

                    <!-- Male Category Totals -->
                    <td>@gM_OC</td>
                    <td>@gM_BC</td>
                    <td>@gM_BCM</td>
                    <td>@gM_DNC</td>
                    <td>@gM_MBC</td>
                    <td>@gM_SC</td>
                    <td>@gM_ST</td>
                    <td>@gM_SCA</td>

                    <!-- Female Category Totals -->
                    <td>@gF_OC</td>
                    <td>@gF_BC</td>
                    <td>@gF_BCM</td>
                    <td>@gF_DNC</td>
                    <td>@gF_MBC</td>
                    <td>@gF_SC</td>
                    <td>@gF_ST</td>
                    <td>@gF_SCA</td>

                    <!-- Transgender Category Totals -->
                    <td>@gT_OC</td>
                    <td>@gT_BC</td>
                    <td>@gT_BCM</td>
                    <td>@gT_DNC</td>
                    <td>@gT_MBC</td>
                    <td>@gT_SC</td>
                    <td>@gT_ST</td>
                    <td>@gT_SCA</td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center" style="margin-top: 20px;">
        <h4>No Records Found for the Selected Criteria</h4>
    </div>
}
