@model CMS.ViewModel.Model.TransferCertificate

@{
    ViewBag.Title = "StudentDetailReport";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li><a href="#">Student</a></li>
        <li class="active">Student Detail Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Detail Report</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Detail Report</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Academic Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Shift</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Programme Level</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.programmeLevel, (Model.programmeLevel != null) ? Model.programmeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.programmeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Programme</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Class Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", data_actions_box = "true", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ClassYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Class Name</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 text-center">
                            <button class="btn btn-primary px-4" type="button" onclick="LoadStudentDetailReport()">
                                <i class="fa fa-search m-r-5"></i> Get
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row pull-right">
                    <div class="col-md-6 btnPrintDiv">
                        <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                    </div>
                    <div class="col-md-6 btnExcelDiv">
                        <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                    </div>
                </div>
                <br />
                <hr />
                <div class="form-group col-md-12">
                    <div id="divbind"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- end panel -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<!-- ================== Student Detail Report SCRIPT ================== -->
<script>
    $('.selectpicker').selectpicker({
        size: 4
    });

    ContentLoad = function () {
        var sOption = '<option value="">-- Select --</option>';
        $("#ClassName").empty();
        $("#ClassName").append(sOption);
        $("#ProgramName").empty();
        $("#ProgramName").append(sOption);
        $('.selectpicker').selectpicker('refresh');
        $(".btnPrintDiv").hide();
        $(".btnExcelDiv").hide();
    }

    // Shift + Programme Level -> Programme
    $("#ShiftList").on("change", function () {
        fetchProgramme();
    });
    $("#programmeLevel").on("change", function () {
        fetchProgramme();
    });
    function fetchProgramme() {
        var sShift = $("#ShiftList").val();
        var pLevel = $("#programmeLevel").val();
        if ($("#ShiftList").val() && $("#programmeLevel").val()) {
            $.ajax({
                url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift, programmeLevel: pLevel },
                success: function (data) {
                    $("#ProgramName").empty();
                    $("#ProgramName").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    // Programme + Class Year (+ Shift) -> Class Name
    $("#ProgramName").on("change", function () {
        FetchClass();
    });
    $("#ClassYear").on("change", function () {
        FetchClass();
    });
    function FetchClass() {
        var ProgramName = String($("#ProgramName").val());
        var classyear = String($("#ClassYear").val());
        var sShift = $("#ShiftList").val();
        if ($("#ClassYear").val() && $("#ShiftList").val() && $("#ProgramName").val()) {
            $.ajax({
                url: "@Url.Action("BindDDLClassListbyClassYear", "Student")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                success: function (data) {
                    $("#ClassName").empty();
                    $("#ClassName").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    // Get button -> load the report
    function LoadStudentDetailReport() {
        var ProgramName = $("#ProgramName").val();
        var ClassName = String($("#ClassName").val());
        var AcademicYear = $('#AcademicYear option:selected').text();
        if (!$("#ClassName").val() || !$('#AcademicYear option:selected').text() || AcademicYear == '' || AcademicYear == '0') {
            alert('Please Choose All The Values...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindStudentDetailReport", "Student")",
            method: "POST",
            datatype: "json",
            data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
            success: function (data) {
                $("#divbind").empty();
                $("#divbind").append(data);
                $(".btnPrintDiv").show();
                $(".btnExcelDiv").show();
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    };

    function printDiv() {
        var printContents = document.getElementById('divbind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Student/StudentDetailReport');
    }

    function Export() {
        var title = "Student_Detail_Report";
        let file = new Blob([$('#divbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
    }
</script>
