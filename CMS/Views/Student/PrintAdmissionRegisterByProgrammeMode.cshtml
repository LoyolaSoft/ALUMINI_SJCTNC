@model CMS.ViewModel.ViewModel.StudentViewModel
@{ Layout = null;
    int RunnigCount = 0;
    int FNO = 0;
    int TNO = 0;
    bool bFlag = true;
}
<style>
    table {
        page-break-before: always;
    }
</style>
<div>
    @{
        if (Model.liAdmissionRegister != null && Model.liAdmissionRegister.Count > 0)
        {
            var Programme = Model.liAdmissionRegister.GroupBy(o => o.PROGRAM_ID).ToList();
            if (Programme != null && Programme.Count > 0)
            {
                foreach (var proitem in Programme)
                {
                    bFlag = true;
                    RunnigCount = 0;
                    FNO = 0;
                    TNO = 0;
                    var programmeStudent = Model.liAdmissionRegister.Where(o => o.PROGRAM_ID == proitem.FirstOrDefault().PROGRAM_ID).ToList();
                    programmeStudent.OrderBy(s => s.ROLL_NO).ToList();
                    while (bFlag)
                    {
                        if (RunnigCount < programmeStudent.Count)
                        {
                            FNO = RunnigCount;
                            TNO = RunnigCount;
                            var studentlist = programmeStudent.Skip(RunnigCount).Take(6).ToList();
                            RunnigCount = RunnigCount + studentlist.Count();
                            if (studentlist != null && studentlist.Count > 0)
                            {
                                <div class="col-md-12 " style="page-break-before:always !important;page-break-after:always !important; page-break-inside:avoid !important;">
                                    <div>
                                        <table class="pull-left" width="95%">
                                            <tr><td colspan="9" align="center"><b>HOLY CROSS COLLEGE - TIRUCHIRAPPALLI - 620002</b></td></tr>
                                            <tr>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"><b>S.No</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="6%" height="100"><b>Admission No</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="15%" height="100"><b>Name of the Student<br />DOB</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="13%" height="100"><b>Name of the Parent<br />Gurardian<br />Occupation<br />Income</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="12%" height="100"><b>Nationality<br />Religion<br />Caste<br />Community</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="5%" height="100"><b>Gender</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="23%" height="100"><b>Personal Marks of Identification</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="12%" height="100"><b>Class on Admission<br />Date of Admission</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="6%" height="100"><b>Part-I Language Studied</b></td>

                                            </tr>
                                            @foreach (var Stuitem in studentlist)
                                    {
                                                <tr>
                                                    <td style="padding:5px 5px; border:1px solid;" align="center" width="2%" height="100">@{FNO++;}@FNO</td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="center" width="6%" height="100">@Stuitem.ROLL_NO</td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="left" width="15%" height="100">@Stuitem.FIRST_NAME <br />@Stuitem.DATE_OF_BIRTH</td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="left" width="13%" height="100">@Stuitem.FATHER_NAME<br />@Stuitem.FR_OCCUPATION<br />@Stuitem.ANNUAL_INCOME<br /></td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="left" width="12%" height="100">@Stuitem.NATIONALITY<br />@Stuitem.RELIGION<br />@Stuitem.CASTE<br />@Stuitem.COMMUNITY</td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="center" width="5%" height="100">@Stuitem.GENDER</td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="left" width="23%" height="100">@Stuitem.IDENTIFICATION_MARK1 <br />@Stuitem.IDENTIFICATION_MARK2</td>
                                                    <td style="padding:5px 5px; border:1px solid;" align="left" width="12%" height="100">@Stuitem.ADMITTED_CLASS <br />@Stuitem.ADMISSION_DATE</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="left" width="6%" height="100">@Stuitem.FIRST_LANGUAGE</td>
                                                </tr>
                                                        }
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-12"  style="page-break-before:always !important;page-break-after:always !important; page-break-inside:avoid !important;">
                                    <div>
                                        <table class="pull-right" width="95%">
                                            <tr><td colspan="10" align="center"><b>REGISTER OF ADMISSION AND WITHDRAWALS FOR @studentlist.FirstOrDefault().ACADEMIC_YEARS</b></td></tr>
                                            <tr>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"><b>S.No</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="14%" height="100"><b>Class on Leaving<br /> Date of Leaving<br />Reason For Leaving</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="5%" height="100"><b>Fee Dues</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="5%" height="100"><b>Scholor ship</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="5%" height="100"><b>Student's Conduct & Charactor</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="8%" height="100"><b>Date of issued TC</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="5%" height="100"><b>Medium of Instruction</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="13%" height="100"><b>Last School/College</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="23%" height="100"><b>Phone No/Address</b></td>
                                                <td style="border:1px solid ;padding-left:5px;" align="center" width="13%" height="100"><b>Remarks</b></td>
                                            </tr>
                                            @foreach (var Stuitem in studentlist)
                                    {
                                                <tr>
                                                    <td style="padding:5px 5px; border:1px solid;" align="center" width="2%" height="100">@{TNO++;}@TNO</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="left" width="14%" height="100">@Stuitem.LEAVING_CLASS <br />@Stuitem.LEAVING_DATE<br />@Stuitem.REASON_FOR_LEAVING</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="center" width="5%" height="100">@Stuitem.FEE_PAID</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="center" width="5%" height="100">@Stuitem.SCHOLAR_SHIP</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="center" width="5%" height="100">@Stuitem.CONDUCT</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="center" width="8%" height="100">@Stuitem.TC_GIVEN_DATE</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="left" width="5%" height="100">@Stuitem.MEDIUM_OF_INSTRUCTION</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="left" width="13%" height="100">@Stuitem.STUDIED_FROM</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="left" width="23%" height="100">@Stuitem.CONTACT_NO<br /> @Stuitem.ADDRESS</td>
                                                    <td style="padding:5px 5px;  border:1px solid;" align="left" width="13%" height="100"></td>
                                                </tr>
                                                        }
                                        </table>
                                    </div>
                                </div>
                                                                            }
                                                                            studentlist.Clear();
                                                                        }
                                                                        else
                                                                        {
                                                                            bFlag = false;
                                                                        }

                                                                    }

                                                                }

                                                            }
                                                        }

    }
</div>