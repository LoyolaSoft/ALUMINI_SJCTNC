@model CMS.ViewModel.Model.ConductCertificate

@{
    ViewBag.Title = "ConductCertificate";
    //  Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
    <link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Conduct Certificate</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ProgramId, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramId, (Model.ProgramId != null) ? Model.ProgramId : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ProgramId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ClassId, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassId, (Model.ClassId != null) ? Model.ClassId : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.Label("Student", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-6">
                                @*@Html.DropDownListFor(model => model.StuName, Model.StuName, new { @class = " multiselect form-control input-sm", multiple= "multiple" })
                                @Html.ValidationMessageFor(model => model.StuName, "", new { @class = "text-danger" })*@
                                <select class="multiselect form-control input-sm" multiple="multiple" id="StuName"></select>
                            </div>
                        </div>
                        <div class="col-md-6 pull-right">
                            <a id="btnSubmit" class="btn btn-primary pull-right">GO</a>
                        </div>
                    </div>
                    <br /><br />
                    <div class="form-horizontal">

                        <iframe id="iReport" class="col-lg-12" style="height:660px;"></iframe>

                    </div>

                </div>
            }
        </div>
    </div>

</div>

    <script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        $('.selectpicker').selectpicker({
            size: 4
        });
        ContentLoad = function () {
                $('.multiselect').multiselect({
                    includeSelectAllOption: true,
                    enableFiltering: true,
                    enableCaseInsensitiveFiltering: true,
                    maxHeight: 200,
                    numberDisplayed: 1,
                    templates: {
                        button: '<button type="button" class="multiselect dropdown-toggle form-control input-sm col-md-9 " data-toggle="dropdown"><span class="multiselect-selected-text"></span> <b class="caret"></b></button>',
                        ul: '<ul class="multiselect-container dropdown-menu" style="max-width:350px;"></ul>'
                    }
                });
        }
    </script>
    <script>
        $("#ProgramId").on("change", function () {
            var ProgramName = $("#ProgramId").val();
            var ShiftId = $("#ShiftList").val();
            var sAcademicYear = $('#AcademicYear option:selected').text();
            if (sAcademicYear == '' || sAcademicYear == '0') {
                alert('Please Choose All The Values...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("BindDDLClass", "Student")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: ShiftId, AcademicYear: sAcademicYear },
                success: function (data) {
                    $("#ClassId").empty();
                    $("#ClassId").append('<option value="0">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });

        $('#ShiftList').on('change', function () {
            var sShift = $("#ShiftList").val();
            $.ajax({
                url: "@Url.Action("GetProgramByShift", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift },
                success: function (data) {
                    $("#ProgramId").empty();
                    $("#ProgramId").append('<option value="0">-- Select --</option>' + data);
                    $("#TransferCertificate").hide();
                    $('#tittle').hide();
                    $("#StuName").empty();
                    $("#StuName").append('<option value="0">-- Select --</option>');
                    $("#ClassId").empty();
                    $("#ClassId").append('<option value="0">-- Select --</option>');
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });

        $("#ClassId").on("change", function () {
            var ProgramName = $("#ProgramId").val();
            var ClassName = $("#ClassId").val();
            var AcademicYear = $('#AcademicYear option:selected').text();
            if (AcademicYear == '' || AcademicYear=='0') {
                alert('Please Choose All The Values...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("FetchStudents", "Student")",
                method: "POST",
                datatype: "json",
                data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
                success: function (option) {
                    $('#StuName').attr("multiple", "multiple");
                    $("#StuName").empty().append(option).multiselect("destroy").multiselect({
                        includeSelectAllOption: true,
                        enableFiltering: true,
                        enableCaseInsensitiveFiltering: true,
                        maxHeight: 200,
                        numberDisplayed: 1,
                        templates: {
                            button: '<button type="button" class="multiselect dropdown-toggle form-control input-sm col-md-9 " data-toggle="dropdown"><span class="multiselect-selected-text"></span> <b class="caret"></b></button>',
                            ul: '<ul class="multiselect-container dropdown-menu" style="max-width:350px;"></ul>'
                        }
                    });

                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });


        $('#btnSubmit').on('click', function () {

            $('#iReport').attr("src", "../RDLCPages/ConductCertificate.aspx?sAcademicYear=" + $('#AcademicYear option:selected').text() + "&sStudentIds=" + $('#StuName').val());
            //$('#iReport').attr("src", "../RDLCPages/ConductCertificate.aspx?sStudentIds="+$('#StuName').val()+"sAcademicYear="+$('#AcademicYear option:selected').text());
        });

    </script>


