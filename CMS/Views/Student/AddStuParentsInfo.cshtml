        <script>
            $(document).ready(function ()
            {
                handleDatepicker = function () {
                    "use strict";
                    $("#FDATEOFBIRTH,#FRDATEOFEXPIRY,#MDATEOFBIRTH,#MODATEOFEXPIRY").datepicker({
                        todayHighlight: true,
                        autoclose: true,
                        endDate: new Date(),
                        format: "dd/mm/yyyy",
                        orientation: "right bottom"
                    }
                    )
                }
                handleDatepicker();
                GetParents();
                $('.selectpicker').selectpicker('refresh');
            });
            // Parents Details ...
            $("#StuAddParents").on("click", function ()
            {
                var isValid = true;
                if ($('#nav-tab1-3').parsley().validate() !== true) isValid = false;
                if (!isValid) {
                    //gritter-info,danger,success,warning,default
                    myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                    return false;
                }
                var FatherName = $("#FATHER_NAME").val();
                var FDOB = $("#FDATEOFBIRTH").val();
                var FOccupation = $("#FR_OCCUPATION").val();
                var FEducation = $("#FR_EDUCATION").val();
                var FNationality = $("#FR_NATIONALITY").val();
                var FBusinessPhone = $("#FR_BUSINESS_PHONE").val();
                var FMobile = $("#FR_MOBILE").val();
                var FPassportNo = $("#FR_PASSPORT_NUMBER").val();
                var FIncome = $("#FR_INCOME").val();
                //var FDOExpiry = $("#FRDATEOFEXPIRY").val();
                var FDOExpiry = "0000-00-00";
                var FEmail = $("#FR_EMAIL").val();
                var MName = $("#MOTHER_NAME").val();
                var MDOB = $("#MDATEOFBIRTH").val();
                var MOccupation = $("#MO_OCCUPATION").val();
                var MEducation = $("#MO_EDUCATION").val();
                var MNationality = $("#MO_NATIONALITY").val();
                var MBusinessPhone = $("#MO_BUSINESS_PHONE").val();
                var MPhone = $("#MO_MOBILE").val();
                var MPassportNo = $("#MO_PASSPORT_NUMBER").val();
                var MIncome = $("#MO_INCOME").val();
                //var MDOExpiry = $("#MODATEOFEXPIRY").val();
                var MDOExpiry = "0000-00-00";
                var MEmail = $("#MO_EMAIL").val();
                //var MPhoto = $("#MOTHER_PHOTO").val();
                //var FPhoto = $("#FATHER_PHOTO").val();
                var JsonData;
                if (JsonData==null)
                {
                //    JsonData = '{"FatherName":"' + FatherName + '","FDateOfBirth":"' + FDOB + '","MotherName":"' + MName + '",\
                //"MDateOfBirth":"' + MDOB + '","fBusinessContact":"' + FBusinessPhone + '","FMobile":"' + FMobile + '","FPassport":"' + FPassportNo + '",\
                //"mBusinessContact":"' + MBusinessPhone + '","MMobile":"' + MPhone + '","MPassport":"' + MPassportNo + '","FIncome":"' + FIncome + '",\
                //"MIncome":"' + MIncome + '","FDateOfExpire":"' + FDOExpiry + '","MDateOfExpire":"' + MDOExpiry + '","FEmail":"' + FEmail + '","MEmail":"' + MEmail + '",\
                //"FOccupation":"' + FOccupation + '","MOccupation":"' + MOccupation + '","FEducation":"' + FEducation + '","MEducation":"' + MEducation + '",\
                //"FNationality":"' + FNationality + '","MNationality":"' + MNationality + '"}';

                    JsonData = '{"FATHER_NAME":"'+FatherName+'"\
                                ,"F_DATE_OF_BIRTH":"'+FDOB+'"\
                                ,"MOTHER_NAME":"'+MName+'"\
                                ,"M_DATE_OF_BIRTH":"'+MDOB+'"\
                                ,"FR_BUSINESS_PHONE":"'+FBusinessPhone+'"\
                                ,"FR_MOBILE":"'+FMobile+'"\
                                ,"MO_BUSINESS_PHONE":"'+MBusinessPhone+'"\
                                ,"MO_MOBILE":"'+MPhone+'"\
                                ,"FR_INCOME":"'+FIncome+'"\
                                ,"MO_INCOME":"'+MIncome+'"\
                                ,"FR_DATE_OF_EXPIRY":"'+FDOExpiry+'"\
                                ,"MO_DATE_OF_EXPIRY":"'+MDOExpiry+'"\
                                ,"FR_EMAIL":"'+FEmail+'"\
                                ,"MO_EMAIL":"'+MEmail+'"\
                                ,"FR_OCCUPATION":"'+FOccupation+'"\
                                ,"MO_OCCUPATION":"'+MOccupation+'"\
                                ,"FATHER_EDUCATION":"'+FEducation+'"\
                                ,"MOTHER_EDUCATION":"'+MEducation+'"\
                                ,"FR_NATIONALITY":"'+FNationality+'"\
                                ,"MO_NATIONALITY":"' + MNationality + '"}';
                }
        
                $.ajax({
                    url:"@Url.Action("SaveParentsDetails", "Student")",
                    method: "POST",
                    datatype: "html",
                    data: { JsonParents: JsonData },
                    success:function(data)
                    {
                        if (data.Message == "200")
                            myAlert('Record(s) saved successfully ...!', 'gritter-success', '');
                        else
                            myAlert(data.Message, 'gritter-warning', '');
                    }, error: function (error)
                    {
                        myAlert('Internal Server Error ...!', 'gritter-danger', '');
                    }
                });
            });


            // FetchParents
            function GetParents()
            {
                $.ajax({
                    url:"@Url.Action("FetchParentsDetails", "Student")",
                    method:"POST",
                    datatype:"json",
                    success:function (data) 
                    {
                        if (data.Message != null && data.Message != '')
                        {
                            myAlert(data.Message, 'gritter-warning', '');
                        } else {
                            $("#FATHER_NAME").val(data[0].FATHER_NAME);
                            $("#FDATEOFBIRTH").val(data[0].F_DATE_OF_BIRTH);
                            $("#FR_OCCUPATION").val(data[0].FR_OCCUPATION);
                            $("#FR_EDUCATION").val(data[0].FATHER_EDUCATION);
                            $("#FR_NATIONALITY").val(data[0].FR_NATIONALITY);
                            $("#FR_BUSINESS_PHONE").val(data[0].FR_BUSINESS_PHONE);
                            $("#FR_MOBILE").val(data[0].FR_MOBILE);
                            $("#FR_PASSPORT_NUMBER").val(data[0].FR_PASSPORT_number);
                            $("#FR_INCOME").val(data[0].FR_INCOME);
                            //$("#fdofexpiry").val(data[0].FR_DATE_OF_EXPIRY);
                            $("#FEmail").val(data[0].FR_EMAIL);
                            $("#MOTHER_NAME").val(data[0].MOTHER_NAME);
                            $("#MDATEOFBIRTH").val(data[0].M_DATE_OF_BIRTH);
                            $("#MO_OCCUPATION").val(data[0].MO_OCCUPATION);
                            $("#MO_EDUCATION").val(data[0].MOTHER_EDUCATION);
                            $("#MO_NATIONALITY").val(data[0].MO_NATIONALITY);
                            $("#MO_BUSINESS_PHONE").val(data[0].MO_BUSINESS_PHONE);
                            $("#MO_MOBILE").val(data[0].MO_MOBILE);
                            $("#MO_PASSPORT_NUMBER").val(data[0].MO_PASSPORT_number);
                            $("#MO_INCOME").val(data[0].MO_INCOME);
                            //$("#MDOFExpiry").val(data[0].MO_DATE_OF_EXPIRY);
                            $("#MO_EMAIL").val(data[0].MO_EMAIL);
                            $('.selectpicker').selectpicker('refresh');
                        }
                           
                    },error:function(error)
                    {
                        myAlert('Internal Server Error ...!', 'gritter-danger', '');
                    }
                });
            }
            
        </script>
