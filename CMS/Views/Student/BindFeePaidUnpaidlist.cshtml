@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@using System.Globalization;
@{
    ViewBag.Title = "BindFeePaidUnpaidlist";
    Layout = null;
    int count = 0;

    var currentDate = DateTime.Now.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
}

@if (Model.liFeeDueReport != null && Model.liFeeDueReport.Count > 0)
{
    var liGroupClass = Model.liFeeDueReport.GroupBy(x => x.CLASS_ID).ToList();
    foreach (var Classitem in liGroupClass)
    {
        count = 0;
        var liDue = Model.liFeeDueReport.Where(x => x.CLASS_ID == Classitem.FirstOrDefault().CLASS_ID).ToList();
        if (liDue != null && liDue.Count > 0)
        {
            var attchecked = ViewBag.isAttCheked != null ? ViewBag.isAttCheked.ToString() : "0";
            var lateAttChecked = ViewBag.isLateAttChecked != null ? ViewBag.isLateAttChecked.ToString() : "0";
            var ParentSign = ViewBag.isParentSign != null ? ViewBag.isParentSign.ToString() : "0";

            int totalCols = 9; // base: #, Roll No, First Name, Term Fee, Exam Fee, Bus Fee, Hostel Fee, Old Balance, Total Due
            if (lateAttChecked == "1")
            {
                totalCols += 5; // No of Days Absent, Late Entry Count, Late Absent Days, Total Absent Days, Att Percentage
            }
            else if (attchecked == "1")
            {
                totalCols += 2; // No of Days Absent, Att Percentage
            }
            if (ParentSign == "1") { totalCols += 1; }

            <div style="page-break-after:always !important;">
                <table class="table table-hover table-bordered" width="100%" id="StudentList">
                    <thead>
                        <tr>
                            <th class="text-center" colspan="@totalCols">ST.JOSEPH'S COLLEGE OF ARTS AND SCIENCE (AUTONOMOUS), CUDDALORE</th>
                        </tr>
                        <tr>
                            <th>
                            </th>
                            <th colspan="@(totalCols - 2)" class="text-center">
                                <b> @liDue.FirstOrDefault().CLASS_NAME  - @currentDate  @(lateAttChecked == "1" ? "(Late Attendance Cum Fee Report)" : "(Attendance Cum Fee Report)")</b>
                            </th>
                            <th>

                            </th>
                        </tr>
                        <tr>
                            <th><b>#</b></th>
                            <th><b>Roll No</b></th>
                            <th><b>First Name</b></th>
                            @if (lateAttChecked == "1")
                            {
                                <th><b>No of Days Absent</b></th>
                                <th><b>Late Entry Count</b></th>
                                <th><b>Late Absent Days</b></th>
                                <th><b>Total Absent Days</b></th>
                                <th><b>Att Percentage</b></th>
                            }
                            else if (attchecked == "1")
                            {
                                <th><b>No of Days Absent</b></th>
                                <th><b>Att Percentage</b></th>
                            }

                            <th><b>Term Fee</b></th>
                            <th><b>Exam Fee</b></th>
                            <th><b>Bus Fee</b> </th>
                            <th><b>Hostel Fee</b></th>
                            <th><b>Old Balance</b></th>
                            <th><b>Total Due</b></th>
                            @if (ParentSign == "1")
                            {
                               <th><b>Parent's_Sign</b></th>
                            }

                        </tr>
                    </thead>
                    <tbody>
                        @if (liDue != null)
                        {

                            foreach (var item in liDue)
                            {
                                var sPercentage = 0.0;
                                var normalAbsentCount = 0;
                                var totalWorkingDays = 0;
                                var lateCount = 0;
                                var lateAbsentDays = 0.0;
                                var totalAbsentDays = 0.0;

                                if (Model.liAttendanceReport != null)
                                {
                                    var findStuId = Model.liAttendanceReport.FirstOrDefault(o => o.STUDENT_ID == item.STUDENT_ID || (!string.IsNullOrEmpty(item.ROLL_NO) && o.ROLL_NO == item.ROLL_NO));
                                    if (findStuId != null)
                                    {
                                        int.TryParse(findStuId.DAYS_COUNT, out totalWorkingDays);
                                        int.TryParse(findStuId.ABSENT_COUNT, out normalAbsentCount);
                                    }
                                }

                                if (Model.liStuLateFee != null)
                                {
                                    var findLate = Model.liStuLateFee.FirstOrDefault(o => (!string.IsNullOrEmpty(item.STUDENT_ID) && o.STUDENT_ID == item.STUDENT_ID) || (!string.IsNullOrEmpty(item.ROLL_NO) && o.ROLL_NO == item.ROLL_NO));
                                    if (findLate != null)
                                    {
                                        int.TryParse(findLate.COUNT, out lateCount);
                                        // 2 late entries = 0.5 absent day, 4 = 1.0 absent day
                                        lateAbsentDays = (lateCount / 2) * 0.5;
                                    }
                                }

                                if (lateAttChecked == "1")
                                {
                                    totalAbsentDays = normalAbsentCount + lateAbsentDays;
                                    if (totalWorkingDays > 0)
                                    {
                                        double presentDays = totalWorkingDays - totalAbsentDays;
                                        if (presentDays < 0) { presentDays = 0; }
                                        sPercentage = (presentDays / (double)totalWorkingDays) * 100.0;
                                    }
                                }
                                else if (attchecked == "1")
                                {
                                    totalAbsentDays = normalAbsentCount;
                                    if (totalWorkingDays > 0)
                                    {
                                        double presentDays = totalWorkingDays - normalAbsentCount;
                                        if (presentDays < 0) { presentDays = 0; }
                                        sPercentage = (presentDays / (double)totalWorkingDays) * 100.0;
                                    }
                                }

                                <tr>
                                    <td>
                                        @{ count++;} <b>@count</b>
                                    </td>

                                    <td>
                                        @item.ROLL_NO
                                    </td>
                                    <td>
                                        @item.FIRST_NAME
                                    </td>
                                    @if (lateAttChecked == "1")
                                    {
                                        <td style="text-align:center;">
                                            <b>@normalAbsentCount</b>
                                        </td>
                                        <td style="text-align:center;">
                                            <b>@(lateCount > 0 ? lateCount.ToString() : "0")</b>
                                        </td>
                                        <td style="text-align:center;">
                                            <b>@(lateAbsentDays > 0 ? lateAbsentDays.ToString("0.#") : "0")</b>
                                        </td>
                                        <td style="text-align:center;">
                                            <b>@(totalAbsentDays.ToString("0.#"))</b>
                                        </td>
                                        <td style="text-align:center;">
                                            <b>@Math.Round(sPercentage, 2) %</b>
                                        </td>
                                    }
                                    else if (attchecked == "1")
                                    {
                                        <td style="text-align:center;">
                                            <b>@normalAbsentCount</b>
                                        </td>
                                        <td style="text-align:center;">
                                            <b>@Math.Round(sPercentage, 2) %</b>
                                        </td>
                                    }
                                    <td>@item.TERMFEE1DUE</td>
                                    <td>@item.EXAMFEEDUE</td>
                                    <td>@item.BUSFEEDUE</td>
                                    <td>@item.HOSTELFEEDUE</td>
                                    @if (item.PREVIOUS_YEAR_TERM_DUE == "0" || string.IsNullOrEmpty(item.PREVIOUS_YEAR_TERM_DUE))
                                    {
                                        <td><b>-</b></td>
                                    }
                                    else
                                    {
                                        <td>@item.PREVIOUS_YEAR_TERM_DUE</td>
                                    }

                                    <td>
                                        @item.TOTAL_DUE_AMOUNT
                                    </td>
                                    @if (ParentSign == "1")
                                    {
                                    <td>
                                      
                                    </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        }
    }
}
else
{
    <br />

    <div class="bg-warning p-2">
        <h5 class="text-center">No record's Found'</h5>
    </div>
}
