@model CMS.ViewModel.Model.TransferCertificate

@{
    ViewBag.Title = "AdmissionRegisterPrint";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">Print Admission Register</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Print Admission Register</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Print Admission Register</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ProgramName, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ClassName, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.StuName, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <select class="form-control input-sm selectpicker" data-live-search="true" multiple="multiple" data-actions-box="true" id="StuName">
                                    
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6 form-group">
                            <a class="btn btn-primary" href="javascript:;" id="btnGet"> Get </a>
                            <a class="btn btn-success pull-right hidden" onclick="PrintDiv();" href="javascript:;" id="btnPrint"> Print </a>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div id="dvPrintAdmissionRegister"></div>
            </div>
        </div>
    </div>
    <!-- end panel -->
</div>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->

<script>
    $('.selectpicker').selectpicker({
        size: 4
    });

    ContentLoad = function () {

        $("#TransferCertificate").hide();
        $("#tittle").hide();

        var sOption = '<option value="">-- Select --</option>';

        $("#ClassName").empty();
        $("#ClassName").append(sOption);
        $("#ProgramName").empty();
        $("#ProgramName").append(sOption);
        $("#StuName").empty();
        $("#StuName").append(sOption);
        $('.selectpicker').selectpicker('refresh');
        //$("#btnTCIssueUpdate").hide();
       

        handleDatepicker = function () {
            "use strict";
            $("#DateOfBirth,#AdmissionDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            })
        }
        handleDatepicker();
        handlepicker = function () {
            "use strict";
            $("#LeavingDate,#TCIssueDate,#StuTCApplyDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            })
        }
        handlepicker();
    }


    $("#ProgramName").on("change", function () {
        var ProgramName = $("#ProgramName").val();
        var ShiftId = $("#ShiftList").val();
        var sAcademicYear = $('#AcademicYear option:selected').text();
        if (sAcademicYear == '' || sAcademicYear == '0') {
            alert('Please Choose All The Values...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindDDLClass", "Student")",
            method: "POST",
            datatype: "json",
            data: { sProgramId: ProgramName, sShiftId: ShiftId, AcademicYear: sAcademicYear },
            success: function (data) {
                $("#ClassName").empty();
                $("#ClassName").append('<option value="">-- select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });


    // Get Shift
    $("#ShiftList").on("change", function () {
        var sShift = $("#ShiftList").val();
        $.ajax({
            url: "@Url.Action("GetProgramByShift", "Student")",
            method: "POST",
            datatype: "json",
            data: { sShiftId: sShift },
            success: function (data) {
                $("#ProgramName").empty();
                $("#ProgramName").append('<option value="">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
                $("#TransferCertificate").hide();
                $('#tittle').hide();
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });


    $("#ClassName").on("change", function () {
        var ProgramName = $("#ProgramName").val();
        var ClassName = $("#ClassName").val();
        var AcademicYear = $('#AcademicYear option:selected').text();
        if (AcademicYear == '' || AcademicYear == '0') {
            alert('Please Choose All The Values...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("FetchStudents", "Student")",
            method: "POST",
            datatype: "json",
            data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
            success: function (data)
            {
                $("#StuName").empty();
                $("#StuName").append(data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });



    $('#btnGet').on('click', function () {
        var ProgramName = $("#ProgramName").val();
        var ClassName = $("#ClassName").val();
        var StuName = String($("#StuName").val());
        var AcademicYear = $('#AcademicYear option:selected').text();
        if (AcademicYear == '' || AcademicYear == '0' || StuName == 0) {
            alert('Please Choose All The Values...!!!');
            return false;
        }

        $.ajax({
            url: '@Url.Action("PrintAdmissionRegister", "Student")',
            method: 'POST',
            datatype: 'json',
            data: { sStudentIds: StuName, AcademicYear: AcademicYear },
            success: function (data) {
                $('#dvPrintAdmissionRegister').empty();
                if (data.Message != null && data.Message != '') {
                    alert(data.Message);
                } else {
                    $('#dvPrintAdmissionRegister').append(data);
                    $('#dvPrintAdmissionRegister').removeClass('hidden');
                    $('#btnPrint').removeClass('hidden');
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });

   

    function PrintDiv()
    {
        var printContents = document.getElementById('dvPrintAdmissionRegister').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Student/AdmissionRegisterPrint');
    }
</script>