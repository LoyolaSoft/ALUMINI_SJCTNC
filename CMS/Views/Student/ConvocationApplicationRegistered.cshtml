@model CMS.ViewModel.ViewModel.StudentViewModel

@{
    ViewBag.Title = "ConvocationApplicationRegistered";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<style>
    hr {
        display: block;
        margin-before: 0.5em;
        margin-after: 0.5em;
        margin-start: auto;
        margin-end: auto;
        overflow: hidden;
        border-style: inset;
        border-width: 1px;
    }
</style>
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Convocation Registered Form</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Convocation Registered Form<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken();
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Convocation Registered Form</h4>
                </div>
                <div class="panel-body">
                    @if (Model.LiConvocationApplicationRegister != null && Model.LiConvocationApplicationRegister.Count > 0)
                    {
                        <div class="col-xs-12">
                            <div class="form-horizontal ">
                                <div class="form-group col-xs-12">
                                    <div class="col-xs-2">
                                        <img src="~/Content/assets/img/hcc-img/hcclogo.jpg" style="width:150px; height:150px" />
                                    </div>
                                    <div class="form-group col-xs-8 text-center">
                                        <h3>Bharthidasan University</h3>
                                        <h5>(Re-accrediated with "A" Grade by NAAC)</h5>
                                        <h4>Trichirappalli - 620 024.</h4>
                                        <h4>APPLICATION FOR ADMISSION TO THE CONVOCATION</h4>
                                        <h5>(Read the instruction carefully before filling the application)</h5>
                                    </div>
                                    <div class="form-group col-xs-2 pull-left">
                                        <div src="" style="border:2px solid gray;width:100px; height:130px;"><p style="text-align:center;">Affix Photo</p></div>
                                    </div>
                                </div>
                                <div class="form-group col-xs-12">
                                    <table class="table table-bordered" style="text-align:center;">
                                        <tr>
                                            <td colspan="4">Particulars of the Fee Remittance</td>
                                            <td rowspan="3">Remarks (For office use only)</td>
                                        </tr>
                                        <tr>
                                            <td>Name of the bank</td>
                                            <td>D.U.No.</td>
                                            <td>Date</td>
                                            <td>Amount</td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="form-group col-xs-12">
                                    <div class="">1. Name of the Candidate (in English)<br />(as entered in University Records in<br /> Block letters)<br /><u>@Model.LiConvocationApplicationRegister.FirstOrDefault().FIRST_NAME</u></div>

                                    <div>Name in Tamil<u>@Model.LiConvocationApplicationRegister.FirstOrDefault().FIRST_NAME</u></div>
                                    <div>2. Expansion of initials in English<u>@Model.LiConvocationApplicationRegister.FirstOrDefault().FIRST_NAME</u></div>
                                    <div> in Tamil<u>@Model.LiConvocationApplicationRegister.FirstOrDefault().FIRST_NAME</u></div>
                                    <div>3.Date of Birth<u>@Model.LiConvocationApplicationRegister.FirstOrDefault().DATE_OF_BIRTH</u></div>
                                    <div>
                                        4.Sex( Tick in appororiate Box )<span style='font-size:55px;'><i class="far fa-check-square"></i></span><span style='font-size:55px;'><i class="far fa-square"></i></span><span style='font-size:55px;'><i class="far fa-square"></i></span>
                                    </div>
                                    <div>
                                        5.Community( Tick in appororiate Box )<span style='font-size:30px;'>&#9989;</span><span style='font-size:30px;'>&#9989;</span><span style='font-size:30px;'>&#9989;</span><span style='font-size:30px;'>&#9989;</span><span style='font-size:30px;'>&#9989;</span><span style='font-size:30px;'>&#9989;</span>
                                    </div>
                                    <div>
                                        a)Physically Challenged/Visually<br />(Tick in appropriate Box)Impaired
                                    </div>
                                    <div>
                                        6.Address to which communication are to be sent(write legibly)
                                        <br />
                                        a.Phone No.
                                        (With std code)
                                        b.Mobile NO:
                                        c.Aadhar No:
                                        d.Email Id:
                                    </div>
                                    <div>
                                        7.Details of the Degree which the application is now made
                                        (i)Degree qualified
                                        (ii) Subject/Major
                                        (iii) Examination Reg.No
                                        (iv) Year of Admission
                                        (v) Year of Passing
                                        (vi) College/ Centre for Distance Education:
                                        (vii) Center code
                                    </div>
                                    @*have design For show Mark Details*@
                                    <div>
                                        8.Whether the candiate has already obtained a Degree? If so, give details
                                        a.Name of the Degree and the Univesity from which it was obtained
                                        b.Year of Passing       Reg.No
                                    </div>
                                    <div>
                                        9. Whether the Canditate has already obtained a similar Degree? If so, furnish detials
                                    </div>
                                    <div>
                                        Application defective in any form or insfufficient in particulars will be summarily rejected
                                    </div>
                                    <div>
                                        ENCLORSURES
                                        1.Attested Xerox copy of the previous Degree/ Course of study (whichever is applicables).
                                        2.Attested Xerox copy f the Mark Statements qualifying for the present degree,
                                        3.Attested Xerox copy of the Communication if any, for admitting the candidate to present course as recieved
                                        4.Online payment Receipt for Rs.
                                        5.Enclosed on photo(size 3.5cm x 4.5cm) and should write his/her name,Register Number and <b>Center Code</b> of the College on the reverse of the photo.
                                    </div>
                                    <div>
                                        Station:
                                        Date:
                                    </div>
                                    <div>
                                        Signature of the Canditate
                                    </div>
                                    <div>
                                        Certified that particulars furnished have been verified and they are correct.
                                    </div>
                                    <div>
                                        College Seal with date
                                    </div>
                                    <div>
                                        Signature of the Principal/Head of the University Department
                                    </div>
                                </div>
                            </div>
                        </div>
                    }                    
                </div>

            </div>
        </div>
    }
</div>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    $('.selectpicker').selectpicker({
        size: 4
    });
  
    function ContentLoad() {
        handleDatepicker = function () {
            "use strict";
            $("#objConvocationApplication_DATE_OF_BIRTH").datepicker({
                todayHighlight: !0,
                autoclose: !0,
                format: "dd/mm/yyyy",
                orientation: "right bottom"
                // 'top': top,
                // 'left': left
            })
        }
        handleDatepicker();
        FetchApplicantInfo();
    }  
</script>

