@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "ListCertificateRequested";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Certificate Requested</li>
    </ol>
    <h1 class="page-header">List Certificate Requested</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Certificate Requested</h4>
        </div>
        <div class="panel-body noPadding">
            <br><br>
            <div class="form-group">
                @Html.Label("ApplicationType", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                    @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.Label("Programme Mode", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.ProgrammeMode, (Model.ProgrammeMode != null) ? Model.ProgrammeMode : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                    @Html.ValidationMessageFor(model => model.ProgrammeMode, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                    @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                </div>
            </div>
           
            <div class="form-group">
                @Html.Label("Programme", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true", multiple = "multiple" })
                    @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                </div>
            </div>                                
            <div class="col-md-1">
                <a class="pull-right btn btn-primary" id="btnget" href="javascript:;">Get</a>
            </div>
            <div class="form-group col-md-12 table-responsive" id="bindstudentlsit">

            </div>
            <div class="col-md-12 hidden" id="submitdiv">
                <div class="col-md-1 col-md-offset-11">
                    <a href="#" class="btn btn-primary" id="btnsubmit">Submit</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>

    function ContentLoad() {
        // Document Ready Function .

    }

    $('.selectpicker').selectpicker({
        size: 5
    });
   

    $("#Shift").on('change', function ()
    {
        //$("#btnReload").click();
        if ($("#Shift").val() != '' && $("#ProgrammeMode").val() != '' && $("#ApplicationType").val() != '')
        {
            $.ajax({
                url: "@Url.Action("LoadProgrammes", "Academics")",
                async: false,
                data: { sApplicationTypeId: $("#ApplicationType").val(), sShiftId: $("#Shift").val(), sProgrammeModeId: $("#ProgrammeMode").val() },
                success: function (data)
                {
                if (data!=null && data!="")
                {
                    var select = $("#ProgrammeList");
                    select.empty();
                    // selectbox.html(list);
                    select.append('<option value=""> -- Select -- </option>' + data);
                    //select.html(data);
                    $("#ProgrammeList").selectpicker('refresh');
                }
                else
                {
                    swal({ title: "Info !", text: "FeedBack role is not added please meet feedback incharge or admin!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                }

            }, error: function (ex) {
                alert('Failed to retrieve .' + ex);
            }
        });
    }
    else
    {
                 var select = $("#ProgrammeList");
                 select.empty();
    }
    });




    $('#ProgrammeList').on('change', function () {
        var programmeids = $('#ProgrammeList').val();
        $.ajax({
            url: "@Url.Action("BindCertificateRequestedStudent", "Student")",
            type: "post",
        data: { sProgrammeIds: programmeids.toString() },
        success: function (data) {
               
            $('#bindstudentlsit').empty();
            $('#bindstudentlsit').append(data);
            $('#submitdiv').removeClass('hidden');
                
        },
        error: function (ex) {
            swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
        }
    });

    });



    $('#btnsubmit').click(function () {

        var JsonData = '';
        JsonData += '{"JSON_CERTIFICATE_DISTRIBUTION":[';
        $('#tblCertificateRequest tr').each(function () {

            if ($(this).find('.status').val() != '' && typeof ($(this).find('.status').val()) != "undefined")
            {
                JsonData += '{"APPLY_ID":"' + $(this).attr('applyid') + '","STATUS":"' + $(this).find('.status').val() + '","STUDENT_ID":"' + $(this).attr('studentid') + '","FEE_MAINHEAD_ID":"' + $(this).attr('feemainheadis') + '"},';
            }

        });
        JsonData = JsonData.slice(0, -1);
        JsonData += ']}';

        $.ajax({
            url: "@Url.Action("SaveorUpdateCertificaterequestedStatus", "Student")",
            type: "post",
        data: { sJsonData: JsonData },
        success: function (data) {
            if (data.ErrorCode != null && data.ErrorCode == "406")
            {
                swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                //loadContent('/Examination/ListMarkSheetRequested');
            } else {
                swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Student/ListCertificateRequested');
            }
        },
        error: function (ex) {
            swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
        }
    });
    });


</script>


