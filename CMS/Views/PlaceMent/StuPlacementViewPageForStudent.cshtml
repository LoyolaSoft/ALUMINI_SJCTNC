            <style>

                .placRegisterbtn {
                    padding: 8px 20px;
                    width: 200px;
                    height: 50px;
                    color: #fff;
                    font-weight: 700;
                    border-radius: 10px; /* Added rounded corners */
                    margin: 25px;
                    overflow: hidden;
                    position: relative;
                    background-color: #007bff;
                    border-left: 2px solid white; /* Set initial border */
                    box-sizing: border-box;
                    display: inline-block;
                    transition: box-shadow 0.3s ease;
                    /* animation: borderRotate 3s linear infinite;*/ /* Apply animation */
                }

                /* Animation for rotating border */
                @@keyframes borderRotate {
                    0% {
                        border-left: 6px solid #0058b7;
                    }

                    30% {
                        border-top: 6px solid #0058b7;
                    }

                    65% {
                        border-right: 6px solid #0058b7;
                    }

                    100% {
                        border-bottom: 6px solid #0058b7;
                    }
                }

                .placRegisterbtn a {
                    position: relative;
                    display: inline-block;
                    font-size: 16px;
                    text-decoration: none;
                    color: #fff;
                    z-index: 1;
                }

                .placRegisterbtn a {
                    display: block;
                    justify-content: center;
                    align-items: center;
                }

                .lastDate {
                    color: #e90d87;
                }
                .NoRecord {
                    background-color: #c50632;
                    color: whitesmoke;
                    background-size: 100px;
                    align-items: center;
                    text-align: center;
                    padding: 10px;
                }
            </style>

            <div>
                <section class="">
                    <!-- Add Bootstrap 5 CSS and Font Awesome for Icons -->
                    <div class=" py-5">
                        <div class="row g-4 text-center justify-content-center">
                            <div class="tab-container">
                                <div class="tabs col-md-12">
                                    <div class="col-md-3" style=" margin-bottom: 20px; ">
                                        <button class="tab active" data-tab="active" onclick="stuInterviewCategory('1')">Active Interviews</button>
                                    </div>
                                    <div class="col-md-3" style=" margin-bottom: 20px; ">

                                        <button class="tab" data-tab="completed" onclick="stuInterviewCategory('2')">Completed Interviews</button>
                                    </div>
                                    <div class="col-md-3" style=" margin-bottom: 20px; ">
                                        <button class="tab" data-tab="other" onclick="stuInterviewCategory('3')">Other Advertisements</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="" id="defaultPage">
                            <div style="padding-top:0px;">
                                <div class="tab-content">
                                    <div class="tabcontent">
                                        <div class="" id="Students">

                                        </div>
                                    </div>
                                </div>
                                <div class="tab-content" style="" id="defaultDiv">
                                    @{
                                        if (Model.liPlacementnews != null && Model.liPlacementnews.Count > 0)
                                        {
                                            int count = 0;

                                            <div class="tabcontent" id="General">
                                                @*<div style="border-bottom:2px solid white">
                                                        <div style="border-bottom:2px solid white;" class="achievementCenterAlign headerfontstyle">

                                                            <h3 style="background-color: #002147; color: white; align-items: center; text-align: center; padding: 5px 10px; border-radius: 5px; "><span style="color:#FFF">Campus News</span> </h3>

                                                        </div>

                                                    </div>*@

                                                <div class="projcard-container">
                                                    @foreach (var items in Model.liPlacementnews)
                                                    {
                                                        var splitImgPath = items.IMG_PATH.Split(',');
                                                        count++;
                                                        int imgcount = 0;

                                                        <div class="projcard projcard-blue">
                                                            <div class="projcard-innerbox" style="display:flex; flex-direction: column;">
                                                                <div class="projcard-img-section">
                                                                    @foreach (var item in splitImgPath)
                                                                    {
                                                                        imgcount++;
                                                                        var imgpath = item.Replace(@"\", "/");

                                                                        if (imgcount == 1)
                                                                        {
                                                                            <a href="@imgpath" data-lightbox="image-@items.PLACEMENT_ID" data-title="Image @items.PLACEMENT_ID">
                                                                                <div class="img-container">
                                                                                    <img class="projcard-img" src="@imgpath" alt="Image @imgcount">
                                                                                </div>
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a href="@imgpath" data-lightbox="image-@items.PLACEMENT_ID" data-title="Image @items.PLACEMENT_ID" style="display:none">
                                                                                <div class="img-container">
                                                                                    <img class="projcard-img" src="@imgpath" alt="Image @imgcount">
                                                                                </div>
                                                                            </a>
                                                                        }
                                                                    }
                                                                </div>

                                                                <div class="projcard-textbox">
                                                                    <div class="projcard-title">@items.TITLE</div>
                                                                    <div class="projcard-bar"></div>
                                                                    <div class="projcard-description">@items.DESCRIPTION</div>
                                                                    <div class="projcard-tagbox">
                                                                        <button class="placRegisterbtn">
                                                                            <a href="@items.LINK" target="_blank"><span>@items.LINKTEXT</span> </a>
                                                                        </button>
                                                                        <span class="lastDate">Last_Date: @items.TO_DATE</span>
                                                                        <span>
                                                                            @if (items.FILE_PATH != null)
                                                                            {
                                                                                int fileCount = 0;
                                                                                var file = items.FILE_PATH.Split(',');
                                                                                if (file != null)
                                                                                {
                                                                                    foreach (var fi in file)
                                                                                    {
                                                                                        fileCount++;

                                                                                        if (fi != "," && fi != "")
                                                                                        {
                                                                                            <a target="_BLANK" href="@fi">
                                                                                                <i class="fa fa-file" style="font-size:40px;color:red"></i>
                                                                                            </a>

                                                                                        }

                                                                                    }
                                                                                }
                                                                                else
                                                                                {


                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <a target="_BLANK" href="@items.FILE_PATH">
                                                                                    <i class="fa fa-file-pdf-o" style="font-size:48px;color:red">else part
                                                                                </a>
                                                                            }
                                                                        </span>

                                                                    </div>


                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                        }
                                        else
