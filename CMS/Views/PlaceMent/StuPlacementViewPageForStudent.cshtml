
@model CMS.ViewModel.ViewModel.WebsiteViewModel
@using CMS.Utility
@{
    ViewBag.Title = "StuPlacementEntryPage";
    Layout = null;
}
<style>
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    #btnImage {
        border: 1px solid gray;
        color: gray;
        background-color: white;
        padding: 7px 15px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }
</style>

<style>
    .city {
        display: none;
    }
    /* Hide all elements with class 'city' by default */
</style>
