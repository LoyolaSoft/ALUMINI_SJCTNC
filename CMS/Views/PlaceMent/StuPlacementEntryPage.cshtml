
@model CMS.ViewModel.ViewModel.WebsiteViewModel
@using CMS.Utility
@{
    ViewBag.Title = "StuPlacementviewPageForStudent";
    Layout = null;
}
<style>
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    #btnImage {
        border: 1px solid gray;
        color: gray;
        background-color: white;
        padding: 7px 15px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/ Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/css/lightbox.min.css">


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Placement</a></li>
        <li class="active">Placement News</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Placement News<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Placement News</h4>
        </div>
        <div class="panel-body">
            <div class="form-group col-md-12">
                <div class="col-md-6">
                    <div class=" form-group">
                        <label class="col-md-4 control-label">Academic Year </label>

                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.sAcademicYearList, (Model.sAcademicYearList != null) ? Model.sAcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.sAcademicYearList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#HomeAchievement-dialog" onclick="Add()" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>
            </div>
            <div id="appendBindData">

            </div>
            @if (Model.liPlacementnews != null && Model.liPlacementnews.Count > 0)
            {
                var count = 0;
                <div class="form-group col-md-12 table-responsive" id="defalultOpen">
                    <table class="table table-hover table-bordered" id="tblPlacementList">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Link</th>
                                <th>FromDate</th>
                                <th>ToDate</th>
                                <th>Image</th>
                                <th>File</th>
                                <th>Descritpion</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>


                            @foreach (var item in Model.liPlacementnews)
                            {
                                var splitImgPath = item.IMG_PATH.Split(',');

                                count = count + 1;
                                int imgcount = 0;
                                int filecount = 0;
                                <tr>
                                    <td>@count</td>
                                    <td>@item.TITLE</td>
                                    <td><a href="@item.LINK" target="_blank">@item.LINKTEXT</a> </td>
                                    <td>@item.FROM_DATE</td>
                                    <td>@item.TO_DATE</td>
                                    <td>
                                        @foreach (var items in splitImgPath)
                                        {
                                            imgcount++;
                                            var parts = items.Split(new[] { "\\" }, StringSplitOptions.RemoveEmptyEntries)
                                                .Select(part => part.Trim('/'))
                                                .ToList(); // Convert to a list to easily check for elements

                                            var imgpath = parts.Any() ? "/" + parts.Aggregate((current, next) => current + "/" + next) : string.Empty;
                                            //var imgpath = "/" + items.Replace(@"\", "/").TrimStart('/');
                                            if (imgcount == 1)
                                            {
                                                @*<img src="@item.IMG_PATH" height="100" width="100" />*@
                                                <a href="@imgpath" data-lightbox="image-@item.PLACEMENT_ID" data-title="Image @item.PLACEMENT_ID">

                                                    <img src="@imgpath" class="" alt="..." height="100" width="100">
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@imgpath" data-lightbox="image-@item.PLACEMENT_ID" data-title="Image @item.PLACEMENT_ID" class="hidden">

                                                    <img src="@imgpath" class="" alt="..." height="100" width="100">
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (item.FILE_PATH != null && item.FILE_PATH != "")
                                        {
                                            var splitFilePath = item.FILE_PATH.Split(',');
                                            foreach (var items in splitFilePath)
                                            {
                                                filecount++;
                                                var parts = items.Split(new[] { "\\" }, StringSplitOptions.RemoveEmptyEntries)
                                                .Select(part => part.Trim('/'))
                                                .ToList(); // Convert to a list to easily check for elements

                                                var imgpath = parts.Any() ? "/" + parts.Aggregate((current, next) => current + "/" + next) : string.Empty;
                                                //var imgpath = "/" + items.Replace(@"\", "/").TrimStart('/');
                                                if (!string.IsNullOrEmpty(imgpath))
                                                {
                                                    <a href="@imgpath" target="_blank">

                                                        <i class="fa fa-file" style="font-size:40px;color:red"></i>
                                                    </a>
                                                }
                                                else
                                                {

                                                }

                                            }

                                        }

                                    </td>

                                    <td>@item.DESCRIPTION</td>
                                    <td>

                                        <a href="#HomeAchievement-dialog" onclick="FetchstuPlacementById(@item.PLACEMENT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.PLACEMENT_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>

                                </tr>
                            }



                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <br />
                <div class=" text-center bg-warning">

                    <h3>No Records Found </h3>

                </div>
            }
            <div class="modal" id="HomeAchievement-dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                            <h4 class="modal-title">Add/Edit Placement News</h4>
                        </div>
                        <div class="modal-body" data-parsley-validate="true" id="placemententry">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="form-horizontal">
                                            <div class="col-md-12 form-horizontal">
                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Title</label>

                                                    <div class="col-md-8">
                                                        <input type="text" id="txtATitle" class="form-control" placeholder=" Title" data-parsley-required="true" data-parsley-maxlength="50">
                                                    </div>
                                                </div>

                                                <div class="col-md-12 form-group">
                                                    @Html.Label("From Date", htmlAttributes: new { @class = "control-label col-md-4" })
                                                    <div class="col-md-8">
                                                        <input type="text" id="txtDate" class="datepicker date form-control" data-parsley-required="true" />
                                                    </div>
                                                </div>
                                                <div class="col-md-12 form-group">
                                                    @Html.Label("To Date", htmlAttributes: new { @class = "control-label col-md-4" })
                                                    <div class="col-md-8">
                                                        <input type="text" id="txtToDate" class="datepicker date form-control" data-parsley-required="true" />
                                                    </div>
                                                </div>

                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Description</label>

                                                    <div class="col-md-8">
                                                        <textarea type="text" id="txtDescription" class="form-control" placeholder="Enter Description maxlength 1500 only" data-parsley-required="true" data-parsley-maxlength="1500"></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Link</label>

                                                    <div class="col-md-8">
                                                        <input type="text" id="link" class="form-control" placeholder="Link">
                                                    </div>
                                                </div>
                                                <div class="col-md-12 form-group">
                                                    <label class="col-md-4 control-label">Link Text</label>

                                                    <div class="col-md-8">
                                                        <input type="text" id="linkText" class="form-control" placeholder="Enter Link Text">
                                                    </div>
                                                </div>
                                                @*<div class="form-group col-md-12">
                                                        <label class="control-label col-md-4"></label>
                                                        <div class="col-md-8">
                                                            <div class="fileupload fileupload-new" data-provides="fileupload">
                                                                <div class="fileupload-new thumbnail" style="width: 150px; height: 190px;">
                                                                    <img src="" id="img" style="width: 140px; height: 185px;" accesskey=".jpg,.jpeg,.png" data-parsley-required="true" />
                                                                </div>
                                                                <div class="upload-btn-wrapper">
                                                                    <button class="btn" id="btnImage">Select Image</button>
                                                                    <input type="file" class="btn bg-purple" name="image" id="inputimg" onchange="encodeImagetoBase64(this)" accept=".pdf,.docx,.doc">
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>*@
                                                <div class="form-group">
                                                    @Html.Label("Image Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                                    <div class="col-md-9">
                                                        <div class="btn btn-primary" onclick="ImageClick('imageUpload')"> <i class="fa fa-plus"></i>  Image</div><br />
                                                        <input type="file" id="imageUpload" class="hidden" multiple="multiple" onchange="LoadImage('dvImageUpload', 'imageUpload')" />
                                                    </div>
                                                </div>
                                                <div class="form-group hidden" id="dvImageUpload">
                                                    <div class="form-group col-md-12 table-responsive">
                                                        <div class="col-md-1"></div>
                                                        <div class="col-md-10">
                                                            <table class="table table-bordered table-hover" id="tbl_imageUpload">
                                                                <thead>
                                                                    <tr>
                                                                        <th>#</th>
                                                                        <th>File</th>
                                                                        <th>Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="tbimageUpload"></tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                                    <div class="col-md-9">
                                                        <div class="btn btn-primary" onclick="FileClick('ActivityUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                                        <input type="file" id="ActivityUpload" class="hidden" multiple="multiple" onchange="LoadFile('dvActivityUpload', 'ActivityUpload')" />
                                                    </div>
                                                </div>
                                                <div class="form-group hidden" id="dvActivityUpload">
                                                    <div class="form-group col-md-12 table-responsive">
                                                        <div class="col-md-1"></div>
                                                        <div class="col-md-10">
                                                            <table class="table table-bordered table-hover" id="tbl_ActivityUpload">
                                                                <thead>
                                                                    <tr>
                                                                        <th>#</th>
                                                                        <th>File</th>
                                                                        <th>Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="tbActivityUpload"></tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 form-group">
                                                    <div class="col-md-8">
                                                        <input type="checkbox" id="chUg" /> &nbsp; &nbsp; Is UG
                                                    </div>
                                                </div>
                                                <div class="col-md-4 form-group">
                                                    <div class="col-md-8">
                                                        <input type="checkbox" id="chPg" /> &nbsp; &nbsp; Is PG
                                                    </div>
                                                </div>
                                                <div class="col-md-4 form-group">
                                                    <div class="col-md-8">
                                                        <input type="checkbox" id="chInterview" /> &nbsp; &nbsp; Is Interview
                                                    </div>
                                                </div>
                                                <div class="col-md-4 form-group">
                                                    <div class="col-md-8">
                                                        <input type="checkbox" id="chOther" /> &nbsp; &nbsp; Is Other
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary">Submit</a>
                            <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                        </div>
                    </div>
                    <input type="hidden" id="placemetnID" value="" />
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/js/lightbox.min.js"></script>

<script>
    var formData = new FormData();

    function ContentLoad() {

    }


    $(document).ready(function () {
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate:false,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
        $("#tblPlacementList").DataTable({
            dom: "lBfrtip", buttons: [{
                extend: "copy", className: "btn-sm"
            }
                , {
                extend: "excel", className: "btn-sm"
            }
                , {
                extend: "pdf", className: "btn-sm"
            }
            ], responsive: !0, "paging": true, "ordering": true
        });
    });
    function FetchstuPlacementById(sPlacement) {
        //$('#pBody').parsley().destroy();

        if (sPlacement != null) {
            $.ajax({

                 url: '@Url.Action("FetchstuPlacementNewsById", "PlaceMent")',
                type: "POST",
                datatype: 'json',
                data: { sPlacementId: sPlacement },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    else {
                        if (data.oResult[0] != null) {
                            $('#txtDate').attr('value', data.oResult[0].FROM_DATE);
                            $('#txtToDate').attr('value', data.oResult[0].TO_DATE);
                            $('#txtDescription').attr('value', data.oResult[0].DESCRIPTION);
                            $('#placemetnID').attr('value', data.oResult[0].PLACEMENT_ID);
                            $('#txtATitle').attr('value', data.oResult[0].TITLE);
                            $('#linkText').attr('value', data.oResult[0].LINKTEXT);
                            $('#link').attr('value', data.oResult[0].LINK);
                          /*  $('#img').attr("src", data.oResult[0].IMG_PATH);*/
                            BindFileInfo(data.oResult[0].FILE_PATH, 'tbActivityUpload', 'dvActivityUpload');
                            //BindImageInfo(data.oResult[0].IMG_PATH, 'tbimageUpload', 'dvImageUpload');
                            BindImageInfo(data.oResult[0].IMG_PATH, 'tbimageUpload', 'dvImageUpload');
                            $('.selectpicker').selectpicker('refresh');
                            if (data.oResult[0].IS_INTERVIEW == "1") {
                                $('#chInterview').attr('checked', true);
                            }
                            if (data.oResult[0].OTHERS == "1") {
                                $('#chOther').attr('checked', true);
                            }
                            if (data.oResult[0].IS_PG == "1") {
                                $('#chPg').attr('checked', true);
                            }
                            if (data.oResult[0].IS_UG == "1") {
                                $('#isUg').attr('checked', true);
                            }
                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
    $('#sAcademicYearList').on('change', function () {

            $.ajax({

                 url: '@Url.Action("BindAcYearWisePlacementList", "PlaceMent")',
                type: "POST",
                datatype: 'json',
                data: { sAcYear: $("#sAcademicYearList option:selected").text() },
                success: function (data) {
                    $("#appendBindData").empty();
                    $("#defalultOpen").empty();
                    $("#appendBindData").append(data);
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });

    })
    var fileExtension = "";
    function SaveData() {

        var isValid = true;
        if ($('#placemententry').parsley().validate() !== true) isValid = false;
        if (!isValid) {

            swal({ title: "Warning", text: "Something went wrong ! Please check your inputs !", showConfirmButton: false, timer: 2000, type: 'error', animation: true });
            return false;
        }
        var DeptFilePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;


        $('#dvActivityUpload').find("table tbody tr").each(function () {


            if (fileExtension != "" && fileExtension != "jpg" && fileExtension != "jpeg" && fileExtension != "png") {
                if ($(this).attr("cms-file-path")) {
                    DeptFilePath += $(this).attr("cms-file-pat") + ",";
                    fCount = parseInt(fCount) + 1;
                }
                else {
                    if ($(this).attr("id")) {
                        FilePath += $(this).attr("id") + ",";
                        iCount = parseInt(iCount) + 1;
                    }
                }
            }
        });

        if (fCount > 0) {
            DeptFilePath = DeptFilePath.slice(0, -1);

            formData.append("sfiles", DeptFilePath);
        }
        if (iCount > 0) {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }
        var NewsImagePath = '';
        var ImagePath = '';
        var IfCount = 0;
        var ImgiCount = 0;
        var ImageExtension = "";
        $('#dvImageUpload').find("table tbody tr").each(function () {

            if ($(this).attr("cms-img-path")) {
                NewsImagePath += $(this).attr("cms-img-path") + ",";
                IfCount = parseInt(IfCount) + 1;
            }
            else {
                if ($(this).attr("id")) {
                    ImagePath += $(this).attr("id") + ",";
                    ImgiCount = parseInt(ImgiCount) + 1;
                }
            }
        });

        if (IfCount > 0) {
            NewsImagePath = NewsImagePath.slice(0, -1);

            formData.append("photo", NewsImagePath);
        }
        if (ImgiCount > 0) {
            ImagePath = ImagePath.slice(0, -1);
            ImagePath += '';
        }

        //summernote
        var isUg = 0
        var isPg = 0
        var isInterView = 0
        var isOther = 0
        if ($('#chUg').is(':checked')) {
            isUg = 1;
        }
        if ($('#chPg').is(':checked')) {
            isPg = 1;
        }
        if ($('#chOther').is(':checked')) {
            isOther = 1;
        }
        if ($('#chInterview').is(':checked')) {
            isInterView = 1;
        }

        var sTitle = $('#txtATitle').val();
        var slinkText = $('#linkText').val();
        var sLink = $('#link').val();
        var fdate = $('#txtDate').val();
        var ToDate = $('#txtToDate').val();
        var placement_id = $('#placemetnID').val();
        var description = $('#txtDescription').val();


            //var fileUpload = $("#inputimg").get(0);
            //var files = fileUpload.files;
            //fileData.append('photo', files[0]);

            //var EventImage = $('#img').attr('src');
        var sJsonData = '{"PLACEMENT_ID":"' + placement_id + '","IS_INTERVIEW":"' + isInterView + '","OTHERS":"' + isOther + '","IS_PG":"' + isPg + '","IS_UG":"' + isUg + '","FROM_DATE":"' + fdate + '","TO_DATE":"' + ToDate + '","DESCRIPTION":"' + description + '","TITLE":"' + sTitle + '","LINKTEXT":"' + slinkText + '","LINK":"' + sLink + '","IMG_PATH":"' + ImagePath + '","FILE_PATH":"' + FilePath +'"}';

        formData.append('jsonData', sJsonData);

            $.ajax({
                url: '@Url.Action("SavePalcementNews", "PlaceMent")',
                method: 'POST',
                contentType: false, // Not to set any content header
                processData: false,
                data: formData,
                async: false,
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        if (data.ErrorCode == "200") {
                            $('#btnCancel').click();
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadContent('/PlaceMent/StuPlacementEntryPage');
                        }
                        if (data.ErrorCode == "417") {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        if (data.ErrorCode == "503") {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "406") {
