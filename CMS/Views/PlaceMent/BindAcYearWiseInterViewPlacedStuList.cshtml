@model CMS.ViewModel.ViewModel.WebsiteViewModel
@using CMS.Utility


@if (Model.liInterviewPlacedList != null && Model.liInterviewPlacedList.Count > 0)
{
    var count = 0;
    <div class="form-group col-md-12 table-responsive" id="defalultOpen">
        <table class="table table-hover table-bordered" id="tblPlacementListN">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Programme </th>
                    <th>Company Name</th>
                    <th>Position</th>
                    <th>Pay Package</th>
                    <th>Website</th>
                    <th>Img</th>
                    <th>File</th>
                    <th>Remarks</th>
                    <th>Action</th>

                </tr>
            </thead>
            <tbody>


                @foreach (var item in Model.liInterviewPlacedList)
                {
                    var splitImgPath = item.IMG_PATH.Split(',');

                    count = count + 1;

                    int filecount = 0;
                    <tr>
                        <td>@count</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME </td>
                        <td>@item.PROGRAMME_NAME </td>
                        <td>@item.COMPANY_NAME </td>
                        <td>@item.POSITION_OFFERED </td>
                        <td>@item.SALARY_PACKAGE </td>
                        <td>
                            @if (item.IS_WEB_PLACEMENT == "1")
                            {
                                <i class="label label-success">Yes</i>
                            }
                            else
                            {
                                <i class="label label-danger">No</i>
                            }
                        </td>
                        <td>
                            @*<img src="@item.IMG_PATH" height="100" width="100" />*@
                            <a href="@item.IMG_PATH" data-lightbox="image-@item.PLACED_ID" data-title="Image @item.PLACED_ID">
                                <img src="@item.IMG_PATH" class="" alt="..." height="100" width="100">
                            </a>
                        </td>
                        <td>
                            @if (item.FILE_PATH != null && item.FILE_PATH != "")
                            {
                                var splitFilePath = item.FILE_PATH.Split(',');
                                foreach (var items in splitFilePath)
                                {
                                    filecount++;
                                    var parts = items.Split(new[] { "\\" }, StringSplitOptions.RemoveEmptyEntries)
                                    .Select(part => part.Trim('/'))
                                    .ToList(); // Convert to a list to easily check for elements

                                    var imgpath = parts.Any() ? "/" + parts.Aggregate((current, next) => current + "/" + next) : string.Empty;
                                    //var imgpath = "/" + items.Replace(@"\", "/").TrimStart('/');
                                    if (!string.IsNullOrEmpty(imgpath))
                                    {
                                        <a href="@imgpath" target="_blank">

                                            <i class="fa fa-file-pdf-o" style="color:red"></i>
                                        </a>
                                    }
                                    else
                                    {

                                    }

                                }

                            }

                        </td>

                        <td>@item.REMARKS</td>
                        <td>

                            <a href="#PlacedStudentList-dialog" onclick="FetchstuPlacementById(@item.PLACED_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                            <a href="javascrip:;" onclick="GetConfirm(@item.PLACED_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                        </td>

                    </tr>
                }



            </tbody>
        </table>
    </div>
}
else
{
   
    <div class=" text-center bg-warning p-1">

        <h3>No Record's Found </h3>

    </div>
}


