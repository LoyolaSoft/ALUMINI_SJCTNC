@model CMS.ViewModel.Model.ChangePassword

@{
    //ViewBag.Title = "ForgotPassword";
    Layout = null; //"~/Views/Shared/_AdminLayoutPage.cshtml";
}

<style>
    #sOTP {
  padding-left: 15px;
  letter-spacing: 42px;
  border: 0;
  background-image: linear-gradient(to left, black 70%, rgba(255, 255, 255, 0) 0%);
  background-position: bottom;
  background-size: 50px 1px;
  background-repeat: repeat-x;
  background-position-x: 35px;
  width: 220px;
}
</style>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <div class="">
            <ol class="breadcrumb pull-right">
                <li><a href="javascript:;">Home</a></li>
                <li class="active">Forgot Password</li>
            </ol>
            <h1 class="page-header">Forgot Password</h1>
        </div>
        <div class="panel panel-inverse" data-sortable-id="form-stuff-4">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Forgot Password</h4>
            </div>
            <div class="panel-body">
                <div class="col-md-6 col-md-offset-3">
                    <div class="form-horizontal">
                      
                        <div class="form-group">
                            @Html.Label("User Name", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.USERNAME, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "User Name" } })
                                @Html.ValidationMessageFor(model => model.USERNAME, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Date Of Birth", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.DATE_OF_BIRTH, new { htmlAttributes = new { @class = "form-control input-sm",placeholder="dd/mm/yyyy" } })
                                @Html.ValidationMessageFor(model => model.DATE_OF_BIRTH, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group pull-right">
                            <div class="col-md-12">
                                <a id="btnSave" href="javascript:;" onclick="Validate()" class="input-sm btn btn-primary">Next</a>
                                <a id="" href="javascript:;" value="Submit" class="input-sm btn btn-danger">Cancel</a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Start Modal -->
<div class="modal" id="Forgot-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Forgot Password </h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12 form-group">
                        <h4>Select how you'd like to change your password.</h4>
                        <h5>We'll send a verification code to your preferred method.</h5>
                        <div class="form-group">
                            <div class="radio radio-css radio-success">
                                <input type="radio" name="cssRadioMail" id="cssRadioMail" value="1" />
                                <label for="cssRadioMail"> Send me an email</label>
                            </div>
                            <div class="radio radio-css radio-success">
                                <input type="radio" name="cssRadioMobile" id="cssRadioMobile" value="2" />
                                <label for="cssRadioMobile"> Text my phone number ending in <span class="dvNumber"></span></label>
                            </div>
                            <div class="radio radio-css radio-success hidden">
                                <input type="radio" name="cssRadioCall" id="cssRadioCall" value="1" />
                                <label for="cssRadioCall"> Call my phone number ending in <span class="dvNumber"></span></label>
                            </div>
                        </div>

                        <br />
                    </div>

                    <div class="col-md-12 form-group">
                        <div class="form-group">
                            @Html.Label("Please enter the OTP sent ", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <input id="sOTP" type="text" maxlength="4" />
                            </div>
                        </div>
                       
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a id="btnSubmit" href="javascript:;" onclick="VerifyOTP()" class="btn btn-sm btn-primary" data-dismiss="modal">Verify</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal-->

<!-- Hidden Filed -->
<input type="hidden" id="sUserName" />
<input type="hidden" id="sAcountId" />
<input type="hidden" id="sUserId" />
<input type="hidden" id="sMailId" />
<input type="hidden" id="sMobileNo" />
<!-- Hidden Filed -->
