    {
        if ($('#USERNAME').val() && $('#DATE_OF_BIRTH').val())
        {
            $.ajax({
                url:'@Url.Action("ValidateForgotPassword", "Account")',
                method:'POST',
                datatype: 'json',
                data: { sUsername: $('#USERNAME').val(), sDOB: $('#DATE_OF_BIRTH').val() },
                success: function (data)
                {
                    if (data.ErrorCode != null && data.ErrorCode != '')
                    {
                        alert("Sorry ! No Matches Found .!");
                    } else
                    {
                            
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    }

    function VerifyOTP()
    {
        if ($('#sOTP').val())
        {
            alert($('#sOTP').val());
            $.ajax({
                url: '@Url.Action("", "Account")',
                method: 'POST',
                datatype: 'json',
                data: {  },
                success: function (data)
                {
                   
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    }
</script>


