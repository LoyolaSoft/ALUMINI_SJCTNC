
@model CMS.ViewModel.ViewModel.AccountViewModel
@{ int count = 0;}
<table class="table table-bordered table-hover" id="tblUserRolesRight">
    <thead>
        <tr>
            <th>#</th>
            <th>Photo</th>
            <th>Name</th>
            <th>User Name</th>
            <th>Role</th>
            <th>Mobile</th>
            <th>User Type</th>
            <th>E-mail</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ListUserRolesByYear != null)
        {
            foreach (var list in Model.ListUserRolesByYear)
            {
                <tr>
                    <td>
                        @{ count++;}
                        @count
                    </td>
                    <td>
                        @if (list.PHOTO != null)
                        {
                            <img src="@list.PHOTO" style="width:50px;height:40px;border-radius:50%" />
                        }
                        else
                        {
                            <img src="" style="width: 50px; height: 40px; border-radius:50%" />
                        }
                    </td>
                    <td>@list.NAME</td>
                    <td>@list.USERNAME</td>
                    <td>@list.ROLE</td>
                    <td>@list.MOBILE</td>
                    <td>@list.USER_TYPE</td>
                    <td>@list.EMAIL</td>
                    <td>
                        <a href="#userroles" data-toggle="modal" data-dissmiss="modal" onclick="FetchUserRole(@list.USER_ROLE_ID)"><i class="fa fa-edit"></i></a>
                        <a href="javascript:;" onclick="DeleteUserRole(@list.USER_ROLE_ID)"><i class="fa fa-trash text-danger"></i></a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<input type="hidden" name="name" value="" id="sUserRoleId" />
<input type="hidden" name="name" value="" id="sUserId" />

