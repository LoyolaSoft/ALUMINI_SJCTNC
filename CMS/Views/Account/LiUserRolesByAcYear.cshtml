                  }
            Json = '{"USER_ROLE_ID":"' + UserRoleId + '","USER_ID":"' + Userid + '","USERNAME":"' + UserName + '",\
                     "ROLE_ID":"' + Role + '","USER_TYPE":"' + Usertype + '","ACADEMIC_YEAR":"' + acyear + '"}';
                $.ajax({
