<script>

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('#tblUserRolesRight').DataTable();

    $('#btnBulkMove').on('click', function () {
        var fromYear = $('#ddlFromAcademicYear option:selected').text().trim();
        var toYear = $('#ddlToAcademicYear option:selected').text().trim();
        
        var fromVal = $('#ddlFromAcademicYear').val();
        var toVal = $('#ddlToAcademicYear').val();

        if (!fromVal || !toVal || fromVal == "" || toVal == "") {
            swal({ title: "Warning!", text: "Please select both From and To academic years.", type: "warning" });
            return false;
        }

        if (fromVal == toVal) {
            swal({ title: "Warning!", text: "From Year and To Year cannot be the same.", type: "warning" });
            return false;
        }

        swal({
            title: "Are you sure?",
            text: "Do you want to copy all user roles from " + fromYear + " to " + toYear + "? Existing matching records in target year will not be duplicated.",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-warning",
            confirmButtonText: "Yes, Copy them!",
            closeOnConfirm: false
        }, function (isConfirm) {
            if (isConfirm) {
                // Change modal state to show loader/progress
                swal({
                    title: "Processing...",
                    text: "Please wait while user roles are copied.",
                    type: "info",
                    showConfirmButton: false
                });

                $.ajax({
                    url: '@Url.Action("BulkMoveUserRoles", "Account")',
                    type: 'POST',
                    data: { sFromYear: fromYear, sToYear: toYear },
                    success: function (data) {
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success!", text: data.Message, type: "success", showConfirmButton: true });
                            if (typeof loadGird1 === "function") {
                                loadGird1();
                            }
                        } else {
                            swal({ title: "Info", text: data.Message, type: "info", showConfirmButton: true });
                        }
                    },
                    error: function (xhr, textStatus, error) {
                        swal({ title: "Error!", text: "Internal Server Error or session expired.", type: "error", showConfirmButton: true });
                    }
                });
            }
        });
    });
</script>
