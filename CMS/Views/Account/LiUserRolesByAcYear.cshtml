<script>
    function FetchUserRole(UserRoleId)
    {
        $.ajax({
            url: '@Url.Action("FetchUserRole", "Account")',
            data: { sUserRoleId: UserRoleId },
            success: function (data)
            {
                if (data.ErrorCode!=null && data.ErrorCode!='')
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#sUserRoleId').val(data[0].USER_ROLE_ID);
                    $('#ddlurYear').val(data[0].ACADEMIC_YEAR);
                    $('#ddluruserid').val(data[0].USER_ID);
                    $('#uruserName').val(data[0].USERNAME);
                 
                    $('#ddlurrole').val(data[0].ROLE_ID);
                    $('#ddlurusertype').val(data[0].USER_TYPE);
                    $('#uruserName').prop("disabled", true);
                    $('.selectpicker').selectpicker('refresh');

                }
            },
            error: function (xhr, textStatus, error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function DeleteUserRole(UserRoleId)
    {

        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        }
        else
        {
            $.ajax({
                url: '@Url.Action("DeleteUserRole", "Account")',
                data: { sUserRoleId: UserRoleId },
                success: function (data) {
                    if (data.ErrorCode == '200')
                    {
                        swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadGird1();
                        //$('#LiUserRoles').click();
                    } else {
                        swal({ title: "Error!", text: "Sorry failed to fetch record !", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                },
                error: function (xhr, textStatus, error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
     }
</script>

