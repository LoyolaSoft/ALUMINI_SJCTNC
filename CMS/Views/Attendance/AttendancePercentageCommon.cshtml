                    @*Percentage Report*@
                    <div class="tab-pane fade" id="bindPercentageReport">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-6 form-group">
                                    @Html.Label("Start Date", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-8">
                                        <div class="input-group">
                                            <input class="form-control date" id="txtStartDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    @Html.Label("EndDate", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-8">
                                        <div class="input-group ">
                                            <input class="form-control date" id="txtEndDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 ">
                                <div class="col-md-5 form-group">
                                    @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <div class="col-md-4 form-group">
                                    @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true " })
                                    </div>
                                </div>

                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindAttendancePercentage()"> Get </button>
                                </div>

                                <div class="col-md-1">
                                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                                </div>
                            </div>
                        </div>

                    </div>

