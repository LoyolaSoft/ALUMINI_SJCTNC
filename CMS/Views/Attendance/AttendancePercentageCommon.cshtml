        FetchClassListForNotAbsentee()
    });
    function FetchClassList()
    {
        var Shift = String($("#CShiftddl").val());
        var Department = String($("#DepartmentList").val());
        var classYear = String($("#ClassYear").val());
        var classLevel = String($("#ClassLevel").val());
        if ($("#ClassLevel").val() && $("#ClassYear").val() && $("#DepartmentList").val() && $("#CShiftddl").val())
        {

            $.ajax({
                url: "@Url.Action("FetchClassByshiftandDepartmentID", "Attendance")",
                method: "POST",
                datatype: "html",
                data: { shift: Shift, sdepart: Department, classYear: classYear, classLevel: classLevel },
                success: function (data) {
                    var select = $("#ClassList");
                    select.empty();
                    if (data.sResult != null && data.sResult != '') {
                        select.append(data.sResult);
                    } else {
                        alert(data.Message);
                    }
                    $('#ClassList').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ...!');
                }
            });
        }
    }
                  function FetchClassListForNotAbsentee()
                  {
                      if ($("#nShiftddl").val() && $("#nDepartment").val() && $("#nClassYear").val() && $("#nClassLevel").val()) {
                          var Shift = String($("#nShiftddl").val());
                          var Department = String($("#nDepartment").val());
                          var classYear = String($("#nClassYear").val());
                          var classLevel = String($("#nClassLevel").val());

                          $.ajax({
                              url: "@Url.Action("FetchClassByshiftandDepartmentID", "Attendance")",
                              method: "POST",
                              datatype: "html",
                              data: { shift: Shift, sdepart: Department, classYear: classYear, classLevel: classLevel },
                              success: function (data) {
                                  var select = $("#NClassList");
                                  select.empty();
                                  if (data.sResult != null && data.sResult != '') {
                                      select.append(data.sResult);
                                  } else {
                                      alert(data.Message);
                                  }
                                  $('#NClassList').selectpicker('refresh');
                              }, error: function (error) {
                                  alert('Internal Server Error ...!');
                              }
                          });
                      }
}
                    function FetchStudentList()
                    {
                    var Shift = String($("#IShiftddl").val());
                        var AcYear = $('#IAcYearddl Option:selected').text();
                        if ($("#IShiftddl").val() && $('#IAcYearddl Option:selected').text()) {
                            $.ajax({
                                url: "@Url.Action("FetchStudentByShiftId", "Attendance")",
                                method: "POST",
                                datatype: "html",
                                data: { sShiftID: Shift, sAc_year: AcYear },
                                success: function (data) {
                                    var select = $("#StudentList");
                                    select.empty();
                                    if (data.sResult != null && data.sResult != '') {
                                        select.append(data.sResult);
                                    } else {
                                        alert(data.Message);
                                    }
                                    $('#StudentList').selectpicker('refresh');
                                }, error: function (error) {
                                    alert('Internal Server Error ...!');
                                }
                            });
                        }
                }

</script>

