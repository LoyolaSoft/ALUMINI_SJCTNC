                            <span class="d-sm-none">Day Wise Absentee's List</span>
                        </a>
                    </li>
                    <li class="nav-items " id="bindDateWiseAbsenteeList">
                        <a href="#bindDateWiseAbsenteeReport" data-toggle="tab" class="nav-link">
