        if ($('#CAcYearddl').val() && $('#CstartDate').val() && $('#CendDate').val() && $('#ClassList').val())
        {
            $('#dvAttendanceReport').empty();
            $('#loader').show();
        $.ajax({
            url:'@Url.Action("BindCommonAttendanceReportbyClassWise", "Attendance")',
            method:'POST',
            datatype:'json',
            data: { sAcYear: $('#CAcYearddl Option:selected').text(), sStartDate: $('#CstartDate').val(), sEndDate: $('#CendDate').val(), classId: String($("#ClassList").val()) },
            success: function (data)
            {

                $('#loader').hide();
                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }else
                {


                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvAttendanceReport').empty();
                    $('#dvAttendanceReport').append(data);
                }
            }, eror: function (error)
            {
                swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
    }
    else {
        swal({ title: "Error !", text: "Please Select All Field's", showConfirmButton: false, timer: 1000, type: 'error', animation: true });

    }
    }

