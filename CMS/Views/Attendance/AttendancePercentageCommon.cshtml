                            <span class="d-sm-none">Range Wise Absentee's List</span>
                        </a>
                    </li>
                    <li class="nav-items " id="bindgAttendancePercentage">
                        <a href="#bindPercentageReport" data-toggle="tab" class="nav-link ">
                            <span class="d-sm-none">Percentage Report </span>
                        </a>
                    </li>
                    <li class="nav-items " id="bindgAttendancePercentageMark">
                        <a href="#bindPercentageReportMark" data-toggle="tab" class="nav-link ">
