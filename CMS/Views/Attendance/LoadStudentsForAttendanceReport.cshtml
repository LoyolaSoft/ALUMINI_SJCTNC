@model CMS.ViewModel.ViewModel.AttendanceViewModel
@{ Layout = null; int count = 0;}
<div class="table-responsive">
    <table class="table table-bordered table-hover table-responsive" id="studenttable">
        <thead>
            <tr>
                <th>#</th>
                <th>Attendance Date</th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>Name</th>
                <th>Course Code</th>
                <th>Course Title</th>
                <th>Entry Date</th>
                <th>Reason</th>
                <th>Class Name</th>
                <th>Hour</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.attendanceEntry != null)
            {
                foreach (var item in Model.attendanceEntry)
                {
                    <tr>
                        <td>
                            @{ count++;}
                            @count
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ATTENDENCE_DATE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ROLL_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.REGISTER_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FIRST_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.COURSE_CODE)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.ENTRY_DATE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.REASON)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CLASS_NAME)
                        </td>
                        <td>
                            @if (item.HOUR_FROM != "")
                            {
                                @Html.DisplayFor(modelItem => item.HOUR_FROM)
                            }
                            else
                            {
                               <span>Special Hour</span> 
                            }
                        </td>

</tr>
                }
            }
            
        </tbody>
    </table>

</div>

