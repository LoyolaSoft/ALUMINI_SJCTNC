
@{
    ViewBag.Title = "BindCommonAbsenteesListRangeWise";
}

@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    Layout = null;
    string sExamNotAllowed = string.Empty;
    string sArrearOnlyAllowed = string.Empty;
    string sFineAndExamAllowed = string.Empty;
}

@if (Model.liAttAttendanceReport != null && Model.liAttAttendanceReport.Count > 0)
{
    string sMark = string.Empty;
    int nCount = 0;

    var liGroupClass = Model.liAttAttendanceReport.GroupBy(x => x.CLASS_ID).ToList();
    <div class="text-center">
        <h4>
            <span class="text-center">ST.JOSEPH'S COLLEGE OF ARTS AND SCIENCE (AUTONOMOUS), CUDDALORE</span>

        </h4>
    </div>
    foreach (var Classitem in liGroupClass)
    {
        nCount = 0;
        var liAttendance = Model.liAttAttendanceReport.Where(x => x.CLASS_ID == Classitem.FirstOrDefault().CLASS_ID).OrderBy(o => o.CLASS_ID).ToList();
        if (liAttendance != null && liAttendance.Count > 0)
        {
            @*<div class="form-group table-responsive" style="page-break-after:always !important;">*@
            <div class="form-group table-responsive">

                <table class="table table-bordered" border="1">
                    <thead>

                        <tr>
                            <th></th>
                            <th colspan="3" class="text-center"><b>@Classitem.FirstOrDefault().CLASS_NAME </b> - Attendance Report</th>


                            <th></th>
                        </tr>
                        <tr>
                            <th><b>#</b></th>
                            <th><b>Reg.No</b></th>
                            <th><b>Name</b></th>
                            <th><b>Mobile</b></th>
                            @*<th>WorkingDays</th>*@
                            <th><b>Absent Count</b></th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in liAttendance)
                        {
                            <tr>
                                <td>@{nCount++;} @nCount</td>
                                <td>@item.ROLL_NO</td>
                                <td>@item.FIRST_NAME</td>
                                <td>@item.MOBILE</td>
                                @*<td>

                                        @item.DAYS_COUNT
                                    </td>*@
                                @{var sAbseentCount = Convert.ToInt32(item.ABSENT_COUNT);

                                }
                                <td>  @sAbseentCount</td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }


}
else
{
    <div class="bg-warning text-center">
        <h4>No Record's Found</h4>
    </div>
}







