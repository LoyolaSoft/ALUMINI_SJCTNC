@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{ 
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active"> Attendance Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Attendance Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> Attendance Report</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">

                @*<div class="col-md-4 form-group">
                    @Html.LabelFor(model => model.StaffListDDL, "Staff", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.StaffListDDL, (Model.StaffListDDL != null) ? Model.StaffListDDL : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.StaffListDDL, "", new { @class = "text-danger" })
                    </div>
                </div>*@
                <div class="col-md-4 form-group">
                    <label class="control-label col-md-3"> Shift</label>
                    <div class="col-md-9">
                        @Html.DropDownListFor(m => m.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                    </div>
                </div>

                <div class="col-md-4 form-group">                    
                    <label class="control-label col-md-3"> Date</label>
                    <div class="col-md-9">
                        <div class="input-group date" id="datetimepicker1">
                            @Html.Editor("txtDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                        </div>
                    </div>
                </div>

                

                <div class="col-md-2 form-group">
                    <button class="btn btn-primary" id="btnGet"> Get </button>
                </div>

                <div class="col-md-2 form-group">
                    <button class="btn btn-success hidden" onclick="printDiv()" id="btnPrint"> Print </button>
                </div>

                <div class="form-group col-md-12">
                    <div id="dvAttendanceReport"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>

        function ContentLoad()
        {
            // Document Ready Function .
            $("#txtDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });

            $('.selectpicker').selectpicker({
                size: 6
            });
            $('.selectpicker').selectpicker('refresh');
        }
        
        // Get Attendance Report By Date And Staff Id ...
        $('#btnGet').on('click', function ()
        {
            if ($("#txtDate").val())//&& $('#StaffListDDL').val()
            {
                $.ajax({
                    url:"@Url.Action("BindAttendanceSubmissionForPrincipal", "Attendance")",
                    method:'POST',
                    datatype:'json',
                    data: { sDate: $('#txtDate').val(), sShift: $('#Shift').val() }, //,sStaffId:$('#StaffListDDL').val()
                    success:function (data) 
                    {
                        $('#dvAttendanceReport').empty();
                        if (data.Message!=null && data.Message!='') 
                        {
                            alert(data.Message);
                        }else 
                        {
                            $('#dvAttendanceReport').append(data);
                            $(".table").DataTable({ "bPaginate": false });
                            //$("#ciaMarkList_filter").addClass("dataTables_filter pull-right");
                            //$(".pagination").addClass("pagination pull-right");
                            $('#btnPrint').removeClass('hidden');
                        }
                    },error:function (error) 
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        });

    // Print Function ,...
        function printDiv()
        {
            var printContents = document.getElementById('dvAttendanceReport').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            loadContent('/Attendance/AttendanceSubmissionForPrincipal');
        }
</script>



