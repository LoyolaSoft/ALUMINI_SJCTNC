
@{
    ViewBag.Title = "AttendanceEntryByInput";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Attendance Status</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Attendance Status</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Attendance Status</h4>
        </div>
        <div class="panel-body">
            
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-6">
                            <label class="control-label col-md-4">RFID Card</label>
                            <div class="col-md-8">
                                <input type="text" name="name" id="txtStaffCard" value="" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group col-md-6 hidden" id="dvStudentIds">
                            <label class="control-label col-md-3"> Student Ids</label>
                            <div class="col-md-7">
                                <input type="text" rows="7" id="txtStudentRFID"  class="form-control"/>
                            </div>

                            <div class="form-group col-md-2 pull-right">
                                <a class="btn btn-primary" href="#" id="btnSubmit"> Submit</a>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="col-md-12">
                    <div id="dvAttendanceBind"></div>
                    <div class="col-md-12 pull-right">
                        <button type="button" class="btn btn-primary hidden" id="btnAbsentee">Save</button>
                    </div>
                </div>
            
        </div>
    </div>
</div>


<!-- Begin Modal For Class & Course Details-->
<div class="modal" id="EditModal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Select Course</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div id="dvBindClassCourse"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" id="btnCourse" class="btn btn-default" data-dismiss="modal">Submit</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- End Modal For Class & Course Details-->


<script>
    function ContentLoad() {
        // Document Ready Function .
    }
   


    var ClassId = null;
    var CourseId = null;
    var HourId = null;
    var StaffId = null;
    var UserRFID = null;
    $('#txtStaffCard').keypress(function (event)
        {
            var x = event.which || event.keyCode
            if (x == 13)
            {
                var text = document.getElementById("txtStaffCard").value = document.getElementById("txtStaffCard").value + ',';
                UserRFID = text;
                @* Begin ajax Calling For Fetch Staff Class & Course *@
                $.ajax({
                    url: '@Url.Action("FetchClassAndCourse", "Attendance")',
                    method:'POST',
                    datatype: 'json',
                    data: { sRFID: text},
                    success: function (data)
                    {
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message); // If Error Occur's alert will  fire ...
                        } else
                        {
                            $('#EditModal-dialog').modal();
                            $('#dvBindClassCourse').empty();
                            $('#dvBindClassCourse').append(data.sResult);
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
                $('#txtStaffCard').attr("disabled","true");
                @* End ajax Calling For Fetch Staff Class & Course *@
            };
    });

    $('#txtStudentRFID').keypress(function (event)
        {
            var x = event.which || event.keyCode
            if (x == 13)
            {
                var text = document.getElementById("txtStudentRFID").value = document.getElementById("txtStudentRFID").value + ',';              
            };
    });

    @* Begin Radio Button Click *@
    $('#btnCourse').on('click', function ()
    {
           // alert('Test1');
        ClassId = $("input[name='RFID']:checked").attr('cms-classid');
        CourseId = $("input[name='RFID']:checked").attr('cms-courseid');
        HourId = $("input[name='RFID']:checked").attr('cms-Hour');
        StaffId = $("input[name='RFID']:checked").attr('cms-StaffId');
        $('#dvStudentIds').removeClass('hidden');
    });
    @* End Radio Button Click *@

    @* Begin Fetch Absentees Student Button Click *@
    $('#btnSubmit').on('click', function ()
    {
        if (ClassId != '' && CourseId != '' && HourId != '' && StaffId!='')
        {           
            @* Begin ajax Calling For Student Attendance *@
                $.ajax({
                    url: '@Url.Action("RemovePrasentStudents", "Attendance")',
                    method:'POST',
                    datatype: 'json',
                    data: { ClassId: ClassId, sCourseId: CourseId, sRFID: $('#txtStudentRFID').val() },
                    success: function (data)
                    {
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#dvAttendanceBind').empty();
                            $('#dvAttendanceBind').append(data);
                            $('#btnAbsentee').removeClass('hidden');
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
                @* End ajax Calling For Student Attendance *@
        }
    });
    @* End Fetch Absentees Student Button Click *@


    @* Begin Submit Absentees Student By Button Click*@
    $('#btnAbsentee').on('click', function ()
    {        
        var JsonData = '{"liSaveStudentAbsentees":[';
        var nCount = 0;
        if (ClassId != '' && CourseId != '' && HourId != '' && StaffId!='')
        {
            // Table Looping To Select Absentees Student
            $('#tblAttendance tbody tr').each(function ()
            {
                if ($(this).find('input[type="checkbox"]').is(':checked'))
                {
                    JsonData += '{"COURSE_ID":"' + CourseId + '","HOUR_FROM":"' + HourId + '","HOUR_TO":"' + HourId + '","STUDENT_ID":"' + $(this).attr('cms-student-id') + '","CLASS_ID":"' + ClassId + '","S_CLASS_ID":"' + ClassId + '","ATTENDANCE_TYPE_ID":"2","REASON_ID":"1","STAFF_ID":"' + StaffId+'"},';
                    nCount++;
                }
            });

            if (nCount > 0)
            {               
                JsonData = JsonData.slice(0, -1);
                JsonData += ']}';
            } else
            {
                alert('Please Select Student To Continue !');
                return false;
            }

            @* Begin ajax Calling For Student Attendance *@
                $.ajax({
                    url: '@Url.Action("SaveAbsenteeStudents", "Attendance")',
                    method:'POST',
                    datatype: 'json',
                    data: { sClassId: ClassId, sCourseId: CourseId, sAbsenteeStudent: JsonData, sHourId: HourId, sStaffId: StaffId},
                    success: function (data)
                    {
                        alert(data.Message);
                        
                        loadContent('/Attendance/AttendanceEntryByInput');
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
                @* End ajax Calling For Student Attendance *@
        }
    });
    @* End Submit Absentees Student By Button Click*@
</script>


