@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{ 
    Layout = null;
}

@if (Model.liCollegeDetails!=null && Model.liCollegeDetails.Count>0)
{
    <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME , @Model.liCollegeDetails.FirstOrDefault().PLACE</h4>
    <h4 style="text-align:center;">Individual Attendance Report (<label id="sStartDate"></label> to <label id="sEndDate"></label>)</h4>
}
<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover" border="1">
        <thead>
            <tr>
                <th>#</th>
                <th width="20%">Roll No</th>
                <th width="20%">Name</th>
                <th width="20%">Date</th>
                <th width="20%">Month</th>
                <th width="20%">hours</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liAttAttendanceReport!=null && Model.liAttAttendanceReport.Count>0)
            {
                int nCount = 0;
                foreach (var item in Model.liAttAttendanceReport)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.START_DATE</td>
                        <td>@item.MONTH</td>
                        <td>@item.HOUR</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">No Record(s) Available !</td>
                </tr>
            }
        </tbody>
    </table>
</div>