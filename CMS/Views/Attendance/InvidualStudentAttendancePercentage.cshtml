@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{ 
    Layout = null;
}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active">Date Wise Online Attendance</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Date Wise Online Attendance<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Date Wise Online Attendance</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">

                <div class="col-md-4 form-group">
                    @Html.Label("Roll No", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.Editor("txtRollNo", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Roll No" } })
                    </div>
                </div>

                <div class="col-md-4 form-group">
                    @*@Html.Label("Date", htmlAttributes: new { @class = "control-label col-md-1" })*@
                    <label class="control-label col-md-3"> Date</label>
                    <div class="col-md-9">
                        <div class="input-group date" id="datetimepicker1">
                            @Html.Editor("txtStartDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select Start Date" } })
                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 form-group">
                    @*@Html.Label("Date", htmlAttributes: new { @class = "control-label col-md-1" })*@
                    <label class="control-label col-md-3"> Date</label>
                    <div class="col-md-9">
                        <div class="input-group date" id="datetimepicker1">
                            @Html.Editor("txtEndDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select End Date" } })
                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                        </div>
                    </div>
                </div>


                <div class="col-md-1">
                    <a href="javascript:;" class="btn btn-primary" id="btnGet" onclick="BindAttendancePercentage()"> Get </a>
                </div>
                <div class="col-md-1">
                    <a href="javascript:;" class="btn btn-success" id="btnPrint"> Print </a>
                </div>

                <div class="form-group col-md-12">
                    <div id="dvAttendanceReport"></div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    function ContentLoad() {
        // Document Ready Function .
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });

    }


    function BindAttendancePercentage() {
        if ($('#txtRollNo').val() &&  $('#txtStartDate').val() && $('#txtEndDate').val()) {
            $.ajax({
                url: '@Url.Action("BindInvidualStudentAttendancePercentage", "Attendance")',
                method: 'POST',
                datatype: 'json',
                data: { sRollNo:$('#txtRollNo').val(), sStartDate: $('#txtStartDate').val(), sEndDate: $('#txtEndDate').val() },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    } else {
                        $('#dvAttendanceReport').empty();
                        $('#dvAttendanceReport').append(data);
                        $('#sStartDate').text($('#txtStartDate').val());
                        $('#sEndDate').text($('#txtEndDate').val());
                    }
                }, eror: function (error) {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }
            });
        }
    }

    $('#btnPrint').on('click', function () {
        var printContents = document.getElementById('dvAttendanceReport').innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
    });
</script>