@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    Layout = null;
    int count = 0;
}

<div class="col-md-12 form-group">

@if (Model.liAttendanceReport != null && Model.liAttendanceReport.Count > 0)
{
        <div class="col-md-12 table-responsive">
            <br />
            <div class="form-group text-center">
                <div class="invoice-company">
                    @Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME ,<small>
                        ATTENDANCE REPORT
                    </small>
                </div>
                <hr />
                <br />
            </div>
            <div class="col-md-12">
                <div class="col-xs-4 form-group"> <b>Class Name: </b><span id="txtClass"></span></div>
                <div class="col-xs-4 form-group"> <b>Course Name : </b> @Model.liAttendanceReport.FirstOrDefault().COURSE_TITLE</div>
                <div class="col-xs-4 form-group"> <b>Course Code: </b> @Model.liAttendanceReport.FirstOrDefault().COURSE_CODE</div>
            </div>            
            <div class="col-md-12">
                <div class="col-xs-4 form-group"> <b>Date : </b> <span id="sdate"></span></div>
                <div class="col-xs-4 form-group"> <b>Staff Name : </b> @Model.UserName</div>
                <div class="col-xs-4 form-group"> <b>Student Count : </b> @Model.liAttendanceReport.Count</div>
            </div>
            

            <table class="table table-bordered table-responsive table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Roll No</th>
                        <th>Register No</th>
                        <th>Name</th>
                        @*<th>Course</th>*@
                        <th>Hour</th>
                        <th>Remark</th>
                        <th>Mobile</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.liAttendanceReport != null && Model.liAttendanceReport.Count > 0)
                        {
                            foreach (var item in Model.liAttendanceReport)
                            {
                                <tr>
                                    <td>@{count++;}@count</td>
                                    <td>@item.ROLL_NO</td>
                                    <td>@item.REGISTER_NO</td>
                                    <td>@item.FIRST_NAME</td>
                                    @*<td>@item.COURSE_CODE</td>*@
                                    <td>@item.HOUR_ID</td>
                                    <td>@item.ATTENDANCE_TYPE</td>
                                    <td>@item.MOBILE</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
}else
{
      <div class="alert alert-warning">
         Sorrry . No Records Found !
      </div>
}
</div>