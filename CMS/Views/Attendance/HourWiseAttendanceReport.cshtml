@model CMS.ViewModel.ViewModel.AttendanceViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "HourWiseAttendanceReport";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active">Hour Wise Attendance Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Hour Wise Attendance Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Hour Wise Attendance Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group  col-md-12">
                        <div class="col-md-4 " data-step="1" data-intro="Choose Class">
                            @Html.Label("Date", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.Editor("AttendanceDate", new { htmlAttributes = new { @class = "form-control", placeholder = "Select Date " } })
                            </div>
                        </div>
                        <div class="col-md-4" data-step="2" data-intro="Choose Course">
                                @Html.Label("Class List", htmlAttributes: new { @class = "col-md-4 control-label pull-left" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                </div>

                            </div>
                        @*<div class="col-md-6" data-step="2" data-intro="Choose Course">
                                @Html.Label("Hours", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.DropDownList("HoursList", Enumerable.Empty<SelectListItem>(), new { @class = "form-control  select2" })
                                </div>

                            </div>*@
                        <div class="col-md-3" data-step="2" data-intro="Choose Course">
                            @Html.Label("Hours", htmlAttributes: new { @class = "col-md-3 control-label pull-left" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.Hours, (Model.Hours != null) ? Model.Hours : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" , @multiple="multiple" ,@data_actions_box="true" })
                            </div>

                        </div>
                        <div class="col-md-1">
                            <a class="btn btn-success pull-right form-group m-b-5" href="#" onclick="BindAttendance()">Get</a>
                        </div>
                    </div>
                </div>
                <div id="divAttendanceEntry" class="row col-lg-12"></div>
            }

        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    @*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>*@
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

    <script>
        function ContentLoad()
        {
            // Document Ready Function .
            $("#AttendanceDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom",
                defaultDate: new Date()
            });

            $('#').on('change', function ()
            {
                $('#divAttendanceEntry').empty();
                var inp = $('#Classes').val();
                var attendanceDate = $("#AttendanceDate").val();
                if (attendanceDate != '') {
                    $.ajax({
                        url: "@Url.Action("FetchHoursByStaffId", "Attendance")",
                        async: false,
                        data: { sClassId: inp, sAttendanceDate: attendanceDate },
                        success: function (sResult)
                        {
                            var select = $('#HoursList');
                            select.empty();
                            select.append('<option value="0" >---Select---</option>' + sResult.sResult);
                        },
                        error: function (xhr, textStatus, error)
                        {
                            alert(error + "\n");
                        }
                    });
                $('#btnSubmit').addClass("disabled");
                } else
                {
                    alert('Please choose Attendance Date !!');
                }
            });
        }

        $('.selectpicker').selectpicker({
            size: 4
        });
        //$(document).ready(function () {
            

        //});
        $('#AttendanceDate').change(function () {
            $("#ClassList").val($("#staffList option:first").val());
            $("#Hours").val($("#HoursList option:first").val());
            $('.selectpicker').selectpicker('refresh');
        });
        function BindAttendance() {
            $('#divAttendanceEntry').empty();
            $('#btnSubmit').removeClass("disabled");
            var input1 = $('#ClassList').val();
            var input2 =String($('#Hours').val());
            var oTable;
            var attendanceDate = $("#AttendanceDate").val();
            if (attendanceDate != ''&&input1!=''&&input2!='') {
            $.ajax({
                url: "@Url.Action("LoadStudentsForAttendanceReport", "Attendance")",
                async: false,
                data: { sClassId: input1, sHourId: input2, sAttendanceDate: attendanceDate },
                success: function (sResult) {
                    var select = $('#divAttendanceEntry');
                    select.empty();
                    select.append(sResult);
                    oTable = $("#tblAttendance").DataTable({ "bPaginate": false, "sDom": '<"top">rt<"bottom"flp><"clear">' });
                    $('.dataTables_filter').hide();
                    $('#search').on('keyup', function () {
                        oTable.search(this.value).draw();
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }

            });
            } else {
                alert('Choose All The Values...!!!');
            }
        }
    </script>






