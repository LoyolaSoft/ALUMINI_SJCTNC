@model CMS.ViewModel.ViewModel.AttendanceViewModel
@using CMS.Utility;
@{
    //string mattvaluee = "1";
    var counts = 0;
    // var count1 = 0;
    // var ischek = "2";

    int count = 0;
}
<style>


    .checkbox-wrapper-8 .tgl {
        display: none;
    }

        .checkbox-wrapper-8 .tgl,
        .checkbox-wrapper-8 .tgl:after,
        .checkbox-wrapper-8 .tgl:before,
        .checkbox-wrapper-8 .tgl *,
        .checkbox-wrapper-8 .tgl *:after,
        .checkbox-wrapper-8 .tgl *:before,
        .checkbox-wrapper-8 .tgl + .tgl-btn {
            box-sizing: border-box;
        }

            .checkbox-wrapper-8 .tgl::-moz-selection,
            .checkbox-wrapper-8 .tgl:after::-moz-selection,
            .checkbox-wrapper-8 .tgl:before::-moz-selection,
            .checkbox-wrapper-8 .tgl *::-moz-selection,
            .checkbox-wrapper-8 .tgl *:after::-moz-selection,
            .checkbox-wrapper-8 .tgl *:before::-moz-selection,
            .checkbox-wrapper-8 .tgl + .tgl-btn::-moz-selection,
            .checkbox-wrapper-8 .tgl::selection,
            .checkbox-wrapper-8 .tgl:after::selection,
            .checkbox-wrapper-8 .tgl:before::selection,
            .checkbox-wrapper-8 .tgl *::selection,
            .checkbox-wrapper-8 .tgl *:after::selection,
            .checkbox-wrapper-8 .tgl *:before::selection,
            .checkbox-wrapper-8 .tgl + .tgl-btn::selection {
                background: none;
            }

            .checkbox-wrapper-8 .tgl + .tgl-btn {
                outline: 0;
                display: block;
                width: 6em;
                height: 2em;
                position: relative;
                cursor: pointer;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

                .checkbox-wrapper-8 .tgl + .tgl-btn:after,
                .checkbox-wrapper-8 .tgl + .tgl-btn:before {
                    position: relative;
                    display: block;
                    content: "";
                    width: 50%;
                    height: 100%;
                }

                .checkbox-wrapper-8 .tgl + .tgl-btn:after {
                    left: 0;
                }

                .checkbox-wrapper-8 .tgl + .tgl-btn:before {
                    display: none;
                }

            .checkbox-wrapper-8 .tgl:checked + .tgl-btn:after {
                left: 50%;
            }

    .checkbox-wrapper-8 .tgl-skewed + .tgl-btn {
        overflow: hidden;
        transform: skew(1deg);
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        transition: all 0.2s ease;
        border-radius: 3%;
        font-family: sans-serif;
        background: #c51515;
    }

        .checkbox-wrapper-8 .tgl-skewed + .tgl-btn:after,
        .checkbox-wrapper-8 .tgl-skewed + .tgl-btn:before {
            transform: skew(1deg);
            display: inline-block;
            transition: all 0.2s ease;
            width: 100%;
            text-align: center;
            position: absolute;
            line-height: 2em;
            font-weight: bold;
            color: #fff;
            text-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);
        }

        .checkbox-wrapper-8 .tgl-skewed + .tgl-btn:after {
            left: 100%;
            content: attr(data-tg-on);
        }

        .checkbox-wrapper-8 .tgl-skewed + .tgl-btn:before {
            left: 0;
            content: attr(data-tg-off);
        }

        .checkbox-wrapper-8 .tgl-skewed + .tgl-btn:active {
            background: #888;
        }

            .checkbox-wrapper-8 .tgl-skewed + .tgl-btn:active:before {
                left: -10%;
            }

    .checkbox-wrapper-8 .tgl-skewed:checked + .tgl-btn {
        background: #298f39;
    }

        .checkbox-wrapper-8 .tgl-skewed:checked + .tgl-btn:before {
            left: -100%;
        }

        .checkbox-wrapper-8 .tgl-skewed:checked + .tgl-btn:after {
            left: 0;
        }

        .checkbox-wrapper-8 .tgl-skewed:checked + .tgl-btn:active:after {
            left: 10%;
        }

    .checkbox-wrapper-8 {
        display: flex;
        justify-content: center;
        flex-direction: row;
        align-items: baseline;
    }
</style>

@{ string sSelected = "selected";
    string sDisabled = string.Empty;
    string sChecked = string.Empty;
    if (Model.attendanceEntry != null && Model.attendanceEntry.Count > 0)
    {
        var nCount = Model.attendanceEntry.Sum(x => Convert.ToInt32(x.ATT_TYPE_ID));
        var AttCount = Model.attendanceEntry.Where(x => x.ATT_ID == "0").Count();


        <div class="row pull-right">
            <div class="col-md-12">
                <div class="col-md-1">
                    <button type="button" class="btn btn-primary" id="Allpresent">All Present</button>
                    @*<a href="#" class="btn-success btn" id="Allpresent">All Present</a>*@
                </div>
                <div class="col-md-4"></div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-danger" id="Allabsent">All Absent</button>
                    @*<a href="#" class="btn-success btn " id="Allabsent">All Absent</a>*@
                </div>
            </div>
        </div>
        <br />
        <br />
        <br />
        <div class="col-md-12">


        </div>
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-bordered table-responsive table-hover" id="tblAttendance">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Roll No</th>
                            <th>Adm No</th>
                            @*  <th>Register No</th>*@

                            @*  <th>Class</th>*@
                            @*  <th>Hour</th>*@
                            <th class="text-center">First Name</th>
                            <th class="text-center" id="deskremove">Attendance Type <i id="attendanceFilterIcon" class="fa fa-filter" style="cursor: pointer; margin-left: 5px;" title="Filter Absentees"></i></th>

                            <th class="">Reason</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var student in Model.attendanceEntry)
                        {

                            counts++;
                            bool isChecked = student.ATTENDANCE_TYPE_ID == "1" || string.IsNullOrEmpty(student.ATTENDANCE_TYPE_ID) || student.ATTENDANCE_TYPE_ID == "";
                            <tr cms-attendance-id="@student.ATTENDANCE_ID" cms-student-id="@student.STUDENT_ID" cms-s-class-id="@student.S_CLASS_ID" cms-date="@DateTime.Now.ToString("yyyy-MM-dd")" cms-staff-id="@student.STAFF_ID">
                                <td>@{count++;}@count</td>
                                <td class="text-center">@student.ROLL_NO</td>

                                <td>@student.ADMISSION_NO</td>
                                @*   <td>@student.REGISTER_NO</td>*@

                                @* <td>@student.CLASS_NAME</td>*@
                                @*  <td>@student.HOUR</td>*@
                                <td>@student.FIRST_NAME</td>
                                <td>
                                    <div class="checkbox-wrapper-8 text-center">
                                        <input type="checkbox" id="attendanceType_@student.STUDENT_ID" value="@(isChecked ? "1" : "2")" class="tgl tgl-skewed" @(isChecked ? "checked" : "") onchange="toggleAttendance(this)">
                                        <label for="attendanceType_@student.STUDENT_ID" data-tg-on="Present" data-tg-off="Absent" class="tgl-btn"></label>
                                    </div>
                                </td>

                                <td class="">
                                    <select class="form-control" id="reason">
                                        <option value="0">--Select--</option>
                                        @foreach (var reason in Model.reasons)
                                        {
                                            <option value="@reason.REASON_ID" @if (reason.REASON_ID == student.REASON_ID) { @sSelected }>
                                                @reason.REASON
                                            </option>
                                        }

                                    </select>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
                <div>
                    <label>Present Count: <span id="checkedCount">0</span></label>
                    <br />
                    <label>Absent Count: <span id="uncheckedCount">0</span></label>
                </div>
            </div>
        </div>
    }
}
<script>
    function DisableCheckBox() {
        var sFlag = true;
        $('#tblAttendance tbody tr').each(function () {
            if ($(this).find('#attendanceType option:selected').text().toLowerCase().trim() != 'Present'.toLowerCase()) {
                $('#chNoAbsentees').attr('disabled', true);
                $('#chNoAbsentees').attr('checked', false);
                sFlag = false;
            }
        });

        if (sFlag) {
            $('#chNoAbsentees').attr('disabled', false);
        }
    }

    $("#deskremove").removeClass("sorting_desc").css("position", "relative"); // Ensure position if needed
    $("head").append(`
    <style>
        #deskremove.sorting_desc::after { content: none !important; }
    </style>
`);

    $(document).ready(function () {
        $('.selectpicker').each(function () {
            updateBadgeColor($(this));
        });

        function updateBadgeColor(selectElement) {
            var selectedOption = selectElement.find('option:selected');
            var backgroundColor = selectedOption.data('bgcolor');

            selectElement.css('background-color', backgroundColor);
        }

        $(document).on('change', '.selectpicker', function () {
            updateBadgeColor($(this));
        });
    });
    function toggleAttendance(checkbox) {
        if (checkbox.checked) {
            checkbox.value = "1"; // Present
        } else {
            checkbox.value = "2"; // Absent
        }
    }

    // New Filter For Attendance Type
    $(document).ready(function () {
        let filterAbsent = false;

        $('#attendanceFilterIcon').on('click', function () {
            filterAbsent = !filterAbsent;

            $('#tblAttendance tbody tr').each(function () {
                const checkbox = $(this).find('input[type="checkbox"]');
                const isChecked = checkbox.is(':checked');

                if (filterAbsent && isChecked) {
                    $(this).hide(); // Hide rows marked as Present
                } else {
                    $(this).show(); // Show all rows when not filtering
                }
            });

            // Update icon style or tooltip to indicate filtering mode
            $(this).toggleClass('active-filter', filterAbsent);
            $(this).attr('title', filterAbsent ? 'Show All' : 'Filter Absentees');
        });
    });

</script>
<script>
    $(document).ready(function () {
        $('#Allpresent').click(function (e) {
            e.preventDefault();
            $('.tgl').each(function () {
                $(this).prop('checked', true);
                $(this).val('1');
            });
        });

        $('#Allabsent').click(function (e) {
            e.preventDefault();
            $('.tgl').each(function () {
                $(this).prop('checked', false);
                $(this).val('2');
            });
        });
    });
</script>

