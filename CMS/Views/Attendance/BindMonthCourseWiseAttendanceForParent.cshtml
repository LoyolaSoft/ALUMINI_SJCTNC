@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    Layout = null;

    int nDaysCount = 0;
    string sHourCount = string.Empty;
    string sAbsentCount = string.Empty;
}

@{
    if (Model.liStudent != null && Model.liStudent.Count > 0)
    {
        int nCount=0;
        foreach (var Studentitem in Model.liStudent)
        {
            <div class="form-group panel-group" id="accordion">
                <div class="panel panel-info overflow-hidden">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" href="#@Studentitem.STUDENT_ID">
                                <i class="fa fa-plus-circle pull-right"></i>
                                @{nCount++;} @nCount. @Studentitem.FIRST_NAME
                            </a>
                        </h3>
                    </div>
                    <div id="@Studentitem.STUDENT_ID" class="panel-collapse collapse">
                        <div class="panel-body">
                            <div class="form-group">
                                <div class="col-md-3">
                                    Roll No : <b> @Studentitem.ROLL_NO </b>
                                </div>
                                <div class="col-md-3">
                                    Register No : <b> @Studentitem.REGISTER_NO </b>
                                </div>
                                <div class="col-md-3">
                                    Name : <b> @Studentitem.FIRST_NAME </b>
                                </div>
                                <div class="col-md-3">
                                    Class : <b> @Studentitem.CLASS_NAME </b>
                                </div>
                            </div>
                            <div class="form-group">
                                @{
                                    if (Model.liHours != null && Model.liHours.Count > 0)
                                    {
                                        if (Model.liCalender != null && Model.liCalender.Count > 0)
                                        {
                                            nDaysCount = Model.liCalender.Count;
                                        }
                                        <table style="width:100%" class="text-center" border="1">
                                            <thead>
                                                <tr>
                                                    @{ int count = 0;
                                                        if (nDaysCount != 0)
                                                        {
                                                            @*<th>#</th>*@
                                                            <th>Course</th>
                                                            for (int i = 1; i <= nDaysCount; i++)
                                                            {
                                                                if (i < 10)
                                                                {
                                                                    <th>@count@i</th>
                                                                }
                                                                else
                                                                {
                                                                    <th>@i</th>
                                                                }
                                                            }
                                                        }
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    if (Model.liStudentCourseList != null && Model.liStudentCourseList.Count > 0)
                                                    {
                                                        var liCourseList = Model.liStudentCourseList.Where(x => x.STUDENT_ID == Studentitem.STUDENT_ID).ToList();
                                                        foreach (var CourseItem in liCourseList)
                                                        {
                                                            <tr>
                                                                @*<td>@{nCount++;} @nCount</td>*@
                                                                <td>@CourseItem.COURSE_CODE</td>
                                                                @if (Model.liCalender != null && Model.liCalender.Count > 0)
                                                                {
                                                                    foreach (var item in Model.liCalender)
                                                                    {
                                                                        sHourCount = string.Empty;
                                                                        sAbsentCount = string.Empty;
                                                                        if (item.IS_HOLIDAY != "1")
                                                                        {
                                                                            <td>
                                                                                @{
                                                                                    if (item.CUR_DATE_VALIDATE == "1" && !string.IsNullOrEmpty(item.DAY_ORDER))
                                                                                    {
                                                                                        if (Model.liAbsenteesList != null && Model.liAbsenteesList.Count > 0)
                                                                                        {
                                                                                            var liAbsentList = Model.liAbsenteesList.Where(x => x.COURSE_ID == CourseItem.COURSE_ROOT_ID && x.ATTENDENCE_DATE == item.DAY_ORDER_DATE && x.STUDENT_ID==Studentitem.STUDENT_ID).ToList();
                                                                                            if (liAbsentList != null && liAbsentList.Count > 0)
                                                                                            {
                                                                                                sAbsentCount = liAbsentList.FirstOrDefault().ABSENT_COUNT;
                                                                                            }
                                                                                        }
                                                                                        if (Model.liHours != null && Model.liHours.Count > 0)
                                                                                        {
                                                                                            var liTotalHours = Model.liHours.Where(x => x.COURSE_ID == CourseItem.COURSE_ROOT_ID && x.DAY_ORDER_DATE == item.DAY_ORDER_DATE && x.STUDENT_ID == Studentitem.STUDENT_ID).ToList();
                                                                                            if (liTotalHours != null && liTotalHours.Count > 0)
                                                                                            {
                                                                                                sHourCount = liTotalHours.FirstOrDefault().HOURS_COUNT;
                                                                                            }
                                                                                        }

                                                                                        if (!string.IsNullOrEmpty(sHourCount))
                                                                                        {
                                                                                            if (!string.IsNullOrEmpty(sAbsentCount))
                                                                                            {
                                                                                                <i class="text-danger"> @sAbsentCount <br />--<br /> @sHourCount</i>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <i> @sHourCount <br />--<br /> @sHourCount</i>
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            </td>
                                                                                    }
                                                                                    else if (item.DAY_NAME == "SUNDAY")
                                                                                    {
                                                                                        <td class="text-success">S</td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="text-primary">H</td>
                                                                                            }
                                                                                        }
                                                                                    }
                                                            </tr>

                                                                                        }
                                                                                    }
                                                }
                                            </tbody>
                                        </table>
                                                                                    }
                                }




                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        }
    }
}


<div class="form-group">
    <pre>H - HOLIDAY , S - SUNDAY , <b>Absent Days Marked As Red Color</b></pre>
</div>
