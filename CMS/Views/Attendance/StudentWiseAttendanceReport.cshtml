@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    ViewBag.Title = "StudentWiseAttendanceReport";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}



    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active">Student Wise Attendance Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Wise Attendance Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Wise Attendance Report</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">
                <div class="form-group">
                    

                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.StudentList, "Student", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                            @Html.ValidationMessageFor(m => m.StudentList, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="col-md-3 control-label"> Date </label>
                        <div class="input-group date" id="datetimepicker1">
                            @Html.Editor("txtDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                        </div>
                    </div>

                    <div class="col-md-1">
                        <button class="btn btn-primary" id="btnGet"> Get </button>
                    </div>

                    <div class="col-md-1">
                        <button class="btn btn-success hidden" onclick="printDiv()" id="btnPrint"> Print </button>
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="invoice-company text-center hidden" id="txtHead">@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME ,<small>ATTENDANCE REPORT</small></div>
                    <div id="dvAttendanceReport"></div>
                </div>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        // $('.selectpicker').selectpicker('refresh');
        $("#txtDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });

        $('#ClassList').on('change', function ()
        {
            if ($('#ClassList').val())
            {
                $.ajax({
                    url:'@Url.Action("FetchStudentByClassId", "Attendance")',
                    method:'POST',
                    datatype:'json',
                    data: { sClassId: $('#ClassList').val() },
                    success: function (data)
                    {
                        $('#StudentList').empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#StudentList').append(data.sResult);
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        });
        // Get Attendance Report By Date And Student Id & Class...
        $('#btnGet').on('click', function ()
        {
            if ($('#ClassList').val() && $('#StudentList').val() && $("#txtDate").val())
            {
                $.ajax({
                    url:'@Url.Action("BindStuentsForAttendanceReport", "Attendance")',
                    method: 'POST',
                    datatype:'json',
                    data: { sClassId: $('#ClassList').val(), sStudentId: String($('#StudentList').val()), sDate: $("#txtDate").val() },
                    success: function (data)
                    {
                        $('#dvAttendanceReport').empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#dvAttendanceReport').append(data);
                            if ($('#HdCount').val())
                            {
                                $('#txtHead').removeClass('hidden');
                                $('#btnPrint').removeClass('hidden');
                            }
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            } else
            {
                alert('Please Select All The Fileds');
            }
        });

        function printDiv()
        {
            var printContents = document.getElementById('dvAttendanceReport').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            loadContent('/Attendance/StudentWiseAttendanceReport');
        }
    </script>






