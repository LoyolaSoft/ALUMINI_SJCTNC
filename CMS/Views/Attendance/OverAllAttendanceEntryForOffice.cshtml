@model CMS.ViewModel.ViewModel.AttendanceViewModel
@using CMS.Utility;

@{
    ViewBag.Title = "Over All Attendance";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active">Absentees Entry</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Absentees Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Absentees Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group  col-md-12">
                        <div class="col-md-3">
                            @Html.Label("Date", htmlAttributes: new { @class = "col-md-4 control-label p-l-0 " })
                            <div class="col-md-8">
                                @Html.Editor("AttendanceDate", new { htmlAttributes = new { @class = "form-control", placeholder = "Select Date " } })
                            </div>
                        </div>
                        <div class="col-md-3">
                            @Html.Label("Shift", htmlAttributes: new { @class = "col-md-4 control-label p-l-0  " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.shifts, new SelectList(Model.shifts, Common.SUP_SHIFT.SHIFT_ID, Common.SUP_SHIFT.SHIFT_NAME), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>

                        </div>
                        <div class="col-md-3">
                            @Html.Label("Department ", htmlAttributes: new { @class = "col-md-4 control-label p-l-0  " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Departments, new SelectList(Model.Departments, Common.CP_DEPARTMENT_2017.DEPARTMENT_ID, Common.CP_CLASSES_2017.DEPARTMENT), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            <label class="col-md-4">Class list</label>
                            <div class="col-md-8">

                                <select id="Classes" class="form-control    selectpicker show-menu-arrow show-tick">
                                </select>

                            </div>
                        </div>
                    </div>
                </div>


                <div id="divAttendanceEntry" class="row col-lg-12"></div>
                <div class="col-lg-12">
                    <a href="#" class="btn-success btn disabled " id="btnSubmit">Submit</a>
                </div>
            }

        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

@*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>*@
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    $(document).ready(function () {        // Document Ready Function .
        $("#AttendanceDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "down bottom",
            zIndexOffset: '15',
            defaultDate: new Date()
        });
        $('.selectpicker').selectpicker({
            size: 4
        });

    
    });

    $("#shifts").on("change", function ()
{
        FetchClassList()
    });
    $("#Departments").on("change", function () {
        FetchClassList()
    });

                function FetchClassList() {
                var Shift = String($("#shifts").val());
                    var Department = String($("#Departments").val());

                    if ($("#Departments").val() && $("#shifts").val())
                    {
                        $.ajax({
                            url: "@Url.Action("FetchClassByshiftandDepartmentIDAttEntry", "Attendance")",
                            method: "POST",
                            datatype: "html",
                            data: { shift: Shift, sdepart: Department },
                            success: function (data) {
                                var select = $("#Classes");
                                select.empty();
                                if (data.sResult != null && data.sResult != '') {
                                    select.append(data.sResult);
                                } else {
                                    alert(data.Message);
                                }
                                $('#Classes').selectpicker('refresh');
                            }, error: function (error) {
                                alert('Internal Server Error ...!');
                            }
                        });
                    }
    }


        $('#AttendanceDate').change(function ()
        {
            $("#Classes").val($("#Classes option:first").val());
            $('.selectpicker').selectpicker('refresh');
        });



        $('#Classes').on('change', function ()
        {
            BindAttendance();
        });

        $('#btnSubmit').on('click', function ()
        {
             
            var Search = $('input[type="search"]').val();
            if (Search != '') {
                alert('Please Clear the Search Box !...');
                return false;
            }
            var flag = false;
            var DateForAttendance = $('#AttendanceDate').val();
            var sJson = '{"ATT_ABSENTEE_LIST":[';
            $('#tblAttendance tbody tr').each(function ()
            {
             
                var AttendanceId;
                var StudentId;
                var SClassId;
                var Authorized;
                var sSplAttendanceType = $('#ReasonList').val();
                var AttendanceDate = $(this).attr("cms-date");
                StudentId = $(this).attr('cms-student-id');
                AttendanceId = $(this).attr('cms-attendance-id');
                var attendanceType = $('#attendanceType_' + StudentId + ':checked').val();
                if (attendanceType == null || attendanceType == undefined) {
                    attendanceType = 2;
                }
                SClassId = $(this).attr('cms-s-class-id');
                var chkBox = $(this).find('input[type="checkbox"]');
                if ($(this).find('#attendanceType option:selected').text().toLowerCase() != 'Present'.toLowerCase() || AttendanceId != '') {
                    sJson += '{"ENTRY_DATE":"' + AttendanceDate + '","ATTENDENCE_DATE":"' + DateForAttendance + '","ATTENDANCE_ID":"' + $(this).attr('cms-attendance-id') + '","STUDENT_ID":"' + StudentId + '","CLASS_ID":"' + $('#hdClassId').val() + '","S_CLASS_ID":"' + SClassId + '","ATTENDANCE_TYPE_ID":"' + attendanceType + '","REASON_ID":"' + $(this).find('#reason option:selected').val() + '"},'
                    flag = true;
                }
            });

            if (flag) {
                sJson = sJson.slice(0, -1) + ']}';

                    var ClassList = $('#Classes').val();
                    $.ajax({
                        url: '@Url.Action("CommonAttendanceEntryForOffice", "Attendance")',
                        method:'POST',
                        datatype:'json',
                        data: { sJsonString: sJson, sClassId: ClassList },
                        success: function (data) {
                            //alert(objResult.ErrorCode + '\n' + objResult.Message);
                            //alert('Successful request,Please verify Absentees list !!');
                            //BindAttendance();
                            if (data.ErrorCode == "200")
                            {
                                alert(data.sResult + " " + 'Successful request,Please verify Absentees list !!');
                                BindAttendance();
                            }
                            else
                            {
                                alert(data.sResult + " " + data.Message);
                            }
                        },
                        error: function (xhr, textStatus, error) {
                            alert(error + "\n");
                            $('#btnSubmit').addClass("disabled");
                        }

                    });
            } else {
                return false;
            }

        });


        function BindAttendance()
        {
            $('#divAttendanceEntry').empty();
            $('#btnSubmit').removeClass("disabled");
            if ($('#Classes').val())
            {
                var objInputs = '{"Flag":"' + $("input[type='radio']:checked").val() + '","AttendanceDate":"' + $('#AttendanceDate').val() + '","ClassId":"' + $('#Classes').val() + '" }';
                $.ajax({
                    url: "@Url.Action("LoadStudentsForOverAllAttendanceEntry", "Attendance")",
                    method: 'POST',
                    datatype: 'json',
                    data: { objInput: objInputs },
                    success: function (sResult) {
                        $('#divAttendanceEntry').empty();
                        $('#divAttendanceEntry').append(sResult);
                        $('#divAttendanceEntry').show();
                        $('#tblAttendance').DataTable({ "bPaginate": false});
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n" + xhr + "\n" + textStatus);
                        $('#btnSubmit').addClass("disabled");
                    }
                });
            }
        }

        function validation() {

            return true;
        }
        HideOrShow = function () {
            if (rbtnCommon.checked == true) {
                $('#divClass').hide();
                $('#divStaff').show();
                $('#divAttendanceEntry').hide();
                $('#AttendanceDate').val('');
                $('#divReason').addClass('hidden');
                $('.selectpicker').selectpicker('refresh');
                $("#staffList").selectpicker('refresh');
                $('#HoursList').selectpicker('refresh');
                $('#divHours').removeClass('hidden');
            }
            if (rbtnSpecial.checked == true) {
                $('#divClass').removeClass('hidden');
                $('#divHours').addClass('hidden');
                $('#divReason').removeClass('hidden');
                $('#divClass').show();
                $('#divStaff').hide();
                $('#divAttendanceEntry').hide();
                $('#AttendanceDate').val('');

            }
        }
        $('#AttendanceDate').on('change', function () {
            var AttendanceDate = $('#AttendanceDate').val();
            if (rbtnSpecial.checked == true && AttendanceDate != '') {
                FetchDayOrder(AttendanceDate);
            }
        });

    $(document).ready(function () {
        // Function to update counts based on checkbox state
        function updateAttendanceCounts() {
            let checkedCount = 0;
            let uncheckedCount = 0;

            $('#tblAttendance tbody tr').each(function () {
                const checkbox = $(this).find('input[type="checkbox"]');
                if (checkbox.is(':checked')) {
                    checkedCount++;
                } else {
                    uncheckedCount++;
                }
            });

            // Update the UI with the counts
            $('#checkedCount').text(checkedCount);
            $('#uncheckedCount').text(uncheckedCount);
        }

        // Event listener for checkbox changes
        $(document).on('change', '#tblAttendance input[type="checkbox"]', function () {
            updateAttendanceCounts(); // Call the update function on change
        });

        // Initial count on page load
        updateAttendanceCounts();
    });
</script>
