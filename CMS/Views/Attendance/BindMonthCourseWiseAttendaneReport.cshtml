@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    Layout = null;

    int nDaysCount = 0;
    //int nCount = 0;
    string sBackWordSlash = "/";
   // string sAbsent = "A =";
  //  string sHours = "T =";
}

<div class="form-group table-responsive"> 

    @{
        if (Model.liHours != null && Model.liHours.Count > 0)
        {
            if (Model.liCalender != null && Model.liCalender.Count > 0)
            {
                nDaysCount = Model.liCalender.Count;
            }
            <table class="table table-bordered">
                <thead>
                    <tr>
                        @{
                            if (nDaysCount != 0)
                            {
                                @*<th>#</th>*@
                                <th>Course</th>
                                for (int i = 1; i <= nDaysCount; i++)
                                {
                                    <th>@i</th>
                                }
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.liStudent != null && Model.liStudent.Count > 0)
                        {
                            foreach (var StudentItem in Model.liStudent)
                            {
                                <tr>
                                    @*<td>@{nCount++;} @nCount</td>*@
                                    <td>@StudentItem.REGISTER_NO</td>
                                    @if (Model.liCalender != null && Model.liCalender.Count > 0)
                                    {
                                        foreach (var item in Model.liCalender)
                                        {

                                            if (item.IS_HOLIDAY != "1")
                                            {
                                                <td>
                                                    @{
                                                        if (Model.liAbsenteesList != null && Model.liAbsenteesList.Count > 0)
                                                        {
                                                            var liAbsentList = Model.liAbsenteesList.Where(x => x.STUDENT_ID == StudentItem.STUDENT_ID && x.ATTENDENCE_DATE == item.DAY_ORDER_DATE).ToList();
                                                            if (liAbsentList != null && liAbsentList.Count > 0)
                                                            {
                                                                @liAbsentList.FirstOrDefault().ABSENT_COUNT @sBackWordSlash
                                                            }
                                                        }
                                                        if (Model.liHours != null && Model.liHours.Count > 0)
                                                        {
                                                            var liTotalHours = Model.liHours.Where(x => x.DAY_ORDER_DATE == item.DAY_ORDER_DATE).ToList();
                                                            if (liTotalHours != null && liTotalHours.Count > 0)
                                                            {
                                                                @liTotalHours.FirstOrDefault().HOURS_COUNT
                                                            }
                                                        }
                                                    }
                                                </td>
                                                        }
                                                        else if (item.DAY_NAME == "SUNDAY")
                                                        {
                                                            <td>S</td>
                                                        }
                                                        else
                                                        {
                                                            <td>H</td>
                                                                }
                                                            }
                                                        }
                                </tr>

                                                            }
                                                        }
                    }
                </tbody>
            </table>
                                                        }
    }

    <div class="row">
        @*<label class="control-label col-md-2">Note : </label><br />*@
        <label class="control-label col-md-2">H - HOLIDAY </label>
        <label class="control-label col-md-2">S - SUNDAY </label>
        @*<label class="control-label col-md-2">A - ABSENT </label>
        <label class="control-label col-md-2">T - TOTAL HOUR </label>*@
    </div>
</div>