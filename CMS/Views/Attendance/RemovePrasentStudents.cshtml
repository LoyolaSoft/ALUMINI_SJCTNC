@model CMS.ViewModel.ViewModel.StaffViewModel

@{ 
    Layout = null;
    int count = 0;
}

<div class="table-responsive">
    <table class="table table-bordered table-hover" id="tblAttendance">
        <thead>
            <tr>
                <th>#</th>
                <th></th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>First Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.liStudentList)
            {
            <tr cms-student-id="@student.STUDENT_ID">
                <td>@{count++;}@count</td>
                <td>
                    <div class="checkbox checkbox-css">
                        <input type="checkbox" id="@student.STUDENT_ID" name="rbtnAbsentees" checked />
                        <label for="@student.STUDENT_ID"></label>
                    </div>
                </td>
                <td>@student.ROLL_NO</td>
                <td>@student.REGISTER_NO</td>
                <td>@student.FIRST_NAME</td>
            </tr>
            }
        </tbody>
    </table>
</div>