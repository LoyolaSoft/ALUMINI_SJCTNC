@model CMS.ViewModel.ViewModel.AttendanceViewModel
@using CMS.Utility;

@{
    ViewBag.Title = "Over All Attendance";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active">Absentees Entry</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Absentees Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Absentees Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        <div class="col-md-9 p-l-25">
                            <div class="radio radio-css radio-inline radio-primary">
                                <input type="radio" name="radioInlineCss" id="rbtnCommon" onchange="HideOrShow()" value="1" checked>
                                <label for="rbtnCommon">
                                    Common Attendance
                                </label>
                            </div>
                            <div class="radio radio-css radio-inline radio-success m-l-5">
                                <input type="radio" name="radioInlineCss" id="rbtnSpecial" onchange="HideOrShow()" value="2">
                                <label for="rbtnSpecial">
                                    Student Attendance
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group  col-md-12">
                        <div class="col-md-3">
                            @Html.Label("Date", htmlAttributes: new { @class = "col-md-4 control-label p-l-0 " })
                            <div class="col-md-8">
                                @Html.Editor("AttendanceDate", new { htmlAttributes = new { @class = "form-control", placeholder = "Select Date " } })
                            </div>
                        </div>
                        <div class="col-md-3">
                            @Html.Label("Shift", htmlAttributes: new { @class = "col-md-4 control-label p-l-0  " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.shifts, new SelectList(Model.shifts, Common.SUP_SHIFT.SHIFT_ID, Common.SUP_SHIFT.SHIFT_NAME), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>

                        </div>
                        <div class="col-md-3">
                            @Html.Label("Department ", htmlAttributes: new { @class = "col-md-4 control-label p-l-0  " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Departments, new SelectList(Model.Departments, Common.CP_DEPARTMENT_2017.DEPARTMENT_ID, Common.CP_CLASSES_2017.DEPARTMENT), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>

                        </div>
                        <div class="form-group col-md-3">
                            <label class="col-md-4">Class list</label>
                            <div class="col-md-8">

                                <select id="Classes" class="form-control    selectpicker show-menu-arrow show-tick">
                                   
                                </select>

                            </div>
                        </div>
                        @*<div class="col-md-3">
                                @Html.Label("Class List", htmlAttributes: new { @class = "col-md-4 control-label p-l-0  " })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.Classes, new SelectList(Model.Classes, Common.CP_CLASSES_2017.CLASS_ID, Common.CP_CLASSES_2017.CLASS_NAME), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>

                            </div>*@
                        <div class="col-md-3" id="divStaff">
                            @Html.Label("Staff List", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                            <div class="col-md-8">
                                @Html.DropDownList("staffList", (Model.staffList != null) ? new SelectList(Model.staffList, Common.STF_PERSONAL_INFO.STAFF_ID, Common.STF_PERSONAL_INFO.FIRST_NAME) : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>

                        <div class="col-md-3" id="divHours">
                            @Html.Label("Hours", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                            <div class="col-md-8">
                                @Html.DropDownList("HoursList", (Model.hourList != null) ? new SelectList(Model.hourList, Common.SUP_HOURS.HOUR_ID, Common.SUP_HOURS.HOUR) : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "selectpicker form-control show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>

                        </div>
                        @*<div class="col-md-3 hidden" id="divReason">
                                @Html.Label("Reason", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                                <div class="col-md-8">
                                    @Html.DropDownList("ReasonList", new SelectList(Model.SplAttendanceType, Common.SUP_SPL_ATTENDANCE_TYPE.SPL_ATTENDANCE_TYPE_ID, Common.SUP_SPL_ATTENDANCE_TYPE.SPL_ATTENDANCE_TYPE), "---Select---", new { @class = "selectpicker form-control show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>

                            </div>*@
                    </div>
                </div>


                <div id="divAttendanceEntry" class="row col-lg-12"></div>
                <div class="col-lg-12">
                    <a href="#" class="btn-success btn disabled " id="btnSubmit">Submit</a>
                </div>
            }

        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

@*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>*@
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>


    $("#shifts").on("change", function ()
{
        FetchClassList()
    });
    $("#Departments").on("change", function () {
        FetchClassList()
    });

                function FetchClassList() {
                var Shift = String($("#shifts").val());
                    var Department = String($("#Departments").val());

                    if ($("#Departments").val() && $("#shifts").val())
                    {
                        $.ajax({
                            url: "@Url.Action("FetchClassByshiftandDepartmentIDAttEntry", "Attendance")",
                            method: "POST",
                            datatype: "html",
                            data: { shift: Shift, sdepart: Department },
                            success: function (data) {
                                var select = $("#Classes");
                                select.empty();
                                if (data.sResult != null && data.sResult != '') {
                                    select.append(data.sResult);
                                } else {
                                    alert(data.Message);
                                }
                                $('#Classes').selectpicker('refresh');
                            }, error: function (error) {
                                alert('Internal Server Error ...!');
                            }
                        });
                    }
    }
        function ContentLoad()
        {
            // Document Ready Function .
            $("#AttendanceDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "down bottom",
                zIndexOffset: '15',
                defaultDate: new Date()
            });
            $('.selectpicker').selectpicker({
                size: 4
            });

        }

        $('#rbtnCommon').on('click', function ()
        {
            $('#divHours').show();
        });
        $('#rbtnSpecial').on('click', function ()
        {
            $('#divHours').hide();
        });

        $('#AttendanceDate').change(function ()
        {
            $("#staffList").val($("#staffList option:first").val());
            $("#HoursList").val($("#HoursList option:first").val());
            $("#Classes").val($("#Classes option:first").val());
            $('.selectpicker').selectpicker('refresh');
        });
        $('#HoursList').change(function ()
        {
            if ($('#HoursList').val())
            {
                if (rbtnCommon.checked == true)
                {
                    var AttendanceDate = $('#AttendanceDate').val();
                    var staffList = $('#staffList').val();
                    if (AttendanceDate != '' && staffList != '')
                    {
                        BindAttendance();
                    }
                    else
                    {
                        alert('Please Select All The Options !');
                        $("#HoursList").val($("#HoursList option:first").val());
                        $('.selectpicker').selectpicker('refresh');
                    }
                }
            }
        });

        $('#staffList').on('change', function ()
        {
            var AttendanceDate = $('#AttendanceDate').val();
            var StaffId = $('#staffList').val();
            var vClassId = $('#Classes').val();
            if (AttendanceDate != '')
            {
                $.ajax({
                    url: "@Url.Action("FetchHoursByStaffIdAndDate", "Attendance")",
                    method: 'POST',
                    datatype: 'json',
                    data: { sAttendanceDate: AttendanceDate, sStaffId: StaffId ,sClassId:vClassId},
                    success: function (objResult)
                    {
                        $('#HoursList').empty();
                        $("#HoursList").append('<option value="">-- select --</option>' + objResult.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error)
                    {
                        alert(error + "\n" + xhr + "\n" + textStatus);
                    }
                });
            }
            else
            {
                alert('Please Choose All The Options !');
                $("#staffList").val($("#staffList option:first").val());
            }
            $('.selectpicker').selectpicker('refresh');
        });

        $('#Classes').on('change', function ()
        {
            // Load Student By Class .....
            if (rbtnSpecial.checked == true)
            {
                var AttendanceDate = $('#AttendanceDate').val();
                var ClassList = $('#Classes').val();
                if (AttendanceDate != '' && ClassList != '')
                {
                    BindAttendance();
                }
                else
                {
                    alert('Please Select All The Options !');
                    $("#HoursList").val($("#HoursList option:first").val());
                   // $('.selectpicker').selectpicker('refresh');
                }
            } else
            {
                // Load Staff By Class ....
                $.ajax({
                    url: '@Url.Action("FetchStaffByClass", "Attendance")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sClassId: $('#Classes').val() },
                    success: function (data)
                    {
                        $("#staffList").empty();
                        if (data.ErrorCode == "200")
                        {
                            $("#staffList").append('<option value=0> -- Select -- </option>' + data.sResult);
                            $('.selectpicker').selectpicker('refresh');
                        }
                        else
                        {
                            alert(data.Message);
                        }

                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
            $('.selectpicker').selectpicker('refresh');
        });
        //$('#ReasonList').on('change', function () {
        //    var AttendanceDate = $('#AttendanceDate').val();
        //    var HourList = $('#HoursList').val();
        //    var ReasonList = $('#ReasonList').val();
        //    if (HourList != '' && AttendanceDate != '' && ReasonList!='') {
        //        BindAttendance();
        //    }
        //    else
        //        return false;
        //});
        //$('#Classes').on('change', function () {
        //    var AttendanceDate = $('#AttendanceDate').val();
        //    var HourList = $('#HoursList').val();
        //    if (AttendanceDate != '' && HourList!='') {
        //        BindAttendance();
        //    }
        //    else
        //        return false;
        //});
        $('#btnSubmit').on('click', function ()
        {
            var Search = $('input[type="search"]').val();
            if (Search != '') {
                alert('Please Clear the Search Box !...');
                return false;
            }
            var flag = false;
            var DateForAttendance = $('#AttendanceDate').val();
            var sJson = '{"ATT_ABSENTEE_LIST":[';
            $('#tblAttendance tbody tr').each(function ()
            {
                var AttendanceId;
                var StudentId;
                var SClassId;
                var Authorized;
                var sSplAttendanceType = $('#ReasonList').val();
                var AttendanceDate = $(this).attr("cms-date");
                var StaffId = $('#staffList').val();
                StudentId = $(this).attr('cms-student-id');
                AttendanceId = $(this).attr('cms-attendance-id');
                SClassId = $(this).attr('cms-s-class-id');
                var chkBox = $(this).find('input[type="checkbox"]');
                if ($(this).find('#attendanceType option:selected').text().toLowerCase() != 'Present'.toLowerCase() || AttendanceId != '') {
                    sJson += '{"ENTRY_DATE":"' + AttendanceDate + '","STAFF_ID":"' + StaffId + '","ENTRY_ID":"' + StaffId + '","ATTENDENCE_DATE":"' + DateForAttendance + '","ATTENDANCE_ID":"' + $(this).attr('cms-attendance-id') + '","COURSE_ID":"' + $('#hdCourseId').val() + '","HOUR_FROM":"' + $('#HoursList').val() + '","HOUR_TO":"' + $('#HoursList').val() + '","STUDENT_ID":"' + StudentId + '","CLASS_ID":"' + $('#hdClassId').val() + '","S_CLASS_ID":"' + SClassId + '","ATTENDANCE_TYPE_ID":"' + $(this).find('#attendanceType option:selected').val() + '","REASON_ID":"' + $(this).find('#reason option:selected').val() + '","SPL_ATTENDANCE_TYPE_ID":"' + sSplAttendanceType + '"},'
                    flag = true;
                }
            });

            if (flag) {
                sJson = sJson.slice(0, -1) + ']}';
                if (rbtnCommon.checked == true) {
                    $.ajax({
                        url: '@Url.Action("AttendanceEntry", "Attendance")',
                        method:'POST',
                        datatype:'json',
                        data: { sJsonString: sJson },
                        success: function (data)
                        {
                            //alert(objResult.ErrorCode + '\n' + objResult.Message);
                            if (data.ErrorCode=="200")
                            {
                                alert(data.sResult + " " + 'Successful request,Please verify Absentees list !!');
                                BindAttendance();
                            }
                            else {
                                alert(data.sResult + " " + data.Message);
                            }
                        },
                        error: function (xhr, textStatus, error) {
                            alert(error + "\n");
                            $('#btnSubmit').addClass("disabled");
                        }

                    });
                }
                else {
                    var ClassList = $('#Classes').val();
                    $.ajax({
                        url: '@Url.Action("CommonAttendanceEntry", "Attendance")',
                        method:'POST',
                        datatype:'json',
                        data: { sJsonString: sJson, sClassId: ClassList },
                        success: function (data) {
                            //alert(objResult.ErrorCode + '\n' + objResult.Message);
                            //alert('Successful request,Please verify Absentees list !!');
                            //BindAttendance();
                            if (data.ErrorCode == "200")
                            {
                                alert(data.sResult + " " + 'Successful request,Please verify Absentees list !!');
                                BindAttendance();
                            }
                            else
                            {
                                alert(data.sResult + " " + data.Message);
                            }
                        },
                        error: function (xhr, textStatus, error) {
                            alert(error + "\n");
                            $('#btnSubmit').addClass("disabled");
                        }

                    });
                }
            } else {
                return false;
            }

        });


        function BindAttendance()
        {
            $('#divAttendanceEntry').empty();
            $('#btnSubmit').removeClass("disabled");
            var sHourId = $('#HoursList').val();
            var sCourseId = $('#HoursList Option:selected').attr('cms-sCourseId');
            var sSemesterId = $('#HoursList Option:selected').attr('cms-sSemesterId');
            if ($('#Classes').val())
            {
                var objInputs = '{"Flag":"' + $("input[type='radio']:checked").val() + '","AttendanceDate":"' + $('#AttendanceDate').val() + '","ClassId":"' + $('#Classes').val() + '","HourId":"' + sHourId + '","StaffId":"' + $('#staffList').val() + '","courseId":"' + sCourseId + '","semesterId":"' + sSemesterId + '" }';
                $.ajax({
                    url: "@Url.Action("LoadStudentsForOverAll", "Attendance")",
                    method: 'POST',
                    datatype: 'json',
                    data: { objInput: objInputs },
                    success: function (sResult) {
                        $('#divAttendanceEntry').empty();
                        $('#divAttendanceEntry').append(sResult);
                        $('#divAttendanceEntry').show();
                        $('#tblAttendance').DataTable({ "bPaginate": false});
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n" + xhr + "\n" + textStatus);
                        $('#btnSubmit').addClass("disabled");
                    }
                });
            }
        }

        function validation() {

            return true;
        }
        HideOrShow = function () {
            if (rbtnCommon.checked == true) {
                $('#divClass').hide();
                $('#divStaff').show();
                $('#divAttendanceEntry').hide();
                $('#AttendanceDate').val('');
                $('#divReason').addClass('hidden');
                $('.selectpicker').selectpicker('refresh');
                $("#staffList").selectpicker('refresh');
                $('#HoursList').selectpicker('refresh');
                $('#divHours').removeClass('hidden');
            }
            if (rbtnSpecial.checked == true) {
                $('#divClass').removeClass('hidden');
                $('#divHours').addClass('hidden');
                $('#divReason').removeClass('hidden');
                $('#divClass').show();
                $('#divStaff').hide();
                $('#divAttendanceEntry').hide();
                $('#AttendanceDate').val('');

            }
        }
        $('#AttendanceDate').on('change', function () {
            var AttendanceDate = $('#AttendanceDate').val();
            if (rbtnSpecial.checked == true && AttendanceDate != '') {
                FetchDayOrder(AttendanceDate);
            }
        });
        function FetchDayOrder(AttendanceDate) {
            $.ajax({
                url: "@Url.Action("FetchDayOrderByDate", "Attendance")",
                method: 'POST',
                datatype: 'json',
                data: { sAttendanceDate: AttendanceDate },
                success: function (objResult) {
                    if (objResult.sResult != null) {
                        $('#divHours').removeClass('hidden');
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n" + xhr + "\n" + textStatus);
                }
            });
        }
</script>
