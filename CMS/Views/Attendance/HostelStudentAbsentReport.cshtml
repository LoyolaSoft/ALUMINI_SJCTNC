@model CMS.ViewModel.ViewModel.AttendanceViewModel
@{
    ViewBag.Title = "HostelStudentAbsentReport";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Attendance</a></li>
        <li class="active">Hostel Student Absent Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Hostel Student Absent Report</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Hostel Student Absent Report</h4>
        </div>

        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>

            <div class="col-md-12 form-horizontal">
                <ul class="nav nav-tabs">
                    <li class="nav-items active" id="tabDaywise">
                        <a href="#daywisePane" data-toggle="tab" class="nav-link active">
                            <span>Day Wise Absentee List</span>
                        </a>
                    </li>
                    <li class="nav-items" id="tabDatewise">
                        <a href="#datewisePane" data-toggle="tab" class="nav-link">
                            <span>Date Wise Absentee List</span>
                        </a>
                    </li>
                    <li class="nav-items" id="tabOverall">
                        <a href="#overallPane" data-toggle="tab" class="nav-link">
                            <span>Overall Absentee List</span>
                        </a>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Day Wise Tab -->
                    <div class="tab-pane fade active in" id="daywisePane">
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Academic Year</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("AcademicYearDay", (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick AcYearList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Semester Type</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("SemesterTypeDay", (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick SemTypeList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Shift</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("ShiftDay", (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control selectpicker show-menu-arrow show-tick ShiftList", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Hostel</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("HostelDay", (Model.HostelList != null) ? Model.HostelList : Enumerable.Empty<SelectListItem>(), "All Hostels", new { @class = "form-control selectpicker show-menu-arrow show-tick HostelList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Date</label>
                                <div class="col-md-8">
                                    <div class="input-group">
                                        <input class="form-control date-picker" id="txtDayDate" placeholder="Pick Date" autocomplete="off" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-right">
                                <button class="btn btn-sm btn-primary" onclick="GetReport('daywise')"> Get </button>
                                <button class="btn btn-sm btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                <button class="btn btn-sm btn-primary btnExport hidden" onclick="Export()"> Export </button>
                            </div>
                        </div>
                    </div>

                    <!-- Date Wise Tab -->
                    <div class="tab-pane fade" id="datewisePane">
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Academic Year</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("AcademicYearDate", (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick AcYearList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Semester Type</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("SemesterTypeDate", (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick SemTypeList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Shift</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("ShiftDate", (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control selectpicker show-menu-arrow show-tick ShiftList", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Hostel</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("HostelDate", (Model.HostelList != null) ? Model.HostelList : Enumerable.Empty<SelectListItem>(), "All Hostels", new { @class = "form-control selectpicker show-menu-arrow show-tick HostelList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Start Date</label>
                                <div class="col-md-8">
                                    <div class="input-group">
                                        <input class="form-control date-picker" id="txtStartDate" placeholder="Pick Start Date" autocomplete="off" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">End Date</label>
                                <div class="col-md-8">
                                    <div class="input-group">
                                        <input class="form-control date-picker" id="txtEndDate" placeholder="Pick End Date" autocomplete="off" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 text-right">
                                <button class="btn btn-sm btn-primary" onclick="GetReport('datewise')"> Get </button>
                                <button class="btn btn-sm btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                <button class="btn btn-sm btn-primary btnExport hidden" onclick="Export()"> Export </button>
                            </div>
                        </div>
                    </div>

                    <!-- Overall Tab -->
                    <div class="tab-pane fade" id="overallPane">
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Academic Year</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("AcademicYearOverall", (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick AcYearList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Semester Type</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("SemesterTypeOverall", (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick SemTypeList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Shift</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("ShiftOverall", (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control selectpicker show-menu-arrow show-tick ShiftList", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label class="control-label col-md-4">Hostel</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("HostelOverall", (Model.HostelList != null) ? Model.HostelList : Enumerable.Empty<SelectListItem>(), "All Hostels", new { @class = "form-control selectpicker show-menu-arrow show-tick HostelList", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-8 text-right">
                                <button class="btn btn-sm btn-primary" onclick="GetReport('overall')"> Get </button>
                                <button class="btn btn-sm btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                <button class="btn btn-sm btn-primary btnExport hidden" onclick="Export()"> Export </button>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="row m-t-15">
                    <div class="col-md-12 table-responsive">
                        <div id="dvAttendanceReport"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal to display specific absent dates -->
<div class="modal fade" id="modalAbsentDates" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <button type="button" class="close text-white" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title text-white" id="modalLabel">Absent Dates</h4>
            </div>
            <div class="modal-body text-center">
                <ul class="list-group" id="lstAbsentDates" style="max-height: 300px; overflow-y: auto;">
                    <!-- Dates will be loaded here via Ajax -->
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden inputs to track resolved semester duration dates in overall tab -->
<input type="hidden" id="overallStartDate" />
<input type="hidden" id="overallEndDate" />

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script>
    $(document).ready(function () {
        var activeAcademicYear = '@Session[CMS.Utility.Common.SESSION_VARIABLES.ACADEMIC_YEAR]';
        var activeSemesterType = '@Session[CMS.Utility.Common.SESSION_VARIABLES.ACTIVE_SEMESTER_TYPE]';

        if (activeAcademicYear != '') {
            $('.AcYearList').val(activeAcademicYear);
        }
        if (activeSemesterType != '') {
            $('.SemTypeList').val(activeSemesterType);
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');

        $('.date-picker').datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy"
        });

        // Hide buttons initially
        hidePrintExport();
    });

    function ContentLoad() {
        // dynamic load
    }

    $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
        hidePrintExport();
        $('#dvAttendanceReport').empty();
    });

    function hidePrintExport() {
        $('.btnPrint').addClass('hidden');
        $('.btnExport').addClass('hidden');
    }

    function GetReport(mode) {
        var acYear = "";
        var semType = "";
        var shift = "";
        var hostel = "";
        var startDate = "";
        var endDate = "";

        if (mode == "daywise") {
            acYear = $('#AcademicYearDay Option:selected').text();
            semType = $('#SemesterTypeDay').val();
            shift = String($('#ShiftDay').val());
            hostel = $('#HostelDay').val();
            startDate = $('#txtDayDate').val();
            endDate = startDate;

            if (!acYear || !semType || !shift || !startDate) {
                swal({ title: "Error !", text: "Please select Academic Year, Semester Type, Shift, and Date.", showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                return;
            }
        } 
        else if (mode == "datewise") {
            acYear = $('#AcademicYearDate Option:selected').text();
            semType = $('#SemesterTypeDate').val();
            shift = String($('#ShiftDate').val());
            hostel = $('#HostelDate').val();
            startDate = $('#txtStartDate').val();
            endDate = $('#txtEndDate').val();

            if (!acYear || !semType || !shift || !startDate || !endDate) {
                swal({ title: "Error !", text: "Please select Academic Year, Semester Type, Shift, Start Date, and End Date.", showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                return;
            }
        } 
        else if (mode == "overall") {
            acYear = $('#AcademicYearOverall Option:selected').text();
            semType = $('#SemesterTypeOverall').val();
            shift = String($('#ShiftOverall').val());
            hostel = $('#HostelOverall').val();

            if (!acYear || !semType || !shift) {
                swal({ title: "Error !", text: "Please select Academic Year, Semester Type, and Shift.", showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                return;
            }
        }

        $('#loader').show();
        $.ajax({
            url: '@Url.Action("BindHostelStudentAbsentReport", "Attendance")',
            method: 'POST',
            data: { sAcYear: acYear, sShiftId: shift, sStartDate: startDate, sEndDate: endDate, sHostelId: hostel, sSemesterType: semType, sMode: mode },
            success: function (data) {
                $('#loader').hide();
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'warning', animation: true });
                } else {
                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvAttendanceReport').empty();
                    $('#dvAttendanceReport').append(data);

                    // If overall, track the resolved dates from view bag inside hidden fields
                    if (mode == "overall") {
                        var resolvedStart = $('#resolvedStart').val();
                        var resolvedEnd = $('#resolvedEnd').val();
                        $('#overallStartDate').val(resolvedStart);
                        $('#overallEndDate').val(resolvedEnd);
                    }
                }
            },
            error: function (error) {
                $('#loader').hide();
                swal({ title: "Error !", text: "Failed to fetch report data.", showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
    }

    function ViewAbsentDates(studentId) {
        var mode = $('.nav-tabs li.active').attr('id');
        var acYear = "";
        var semType = "";
        var startDate = "";
        var endDate = "";

        if (mode == "tabOverall") {
            acYear = $('#AcademicYearOverall Option:selected').text();
            semType = $('#SemesterTypeOverall').val();
            startDate = $('#overallStartDate').val();
            endDate = $('#overallEndDate').val();
        } else if (mode == "tabDatewise") {
            acYear = $('#AcademicYearDate Option:selected').text();
            semType = $('#SemesterTypeDate').val();
            startDate = $('#txtStartDate').val();
            endDate = $('#txtEndDate').val();
        }

        if (acYear && semType && startDate && endDate) {
            $('#loader').show();
            $.ajax({
                url: '@Url.Action("FetchStudentAbsentDates", "Attendance")',
                method: 'POST',
                data: { sStudentId: studentId, sAcYear: acYear, sSemesterType: semType, sStartDate: startDate, sEndDate: endDate },
                success: function (data) {
                    $('#loader').hide();
                    var lst = $('#lstAbsentDates');
                    lst.empty();
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            lst.append('<li class="list-group-item"><b>' + item.ATTENDENCE_DATE + '</b></li>');
                        });
                    } else {
                        lst.append('<li class="list-group-item text-muted">No absent dates found</li>');
                    }
                    $('#modalAbsentDates').modal('show');
                },
                error: function (error) {
                    $('#loader').hide();
                    swal({ title: "Error !", text: "Failed to load absent dates.", showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                }
            });
        }
    }

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Attendance/HostelStudentAbsentReport');
    }

    function Export() {
        var title = "Hostel_Student_Absent_Report";
        let file = new Blob([$('#dvAttendanceReport').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
    }
</script>
