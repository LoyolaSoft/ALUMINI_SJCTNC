                            @Html.Label("Date", htmlAttributes: new { @class = "control-label col-md-3" })

                            <div class="col-md-9">
                                <div class="input-group">
                                    <input class="form-control date" id="txtDate" placeholder="Pick Date" />
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "shiftD" })
                            </div>
                        </div>

                        @*<div class="col-md-1">
                                <button class="btn btn-primary" id="btnGet" onclick="BindDayWiseAttendanceReport()"> Get </button>
                         </div>*@
                        <div class="col-md-1">
