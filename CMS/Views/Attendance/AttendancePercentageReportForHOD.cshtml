                    <li class="nav-items" id="bindgLackAttendancePercentage">
                        <a href="#bindLackPercentageReport" data-toggle="tab" class="nav-link ">
                            <span class="d-sm-none">Lack Attendance Percentage Report </span>
                        </a>
                    </li>

                    <li class="nav-items" id="bindNotAbsenteeList">
                        <a href="#bindNotAbsentee" data-toggle="tab" class="nav-link ">
                            <span class="d-sm-none">Not Absent Taken List </span>
                        </a>
                    </li>
                </ul>
                <div class="tab-content">

                    @*Day Wise Absentee's List*@

                    <div class="tab-pane fade" id="bindDaywiseAbsenteeReport">

