                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                        </div>
                    </div>


                    @*Overall Absentee List*@

                    <div class="tab-pane fade" id="bindDateWiseAbsenteeReport">
                        <div class="row">
                            <div class="col-md-12">

                                <div class="col-md-4 form-group">
                                    @Html.Label("Start Date", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-9">
                                        <div class="input-group">
                                            <input class="form-control date" id="startDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4 form-group">
                                    @Html.Label("EndDate", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-9">
                                        <div class="input-group">
                                            <input class="form-control date" id="endDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "AcYearddl" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-4 form-group">
                                    @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "Shiftddl" })
                                    </div>
                                </div>

                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindAbsentlistDateWise()"> Get </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                                </div>

                            </div>
                        </div>
                    </div>


                    @*Lack Attendance Percentage Report*@

                    <div class="tab-pane fade" id="bindLackPercentageReport">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-4 form-group">
                                    @Html.Label("Start Date", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        <div class="input-group">
                                            <input class="form-control date" id="LstartDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4 form-group">
                                    @Html.Label("EndDate", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-9">
                                        <div class="input-group">
                                            <input class="form-control date" id="LendDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "LAcYearddl" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-4 form-group">
                                    @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "LShiftddl" })
                                    </div>
                                </div>

                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindLackAttendancePercentage()"> Get </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*Not Absentee list *@
                    <div class="tab-pane fade " id="bindNotAbsentee">
                        <div class="row">
                            <div class="col-md-12">


                                <div class="col-md-4 form-group">
                                    @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "NAcYearddl" })
                                    </div>
                                </div>

                                <div class="col-md-4 form-group">
                                    @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "nShiftddl" })
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", id = "NClassList" })
                                        @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">

                                <div class="col-md-4 form-group">
                                    @Html.LabelFor(model => model.SemesterType, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">

                                        @Html.DropDownListFor(m => m.SemesterType, (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", id = "nSemesterType" })
                                        @Html.ValidationMessageFor(m => m.SemesterType, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindNotAbsenteeList()"> Get </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="form-group col-md-12">
                    <div id="dvAttendanceReport"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
