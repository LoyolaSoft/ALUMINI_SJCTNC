<script>
    $(document).ready(function () {
        $('#bindDaywiseAbsenteeReport').addClass("active in");
        $('.nav-items').on("click", function () {

            $('#dvAttendanceReport').html('');

        });
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
    });

    $("#CShiftddl").on("change", function ()
{
        FetchClassList()
    });
    $("#DepartmentList").on("change", function () {
        FetchClassList()
    });
    $("#IShiftddl").on("change", function () {
        FetchStudentList()
    });
    $("#IAcYearddl").on("change", function () {
        FetchStudentList()
    });
    $("#nShiftddl").on("change", function () {
        FetchClassListForNotAbsentee()
    });

     function FetchClassListForNotAbsentee()
    {

     var Shift = $("#nShiftddl").val();
     $.ajax({
         url:"@Url.Action("FetchClassByshiftID", "Attendance")",
         method: "POST",
         datatype: "html",
         data: { shift: Shift },
         success: function (data)
         {
             var select = $("#NClassList");
             select.empty();
             if (data.sResult != null && data.sResult != '')
             {
                 select.append( data.sResult);
             } else {
                 alert(data.Message);
             }
             $('#NClassList').selectpicker('refresh');
         },error:function(error)
         {
             alert('Internal Server Error ...!');
         }
     });
    }

</script>

<script>


    $('#AcYearddl').on('change', function () {
        BindAbsentlistDateWise();
    });

    $('#Shiftddl').on('change', function () {
        BindAbsentlistDateWise();
    });
    $('#LAcYearddl').on('change', function () {
        BindLackAttendancePercentage();
    });

    $('#LShiftddl').on('change', function () {
        BindLackAttendancePercentage();
    });
    $('#shiftD').on('change', function () {
        BindDayWiseAttendanceReport();
    });
    $('#txtDate').on('change', function () {
        BindDayWiseAttendanceReport();
    });
</script>

<script>
    function BindDayWiseAttendanceReport()
{
        if ($('#shiftD').val() && $('#txtDate').val()) {
            $.ajax({
                url: '@Url.Action("BindCommonAbsenteesListDayWiseForHOD", "Attendance")',
                method: 'POST',
                datatype: 'json',
                data: { sShiftId: $('#shiftD').val(), sDate: $('#txtDate').val() },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    } else {
                        $('.btnPrint').removeClass('hidden');
                        $('.btnExport').removeClass('hidden');
                        $('#dvAttendanceReport').empty();
                        $('#dvAttendanceReport').append(data);
                    }
                }, eror: function (error) {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }
            });
        }
       
}

    function BindAbsentlistDateWise()
{
        if ($('#AcYearddl').val() && $('#Shiftddl').val() && $('#startDate').val() && $('#endDate').val())
    {
        $.ajax({
            url:'@Url.Action("BindCommonAbsenteesListDateWiseForHOD", "Attendance")',
            method:'POST',
            datatype:'json',
            data: { sAcYear: $('#AcYearddl Option:selected').text(), sShiftId: $('#Shiftddl').val(), sStartDate: $('#startDate').val(), sEndDate: $('#endDate').val() },
            success: function (data)
            {
                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }else
                {
                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvAttendanceReport').empty();
                    $('#dvAttendanceReport').append(data);
                }
            }, eror: function (error)
            {
                swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
        }
       
    }
    function BindLackAttendancePercentage()
{
        if ($('#LAcYearddl').val() && $('#LShiftddl').val() && $('#LstartDate').val() && $('#LendDate').val())
    {
        $.ajax({
            url:'@Url.Action("LackAttendancePercentageReportHOD", "Attendance")',
            method:'POST',
            datatype:'json',
            data: { sAcYear: $('#LAcYearddl Option:selected').text(), sShiftId: $('#LShiftddl').val(), sStartDate: $('#LstartDate').val(), sEndDate: $('#LendDate').val() },
            success: function (data)
            {
                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }else
                {
                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvAttendanceReport').empty();
                    $('#dvAttendanceReport').append(data);
                }
            }, eror: function (error)
            {
                swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
        }
       
    }

    function BindNotAbsenteeList()
{
        if ($('#NAcYearddl').val() && $('#NClassList').val() && $('#nSemesterType').val())
    {
        $.ajax({
            url:'@Url.Action("BindCommonNotAbsenteesListClassWiseForHOD", "Attendance")',
            method:'POST',
            datatype:'json',
            data: { sAcYear: $('#NAcYearddl Option:selected').text(), classId: String($('#NClassList').val()), semestertype:$('#nSemesterType').val() },
            success: function (data)
            {
                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }else
                {
                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvAttendanceReport').empty();
                    $('#dvAttendanceReport').append(data);
                }
            }, eror: function (error)
            {
                swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
    }
  
}
</script>

<script>
    //$('#btnPrint').on('click', function () {
