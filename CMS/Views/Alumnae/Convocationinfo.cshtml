                                        <br />
                                        <span class="label label-inverse m-r-5" id="countdown"></span>
                                        var targetDate = Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD_END;
                                        <script>
       var targetDate = new Date('@targetDate');
      function updateCountdown() {
          var countdownElement = document.getElementById("countdown");
          if (!countdownElement) return;
           var now = new Date().getTime();
           var distance = targetDate - now;
           if (distance > 0) {
               var days = Math.floor(distance / (1000 * 60 * 60 * 24));
               var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
               var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
               var seconds = Math.floor((distance % (1000 * 60)) / 1000);
               if (days == "0" && hours == "0" && minutes == "0" && seconds == "0") {
                   document.getElementById("countdown").innerHTML = "Registration has ended!";
                   loadContent('/Alumnae/Convocationinfo');
               }
               else if (days == "0" && hours == "0" && minutes == "0") {
                   document.getElementById("countdown").innerHTML =
                       "Registration Ends in: " + seconds + " Sec";
               }
               else if (days == "0" && hours == "0") {
                   document.getElementById("countdown").innerHTML =
                       "Registration Ends in: " + minutes + " Min, " + seconds + " Sec";
               }
               else if (days == "0") {
                   document.getElementById("countdown").innerHTML =
                       "Registration Ends in: " + hours + " Hrs, " + minutes + " Min, " + seconds + " Sec";
               }
               else {
                   document.getElementById("countdown").innerHTML =
                       "Registration Ends in: " + days + " Days, " + hours + " Hrs, " + minutes + " Min, " + seconds + " Sec";
               }


           } else {
               document.getElementById("countdown").innerHTML = "Registration has ended!";
               loadContent('/Alumnae/Convocationinfo');
           }
       }
       setInterval(updateCountdown, 1000);
                                        </script>

                                    }

                                </center>
