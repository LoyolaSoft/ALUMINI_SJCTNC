                            <h4 class="">Convocation Registration (MBA Student Portal)</h4>

                        </center>
                        <div class=" mt-4" id="feedbackarea">

                            <div class="highlight-note">
                                @*<h3 class="text-decoration-underline">[Basic Info]</h3>*@

                                <h4><i class="fa fa-info-circle"></i> CONVOCATION NOTE:</h4>
                                <ol>
                                    <li>Candidates should be in their seats by <b>09.30 a.m.</b> in their convocation gowns.</li>
                                    <li>Register your confirmation of Participation through <b>ERP-Online</b> by paying an amount of <span class="price-info">Rs.@Model.liconvocationeligible.FirstOrDefault().REGISTRATION_AMOUNT/-</span></li>
                                    <li>Gown and Photo - <span class="price-info">Rs. 400/-</span> (Gown refundable Deposit <span class="price-info">Rs. 300/-</span>, Gown hire Charge <span class="price-info">Rs. 50/-</span> and Photo Charge <span class="price-info">Rs. 50/-</span>)</li>
                                    <li>For any clarifications kindly contact the college office</li>
                                </ol>
                                <center>
                                    @*<span class="label label-inverse m-r-5">NOTE!</span> Any submission with incorrect data or irrelevant files may be subject to review, and approval could be delayed.*@
                                    @if (@Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD_END != null || @Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD_END != "")
