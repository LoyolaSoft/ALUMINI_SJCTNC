                        </div>
                    }

                }
            }

            else if (Model.liStudentflag != null && Model.liStudentflag.Count > 0 && !string.IsNullOrEmpty(Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD))
            {
                <div class=" mt-4" id="feedbackarea">

                    @if (Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD != null || Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD != "")
                    {
                        <br />
                        <center>
                            <h3 class="label label-warning m-r-5" id="countdown" style="font-size: 100%;"></h3>
                        </center>
                        var targetDate = Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD;
                        <script>
                            var targetDate = new Date('@targetDate');
                            function updateCountdown() {
                                var now = new Date().getTime();
                                var distance = targetDate - now;

                                if (distance > 0) {
                                    var days = Math.floor(distance / (1000 * 60 * 60 * 24));
                                    var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                                    var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                                    var seconds = Math.floor((distance % (1000 * 60)) / 1000);
                                    if (days == "0" && hours == "0" && minutes == "0" && seconds == "0") {
                                        document.getElementById("countdown").innerHTML = "Registration has Started!";
                                        loadContent('/Alumnae/Convocationinfo');
                                    }
                                    else if (days == "0" && hours == "0" && minutes == "0") {
                                        document.getElementById("countdown").innerHTML =
                                            "Registration will starts in: " + seconds + " Seconds";
                                    }
                                    else if (days == "0" && hours == "0") {
                                        document.getElementById("countdown").innerHTML =
                                            "Registration will starts in: " + minutes + " Minutes, " + seconds + " Seconds";
                                    }
                                    else if (days == "0") {
                                        document.getElementById("countdown").innerHTML =
                                            "Registration will starts in: " + hours + " Hours, " + minutes + " Minutes, " + seconds + " Seconds";
                                    }
                                    else {
                                        document.getElementById("countdown").innerHTML =
                                            "Registration will starts in: " + days + " Days, " + hours + " Hours, " + minutes + " Minutes, " + seconds + " Seconds";
                                    }
                                }
                                else {
                                    document.getElementById("countdown").innerHTML = "Registration has started Reload the page!";
                                    loadContent('/Alumnae/Convocationinfo');
                                }
                            }
                            setInterval(updateCountdown, 1000);
                        </script>

                    }
                    else
                    {
                        <center>
                            <h3 class="text-danger">@Model.liconvocationeligible.FirstOrDefault().ERROR</h3>
                        </center>
                    }
                </div>
            }
            else if (Model.liStudentflag != null && Model.liStudentflag.Count > 0 && string.IsNullOrEmpty(Model.liconvocationeligible.FirstOrDefault().TIME_PERIOD) && Model.liconvocationeligible.FirstOrDefault().ERROR == "REGCLOSE")
            {
                <div class="container mt-4" id="feedbackarea">
                    <center>
                        <h3 class="text-danger">Registration Closed ...!</h3>
                    </center>
                </div>
            }
            else
            {
                <div class=" mt-4" id="feedbackarea">
                    <center>
                        <h3 class="text-danger">@Model.liconvocationeligible.FirstOrDefault().ERROR</h3>
                    </center>
                </div>
            }

        </div>



    </div>
</div>

