@using CMS.Utility;
@using System.Data;
@using CMS.ViewModel.Model;
@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    if (Session["USER_ID"] == null)
    {
        Response.Redirect("/Account/Index");
    }

    string sCollegeCode = string.Empty;
    string sCollegeLogo = string.Empty;
    string sCollegeName = string.Empty;

}

@if (Session[Common.SESSION_VARIABLES.COLLEGE_DETAILS] != null)
{
    var liCollegeDetails = (List<CollegeDetails>)Session[Common.SESSION_VARIABLES.COLLEGE_DETAILS];
    sCollegeCode = liCollegeDetails.FirstOrDefault().COLLEGE_CODE;
    sCollegeLogo = liCollegeDetails.FirstOrDefault().COLLEGE_LOGO;
    sCollegeName = liCollegeDetails.FirstOrDefault().COLLEGE_NAME;
}


<style>
    /* College Header */
    .header-college h3 {
        font-weight: 700;
        color: #0d47a1;
    }

    .header-college p {
        font-size: 14px;
        color: #607d8b;
        margin-bottom: 0;
    }

    /* Alerts and Notes */
    .alert-warning {
        background: #fff3cd;
        border: 1px solid #ffeeba;
        color: #856404;
        font-size: 14px;
        border-radius: 8px;
        padding: 12px;
    }

    /* Countdown Timer */
    #countdown {
        font-weight: bold;
        font-size: 10px;
        background: #263238;
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
    }

    /* Buttons */
    .btn {
        border-radius: 25px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 6px rgba(0,0,0,0.2);
        }

    #feedbackBtn, #progressionBtn, #FeepayBtn, #downloadBtn {
        font-size: 14px;
        padding: 10px 20px;
    }

    .success {
        background-color: #4CAF50 !important;
        color: #fff !important;
    }

    .borderred button {
        margin-bottom: 12px;
    }

    .ion-checkmark {
        color: #43a047 !important;
    }

    .ion-close {
        color: #e53935 !important;
    }

    /* Remarks Modal */
    .modal-content {
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .modal-header {
        background: #1565c0;
        color: white;
        border-radius: 10px 10px 0 0;
    }

    .modal-body ul {
        list-style-type: disc;
        padding-left: 25px;
    }

    .modal-body h4 {
        color: #1a237e;
        font-weight: 600;
    }

    /* Inputs */
    input.form-control {
        border-radius: 8px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s ease;
    }

        input.form-control:focus {
            border-color: #1976d2;
            box-shadow: 0 0 5px rgba(25,118,210,0.2);
        }

    /* Label Styling */
    .label.label-inverse {
        background: #1e88e5;
        font-weight: 500;
    }

    .label-success {
        background-color: #4CAF50 !important;
        color: white;
    }

    .label-danger {
        background-color: #f44336 !important;
        color: white;
    }

    /* Utility Classes */
    .text-end {
        text-align: right;
    }

    .text-primary {
        color: #1565c0 !important;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    /* Highlight Note Style */
    .highlight-note {
        background: #fff9c4;
        border-right: 5px solid #fbc02d;
        border-left: 5px solid #fbc02d;
        padding: 20px;
        border-radius: 12px;
        margin: 20px 0;
        text-align: left;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

        .highlight-note h4 {
            color: #f57f17;
            margin-top: 0;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .highlight-note ol {
            margin-bottom: 0;
            padding-left: 20px;
        }

            .highlight-note ol li {
                margin-bottom: 15px;
                font-size: 15px;
                line-height: 1.5;
                color: #5d4037;
            }

                .highlight-note ol li:last-child {
                    margin-bottom: 0;
                }

        .highlight-note .price-info {
            font-weight: 700;
            color: #e65100;
        }

    /* Steps Alignment */
    .steps-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 500px;
        margin: 30px auto;
    }

    .step-row {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-bottom: 10px;
    }

    .step-btn {
        flex: 1;
        min-width: 250px;
        text-align: center;
    }

    .step-status {
        width: 40px;
        display: flex;
        justify-content: center;
        margin-left: 10px;
    }

    .step-divider {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 10px;
        width: 100%;
    }

        .step-divider i {
            margin-right: 40px; /* Offset to align with buttons, not status */
        }

    @@media (max-width: 768px) {
        .step-btn {
            min-width: 200px;
        }

        .highlight-note {
            padding: 15px;
        }

            .highlight-note ol li {
                font-size: 14px;
            }

        #countdown {
            font-weight: bold;
            font-size: 9px;
            background: #263238;
            color: #fff;
            padding: 5px 10px;
            border-radius: 20px;
        }
    }
</style>
