
@model CMS.ViewModel.ViewModel.AlumnaeViewModel

@{
    ViewBag.Title = "AlumnaeReport";
   // Layout = "~/Views/Shared/AlumnaeLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />




@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
                <li><a href="javascript:;">Home</a></li>
                <li><a href="javascript:;" onclick="loadContent('/Library/ListBookDetails')">List Books</a></li>
                <li class="active">Alumnae Report</li>
            </ol>
        <h2 class="page-header">Alumnae Report</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Alumnae Report</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal" id="Validate" data-parsley-validate="true">
                    <div class="form-group col-md-12">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-3">Batch</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @*@Html.EditorFor(model => model.objAluRegistration.BATCH, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Batch", @data_parsley_required = "true" } })*@
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-3">Programme</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @*@Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })*@
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-3">Department</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @*@Html.ValidationMessageFor(model => model.DepartmentList, "", new { @class = "text-danger" })*@
                            </div>
                        </div>
                    </div>


                    <br /><br />
                   
                        <div class="col-md-12" id="divBind">
                        </div>
                   
                </div>
            </div>
        </div>
    </div>
}

<!-- Hidden Filed -->
<!-- Hidden Filed -->

    <script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
    <script>

    function ContentLoad() {
        // Document Ready Function .

        //$('.selectpicker').selectpicker({
        //    size: 4
        //});

        //$('.selectpicker').selectpicker('refresh');
        // fetch the status
        var Batch=@Html.Raw(Json.Encode(Model.sBatch));
        var Programme=@Html.Raw(Json.Encode(Model.sProgramme));
        var Dept=@Html.Raw(Json.Encode(Model.sDept));
        if(Batch!=null && Batch!="")
        {

            $("#Batch  option[value="+Batch+"]").prop('selected',true);
            //$("#Batch").trigger("change");
        }
        if(Programme!=null && Programme!="")
        {

            $("#ProgrammeList  option[value="+Programme+"]").prop('selected',true);
            //$("#ProgrammeList").trigger("change");
        }
        if(Dept!=null && Dept!="")
        {

            $("#DepartmentList  option[value="+Dept+"]").prop('selected',true);
            $("#DepartmentList").trigger("change");
        }
        $('.selectpicker').selectpicker('refresh');
    }
    $('.selectpicker').selectpicker({
        size: 4
    });

    $('.selectpicker').selectpicker('refresh');


       

    $("#DepartmentList").on("change", function () {

        var Batch = $('#Batch').val();
        var Programme = $('#ProgrammeList').val();
        var Department = $('#DepartmentList').val();

        if (Batch != "" && Programme!="")
        {
            $.ajax({
            url: "@Url.Action("BindAlumnaeReport", "Alumnae")",
            method: "POST",
            datatype: "json",
            data: { sBatch: Batch, sProgramme: Programme, sDepartment: Department },
            success: function (data) {


                    $('#divBind').html('');
                    $('#divBind').append(data);


            }, error: function (error) {
                swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
          });
        }
        else {
            swal({ title: "Error !", text: "Please select All Fields!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
        }

    });




    $('#btnCancel').click(function () {
    });



    </script>


