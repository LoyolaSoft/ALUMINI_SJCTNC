
@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "Convocation Payment Report";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Alumni Report</li>
    </ol>
    <h1 class="page-header">Alumni Report</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
            </div>
            <h4 class="panel-title">Report Filters</h4>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="form-group col-md-2">
                    @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label " })

                    @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "ddlShift", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @data_selected_text_format = "count > 2" })
                </div>
                <div class="form-group col-md-2">
                    <label class="control-label">Programme Level</label>

                    @Html.DropDownListFor(model => model.Programmelevel, (Model.Programmelevel != null) ? Model.Programmelevel : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "ddlLevel", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @data_selected_text_format = "count > 2" })
                </div>
                <div class="col-md-3 form-group">
                    @Html.Label("Programme")
                    
                    @Html.DropDownListFor(m => m.Programmelist, (Model.Programmelist != null) ? Model.Programmelist : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker form-control input-sm", @id = "ddlProgramme", @data_live_search = "true", @multiple = "multiple", @data_selected_text_format = "count > 2", @data_actions_box = "true" })
                </div>
                <div class="col-md-2 form-group" id="divFromDate">
                    @Html.Label("From Date")
                    @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control input-sm datepicker", @id = "txtFromDate", @placeholder = "dd-mm-yyyy" })
                </div>
                <div class="col-md-2 form-group" id="divToDate">
                    @Html.Label("To Date")
                    @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control input-sm datepicker", @id = "txtToDate", @placeholder = "dd-mm-yyyy" })
                </div>
                <div class="col-md-1 form-group">
                    <button type="button" class="btn btn-sm btn-primary" style="margin-top: 25px;" onclick="loadReport()">Get</button>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group">
                    <a class="btn btn-sm btn-success btnExport hidden" onclick="exportData()"><i class="fa fa-file-excel-o"></i> Excel</a>
                    <a class="btn btn-sm btn-info btnPrint hidden" onclick="printData()"><i class="fa fa-print"></i> Print</a>
                </div>
            </div>

            <div id="reportdiv" style="margin-top:20px;"></div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script>
    $('.datepicker').datepicker({
        format: 'dd/mm/yyyy',
        autoclose: true,
        todayHighlight: true
    });
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    function loadProgrammes() {
        var shiftId = String($('#ddlShift').val());
        var levelId = String($('#ddlLevel').val());
        var $programme = $('#ddlProgramme');

        if (!shiftId || shiftId == "" || !levelId || levelId == "") {
            $programme.empty().selectpicker('refresh');
            return;
        }

        $('#page-loader').removeClass('fade in hide').addClass('fade in');

        $.ajax({
            url: '@Url.Action("GetProgrammesByLevelandShift", "Alumnae")',
            type: 'POST',
            data: { shiftId: shiftId, levelId: levelId },
            success: function (response) {
                $('#page-loader').removeClass('fade in').addClass('fade in hide');
                $programme.empty();
                if (response && response.length > 0) {
                    $.each(response, function (i, item) {
                        $programme.append('<option value="' + item.PROGRAMME_GROUP_ID + '">' + item.PROGRAMME_DESCRIPTION + '</option>');
                    });
                }
                $programme.selectpicker('refresh');
            },
            error: function () {
                $('#page-loader').removeClass('fade in').addClass('fade in hide');
                swal("Error", "Error loading programmes", "error");
            }
        });
    }

    $('#ddlShift, #ddlLevel').on('change', function () {
        loadProgrammes();
    });

    function loadReport() {
        var sid = String($('#ddlShift').val() || '');
        var lid = String($('#ddlLevel').val() || '');
        var pid = String($('#ddlProgramme').val() || '');
        var fromDate = $('#txtFromDate').val();
        var toDate = $('#txtToDate').val();

        $('#page-loader').removeClass('fade in hide').addClass('fade in');

        $.ajax({
            url: "@Url.Action("BindAluminiReport", "Alumnae")",
            type: "post",
            data: { sShiftId: sid, sLevelId: lid, sProgrammeId: pid, sFromDate: fromDate, sToDate: toDate },
            success: function (data) {
                $('#page-loader').removeClass('fade in').addClass('fade in hide');
                $('#reportdiv').empty().append(data);
                $('.btnExport, .btnPrint').removeClass('hidden');

                var table = $('#tblReport').DataTable({
                    dom: 'lBfrtip',
                    buttons: [
                        { extend: 'copy', className: 'btn-sm' },
                        { extend: 'csv', className: 'btn-sm' },
                        { extend: 'excel', className: 'btn-sm' },
                        { extend: 'pdf', className: 'btn-sm' },
                        { extend: 'print', className: 'btn-sm' }
                    ],
                    responsive: true
                });

                table.on('order.dt search.dt', function () {
                    table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
                }).draw();
            },
            error: function (ex) {
                $('#page-loader').removeClass('fade in').addClass('fade in hide');
                swal("Error", "Error loading report", "error");
            }
        });
    }

    function exportData() {
        var sid = encodeURIComponent(String($('#ddlShift').val() || ''));
        var lid = encodeURIComponent(String($('#ddlLevel').val() || ''));
        var pid = encodeURIComponent(String($('#ddlProgramme').val() || ''));
        var fromDate = encodeURIComponent($('#txtFromDate').val());
        var toDate = encodeURIComponent($('#txtToDate').val());

        var baseUrl = '@Url.Action("ExportFilteredAlumniDataToExcel", "Alumnae")';
        var url = baseUrl + '?sShiftId=' + sid + '&sLevelId=' + lid + '&sProgrammeId=' + pid + '&sFromDate=' + fromDate + '&sToDate=' + toDate;
        window.location.href = url;
    }

    function printData() {
        var table = $('#tblReport').DataTable();
        table.destroy();

        var printContents = document.getElementById('reportdiv').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = "<html><head><title>Print Report</title></head><body>" + printContents + "</body></html>";
        window.print();
        document.body.innerHTML = originalContents;

        location.reload();
    }
</script>
