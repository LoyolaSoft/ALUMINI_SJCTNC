                                'rgba(54, 162, 235, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(255, 159, 64, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(255, 159, 64, 1)'
                            ],
                            borderWidth: 1
                        }]
                    };
                     var chartType = "";
                     switch ("@Model.UDF2"){
                         case "2":
                             chartType = "bar";
                             break;
                         case "3":
                             chartType = "pie";
                             break;
                         case "4":
                             chartType = "line";
                             break;
                         case "5":
                             chartType = "scatter";
                             break;
                         case "6":
                             chartType = "doughnut";
                             break;
                         case "7":
                             chartType = "bubble";
                             break;
                         case "8":
                             chartType = "radar";
                             break;
                         case "9":
                             chartType = "polarArea";
                             break;
                         case "10":
                             chartType = "bar";
                             break;
