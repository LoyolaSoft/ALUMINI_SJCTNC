        function readFiles(focusDiv, sourceDiv, sStatus, keyName) {
            var file = document.getElementById('' + sourceDiv + '').files[0];
        // Read first file
            Dom = $('#' + focusDiv + '');
            setup_reader(file, sStatus, focusDiv, keyName);
        }

        function setup_reader(file, sStatus, focusDiv, keyName) {
        //var file = files;
       
        var name = file.name;
        var reader = new FileReader();
        reader.onloadend = function (e) {
            if (sStatus == "0")
            {
                readerLoaded(e, file, name, keyName);
            }
            else
            {

                readerLoaded1(e, file, name, focusDiv, keyName);
            }

           
        };
        reader.readAsBinaryString(file);
        // After reading, read the next file.
    }

        function readerLoaded(e, file, name, keyName) {

        var _size = file.size;
        var extension = GetFileExtension(file);
        var size = GetFileSize(file);
        var UniqueName;
        var actualKey;
        //var iProgress = GetProgressRate(_size);

        if (size != null && size != '') {
            var actualFileDom;
            
            if (extension != null && extension != '') {
                UniqueName = GetuniqueNameForFile(file);
                actualKey = keyName + UniqueName;
                if (extension == 'jpg' || extension == 'png') {
                    actualFileDom = "<div class='col-md-1 col-md-offset-3'><img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + actualKey + "></img><div>";
                }
                else {
                    actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                }
                formData.append(actualKey, file);
                    Dom.html('');
                    Dom.append(actualFileDom);
            }
        }
    }


        function readerLoaded1(e, file, name, focusDiv, keyName) {

            var _size = file.size;
            var extension = GetFileExtension(file);
            var size = GetFileSize(file);
            var UniqueName;
            var actualKey ;
            //var iProgress = GetProgressRate(_size);

            if (size != null && size != '') {
                var actualFileDom;
                if (extension != null && extension != '') {
                    if (extension == 'jpg' || extension == 'png') {
                        UniqueName = GetuniqueNameForFile(file);
                        actualKey = keyName + UniqueName;
                        if(Dom.find('img').length>0)
                        {
                            actualFileDom = "<div class='col-md-2' cms-sp=" + actualKey + ">";
                        }
                        else
                        {
                            actualFileDom = "<div class='col-md-2 col-md-offset-3' cms-sp=" + actualKey + ">";
                        }
                        
                        actualFileDom += "<a onclick=FileCancel('" + actualKey + "','" + focusDiv + "') class='close' aria-label='Close'>" +
                                         "<span aria-hidden='true'>×</span>"+
                                          "</a>"+
                                         "<img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + actualKey + "></img>" +
                                        "<div>";
                    }
                    else {
                        actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                    }
                    
                    formData.append(actualKey, file);
                   // Dom.html('');
                    Dom.append(actualFileDom);
                }
            }
        }


    function GetFileExtension(file) {
        // Get uploaded file extension
        var extension = file.name.split('.').pop().toLowerCase();
        var validFileExtensions = ['jpg', 'png'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            alert("Sorry!! Upload only 'jpf','png'")
            //$(this).replaceWith($(this).val('').clone(true));
            $('#fAttachment').val('');
            //Dom.find('img').remove();
            return extension = null;
        }
        else {
            return extension;
        }

    }

    function GetFileSize(file) {
        var _size = file.size;
        var fileSize = _size;
        var fSExt = new Array('Bytes', 'KB', 'MB', 'GB'),
        i = 0; while (_size > 900) { _size /= 1024; i++; }
        var exactSize = (Math.round(_size * 100) / 100) + ' ' + fSExt[i];

        if (fileSize > 1000000) {
            alert("Sorry!! Max allowed file size is 1 mb");
            // Clear fileuload control selected file
            // $(this).replaceWith($(this).val('').clone(true));
            $('#fAttachment').val('');
            //Dom.find('img').remove();
            return exactSize = null;

        }
        else {
            return exactSize;
        }

    }

    function GetuniqueNameForFile(file)
    {
        var fileName = file.name;
        var File = fileName.split(".");
        var MaxValue = 100;
        var randomValue = Math.floor((Math.random() * parseInt(MaxValue)) + 1);
        var Length = File[0].length;
        var UniqueName = randomString(Length) + randomValue;
        return UniqueName;
    }

        
    function randomString(Length)
    {
        var chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXTZabcdefghiklmnopqrstuvwxyz";
	
        var randomstring = '';
        for (var i = 0; i < Length; i++)
        {
            var rnum = Math.floor(Math.random() * chars.length);
            randomstring += chars.substring(rnum,rnum+1);
        }
        return randomstring;
    }


    $("#btnSubmit").on("click", function () {

        var isValid = true;
        if ($('#Validate').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        var jsonData = '{"objAluPassedoutRegistration":';

        var FirstName = $('#txtFirstName').val();
        var LastName = $('#txtLastName').val();
        var BatchBegin = $('#txtBatchBeginYear').val();
        var BatchEnd = $('#txtBatchEndYear').val();
        var Programme = $('#ProgrammeList').val();
        var Department = $('#DepartmentList').val();
        var Dateofbirth = $('#txtRDob').val();
        var Email = $('#txtRegEmailid').val();
        var Mobile = $('#txtRegMobileNo').val();
        var Address = $('#txtRegPAddress').val();
        var SchorshipReceived = $('#ScholorshipType').val();
        var ScholorshipScheme = $('#ScholorshipScheme').val();
        var AmountReceived = $('#txtRegAmountReceived').val();
        var Aadharno = $('#txtRegAadhaarNo').val();
        var Panno = $('#txtRegPanNo').val();
        var IsHigher = $('#rdHYes').is(":checked")?"1":"0";
        var IsPlacement = $('#rdPDYes').is(":checked") ? "1" : "0";
        var CompetitiveExam = $('#txtCNameofExam').val();
        var CExamRegNo = $('#txtCExamRegNo').val();
        var NoofParticipantsInCultural = $('#txtCNoOfCultural').val();
        var NoofParticipantsInSports = $('#txtSNoOfSports').val();
        var CCyear = $('#txtCCYear').val();
        var CCCourse = $('#txtCCNameofCCourse').val();
        var RSuggestion = $('#txtRSuggestion').val();
        var RExperience = $('#txtRExperience').val();


        var isCultural = $('#txtCNoOfCultural').val() != "" && $('#txtCNoOfCultural').val() != null ? "1" : "0";
        var isSports = $('#txtSNoOfSports').val() != "" && $('#txtSNoOfSports').val() != null ? "1" : "0";
       

        // images
        var dobPath = $('#filesForScholorRDOB').find('img').attr("cms-sp");
        var scholorPath = [];
        $('#filesForScholorRSP').find('img').each(function () {
            if ($(this).attr('cms-sp')!="")
            {
                scholorPath.push($(this).attr('cms-sp'));
            }
        });

        var CompetitiveExamPath = [];
        $('#filesForScholorCEP').find('img').each(function () {
            if ($(this).attr('cms-sp') != "") {
                CompetitiveExamPath.push($(this).attr('cms-sp'));
            }
        });

        var CertificateCoursePath = $('#filesForScholorCCPP').find('img').attr("cms-sp");
       
       

        //clearing formdata sJsonData
        if (formData.has('sJsonData')) {

            formData.delete("sJsonData");
        }

        jsonData += '{"FIRST_NAME":"' + FirstName + '","LAST_NAME":"' + LastName + '","PROGRAMME_ID":"' + Programme + '","BATCH_BEGIN_YEAR":"' + BatchBegin + '","BATCH_END_YEAR":"' + BatchEnd + '","DEPARTMENT":"' + Department + '","DATE_OF_BIRTH":"' + Dateofbirth + '","DOB_PROOF":"' + dobPath + '",' +
                    '"EMAIL_ID":"' + Email + '","MOBILE_NO":"' + Mobile + '","PERMANENT_ADDRESS":"' + Address + '","SCHOLARSHIP":"' + SchorshipReceived + '","SCHEME":"' + ScholorshipScheme + '","AMOUNT_RECEIVED":"' + AmountReceived + '","SCHOLOR_BANK_PROOF":"' + scholorPath + '","AADHAR_NUMBER":"' + Aadharno + '","PAN_NUMBER":"' + Panno + '","IS_HIGHER":"' + IsHigher + '",' +
                    '"IS_PLACEMENT":"' + IsPlacement + '","NAME_OF_COMPETITIVE_EXAM":"' + CompetitiveExam + '","EXAM_REG_NO":"' + CExamRegNo + '","COMPETITIVE_EXAM_PROOF":"' + CompetitiveExamPath + '","IS_CULTURAL":"' + isCultural + '","IS_SPORTS":"' + isSports + '","CC_YEAR":"' + CCyear + '","CC_NAME":"' + CCCourse + '","CC_PROOF":"' + CertificateCoursePath + '","SUGGESTION":"' + RSuggestion + '","EXPERIENCE":"' + RExperience + '"},';

            if (IsHigher != "0" && IsHigher!="")
            {
                jsonData +="objAluPassedoutHigherDetails:";
                var HCourse = $('#txtHCourse').val();
                var HProof = $('#filesForScholorSIp').find('img').attr("cms-sp");
                jsonData += '{"ALU_PASSEDOUT_REGISTER_ID":"","COURSE":"' + HCourse + '","ID_PROOF":"' + HProof + '"},';
            }
           
            if (IsPlacement != "0" && IsPlacement!="")
            {
                var IsOnCampusPlacement = $('#rdPOCYes').is(":checked") ? "1" : "0";
                if (IsOnCampusPlacement != "")
                {
                    var Status;
                    var Val = IsOnCampusPlacement;
                    if(Val=="0")
                    {
                        Status = "2";
                        //off campus
                    }
                    else
                    {
                        Status = "1";
                        //on campus
                    }
                    jsonData += "objAluPassedoutPlacementDetails:";
                    jsonData += '{"ALU_PASSEDOUT_REGISTER_ID":"","STATUS":"' + Status + '"},';

                    var NameofCompany;
                    var packageReceived;
                    var AddressOfCompany;
                    var PlaceProof = [];
                    if(Status=="1")
                    {
                        NameofCompany = $('#txtPNameonCompany').val();
                        packageReceived = $('#txtonPPackageReceived').val();
                        AddressOfCompany = $('#txtonPAddress').val();
                        $('#filesForScholorPonPP').find('img').each(function () {
                            if ($(this).attr('cms-sp') != "") {
                                PlaceProof.push($(this).attr('cms-sp'));
                            }
                        });
                        jsonData += "objAluPassedoutPlaOnCampusDetails:";
                        jsonData += '{"ALU_PASSEDOUT_PLACEMENT_ID":"","COMPANY_NAME":"' + NameofCompany + '","PACKAGE_RECEIVED":"' + packageReceived + '","ADDRESS":"' + AddressOfCompany + '","PROOF":"' + PlaceProof + '"},';

                    }
                    if(Status=="2")
                    {
                        NameofCompany = $('#txtPNNameofCompany').val();
                        packageReceived = $('#txtPNPackageReceived').val();
                        AddressOfCompany = $('#txtPNAddress').val();
                        $('#filesForScholorPPNP').find('img').each(function () {
                            if ($(this).attr('cms-sp') != "") {
                                PlaceProof.push($(this).attr('cms-sp'));
                            }
                        });
                        jsonData += "objAluPassedoutPlaOffCampusDetails:";
                        jsonData += '{"ALU_PASSEDOUT_PLACEMENT_ID":"","COMPANY_NAME":"' + NameofCompany + '","PACKAGE_RECEIVED":"' + packageReceived + '","ADDRESS":"' + AddressOfCompany + '","PROOF":"' + PlaceProof + '"},';
                    }
                }
            }

            if (isCultural != "0" && isCultural != "")
            {
                
                var NameofEvent;
                var place;
                var ClgorInstitutionName;
                var CulProof;
                var cCount = 0;
                jsonData += "objAluPassedoutCulturalDetails:[";
                 
                for (var i = 0; i < NoofParticipantsInCultural; i++)
                {
                    NameofEvent = $('#txtCNameofEvent' + i + '').val();
                    place = $('#txtCPlace' + i + '').val();
                    ClgorInstitutionName = $('#txtCClgorInsName' + i + '').val();
                    CulProof = $('#filesForScholorCP' + i + '').find('img').attr("cms-sp");
                    jsonData += '{"ALU_PASSEDOUT_REGISTER_ID":"","NAME_OF_EVENT":"' + NameofEvent + '","PLACE":"' + place + '","CLGORINSTITUTION_NAME":"' + ClgorInstitutionName + '","PROOF":"' + CulProof + '"},';
                    cCount = parseInt(cCount) + 1;
                }
                if (cCount > 0)
                {
                    jsonData = jsonData.slice(0, -1);
                    jsonData += '],';
                }
            }

            if (isSports != "0" && isSports != "") {

                var SNameofEvent;
                var SportsProof;
                var sCount = 0;
                jsonData += "objAluPassedoutSportsDetails:[";

                for (var i = 0; i < NoofParticipantsInSports; i++) {
                    SNameofEvent = $('#txtSNameofEvent' + i + '').val();
                    SportsProof = $('#filesForScholorSP' + i + '').find('img').attr("cms-sp");
                    jsonData += '{"ALU_PASSEDOUT_REGISTER_ID":"","NAME_OF_EVENT":"' + SNameofEvent + '","PROOF":"' + SportsProof + '"},';
                    sCount = parseInt(sCount) + 1;
                }
                if (sCount > 0) {
                    jsonData = jsonData.slice(0, -1);
                    jsonData += '],';
                }
            }


            jsonData = jsonData.slice(0, -1);
            jsonData += "}";
           
            formData.append("sJsonData", jsonData);

            $.ajax({
            url: "@Url.Action("SaveAluPassedOutRegistration", "Alumnae")",
                type: "post",
                data: formData,
                contentType: false,
                processData: false,
                datatype: "json",
            success: function (data) {

                if (data.ErrorCode != null && data.ErrorCode != "")
                {

                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                    }
                    if (data.ErrorCode == "417") {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                    }
                    if (data.ErrorCode == "201") {
                        swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                    }
                  
                    //  loadContent1('/FeedBack/AddFeedBackQuestions?sFeedBackId=' + $('#FeedBackId').val() + '&sFeedBackRoleId=' + $('#FeedBackRoleId').val() + '&sQuestionId=' + $('#QuestionId').val() + '');
                }
                else
                {
                    if (data.Message!=null && data.Message!="")
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                    }
                }

            }, error: function (error) {
                swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
        });

    });




