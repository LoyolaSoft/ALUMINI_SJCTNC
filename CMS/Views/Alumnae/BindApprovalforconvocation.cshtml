@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    Layout = null;
}
<table class="table table-hover table-bordered" id="tblstudent">
    <thead>
        <tr>
            <th>#</th>
            <th>Register No</th>
            <th>Roll No</th>
            <th>Name</th>
            <th>Batch</th>
            <th>Profile</th>
            <th>Feedback</th>
            <th>Progression</th>
            <th>View All</th>
            <th>Paid Status</th>
            <th>Approval</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
        {
            var count = 0;
            foreach (var item in Model.liStudentList)
            {
                count = count + 1;

                <tr>
                    <td>@count</td>

                    <td>@item.REGISTER_NO</td>
                    <td>@item.ROLL_NO</td>
                    <td>@item.FIRST_NAME</td>
                    <td>@item.BATCH</td>

                    <td>
                        <a href="#profile" onclick="profile(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a>
                        <button onclick="deleteRecords(@item.STUDENT_ID, 'Profile')" class="m-1 btn btn-danger text-primary"><i style="color:white" class="glyphicon glyphicon-repeat" title="Redo"></i></button>

                    </td>
                    <td>
                        <a href="#feedback" onclick="feedback(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a>
                        <button onclick="deleteRecords(@item.STUDENT_ID,'Feedback')" class="m-1 btn btn-danger text-primary"><i style="color:white" class="glyphicon glyphicon-repeat" title="Redo"></i></button>
                    </td>
                    <td>
                        <a href="#Progression" onclick="Progression(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a>
                        <button onclick="deleteRecords(@item.STUDENT_ID,'Progression')" class="m-1 btn btn-danger text-primary"><i style="color:white" class="glyphicon glyphicon-repeat" title="Redo"></i></button>
                    </td>
                    <td>
                        <a href="#Viewall" onclick="viewalldata(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View all"></i></a>
                    </td>
                    <td>
                        @if (item.DEBIT == "1000" || !string.IsNullOrEmpty(item.DEBIT))
                        {
                            <label class="label label-success f-s-12">Paid</label>
                        }
                        else
                        {
                            <label class="label label-danger f-s-12">Not Paid</label>
                        }
                    </td>
                    @if (item.APPROVAL == "1")
                    {
                        <td><a onclick="updateapproval(@item.STUDENT_ID, 1)" class="btn btn-success text-primary"><i style="color:white" class="glyphicon glyphicon-check"></i></a></td>
                    }
                    else
                    {
                        <td><a onclick="updateapproval(@item.STUDENT_ID, 0)" class="btn btn-danger text-primary"><i style="color:white" class="glyphicon glyphicon-unchecked"></i></a></td>
                    }
                </tr>
            }

        }
    </tbody>
</table>