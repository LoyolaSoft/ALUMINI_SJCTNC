
@model CMS.ViewModel.ViewModel.StudentViewModel
@{

    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("COE","DashBoard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Convocation Setting</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Consolidate Mark Sheet Print</h1>
    <!-- end page-header -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Convocation Setting</h4>
        </div>
        <div class="panel-body">
            <div class="form-group col-md-12">
                <a href="#Viewall" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View all"></i></a>
            </div>
            <br />
            <div class="col-md-12 page" id="dvBindConsolidateMark">
            </div>
        </div>
    </div>
</div>

<div class="modal" id="Viewall">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Create Convocation setting</h4>
            </div>
            <div class="modal-content" id="pBody">
                <div id="divprofile" class="modal-header">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="col-md-10">
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">Create Setting Name</label>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" placeholder="This will show for students" id="convocationname" />
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    @Html.LabelFor(model => model.Batch, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    @Html.LabelFor(model => model.ApplicationType, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    @Html.LabelFor(model => model.ResultMonth, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ResultMonth, (Model.ResultMonth != null) ? Model.ResultMonth : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.ResultMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">DATE_FROM</label>
                                    <div class="col-md-7">
                                        <div class="input-group date" id="datetimepicker1">
                                            <input type="text" class="form-control" id="Datefrom" , placeholder="Pick Starting Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">END DATE</label>
                                    <div class="col-md-7">
                                        <div class="input-group date" id="datetimepicker2">
                                            <input type="text" class="form-control" id="Datefrom" , placeholder="Pick Ending Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group col-md-6">

                                </div>
                                <div class="form-group col-md-6">
                                    <div class="col-md-1 col-md-offset-2 pull-right">
                                        <a id="btnSubmit" class="btn btn-primary pull-right">Save</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script>
    ContentLoad = function () {
        //Ready Function()
    }
    handleDatepicker = function () {
        "use strict";
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        })
    }
    handleDatepicker();
    $('.selectpicker').selectpicker({
        size: 4
    });
</script>
<script>
    $('#btnSubmit').on('click', function () {
        var vBatch = $("#Batch").val();
        var vApplicationType = $("#ApplicationType").val();
        var vExamsettingId = $('#ResultMonth').val();
        var AcademicYear = $('#AcademicYear option:selected').text();
        if (AcademicYear == '--select--' || AcademicYear == '0') {
            alert('Please Choose All The Values...!!!');
            return false;
        }

        $.ajax({
            url: "@Url.Action("Saveconvoationsetting", "Alumnae")",
            method: "POST",
            datatype: "json",
            data: {sBatch: vBatch,sExamSettingId: vExamsettingId, sIssueDate: $('#txtIssueDate').val() },
            success: function (data) {
                $('#dvBindConsolidateMark').empty();
                $('#dvBindConsolidateMark').append(data);
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });


    });
</script>


