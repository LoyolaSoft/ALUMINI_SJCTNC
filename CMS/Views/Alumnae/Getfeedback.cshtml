@using CMS.Utility;
@using System.Data;
@using CMS.ViewModel.Model;
@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
}
@if (Model.licurriculumquestions != null && Model.licurriculumquestions.Count > 0)
{
    <table class="table table-hover table-bordered" id="tblstudent">
        <thead>
            <tr>
                <th>#</th>
                <th>Question</th>
                <th>Answer</th>
            </tr>
        </thead>
        <tbody>


            @{var count = 0;
                foreach (var item in Model.licurriculumquestions)
                {
                    count = count + 1;

                    <tr>
                        <td>@count</td>

                        <td><b>@item.QUESTION</b></td>
                        <td>@item.ANSWER</td>
                    </tr>
                }
            }

        </tbody>
    </table>
}
else
{
    <h4 class="text-danger">No data found, It might be the student not filled or You session expired...!</h4>
}