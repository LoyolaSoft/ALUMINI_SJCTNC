@using CMS.Utility;
@using System.Data;
@using CMS.ViewModel.Model;
@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    Layout = null;
}
@if (Model.licurriculumpersonal != null && Model.licurriculumpersonal.Count > 0)
{
    <table class="table table-hover table-bordered" id="tblstudent">
        <tbody>
            <tr>
                <td><b>REGISTER_NO</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().REGISTER_NO</td>
            </tr>
            <tr>
                <td><b>NAME</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().FIRST_NAME</td>
            </tr>
            <tr>
                <td><b>DEPARTMENT</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().DEPARTMENT</td>
            </tr>
            <tr>
                <td><b>PROGRAMME</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().PROGRAMME_NAME</td>
            </tr>
            @* <tr>
                    <td><b>QUALIFICATION</b></td>
                    <td>@Model.licurriculumpersonal.FirstOrDefault().QUALIFICATION</td>
                </tr>*@
            <tr>
                <td><b>PHONE_NO</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().PHONE_NO</td>
            </tr>
            <tr>
                <td><b>EMAIL</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().EMAIL</td>
            </tr>
            <tr>
                <td><b>AADHAR_NO</b></td>
                <td>@Model.licurriculumpersonal.FirstOrDefault().AADHAR_NO</td>
            </tr>
        </tbody>
    </table>
}
else
{
    <h4 class="text-danger">No data found, It might be the student not filled or You session expired...!</h4>
}