@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    Layout = null;
} 
<div class="table-responsive">
    <table id="tblReport" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Register No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Programme</th>
                <th>Batch</th>
                <th>Amount</th>
                <th>Payment Date</th>
                <th>Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
            {
            int count = 1;
            foreach (var item in Model.liStudentList)
            {
            <tr>
                <td>@count</td>
                <td>@item.REGISTER_NO</td>
                <td>@item.ROLL_NO</td>
                <td>@item.FIRST_NAME</td>
                <td>@item.PROGRAMME_NAME</td>
                <td>@item.BATCH</td>
                <td>@item.TOTAL_AMOUNT</td>
                <td>@item.PAYMENT_DATE</td>
                <td>
                    @if (item.STATUS == "PAID")
                    {
                        <label class="label label-success">Paid</label>
                    }
                    else
                    {
                        <label class="label label-danger">Not Paid</label>
                    }
                </td>
            </tr>
            count++;
            }
            }
            else
            {
            <tr>
                <td colspan="9" style="text-align:center;">No Data Found</td>
            </tr>
            }
        </tbody>
    </table>
</div>
