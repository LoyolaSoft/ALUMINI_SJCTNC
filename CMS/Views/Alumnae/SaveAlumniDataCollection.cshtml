@model CMS.Models.ALUMNI_DATA_COLLECTION
@{
    ViewBag.Title = "Alumni Data Collection Form";
    Layout = "~/Views/Shared/AlumnaeLayoutPage.cshtml";
}

@section styles{
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
    <style>
        .form-container {
            max-width: 800px;
            margin: 20px auto;
            padding: 30px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

        .checkbox-group {
            display: flex;
            gap: 20px;
            padding: 10px 0;
            flex-wrap: wrap;
        }

            .checkbox-group label {
                font-weight: 400;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 5px;
            }

        .section-title {
            border-bottom: 2px solid #f1f1f1;
            padding-bottom: 10px;
            margin-bottom: 25px;
            color: #2c3e50;
            font-weight: 700;
        }

        .btn-submit {
            background: #3498db;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s;
            cursor: pointer;
            width: 100%;
            margin-top: 20px;
        }

            .btn-submit:hover {
                background: #2980b9;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
            }
    </style>
}

<div class="content" id="content">
    <div class="form-container">
        <h2 class="section-title text-center">Alumni Data Collection Form</h2>

        <form id="alumniForm" class="form-horizontal">
            <div class="row">
                <div class="col-md-4 form-group">
                    <label for="salutation">Salutation</label>
                    <select id="salutation" name="SALUTATION" class="form-control">
                        <option value="Dr.">Dr.</option>
                        <option value="Mr.">Mr.</option>
                        <option value="Ms.">Ms.</option>
                        <option value="Mrs.">Mrs.</option>
                    </select>
                </div>
                <div class="col-md-8 form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="NAME" class="form-control" required>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="roll">Roll Number</label>
                    <input type="text" id="roll" name="ROLL_NO" class="form-control" required>
                </div>
                <div class="col-md-6 form-group">
                    <label for="programme">Programme Studied</label>
                    <input type="text" id="programme" name="PROGRAMME" class="form-control" required>
                </div>
            </div>

            <div class="form-group">
                <label>Branch</label>
                <div class="checkbox-group">
                    <label><input type="checkbox" id="ug" name="BRANCH_UG" value="Yes"> UG</label>
                    <label><input type="checkbox" id="pg" name="BRANCH_PG" value="Yes"> PG</label>
                    <label><input type="checkbox" id="mphil" name="BRANCH_MPHIL" value="Yes"> M.Phil.</label>
                    <label><input type="checkbox" id="phd" name="BRANCH_PHD" value="Yes"> Ph.D.</label>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="batch">Batch of Study (e.g., 2015 - 2018)</label>
                    <input type="text" id="batch" name="BATCH" class="form-control" required>
                </div>
                <div class="col-md-6 form-group">
                    <label for="stream">Stream</label>
                    <select id="stream" name="STREAM" class="form-control">
                        <option value="Shift-I (Day or Regular)">Shift-I</option>
                        <option value="Shift-II (Evening)">Shift-II</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="status">Present Status</label>
                <input type="text" id="status" name="PRESENT_STATUS" class="form-control" placeholder="Employed / Business / Higher Studies / Others" required>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="designation">Designation / Position</label>
                    <input type="text" id="designation" name="DESIGNATION" class="form-control">
                </div>
                <div class="col-md-6 form-group">
                    <label for="company">Company / Office (with Place)</label>
                    <input type="text" id="company" name="COMPANY" class="form-control">
                </div>
            </div>

            <div class="form-group">
                <label for="permAddress">Permanent Address</label>
                <textarea id="permAddress" name="PERMANENT_ADDRESS" class="form-control" rows="3" required></textarea>
            </div>

            <div class="form-group">
                <label for="commAddress">Communication Address</label>
                <textarea id="commAddress" name="COMMUNICATION_ADDRESS" class="form-control" rows="3" required></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="mobile">Mobile Number (WhatsApp)</label>
                    <input type="text" id="mobile" name="MOBILE_NO" class="form-control" required>
                </div>
                <div class="col-md-6 form-group">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="EMAIL_ID" class="form-control" required>
                </div>
            </div>

            <div class="form-group">
                <label for="otherDetails">Any other relevant details</label>
                <textarea id="otherDetails" name="OTHER_DETAILS" class="form-control" rows="4"></textarea>
            </div>

            <button type="button" id="btnSubmit" class="btn-submit">Submit Data</button>
        </form>
    </div>
</div>

@section scripts{
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#btnSubmit').click(function() {
                var form = $('#alumniForm');
                if (form[0].checkValidity()) {
                    var data = {};
                    form.serializeArray().map(function(x) {
                        data[x.name] = x.value;
                    });

                    // Handle checkboxes specifically if they are not checked
                    if (!$('#ug').is(':checked')) data['BRANCH_UG'] = '';
                    if (!$('#pg').is(':checked')) data['BRANCH_PG'] = '';
                    if (!$('#mphil').is(':checked')) data['BRANCH_MPHIL'] = '';
                    if (!$('#phd').is(':checked')) data['BRANCH_PHD'] = '';

                    $.ajax({
                        url: '@Url.Action("SaveAlumniDataCollection", "Alumnae")',
                        type: 'POST',
                        data: { sJsonData: JSON.stringify(data) },
                        success: function(response) {
                            if (response.ErrorCode == 202) { // Accepted
                                swal("Success", "Alumni data saved successfully!", "success");
                                form[0].reset();
                            } else {
                                swal("Error", response.Message || "Failed to save data.", "error");
                            }
                        },
                        error: function() {
                            swal("Error", "A server error occurred.", "error");
                        }
                    });
                } else {
                    form[0].reportValidity();
                }
            });
        });
    </script>
}
