                EXAM_CLEARED: $('input[name="competitiveexam"]:checked').val(),
                EXAM_NAME: null,
                PASSED_YEAR: null
            };

            if (apstatus === "1" || apstatus === "3") {
                if (!$("#Programmename").val()) {
                    showAlert('warning', 'Please provide the programme!');
                    return;
                }
                if (!$("#InstitutionName").val()) {
                    showAlert('warning', 'Please provide the name of the institution!');
                    return;
                }
                if (!$("#InstitutionAddress").val()) {
                    showAlert('warning', 'Please provide the address of the institution!');
