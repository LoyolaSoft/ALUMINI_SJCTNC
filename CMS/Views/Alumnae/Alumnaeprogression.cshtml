                //}
                if (!$('input[name="competitiveexam"]:checked').val()) {
                    showAlert('warning', 'Please check competitive exam section!');
                    return;
                }
                var selectedValue = $('input[name="competitiveexam"]:checked').val();
                if (selectedValue === "1") {
