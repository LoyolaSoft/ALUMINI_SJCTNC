        function showAlert(type, message, callback) {
            const titles = {
                success: "Success!",
                error: "Error!",
                warning: "Warning!"
            };

            const swalOptions = {
                title: titles[type] || "Notification",
                text: message,
                showConfirmButton: type === "success",
                confirmButtonText: 'OK',
                animation: true,
                type: type
            };

            if (type !== "success") {
                swalOptions.timer = 1500;
                swalOptions.showConfirmButton = false;
            } else {
                swalOptions.timer = 40000;
            }
            swal(swalOptions);
            if (type !== "success") {
                setTimeout(() => {
                    swal.close();
                    if (callback) {
                        callback();
                    }
                }, swalOptions.timer);
            } else {
                swal(swalOptions, function () {
                    if (callback) {
                        callback();
                    }
                });
            }
        }


