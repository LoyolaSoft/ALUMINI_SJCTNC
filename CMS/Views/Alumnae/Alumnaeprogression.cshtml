<script>
    document.getElementById('Institutionattachment').addEventListener('change', function (event) {
        handleFilePreview('Institutionattachment', 'preview-container');
    });

    document.getElementById('appointmentletter').addEventListener('change', function (event) {
        handleFilePreview('appointmentletter', 'preview-containerAPPOINMENT');
    });

    document.getElementById('competitiveexamproof').addEventListener('change', function (event) {
        handleFilePreview('competitiveexamproof', 'preview-containerCF');
    });
    document.getElementById('Institutionattachmentforintern').addEventListener('change', function (event) {
        handleFilePreview('Institutionattachmentforintern', 'preview-containerintern');
    });
    function handleFilePreview(inputId, previewContainerId) {
        const inputElement = document.getElementById(inputId);
        const files = inputElement.files;
        const previewContainer = $(`#${previewContainerId}`);
        previewContainer.empty();

        $.each(files, function (index, file) {
            // Validation: Only allow PDF
            if (file.type !== 'application/pdf') {
                showAlert('error', 'Only PDF files are allowed!');
                inputElement.value = ""; // Clear the input
                previewContainer.empty();
                return false;
            }

            // Validation: File size Max 20KB
            const maxSize = 20 * 1024; // 20KB in bytes
            if (file.size > maxSize) {
                showAlert('error', 'File size exceeds 20KB limit!');
                inputElement.value = ""; // Clear the input
                previewContainer.empty();
                return false;
            }

            // If valid, show preview
            const pdfIcon = $('<i>')
                .addClass('fa fa-file-pdf-o')
                .css({
                    'font-size': '40px',
                    'color': 'red',
                    'margin-right': '10px'
                });

            const pdfLink = $('<a>')
                .attr({
                    'href': URL.createObjectURL(file),
                    'target': '_blank'
                })
                .append(pdfIcon);

            previewContainer.append(pdfLink);
        });
    }

</script>