<script>
    $(document).ready(function () {
        $(".studying").hide();
        $(".working").hide();
        $('.competitive').hide();
        $('.Specifydoing').hide();
        $('.Intern').hide();
        $(".curtain").hide();

        $("#APSTATUS").on("change", function () {
            var status = $(this).val();

            if (status === "1" || status === "3") {
                $(".studying").show();
                $(".working").hide();
                $('.Specifydoing').hide();
                $('.Specifydoing2').hide();
                $('.Intern').hide();
                $("#span_institution_attachment").show();
            }
            else if (status === "4") {
                $(".studying").hide();
                $(".working").hide();
                $('.Specifydoing').hide();
                $('.Programmename').hide();
                $('.Specifydoing2').show();
                $('.Intern').hide();
                $("#span_institution_attachment").hide();
            } else if (status === "2") {
                $(".studying").hide();
                $(".working").show();
                $('.Specifydoing').hide();
                $('.Specifydoing2').hide();
                $('.Intern').hide();
            } else if (status === "7" || status === "6") {
                $(".studying").hide();
                $(".working").hide();
                $(".Specifydoing").show();
                $(".Specifydoing2").hide();
                $('.Intern').hide();
            } else if (status === "5") {
                $(".studying").hide();
                $(".working").hide();
                $(".Specifydoing").hide();
                $(".Specifydoing2").hide();
                $('.Intern').show();
            } else {
                $(".studying").hide();
                $(".working").hide();
                $(".Specifydoing").hide();
                $(".Specifydoing2").hide();
                $('.Intern').hide();
            }
        });

