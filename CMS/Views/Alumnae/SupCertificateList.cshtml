@model CMS.ViewModel.ViewModel.AlumnaeViewModel

@{
    ViewBag.Title = "SupCertificateList";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">SupCertificateList</li>
    </ol>
    <h1 class="page-header">Sup Certificate List </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Sup Certificate List </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>

                            <th>Certificate Name </th>

                            <th>Order By</th>
                            <th>Category Name</th>
                            <th>Active</th>
                            <th>Action</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liCertificateList != null && Model.liCertificateList.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liCertificateList)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.CERTIFICATE_NAME</td>


                                    <td>@item.ORDER_BY</td>

                                    <td>@item.CATEGORY_NAME</td>
                                    <td>

                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>




                                    <td>
                                        <a href="#Rules-dialog" onclick="FetchSubCertificateById(@item.CERTIFICATE_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.CERTIFICATE_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Certificate Name", htmlAttributes: new { @class = "col-md-3 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="text" id="CertificateName" required />
                                        </div>
                                        <div class="col-md-12 form-group">
                                        </div>
                                        @Html.Label("Order By", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="number" id="orderby" />
                                        </div>
                                        <br />
                                        <br />
                                        <div class="form-group">
                                            <label class="control-label col-md-3">Category</label>
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.CertificateName, (Model.CertificateName ?? Enumerable.Empty<SelectListItem>()), new { @class = "selectpicker form-control", @data_live_search = "true", @data_actions_box = "true", @id = "CERTIFICATE_ID", @multiple = "multiple" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 form-group">
                                        <div class="col-md-8">
                                            <input type="checkbox" id="chIsActive" /> &nbsp; &nbsp; IsActive
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="Certificateid" value="" />
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>

    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
        //add
    });

    //add

       $('#btnSubmit').on('click', function ()
       {
           var isValid = true;
           if ($('#pBody').parsley().validate() !== true) isValid = false;

           if (!isValid) {
               //gritter-info,danger,success,warning,default
               myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
               return false;
           }
    var IsActive = 0;
    if ($('#chIsActive').is(':checked'))
    {
        IsActive = 1;
    }
           // Get selected values from multi-select dropdown
           var selectedCategories = $('#CERTIFICATE_ID').val();
           var categoryIdStr = selectedCategories ? selectedCategories.toString() : '';

           var sJsonData = '{"CERTIFICATE_ID":"' + $("#Certificateid").val() + '","CERTIFICATE_NAME":"' + $('#CertificateName').val() + '","IS_ACTIVE":"' + IsActive + '","ORDER_BY":"' + $('#orderby').val() + '","CATEGORY_ID":"' + categoryIdStr +'"}';
    $.ajax({
        url:'@Url.Action("SaveSupCertificate", "Alumnae")',
        method: 'POST',
        data: { certificate: sJsonData},
        success: function (data)
        {
            if (data.ErrorCode != null && data.ErrorCode == "402") {
                swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            } else {
                swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
            }
            
            loadContent('/Alumnae/SupCertificateList');

            // window.location = '/Admin/CountInfo';
        },
        error: function (error)
        {
            alert('Internal Server Error !');
        }
    });
});


//delete

    //var CertificateID = '';
    function GetConfirm(ID) {
      swal({
          title: "Are you sure want to Delete..?",
          type: "warning",
          showCancelButton: true,
          confirmButtonClass: "btn-danger",
          confirmButtonText: "Yes, I agree!",
          closeOnConfirm: false
      }, function () {
          $.ajax({
              url: "@Url.Action("DeleteSupCertificateById", "Alumnae")",
              type: "post",
              data: { CertificateID: ID },
              success: function (data) {
                  if (data.ErrorCode != null && data.ErrorCode == "402") {
                      swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                  } else {
                      swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                  }
                  loadContent('/Alumnae/SupCertificateList');
              },
              error: function () {
                  swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
              }
          });
      });
    }

    //edit
    function FetchSubCertificateById(RuleId) {
        $('#pBody').parsley().destroy();

        if (RuleId != null) {
            $.ajax({
                url: "/Alumnae/FetchSupCertificateById",
                type: "post",
                data: { CertificateID: RuleId },
                success: function (data) {
                    if (data.Message != null) {
                        alert(data.Message);
                    }
                    else {
                        if (data.oResult[0] != null) {

                            $('#Certificateid').val(data.oResult[0].CERTIFICATE_ID);
                            $('#CertificateName').val(data.oResult[0].CERTIFICATE_NAME);
                            
                            // Map CATEGORY_ID to the dropdown
                            if (data.oResult[0].CATEGORY_ID != null) {
                                var categoryIds = data.oResult[0].CATEGORY_ID.split(',');
                                $('#CERTIFICATE_ID').val(categoryIds);
                            } else {
                                $('#CERTIFICATE_ID').val([]);
                            }
                            $('#CERTIFICATE_ID').selectpicker('refresh');
                            
                            $('#orderby').val(data.oResult[0].ORDER_BY);
                            
                            // Handle Checkbox
                            $('#chIsActive').prop('checked', false);
                            if (data.oResult[0].IS_ACTIVE == "1") {
                                $("#chIsActive").prop("checked", true);
                            }
                        }


                    }

                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $("#Add").on('click', function(){

        $('#Certificateid').val('');
        $('#CertificateName').val('');
        $('#CERTIFICATE_ID').val([]).selectpicker('refresh');
        $('#orderby').val('');
        $("#chIsActive").prop("checked", false);    })
</script>