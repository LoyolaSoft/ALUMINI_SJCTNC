<script src="https://cdn.jsdelivr.net/npm/@symbol/ui/dist/fancybox.umd.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        Fancybox.bind('[data-fancybox="gallery"]', {
            Toolbar: {
                display: ["zoom", "close"]
            },
            loop: true,
            afterLoad: (fancybox, slide) => {
                slide.$content.on('click', function (event) {
                    event.preventDefault();
                });
            }
        });
    });
    function ContentLoad() {

    }

    if ($('#progression').is(':checked')) {
        $('.progressiondiv').css('display', 'block');
        $('.feedbackdiv').css('display', 'none');

    } else if ($('#feedback').is(':checked')) {
        $('.progressiondiv').css('display', 'none');
        $('.feedbackdiv').css('display', 'block');
    } else if ($('#both').is(':checked')) {
        $('.progressiondiv').css('display', 'block');
        $('.feedbackdiv').css('display', 'block');
    }

    if ($('#ignoreincompletedata').is(':checked')) {
        $('.incompletestudent').css('display', 'none');
    }
    else {
        $('.incompletestudent').css('display', 'block');
    }

    $('#ignoreincompletedata').change(function () {
        if ($('#ignoreincompletedata').is(':checked')) {
            $('.incompletestudent').css('display', 'none');
        } else {
            $('.incompletestudent').css('display', 'block');
        }
    });


    $('input[name="printtype"]').change(function () {
        if ($('#progression').is(':checked')) {
            $('.progressiondiv').css('display', 'block');
            $('.feedbackdiv').css('display', 'none');

        } else if ($('#feedback').is(':checked')) {
            $('.progressiondiv').css('display', 'none');
            $('.feedbackdiv').css('display', 'block');
        } else if ($('#both').is(':checked')) {
            $('.progressiondiv').css('display', 'block');
            $('.feedbackdiv').css('display', 'block');
        }
    });
</script>