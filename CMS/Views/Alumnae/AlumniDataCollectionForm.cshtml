@model CMS.Models.ALUMNI_DATA_COLLECTION
@{
    ViewBag.Title = "Alumni Data Collection Form";
    Layout = null;
}

@if (Request.IsAjaxRequest())
{
    @RenderStyles()
    @RenderForm()
    @RenderScripts()
}
else
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Alumni Connect | SJCTNC</title>

        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />


        <!-- Select2 & Bootstrap 5 theme -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

        @RenderStyles()
    </head>
    <body class="page-body">
        <div class="page-wrapper">
            <div class="container py-5 animate__animated animate__fadeIn">

                <div class="header-branding text-center mb-5">
                    <img src="/Content/assets/img/hcc-img/SJCLOGO.png" alt="SJC Logo" class="header-logo">
                    <h1 class="brand-title">SJCTNC Alumni Network</h1>
                    <p class="brand-subtitle">Staying Connected with Your Alma Mater</p>
                </div>

                @RenderForm()

            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        @RenderScripts()
    </body>
</html>
}

@helper RenderStyles()
{
    <style>
        :root {
            --primary: #4361ee;
            --primary-hover: #3f37c9;
            --secondary: #4895ef;
            --background: #f8fafc;
            --text-main: #1e293b;
            --text-dark: #0f172a;
            --glass-bg: rgba(255, 255, 255, 0.95);
            --glass-border: rgba(255, 255, 255, 0.2);
            --success: #06d6a0;
            --admit-card-bg: #dceefc;
            --admit-card-accent: #e74c3c;
        }

        .page-body {
            font-family: 'Inter', sans-serif;
            background-color: var(--background);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .page-wrapper {
            background-color: #656565;
            background-image: radial-gradient(at 0% 0%, hsl(269.5deg 34.45% 61.2%) 0, transparent 50%), radial-gradient(at 50% 0%, hsl(225deg 33.25% 63.66%) 0, transparent 50%), radial-gradient(at 100% 0%, hsl(225deg 35.98% 64.57%) 0, transparent 50%);
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .header-logo {
            width: 140px;
            height: auto;
            margin-bottom: 25px;
            filter: drop-shadow(0 5px 15px rgba(0,0,0,0.1));
        }

        .brand-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            color: #ffffff;
            font-size: 3rem;
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
        }

        .brand-subtitle {
            color: rgba(255,255,255,0.85);
            font-size: 1.25rem;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .form-container {
            max-width: 850px;
            margin: 0 auto;
            padding: 50px;
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.35);
            position: relative;
            overflow: hidden;
        }

        /* Stepper Styles */
        .stepper {
            display: flex;
            justify-content: space-between;
            margin-bottom: 50px;
            position: relative;
            z-index: 1;
        }

            .stepper::before {
                content: '';
                position: absolute;
                top: 25px;
                left: 0;
                right: 0;
                height: 3px;
                background: #e2e8f0;
                z-index: -1;
            }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            position: relative;
        }

        .step-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            color: #64748b;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            margin-bottom: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .step.active .step-circle {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: 0 10px 20px rgba(67, 97, 238, 0.3);
            transform: scale(1.1);
        }

        .step.completed .step-circle {
            background: var(--success);
            border-color: var(--success);
            color: #fff;
        }

        .step-label {
            font-weight: 600;
            font-size: 0.8rem;
            color: #64748b;
            font-family: 'Outfit', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .step.active .step-label {
            color: var(--primary);
        }

        /* Form Content Animation */
        .form-step {
            display: none;
        }

            .form-step.active {
                display: block;
                animation: slideUp 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section-header {
            margin-bottom: 35px;
            text-align: center;
        }

            .section-header h3 {
                font-family: 'Outfit', sans-serif;
                font-weight: 700;
                font-size: 1.8rem;
                color: var(--text-dark);
                margin-bottom: 10px;
            }

            .section-header p {
                color: #64748b;             
                font-size: 1rem;    
            }

        /* Inputs */
        .form-label {
            font-weight: 600;
            color: #475569;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .form-control, .form-select {
            border-radius: 14px;
            border: 2px solid #e2e8f0;
            padding: 14px 18px;
            font-size: 1rem;
            background-color: #fff;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
                outline: none;
            }

        .checkbox-group {
            background: #f8fafc;
            border: 2px solid #f1f5f9;
            padding: 25px;
            border-radius: 20px;
            margin-bottom: 25px;
        }

        .form-check {
            padding-left: 1.8em;
            margin-bottom: 12px;
        }

        .nav-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
            gap: 20px;
        }

        .btn-nav {
            padding: 16px 32px;
            border-radius: 16px;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            flex: 1;
        }

        .btn-prev {
            background: #fff;
            color: #64748b;
            border: 2px solid #e2e8f0;
        }

        .btn-next, .btn-submit {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: #fff;
            border: none;
            box-shadow: 0 10px 20px rgba(67, 97, 238, 0.25);
        }

        .branch-textbox {
            display: none;
            margin-top: 12px;
        }

        /* Admit Card Card Styles */
        .admit-card-stage {
            text-align: center;
        }

        .admit-card-wrapper {
            margin: 0 auto;
            max-width: 600px;
            padding: 30px;
            background-color: #dceefc;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 2px solid #a4d2f7;
            position: relative;
            text-align: left;
        }

        .admit-card-header {
            text-align: center;
            margin-bottom: 20px;
        }

            .admit-card-header h2 {
                color: #d35400;
                font-weight: 800;
                font-size: 1.4rem;
                margin: 5px 0;
                text-transform: uppercase;
            }

            .admit-card-header p {
                color: #2c3e50;
                font-size: 0.8rem;
                margin: 2px 0;
                font-weight: 500;
            }

        .admit-card-title-pill {
            display: inline-block;
            border: 2px solid #e74c3c;
            border-radius: 25px;
            padding: 8px 30px;
            color: #e74c3c;
            font-weight: 700;
            font-size: 1.1rem;
            margin: 15px 0;
            background: rgba(255,255,255,0.8);
        }

        .admit-card-body {
            display: flex;
            gap: 25px;
        }

        .admit-card-photo {
            width: 140px;
            height: 160px;
            border: 2px solid #fff;
            background: #bdc3c7;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            overflow: hidden;
        }

        .admit-card-details {
            flex: 1;
        }

        .admit-card-row {
            display: flex;
            border-bottom: 1px dotted #a4d2f7;
            padding: 8px 0;
            font-size: 0.95rem;
        }

        .admit-card-label {
            width: 130px;
            font-weight: 600;
            color: #34495e;
        }

        .admit-card-value {
            font-weight: 700;
            color: #2c3e50;
            flex: 1;
        }

        .admit-card-footer {
            margin-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            font-size: 0.75rem;
            color: #7f8c8d;
        }

        .download-btn {
            background: #27ae60;
            color: #fff;
            border: none;
            padding: 14px 40px;
            border-radius: 12px;
            font-weight: 700;
            margin-top: 30px;
            transition: all 0.3s ease;
            cursor: pointer;
            width: auto;
            display: inline-block;
        }

            .download-btn:hover {
                background: #219150;
                transform: translateY(-2px);
            }

        @@media print {
            .stepper, .nav-buttons, .header-branding, .download-btn {
                display: none !important;
            }

            .form-container {
                padding: 0;
                box-shadow: none;
                background: none;
            }

            .admit-card-wrapper {
                border: 2px solid #000;
                box-shadow: none;
                margin: 0;
            }
        }

        /* Select2 Boostrap 5 Overrides */
        .select2-container--bootstrap-5 .select2-selection {
            border-radius: 14px;
            border: 2px solid #e2e8f0;
            min-height: calc(1.5em + 1.25rem + 2px); 
            padding: 0.625rem 0.75rem;
            font-size: 1rem;
            background-color: #fff;
            transition: all 0.3s ease;
        }
        .select2-container--bootstrap-5.select2-container--focus .select2-selection {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
        }
        
        /* Validation feedback for Select2 */
        .was-validated select:invalid + .select2-container .select2-selection {
            border-color: #dc3545;
            padding-right: 2.25rem;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
        .was-validated select:valid + .select2-container .select2-selection {
            border-color: #198754;
            padding-right: 2.25rem;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }

        /* Mobile Responsive Adjustments */
        @@media (max-width: 768px) {
            .form-container {
                padding: 10px 5px;
                border-radius: 20px;
            }
            .brand-title {
                font-size: 2rem;
            }
            .brand-subtitle {
                font-size: 1rem;
            }
            .stepper::before {
                top: 20px;
            }
            .step-circle {
                width: 40px;
                height: 40px;
                font-size: 0.95rem;
                border-width: 2px;
            }
            .step-label {
                font-size: 0.7rem;
            }
            .nav-buttons {
                flex-direction: column-reverse;
                gap: 15px;
            }
            .btn-nav {
                width: 100%;
            }
            .admit-card-body {
                flex-direction: column;
                align-items: center;
                gap: 15px;
                text-align: center;
            }
            .admit-card-row {
                flex-direction: column;
                border-bottom: none;
                padding: 4px 0;
            }
            .admit-card-label {
                width: auto;
                color: #7f8c8d;
                font-size: 0.85rem;
            }
            .admit-card-value {
                font-weight: 600;
                font-size: 1.05rem;
            }
        }
    </style>
}

@helper RenderForm()
{
    <div class="form-container">

        <!-- Stepper -->
        <div class="stepper">
            <div class="step active" id="stepIndicator1">
                <div class="step-circle">1</div>
                <div class="step-label">Identify</div>
            </div>
            <div class="step" id="stepIndicator2">
                <div class="step-circle">2</div>
                <div class="step-label">Personal</div>
            </div>
            <div class="step" id="stepIndicator3">
                <div class="step-circle">3</div>
                <div class="step-label">Edu & Work</div>
            </div>
            <div class="step" id="stepIndicator4">
                <div class="step-circle">4</div>
                <div class="step-label">Admit Card</div>
            </div>
        </div>

        <form id="alumniForm" class="needs-validation" novalidate onsubmit="return false;">

            <!-- STEP 1: IDENTIFICATION -->
            <div class="form-step active" id="step1">
                <div class="section-header">
                    <h3>Identification</h3>
                    <p>Enter your basic details to get started.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-12">
                        <label class="form-label">Roll Number</label>
                        <input type="text" name="ROLL_NO" class="form-control" placeholder="Your Unique Roll Number (Ex:A22CADA01)" >
                        <div class="invalid-feedback">Roll Number is required.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Salutation</label>
                        <select name="SALUTATION" class="form-select">
                            <option value="Dr.">Dr.</option>
                            <option value="Mr.">Mr.</option>
                            <option value="Ms.">Ms.</option>
                            <option value="Mrs.">Mrs.</option>
                            <option value="Rev Fr.">Rev Fr.</option>
                            <option value="Rev Sr.">Rev Sr.</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="NAME" class="form-control" placeholder="As per records" required>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="EMAIL_ID" class="form-control" placeholder="Your email address" required>
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                </div>

                <div class="nav-buttons">
                    <div></div> <!-- Spacer -->
                    <button type="button" class="btn-nav btn-next" onclick="nextStep(1)">Next Step &rarr;</button>
                </div>
            </div>

            <!-- STEP 2: PERSONAL DETAILS -->
            <div class="form-step" id="step2">
                <div class="section-header">
                    <h3>Personal Details</h3>
                    <p>More about how we can reach you.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">Mobile Number</label>
                        <input type="tel" name="MOBILE_NO" class="form-control" placeholder="10-digit Mobile Number" pattern="[0-9]{10}" maxlength="10" required>
                        <div class="invalid-feedback">Please enter a valid 10-digit mobile number.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" name="DATE_OF_BIRTH" class="form-control" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Permanent Address</label>
                        <textarea name="PERMANENT_ADDRESS" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">Communication Address</label>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="sameAsPermanent">
                                <label class="form-check-label" for="sameAsPermanent" style="font-size: 0.85rem">Same as Permanent</label>
                            </div>
                        </div>
                        <textarea name="COMMUNICATION_ADDRESS" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Profile Photo (Passport size)</label>
                        <input type="file" id="photoInput" class="form-control" accept="image/*" name="PHOTO_FILE">
                        <div id="photoPreview" class="mt-3" style="display:none;">
                            <p class="small text-muted mb-2">Preview Image:</p>
                            <img src="" id="imgPreview" alt="Preview" style="max-width: 140px; border: 3px solid #fff; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                        </div>
                    </div>
                </div>

                <div class="nav-buttons">
                    <button type="button" class="btn-nav btn-prev" onclick="prevStep(2)">&larr; Previous</button>
                    <button type="button" class="btn-nav btn-next" onclick="nextStep(2)">Next Step &rarr;</button>
                </div>
            </div>

            <!-- STEP 3: EDUCATIONAL & WORKING DETAILS -->
            <div class="form-step" id="step3">
                <div class="section-header">
                    <h3>Educational & Working Details</h3>
                    <p>Tell us about your background and career.</p>
                </div>

                <div class="row g-4">
                    <!-- Educational Part -->
                    <div class="col-md-6">
                        <label class="form-label">Programme Level</label>
                        @Html.DropDownList("ACADEMIC_LEVEL_ID", ViewBag.ProgrammeLevelList as SelectList, "-- Select Academic Level --", new { @class = "form-select", id = "ddlAcademicLevel", required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Shift</label>
                        @Html.DropDownList("SHIFT_ID", ViewBag.shiftList as SelectList, "-- Select Stream --", new { @class = "form-select", id = "ddlshift", required = "required" })
                    </div>
                   
                    <div class="col-md-6">
                        <label class="form-label">Programme Studied</label>
                        <select name="PROGRAMME" id="ddlProgramme" class="form-select" required>
                            <option value="">-- Select Programme --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Year of Passing</label>
                        <input type="text" name="BATCH" class="form-control" placeholder="e.g. 2024" pattern="(19|20)\d{2}" maxlength="4" required>
                        <div class="invalid-feedback">Please enter a valid 4-digit year (e.g., 2024).</div>
                    </div>



                    <hr class="my-4">

                    <!-- Working Part -->
                    <div class="col-12">
                        <label class="form-label">Present Status</label>
                        @Html.DropDownList("PRESENT_STATUS", ViewBag.PresentStatusList as SelectList, "-- Select Present Status --", new { @class = "form-select", required = "required" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Designation</label>
                        <input type="text" name="DESIGNATION" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Company</label>
                        <input type="text" name="COMPANY" class="form-control">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Other Details / Office Address</label>
                        <textarea name="OTHER_DETAILS" class="form-control" rows="4"></textarea>
                    </div>
                </div>

                <div class="nav-buttons">
                    <button type="button" class="btn-nav btn-prev" onclick="prevStep(3)">&larr; Previous</button>
                    <button type="submit" class="btn-nav btn-submit" id="submitBtn">FINISH & SUBMIT</button>
                </div>
            </div>

            <!-- STEP 4: ADMIT CARD -->
            <div class="form-step" id="step4">
                <div class="section-header">
                    <h3>Convocation Admit Card</h3>
                    <p>Please double-check your details and download your card.</p>
                </div>

                <div class="admit-card-stage">
                    <div id="printableAdmitCard" class="admit-card-wrapper">
                        <div class="admit-card-header">
                            <img src="/Content/assets/img/hcc-img/SJCLOGO.png" alt="SJC Logo" style="width: 70px; margin-bottom: 10px;">
                            <h2>St.Joseph's College of Arts & Science (Autonomous)</h2>
                            <p>Cuddalore - 607 001</p>
                            <p>(Accredited by NAAC with 'A' Grade in the 4th Cycle)</p>
                            @*<p>67th Graduation Day 11th Oct 2025</p>*@
                            <div class="admit-card-title-pill"> ADMIT CARD</div>
                        </div>

                        <div class="admit-card-body">
                            <div class="admit-card-photo">
                                <img id="card_Photo" src="" alt="Student" style="width:100%; height:100%; object-fit:cover; display:none;">
                                <div id="card_Photo_placeholder" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#e9ecef;color:#6c757d;font-size:0.75rem;text-align:center;">No<br>Photo</div>
                            </div>
                            <div class="admit-card-details">
                                <div class="admit-card-row">
                                    <span class="admit-card-label">Name</span>
                                    <span class="admit-card-value" id="card_Name">: </span>
                                </div>
                                <div class="admit-card-row">
                                    <span class="admit-card-label">Reg No</span>
                                    <span class="admit-card-value" id="card_RegNo">: </span>
                                </div>
                                <div class="admit-card-row">
                                    <span class="admit-card-label">Date of Birth</span>
                                    <span class="admit-card-value" id="card_Dob">: </span>
                                </div>
                                <div class="admit-card-row">
                                    <span class="admit-card-label">Email</span>
                                    <span class="admit-card-value" id="card_Email">: </span>
                                </div>
                                <div class="admit-card-row">
                                    <span class="admit-card-label">Programme</span>
                                    <span class="admit-card-value" id="card_Programme" placeholder="B.Sc.Computer Science">: </span>
                                </div>
                                <div class="admit-card-row">
                                    <span class="admit-card-label">Year of Passing</span>
                                    <span class="admit-card-value" id="card_PassingYear">: </span>
                                </div>
                            </div>
                        </div>

                        <div class="admit-card-footer">
                            <span>Printed: <span id="printTimestamp"></span></span>
                        </div>
                    </div>

                    <button type="button" class="download-btn" onclick="downloadAdmitCard()">
                        <svg width="20" height="20" fill="currentColor" class="bi bi-download me-2" viewBox="0 0 16 16">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                        </svg>
                        DOWNLOAD ADMIT CARD
                    </button>

                    <div class="mt-4">
                        <button type="button" class="btn btn-link" onclick="returnToForm()">Return to Form</button>
                    </div>
                </div>
            </div>

        </form>
    </div>
}

@helper RenderScripts()
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        var currentStep = 1;
        var baseUrl = '@Url.Content("~")';

        function formatDateForInput(dateStr) {
            if (!dateStr) return '';
            // If it's DD-MM-YYYY or DD/MM/YYYY
            var parts = dateStr.split(/[-/]/);
            if (parts.length === 3) {
                if (parts[0].length === 2 && parts[2].length === 4) {
                    return parts[2] + '-' + (parts[1].length === 1 ? '0' + parts[1] : parts[1]) + '-' + (parts[0].length === 1 ? '0' + parts[0] : parts[0]);
                }
                if (parts[0].length === 4) { // YYYY-MM-DD
                    return parts[0] + '-' + (parts[1].length === 1 ? '0' + parts[1] : parts[1]) + '-' + (parts[2].length === 1 ? '0' + parts[2] : parts[2]);
                }
            }
            return dateStr;
        }

        function formatDateForDisplay(dateStr) {
            if (!dateStr) return '';
            var parts = dateStr.split(/[-/]/);
            if (parts.length === 3) {
                if (parts[0].length === 4) { // YYYY-MM-DD -> DD-MM-YYYY
                    return (parts[2].length === 1 ? '0' + parts[2] : parts[2]) + '-' + (parts[1].length === 1 ? '0' + parts[1] : parts[1]) + '-' + parts[0];
                }
            }
            return dateStr;
        }

        function getFullPhotoPath(photoPath) {
            if (!photoPath) return '';
            var path = photoPath.replace(/\\/g, '/');
            if (path.startsWith('http')) return path;
            if (path.startsWith('/')) {
                // Remove trailing slash from baseUrl if path has leading slash
                var cleanBase = baseUrl.endsWith('/') ? baseUrl.substring(0, baseUrl.length - 1) : baseUrl;
                return cleanBase + path;
            }
            return baseUrl + path;
        }


        function jumpToStep(step) {
            $('.form-step').removeClass('active');
            $('#step' + step).addClass('active');

            $('.step').removeClass('active').removeClass('completed');
            for(let i=1; i<step; i++) {
                $('#stepIndicator' + i).addClass('completed');
            }
            $('#stepIndicator' + step).addClass('active');
            currentStep = step;
            window.scrollTo({ top: $('.form-container').offset().top - 20, behavior: 'smooth' });
        }

        function nextStep(step) {
            const $step = $('#step' + step);
            let isValid = true;

            $step.find('input[required], select[required], textarea[required]').each(function() {
                if (!this.checkValidity()) {
                    isValid = false;
                }
            });

            if (!isValid) {
                $step.addClass('was-validated');
                const firstInvalid = $step[0].querySelector(':invalid');
                if ($(firstInvalid).is('select') && $(firstInvalid).hasClass('select2-hidden-accessible')) {
                    $(firstInvalid).next('.select2-container').find('.select2-selection').focus();
                } else {
                    firstInvalid.focus();
                }
                return;
            }

            $step.removeClass('was-validated');
            jumpToStep(step + 1);
        }

        function prevStep(step) {
            jumpToStep(step - 1);
            $('#stepIndicator' + (step - 1)).removeClass('completed');
        }

        function returnToForm() {
            jumpToStep(1);
        }

        function downloadAdmitCard() {
            if (typeof window.html2pdf === 'undefined' && typeof html2pdf === 'undefined') {
                Swal.fire({
                    title: 'Loading PDF Engine...',
                    text: 'Please wait a moment while we initialize the PDF downloader.',
                    icon: 'info',
                    showConfirmButton: false,
                    timer: 2000
                });
                var s = document.createElement('script');
                s.src = "https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js";
                s.onload = function () {
                    executeDownload();
                    Swal.close();
                };
                document.head.appendChild(s);
                return;
            }
            executeDownload();
        }

        function executeDownload() {
            const element = document.getElementById('printableAdmitCard');
            if (!element) {
                Swal.fire('Error', 'Admit card content not found!', 'error');
                return;
            }

            // Show loading state
            Swal.fire({
                title: 'Preparing your Admit Card...',
                text: 'Please wait while we generate the PDF.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // 1. Remove animation classes that often cause blank captures in html2canvas
            $(element).removeClass('animate__animated animate__zoomIn');
            
            // 2. Prepare options
            const regNo = $('#card_RegNo').text().replace(': ', '').trim() || 'Record';
            const opt = {
                margin: [0.5, 0.5],
                filename: 'AdmitCard_' + regNo + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { 
                    scale: 2, 
                    useCORS: true,
                    logging: false,
                    letterRendering: true,
                    scrollY: 0,
                    scrollX: 0,
                    windowWidth: document.documentElement.offsetWidth
                },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };

            // 3. Capture after a short delay to ensure DOM is settled
            setTimeout(function() {
                html2pdf().set(opt).from(element).save()
                    .then(() => {
                        Swal.close();
                    })
                    .catch(err => {
                        console.error('PDF Error:', err);
                        Swal.close();
                        Swal.fire('Error', 'Failed to generate PDF. Please try again.', 'error');
                    });
            }, 600);
        }

        function initSelect2() {
            $('select').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            // For Bootstrap validation: when select2 value changes, remove invalid state
            $('select').on('change', function() {
                var $form = $(this).closest('.was-validated');
                if ($form.length) {
                    this.checkValidity(); // forces validation visual update on the native select
                }
            });
        }

        $(document).ready(function () {
            
            initSelect2();

            $('#sameAsPermanent').change(function() {
                if(this.checked) {
                    $('textarea[name="COMMUNICATION_ADDRESS"]').val($('textarea[name="PERMANENT_ADDRESS"]').val());
                }
            });

            // Image preview (no base64 - just show local preview)
            $('#photoInput').on('change', function() {
                const file = this.files[0];
                if (file) {
                    const previewUrl = URL.createObjectURL(file);
                    $('#imgPreview').attr('src', previewUrl);
                    $('#photoPreview').show();
                    $('#card_Photo').attr('src', previewUrl);
                }
            });

            function autofillFromRecord(data) {
                $('select[name="SALUTATION"]').val(data.SALUTATION).trigger('change');
                $('input[name="NAME"]').val(data.NAME);
                $('input[name="ROLL_NO"]').val(data.ROLL_NO);
                $('input[name="EMAIL_ID"]').val(data.EMAIL_ID);
                $('input[name="MOBILE_NO"]').val(data.MOBILE_NO);
                $('input[name="DATE_OF_BIRTH"]').val(formatDateForInput(data.DATE_OF_BIRTH));
                $('textarea[name="PERMANENT_ADDRESS"]').val(data.PERMANENT_ADDRESS);
                $('textarea[name="COMMUNICATION_ADDRESS"]').val(data.COMMUNICATION_ADDRESS);
                $('select[name="PROGRAMME"]').val(data.PROGRAMME).trigger('change');
                $('input[name="BATCH"]').val(data.BATCH);
                $('#ddlshift').val(data.STREAM).trigger('change');
                $('select[name="PRESENT_STATUS"]').val(data.PRESENT_STATUS).trigger('change');
                $('input[name="DESIGNATION"]').val(data.DESIGNATION);
                $('input[name="COMPANY"]').val(data.COMPANY);
                $('textarea[name="OTHER_DETAILS"]').val(data.OTHER_DETAILS);

                // Populate Card
                $('#card_Name').text(': ' + (data.SALUTATION || '') + ' ' + (data.NAME || ''));
                $('#card_RegNo').text(': ' + (data.ROLL_NO || ''));
                $('#card_Dob').text(': ' + formatDateForDisplay(data.DATE_OF_BIRTH || ''));
                $('#card_Email').text(': ' + (data.EMAIL_ID || ''));
                
                // Programme Value handling: If it's an ID, try to get the text, otherwise show the saved text
                // Wait a tiny bit for the dropdown to populate before grabbing text
                setTimeout(function() {
                    var progText = $('#ddlProgramme option:selected').text();
                    if(progText && progText.indexOf('--') === -1) {
                         $('#card_Programme').text(': ' + progText);
                    } else {
                         $('#card_Programme').text(': ' + (data.PROGRAMME || ''));
                    }
                }, 500);

                $('#card_PassingYear').text(': ' + (data.BATCH || ''));
                if (data.PHOTO) {
                    var photoSrc = getFullPhotoPath(data.PHOTO);
                    $('#card_Photo').attr('src', photoSrc).show();
                    $('#card_Photo_placeholder').hide();
                    $('#imgPreview').attr('src', photoSrc);
                    $('#photoPreview').show();
                } else {
                    $('#card_Photo').hide();
                    $('#card_Photo_placeholder').show();
                    $('#photoPreview').hide();
                }

                $('#printTimestamp').text(new Date().toLocaleString());
            }

            // Roll Number Check & Autofill
            $('input[name="ROLL_NO"]').on('blur', function () {
                var rollNo = $(this).val();
                if (rollNo) {
                    $.ajax({
                        url: '@Url.Action("CheckRollNo", "Alumnae")',
                        type: 'POST',
                        data: { sRollNo: rollNo },
                        success: function (response) {
                            if (response.ErrorCode == "202") {
                                autofillFromRecord(response.oResult);
                                Swal.fire({
                                    title: 'Record Found!',
                                    text: 'You are already registered. Here is your Admit Card.',
                                    icon: 'info',
                                    confirmButtonText: 'View Admit Card',
                                    confirmButtonColor: '#4361ee'
                                }).then(() => {
                                    jumpToStep(4);
                                });
                            }
                        }
                    });
                }
            });

            // Email Check & Autofill
            $('input[name="EMAIL_ID"]').on('blur', function () {
                var email = $(this).val();
                if (email) {
                    $.ajax({
                        url: '@Url.Action("CheckEmail", "Alumnae")',
                        type: 'POST',
                        data: { sEmail: email },
                        success: function (response) {
                            if (response.ErrorCode == "202") {
                                autofillFromRecord(response.oResult);
                                Swal.fire({
                                    title: 'Record Found!',
                                    text: 'You are already registered with this email. Here is your Admit Card.',
                                    icon: 'info',
                                    confirmButtonText: 'View Admit Card',
                                    confirmButtonColor: '#4361ee'
                                }).then(() => {
                                    jumpToStep(4);
                                });
                            }
                        }
                    });
                }
            });

            $('#alumniForm').on('submit', function (e) {
                e.preventDefault();
                
                var formStep = document.getElementById('step3'); // 3 is the final input step
                if (!this.checkValidity()) {
                    $(formStep).addClass('was-validated');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: 'Please complete all required fields.',
                        showConfirmButton: false,
                        timer: 3000
                    });
                    
                    var firstInvalid = this.querySelector(':invalid');
                    if (firstInvalid) {
                        var stepParent = $(firstInvalid).closest('.form-step');
                        if (stepParent.length && !stepParent.hasClass('active')) {
                            var stepId = stepParent.attr('id').replace('step', '');
                            jumpToStep(parseInt(stepId));
                        }
                        if ($(firstInvalid).is('select') && $(firstInvalid).hasClass('select2-hidden-accessible')) {
                            $(firstInvalid).next('.select2-container').find('.select2-selection').focus();
                        } else {
                            firstInvalid.focus();
                        }
                    }
                    return;
                }

                var data = {};
                $(this).serializeArray().forEach(function (item) {
                    if (item.name !== 'PHOTO_FILE') {
                        data[item.name] = item.value;
                    }
                });
                
                // Map the shift value correctly to the STREAM column
                data['STREAM'] = $('#ddlshift').val();
                data['PROGRAMME'] = $('#ddlProgramme').val();

                data['DATE_OF_BIRTH'] = $('input[name="DATE_OF_BIRTH"]').val();

                // Build FormData for multipart file upload
                var formData = new FormData();
                formData.append('sJsonData', JSON.stringify(data));

                var photoFile = $('#photoInput')[0].files[0];
                if (photoFile) {
                    formData.append('PHOTO_FILE', photoFile);
                }

                const submitBtn = $('#submitBtn');
                const originalText = submitBtn.html();
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2"></span> Submitting...').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("SaveAlumniDataCollection", "Alumnae")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.ErrorCode == "202") {
                            // Populate Card after submission
                            $('#card_Name').text(': ' + (data.SALUTATION || '') + ' ' + (data.NAME || ''));
                            $('#card_RegNo').text(': ' + (data.ROLL_NO || ''));
                            $('#card_Dob').text(': ' + formatDateForDisplay(data.DATE_OF_BIRTH || ''));
                            $('#card_Email').text(': ' + (data.EMAIL_ID || ''));
                            
                            var progText = $('#ddlProgramme option:selected').text();
                            if(progText && progText.indexOf('--') === -1) {
                                $('#card_Programme').text(': ' + progText);
                            } else {
                                $('#card_Programme').text(': ' + (data.PROGRAMME || ''));
                            }
                            
                            $('#card_PassingYear').text(': ' + (data.BATCH || ''));
                            // Use server-returned saved path for card photo
                            if (response.oResult && response.oResult.PHOTO_PATH) {
                                var imgSrc = getFullPhotoPath(response.oResult.PHOTO_PATH);
                                $('#card_Photo').attr('src', imgSrc).show();
                                $('#card_Photo_placeholder').hide();
                                $('#imgPreview').attr('src', imgSrc);
                                $('#photoPreview').show();
                            }
                            $('#printTimestamp').text(new Date().toLocaleString());

                            Swal.fire({
                                title: 'Success!',
                                text: 'Your registration is complete. Here is your Admit Card.',
                                icon: 'success'
                            }).then(() => {
                                jumpToStep(4);
                            });
                        } else {
                            Swal.fire('Error', response.Message || 'Save failed.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Connection failed.', 'error');
                    },
                    complete: function () {
                        submitBtn.html(originalText).prop('disabled', false);
                    }
                });
            });

        });
        // ---- Cascading Dropdown: Level & Stream → Programme → Branch ----
        function loadProgrammes() {
            var levelId = $('#ddlAcademicLevel').val();
            var shiftId = $('#ddlshift').val();
            var $programme = $('#ddlProgramme');
            var $branch = $('#ddlBranch');

            $programme.html('<option value="">-- Loading... --</option>');
            $branch.html('<option value="">-- Select Programme first --</option>');

            if (!levelId || !shiftId) {
                $programme.html('<option value="">-- Select Academic Level & Stream first --</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetProgrammesByLevel", "Alumnae")',
                type: 'POST',
                data: { levelId: levelId, shiftId: shiftId },
                success: function (response) {
                    $programme.html('<option value="">-- Select Programme --</option>');
                    if (response && response.length > 0) {
                        $.each(response, function (i, item) {
                            $programme.append('<option value="' + item.PROGRAMME_GROUP_ID + '">' + item.PROGRAMME_NAME + '</option>');
                        });
                    } else {
                        $programme.html('<option value="">-- No programmes found --</option>');
                    }
                    $programme.trigger('change');
                },
                error: function () {
                    $programme.html('<option value="">-- Error loading programmes --</option>').trigger('change');
                }
            });
        }

        $('#ddlAcademicLevel, #ddlshift').on('change', function () {
            loadProgrammes();
        });

        @*$('#ddlProgramme').on('change', function () {
            var $branch = $('#ddlBranch');
            var programmeName = $(this).val();
            var levelId = $('#ddlAcademicLevel').val();
            var shiftId = $('#ddlshift').val();

            $branch.html('<option value="">-- Loading... --</option>');

            if (!programmeName || !levelId || !shiftId) {
                $branch.html('<option value="">-- Select Programme first --</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetBranchesByProgramme", "Alumnae")',
                type: 'POST',
                data: { levelId: levelId, shiftId: shiftId, programmeName: programmeName },
                success: function (response) {
                    $branch.html('<option value="">-- Select Branch --</option>');
                    if (response && response.length > 0) {
                        $.each(response, function (i, item) {
                            $branch.append('<option value="' + item.PROGRAMME_DESCRIPTION + '">' + item.PROGRAMME_DESCRIPTION + '</option>');
                        });
                        $branch.append('<option value="NA">NA</option>');
                    } else {
                        $branch.html('<option value="">-- No branches found --</option>');
