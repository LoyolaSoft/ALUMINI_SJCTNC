@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}
<div class="col-md-12">
    <br><br>
    <table class="table table-hover table-bordered table-responsive" id="tblCertificatetRequested">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>Contact No</th>
                <th>Programme</th>
                <th>Certificate Type</th>
                <th>Certificate Category</th>
                <th>Month & Year</th>
                <th>Requested Date</th>
                <th>Description</th>
                <th>Approved Date</th>
                <th>Extra info </th>
                <th>Status</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.liCertificateDistribution != null && Model.liCertificateDistribution.Count > 0)
            {
                int count = 0;
                foreach (var item in Model.liCertificateDistribution)
                {
                    <tr marksheetdisid="@item.CERTIFICATE_DISTRIBUTION_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.CONTACT_NO</td>
                        <td>@item.PROGRAMME_NAME</td>
                        <td>@item.CERTIFICATE_NAME</td>
                        <td>@item.CERTIFICATE_TYPE</td>
                        <td>@item.MONTH_OF_SEMESTER @item.YEAR_OF_SEMESTER</td>
                        <td>@item.REQUEST_DATE</td>
                        <td>@item.REASON</td>
                        <td>@item.APPROVED_DATE</td>
                        <td>@item.EXTRA_INFORMATION</td>
                        <td>@item.STATUS_NAME</td>
                    </tr>
                }

            }

        </tbody>
    </table>
</div>

