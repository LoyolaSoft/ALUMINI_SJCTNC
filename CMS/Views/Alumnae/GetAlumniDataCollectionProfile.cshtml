@model CMS.Models.ALUMNI_DATA_COLLECTION

<div class="row">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.PHOTO))
        {
            <img src="@Model.PHOTO.Replace("\\", "/")" alt="Student Photo" class="img-thumbnail" style="max-height: 200px; max-width: 100%;" />
        }
        else
        {
            <div class="well text-center" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                <span>No Photo Available</span>
            </div>
        }
    </div>
    <div class="col-md-8">
        <table class="table table-bordered table-striped" style="margin-bottom: 0;">
            <tbody>
                <tr>
                    <th style="width: 30%;">Name</th>
                    <td>@Model.SALUTATION @Model.NAME</td>
                </tr>
                <tr>
                    <th>Register No</th>
                    <td>@Model.ROLL_NO</td>
                </tr>
                <tr>
                    <th>Programme</th>
                    <td>@Model.PROGRAMME</td>
                </tr>
                <tr>
                    <th>Branch/Stream</th>
                    <td>
                        @{
                            var branch = Model.BRANCH_PHD ?? Model.BRANCH_MPHIL ?? Model.BRANCH_PG ?? Model.BRANCH_UG;
                        }
                        @branch (@Model.STREAM)
                    </td>
                </tr>
                <tr>
                    <th>Batch</th>
                    <td>@Model.BATCH</td>
                </tr>
                <tr>
                    <th>Date of Birth</th>
                    <td>@Model.DATE_OF_BIRTH</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.EMAIL_ID</td>
                </tr>
                <tr>
                    <th>Mobile No</th>
                    <td>@Model.MOBILE_NO</td>
                </tr>
                <tr>
                    <th>Present Status</th>
                    <td>@Model.PRESENT_STATUS</td>
                </tr>
                <tr>
                    <th>Designation</th>
                    <td>@Model.DESIGNATION</td>
                </tr>
                <tr>
                    <th>Company</th>
                    <td>@Model.COMPANY</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="row" style="margin-top: 15px;">
    <div class="col-md-12">
        <table class="table table-bordered table-striped">
            <tbody>
                <tr>
                    <th style="width: 25%;">Permanent Address</th>
                    <td>@Model.PERMANENT_ADDRESS</td>
                </tr>
                <tr>
                    <th>Communication Address</th>
                    <td>@Model.COMMUNICATION_ADDRESS</td>
                </tr>
                <tr>
                    <th>Other Details</th>
                    <td>@Model.OTHER_DETAILS</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
