}
<script src="https://cdn.jsdelivr.net/npm/@symbol/ui/dist/fancybox.umd.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        Fancybox.bind('[data-fancybox="gallery"]', {
            Toolbar: {
                display: ["zoom", "close"]
            },
            loop: true,
            afterLoad: (fancybox, slide) => {
                slide.$content.on('click', function (event) {
                    event.preventDefault();
                });
            }
        });
    });
</script>

