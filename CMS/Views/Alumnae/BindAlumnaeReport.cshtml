                                <td>@item.DATE_OF_BIRTH</td>
                                <td>@item.EMAIL_ID</td>
                                <td>@item.MOBILE_NO</td>
                                <td>@item.ADDRESS</td>
                                <td>@item.COUNTRY</td>
                                <td>@item.AADHAR_NUMBER</td>
                                <td>@item.PAN_NUMBER</td>
                                @if (item.COMPETITIVE_EXAM != "" && item.COMPETITIVE_EXAM != null)
                                {
                                    <td>@item.COMPETITIVE_EXAM</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                @if (item.ANY_OTHER != "" && item.ANY_OTHER != null)
                                {
                                    <td>@item.ANY_OTHER</td>
                                }
                                else
                                {
                                    <td></td>
                                }

