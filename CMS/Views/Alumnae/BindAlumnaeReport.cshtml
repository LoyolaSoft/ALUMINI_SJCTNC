<script>
        ContentLoad = function () {
            $('.selectpicker').selectpicker({
                size: 5
            });
            $('.selectpicker').selectpicker('refresh');

        }


        $('#tblAluEntrepreneurDetails').DataTable();
        $('#tblAluPlacementDetails').DataTable();
        $('#tblAluResearchDetails').DataTable();
        $('#tblAluHigherDetails').DataTable();
        $('#tblAluRegistration').DataTable();
  

        var message=@Html.Raw(Json.Encode(Model.Message));
        if(message!=null && message!="")
        {
            alertMessage(message);
        }
        function alertMessage(Message)
        {
            swal({ title: "error !", text:Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }



        $('button[name="btnGet"]').click(function () {

            var date = $('.tab-pane.fade.active.in').find('input[name="txtDate"]').val();
            var action = $('.tab-pane.fade.active.in').attr('id');
            var title = action.split('Bind');

            if (date && action)
            {
                $.ajax({
                    url: "/Library/" + action + "",
                    type:"post",
                    data:{sDate:date},
                    success:function(data)
                    {

                        if(data.Message!=null)
                        {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        }
                        else
                        {
                            $('#dvGrievanceReport').html('');
                            $('#dvGrievanceReport').append(data);
                            $('#lblReportName').text(title[1].toUpperCase() + "-" + date);
                        }
                    },
                    error:function()
                    {
                        swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    }


                });
            }
            else
            {
                swal({ title: "Error !", text: "Plese select the date!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });






        $('.nav-items').on("click", function () {

            $('#dvGrievanceReport').html('');

        });



    
        var Programme=$('#ProgrammeList').val();
        var Batch=$('#Batch').val();
        var Department=$('#DepartmentList').val();

        function printDiv(divName) {
           
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            loadContent('/Alumnae/AlumnaeReport?sBatch='+Batch+'&sProgramme='+Programme+'&sDepartment='+Department+'');
        }




