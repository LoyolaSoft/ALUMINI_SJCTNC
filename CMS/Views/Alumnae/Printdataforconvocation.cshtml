@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "ClassStudentAttendanceMarkProfile";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<style>
    #ISFORPRINT {
        display: none;
    }
</style>
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ClassWise Convocation Report</li>
    </ol>
    <h1 class="page-header">ClassWise Convocation Report</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ClassWise Convocation Report</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-4 form-group">
                @Html.Label("Programme", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-8">
                    @Html.DropDownListFor(m => m.Programmelist, (Model.Programmelist != null) ? Model.Programmelist : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", })
                    @Html.ValidationMessageFor(m => m.Programmelist, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4 form-group">
                @Html.Label("CONVOCATION SETTING", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-8">
                    @Html.DropDownListFor(m => m.Convocationsettinglist, (Model.Convocationsettinglist != null) ? Model.Convocationsettinglist : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                    @Html.ValidationMessageFor(m => m.Convocationsettinglist, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-2 form-group">
                <div class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" id="progression" name="printtype">
                    <label class="form-check-label" for="progression">Progression</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" id="feedback" name="printtype">
                    <label class="form-check-label" for="feedback">Feedback</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" id="both" name="printtype">
                    <label class="form-check-label" for="both">Both</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" id="ignoreincompletedata" name="printtypeincomplete">
                    <label class="form-check-label" for="ignoreincompletedata">Ignore Incomplete Students</label>
                </div>
            </div>

            <div class="col-md-1 form-group">
                <button class="btn btn-primary" id="btnget">Get</button>
            </div>
            <div class="col-md-1 form-group">
                <div class="col-md-8">
                    <button type="button" onclick="PrintDiv();" class="btn btn-primary" name="get">Print</button>
                </div>
            </div>
            <div class="col-md-12" id="divviewalldata">

            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script>
    function ContentLoad() {

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('Refresh');


    $('#btnget').on('click', viewalldata);

    function viewalldata()
    {
        var pid2 = $('#Programmelist').val().toString();
        var setting2 = $('#Convocationsettinglist').val();
        var selectedRadio = $('input[name="printtype"]:checked').val();

        if (!pid2 || !setting2 || setting2 == '-- Select --') {
            alert("Please select both Programme and Convocation settings.");
            return;
        }

        if (!selectedRadio) {
            alert("Please select a print type option.");
            return;
        }
        $('#page-loader').removeClass('fade in hide');
        $('#page-loader').addClass('fade in ');
        $('#divviewalldata').empty();
        $.ajax({
            url: "@Url.Action("Binddatatoprint", "Alumnae")",
            type: "post",
            data: { sprogrammeid: pid2, sSetting: setting2},
            success: function (data) {
                $('#page-loader').removeClass('fade in');
                $('#page-loader').addClass('fade in hide');
                $('#divviewalldata').empty();
                $('#divviewalldata').append(data);
            },
            error: function (ex) {
                $('#page-loader').removeClass('fade in ');
                $('#page-loader').addClass('fade in hide');
            alert(ex.Message);
        }
    });
    }



    function showAlert(type, message, callback) {
        $('#page-loader').removeClass('fade in').addClass('fade in hide');
        const titles = {
            success: "Success!",
            error: "Error!",
            warning: "Warning!"
        };

        const swalOptions = {
            title: titles[type] || "Notification",
            text: message,
            animation: true,
            type: type
        };

        if (type === "success") {
            swalOptions.showConfirmButton = true;
            swalOptions.confirmButtonText = 'OK';
            swalOptions.timer = 5000;
        } else if (type === "warning") {
            swalOptions.showConfirmButton = true;
            swalOptions.confirmButtonText = 'OK';
        } else {
            swalOptions.timer = 1500;
            swalOptions.showConfirmButton = false;
        }

        swal(swalOptions, function () {
            if (callback) {
                callback();
            }
        });

        if (swalOptions.timer) {
            setTimeout(() => {
                swal.close();
                if (callback) {
                    callback();
                }
            }, swalOptions.timer);
        }
    }


    function showConfirmationAlert(message, callback) {
        const swalOptions = {
            title: "Confirmation",
            text: message,
            animation: true,
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            closeOnConfirm: false,
            closeOnCancel: true
        };

        swal(swalOptions, function (isConfirm) {
            if (isConfirm) {
                if (callback) {
                    callback();
                }
            } else {
                showAlert('info', 'Action cancelled.');
            }
        });
    }


    function PrintDiv() {
        debugger;
        var printWindow = window.open('', '_blank');
        if (!printWindow) {
            alert("Error: Unable to open new window for printing. Please check if pop-up blockers are disabled.");
            return;
        }

        var printDiv = document.getElementById('divviewalldata');
        if (!printDiv) {
            console.error("Error: Element with ID 'divviewalldata' not found.");
            return;
        }
        var printContents = printDiv.innerHTML;
        var canvases = document.getElementsByClassName('sendforprint');
        for (let i = 0; i < canvases.length; i++) {
            const canvas = canvases[i];
            if (canvas) {
                const imgData = canvas.toDataURL("image/png");
                const imgElement = `<img src="${imgData}" alt="Chart">`;
                printContents = printContents.replace(canvas.outerHTML, imgElement);
            } else {
                console.warn(`Warning: No canvas found with class 'sendforprint' at index ${i}.`);
            }
        }
        printWindow.document.open();
        printWindow.document.write(`
    <html>
        <head>
            <title>Print Preview</title>
             <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/js/bootstrap.min.js"><\/script>
<style>
    body {
        font-family: 'Verdana', Times, serif;
        text-align: center;
        margin: 20px;
    }

    h4, h5 {
        margin: 0;
    }

    .text-center {
        text-align: center;
    }
    .hidefornow {
        Display: none !important;;
    }

    .table-bordered > tbody > tr > td,
    .table-bordered > tbody > tr > th,
    .table-bordered > tfoot > tr > td,
    .table-bordered > tfoot > tr > th,
    .table-bordered > thead > tr > td,
    .table-bordered > thead > tr > th {
        font-size: 13px;
    }
</style>
        </head>
<body>
    ${printContents}
    <script>
                        window.print();
                        window.onafterprint = function() { window.close(); };
                    <\/script>
                </body>
            </html>
`);
               // printWindow.document.close();
            }


            /* ('#progressiondiv, #feedbackdiv').hide();
             $('input[name="printtype"]').change(function () {
                 if ($('#progression').is(':checked')) {
                     $('#progressiondiv').show();
                     $('#feedbackdiv').hide();
                 } else if ($('#feedback').is(':checked')) {
                     $('#progressiondiv').hide();
                     $('#feedbackdiv').show();
                 } else if ($('#both').is(':checked')) {
                     $('#progressiondiv, #feedbackdiv').show();
                 }
             });*/

</script>
