@model IEnumerable<CMS.Models.ALUMNI_DATA_COLLECTION>
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-bordered table-striped" id="tblReport" style="width:100%">
                <thead class="bg-primary text-white">
                    <tr>
                        <th width="1%">S.No</th>
                        <th>Name</th>
                        <th>Roll No</th>
                        <th>Programme</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count() > 0)
                    {
                        int sno = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@sno</td>
                                <td>@item.NAME</td>
                                <td>@item.ROLL_NO</td>
                                <td>@item.PROGRAMME</td>
                                <td>@item.CREATED_DATE</td>
                            </tr>
                            sno++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
