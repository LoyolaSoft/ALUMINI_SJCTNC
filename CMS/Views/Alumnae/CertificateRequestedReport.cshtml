
@{
    ViewBag.Title = "CertificateRequestedReport";
}

@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- HTML for loader (hidden initially) -->
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Certificate</a></li>
        <li class="active">Certificate Request Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Certificate Request Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Certificate Request Report</h4>
        </div>

        <div class="panel-body">

            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12 form-horizontal">
                <ul class="nav nav-tabs">
                    <li class="nav-items active" id="BindDateWiseCertificateRequestForm">
                        <a href="#bindDateWiseCertificatedDateWise" data-toggle="tab" class="nav-link active">
                            <span class="d-sm-none">Date Wise Certificate List</span>
                        </a>
                    </li>
                    <li class="nav-items" id="bind">
                        <a href="#bindCertificateLeaveUpdate" data-toggle="tab" class="nav-link">
                            <span class="d-sm-none">Certificate Leave Update</span>
                        </a>
                    </li>
                    <li class="nav-items" id="bindOverall">
                        <a href="#bindOverallReport" data-toggle="tab" class="nav-link">
                            <span class="d-sm-none">Overall Report</span>
                        </a>
                    </li>
                </ul>
                <div class="tab-content">

                    @*Date Wise Certificate List*@
                    <div class="tab-pane fade" id="bindDateWiseCertificatedDateWise">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-6 form-group">
                                    @Html.Label("Start Date", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-8">
                                        <div class="input-group">
                                            <input class="form-control date" id="txtStartDateCR" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    @Html.Label("EndDate", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-8">
                                        <div class="input-group ">
                                            <input class="form-control date" id="txtEndDateCR" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 ">
                                <div class="col-md-5 form-group">
                                    @Html.Label("Status", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-8">

                                        @Html.DropDownListFor(model => model.StatusList, (Model.StatusList != null) ? Model.StatusList : Enumerable.Empty<SelectListItem>(), null, new
                                                {
                                                    @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",
                                                    @data_live_search = "true",
                                                    @data_parsley_required = "true",
                                                    @id = "ddlStatusCR",
                                                    data_dropup_auto = "false",
                                                    data_container = "body",
                                                    @multiple = "multiple",
                                                    @data_actions_box = "true"
                                                })

                                    </div>
                                </div>

                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindCertificateRequestedReport()"> Get </button>
                                </div>

                            </div>
                        </div>

                    </div>

                    @*Certificate Leave Update Report*@
                    <div class="tab-pane fade" id="bindCertificateLeaveUpdate">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-4 form-group">
                                    @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "CLAcYear" })
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindCertificateLeaveUpdateList()"> Get </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*Overall Report*@
                    <div class="tab-pane fade" id="bindOverallReport">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-4 form-group">
                                    @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), null, new
                                        {
                                            @class = "form-control selectpicker show-menu-arrow show-tick drop-down input-sm",
                                            @data_live_search = "true",
                                            @data_parsley_required = "true",
                                            @id = "OverallAcYear",
                                            data_dropup_auto = "false",
                                            data_container = "body",
                                            @multiple = "multiple",
                                            @data_actions_box = "true"
                                        })
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGetOverall" onclick="BindOverallCertificateReport()"> Get </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="row">

                        <div class="col-md-1">
                            <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                        </div>
                    </div>
                    <div id="dvCertificateReport"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>

    function parsevalidDate(str) {
        var parts = str.split("/");
        return new Date(parts[2], parts[1] - 1, parts[0]); // yyyy, mm-1, dd
    }

    // validate when either date changes
    $("#txtStartDateCR, #txtEndDateCR").on("change", function () {
        var fromDateVal = $("#txtStartDateCR").val();
        var toDateVal = $("#txtEndDateCR").val();

        if (fromDateVal && toDateVal) {
            var fromDate = parsevalidDate(fromDateVal);
            var toDate = parsevalidDate(toDateVal);

            if (toDate < fromDate) {
                alert("Leave To Date cannot be earlier than Leave From Date.");
                $("#txtEndDateCR").val(""); // clear invalid value
            }
        }
    });
    // function to convert dd/mm/yyyy → Date
    function parseToDate(str) {
        var parts = str.split("/");
        return new Date(parts[2], parts[1] - 1, parts[0]); // yyyy, mm-1, dd
    }
    $("#txtStartDateCR").on("changeDate", function (e) {
        var fromDate = e.date; // this is already a JS Date
        $("#txtEndDateCR").datepicker("setStartDate", fromDate);
    });


    $(document).ready(function () {
        $('#bindDateWiseCertificatedDateWise').addClass("active in");
        $('.nav-items').on("click", function () {

            $('#dvCertificateReport').html('');

        });
        //$(".date").datepicker({
        //    todayHighlight: true,
        //    autoclose: !0,
        //    endDate: new Date(),
        //    format: "dd/mm/yyyy",
        //    orientation: "right bottom"
        //});
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
        $(".datepicker").datepicker({ format: "dd/mm/yyyy", autoclose: true });
    });

    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $(".date").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )

            }
            handleDatepicker();
        });
    }


</script>

<script>
    $('#AcademicYearList').on('change', function () {
        BindCertificateRequestedReport();
    });

    $('#Shift').on('change', function () {
        BindCertificateRequestedReport();
    });

</script>

<script>

    function BindCertificateRequestedReport()
    {
        if ($('#ddlStatusCR').val() && $('#txtStartDateCR').val() && $('#txtEndDateCR').val())
        {
            $('#loader').show();
            $.ajax({
                url:'@Url.Action("BindCertificateRequestedReportDateWise", "Alumnae")',
                method:'POST',
                datatype:'json',
                data: { sStatus: String($('#ddlStatusCR').val()), sStartDate: $('#txtStartDateCR').val(), sEndDate: $('#txtEndDateCR').val() },
                success: function (data)
                {
                    $('#loader').hide();
                    if (data.Message!=null && data.Message!='')
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    }else
                    {
                        $('.btnPrint').removeClass('hidden');
                        $('.btnExport').removeClass('hidden');
                        $('#dvCertificateReport').empty();
                        $('#dvCertificateReport').append(data);

                        $("#tblCertificatetRequested").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                                , {
                                extend: "excel", className: "btn-sm"
                            }
                                , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": true, "ordering": true
                        });
                    }
                }, eror: function (error)
                {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }
            });
        }

    }
    function BindCertificateLeaveUpdateList()
    {
        if ($('#CLAcYear').val())
        {
            $('#loader').show();
            $.ajax({
                url:'@Url.Action("BindCertificateLeaveUpdate", "Alumnae")',
                method:'POST',
                datatype:'json',
                data: { sAcYear: $('#CLAcYear option:selected').text()},
                success: function (data)
                {
                    $('#loader').hide();
                    if (data.Message!=null && data.Message!='')
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    }else
                    {
                        $('.btnPrint').removeClass('hidden');
                        $('.btnExport').removeClass('hidden');
                        $('#dvCertificateReport').empty();
                        $('#dvCertificateReport').append(data);

                        $("#tblCertificatetRequested").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                                , {
                                extend: "excel", className: "btn-sm"
                            }
                                , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": true, "ordering": true
                        });
                    }
                }, eror: function (error)
                {
                    swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }
            });
        }

    }

    function BindOverallCertificateReport()
    {
        if ($('#OverallAcYear').val())
        {
            $('#loader').show();
            $.ajax({
                url: '@Url.Action("BindCertificateRequestedReportAcademicYearWise", "Alumnae")',
                method: 'POST',
                datatype: 'json',
                data: { sAcYear: $('#OverallAcYear option:selected').map(function() { return "'" + $(this).text().trim() + "'"; }).get().join(',') },
                success: function (data)
                {
                    $('#loader').hide();
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    } else
                    {
                        $('.btnPrint').removeClass('hidden');
                        $('.btnExport').removeClass('hidden');
                        $('#dvCertificateReport').empty();
                        $('#dvCertificateReport').append(data);

                        $("#tblCertificatetRequested").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                                , {
                                extend: "excel", className: "btn-sm"
                            }
                                , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": true, "ordering": true
                        });
                    }
                }, error: function (error)
                {
                    $('#loader').hide();
                    swal({ title: "Warning !", text: "Something went wrong!", showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }
            });
        }
        else
        {
            swal({ title: "Warning !", text: "Please select an Academic Year!", showConfirmButton: false, timer: 3000, type: 'warning', animation: true });
        }
    }

</script>
