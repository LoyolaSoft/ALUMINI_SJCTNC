    function Export() {
        var title = "Certificate_Request_report";

        // get HTML table inside dvCertificateReport
        var table = document.querySelector("#dvCertificateReport table");
        if (!table) {
            alert("No table found inside dvCertificateReport!");
            return;
        }

        // If DataTable exists, temporarily show all rows to export all of them
        var isDataTable = $.fn.DataTable.isDataTable(table);
        var dt;
        var oldPageLen;

        if (isDataTable) {
            dt = $(table).DataTable();
            oldPageLen = dt.page.len();
            dt.page.len(-1).draw(false); // set page length to -1 (All) without resetting paging position
        }

        // convert HTML table to worksheet
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        if (isDataTable) {
            dt.page.len(oldPageLen).draw(false); // restore original page length
        }

        // export workbook to xlsx file
        XLSX.writeFile(wb, title + ".xlsx");
    }


</script>

