@model CMS.ViewModel.ViewModel.LMSViewModel
@{
    Layout = null;
    int No = 0;
}
<table class="col-md-12 table table-hover table-bordered" id="tblAssignments">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Class</th>
            <th>group name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.listudentgroupinfo != null)
        {
            foreach (var item in Model.listudentgroupinfo)
            {
                <tr>
                    <td>@{No++; } @No</td>
                    <td>@item.FIRST_NAME</td>
                    <td>@item.CLASS_NAME</td>
                    <td>@item.GROUP_NAME</td>
                    <td>
                        <a href="#AssignmentSettinggroup" onclick="listlmsgroupinfoforedit(@item.LMS_GROUP_ID);" data-toggle="modal" title="View"><i class="glyphicon glyphicon-edit text-primary"></i></a>
                       
                            <a href="javascrip:;" onclick="GetConfirminfo(@item.LMS_GROUP_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                  
                    </td>
                </tr>
            }

        }
        else
        {
            <tr>
                <td colspan="6">No Assignment Found...!</td>
            </tr>
        }


    </tbody>
</table>
<script>
    function listlmsgroupinfoforedit(ID)
   {
       $.ajax({
           url:"@Url.Action("FetchAssignmentclassGroupInfo", "LMS")",
           method: "POST",
           datatype:"json",
           data: { sgroupid: ID },
           success:function(data)
           {
               if (data.Message != null && data.Message != '')
               {
                   alert(data.Message);
               } else
               {
                   $('#txtassigmnetname').val(data[0].ASSIGNMENT_NAME);
                   $('#groupclass').val(data[0].CLASS_ID);
                   $('#lmsgroupid').val(data[0].LMS_GROUP_ID);
                 //  $('#hdSettingId').val(data[0].ASSIGNMENT_SETTING_ID);
                   $('#groupcourse').val(data[0].COURSE_ID);
                   $('#assigngroupid').val(data[0].GROUP_ID);
                   $('#assigninfo').val(data[0].ASSIGNMENT_INFO);
                   $('.selectpicker').selectpicker('refresh');
               }
           },error:function(error)
           {
               alert('Internal Server Error ! ');
           }
       });
    }

       //edit assignment group
  $('#btnSubmitgroup').on('click', function ()
           {

              var JsonData = null;
             JsonData = '{"GROUP_ID":"' + $('#assigngroupid').val() + '",\
                        "CLASS_ID": "' + $('#groupclass').val() + '", \
                        "COURSE_ID":"' + $('#groupcourse').val() + '",\
                        "LMS_GROUP_ID":"' + $('#lmsgroupid').val() + '"\}';
      $.ajax({
          url:'@Url.Action("UpdateAssignmentGroupInfo", "LMS")',
          method:'POST',
          datatype:'json',
          data: { sUpdateGroupinfo:JsonData },
          success: function (data)
          {
              alert(data.Message);

              Getstudentlist2();



          }, error: function (error)
          {
              alert('Internal Server Error !');
          }
      });

  });
     function GetConfirminfo(ID)
   {
       if (!confirm('Are you sure to delete ?'))
       {
           return false;
       }
       else
       {
           $.ajax({
               url:"@Url.Action("DeleteAssignmentgroupinfo", "LMS")",
               method: "POST",
               datatype:"json",
               data: { sSettingId: ID },
               success:function(data)
               {
                   alert(data.Message);
                   Getstudentlist2();
               },error:function(error)
               {
                   alert('Internal Server Error ! ');
               }
           });
       }
   }
</script>