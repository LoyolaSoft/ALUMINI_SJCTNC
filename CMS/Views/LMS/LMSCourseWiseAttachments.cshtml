function FetchCourseWiseInfo(ID, modalNo) {

    $.ajax({
        url: "@Url.Action("FetchCourseWiseAttachmnet", "LMS")",
        method: "POST",
        datatype: "json",
        data: { sAttachmentId: ID },
        success: function (data) {

            if (data.Message) {
                alert(data.Message);
                return;
            }

            let d = data[0];

            // Get the correct modal
            let modal = $("#AssignmentSetting-dialog" + modalNo);

            modal.find('#txtDescription').val(d.DESCRIPTION);
            modal.find('#CourseAttid').val(d.COURSEWISE_ATTACHMENT_ID);

            modal.find('#CLASSLIST, #excelClass ,#quecls ,#notescls').val(d.CLASS_ID);
            modal.find('#COURSELIST, #excelCourse,#qusCourse,#NotesCourse').val(d.COURSE_ID);

            modal.find('#LMSCLASSNOTES, #ExcelNotes,#QuesNotes,#notesNotes').val(d.NOTES_ID);
            modal.find('#LMSQUESTIONPAPER').val(d.QUESTION_PAPER_ID);
            modal.find('#LMSQUESTIONPAPERTYPE').val(d.QUESTION_PAPER_TYPE_ID);

            modal.find('#txSubject').val(d.SUBJECT);
            modal.find('#txTitle').val(d.TITLE);
            modal.find('#txtunit').val(d.UNIT);
            modal.find('#txthour').val(d.HOUR);
            modal.find('#txtMetod').val(d.METHOD);
            modal.find('#txteexcelunit').val(d.EXCEL_UNIT);
            modal.find('#txtresourse').val(d.RESOURCE);
            modal.find('#txassenment').val(d.ASSESSMENT);
            modal.find('#txrubric').val(d.RUBRIC);
            modal.find('#txother').val(d.ANY_OTHER);
            modal.find('#txttopic').val(d.TOPIC);

            // File
            modal.find('#txtFilePath').val(d.FILE_PATH);

            // Refresh dropdown UI inside modal
            modal.find('.selectpicker').selectpicker('refresh');

            // Show the correct modal
            modal.modal('show');
        }
    });
}

function UpdateCourseWiseINfo(btn) {

    var $btn = $(btn);
    if ($btn.data("busy")) return;
    $btn.data("busy", true).prop("disabled", true);

    var formData = new FormData();

    var fileInput = $('#txtFilePath')[0]?.files[0];
    if (fileInput) {
        formData.append("   ", fileInput);
    }

    var JsonData = {
        COURSEWISE_ATTACHMENT_ID: $('#CourseAttid').val(),
        SUBJECT: $('#txSubject').val(),
        DESCRIPTION: $('#txtDescription').val(),
        TITLE: $('#txTitle').val(),
        UNIT: $('#txtunit').val(),
        QUESTION_PAPER_TYPE_ID: $('#LMSQUESTIONPAPERTYPE').val(),
        QUESTION_PAPER_ID: $('#LMSQUESTIONPAPER').val(),
        CLASS_ID: $('#CLASSLIST').val(),
        NOTES_ID: $('#LMSCLASSNOTES').val(),
        HOUR: $('#txthour').val(),
        METHOD: $('#txtMetod').val(),
        RESOURCE: $('#txtresourse').val(),
        EXCEL_UNIT: $('#txteexcelunit').val(),
        ASSESSMENT: $('#txassenment').val(),
        RUBRIC: $('#txrubric').val(),
        ANY_OTHER: $('#txother').val(),
        COURSE_ID: $('#COURSELIST').val(),
        TOPIC: $('#txttopic').val()
    };

    formData.append("SaveCourseWiseAttachements", JSON.stringify(JsonData));

    $.ajax({
        url: '@Url.Action("UpdateCourseWiseAttachments", "LMS")',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (data) {
            alert(data.Message);
            loadContent('/LMS/LMSCourseWiseAttachments');
        },
        error: function () {
            alert('Internal Server Error!');
        },
        complete: function () {
            // ✅ Unlock button after request completes
            $btn.data("busy", false).prop("disabled", false);
        }
    });
}

</script>


<script>
     $('#CLASSLIST').on('change', function ()
     {
         $.ajax({
             url: '@Url.Action("FetchCourseByClassid", "LMS")',
             method: 'POST',
             datatype: 'json',
             data: { sClassid: $('#CLASSLIST').val()},
             success: function (data)
             {
                 $('#COURSELIST').empty();
                 if (data.Message != null && data.Message != '')
                 {
                     alert(data.Message);
                 } else
                 {
                     $('#COURSELIST').append('<option value="0" >---select---</option>'+data.sResult);
                     $('.selectpicker').selectpicker('refresh');
                 }
             }, error: function (error)
             {
                 alert('Internal Server Error !');
             }
         });
     });


    $('#clsID').on('change', function ()
     {
         $.ajax({
             url: '@Url.Action("FetchCourseByClassid", "LMS")',
             method: 'POST',
             datatype: 'json',
             data: { sClassid: $('#clsID').val()},
             success: function (data)
             {
                 $('#CourseID').empty();
                 if (data.Message != null && data.Message != '')
                 {
                     alert(data.Message);
                 } else
                 {
                     $('#CourseID').append('<option value="0" >---select---</option>'+data.sResult);
                     $('.selectpicker').selectpicker('refresh');
                 }
             }, error: function (error)
             {
                 alert('Internal Server Error !');
             }
         });
     });

</script>


    <script>
        function BindLMSPage() {
            var clsId = $("#clsID").val();
            var courseId = $("#CourseID").val();
            var noteId = $("#NotedID").val();

            $.ajax({
                 url: '@Url.Action("BingCourseWiseAttachmentsbyNotes", "LMS")',
                type: 'GET',
                data: {
                    CLASS_ID: clsId,
                    COURSE_ID: courseId,
                    NOTES_ID: noteId
                },
                success: function (data) {
                    $("#tblcontent").html(data);
                }
            });
        }
    </script>
