    function DeleteLMS(id)
            {
            if (!confirm('Are you sure to delete ?'))
            {
                return false;
            }
            $.ajax({
                url: '@Url.Action("DeleteCourseWiseAttachments", "LMS")',
                method: 'POST',
                datatype: 'json',
                data: { sCWId: id },
                success: function (data)
                {
                    alert(data.Message + "\n");
                    loadContent('/LMS/LMSCourseWiseAttachments');
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }


            });
    }


