@model CMS.ViewModel.ViewModel.LMSViewModel
@{
    ViewBag.Title = "LMSAnnouncementList";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">LMS Announcement List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">LMS Announcement List<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">LMS Announcement List</h4>
                </div>
                <div class="panel-body">
                    <input id="announceid" hidden />
                    <input id="date" hidden />

                    <div class="col-md-12 form-horizontal">
                        <!--<div class="col-md-6 form-group" style="font-size:18px;">
                            @Html.Label("Over All", htmlAttributes: new { @class = "col-md-4 control-label" })
                            <div class="col-md-6">
                                <div class="form-group">-->
                                    @*@Html.LabelFor(model => model.IsLeft, htmlAttributes: new { @class = "control-label col-md-4" })*@
                                    <!--<div class="col-md-8" style="padding-top:9px;">
                                        <input style="width:27px; height:19px;" type="checkbox" id="choverall" value="1" />
                                    </div>
                                </div>
                            </div>
                        </div>-->
                        <div class="col-md-6 form-group" style="font-size:18px;">
                            @Html.Label("Class Wise", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-6">
                                <div class="form-group">
                                    @*@Html.LabelFor(model => model.IsLeft, htmlAttributes: new { @class = "control-label col-md-4" })*@
                                    <div class="col-md-8" style="padding-top:9px;">
                                        <input style="width:27px; height:19px;" type="checkbox" id="chclasswise" value="2" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>


                    <div class="col-md-12">
                        <div class="form-horizontal" id="overallhide" data-parsley-validate="true">

                            <div class="form-group col-md-12" style="background-color:#fff;">
                                <h4>Overall Announcement </h4>
                                <hr style="height:2px;background-color:black">
                                <div class="col-md-6">

                                    <div class="form-group col-md-12">
                                        @Html.Label("Overall Annoucesment", htmlAttributes: new { @class = "col-md-4 control-label" })

                                        <div class="col-md-8">
                                            <textarea class="form-control" cols="60" data-limit-rows="true" data-parsley-maxlength="500" data-parsley-required="true" id="txtoverall" placeholder="Enter Announcements" rows="5">

                                            </textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>


                        </div>

                        <div class="form-horizontal" id="classwisehide" data-parsley-validate="true">
                            <h2>Classwise Announcement</h2>
                            <hr style="height:2px;background-color:black">
                            <div class="form-group col-md-12" style="background-color:#fff;">
                                <div class="col-md-6">

                                    <div class="form-group col-md-12">
                                        @Html.Label("Class", htmlAttributes: new { @class = "col-md-4 control-label" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-12" style="background-color:#fff;">
                                <div class="col-md-6">

                                    <div class="form-group col-md-12">
                                        @Html.Label("Courses", htmlAttributes: new { @class = "col-md-4 control-label" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-12" style="background-color:#fff;">
                                <div class="col-md-6">

                                    <div class="form-group col-md-12">
                                        @Html.Label("Message", htmlAttributes: new { @class = "col-md-4 control-label" })
                                        <div class="col-md-8">
                                            @*<input class="form-control input-sm text-box single-line" data-parsley-required="true" id="txtMsg" placeholder="Enter Classwise Announcements" type="text" value="">*@
                                       <textarea class="form-control input-sm text-box single-line" data-parsley-required="true" id="txtMsg" placeholder="Enter Classwise Announcements" type="text"></textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div id="savehide">
                            <div class="form-group pull-right">
                                <div class="col-md-12 pull-right">
                                    <a id="btnSubmit" value="Submit" class="btn btn-primary" href="javascript:;">Submit</a>
                                    <a id="btnCancel" value="Cancel" class="btn btn-danger" href="javascript:;">Cancel</a>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <br />
                        <div class="col-md-12" id="BindAnnouncmentlist">

                        </div>
                    </div>
                </div>


            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    $('#choverall').on('change', function (e) {
        $("#chclasswise").removeAttr('checked');
        $('#classwisehide').addClass('hidden');

        $('#overallhide').removeClass('hidden');
        if ($(this).prop("checked")) {
            $('#overallhide').show();
            $('#savehide').removeClass('hidden');
            Bindannouncementlist();

        }
        else {
            $('#overallhide').hide();
            $('#BindAnnouncmentlist').empty();
            //$('#save').hide();
        }

    });
    $('#chclasswise').on('change', function (e) {
        $("#choverall").removeAttr('checked');
        $('#overallhide').addClass('hidden');
        $('#BindAnnouncmentlist').empty();
        $('#classwisehide').removeClass('hidden');
        if ($(this).prop("checked")) {
            $('#classwisehide').show();
            $('#savehide').removeClass('hidden');
            Bindannouncementlist();
        }
        else {
            $('#classwisehide').hide();
            //$('#save').hide();
        }
    });
       function Bindannouncementlist() {
           var announcetype = $('#chclasswise').is(":checked") ? "2" : "1";
           $.ajax(
               {
                   /**/
                   url: "@Url.Action("BindLMSCourseWiseandOverallAnnouncement", "LMS")",
                   /**/
                   method: "POST",
                   data: { announcementType: announcetype },
                   success: function (data) {
                       var ddl = $('#BindAnnouncmentlist');
                       ddl.empty();

                       ddl.append(data);

                       $('.selectpicker').selectpicker('refresh');
                   }, error: function (error) {
                       alert('Internal Server Error !!');
                   }
               });
       }
</script>

<script>
    $(document).ready(function () {
        lpage();


    });
    function lpage() {
        $('#savehide').addClass('hidden');
        $('#overallhide').addClass('hidden');
        $('#classwisehide').addClass('hidden');
        $("#chclasswise").removeAttr('checked');
        $("#choverall").removeAttr('checked');
    }
</script>



<script>


    // get course list by class id


    $("#ClassList").on("change", function ()
    {


        var inp = $('#ClassList').val();

            $.ajax({
                url: "@Url.Action("FetchcourselistByclassId", "LMS")",
                type: "post",
                data: { sClassId: inp},
                datatype: "json",
                success: function (option)
                {

                    $('#CourseList').empty();
                    $('#CourseList').append("<option value='0'>--select--</option>" + option.sResult);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error)
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                }
            });
        });




    $("#btnSubmit").on("click", function ()
    {
        //var txtoverall = $('#txtoverall').val();

        var sannounceid = $('#announceid').val();
        var sclassid = $('#ClassList').val();
        var sCourseid = $('#CourseList').val();

        //var smsg = $('#txtMsg').val();


        var Overallannouncetype = $('#choverall').is(":checked") ? "1" : "2";

        if (Overallannouncetype == 1) {

            var smsg = $('#txtoverall').val();
        }
        else {
            var smsg = $('#txtMsg').val();
        }
        var Jsondata = '{  "ANNOUNCEMENT_ID":"' + sannounceid + '","CLASS_ID":"' + sclassid + '",\
                "COURSE_ID":"' + sCourseid + '","MESSAGE":"' + smsg + '","ANNOUNCEMENT_TYPE": "' + Overallannouncetype + '",\
                 }';
        if (Overallannouncetype != null && Overallannouncetype != "")
        {
           $.ajax(
           {
                url: "@Url.Action("SaveLMSannouncements", "LMS")",
                   type: "post",
                   data: { sJson: Jsondata},
                   datatype: "json",

                success: function (data)
                {
                    if (data.ErrorCode != null && data.ErrorCode != "")
                    {
                        if (data.ErrorCode == "200")
                        {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });

                            lpage();
                        }
                        if (data.ErrorCode == "400")
                        {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                        }
                    }
                    else
                    {
                        if (data.Message != null && data.Message != "")
                        {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                        }
                    }

                },
                error: function (error)
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                }
           });
        }
     });
</script>


