@model CMS.ViewModel.ViewModel.LMSViewModel
@using CMS.Utility
@{
    ViewBag.Title = "Add LMS Course Wise Attachments";

    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />

<link href="~/Content/assets/css/animate.min.css" rel="stylesheet" />

<style>
    .fileinput-button input {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        opacity: 0;
        -ms-filter: 'alpha(opacity=0)';
        font-size: 200px !important;
        direction: ltr;
        cursor: pointer;
    }

    button, input, optgroup, select, textarea {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
    }

    .btn {
        font-weight: 600;
        line-height: 20px;
        padding: 6px 12px;
        transition: all .1s ease-in-out;
        box-shadow: none !important;
    }

        .btn:not(:disabled):not(.disabled) {
            cursor: pointer;
        }

    .fileinput-button {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .btn, .input-group-addon:focus {
        outline: 0 !important;
    }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Add LMS Course Wise Attachments</li>
    </ol>
    <h1 class="page-header">Add LMS Course Wise Attachments</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Add LMS Course Wise Attachments</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <br /><br />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="col-lg-12 form-group row">
                <a class="hidden" title="Click to Add" href="#coursewiseatt" id="btncoursewiseatt" data-toggle="modal">Add</a>
                <input type="text" id="coursewiseattid" hidden />
                <div class="row">

                    <div class="form-group col-md-4 col-sm-12">
                        @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.CLASSLIST,
                                 Model.CLASSLIST ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.CLASSLIST, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-4 col-sm-12">
                        @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.COURSELIST,
                                 Model.COURSELIST ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.COURSELIST, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-4 col-sm-12">
                        @Html.Label("Class Notes", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.LMSCLASSNOTES,
                                 Model.LMSCLASSNOTES ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                            @Html.ValidationMessageFor(model => model.LMSCLASSNOTES, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>



                <div class="row">

                    <div class="form-group col-md-4 col-sm-12" id="unitContainer">
                        @Html.Label("Unit No", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.UNITLIST,
                                 Model.UNITLIST ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.UNITLIST, "", new { @class = "text-danger" })
                        </div>
                    </div>


                    @*<div class="form-group col-md-4 col-sm-12" id="unitContainer">
                        @Html.Label("Unit No.", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.UNITLIST,
                                 Model.UNITLIST ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.UNITLIST, "", new { @class = "text-danger" })
                        </div>
                    </div>*@



                    <!-- Row 3 -->


                    <div class="form-group col-md-4 col-sm-12" id="unitNameContainer">
                        @Html.Label("Unit Name", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtsubject" placeholder="Subject" />
                        </div>
                    </div>

                    <div class="form-group col-md-4 col-sm-12" id="unitTopicContainer">
                        @Html.Label("Sup Topic", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txttitle" placeholder="Title" />
                        </div>
                    </div>

                </div>


                <div class="row">

                    <div class="form-group col-md-4 col-sm-12" id="QuePaperContainer">
                        @Html.Label("Question Paper", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.LMSQUESTIONPAPER,
                                 Model.LMSQUESTIONPAPER ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.LMSQUESTIONPAPER, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-4 col-sm-12" id="QuesTypeContainer">
                        @Html.Label("Question Paper Type", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.LMSQUESTIONPAPERTYPE,
                                 Model.LMSQUESTIONPAPERTYPE ?? Enumerable.Empty<SelectListItem>(),
                                 "--select--",
                                 new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.LMSQUESTIONPAPERTYPE, "", new { @class = "text-danger" })
                        </div>
                    </div>


                    <!-- Row 3 -->


                </div>


                <div class="row">


                    <!-- SHOW/HIDE THIS (Excel Upload) -->
                    <div class="form-group col-md-4 col-sm-12" id="ExcelUploadContainer">
                        @Html.Label("Upload Excel", htmlAttributes: new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            <input type="file" id="ExcelUploadFile" name="ExcelUploadFile"
                                   class="form-control input-sm" accept=".xls,.xlsx" />
                            <span class="text-danger" id="ExcelUploadError"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4 col-sm-12" id="ExcelDownloadContainer">
                        <a href="~/Content/ExcelTemplate/lms_instruction_plan.xlsx" class="btn btn-success btn-sm">
                            <i class="fa fa-download"></i> Download Template
                        </a>

                    </div>

                </div>

                <!-- Row 4 -->


                <div class="form-group col-md-12" id="unitDescContainer">
                    @Html.Label("Description", htmlAttributes: new { @class = "col-md-2 control-label" })

                    <div class="col-md-10">
                        <form action="" method="POST" name="summernote_form" class="table-bordered">
                            <input type="text" class="summernote table-bordered" name="content" id="txtdescription" maxlength="612" />
                        </form>
                    </div>

                </div>




                <div class="form-group col-lg-12" id="attachmentContainer">

                    <div class="col-md-2">
                        @Html.Label("Attachments", htmlAttributes: new { @class = "col-md-3 control-label " })
                    </div>


                    <div class="col-md-6">

                        <span class="btn btn-primary fileinput-button m-r-3">
                            <i class="fa fa-plus"></i>
                            <span>
                                Add files...
                                <input type="file" name="files[]" multiple id="fAttachment" onchange='readmultifiles()'>
                            </span>
                        </span>

                    </div>

                </div>
            </div>
            <div class="panel-body" id="tblcontainer">
                <!-- begin table-responsive -->
                <div class="col-md-12 table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>PREVIEW</th>
                                <th>FILE INFO</th>
                                <th width="50%">UPLOAD PROGRESS</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody class="files">
                            <tr data-id="empty" style="display: none;" id="trEmpty">
                                <td colspan="4" class="text-center text-muted p-t-30 p-b-30">
                                    <div class="m-b-10"><i class="fa fa-file fa-3x"></i></div>
                                    <div>No file selected</div>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                <!-- end table-responsive -->
            </div>
            <div class="form-group col-lg-12 row">

                <div class="form-group pull-right">
                    <div class="col-md-4">
                        <a href="javascript:;" id="btnPost" onclick="" class="btn btn-primary">Save</a>
                    </div>

                    <div class="col-md-4">
                        <a href="javascript:;" id="btnCancel" onclick="" class="btn btn-danger">Cancel</a>
                    </div>
                </div>

            </div>



        </div>
    </div>
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script>

    ContentLoad = function () {
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
        handleSummernote();
        $("#btncoursewiseatt").click();
    }

    // var progressbar = $("#progressbar"),
    //    progressLabel = $(".progress-label");

    handleSummernote = function () {
        $(".summernote").summernote({
            placeholder: "Add a Description"
        })
    }
    $('.note-editable').css("width", "882");

    function readmultifiles() {
        var totalFiles = document.getElementById('fAttachment').files.length;
        if (totalFiles > 0) {
            $('#trEmpty').empty();
        }
        var files = document.getElementById('fAttachment').files;
        // Read first file
        setup_reader(files, 0);
    }

    function setup_reader(files, i) {
        var file = files[i];
        var name = file.name;
        var reader = new FileReader();
        reader.onloadend = function (e) {
            readerLoaded(e, files, i, name);
        };
        reader.readAsBinaryString(file);
        // After reading, read the next file.
    }

    function readerLoaded(e, files, i, name) {
        var Dom = $('.files');
        var _size = files[i].size;
        var extension = GetFileExtension(files, i);
        var size = GetFileSize(files, i);
        var iProgress = GetProgressRate(_size);



        if (size != null && size != '') {
            var actualFileDom;
            if (extension != null && extension != '') {
                if (extension == 'jpg' || extension == 'png') {
                    actualFileDom = "<img src=" + window.URL.createObjectURL(files[i]) + " width=77 height=80></img>";
                }
                else {
                    actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                }
                var filedom = AppendFileDom(actualFileDom, name, size, iProgress, files, i);
                Dom.append(filedom);
            }
        }

        // get file content
        var bin = e.target.result;
        // do sth with text


        // If there's a file left to load
        if (i < files.length - 1) {
            // Load the next file
            setup_reader(files, i + 1);

        }
    }





    function GetFileExtension(files, i) {
        // Get uploaded file extension
        var extension = files[i].name.split('.').pop().toLowerCase();
        var validFileExtensions = ['doc', 'docx', 'pdf', 'jpg', 'png', 'txt', 'xlsx'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            alert("Sorry!! Upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file")
            //$(this).replaceWith($(this).val('').clone(true));
            return extension = null;
        }
        else {
            return extension;
        }

    }

    function GetFileSize(files, i)
    {

        var _size = files[i].size;
        var fileSize = _size;
        var fSExt = new Array('Bytes', 'KB', 'MB', 'GB'),
            i = 0; while (_size > 900) { _size /= 1024; i++; }
        var exactSize = (Math.round(_size * 100) / 100) + ' ' + fSExt[i];

        if (fileSize > 1024000000)
        {
            alert("Sorry!! Max allowed file size is 100 mb");
            // Clear fileuload control selected file
            // $(this).replaceWith($(this).val('').clone(true));
            return exactSize = null;

        }
        else {
            return exactSize;
        }

    }


    $('#CLASSLIST').on('change', function ()
        {
            $.ajax({
                url: '@Url.Action("FetchCourseByClassid", "LMS")',
                method: 'POST',
                datatype: 'json',
                data: { sClassid: $('#CLASSLIST').val()},
                success: function (data)
                {
                    $('#COURSELIST').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#COURSELIST').append('<option value="0" >---select---</option>'+data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        });



    $('#btnCancel').on("click", function () {
        $('.selectpicker').selectpicker('refresh');
        $('#Pbody').parsley().reset();
    });

    $('#btnPost').on("click", function () {

        var isValid = true;
        if ($('#Pbody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }
        var sid = $('#coursewiseattid').val();
        var class1 = $('#CLASSLIST').val();
        var course = $('#COURSELIST').val();
        var unit = $('#UNITLIST').val();
        var classNotes = $('#LMSCLASSNOTES').val();
        var sub = $('#txtsubject').val();
        var tit = $('#txttitle').val();
        var qusPaperType = $('#LMSQUESTIONPAPERTYPE').val();
        var qusPaper = $('#LMSQUESTIONPAPER').val();

        //var str = btoa(SummerNote);
        var SummerNote = $('#txtdescription').summernote('code');
        var HtmlContent = encodeURI(SummerNote);
        formData.append('sHtml', HtmlContent);
        // var GrievanceContent = $($("#txtGrievanceContent").summernote("code")).text();

        var JsonData = '{"COURSEWISE_ATTACHMENT_ID":"' + sid + '","CLASS_ID":"' + class1 + '",\
                         "COURSE_ID":"' + course + '","UNIT":"' + unit + '","NOTES_ID":"' + classNotes + '","QUESTION_PAPER_TYPE_ID":"' + qusPaperType + '","QUESTION_PAPER_ID":"' + qusPaper + '","SUBJECT":"' + sub + '","TITLE": "' + tit + '"}';
        formData.append("sJsonData", JsonData);

        // ✅ EXCEL FILE
        let excelFile = $("#ExcelUploadFile")[0]?.files[0];
        if (excelFile) {
            formData.append("ExcelFile", excelFile);
        }

        // ✅ MULTIPLE PDF / OTHER FILES
        let files = $("#fAttachment")[0]?.files;
        if (files && files.length > 0) {
            for (let i = 0; i < files.length; i++) {
                formData.append("Files", files[i]); 
            }
        }

        $.ajax({
            url: "/LMS/SaveCourseWiseAttachements",
            type: "post",
            data: formData,
            contentType: false,
            processData: false,
            datatype: "json",
            success: function (result) {
                alert(result.Message)
                loadContent('/LMS/AddCourseWiseAttachments');
            },
            error: function (ex) {
                alert(ex.statusText)
            }
        });


        $('.selectpicker').selectpicker('refresh');
        $('#Pbody').parsley().reset();

    });

    $('#btnCancel').on("click", function () {
        $('.selectpicker').selectpicker('refresh');
        $('#Pbody').parsley().reset();
    });

    function FileCancel(rowId) {

        var row = document.getElementById(rowId);
        formData.delete(rowId);
        row.parentNode.removeChild(row);

    }
</script>


<script>
    $(document).ready(function () {

        function toggleUnitDropdown() {
            let selectedValues = $("#LMSCLASSNOTES").val() || [];
            
            // Handle case where val() returns a single string (if not multiple) or null
            if (!Array.isArray(selectedValues)) {
                selectedValues = [selectedValues];
            }

            // Check if "2" (Unit) is in the selected values
            if (selectedValues.includes("2")) {
                $("#unitContainer").show();
                $("#unitNameContainer").show();
                $("#unitDescContainer").show();
                $("#unitTopicContainer").show();
            } else {
                $("#unitContainer").hide();
                $("#unitDescContainer").hide();
                $("#unitNameContainer").hide();
                $("#unitTopicContainer").hide();
            }

            // Check if "3" (Question Paper) is in the selected values
            if (selectedValues.includes("3")) {
                $("#QuePaperContainer").show();

            }
            else {
                $("#QuePaperContainer").hide();
            }

            // Check if "4" (Excel Upload) is in the selected values
            if (selectedValues.includes("4"))
            {
                $("#ExcelUploadContainer").show();
                $("#ExcelDownloadContainer").show();
                $("#attachmentContainer").hide();
                $("#tblcontainer").hide();

            }
            else
            {
                $("#ExcelUploadContainer").hide();
                $("#ExcelDownloadContainer").hide();
                $("#attachmentContainer").show();
                $("#tblcontainer").show();
            }

        }

        toggleUnitDropdown();


        $("#LMSCLASSNOTES").on("change", function () {
            toggleUnitDropdown();
        });

    });
</script>


<script>
    $(document).ready(function () {

        function toggleQuestionDropdown() {
            let selectedValue = $("#LMSQUESTIONPAPER").val();

            if (selectedValue == "1" || selectedValue == "2") {
                $("#QuesTypeContainer").show();
            } else {
                $("#QuesTypeContainer").hide();
            }
        }

        // On page load
        toggleQuestionDropdown();

        // On change
        $("#LMSQUESTIONPAPER").on("change", function () {
            toggleQuestionDropdown();
        });

    });
</script>



<script>


    //-----------------------------
    // GLOBALS
    //-----------------------------
    let startTimers = {};  // progress animation per file
    var formData = new FormData();

    //-----------------------------
    // CREATE FILE ROW IN TABLE
    //-----------------------------
    function AppendFileDom(fileDom, fileName, exactSize, files, i) {

        let r = Math.random().toString(36).substring(2);

        var filedom =
            "<tr id='" + r + "'>" +
            "<td><span class='preview'>" + fileDom + "</span></td>" +

            "<td><div><dl>" +
            "<dt class='text-inverse'>File Name:</dt>" +
            "<dd class='name'>" + fileName + "</dd>" +
            "<dt class='text-inverse'>File Size:</dt>" +
            "<dd class='size'>" + exactSize + "</dd>" +
            "</dl></div></td>" +

            "<td>" +
            "<div class='progress rounded-corner m-b-15'>" +
            "<div class='progress-bar' id='pb_" + r + "' style='width:1%;'>1%</div>" +
            "</div>" +
            "</td>" +

            "<td>" +
            "<button class='btn btn-default cancel width-100 p-r-20' onclick=\"FileCancel('" + r + "')\">" +
            "<i class='fa fa-trash fa-fw pull-left m-t-2 m-r-5 text-muted'></i>" +
            "<span>Cancel</span></button></td>" +
            "</tr>";

        // append file to formData
        formData.append(r, files[i]);

        // start 10-second animation
        AnimateProgressBar("pb_" + r);

        return filedom;
    }

    //-----------------------------
    // 10 SECOND PROGRESS ANIMATION
    //-----------------------------
    function AnimateProgressBar(pbId) {

        let start = Date.now();
        let duration = 5000;

        startTimers[pbId] = setInterval(function () {

            let elapsed = Date.now() - start;
            let percent = Math.round((elapsed / duration) * 100);

            if (percent < 1) percent = 1;
            if (percent >= 100) percent = 100;

            $("#" + pbId).css("width", percent + "%").text(percent + "%");

            if (percent >= 100)
                clearInterval(startTimers[pbId]);

        }, 100);
    }

    //-----------------------------
    // FILE LOADING
    //-----------------------------
    function readmultifiles() {

        var files = document.getElementById('fAttachment').files;
        if (files.length > 0) $('#trEmpty').empty();

        setup_reader(files, 0);
    }

    function setup_reader(files, index) {

        let file = files[index];
        if (!file) return;

        let reader = new FileReader();

        reader.onloadend = function (e) {
            readerLoaded(e, files, index, file.name);
        };

        reader.readAsArrayBuffer(file);
    }

    function readerLoaded(e, files, i, name) {

        var Dom = $('.files');

        var extension = GetFileExtension(files, i);
        var size = GetFileSize(files, i);

        if (!extension || !size) return;

        let fileDom = "";

        if (extension === 'jpg' || extension === 'png') {
            fileDom = "<img src='" + window.URL.createObjectURL(files[i]) +
                "' width='77' height='80'>";
        } else {
            fileDom = "<span style='color:green;'>" + name + "</span>";
        }

        var fileHtml = AppendFileDom(fileDom, name, size, files, i);
        Dom.append(fileHtml);

        // Load next file
        if (i < files.length - 1) {
            setup_reader(files, i + 1);
        }
    }

    //-----------------------------
    // EXTENSION VALIDATION
    //-----------------------------
    function GetFileExtension(files, i) {

        var ext = files[i].name.split('.').pop().toLowerCase();
        var validExt = ['doc', 'docx', 'pdf', 'jpg', 'png', 'txt', 'xlsx'];

        if ($.inArray(ext, validExt) === -1) {
            alert("Upload only: doc, docx, pdf, jpg, png, txt, xlsx");
            return null;
        }
        return ext;
    }

    //-----------------------------
    // SIZE VALIDATION
    //-----------------------------
    function GetFileSize(files, i) {

        var bytes = files[i].size;
        if (bytes > 100 * 1024 * 1024) {
            alert("Max allowed file size is 100 MB");
            return null;
        }

        var sizes = ['Bytes', 'KB', 'MB', 'GB'];
        var idx = 0;

        while (bytes > 900) {
            bytes = bytes / 1024;
            idx++;
        }

        return (Math.round(bytes * 100) / 100) + ' ' + sizes[idx];
    }

    //-----------------------------
    // REMOVE FILE
    //-----------------------------
    function FileCancel(rowId) {

        if (startTimers["pb_" + rowId])
            clearInterval(startTimers["pb_" + rowId]);

        formData.delete(rowId);
        $("#" + rowId).remove();
    }

</script>


