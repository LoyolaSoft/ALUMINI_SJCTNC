@{
    Layout = null; // No master layout for this page
    ViewBag.Title = ViewBag.CourseTitle;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title - Chat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* Your CSS from the prompt goes here. It's good, no changes needed. */
        body {
            margin: 0;
            padding: 0;
            background: #e5ddd5;
        }

        .chat-container {
            max-width: 1200px;
            margin: 20px auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
        }

        .chat-header {
            background: #075e54;
            color: white;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: #e5ddd5;
        }

        .message {
            margin-bottom: 15px;
        }

            .message.sent {
                text-align: right;
            }

            .message.received {
                text-align: left;
            }

        .message-content {
            display: inline-block;
            padding: 10px 15px;
            border-radius: 8px;
            max-width: 70%;
            word-wrap: break-word;
        }

        .sent .message-content {
            background: #dcf8c6;
            text-align: left;
        }

        .received .message-content {
            background: white;
            text-align: left;
        }

        .message-header {
            font-size: 0.85em;
            margin-bottom: 5px;
        }

        .message-time {
            color: #999;
            margin-left: 8px;
        }

        .chat-input {
            display: flex;
            padding: 15px;
            background: #f0f0f0;
            gap: 10px;
        }

            .chat-input input {
                flex: 1;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 25px;
            }

            .chat-input button {
                padding: 12px 30px;
                border-radius: 25px;
                background: #075e54;
                color: white;
                border: none;
                cursor: pointer;
            }
    </style>
</head>
<body>
    <div class="chat-container">
        <div class="chat-header">
            <div>
                <h4 style="margin: 0;">💬 @ViewBag.CourseTitle</h4>
                <small>Course: <strong>@ViewBag.CourseCode</strong> | User: <strong>@ViewBag.CurrentUser</strong></small>
            </div>
            <a href="javascript:history.back()" class="btn btn-light btn-sm"><i class="fa fa-arrow-left"></i> Back</a>
        </div>
        <div class="chat-messages" id="chatMessages"></div>
        <div class="chat-input">
            <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
            <button id="sendButton" class="btn"><i class="fa fa-paper-plane"></i> Send</button>
        </div>
    </div>

    <!-- REQUIRED JAVASCRIPT LIBRARIES -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script> <!-- Adjust path if necessary -->
    <!-- This special script is auto-generated by SignalR -->
    <script src="~/signalr/hubs"></script>

    <script type="text/javascript">
        $(function () {
            // --- SETUP ---
            const courseCode = "@ViewBag.CourseCode";
            const currentUsername = "@ViewBag.CurrentUser";

            // Get a reference to the server-side Hub. The name 'chatHub' must match your Hub class name.
            const chatHub = $.connection.chatHub;
            const $chatMessages = $('#chatMessages');
            const $messageInput = $('#messageInput');

            // --- CLIENT-SIDE METHODS (What the server can call on the client) ---

            // Create a function that the hub can call to broadcast messages.
            // The name 'receiveMessage' must match the server-side method name 'ReceiveMessage'.
            chatHub.client.receiveMessage = function (sender, message, time) {
                addMessage(sender, message, time);
            };

            // --- START CONNECTION ---

            // Start the connection to the hub.
            $.connection.hub.start().done(function () {
                console.log("Connected to SignalR Hub.");
                // Once connected, call the 'JoinRoom' method on the server.
                chatHub.server.joinRoom(currentUsername, courseCode);

                // Enable the send button
                $('#sendButton').click(sendMessage);
            }).fail(function (err) {
                console.error('Could not connect: ' + err);
            });

            // --- HELPER FUNCTIONS ---
            function sendMessage() {
                const message = $messageInput.val().trim();
                if (message) {
                    // Call the 'SendMessage' method on the hub.
                    chatHub.server.sendMessage(currentUsername, courseCode, message);
                    // Clear the input box and set focus.
                    $messageInput.val('').focus();
                }
            }

            function addMessage(sender, message, time) {
                const messageSide = (sender === currentUsername) ? 'sent' : 'received';

                // HTML Encode the message to prevent XSS
                const encodedSender = $('<div />').text(sender).html();
                const encodedMsg = $('<div />').text(message).html();

                const messageHtml = `
                    <div class="message ${messageSide}">
                        <div class="message-content">
                            <div class="message-header">
                                <strong>${encodedSender}</strong>
                                <span class="message-time">${time}</span>
                            </div>
                            <div>${encodedMsg}</div>
                        </div>
                    </div>`;

                $chatMessages.append(messageHtml);
                // Scroll to the bottom of the chat window
                $chatMessages.scrollTop($chatMessages[0].scrollHeight);
            }

            // Bind the Enter key to send a message
            $messageInput.on('keypress', function (e) {
                if (e.which === 13) { // 13 is the Enter key
                    e.preventDefault();
                    sendMessage();
                }
            });
        });
    </script>
</body>
</html>