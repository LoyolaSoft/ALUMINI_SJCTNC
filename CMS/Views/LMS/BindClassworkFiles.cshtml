@model CMS.ViewModel.ViewModel.LMSViewModel
@{
    Layout = null;
}

<style>
    .panel-purple {
        border-color: #9333ea;
    }

        .panel-purple > .panel-heading {
            background-color: #9333ea;
            color: #fff;
            border-color: #9333ea;
        }

    .panel-indigo {
        border-color: #4f46e5;
    }

        .panel-indigo > .panel-heading {
            background-color: #4f46e5;
            color: #fff;
            border-color: #4f46e5;
        }

    .panel-teal {
        border-color: #14b8a6;
    }

        .panel-teal > .panel-heading {
            background-color: #14b8a6;
            color: #fff;
            border-color: #14b8a6;
        }

    .panel-heading h3 a {
        color: #fff !important;
        text-decoration: none;
    }

        .panel-heading h3 a:hover {
            opacity: 0.9;
        }

    .notes-panel-light {
        background-color: #f8f9fa;
        border-left: 4px solid #6c757d;
    }

        .notes-panel-light .panel-heading {
            background-color: #e9ecef;
            color: #495057;
            font-weight: 600;
        }

            .notes-panel-light .panel-heading a {
                color: #495057 !important;
            }

    .table-hover tbody tr:hover {
        background-color: #f1f3f5;
    }

    .file-icon {
        font-size: 18px;
        color: #dc3545;
        transition: all 0.3s;
    }

        .file-icon:hover {
            color: #c82333;
            transform: scale(1.2);
        }

    .panel-title {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .badge-custom {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        margin-left: 10px;
        background-color: rgba(255,255,255,0.3);
    }
</style>
@if (Model.lilmscoursewiseatt != null && Model.lilmscoursewiseatt.Count() > 0)
{
    var groupedcourse = Model.lilmscoursewiseatt.GroupBy(o => o.COURSE_ID).ToList();
    int courseIndex = 0;
    var courseColors = new string[] {
        "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
        "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
        "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
        "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)",
        "linear-gradient(135deg, #fa709a 0%, #fee140 100%)",
        "linear-gradient(135deg, #30cfd0 0%, #330867 100%)",
        "linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)",
        "linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%)"
    };

<div class="col-md-12">
    <style>


        .courses-container {
            font-family: 'Poppins', sans-serif;
            padding: 20px 0;
        }

        .course-card {
            margin-bottom: 25px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
        }

            .course-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

        .course-header {
            padding: 25px 30px;
            position: relative;
            overflow: hidden;
        }

            .course-header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(255,255,255,0.1);
                opacity: 0;
                transition: opacity 0.3s;
            }

            .course-header:hover::before {
                opacity: 1;
            }

        .course-title {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

            .course-title a {
                color: #fff !important;
                text-decoration: none;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

        .course-icon {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 18px;
        }

        .badge-count {
            background: rgba(255,255,255,0.25);
            backdrop-filter: blur(10px);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            margin-left: 15px;
        }

        .toggle-icon {
            width: 32px;
            height: 32px;
            background: rgba(255,255,255,0.2);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .course-body {
            background: linear-gradient(to bottom, #f8f9fc 0%, #ffffff 100%);
            padding: 25px;
        }

        .notes-card {
            background: #ffffff;
            border-radius: 12px;
            margin-bottom: 15px;
            overflow: hidden;
            border: 2px solid #e9ecef;
            transition: all 0.3s;
        }

            .notes-card:hover {
                border-color: #cbd5e0;
                box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            }

        .notes-header {
            background: linear-gradient(135deg, #f6f8fb 0%, #ffffff 100%);
            padding: 7px 10px;
            border-bottom: 2px solid #f0f2f5;
        }

        .notes-title {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            color: #2d3748;
        }

            .notes-title a {
                color: #2d3748 !important;
                text-decoration: none;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

        .notes-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            color: #fff;
            font-size: 14px;
        }

        .file-count {
            background: #e6f2ff;
            color: #0066cc;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            margin-left: 10px;
        }

        .notes-body {
            padding: 20px;
        }

        /* Table Styles */
        .modern-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

            .modern-table thead {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }

                .modern-table thead th {
                    padding: 16px;
                    font-weight: 600;
                    font-size: 13px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    color: #fff;
                    border: none;
                }

            .modern-table tbody tr {
                transition: all 0.3s;
                border-bottom: 1px solid #f0f2f5;
            }

                .modern-table tbody tr:last-child {
                    border-bottom: none;
                }

                .modern-table tbody tr:hover {
                    background: linear-gradient(to right, #f8f9ff 0%, #ffffff 100%);
                    transform: scale(1.01);
                    box-shadow: 0 3px 10px rgba(102, 126, 234, 0.1);
                }

            .modern-table tbody td {
                padding: 16px;
                font-size: 14px;
                color: #4a5568;
                border: none;
            }

        .serial-number {
            width: 50px;
            text-align: center;
            font-weight: 700;
            color: #667eea;
            font-size: 15px;
        }

        .unit-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .staff-name {
            font-weight: 600;
            color: #2d3748;
        }

        .file-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: #fff;
            border-radius: 10px;
            transition: all 0.3s;
            text-decoration: none;
        }

            .file-link:hover {
                transform: scale(1.15) rotate(5deg);
                box-shadow: 0 5px 15px rgba(245, 87, 108, 0.4);
            }

        .empty-state {
            text-align: center;
            padding: 60px 30px;
            background: linear-gradient(135deg, #f6f8fb 0%, #ffffff 100%);
            border-radius: 12px;
        }

        .empty-icon {
            font-size: 64px;
            color: #cbd5e0;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        .empty-title {
            color: #4a5568;
            font-weight: 600;
            font-size: 20px;
            margin-bottom: 10px;
        }

        .empty-text {
            color: #a0aec0;
            font-size: 14px;
        }

        /* Simple Card Styles for NOTES_ID 1 */
        .simple-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            padding: 10px 0;
        }

        .staff-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fc 100%);
            border-radius: 12px;
            padding: 11px;
            border: 2px solid #e9ecef;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

            .staff-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 4px;
                height: 100%;
                background: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);
            }

            .staff-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                border-color: #a052d9;
            }

        .staff-card-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .staff-avatar {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            font-weight: 700;
            margin-right: 15px;
        }

        .staff-name-title {
            flex: 1;
        }

        .staff-name-text {
            font-size: 16px;
            font-weight: 600;
            color: #2d3748;
            margin: 0;
        }

        .staff-role {
            font-size: 12px;
            color: #a0aec0;
            margin-top: 2px;
        }

        .file-download-btn {
            display: inline-flex;
            align-items: center;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: #fff;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.3s;
            margin-top: 15px;
        }

            .file-download-btn:hover {
                transform: translateX(5px);
                box-shadow: 0 5px 15px rgba(245, 87, 108, 0.3);
                color: #fff;
                text-decoration: none;
            }

            .file-download-btn i {
                margin-right: 8px;
            }

        /* Compact List for NOTES_ID 3 */
        .compact-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .compact-list-item {
            background: #fff;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 12px;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .compact-list-item:hover {
                border-color: #667eea;
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.1);
                transform: translateX(5px);
            }

        .compact-item-content {
            display: flex;
            align-items: center;
            flex: 1;
        }

        .compact-number {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            margin-right: 20px;
        }

        .compact-details {
            flex: 1;
        }

        .compact-title {
            font-weight: 600;
            color: #2d3748;
            font-size: 15px;
            margin-bottom: 5px;
        }

        .compact-meta {
            font-size: 13px;
            color: #a0aec0;
        }

        .compact-file-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: #fff;
            border-radius: 10px;
            transition: all 0.3s;
            text-decoration: none;
        }

            .compact-file-link:hover {
                transform: scale(1.1) rotate(5deg);
                box-shadow: 0 5px 15px rgba(245, 87, 108, 0.4);
            }
    </style>

    <div class="courses-container">
        <div class="panel-group" id="accordion">
            @foreach (var course in groupedcourse)
            {
                courseIndex++;
                var firstCourse = course.First();
                var coursewisefiles = course.ToList();

                var groupeddate = coursewisefiles.GroupBy(o => o.NOTES_ID).ToList();

                var courseAccordionId = "course_" + courseIndex + "_" + firstCourse.COURSE_ID;
                var accordionParentId = "accordion_" + courseIndex + "_" + firstCourse.COURSE_ID;
                var gradientColor = courseColors[(courseIndex - 1) % courseColors.Length];
                int notesIndex = 0;

                <div class="course-card">
                    <div class="course-header" style="background: @gradientColor;"
                         data-toggle="collapse"
                         data-parent="#accordion"
                         href="#@courseAccordionId"
                         aria-expanded="false"
                         style="cursor: pointer;">

                        <h3 class="course-title">
                            <a class="accordion-toggle collapsed"
                               style="display:flex; justify-content:space-between; align-items:center; padding:10px; text-decoration:none; color:inherit; pointer-events: none;">

                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="course-icon">
                                        <i class="fa fa-graduation-cap"></i>
                                    </span>

                                    <span>
                                        @firstCourse.COURSE_CODE - @firstCourse.COURSE_TITLE

                                        <span class="badge-count">@groupeddate.Count Notes</span>

                                    </span>
                                </div>

                                <span class="toggle-icon">
                                    <i class="fa fa-chevron-down"></i>
                                </span>

                            </a>
                        </h3>
                    </div>

                    <div id="@courseAccordionId" class="panel-collapse collapse" aria-expanded="false">
                        <div class="course-body">
                            @if (groupeddate != null && groupeddate.Count > 0)
                            {
                                <div class="panel-group" id="@accordionParentId">
                                    @foreach (var date in groupeddate)
                                    {
                                        notesIndex++;

                                        var firstDate = date.First();

                                        var datecoursewise = date
                                            .Where(f => f.NOTES_ID != "7")   
                                            .ToList();

                                        var notesAccordionId = "notes_" + courseIndex + "_" + notesIndex + "_" + firstDate.NOTES_ID;
                                        var notesId = firstDate.NOTES_ID;

                                        <div class="notes-card">
                                            <div class="notes-header">
                                                <h3 class="notes-title">
                                                    <a class="accordion-toggle collapsed" data-toggle="collapse" data-parent="#@accordionParentId" href="#@notesAccordionId" aria-expanded="false">
                                                        <div style="display: flex; align-items: center;">
                                                            <span class="notes-icon">
                                                                <i class="fa fa-file-text"></i>
                                                            </span>
                                                            <span>
                                                                @firstDate.NOTES_TITLE
                                                                    <span class="file-count">@datecoursewise.Count Files</span>
                                                            </span>
                                                        </div>
                                                        <span class="toggle-icon" style="background: #e9ecef; color: #2d3748;">
                                                            <i class="fa fa-chevron-down"></i>
                                                        </span>
                                                    </a>
                                                </h3>
                                            </div>
                                            <div id="@notesAccordionId" class="panel-collapse collapse" aria-expanded="false">
                                                <div class="notes-body">
                                                    @if (datecoursewise != null && datecoursewise.Count > 0)
                                                    {
                                                        if (notesId == "1")
                                                        {
                                                            <div class="simple-cards-grid">
                                                                @foreach (var file in datecoursewise)
                                                                {
                                                                    <div class="staff-card">
                                                                        <div class="staff-card-header">
                                                                            <div class="staff-avatar">
                                                                                @if (!string.IsNullOrEmpty(file.FIRST_NAME))
                                                                                {
                                                                                    @file.FIRST_NAME.Substring(0, 1).ToUpper()
                                                                                }
                                                                                else
                                                                                {
                                                                                    <text>?</text>
                                                                                }
                                                                            </div>
                                                                            <div class="staff-name-title">
                                                                                <p class="staff-name-text">@file.FIRST_NAME</p>
                                                                                <p class="staff-role">Course Instructor</p>
                                                                            </div>
                                                                        </div>
                                                                        <a href="@file.FILE_PATH" target="_blank" class="file-download-btn">
                                                                            <i class="fa fa-download"></i>
                                                                            Download Material
                                                                        </a>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else if (notesId == "2")
                                                        {
                                                            <table class="modern-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="serial-number">#</th>
                                                                        <th><i class="fa fa-user"></i> Staff</th>
                                                                        <th><i class="fa fa-bookmark"></i> Unit</th>
                                                                        <th><i class="fa fa-tag"></i> Title</th>
                                                                        <th><i class="fa fa-book"></i> Subject</th>
                                                                        <th style="text-align: center;"><i class="fa fa-download"></i> Files</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{
                                                                        int count = 0;
                                                                        foreach (var file in datecoursewise)
                                                                        {
                                                                            count++;
                                                                            <tr>
                                                                                <td class="serial-number">@count</td>
                                                                                <td class="staff-name">@file.FIRST_NAME</td>
                                                                                <td><span class="unit-badge">@file.UNIT</span></td>
                                                                                <td style="font-weight: 500;">@file.TITLE</td>
                                                                                <td>@file.SUBJECT</td>
                                                                                <td style="text-align: center;">
                                                                                    <a href="@file.FILE_PATH" target="_blank" class="file-link" title="Download file">
                                                                                        <i class="fa fa-cloud-download"></i>
                                                                                    </a>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else if (notesId == "3")
                                                        {
                                                            <table class="modern-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="serial-number">#</th>
                                                                        <th><i class="fa fa-user"></i> Staff</th>
                                                                        <th><i class="fa fa-bookmark"></i> Paper </th>
                                                                        <th><i class="fa fa-bookmark"></i> Paper Type</th>
                                                                        <th style="text-align: center;"><i class="fa fa-download"></i> Files</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{
                                                                        int count = 0;
                                                                        foreach (var file in datecoursewise)
                                                                        {
                                                                            count++;
                                                                            <tr>
                                                                                <td class="serial-number">@count</td>
                                                                                <td class="staff-name">@file.FIRST_NAME</td>
                                                                                <td><span class="">@file.PAPER_TITLE</span></td>
                                                                                <td><span class="">@file.TYPE</span></td>

                                                                                <td style="text-align: center;">
                                                                                    <a href="@file.FILE_PATH" target="_blank" class="file-link" title="Download file">
                                                                                        <i class="fa fa-cloud-download"></i>
                                                                                    </a>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else if (notesId == "4")
                                                        {
                                                            <table class="modern-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="serial-number">#</th>
                                                                        <th><i class="fa fa-user"></i> Staff</th>
                                                                        <th><i class="fa fa-bookmark"></i> Unit</th>
                                                                        <th><i class="fa fa-bookmark"></i> Topic</th>
                                                                        <th><i class="fa fa-times"></i> Hour</th>
                                                                        <th><i class="fa fa-bookmark"></i> Method</th>
                                                                        <th><i class="fa fa-bookmark"></i> Rubric</th>
                                                                        <th><i class="fa fa-bookmark"></i> Any Other</th>
                                                                        <th style="text-align: center;"><i class="fa fa-download"></i> Files</th>
                                                                    </tr>
                                                                </thead>

                                                                <tbody>
                                                                    @{
                                                                        int count = 0;

                                                                        if (datecoursewise != null && datecoursewise.Any())
                                                                        {
                                                                            foreach (var file in datecoursewise)
                                                                            {
                                                                                count++;
                                                                                <tr>
                                                                                    <td class="serial-number">@count</td>
                                                                                    <td class="staff-name">@file.FIRST_NAME</td>
                                                                                    <td>@file.EXCEL_UNIT</td>
                                                                                    <td>@file.EXCEL_TOPIC</td>
                                                                                    <td>@file.HOUR</td>
                                                                                    <td>@file.METHOD</td>
                                                                                    <td>@file.RUBRIC</td>
                                                                                    <td>@file.ANY_OTHER</td>

                                                                                    <td style="text-align: center;">
                                                                                        @if (!string.IsNullOrEmpty(file.RESOURCE))
                                                                                        {
                                                                                            <a href="@file.RESOURCE" target="_blank" class="file-link" title="Download file">
                                                                                                <i class="fa fa-cloud-download"></i>
                                                                                            </a>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span>-</span>
                                                                                        }
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <tr>
                                                                                <td colspan="9" style="text-align: center; padding: 80px 20px;">
                                                                                    <div style="font-size: 80px; color: #e9ecef; margin-bottom: 30px;">
                                                                                        <i class="fa fa-cloud-upload"></i>
                                                                                    </div>
                                                                                    <h2 style="color: #4a5568; font-weight: 600; font-size: 28px; margin-bottom: 15px;">
                                                                                        No Files Uploaded
                                                                                    </h2>
                                                                                    <p style="color: #a0aec0; font-size: 16px;">
                                                                                        Course materials and notes will appear here once they are uploaded by instructors.
                                                                                    </p>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>


                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="empty-state">
