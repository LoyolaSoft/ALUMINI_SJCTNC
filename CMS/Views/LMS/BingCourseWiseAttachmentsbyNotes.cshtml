@model CMS.ViewModel.ViewModel.LMSViewModel
@{

    Layout = null;
    int No = 0;

}
@if (Model.listattachmnets != null && Model.listattachmnets.Count > 0)
{
    var groupedNotes = Model.listattachmnets
                            .GroupBy(x => x.NOTES_ID)
                            .ToList();

    foreach (var group in groupedNotes)
    {
        <h4 class="" style="margin-top:20px;">
            Notes: @group.FirstOrDefault().NOTES_TITLE
        </h4>

        <table class="table table-bordered">
            <thead>
                <tr>
                    @switch (group.Key)
                    {
                        case "1":
                            {
                                <th>#</th>
                                <th>Class Name</th>
                                <th>Course Title</th>
                                <th>Notes</th>
                                <th width="10%">File</th>
                                <th>Action</th>
                                break;
                            }

                        case "2":
                            {
                                <th>#</th>
                                <th>Class Name</th>
                                <th>Course Title</th>
                                <th>Notes</th>
                                <th>Unit No.</th>
                                <th>Unit Title</th>
                                <th>Sup Topic</th>
                                <th>Description</th>
                                <th width="10%">File</th>
                                <th>Action</th>
                                break;
                            }

                        case "3":
                            {
                                <th>#</th>
                                <th>Class Name</th>
                                <th>Course Title</th>
                                <th>Notes</th>
                                <th>Question Paper</th>
                                <th>Question Paper type</th>
                                <th>File</th>
                                <th>Action</th>
                                break;
                            }

                        case "4":
                            {
                                <th>#</th>
                                <th>Class Name</th>
                                <th>Course Title</th>
                                <th>Notes</th>
                                <th>Topic</th>
                                <th>Unit</th>
                                <th>Hour</th>
                                <th>Method</th>
                                <th>Resource</th>
                                <th>Rubric</th>
                                <th>Any Other</th>
                                <th>Assessment</th>
                                <th>Action</th>
                                break;
                            }
                    }
                </tr>
            </thead>

            <tbody>


                @foreach (var item in group)
                {
                    <tr>
                        <td>@(++No)</td>

                        @switch (group.Key)
                        {
                            case "1":
                                {
                                    <td>@item.CLASS_NAME</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.NOTES_TITLE</td>

                                    <td>
                                        @{
                                            var files = Model.lilmscoursewiseatt
                                                .Where(o => o.COURSEWISE_ATTACHMENT_ID == item.COURSEWISE_ATTACHMENT_ID)
                                                .ToList();

                                            foreach (var f in files)
                                            {
                                                if (!string.IsNullOrEmpty(f.FILE_PATH))
                                                {
                                                    <a href="@f.FILE_PATH" target="_blank">
                                                        <i class="fa fa-file-pdf-o fa-3x"></i>
                                                    </a>
                                                }
                                            }
                                        }
                                    </td>

                                    <td>
                                        <a href="#AssignmentSetting-dialog1"
                                           onclick="FetchCourseWiseInfo(@item.COURSEWISE_ATTACHMENT_ID, 1)"
                                           data-toggle="modal" class="text-primary">
                                            <i class="fa fa-edit"></i>
                                        </a>


                                        <a href="javascript:;" onclick="DeleteLMS(@item.COURSEWISE_ATTACHMENT_ID)">
                                            <i class="fa fa-trash text-danger"></i>
                                        </a>
                                    </td>

                                    break;
                                }

                            case "2":
                                {
                                    <td>@item.STAFF_NAME</td>
                                    <td>@item.CLASS_NAME</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.NOTES_TITLE</td>
                                    <td>@item.UNIT</td>
                                    <td>@item.SUBJECT</td>
                                    <td>@item.TITLE</td>
                                    <td>@Html.Raw(item.DESCRIPTION)</td>

                                    <td>
                                        @{
                                            var files = Model.lilmscoursewiseatt
                                                .Where(o => o.COURSEWISE_ATTACHMENT_ID == item.COURSEWISE_ATTACHMENT_ID)
                                                .ToList();

                                            foreach (var f in files)
                                            {
                                                if (!string.IsNullOrEmpty(f.FILE_PATH))
                                                {
                                                    <a href="@f.FILE_PATH" target="_blank">
                                                        <i class="fa fa-file-pdf-o fa-3x"></i>
                                                    </a>
                                                }
                                            }
                                        }
                                    </td>

                                    <td>
                                        <a href="#AssignmentSetting-dialog2"
                                           onclick="FetchCourseWiseInfo(@item.COURSEWISE_ATTACHMENT_ID, 2)"
                                           data-toggle="modal" class="text-primary">
                                            <i class="fa fa-edit"></i>
                                        </a>


                                        <a href="javascript:;" onclick="DeleteLMS(@item.COURSEWISE_ATTACHMENT_ID)">
                                            <i class="fa fa-trash text-danger"></i>
                                        </a>
                                    </td>

                                    break;
                                }

                            case "3":
                                {
                                    <td>@item.STAFF_NAME</td>
                                    <td>@item.CLASS_NAME</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.NOTES_TITLE</td>
                                    <td>@item.PAPER_TITLE</td>
                                    <td>@item.TYPE</td>

                                    <td>
                                        @{
                                            var files = Model.lilmscoursewiseatt
                                                .Where(o => o.COURSEWISE_ATTACHMENT_ID == item.COURSEWISE_ATTACHMENT_ID)
                                                .ToList();

                                            foreach (var f in files)
                                            {
                                                if (!string.IsNullOrEmpty(f.FILE_PATH))
                                                {
                                                    <a href="@f.FILE_PATH" target="_blank">
                                                        <i class="fa fa-file-pdf-o fa-3x"></i>
                                                    </a>
                                                }
                                            }
                                        }
                                    </td>

                                    <td>
                                        <a href="#AssignmentSetting-dialog3"
                                           onclick="FetchCourseWiseInfo(@item.COURSEWISE_ATTACHMENT_ID, 3)"
                                           data-toggle="modal" class="text-primary">
                                            <i class="fa fa-edit"></i>
                                        </a>

                                        <a href="javascript:;" onclick="DeleteLMS(@item.COURSEWISE_ATTACHMENT_ID)">
                                            <i class="fa fa-trash text-danger"></i>
                                        </a>
                                    </td>

                                    break;
                                }

                            case "4":
                                {
                                    <td>@item.CLASS_NAME</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.NOTES_TITLE</td>
                                    <td>@item.TOPIC</td>
                                    <td>@item.EXCEL_UNIT</td>
                                    <td>@item.HOUR</td>
                                    <td>@item.METHOD</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.RESOURCE))
                                        {
                                            <a href="@item.RESOURCE" target="_blank" title="Open Resource">
                                                <i class="fa fa-file-pdf-o fa-2x text-danger"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>@item.RUBRIC</td>
                                    <td>@item.ANY_OTHER</td>

                                    <!-- ✅ Assessment File Column -->
                                   
                                    <td>@item.ASSESSMENT</td>

                                 

                                    <!-- ✅ Action Column -->
                                    <td>
                                        <a href="#AssignmentSetting-dialog4"
                                           onclick="FetchCourseWiseInfo(@item.COURSEWISE_ATTACHMENT_ID, 4)"
                                           data-toggle="modal" class="text-primary">
                                            <i class="fa fa-edit"></i>
                                        </a>

                                        <a href="javascript:;" onclick="DeleteLMS(@item.COURSEWISE_ATTACHMENT_ID)">
                                            <i class="fa fa-trash text-danger"></i>
                                        </a>
                                    </td>

                                    break;
                                }
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}
