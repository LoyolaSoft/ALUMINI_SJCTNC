@model CMS.ViewModel.ViewModel.LMSViewModel
@{
    Layout = null;
}
@if (Model.liExamRegistrationList != null && Model.liExamRegistrationList.Count() > 0)
{
    <div class="row">
        @foreach (var item in Model.liExamRegistrationList)
        {
            var listaffs = Model.liClasscoursestaff.Where(o => o.COURSE_ID == item.COURSE_ROOT_ID).ToList();


            <div class="col-md-3 col-sm-6 item">
                <div class="card item-card card-block" style="height:400px;">
                    <h4 class="item-card-title"><i class="material-icons">@item.COURSE_CODE</i></h4>
                    <h5 class="" style="color:black !important;"><i class="material-icons">@item.COURSE_TITLE</i></h5>

                    <img src="~/Content/hcc_img/notes.jpg" alt="Photo of sunset">
                    <h5 class="card-title  mt-3 mb-3">Course Incharges:</h5>
                    @if (listaffs != null && listaffs.Count() > 0)
                    {
                        foreach (var staff in listaffs)
                        {
                            <p>@staff.FIRST_NAME</p>
                        }
                    }

                </div>
            </div>

        }



    </div>
}

