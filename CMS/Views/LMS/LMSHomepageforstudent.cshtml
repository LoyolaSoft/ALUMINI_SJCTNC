                                <div class="stats-content">
                                    <div class="stats-title" style="font-size:16px;color:white;">Class Notes & Files</div>
                                    <div class="stats-number" style="color:#fff;">
                                        <p id="">

                                            @{int isna = 0; }
                                            @if (@Model.lilmscoursewiseatt != null && @Model.lilmscoursewiseatt.Count > 0)
                                            {
                                                isna = @Model.lilmscoursewiseatt.Count();
                                            }

                                            @isna

                                        </p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-12">
                        <a href="javascript:;" onclick="BindClassTest()" style="text-decoration:none">
                            <div class="widget widget-stats bg-gradient-red m-b-10">
                                <div class="stats-icon stats-icon-lg"><i class="far fa-edit fa-fw"></i></div>
                                <div class="stats-content">
                                    <div class="stats-title" style="font-size:16px;color:white;">Class Test</div>
                                    <div class="stats-number" style="color:#fff;">
                                        <p id="">
                                            @{int isn = 0; }
                                            @if (@Model.liQuizSetting != null && @Model.liQuizSetting.Count > 0)
                                            {
                                                isn = @Model.liQuizSetting.Count();
                                            }

                                            @isn


                                        </p>
                                    </div>


                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-12">
                        <a href="javascript:;" onclick="BindAssignment()" style="text-decoration:none">
                            <div class="widget widget-stats bg-gradient-dark-blue m-b-10">
                                <div class="stats-icon stats-icon-lg"><i class="ion-ios-book bg-gradient-red"></i></div>
                                <div class="stats-content">
                                    <div class="stats-title" style="font-size:16px;color:white;">Class Assignment</div>
                                    <div class="stats-number" style="color:#fff;">
                                        <p id="">

                                            @{int isas = 0; }
                                            @if (@Model.liassignmentsetting != null && @Model.liassignmentsetting.Count > 0)
                                            {
                                                isas = @Model.liassignmentsetting.Count();
                                            }

                                            @isas

                                        </p>
                                    </div>


                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-md-9" style="border:2px solid #73AD21;padding:20px;min-height:580px;" id="binddiv">
                    @if (Model.liExamRegistrationList != null && Model.liExamRegistrationList.Count() > 0)
                    {
                        <div class="row">
                            @foreach (var item in Model.liExamRegistrationList)
                            {
                                var listaffs = Model.liClasscoursestaff.Where(o => o.COURSE_ID == item.COURSE_ROOT_ID).ToList();


                                <div class="col-md-3 col-sm-6 item">
                                    <div class="card item-card card-block" style="height:300px;">
                                        <h4 class="item-card-title"><i class="material-icons">@item.COURSE_CODE</i></h4>
                                        <h5 class="" style="color:black !important;"><i class="material-icons">@item.COURSE_TITLE</i></h5>

                                        @*<img src="~/Content/hcc_img/notes.png" alt="Photo of sunset" sty>*@
                                        <h5 class="card-title  mt-3 mb-3">Course Incharges:</h5>
                                        @if (listaffs != null && listaffs.Count > 0)
                                        {
                                            foreach (var staff in listaffs)
                                            {
                                                <p>@staff.FIRST_NAME</p>
                                            }
                                        }

                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


