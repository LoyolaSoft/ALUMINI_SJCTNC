            <div class="row">
                <div class="col-md-3" style="border:2px solid #73AD21;padding:20px;height: 580px;">
                    <div class="col-lg-12">
                        <a href="javascript:;" onclick="BindCourse()" style="text-decoration:none">
                            <div class="widget widget-stats bg-gradient-purple m-b-10">
                                <div class="stats-icon stats-icon-lg"><i class="fa fa-book fa-fw"></i></div>
                                <div class="stats-content">
                                    <div class="stats-title" style="font-size:16px;color:white;">Courses</div>
                                    <div class="stats-number">
                                        <p id="">

                                            @{int iser = 0; }
                                            @if (@Model.liExamRegistrationList != null && @Model.liExamRegistrationList.Count > 0)
                                            {
                                                iser = @Model.liExamRegistrationList.Count();

                                            }

                                            @iser
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-12">
                        <a href="javascript:;" onclick="BindAnnouncements()" style="text-decoration:none">
                            <div class="widget widget-stats bg-gradient-green m-b-10">
                                <div class="stats-icon stats-icon-lg"><i class="fa fa-bullhorn fa-fw"></i></div>
                                <div class="stats-content">
                                    <div class="stats-title" style="font-size:16px;color:white;">Announcements</div>
                                    <div class="stats-number">
                                        <p id="">

                                            @{int isnaa = 0; }
                                            @if (@Model.liAnnouncement != null && @Model.liAnnouncement.Count > 0)
                                            {
                                                isnaa = @Model.liAnnouncement.Count();
                                            }

                                            @isnaa

                                        </p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-12">
                        <a href="javascript:;" onclick="BindClassworks()" style="text-decoration:none">
