<script>
    function BindCourse()
    {

            $.ajax({
                url: "@Url.Action("BindCourses", "LMS")",
                method: "POST",
                datatype: "json",
                data: {},
                success: function (data)
                {
                    $('#binddiv').empty();
                    $('#binddiv').append(data);

                }, error: function (error)
                {

                    swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });


    }
    function BindAnnouncements()
    {

            $.ajax({
