
@model CMS.ViewModel.ViewModel.LMSViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BindLMSCourseWiseAttachmentsHOD";

}

<br />
<div class="">
    <div class="">
        <table class="table table-bordered" id="tbl">
            <thead>
                <tr>

                    <th>#</th>
                    <th>Staff Name</th>
                    <th>Class Name</th>
                    <th>Course Title</th>
                    <th>Unit</th>
                    <th>Subject</th>
                    <th>Title</th>
                    <th>Description</th>


                    <th width="10%">file </th>


                </tr>
            </thead>
            <tbody>
                @if (Model.lilmscoursewiseatt != null && Model.lilmscoursewiseatt.Count > 0)
                {
                    int nCount = 0;

                    var grplicoursewiseatt = Model.lilmscoursewiseatt.GroupBy(o => o.COURSEWISE_ATTACHMENT_ID).ToList();
                    foreach (var item in grplicoursewiseatt)
                    {


                        <tr>

                            <td>@{nCount++;} @nCount</td>
                            <td>@item.FirstOrDefault().STAFF_NAME</td>
                            <td>@item.FirstOrDefault().CLASS_NAME</td>
                            <td>@item.FirstOrDefault().COURSE_TITLE</td>
                            <td>@item.FirstOrDefault().UNIT</td>
                            <td>@item.FirstOrDefault().SUBJECT</td>
                            <td>@item.FirstOrDefault().TITLE</td>

                            <td>@Html.Raw(@item.FirstOrDefault().DESCRIPTION)</td>
                            @{
                                var grpfile1 = Model.lilmscoursewiseatt.Where(o => o.COURSEWISE_ATTACHMENT_ID == item.FirstOrDefault().COURSEWISE_ATTACHMENT_ID
                                          ).ToList();
                                <td>
                                    @foreach (var it in grpfile1)
                                    {
                                        if (it.FILE_PATH != null && it.FILE_PATH != "")
                                        {
                                            <a href="@it.FILE_PATH" target="_blank"><i class="fa fa-file-pdf-o fa-3x"></i></a>

                                        }
                                    }

                                </td>
                            }


                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="text-align:center">No Record Found..!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>





