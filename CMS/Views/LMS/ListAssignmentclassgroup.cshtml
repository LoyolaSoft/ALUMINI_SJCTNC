@model CMS.ViewModel.ViewModel.LMSViewModel
@{
    ViewBag.Title = "ListAssignmentclassgroup";
    Layout = null;
}

<style>
    .hidden{
        display:none;
    }
</style>

<div class="col-md-12 form-horizontal">

    <!-- Class -->
    <div class="col-md-4 form-group">
        <label class="col-md-3 control-label">Class</label>
        <div class="col-md-9">
            @Html.DropDownListFor(m => m.CLASSLIST, (Model.CLASSLIST != null) ? Model.CLASSLIST : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true", @id = "classlist1" })
            @Html.ValidationMessageFor(m => m.CLASSLIST, "", new { @class = "text-danger" })
        </div>
    </div>
    <!-- Course -->
    <div class="col-md-4 form-group">
        <label class="col-md-3 control-label">Course</label>
        <div class="col-md-9">
            @Html.DropDownListFor(m => m.COURSELIST, (Model.COURSELIST != null) ? Model.COURSELIST : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true", @id = "courselist1" })
            @Html.ValidationMessageFor(m => m.COURSELIST, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4 form-group">
        <label class="col-md-3 control-label">Assigment Setting</label>
        <div class="col-md-9">
            @Html.DropDownListFor(m => m.SETTING, (Model.SETTING != null) ? Model.SETTING : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
            @Html.ValidationMessageFor(m => m.SETTING, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-5 form-group ">
        <label class="control-label col-md-3">Assignment Info</label>
        <div class="col-md-9">
            <textarea type="text" class="form-control" id="addionalinfo"></textarea>
        </div>
    </div>
    <div class="col-md-3 form-group">
        <div class="form-check form-check-inline col-md-12">
            <input class="form-check-input" type="checkbox" id="isgroup">
            <label class="form-check-label" for="isgroup">Is Group</label>
        </div>
    </div>
    <div class="col-md-4 form-group hidden" id="classGroupDiv">
        <label class="control-label col-md-3">Class Group</label>
        <div class="col-md-9">
            @Html.DropDownListFor(m => m.CLASS_GROUP, (Model.CLASS_GROUP != null) ? Model.CLASS_GROUP : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
            @Html.ValidationMessageFor(m => m.CLASS_GROUP, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="" id="binddiv">
    </div>


</div>

<script>
    $('#classlist1').on('change', function ()
        {
            $.ajax({
                url: '@Url.Action("FetchCourseByClassidlms", "LMS")',
                method: 'POST',
                datatype: 'json',
                data: { sClassid: $('#classlist1').val()},
                success: function (data)
                {
                    $('#courselist1').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#courselist1').append('<option value="0" >---select---</option>'+data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
    });
    $('#courselist1').on('change', function ()
       {
           $.ajax({
               url: '@Url.Action("Fetchassignmentsettingid", "LMS")',
               method: 'POST',
               datatype: 'json',
               data: { sClassid: $('#classlist1').val(), sCourseid: $('#courselist1').val() },
               success: function (data)
               {
                   $('#SETTING').empty();
                   if (data.Message != null && data.Message != '')
                   {
                       alert(data.Message);
                   } else
                   {
                       $('#SETTING').append('<option value="0" >---select---</option>'+data.sResult);
                       $('.selectpicker').selectpicker('refresh');
                   }
               }, error: function (error)
               {
                   alert('Internal Server Error !');
               }
           });
    });
    $(document).ready(function () {
        $('#isgroup').change(function () {
            if ($(this).is(':checked')) {
                $('#classGroupDiv').removeClass('hidden');
            } else {
                $('#classGroupDiv').addClass('hidden');
            }
        });
    });

    $('#SETTING').on('change', function () {
        Getstudentlist();
    });
    function Getstudentlist() { 
        
            $.ajax({
                url: '@Url.Action("BindstudentlistyClassandCourseId", "LMS")',
                method: 'POST',
                datatype: 'json',
                data: { sClassid: $('#classlist1').val(), settingid: $('#SETTING').val(), sCourseid: $('#courselist1').val() },
                success: function (data)
                {
                    $('#binddiv').empty();
                    $('#binddiv').append(data);

                }, error: function (error)
                {
                    alert('Internal Server Error data null!');
                }
            });
    };
</script>