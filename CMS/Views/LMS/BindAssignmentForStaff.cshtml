@model CMS.ViewModel.ViewModel.LMSViewModel
@{
    Layout = null;
    int No = 0;
}
<table class="col-md-12 table table-hover table-bordered" id="tblAssignments">
    <thead>
        <tr>
            <th>#</th>
            <th>Assignment</th>
            <th>Class</th>
            <th>Course</th>
            <th>Date</th>
            <th>Total</th>
            <th>Submited</th>
            <th>Mark Entry</th>

        </tr>
    </thead>
    <tbody>
        @if (Model.liassignmentsetting != null)
        {
            foreach (var item in Model.liassignmentsetting)
            {
                <tr>
                    <td>@{No++; } @No</td>
                    <td>@item.ASSIGNMENT_NAME</td>
                    <td>@item.CLASS_NAME</td>
                    <td>@item.COURSE_TITLE</td>
                    <td>@item.START_DATE - @item.END_DATE</td>
                    <td>@item.TOTAL</td>
                    <td>@item.SUBMITED</td>

                    <td>
                        @*<a onclick="loadContent('/LMS/BindStudentSubmissionForMarkEntry/@item.ASSIGNMENT_SETTING_ID,@item.CLASS_ID,@item.COURSE_ID')" class="text-primary"><i class="fa fa-edit"></i></a>*@
                        <a onclick="loadContent('@Url.Action("BindStudentSubmissionForMarkEntry","LMS", new { sSettingId = @item.ASSIGNMENT_SETTING_ID,sClassid=@item.CLASS_ID,sCourseId=@item.COURSE_ID})')" class="text-primary"><i class="fa fa-edit"></i></a>
                    </td>
                </tr>
            }

        }
        else
        {
            <tr>
                <td colspan="6">No Assignment Found...!</td>
            </tr>
        }


    </tbody>
</table>


