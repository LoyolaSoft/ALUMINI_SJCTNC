@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "Course Page";
    Layout = null;
    var photoPath = string.Empty;
}


<style>
        .headerS {
            width: 50%;
            margin: 0 auto 30px auto;
            padding: 15px 20px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
            background: #fff;
        }

            .headerS .row {
                align-items: center;
            }

        .name {
            font-size: 28px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .department {
            font-size: 18px;
            color: #34495e;
            margin-bottom: 5px;
            font-weight: 500;
        }

        .contact-info {
            font-size: 15px;
            color: #7f8c8d;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

            .contact-info a {
                color: #3498db;
                text-decoration: none;
                transition: color 0.3s;
            }

                .contact-info a:hover {
                    color: #2c3e50;
                }

        .headerS .row {
            display: flex;
            justify-content: center; /* centers the full block */
            align-items: center; /* vertically aligns photo + text */
            text-align: center; /* makes text center aligned */
        }

        .headerS .col-md-3,
        .headerS .col-md-9 {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center; /* forces both columns to center */
        }


        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #bdc3c7, transparent);
            margin: 30px 0;
        }

        .section-title {
            font-size: 24px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-title i {
                color: #3498db;
            }

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
        }

        .course-card {
            /*        border-radius: 10px;
    */ color: #fff;
            padding: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

            .course-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.12);
            }

            .course-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
            }

        .course-name {
            font-weight: 700;
            font-size: 18px;
            color: #2c3e50;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .course-code {
            color: #7f8c8d;
            font-size: 16px;
            margin: 8px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .course-instructor {
            color: #7f8c8d;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px dashed #e0e6ed;
        }

        .course-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #3498db, #2c3e50);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            margin-bottom: 15px;
        }

        /* Color classes for different cards */
        .color-1 {
            background: linear-gradient(135deg, #3498db, #2980b9);
        }

        .color-2 {
            background: linear-gradient(135deg, #2ecc71, #27ae60);
        }

        .color-3 {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
        }

        .color-4 {
            background: linear-gradient(135deg, #f39c12, #d35400);
        }

        .color-5 {
            background: linear-gradient(135deg, #9b59b6, #8e44ad);
        }

        .color-6 {
            background: linear-gradient(135deg, #1abc9c, #16a085);
        }

        /* Course text colors to be visible */
        .course-name, .course-code, .course-instructor {
            color: #fff;
        }

        @@media (max-width: 768px) {
            .headerS {
                width: 95%;
                margin-bottom: 20px;
            }

            .headerS .row {
                flex-direction: column;
                text-align: center;
            }

            .headerS .col-md-3,
            .headerS .col-md-9 {
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .headerS .col-md-3 {
                margin-bottom: 15px;
            }

            .courses-grid {
                grid-template-columns: 1fr;
            }

            .contact-info {
                flex-direction: column;
                gap: 5px;
            }
        }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active"></li>
    </ol>
    <h1 class="page-header">LMS</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">LMS</h4>
        </div>
        <div class="panel-body" id="Pbody">

            <div class="">
                <div class="headerS">

                    @{
                        if (Model.listAnnouncement != null && Model.listAnnouncement.Count > 0)
                        {
                            photoPath = string.IsNullOrEmpty(@Model.listAnnouncement.FirstOrDefault().PHOTO) ? Url.Content("~/Images/default-user.png") : @Model.listAnnouncement.FirstOrDefault().PHOTO;
                        }
                    }

                    <div class="row">
                        @if (Model.listDepartment != null && Model.listDepartment.Any())
                        {
                            <div class="col-md-3" style="display:flex; justify-content:center;">
                                <img src="@photoPath" class="faculty-photo" alt="Faculty Photo" onerror="this.src='/Images/default-user.png'" style="height: 112px; width: 100px; border-radius: 50px;">
                            </div>

                            <div class="col-md-9">
                                <div class="name">@Model.listDepartment.FirstOrDefault().FIRST_NAME</div>
                                <div class="department">Department of @Model.listDepartment.FirstOrDefault().DEPARTMENT</div>
                                <div class="contact-info">
                                    <span><i class="fa fa-envelope"></i> <a href="@Model.listDepartment.FirstOrDefault().GSUITE_MAIL_ID">@Model.listDepartment.FirstOrDefault().GSUITE_MAIL_ID</a></span>
                                    <span><i class="fa fa-phone"></i>@Model.listDepartment.FirstOrDefault().MOBILE_NO</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12 text-center">
                                <div class="name">Faculty Information Unavailable</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="section-title">
                    <i class="fa fa-book-open"></i> My Courses
                </div>

                <div class="courses-grid">
                    @if (Model.listAnnouncement != null && Model.listAnnouncement.Any())
                    {
                        int colorIndex = 1;

                        foreach (var item in Model.listAnnouncement)
                        {
                            <div class="course-card color-@colorIndex"
                                 style="cursor: pointer;"
                                 onclick="location.href='@Url.Action("CourseAnnouncements", "Lms", new { id = item.COURSE_ID, classId = item.CLASS_ID })'">

                                <div class="d-none">@item.COURSE_ID</div>
                                <div>@item.CLASS_NAME</div>
                                <div class="course-name">@item.COURSE_TITLE</div>
                                <div class="course-code">
                                    <i class="fa fa-code"></i> @item.COURSE_CODE
                                </div>
                                <div class="course-instructor">
                                    <i class="fa fa-user-tie"></i> @item.FIRST_NAME
                                </div>
                            </div>

                            colorIndex = (colorIndex % 6) + 1;
                        }
                    }


                </div>

            </div>
        </div>
    </div>
</div>


<!-- jQuery + Bootstrap -->
<script>
    // JavaScript alternative for dynamic color assignment
    document.addEventListener('DOMContentLoaded', function () {
        const courseCards = document.querySelectorAll('.course-card');
        const colorClasses = ['color-1', 'color-2', 'color-3', 'color-4', 'color-5', 'color-6'];

        courseCards.forEach((card, index) => {
            // Remove any existing color classes
            card.classList.remove(...colorClasses);
            // Add the appropriate color class based on index
            const colorIndex = (index % colorClasses.length) + 1;
            card.classList.add(`color-${colorIndex}`);
        });
    });
</script>


<script>
    $(document).ready(function () {
        $("#loader").show();
        $("#courseData").hide();

        setTimeout(function () {
            $("#loader").fadeOut(300);
            $("#courseData").fadeIn(500);
        }, 1000);
    });
</script>
