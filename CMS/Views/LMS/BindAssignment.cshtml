                var courseId = $(this).attr('cms-CourseId');
                var assigmentId = $(this).attr('cms-assignment-id');
                var sFile = $(this).find('#' + courseId + assigmentId).get(0).files;

                if (sFile.length != 0) {
                    for (var i = 0; i < sFile.length; i++) {

                        fileData.append($(this).attr('cms-CourseId'), sFile[i]);

                        sFlag = true;
                    }
                    sJsonData += '{"ASSIGNMENT_SETTING_ID":"' + $(this).attr('cms-assignment-id') + '",\
                       "COURSE_ID":"' + $(this).attr('cms-CourseId') + '"},';
                    nJsonCount++;
                }
            }

        });
        if (nJsonCount != 0) {
            sJsonData = sJsonData.slice(0, -1);
            sJsonData = sJsonData + "]}";
        }
        if (nJsonCount != 0) {
            swal({
                title: "Please confirm your file selection",
                text: "Make sure you have selected the correct file before submission. If everything is correct, click the Submit button.",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Submit",
                closeOnConfirm: false
            },
                function () {
                    fileData.append('JsonData', sJsonData);
                    $.ajax({
                        url: "/LMS/SaveStuAssignment",
                        type: "post",
                        data: fileData,
                        contentType: false,
                        processData: false,
                        datatype: "json",
                        success: function (result) {
                            if (result.ErrorCode == "200") {
                                swal({ title: "Success !", text: result.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });
                                loadContent('/LMS/LMSHomepageforstudent');
                            }
                            else {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });

                            }
                        },
                        error: function (ex) {
                            swal({ title: "Error !", text: ex.statusText, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                        }
                    });
                });
            $('.selectpicker').selectpicker('refresh');
            $('#Pbody').parsley().reset();
        }
        else {
            swal({ title: "Warning !", text: "Kindly upload your assignment first, then proceed to save..", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
        }

    });

    $('#btnCancel').on("click", function () {
        $('.selectpicker').selectpicker('refresh');
        $('#Pbody').parsley().reset();
        $('#tblassignment tbody tr').each(function () {
            var status = $(this).attr('cms_status');
            if (status != "1") {
                var courseId = $(this).attr('cms-CourseId');
                var assignmentID = $(this).attr('cms-assignment-id');
                var fileInput = document.getElementById(courseId + assignmentID);
                var fileNameDisplay = document.getElementById('fileNameDisplay_' + courseId + assignmentID);
                if (fileInput) {
                    fileInput.value = "";
                }

                if (fileNameDisplay) {
                    fileNameDisplay.textContent = "";
                }
            }
        })
    });




    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblassignment').DataTable({});
        //add
    });
    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#Completeassignment').DataTable({});
        //add
    });
</script>
