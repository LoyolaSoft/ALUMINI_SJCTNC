@model CMS.ViewModel.ViewModel.LMSViewModel
@{

    Layout = null;
    int No = 0;

}
@if (Model.listAnnouncement != null && Model.listAnnouncement.Count > 0)
{
    if (ViewBag.AType == "2")
    {
        <div class="table-responsive">
            <table class="col-md-12 table table-hover table-bordered " id="tblclasswise">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Class Name</th>
                    @*    <th>Course Title </th>*@
                        <th>Date</th>
                        <th>Message</th>

                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.listAnnouncement)
                    {
                        <tr>
                            <td>@{No++; } @No</td>
                            <td>@item.CLASS_NAME</td>
                          @*  <td>@item.COURSE_TITLE</td>*@
                            <td>@item.DATE </td>
                            <td>@item.MESSAGE </td>
                          

                        </tr>
                    }


                </tbody>
            </table>
        </div>
    }
    else
    {
<div class="table-responsive">
    <table class="col-md-12 table table-hover table-bordered " id="tblOverAll">
        <thead>
            <tr>
                <th colspan="3" class="text-center">
                    Over all Message
                </th>
            </tr>
            <tr>
                <th>#</th>

                <th>Date</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.listAnnouncement)
            {
                <tr>
                    <td>@{No++; } @No</td>

                    <td>@item.DATE </td>
                    <td>@item.MESSAGE </td>
                 

                </tr>
            }


        </tbody>
    </table>
</div>

            }
            }
            else
            {
            <br />
            <h3 class="text-danger">No Record's Found...!</h3>

            }



           @* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>*@
            <script>
                $(document).ready(function () {
                    $('#tblOverAll').DataTable({
                        paging: false
                    });
                    $('#tblclasswise').DataTable({
                        paging: false
                    });
                });
            </script>






