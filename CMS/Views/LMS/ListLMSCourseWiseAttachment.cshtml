    function BindcourseAttachedFile()
{
        if ($("#ACDEMICYEAR Option:selected").text() && $("#staffList").val() && $('#ddlSemesterType').val())
        {
            var semType = $('#ddlSemesterType').val();
            //var classid = $('#sClassList').val();
            //var courseid = $("#sCourseList").val();
            var Ac_year = $("#ACDEMICYEAR Option:selected").text();
            var Staff_id = $("#staffList").val();

            $.ajax({
                url: "@Url.Action("BindLMSCourseWiseAttachments", "LMS")",
                method: "POST",
                datatype: "json",
                data: { sStaff_id: Staff_id.toString(), semtype: semType, Ac_year: Ac_year },
                success: function (data) {

                    $('.btnPrint').show();
                    $('.btnExport').show();
                    $('#dvbind').empty();
                    $('#dvbind').append(data);
                    $('#tbl').DataTable({
                        // Proper DataTable initialization
                    });

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            })
        }
}
