
@{
    ViewBag.Title = "ListLMSCourseWiseAttachment";
}

@model CMS.ViewModel.ViewModel.LMSViewModel

@{

    Layout = null;
    string sIcon = string.Empty;
    string sClass = string.Empty;

}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />
<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }
</style>


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">LMS</a></li>
        <li class="active">Course Wise Attachment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Course Wise Attachment<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Course Wise Attachment</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Year</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ACDEMICYEAR, (Model.ACDEMICYEAR != null) ? Model.ACDEMICYEAR : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ACDEMICYEAR, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            @Html.Label("Semester Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <select class="selectpicker form-control" id="ddlSemesterType">
                                    <option value=""> -- Select -- </option>
                                    <option value="1"> Odd Semester </option>
                                    <option value="2"> Even Semester </option>
                                    <option value="3"> Non Semester </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Staff</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.staffList, (Model.staffList != null) ? Model.staffList : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(m => m.staffList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @*<div class="col-md-4" data-step="2" data-intro="Choose Course">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(
                                    m => m.sClassList,
                                    (Model.sClassList != null) ? Model.sClassList : Enumerable.Empty<SelectListItem>(),
                                    null,
                                    new { @class = "form-control selectpicker", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" }
                                )
                                @Html.ValidationMessageFor(m => m.sClassList, "", new { @class = "text-danger" })
                            </div>


                        </div>
                        <div class="col-md-4" data-step="2" data-intro="Choose Course">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.sCourseList, (Model.sCourseList != null) ? Model.sCourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(m => m.sCourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>*@

                        @*<div class="form-group col-md-1">
                            <a href="#" id="btnget" class="btn btn-primary" onclick="BindcourseAttachedFile()">Get</a>
                        </div>*@
                        <div class="col-md-1">
                            <button class="btn btn-success btnPrint " onclick="printDiv('dvbind')"> Print </button>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                        </div>
                    </div>
                </div>



            }
            <div id="dvbind">

            </div>
        </div>

    </div>
</div>
<!-- end #content -->
