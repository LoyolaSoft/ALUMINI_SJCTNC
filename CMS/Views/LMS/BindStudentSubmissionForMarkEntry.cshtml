@model CMS.ViewModel.ViewModel.LMSViewModel
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Student Submission Assignment List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Submission Assignment List</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Student Submission Assignment List</h4>
                </div>
                <div class="panel-body">




                    <table class="col-md-12 table table-hover table-bordered" id="tblStuAssignments">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Roll No</th>
                                <th>Assignment</th>
                                <th>Course</th>
                                <th>Total Mark</th>
                                <th>Sec Mark</th>
                                <th>Mark Entry</th>

                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.listuassignment != null)
                            {
                                int No = 0;
                                foreach (var item in Model.listuassignment)
                                {
                                    <tr>
                                        <td>@{No++; } @No</td>
                                        <td>@item.NAME</td>
                                        <td>@item.ROLL_NO</td>
                                        <td>@item.ASSIGNMENT_NAME</td>
                                        <td>@item.COURSE_TITLE</td>
                                        <td>@item.TOTAL_MARK</td>
                                        <td>@item.SEC_MARK</td>


                                        <td>
                                            @if (@item.SUBMITED == "1")
                                            {
                                                <a href="#StuAssignment" onclick="FetchStusubmission(@item.STU_ASSIGNMENT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                            }

                                        </td>
                                    </tr>
                                }

                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">No Assignment Found...!</td>
                                </tr>
                            }


                        </tbody>
                    </table>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>


<div class="modal" id="StuAssignment">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Edit Mark</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12" id="dvValidate" data-parsley-validate="true">
                                <input id="txtstusubmissionid" value="" hidden />
                                <embed src="" height="800px" width="550px" id="pdf">
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Total Mark </label>
                                    <div class="col-md-9">
                                        <input type="text" id="txttotal" class="form-control" disabled>
                                    </div>
                                </div>

                                <!-- Total Mark -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Secure Mark</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtsecure" class="form-control" placeholder="Secure Mark">
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" data-dismiss="modal" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script>

     // Fetch Settin Info ...
    function FetchStusubmission(ID)
    {
        $.ajax({
            url:"@Url.Action("FetchStuAssignmentSubmission", "LMS")",
            method: "POST",
            datatype:"json",
            data: { sStusubid: ID },
            success:function(data)
            {
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#txtstusubmissionid').val(data[0].STU_ASSIGNMENT_ID);
                    $('#txtsecure').val(data[0].SEC_MARK);
                    $('#txttotal').val(data[0].TOTAL_MARK);

                    $('#pdf').attr("src", data[0].FILE_PATH);


                    $('.selectpicker').selectpicker('refresh');
                }
            },error:function(error)
            {
                alert('Internal Server Error ! ');
            }
        });
    }

    $('#btnSubmit').on('click', function ()
    {
        JsonData = '{"STU_ASSIGNMENT_ID":"' + $('#txtstusubmissionid').val() + '",\
                         "SEC_MARK":"' + $('#txtsecure').val() + '",\
                         "TOTAL_MARK": "' + $('#txttotal').val() + '"}';


        $.ajax({
            url: '/LMS/SaveAssignmentMark',
            method: 'post',
            data: { sJsonData: JsonData},
            success: function (data)
            {

                swal({ title: "Message", text: "Updated Successfully", showConfirmButton: false, timer: 1500, type: 'success', animation: true });

                $('#AssignmentSetting-dialog').modal('hide');
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    });





</script>

