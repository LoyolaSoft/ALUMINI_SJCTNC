@model CMS.ViewModel.ViewModel.SupportDataViewModel
@{
    ViewBag.Title = "SupMethodologyList";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Sup Methodology List</li>
    </ol>
    <h1 class="page-header">Sup Methodology List </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Sup Methodology List </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">

                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Methodology Name</th>
                            <th>Active</th>
                            <th>Action</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liMethodology != null && Model.liMethodology.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liMethodology)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.METHODOLOGY_NAME</td>

                                    <td>

                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>


                                    <td>
                                        <a href="#Rules-dialog" data-toggle="modal" class="text-primary" onclick="FetchMethodologybyId(@item.METHODOLOGY_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfirm(@item.METHODOLOGY_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="hidden" id="MethodologyID" value="" />
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Methodology Name", htmlAttributes: new { @class = "col-md-4 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-8">
                                            <input class="form-control input-sm" type="text" id="MethodologyName" required />

                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <div class="col-md-8">
                                            <input type="checkbox" id="IsActive" /> &nbsp; &nbsp; IsActive
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>


            </div>
        </div>

    </div>

</div>




<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>



    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
        //add
    });

    $("#Add").on('click', function () {

        $('#MethodologyID').attr('value', '');
        $('#MethodologyName').attr('value', '');
        //$('#IsActive').attr('value', '');
        $("#IsActive").prop("checked", false);
    })




    //add
       $('#btnSubmit').on('click', function ()
       {
           var isValid = true;
           if ($('#pBody').parsley().validate() !== true) isValid = false;

           if (!isValid) {
               //gritter-info,danger,success,warning,default
               myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
               return false;
           }
           var IsActive = 0;
           if ($('#IsActive').is(':checked'))
            {
               IsActive = 1;
            }
           var sJsonData = '{"METHODOLOGY_ID":"' + $("#MethodologyID").val() + '","METHODOLOGY_NAME":"' + $('#MethodologyName').val() + '","IS_ACTIVE":"' + IsActive + '",}';
    $.ajax({
        url:'@Url.Action("SaveMethodology", "SupportData")',
        method: 'POST',
        data: { Methodology: sJsonData},
        success: function (data)
        {
            if (data.ErrorCode == "200") {
                swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });

            } else {
                swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

            }

            loadContent('/SupportData/SupMethodologyList');

            // window.location = '/Admin/CountInfo';
        },
        error: function (error)
        {
            alert('Internal Server Error !');
        }
    });
       });


    //edit
    function FetchMethodologybyId(Id) {

        $('#pBody').parsley().destroy()

        $.ajax({
            url: '/SupportData/FetchMethodologybyId',
            method: 'POST',
            datatype: 'json',
            data: { MethodologyID: Id },
            success: function (data) {
                $('#MethodologyID').val(data[0].METHODOLOGY_ID);
                $('#MethodologyName').val(data[0].METHODOLOGY_NAME);
                $('.selectpicker').selectpicker('refresh');

                if (data[0].IS_ACTIVE == "1") {
                    $("#IsActive").prop("checked", true);
                } else {
                    $("#IsActive").prop("checked", false);
                }

            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }

  



     function GetConfirm(id) {
   swal({
       title: "Are you sure want to Delete..?",
       type: "warning",
       showCancelButton: true,
       confirmButtonClass: "btn-danger",
       confirmButtonText: "Yes, I agree!",
       closeOnConfirm: false
   }, function () {
       $.ajax({
           url: "@Url.Action("DeleteMethodologyById", "SupportData")",
           type: "post",
           data: { MethodologyID: id },
           success: function (data) {
               if (data.ErrorCode != null && data.ErrorCode == "406") {
                   swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
               } else {
                   swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
               }
               loadContent('/SupportData/SupMethodologyList');
           },
           error: function () {
               swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
           }
       });
   });
 }

</script>
