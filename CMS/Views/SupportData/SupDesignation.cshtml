@model CMS.ViewModel.ViewModel.SupportDataViewModel
@{
    ViewBag.Title = "SupDesignation";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Sup Designation</li>
    </ol>
    <h1 class="page-header">Sup Designation </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Sup Designation</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">

                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Designation</th>
                            <th>Designation Order</th>
                            @*<th>Is Used</th>*@
                            <th>Action</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lisupDesignation != null && Model.lisupDesignation.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lisupDesignation)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.DESIGNATION</td>
                                    <td>@item.DESIGNATIONORDER</td>

                                    @*<td>

                                        @if (item.ISUSED == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>*@





                                    <td>
                                        <a href="#Rules-dialog" onclick="FetchDesignationById(@item.DESIGNATIONID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.DESIGNATIONID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>   
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="hidden" id="DesignationID" value="" />
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Designation", htmlAttributes: new { @class = "col-md-4 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-8">
                                            <input class="form-control input-sm" type="text" id="Designation" required />

                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        @Html.Label("Designation Order", htmlAttributes: new { @class = "col-md-4 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-8">
                                            <input class="form-control input-sm" type="number" id="Designationorder" required />

                                        </div>
                                    </div>

                                    @*<div class="col-md-12 form-group">
                                        <div class="col-md-8">
                                            <input type="checkbox" id="chIsUsed" /> &nbsp; &nbsp; IsUsed
                                        </div>
                                    </div>*@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>


            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>



    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
        //add
    });

    $("#Add").on('click', function () {

        $('#DesignationID').attr('value', '');
        $('#Designation').attr('value', '');
        $('#Designationorder').attr('value', '');
        //$("#chIsUsed").prop("checked", false);
    })




    //add
       $('#btnSubmit').on('click', function ()
       {
           var isValid = true;
           if ($('#pBody').parsley().validate() !== true) isValid = false;

           if (!isValid) {
               //gritter-info,danger,success,warning,default
               myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
               return false;
           }
           var IsUsed = 0;
    if ($('#chIsActive').is(':checked'))
    {
        IsUsed = 1;
    }
           var sJsonData = '{"DESIGNATIONID":"' + $("#DesignationID").val() + '","DESIGNATION":"' + $('#Designation').val() + '","DESIGNATIONORDER":"' + $('#Designationorder').val()+ '",}';
    $.ajax({
        url:'@Url.Action("SaveDesignation", "SupportData")',
        method: 'POST',
        data: { Designation: sJsonData},
        success: function (data)
        {
            if (data.ErrorCode == "200") {
                swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });

            } else {
                swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

            }

            loadContent('/SupportData/SupDesignation');

            // window.location = '/Admin/CountInfo';
        },
        error: function (error)
        {
            alert('Internal Server Error !');
        }
    });
       });



    //edit
    function FetchDesignationById(Id) {

        $('#pBody').parsley().destroy()
        
        $.ajax({
            url: '/SupportData/FetchDesignationById',
            method: 'POST',
            datatype: 'json',
            data: { DesignationID: Id },
            success: function (data) {
                $('#DesignationID').val(data[0].DESIGNATIONID);
                $('#Designation').val(data[0].DESIGNATION);
                $('#Designationorder').val(data[0].DESIGNATIONORDER);

                $('.selectpicker').selectpicker('refresh');
                //if (data[0].ISUSED == 1) {
                //    $("#chIsUsed").prop("checked", true);
                //} else {
                //    $("#chIsUsed").prop("checked", false);
                //}
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }



     function GetConfirm(id) {
   swal({
       title: "Are you sure want to Delete..?",
       type: "warning",
       showCancelButton: true,
       confirmButtonClass: "btn-danger",
       confirmButtonText: "Yes, I agree!",
       closeOnConfirm: false
   }, function () {
       $.ajax({
           url: "@Url.Action("DeleteDesignation", "SupportData")",
           type: "post",
           data: { DesignationID: id },
           success: function (data) {
               if (data.ErrorCode != null && data.ErrorCode == "406") {
                   swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
               } else {
                   swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
               }
               loadContent('/SupportData/SupDesignation');
           },
           error: function () {
               swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
           }
       });
   });
 }

</script>
