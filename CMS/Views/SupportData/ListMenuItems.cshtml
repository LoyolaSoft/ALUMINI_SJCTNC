
@model CMS.ViewModel.ViewModel.SupportDataViewModel

@{
    ViewBag.Title = "ListMenuItems";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Menu Items List</li>
    </ol>
    <h1 class="page-header">Menu Items</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Menu Items</h3>
        </div>
        <div class="panel-body">

            <div class="form-group">
                <a class="btn bg-green pull-right" title="Click to Add" href="#menu-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus"></i> Add</a>
            </div><br /><br />

            <div class="form-group table-responsive">
                @{ int count = 0;}
                <table class="table table-hover table-bordered" id="tblMenuItems">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Menu Name</th>
                            <th>Module</th>
                            <th>Controller</th>
                            <th>Menu Action</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liMenuItems != null)
                        {
                            foreach (var item in Model.liMenuItems)
                            {
                                <tr>
                                    <td>@{count++;} @count</td>
                                    <td>@item.MENU_NAME</td>
                                    <td>@item.MODULE_NAME</td>
                                    <td>@item.CONTROLLER</td>
                                    <td>@item.ACTION</td>
                                    <td>
                                        <a href="#menu-dialog" onclick="FetchMenuItemById(@item.MENU_ID)" data-toggle="modal"><i class="fa fa-edit text-primary"  title="Edit"></i></a>
                                        <a href="javascript:;" onclick="GetConfirm(@item.MENU_ID)" title="Click To Delete"><i class="fa fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="menu-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Menu</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal" id="pBody" data-parsley-validate="true">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input type="hidden" id="txtMenuId" />
                                <div class="form-group">
                                    <label class="control-label col-md-3">Menu Name</label>
                                    <div class="col-md-9">
                                        <input type="text" class="form-control input-sm" id="txtMenuName" placeholder="Enter Menu Name" data-parsley-required="true" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Module</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ModuleList, (Model.ModuleList != null) ? Model.ModuleList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Controller</label>
                                    <div class="col-md-9">
                                        <input type="text" class="form-control input-sm" id="txtController" placeholder="Enter Controller" data-parsley-required="true" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Action </label>
                                    <div class="col-md-9">
                                        <input type="text" class="form-control input-sm" id="txtAction" placeholder="Enter Action" data-parsley-required="true"  />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker('refresh');
         
        var tbl = $('#tblMenuItems').DataTable();

     
        function FetchMenuItemById(MenuId)
        {
            $('#pBody').parsley().destroy();

            if (MenuId != null)
            {
                $.ajax({
                    url: "/SupportData/FetchMenuItemById",
                    type:"post",
                    data: { sMenuId: MenuId },
                    success:function(data)
                    {
                        if(data.Message!=null)
                        {
                            alert(data.Message);
                        }
                        else {
                            if (data.oResult[0] != null)
                            {
                                $('#txtMenuName').attr('value', data.oResult[0].MENU_NAME);
                                $('#txtController').attr('value', data.oResult[0].CONTROLLER);
                                $('#txtAction').attr('value', data.oResult[0].ACTION);
                                $('#ModuleList option[value="' + data.oResult[0].PARENT_ID + '"]').attr("selected", "selected");
                                $('#txtMenuId').attr('value', data.oResult[0].MENU_ID);
                                $('.selectpicker').selectpicker('refresh');
                            }
                        }

                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }

        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var MenuId = $('#txtMenuId').val();
            var MenuName = $('#txtMenuName').val();
            var ParentId = $('#ModuleList').val();
            var Controller = $('#txtController').val();
            var Action = $('#txtAction').val();
            
            var jsonData = '{"MENU_ID":"' + MenuId + '","MENU_NAME":"' + MenuName + '","PARENT_ID":"' + ParentId + '","CONTROLLER":"' + Controller + '","ACTION":"' + Action + '"}';


              var req=  $.ajax({
                    url: "/SupportData/SaveorUpdateMenuItem",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "")
                        {
                            if (data.ErrorCode == "200")
                            {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/SupportData/ListMenuItems');
                            }
                            if (data.ErrorCode == "417") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                            if (data.ErrorCode == "503") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }


                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

              });
        });


    function SetActive(MenuId,Mode)
    {
        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "/SupportData/ActivateorDeactivateMenuItemId",
                type: "post",
                data: { sMenuId: MenuId, sMode: Mode },
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/SupportData/ListMenuItems');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }

            });
        });

    }


    GetConfirm = function (MenuId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "/SupportData/DeleteMenuItemById",
        type: "post",
        data: { sMenuId: MenuId },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/SupportData/ListMenuItems');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }
    });
});

        }

        $('#Add').click(function () {

            $('#pBody').parsley().destroy();

            $('#txtMenuName').attr('value', '');
            $('#txtController').attr('value', '');
            $('#txtAction').attr('value', '');
            $('#ModuleList option[value=""]').attr("selected", "selected");
            $('#txtMenuId').attr('value', '');
            $('.selectpicker').selectpicker('refresh');


        });




        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
        }
</script>