@model CMS.ViewModel.ViewModel.SupportDataViewModel

@{
    ViewBag.Title = "SupRoomList";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Room List</li>
    </ol>
    <h1 class="page-header">Room List</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Room List</h3>
        </div>
        <div class="panel-body">

            <div class="form-group">
                <a class="btn bg-green pull-right" title="Click to Add" href="#Room-dialog" data-toggle="modal"><i class="fa fa-plus"></i> Add</a>
            </div><br /><br />

            <div class="form-group table-responsive">
                @{ int count = 0;}
                <table class="table table-hover table-bordered" id="tblSupRoom">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ExamType</th>
                            <th>Block</th>
                            <th>Room No</th>
                            <th>Column</th>
                            <th>Row</th>
                            <th>Exam Capacity</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liSupRoom != null)
                        {
                            foreach (var item in Model.liSupRoom)
                            {
                                <tr>
                                    <td>@{count++;} @count</td>
                                    <td>@item.EXAM_TYPE_NAME</td>
                                    <td>@item.BLOCK_NAME</td>
                                    <td>@item.ROOM_NO</td>
                                    <td>@item.COLUMN</td>
                                    <td>@item.ROW</td>
                                    <td>@item.EXAM_CAPACITY</td>                             
                                    <td>
                                        <a href="#Room-dialog" onclick="FetchRoomDetails(@item.ROOM_ID)" title="Click To Edit" data-toggle="modal"><i class="fa fa-edit text-primary"></i></a>
                                        <a href="javascript:;" onclick="GetConfrim(@item.ROOM_ID)" title="Click To Delete"><i class="fa fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="Room-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Rooms</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal" id="Validate" data-parsley-validate="true">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input type="hidden" id="hdRoomId" />
                                <div class="form-group">
                                    <label class="control-label col-md-3">Block</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.CollgeBlock, (Model.CollgeBlock != null) ? Model.CollgeBlock : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                    </div>
                                </div>   
                                <div class="form-group">
                                    <label class="control-label col-md-3">Exam Type</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                    </div>
                                </div>                             
                                <div class="form-group">
                                    <label class="control-label col-md-3">Room No</label>
                                    <div class="col-md-9">
                                        <input type="text" class="form-control input-sm" id="txtRoomNo" placeholder="Enter Room No" data-parsley-required = "true"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Column</label>
                                    <div class="col-md-9">
                                        <input type="number" class="form-control input-sm" id="txtColumn" placeholder="Enter Column" data-parsley-required = "true" data-parsley-min="1" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Row</label>
                                    <div class="col-md-9">
                                        <input type="number" class="form-control input-sm" id="txtRow" placeholder="Enter Row" data-parsley-required = "true" data-parsley-min="1" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Exam Capacity</label>
                                    <div class="col-md-9">
                                        <input type="number" class="form-control input-sm" id="txtExamCapacity" placeholder="Enter ExamCapacity"data-parsley-required = "true"data-parsley-min="0"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">Space</label>
                                    <div class="col-md-9">
                                        <input type="number" class="form-control input-sm" id="txtSpaceColumn" placeholder="Enter Column" data-parsley-required="true" data-parsley-min="1" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-3">
                                       Room Order
                                    </label>
                                    <div class="col-md-9">
                                        <input type="number" class="form-control input-sm" id="txtRoomOrder" placeholder="Enter Column" data-parsley-required="true" data-parsley-min="1" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {      
    }
    $('.selectpicker').selectpicker('refresh');
    $('#tblSupRoom').DataTable({
        dom: "lBfrtip", buttons: [{
            extend: "copy", className: "btn-sm"
        }
        , {
            extend: "excel", className: "btn-sm"
        }
        , {
            extend: "pdf", className: "btn-sm"
        }
        ], responsive: !0,
    });
    // FectchRoombyRoomId
    function FetchRoomDetails(ID) {
        $.ajax({
            url: '@Url.Action("FetchRoomByRoomId", "SupportData")',
            method: 'POST',
            datatype: 'json',
            data: { sRoomId: ID },
            success: function (data) {
                if (data.Message != null && data.Message != '') {                   
                    alert(data.Message);
                } else {               
                    $('#hdRoomId').val(data[0].ROOM_ID);
                    $('#CollgeBlock').val(data[0].COLLEGE_BLOCK_ID);
                    $('#ExamType').val(data[0].EXAM_TYPE);
                    $('#txtRoomNo').val(data[0].ROOM_NO);
                    $('#txtColumn').val(data[0].COLUMN);
                    $('#txtSpaceColumn').val(data[0].SPACE_COLUMN);
                    $('#txtRoomOrder').val(data[0].ROOM_ORDER);
                    $('#txtRow').val(data[0].ROW);
                    $('#txtExamCapacity').val(data[0].EXAM_CAPACITY);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {                
                alert('Internal Server Error !');
            }
        });
    }
    //DeleteRoom
    function GetConfrim(ID) {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        } else {
            $.ajax({
                url: '@Url.Action("DeleteSupRoom", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sRoomId: ID },
                success: function (data) {
                    alert(data.Message);                 
                    loadContent('/SupportData/SupRoomList');
                }, error: function (error) {
                    alert('Internal Server Error !');                   
                }
            });
        }
    }

    $(function () {
        $('#Room-dialog').on('hidden.bs.modal', function (e) {
            $('#txtExamCapacity').val('');
            $('#txtRow').val('');
            $('#txtColumn').val('');
            $('#txtRoomNo').val('');
            $('#hdRoomId').val('');
            $('#txtSpaceColumn').val('');
            $('#txtRoomOrder').val('');
            $('#CollgeBlock').val('');
            $('#ExamType').val('');
            $('.selectpicker').selectpicker('refresh');
        });
    });

    $('#txtColumn').on('focusout', function () {
        if ($('#txtColumn').val() != 0 && $('#txtRow').val() != 0) {
            var vTotalmark = $('#txtColumn').val() * $('#txtRow').val();
            $('#txtExamCapacity').val(vTotalmark)
        }
    });
    $('#txtRow').on('focusout', function () {
        if ($('#txtColumn').val() != 0 && $('#txtRow').val() != 0) {
            var vTotalmark = $('#txtColumn').val() * $('#txtRow').val();
            $('#txtExamCapacity').val(vTotalmark)
        }
    });    
    $('#btnSubmit').on('click', function () {
        var isValid = true;
        if ($('#Validate').parsley().validate() !== true) isValid = false;
        if (!isValid) {            
            alert('Please Check Your Inputs!!!');
            return false;
        }
        var JsonData = null;
        if ($('#txtRoomNo').val() != 0 && $('#txtColumn').val() != 0 && $('#txtRow').val() != 0 && $('#txtExamCapacity').val() != 0 && $('#CollgeBlock').val() != 0) {
            JsonData = '{"ROOM_ID":"' + $('#hdRoomId').val() + '",\
                      "ROOM_NO":"' + $('#txtRoomNo').val() + '",\
                      "COLLEGE_BLOCK_ID":"' + $('#CollgeBlock').val() + '",\
                       "EXAM_TYPE":"' + $('#ExamType').val() + '",\
                        "SPACE_COLUMN":"' + $('#txtSpaceColumn').val() + '",\
                        "ROOM_ORDER":"' + $('#txtRoomOrder').val() + '",\
                      "COLUMN":"' + $('#txtColumn').val() + '",\
                      "ROW":"' + $('#txtRow').val() + '",\
                      "EXAM_CAPACITY":"' + $('#txtExamCapacity').val() + '"}';
      
            $.ajax({
                url: '@Url.Action("SaveSupRoom", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonRoom: JsonData },
                success: function (data) {                  
                    alert(data.Message);
                    loadContent('/SupportData/SupRoomList');
                }, error: function (error) {
                    alert('Internal Server Error !');                 
                }
            });
        } else {
            alert('Please Fill All The Filed To Continue !');
            return false;
        }

    });



</script>