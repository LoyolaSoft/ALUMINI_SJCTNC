@model CMS.ViewModel.ViewModel.SupUserType
@{
    ViewBag.Title = "FetchUserType";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List User Type </li>
    </ol>
    <h1 class="page-header">List User Type </h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List User Type </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="">
                <a class="btn btn-success pull-right form-group m-b-5" data-toggle="modal" onclick="AddOrEdit(0)" href="#modal-without-animation"><i class="fa fa-plus" title="Add"> </i>Add</a>
            </div>

            <br />
            @{ int count = 0;}
            @if (Model.liUserType != null)
            {
                <table class="table table-hover table-bordered table-responsive" id="tblUserTypeList">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                User Type
                            </th>
                            <th>
                                Actions
                            </th>
                        </tr>
                    </thead>

                    @foreach (var item in Model.liUserType)
                    {
                        <tr>
                            <td>
                                @{ count++;}
                                @count
                            </td>
                            <td>
                                @Html.DisplayFor(o => item.USER_TYPE_NAME)

                            </td>
                            <td>
                                <a href="#"><i class="fa fa-edit text-primary" onclick="AddOrEdit(1)" title="Edit"></i></a>
                                <a href="javascript:;" onclick="GetConfirm(0)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                            </td>
                        </tr>
                    }

                </table>
            }
            <textarea id="results" cols="80" rows="5"></textarea>

            <input type="text" class="txt">
            <div>
                <label for="rate">Rate</label><input type="range" min="0.5" max="2" value="1" step="0.1" id="rate">
                <div class="rate-value">1</div>
                <div class="clearfix"></div>
            </div>
            <div>
                <label for="pitch">Pitch</label><input type="range" min="0" max="2" value="1" step="0.1" id="pitch">
                <div class="pitch-value">1</div>
                <div class="clearfix"></div>
            </div>
            <a href="#" onclick="stopRecognition()">Click me</a>
            <a href="#" onclick="startRecognition()">Click me1</a>
            <select></select>


            <div class="form-group">
                <div id="chartContainer"></div>

            </div>

            <div class="form-group">
                <canvas id="ChartJs"></canvas>

            </div>

        </div>


    </div>

</div>

<div class="modal" id="modal-without-animation">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Modal Without Animation</h4>
            </div>
            <div class="modal-body">
                Modal body content here...
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-white" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script type="text/javascript" src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>
<script src="~/Content/assets/plugins/chart-js/Chart.min.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
        // Loadchart();
        loadChartjs();
    }

    $("#tblUserTypeList").DataTable();
</script>
<script>
        function GetConfirm(ID) {
            if (!confirm('Are you sure to delete ?')) {
                return false;
            } else {
                $.ajax({
                    url: "@Url.Action("DeleteSupBank", "SupportData")",
                    method: "POST",
                    datatype: "json",
                    data: { sBankId: ID },
                    success: function (objResult) {
                        alert(objResult.Message);
                        loadContent('/SupportData/FetchUserType');
                    }, error: function (error) {
                        alert('Internal Server Error ! ');
                    }
                });
            }
        }

        function AddOrEdit(flag) {
            if (flag=1) {
                alert('flag 1');
            } else {
                alert('flag 0');
            }
        }

         function Loadchart () {
            alert();
            var chart = new CanvasJS.Chart("chartContainer", {

                animationEnabled: true,
                title: {
                    text: "Tested By Paul"
                },
                legend: {
                    verticalAlign: "center",
                    horizontalAlign: "left",
                    fontSize: 18,
                    fontFamily: "-apple-system"
                },
                axisX: {
                    valueFormatString: "DD MMM"
                },
                axisY: {
                    title: "Collection (in INR)",
                    prefix: "₹",
                    includeZero: false
                },
                data: [
                    {
                        type: "stackedArea",
                        xValueType: "dateTime",
                        xValueFormatString: "DD MMM",
                        yValueFormatString: "₹#,###",


                        dataPoints: @Html.Raw(ViewBag.DataPoints),
                    }
                ]

            });
            chart.render();

        };
        function loadChartjs() {
            var ctx = $("#ChartJs");
            var myChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(ViewBag.DataLabel),
                    datasets: [{
                        label: 'Fee Collection',
                        data: @Html.Raw(ViewBag.DataY),
                        backgroundColor: '#528ff0'
                        ,
                        borderColor:'rgba(82, 143, 240, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    
                    title: {
                        display: true,
                        text: 'Tested By Paul'
                    },
                    animation: {
                        duration: 3000,
                        easing:'easeOutExpo'
                    }
                }
            });


        }

        var recognition = new webkitSpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = true;
        var voiceText;

        recognition.onresult = function (e) {
            var textarea = document.getElementById('results');
            voiceText = '';
            for (var i = e.resultIndex; i < e.results.length; ++i) {
                if (e.results[i].isFinal) {
                    voiceText += e.results[i][0].transcript;
                }
            }
            speak(voiceText);
            textarea.value += voiceText;
            recognition.stop();
        }
        // start listening
        function stopRecognition() {
            recognition.stop();
        }
        function startRecognition() {
            recognition.start();
        }
        // say a message
</script>
