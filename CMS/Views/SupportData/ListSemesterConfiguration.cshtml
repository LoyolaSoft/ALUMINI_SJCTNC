@model CMS.ViewModel.ViewModel.SupportDataViewModel

@{
    ViewBag.Title = "Semester Configuration";
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Semester Configuration</li>
    </ol>
    <h1 class="page-header">Academic Semester Configuration</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
            </div>
            <h3 class="panel-title"><i class="fa fa-cogs"></i> Semester Configuration Settings</h3>
        </div>
        <div class="panel-body">
            <!-- Navigation Tabs -->
            <ul class="nav nav-tabs">
                <li class="active"><a href="#tab-semester-type" data-toggle="tab"><i class="fa fa-calendar-check-o"></i> Semester Type</a></li>
                <li><a href="#tab-sup-semester-type" data-toggle="tab"><i class="fa fa-tags"></i> Support Semester Type</a></li>
                <li><a href="#tab-sup-semester" data-toggle="tab"><i class="fa fa-list-ol"></i> Semesters</a></li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content">
                
                <!-- Tab 1: Semester Type Management -->
                <div class="tab-pane fade active in" id="tab-semester-type">
                    <div class="form-group clearfix">
                        <a class="btn bg-green pull-right" title="Add Semester Type" href="#semester-type-dialog" data-toggle="modal" id="AddSemesterTypeBtn"><i class="fa fa-plus"></i> Add Semester Type</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered" id="tblSemesterType" style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Semester Type</th>
                                    <th style="width: 140px;">Status</th>
                                    <th style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liSemesterType != null)
                                {
                                    int countSemType = 0;
                                    foreach (var item in Model.liSemesterType)
                                    {
                                        <tr>
                                            <td>@{countSemType++;} @countSemType</td>
                                            <td><strong>@item.SEMESTER_TYPE_NAME</strong></td>
                                            <td>
                                                @if (item.IS_ACTIVE == "1")
                                                {
                                                    <a href="javascript:;" onclick="ToggleSemesterTypeStatus(@item.SEMESTER_TYPE_ID, 0)" class="text-success"><i class="fa fa-check-circle fa-lg"></i> Active</a>
                                                }
                                                else
                                                {
                                                    <a href="javascript:;" onclick="ToggleSemesterTypeStatus(@item.SEMESTER_TYPE_ID, 1)" class="text-danger"><i class="fa fa-times-circle fa-lg"></i> Inactive</a>
                                                }
                                            </td>
                                            <td>
                                                <a href="#semester-type-dialog" onclick="FetchSemesterTypeById(@item.SEMESTER_TYPE_ID)" data-toggle="modal" title="Edit"><i class="fa fa-edit text-primary fa-lg m-r-5"></i></a>
                                                <a href="javascript:;" onclick="ConfirmDeleteSemesterType(@item.SEMESTER_TYPE_ID)" title="Delete"><i class="fa fa-trash text-danger fa-lg"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: Support Semester Type Management -->
                <div class="tab-pane fade" id="tab-sup-semester-type">
                    <div class="form-group clearfix">
                        <a class="btn bg-green pull-right" title="Add Support Semester Type" href="#sup-semester-type-dialog" data-toggle="modal" id="AddSupSemesterTypeBtn"><i class="fa fa-plus"></i> Add Support Semester Type</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered" id="tblSupSemesterType" style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Semester Type Code / Name</th>
                                    <th style="width: 140px;">Status</th>
                                    <th style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liSupSemesterType != null)
                                {
                                    int countSupSemType = 0;
                                    foreach (var item in Model.liSupSemesterType)
                                    {
                                        <tr>
                                            <td>@{countSupSemType++;} @countSupSemType</td>
                                            <td><strong>@item.SEMESTER_TYPE</strong></td>
                                            <td>
                                                @if (item.IS_ACTIVE == "1")
                                                {
                                                    <a href="javascript:;" onclick="ToggleSupSemesterTypeStatus(@item.SEMESTER_TYPE_ID, 0)" class="text-success"><i class="fa fa-check-circle fa-lg"></i> Active</a>
                                                }
                                                else
                                                {
                                                    <a href="javascript:;" onclick="ToggleSupSemesterTypeStatus(@item.SEMESTER_TYPE_ID, 1)" class="text-danger"><i class="fa fa-times-circle fa-lg"></i> Inactive</a>
                                                }
                                            </td>
                                            <td>
                                                <a href="#sup-semester-type-dialog" onclick="FetchSupSemesterTypeById(@item.SEMESTER_TYPE_ID)" data-toggle="modal" title="Edit"><i class="fa fa-edit text-primary fa-lg m-r-5"></i></a>
                                                <a href="javascript:;" onclick="ConfirmDeleteSupSemesterType(@item.SEMESTER_TYPE_ID)" title="Delete"><i class="fa fa-trash text-danger fa-lg"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Semesters Management -->
                <div class="tab-pane fade" id="tab-sup-semester">
                    <div class="form-group clearfix">
                        <a class="btn bg-green pull-right" title="Add Semester" href="#sup-semester-dialog" data-toggle="modal" id="AddSupSemesterBtn"><i class="fa fa-plus"></i> Add Semester</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered" id="tblSupSemester" style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Semester Name</th>
                                    <th>Semester Type</th>
                                    <th style="width: 140px;">Status</th>
                                    <th style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liSupSemester != null)
                                {
                                    int countSupSem = 0;
                                    foreach (var item in Model.liSupSemester)
                                    {
                                        <tr>
                                            <td>@{countSupSem++;} @countSupSem</td>
                                            <td><strong>@item.SEMESTER_NAME</strong></td>
                                            <td>
                                                <span class="label label-primary" style="font-size: 11px;">@(string.IsNullOrEmpty(item.SEMESTER_TYPE_NAME) ? "Not Assigned" : item.SEMESTER_TYPE_NAME)</span>
                                            </td>
                                            <td>
                                                @if (item.IS_ACTIVE == "1")
                                                {
                                                    <a href="javascript:;" onclick="ToggleSupSemesterStatus(@item.SUP_SEMESTER_ID, 0)" class="text-success"><i class="fa fa-check-circle fa-lg"></i> Active</a>
                                                }
                                                else
                                                {
                                                    <a href="javascript:;" onclick="ToggleSupSemesterStatus(@item.SUP_SEMESTER_ID, 1)" class="text-danger"><i class="fa fa-times-circle fa-lg"></i> Inactive</a>
                                                }
                                            </td>
                                            <td>
                                                <a href="#sup-semester-dialog" onclick="FetchSupSemesterById(@item.SUP_SEMESTER_ID)" data-toggle="modal" title="Edit"><i class="fa fa-edit text-primary fa-lg m-r-5"></i></a>
                                                <a href="javascript:;" onclick="ConfirmDeleteSupSemester(@item.SUP_SEMESTER_ID)" title="Delete"><i class="fa fa-trash text-danger fa-lg"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal 1: Semester Type Dialog                                             -->
<!-- ========================================================================= -->
<div class="modal" id="semester-type-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="lblModalTitleSemesterType">Add / Edit Semester Type</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal" id="semesterTypeForm" data-parsley-validate="true">
                    <input type="hidden" id="txtSemesterTypeId" />
                    <div class="form-group">
                        <label class="control-label col-md-4">Semester Type Name <span class="text-danger">*</span></label>
                        <div class="col-md-8">
                            <input type="text" class="form-control input-sm" id="txtSemesterTypeName" placeholder="e.g. Odd Semester, Even Semester" data-parsley-required="true" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-8 col-md-offset-4">
                            <div class="checkbox checkbox-css">
                                <input type="checkbox" id="chkSemTypeIsActive" checked />
                                <label for="chkSemTypeIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitSemesterType" class="btn btn-sm btn-primary"><i class="fa fa-save"></i> Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</a>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal 2: Support Semester Type Dialog                                     -->
<!-- ========================================================================= -->
<div class="modal" id="sup-semester-type-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="lblModalTitleSupSemesterType">Add / Edit Support Semester Type</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal" id="supSemesterTypeForm" data-parsley-validate="true">
                    <input type="hidden" id="txtSupSemesterTypeId" />
                    <div class="form-group">
                        <label class="control-label col-md-4">Semester Type Code / Name <span class="text-danger">*</span></label>
                        <div class="col-md-8">
                            <input type="text" class="form-control input-sm" id="txtSupSemesterTypeCode" placeholder="e.g. ODD, EVEN, NON SEMESTER" data-parsley-required="true" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-8 col-md-offset-4">
                            <div class="checkbox checkbox-css">
                                <input type="checkbox" id="chkSupSemTypeIsActive" checked />
                                <label for="chkSupSemTypeIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitSupSemesterType" class="btn btn-sm btn-primary"><i class="fa fa-save"></i> Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</a>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal 3: Support Semester Dialog                                          -->
<!-- ========================================================================= -->
<div class="modal" id="sup-semester-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="lblModalTitleSupSemester">Add / Edit Semester</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal" id="supSemesterForm" data-parsley-validate="true">
                    <input type="hidden" id="txtSupSemesterId" />
                    <div class="form-group">
                        <label class="control-label col-md-4">Semester Name <span class="text-danger">*</span></label>
                        <div class="col-md-8">
                            <input type="text" class="form-control input-sm" id="txtSupSemesterName" placeholder="e.g. I, II, III, IV, V, VI" data-parsley-required="true" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-md-4">Semester Type <span class="text-danger">*</span></label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.SupSemesterTypeList, (Model.SupSemesterTypeList != null) ? Model.SupSemesterTypeList : Enumerable.Empty<SelectListItem>(), "--Select Semester Type--", new { @id = "ddlSupSemesterType", @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-8 col-md-offset-4">
                            <div class="checkbox checkbox-css">
                                <input type="checkbox" id="chkSupSemIsActive" checked />
                                <label for="chkSupSemIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitSupSemester" class="btn btn-sm btn-primary"><i class="fa fa-save"></i> Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    function ContentLoad() {
        // Dynamic reload hook
    }

    $('.selectpicker').selectpicker('refresh');

    // Initialize Datatables
    $('#tblSemesterType').DataTable({
        responsive: true
    });
    $('#tblSupSemesterType').DataTable({
        responsive: true
    });
    $('#tblSupSemester').DataTable({
        responsive: true
    });

    // Helper to reload and preserve the active tab
    function reloadSemesterConfig(activeTabId) {
        if (activeTabId) {
            sessionStorage.setItem('semConfigActiveTab', activeTabId);
        }
        if (typeof loadContent === 'function') {
            loadContent('/SupportData/ListSemesterConfiguration');
        } else {
            window.location.reload();
        }
    }

    // Restore active tab after reload
    var savedActiveTab = sessionStorage.getItem('semConfigActiveTab');
    if (savedActiveTab) {
        $('.nav-tabs a[href="' + savedActiveTab + '"]').tab('show');
        sessionStorage.removeItem('semConfigActiveTab');
    }

    // =========================================================================
    // 1. SEMESTER TYPE FUNCTIONS
    // =========================================================================
    $('#AddSemesterTypeBtn').click(function () {
        $('#semesterTypeForm').parsley().destroy();
        $('#lblModalTitleSemesterType').text('Add Semester Type');
        $('#txtSemesterTypeId').val('');
        $('#txtSemesterTypeName').val('');
        $('#chkSemTypeIsActive').prop('checked', true);
    });

    function FetchSemesterTypeById(id) {
        $('#semesterTypeForm').parsley().destroy();
        $('#lblModalTitleSemesterType').text('Edit Semester Type');
        if (id) {
            $.ajax({
                url: "/SupportData/FetchSemesterTypeById",
                type: "POST",
                data: { sSemesterTypeId: id },
                success: function (data) {
                    if (data.oResult && data.oResult[0]) {
                        var item = data.oResult[0];
                        $('#txtSemesterTypeId').val(item.SEMESTER_TYPE_ID);
                        $('#txtSemesterTypeName').val(item.SEMESTER_TYPE_NAME);
                        $('#chkSemTypeIsActive').prop('checked', item.IS_ACTIVE == "1");
                    } else if (data.Message) {
                        alert(data.Message);
                    }
                },
                error: function (ex) {
                    alert("Error loading semester type: " + ex.statusText);
                }
            });
        }
    }

    $('#btnSubmitSemesterType').click(function () {
        if ($('#semesterTypeForm').parsley().validate() !== true) return false;

        var id = $('#txtSemesterTypeId').val();
        var name = $('#txtSemesterTypeName').val();
        var isActive = $('#chkSemTypeIsActive').is(':checked') ? "1" : "0";

        var jsonData = JSON.stringify({
            SEMESTER_TYPE_ID: id,
            SEMESTER_TYPE_NAME: name,
            IS_ACTIVE: isActive
        });

        $.ajax({
            url: "/SupportData/SaveorUpdateSemesterType",
            type: "POST",
            data: { sJsonData: jsonData },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success' });
                    $('#semester-type-dialog').modal('hide');
                    reloadSemesterConfig('#tab-semester-type');
                } else {
                    swal({ title: "Error", text: data.Message, type: 'error' });
                }
            },
            error: function () {
                swal({ title: "Error", text: "Something went wrong during submission", type: 'error' });
            }
        });
    });

    function ConfirmDeleteSemesterType(id) {
        swal({
            title: "Are you sure you want to delete this Semester Type?",
            text: "This record will be removed from active lists.",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, delete it!"
        }, function () {
            $.ajax({
                url: "/SupportData/DeleteSemesterTypeById",
                type: "POST",
                data: { sSemesterTypeId: id },
                success: function (data) {
                    swal({ title: "Deleted!", text: data.Message, type: 'success', timer: 1500, showConfirmButton: false });
                    reloadSemesterConfig('#tab-semester-type');
                },
                error: function () {
                    swal({ title: "Error", text: "Unable to delete semester type", type: 'error' });
                }
            });
        });
    }

    function ToggleSemesterTypeStatus(id, nextMode) {
        swal({
            title: "Are you sure you want to update the status?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-primary",
            confirmButtonText: "Yes, change it!"
        }, function () {
            $.ajax({
                url: "/SupportData/ToggleSemesterTypeStatus",
                type: "POST",
                data: { sSemesterTypeId: id, sMode: nextMode },
                success: function (data) {
                    swal({ title: "Updated!", text: data.Message, type: 'success', timer: 1500, showConfirmButton: false });
                    reloadSemesterConfig('#tab-semester-type');
                },
                error: function () {
                    swal({ title: "Error", text: "Unable to update status", type: 'error' });
                }
            });
        });
    }

    // =========================================================================
    // 2. SUPPORT SEMESTER TYPE FUNCTIONS
    // =========================================================================
    $('#AddSupSemesterTypeBtn').click(function () {
        $('#supSemesterTypeForm').parsley().destroy();
        $('#lblModalTitleSupSemesterType').text('Add Support Semester Type');
        $('#txtSupSemesterTypeId').val('');
        $('#txtSupSemesterTypeCode').val('');
        $('#chkSupSemTypeIsActive').prop('checked', true);
    });

    function FetchSupSemesterTypeById(id) {
        $('#supSemesterTypeForm').parsley().destroy();
        $('#lblModalTitleSupSemesterType').text('Edit Support Semester Type');
        if (id) {
            $.ajax({
                url: "/SupportData/FetchSupSemesterTypeById",
                type: "POST",
                data: { sSemesterTypeId: id },
                success: function (data) {
                    if (data.oResult && data.oResult[0]) {
                        var item = data.oResult[0];
                        $('#txtSupSemesterTypeId').val(item.SEMESTER_TYPE_ID);
                        $('#txtSupSemesterTypeCode').val(item.SEMESTER_TYPE);
                        $('#chkSupSemTypeIsActive').prop('checked', item.IS_ACTIVE == "1");
                    } else if (data.Message) {
                        alert(data.Message);
                    }
                },
                error: function (ex) {
                    alert("Error loading support semester type: " + ex.statusText);
                }
            });
        }
    }

    $('#btnSubmitSupSemesterType').click(function () {
        if ($('#supSemesterTypeForm').parsley().validate() !== true) return false;

        var id = $('#txtSupSemesterTypeId').val();
        var code = $('#txtSupSemesterTypeCode').val();
        var isActive = $('#chkSupSemTypeIsActive').is(':checked') ? "1" : "0";

        var jsonData = JSON.stringify({
            SEMESTER_TYPE_ID: id,
            SEMESTER_TYPE: code,
            IS_ACTIVE: isActive
        });

        $.ajax({
            url: "/SupportData/SaveorUpdateSupSemesterType",
            type: "POST",
            data: { sJsonData: jsonData },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success' });
                    $('#sup-semester-type-dialog').modal('hide');
                    reloadSemesterConfig('#tab-sup-semester-type');
                } else {
                    swal({ title: "Error", text: data.Message, type: 'error' });
                }
            },
            error: function () {
                swal({ title: "Error", text: "Something went wrong during submission", type: 'error' });
            }
        });
    });

    function ConfirmDeleteSupSemesterType(id) {
        swal({
            title: "Are you sure you want to delete this Support Semester Type?",
            text: "This record will be removed from active lists.",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, delete it!"
        }, function () {
            $.ajax({
                url: "/SupportData/DeleteSupSemesterTypeById",
                type: "POST",
                data: { sSemesterTypeId: id },
                success: function (data) {
                    swal({ title: "Deleted!", text: data.Message, type: 'success', timer: 1500, showConfirmButton: false });
                    reloadSemesterConfig('#tab-sup-semester-type');
                },
                error: function () {
                    swal({ title: "Error", text: "Unable to delete support semester type", type: 'error' });
                }
            });
        });
    }

    function ToggleSupSemesterTypeStatus(id, nextMode) {
        swal({
            title: "Are you sure you want to update the status?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-primary",
            confirmButtonText: "Yes, change it!"
        }, function () {
            $.ajax({
                url: "/SupportData/ToggleSupSemesterTypeStatus",
                type: "POST",
                data: { sSemesterTypeId: id, sMode: nextMode },
                success: function (data) {
                    swal({ title: "Updated!", text: data.Message, type: 'success', timer: 1500, showConfirmButton: false });
                    reloadSemesterConfig('#tab-sup-semester-type');
                },
                error: function () {
                    swal({ title: "Error", text: "Unable to update status", type: 'error' });
                }
            });
        });
    }

    // =========================================================================
    // 3. SUPPORT SEMESTER FUNCTIONS
    // =========================================================================
    $('#AddSupSemesterBtn').click(function () {
        $('#supSemesterForm').parsley().destroy();
        $('#lblModalTitleSupSemester').text('Add Semester');
        $('#txtSupSemesterId').val('');
        $('#txtSupSemesterName').val('');
        $('#ddlSupSemesterType').val('').selectpicker('refresh');
        $('#chkSupSemIsActive').prop('checked', true);
    });

    function FetchSupSemesterById(id) {
        $('#supSemesterForm').parsley().destroy();
        $('#lblModalTitleSupSemester').text('Edit Semester');
        if (id) {
            $.ajax({
                url: "/SupportData/FetchSupSemesterById",
                type: "POST",
                data: { sSupSemesterId: id },
                success: function (data) {
                    if (data.oResult && data.oResult[0]) {
                        var item = data.oResult[0];
                        $('#txtSupSemesterId').val(item.SUP_SEMESTER_ID);
                        $('#txtSupSemesterName').val(item.SEMESTER_NAME);
                        $('#ddlSupSemesterType').val(item.SEMESTER_TYPE).selectpicker('refresh');
                        $('#chkSupSemIsActive').prop('checked', item.IS_ACTIVE == "1");
                    } else if (data.Message) {
                        alert(data.Message);
                    }
                },
                error: function (ex) {
                    alert("Error loading semester: " + ex.statusText);
                }
            });
        }
    }

    $('#btnSubmitSupSemester').click(function () {
        if ($('#supSemesterForm').parsley().validate() !== true) return false;

        var id = $('#txtSupSemesterId').val();
        var name = $('#txtSupSemesterName').val();
        var semType = $('#ddlSupSemesterType').val();
        var isActive = $('#chkSupSemIsActive').is(':checked') ? "1" : "0";

        var jsonData = JSON.stringify({
            SUP_SEMESTER_ID: id,
            SEMESTER_NAME: name,
            SEMESTER_TYPE: semType,
            IS_ACTIVE: isActive
        });

        $.ajax({
            url: "/SupportData/SaveorUpdateSupSemester",
            type: "POST",
            data: { sJsonData: jsonData },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success' });
                    $('#sup-semester-dialog').modal('hide');
                    reloadSemesterConfig('#tab-sup-semester');
                } else {
                    swal({ title: "Error", text: data.Message, type: 'error' });
                }
            },
            error: function () {
                swal({ title: "Error", text: "Something went wrong during submission", type: 'error' });
            }
        });
    });

    function ConfirmDeleteSupSemester(id) {
        swal({
            title: "Are you sure you want to delete this Semester?",
            text: "This record will be removed from active lists.",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, delete it!"
        }, function () {
            $.ajax({
                url: "/SupportData/DeleteSupSemesterById",
                type: "POST",
                data: { sSupSemesterId: id },
                success: function (data) {
                    swal({ title: "Deleted!", text: data.Message, type: 'success', timer: 1500, showConfirmButton: false });
                    reloadSemesterConfig('#tab-sup-semester');
                },
                error: function () {
                    swal({ title: "Error", text: "Unable to delete semester", type: 'error' });
                }
            });
        });
    }

    function ToggleSupSemesterStatus(id, nextMode) {
        swal({
            title: "Are you sure you want to update the status?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-primary",
            confirmButtonText: "Yes, change it!"
        }, function () {
            $.ajax({
                url: "/SupportData/ToggleSupSemesterStatus",
                type: "POST",
                data: { sSupSemesterId: id, sMode: nextMode },
                success: function (data) {
                    swal({ title: "Updated!", text: data.Message, type: 'success', timer: 1500, showConfirmButton: false });
                    reloadSemesterConfig('#tab-sup-semester');
                },
                error: function () {
                    swal({ title: "Error", text: "Unable to update status", type: 'error' });
                }
            });
        });
    }
</script>
