
@model CMS.ViewModel.ViewModel.IQACViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BindIQACPreparationandUpdationOfNotes";
    Layout = null;
}

@if (Model.sMessage != null && Model.sMessage != "")
{
    <div class="alert alert-danger">No Record(s) Found !</div>

}
else
{

    if (Model.liPreparation != null && Model.liPreparation.Count > 0)
    {
        int count = 0;
        <div class="col-md-12 table-responsive">

            @*if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
                {
                <div class="text-center">
                    <img class="image" />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
                </div>
                <div class="text-center">

                    <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                    <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                    <h5>
                        LIBRARY  REPORT FOR <label id="lblReportName">m</label> &nbsp;-(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                            { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } }) <br />

                    </h5>
                </div>
                }*@
            <label class="text-center col-xs-10" id="lblQuestion"></label> <br />
            <label class="text-center col-xs-10" id="lblMonth"></label>
            <br />
            

            <div>
                <table class="table table-bordered table-responsive table-hover" id="tblReport" border="1">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ac Year</th>
                            <th>Name of the staff</th>
                            <th>Dept</th>
                            <th>Class</th>
                            <th>Sem</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Publication</th>
                            <th>Year of Publication</th>
                            <th>Place of library</th>
                            <th>Website Refered</th>
                            <th>E Resource Developed</th>
                        </tr>
                    </thead>

                    <tfoot id="tfooter">
                        <tr>
                            <th>#</th>
                            <th>Name of the staff</th>
                            <th>Dept</th>
                            <th>Class</th>
                            <th>Sem</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Publication</th>
                            <th>Year of Publication</th>
                            <th>Place of library</th>
                            <th>Website Refered</th>
                            <th>E Resource Developed</th>
                        </tr>
                    </tfoot>

                    <tbody>
                    @foreach (var item in Model.liPreparation)
                    {
                        <tr>
                            <td>@{count++;}@count</td>
                            <td>@item.ACADEMIC_YEAR</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.DEPARTMENT_CODE</td>
                            <td>@item.CLASS_CODE</td>
                            <td>@item.SEMESTER_ID</td>
                            <td>@item.TITLE</td>
                            <td>@item.AUTHOR</td>
                            <td>@item.PUBLICATION</td>
                            <td>@item.YEAR_OF_PUBLICATION</td>
                            <td>@item.PLACE_OF_LIBRARY</td>
                            <td>@item.WEBSITE_REFFERED</td>
                            <td>@item.E_RESOURSE_DEVELOPED</td>
                        </tr>
                    }</tbody>
                </table>
                <hr />
            </div>
        </div>

        <div class="col-md-1">
            <button class="btn btn-primary" onclick="printDiv()" id="btnPrint"> Print </button>
        </div>
        <div class="col-md-1">
            <button class="btn btn-primary" onclick="Export()" id="btnExport"> Export </button>
        </div>
    }
}




