@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}



<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover" id="tblResourcePerson">
        <thead>
            <tr>
                <th>#</th>
                <th>Organizer Type</th>
                <th>Organizer Name</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liOrganizer != null && Model.liOrganizer.Count > 0)
            {
                int nCount = 0;
                foreach (var item in Model.liOrganizer)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.ORGANIZER</td>
                        <td>@item.ORGANIZER_NAME</td>
                    </tr>
                                }
                            }
        </tbody>
    </table>
</div>