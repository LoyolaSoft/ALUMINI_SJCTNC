@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}


<div class="form-horizontal table-responsive col-md-12">
        <table class="table table-bordered" id="tblIQACBookPublication">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Department </th>
                    <th>Staff Code</th>
                    <th>Staff Name</th>
                    <th>Chapter</th>
                    <th>Book Title</th>
                    <th>Chapter Title</th>
                    <th>Publisher</th>
                    <th>Year</th>
                    <th>ISBN</th>
                    <th>Single Author</th>
                    <th>Editor</th>
                </tr>
            </thead>
            <tfoot id="tfooter">
                <tr>
                    <th>#</th>
                    <th>Department </th>
                    <th>Staff Code</th>
                    <th>Staff Name</th>
                    <th>Chapter</th>
                    <th>Book Title</th>
                    <th>Chapter Title</th>
                    <th>Publisher</th>
                    <th>Year</th>
                    <th>ISBN</th>
                    <th>Single Author</th>
                    <th>Editor</th>
                </tr>
            </tfoot>
            <tbody>
                @{
                    if (Model.liBookPublication != null && Model.liBookPublication.Count > 0)
                    {
                        int ncount = 0;
                        foreach (var item in Model.liBookPublication)
                        {
                            <tr>
                                <td>@{ncount++;} @ncount</td>
                                <td>@item.DEPARTMENT</td>
                                <td>@item.STAFF_CODE</td>
                                <td>@item.FIRST_NAME</td>
                                <td>@item.CHAPTER</td>
                                <td>@item.BOOK_TITLE</td>
                                <td>@item.CHAPTER_TITLE</td>
                                <td>@item.PUBLISHER</td>
                                <td>@item.PUBLICATION_YEAR</td>
                                <td>@item.ISBN_NUMBER</td>
                                <td>@item.SINGLE_AUTHOR</td>
                                <td>@item.EDITOR</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

