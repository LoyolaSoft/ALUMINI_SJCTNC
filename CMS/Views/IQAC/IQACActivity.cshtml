<script>
   function ContentLoad()
   {
       //$('#liAchivements').click();
       // Document Ready Function .
   }

   $('.selectpicker').selectpicker({
       size: 6
   });
   $('.selectpicker').selectpicker('refresh');

   handleDatepicker = function () {
       "use strict";
       $(".date").datepicker({
           todayHighlight: !0,
           autoclose: !0,
           endDate:new Date,
           format: "dd/mm/yyyy",
           orientation: "left"
           // 'top': top,
           // 'left': left
       })
   }
   handleDatepicker();
</script>

@* This Script For Load Page By Click Id *@
<script>
    // Achivements ,...
    $('#liAchivements').on('click', function ()
    {
        formData = new FormData();
        $.ajax({
            url:'@Url.Action("Achivements", "IQAC")',
            method:'POST',
            datatype: 'json',
            success: function (data)
            {
                $('#Achivements').empty();
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Warning Message!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
                } else
                {
                    $('#Achivements').append(data);
                   // $('.selectpicker').selectpicker('refresh');
                   // handleDatepicker();
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

