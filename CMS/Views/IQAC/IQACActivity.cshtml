@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">IQAC Personal Academic Activity</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">IQAC  Personal Academic Activity<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">IQAC  Personal Academic Activity</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal" id="dvIQACBind" data-parsley-validate="true">
                    <!-- begin row -->
                    <div class="row">

                        <ul class="nav nav-tabs">
                                <li class="active" id="liAchivements">
                                    <a href="#Achivements" data-toggle="tab">
                                        <span class="visible-xs">Achivements</span>
                                        <span class="hidden-xs">Achivements</span>
                                    </a>
                                </li>
                                <li class="" id="liProject">
                                    <a href="#Project" data-toggle="tab">
                                        <span class="visible-xs">Project</span>
                                        <span class="hidden-xs">Project</span>
                                    </a>
                                </li>
                                <li class="" id="liResearchGudience">
                                    <a href="#ResearchGudience" data-toggle="tab">
                                        <span class="visible-xs">Research Guidance</span>
                                        <span class="hidden-xs">Research Guidance</span>
                                    </a>
                                </li>
                                <li class="" id="liPHDGudience">
                                    <a href="#PHDGudience" data-toggle="tab">
                                        <span class="visible-xs">Ph.D Guidance</span>
                                        <span class="hidden-xs">Ph.D Guidance</span>
                                    </a>
                                </li>
                                <li class="" id="liActivity">
                                    <a href="#Activity" data-toggle="tab">
                                        <span class="visible-xs">Presented / Participated</span>
                                        <span class="hidden-xs">Presented / Participated</span>
                                    </a>
                                </li>
                                <li class="" id="liPaperPublication">
                                    <a href="#PaperPublication" data-toggle="tab">
                                        <span class="visible-xs">Paper Publication</span>
                                        <span class="hidden-xs">Paper Publication</span>
                                    </a>
                                </li>
                                <li class="" id="liBookPublication">
                                    <a href="#BookPublication" data-toggle="tab">
                                        <span class="visible-xs">Book Publication</span>
                                        <span class="hidden-xs">Book Publication</span>
                                    </a>
                                </li>
                            </ul>

                        <div class="tab-content">
                                <div class="tab-pane  active in" id="Achivements">
                                   @Html.Action("Achivements", "IQAC")
                                </div>
                                
                                <div class="tab-pane" id="Project">
                                    
                                </div>
                                <div class="tab-pane" id="ResearchGudience">

                                </div>
                                <div class="tab-pane" id="PHDGudience">

                                </div>
                                <div class="tab-pane" id="Activity">

                                </div>
                                <div class="tab-pane" id="PaperPublication">

                                </div>
                                <div class="tab-pane" id="BookPublication">

                                </div>
                            </div>
                        
                    </div>

                </div>
            }
</div>
</div>
</div>

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
