                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="dvIQACBind">

                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        @Html.Label("Organizer", htmlAttributes: new { @class = "col-md-3 control-label" })
                                        <div class="col-md-9">
                                            <div class="form-group">
                                                <a href="javascript:;" onclick="AddOrganizer()" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
                                            </div>

                                            <table class="table table-bordered table-hover" id="tblOrganizer">
                                                <thead>
                                                    <tr>
                                                        <th>Organizer</th>
                                                        <th>Name</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbBind">
                                                    <tr id="tdClone" cms-key="">
                                                        <td>
                                                            @Html.DropDownListFor(m => m.sOrganizerList, (Model.sOrganizerList != null) ? Model.sOrganizerList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  input-sm", @data_parsley_required = "true" })
                                                            @Html.ValidationMessageFor(m => m.sOrganizerList, "", new { @class = "text-danger" })
                                                        </td>
                                                        <td>
                                                            <input type="text" class="form-control input-sm" placeholder="Enter Name" data-parsley-required="true" />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
