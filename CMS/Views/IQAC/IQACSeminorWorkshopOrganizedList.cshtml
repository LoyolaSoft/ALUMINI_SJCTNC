@model CMS.ViewModel.ViewModel.IQACViewModel


@{
    Layout = null;
}

<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">Seminar / Workshop Organized</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Seminar / Workshop Organized<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Seminar / Workshop Organized</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group col-md-12 table-responsive">
                        <div class="form-group col-md-12 pull-right">
                            <a class="btn btn-success pull-right" data-toggle="modal" href="#IQACSeminorWorkshop-dialog"><i class="fa fa-plus"></i> Add</a>
                        </div>
                        <table class="table table-hover table-bordered" id="tblSeminorWorkshopOrganized">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Type Of Program</th>
                                    <th>Date</th>
                                    <th>Title</th>
                                    <th>Level</th>
                                    <th>Guest Person</th>
                                    <th>Organizer</th>
                                    @*<th>File</th>*@
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>

                                @if (Model.liSeminorWorkshopOrganized != null && Model.liSeminorWorkshopOrganized.Count > 0)
                                {
                                    var count = 0;
                                    foreach (var item in Model.liSeminorWorkshopOrganized)
                                    {
                                        count = count + 1;
                                        <tr>
                                            <td>@count</td>
                                            <td>@item.PROGRAMME_TYPE_ID</td>
                                            <td>@item.ORGANIZED_DATE</td>
                                            <td>@item.TITLE</td>
                                            <td>@item.LEVEL_ID</td>
                                            <td><a href="#IQACResourcePerson-dialog" data-toggle="modal" onclick="FetchResourcePerson(@item.IQAC_ID)"><i class="glyphicon glyphicon-eye-open"></i></a></td>
                                            <td><a href="#IQACResourcePerson-dialog" data-toggle="modal" onclick="FetchOrganizer(@item.IQAC_ID)"><i class="glyphicon glyphicon-eye-open"></i></a></td>
                                            @*@if (!string.IsNullOrEmpty(item.FILE_PATH))
                                            {
                                                <td><a href="@Url.Content(item.FILE_PATH)" download><i class="fa fa-download text-primary"></i></a></td>
                                            }
                                            else
                                            {
                                                <td>N/A</td>
                                            }*@
                                            <td>
                                                <a href="#IQACSeminorWorkshop-dialog" onclick="FetchSeminorWorkshopOrganizedById(@item.IQAC_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                                <a href="javascrip:;" onclick="GetConfirm(@item.IQAC_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<a href="javascript:;" id="LoadList" class="hidden" onclick="loadContent('/IQAC/IQACSeminorWorkshopOrganizedList')"></a>

<div class="modal" id="IQACSeminorWorkshop-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit IQAC Seminar Workshop Organized</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Type Of Programme</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sProgrammeTypeList, (Model.sProgrammeTypeList != null) ? Model.sProgrammeTypeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
