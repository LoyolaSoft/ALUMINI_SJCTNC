<script>
    handleDatepicker = function () {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            endDate: new Date,
            format: "dd/mm/yyyy",
            orientation: "left"
            // 'top': top,
            // 'left': left
        })
    }
    handleDatepicker();

    function ContentLoad() {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
    $('#tblSeminorWorkshopOrganized').DataTable();
</script>

<script>

    $('#sProgrammeTypeList').on('change', function () {
        if ($('#sProgrammeTypeList').val() == '8') {
            $('#txtOthers').attr('data-parsley-required', 'true');
            $('#dvOthers').removeClass('hidden');
        } else {
            $('#txtOthers').attr('data-parsley-required', 'false');
            $('#dvOthers').addClass('hidden');
        }
    });
    var nCount = 2;
    function ResourcePerson() {
        //var sText = $('#dvGuest').clone().removeClass('hidden');
        var sValue = null;
        var sDom = $('#dvIQAC1').clone();
        sDom.attr('id', 'dvIQAC' + nCount);
        sDom.find('#dvResourcePerson1').attr('id', 'dvResourcePerson' + nCount);
        sDom.find('#dvcount1').attr('id', 'dvcount' + nCount);
        sDom.find('#dvcount' + nCount).text(nCount);
        sDom.find('#dvResourcePerson' + nCount).attr('href', '#Resource_Person' + nCount);
        sDom.find('#Resource_Person1').attr('id', 'Resource_Person' + nCount);
        sDom.find('input').val('');
        sDom.appendTo('#dvIQACBind');
        // $('#dvIQACBind').append(sDom);
        nCount = nCount + 1;
    }

    function AddOrganizer() {
        var T_clone = $('#tdClone').clone();
        T_clone.find('input').val('');
        $('#tbBind').append(T_clone);
    }
</script>

<script>
    $(function () {
        $('#IQACSeminorWorkshop-dialog').on('hidden.bs.modal', function (e) {
            nCount = 2;
            $('#dvIQACBind').empty();
            $('#iqacSeminorWorkshopId').val('');
            $('#sProgrammeTypeList').val('');
            $('#txtFromDate').val('');
            $('#txtToDate').val('');
            $('#txtTitle').val('');
            $('#txtOthers').val('');
            $('#sLevelList').val('');

            $('#dvIQAC1').find('#sGuestList').val("");
            $('#dvIQAC1').find('input').val("");
            $('.selectpicker').selectpicker('refresh');
        });
    });

    function SaveData() {
        // Validation Check ,...
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
    
        //for image update
        var SeminorImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#sFileUploadData').find("table tbody tr").each(function () {
            if ($(this).attr("cms-img-path")) {
                SeminorImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else {
                if ($(this).attr("id")) {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0) {
            SeminorImagePath = SeminorImagePath.slice(0, -1);
            SeminorImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto')) {
                formData.delete("sPhoto");
            }
            formData.append("sPhoto", SeminorImagePath);
        }
        if (iCount > 0) {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }

        var sJsonData = null;
        sJsonData = '{"IQAC_ID":"' + $('#iqacSeminorWorkshopId').val() + '",\
                      "PROGRAMME_TYPE_ID":"' + $('#sProgrammeTypeList').val() + '",\
                      "ORGANIZED_DATE":"' + $('#txtFromDate').val() + '",\
                      "TO_DATE":"' + $('#txtToDate').val() + '",\
                      "TITLE":"' + $('#txtTitle').val() + '",\
                      "IF_OTHER_SPECIFY":"' + $('#txtOthers').val() + '",\
                      "LEVEL_ID":"' + $('#sLevelList').val() + '",\
                      "FILE_PATH":"' + FilePath + '"}';
        var sJsonList = "{liResourcePerson:[";

        for (var i = 1; i < nCount; i++) {
            sJsonList += '{"QUESTION_ID":"1",\
                           "GUEST_ID":"' + $('#dvIQAC' + i).find('#sGuestList Option:selected').val() + '",\
                           "PERSON_NAME":"' + $('#dvIQAC' + i).find('#txtName').val() + '",\
                           "DESIGNATION":"' + $('#dvIQAC' + i).find('#txtDesignation').val() + '",\
                           "INSTITUTION":"' + $('#dvIQAC' + i).find('#txtInstitution').val() + '",\
                           "PLACE":"' + $('#dvIQAC' + i).find('#txtPlace').val() + '",\
                           "TOPIC":"' + $('#dvIQAC' + i).find('#txtTopic').val() + '",\
                           "RESOURCE_PERSON_ID":"' + $('#dvIQAC' + i).find('#txtResourcePersonId').val() + '"},';
        }
        sJsonList.slice(0, -1);
        sJsonList = sJsonList + "]}";

        var sJsonOrganizer = '{liOrganizer:[';
        $('#tblOrganizer tbody tr').each(function () {
            sJsonOrganizer += '{"ORGANIZER_ID":"' + $(this).closest('tr').find('select:eq(0)').val() + '","SUP_ORGANIZER_ID":"' + $(this).closest('tr').attr('cms-key') + '","ORGANIZER_NAME":"' + $(this).closest('tr').find('input:eq(0)').val() + '"},';
        });
        sJsonOrganizer.slice(0, -1);
        sJsonOrganizer = sJsonOrganizer + "]}";

        formData.append("JsonData", sJsonData);
        formData.append("JsonList", sJsonList);
        formData.append("JsonOrganizer", sJsonOrganizer);
        $.ajax({
            url: '@Url.Action("SaveSeminorWorkshopOrganized", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    $('.modal-backdrop').removeClass('modal-backdrop in');
                    $('#LoadList').click();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
    function FetchSeminorWorkshopOrganizedById(Id) {
        $.ajax({
            url: '@Url.Action("FetchSeminorWorkshopOrganizedById", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { IqacId: Id },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {
                    var Count = 0; $('#dvIQACBind').empty();
                    $.each(data.liResourcePerson, function (i, e) {
                        if (i != 0) {
                            ResourcePerson();
                        }
                        Count = i + 1; 
                        $('#dvIQAC' + Count).find('select option[text="' + e.GUEST_ID + '"]').attr('selected', 'true');
                        $('#dvIQAC' + Count).find('#txtName').val(e.PERSON_NAME);
                        $('#dvIQAC' + Count).find('#txtDesignation').val(e.DESIGNATION);
                        $('#dvIQAC' + Count).find('#txtInstitution').val(e.INSTITUTION);
                        $('#dvIQAC' + Count).find('#txtPlace').val(e.PLACE);
                        $('#dvIQAC' + Count).find('#txtTopic').val(e.TOPIC);
                        $('#dvIQAC' + Count).find('#txtResourcePersonId').val(e.RESOURCE_PERSON_ID);
                    });

