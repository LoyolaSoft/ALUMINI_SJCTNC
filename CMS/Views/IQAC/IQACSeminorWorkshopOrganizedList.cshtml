                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">To Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                <input type="text" name="txtGuidenceDate" class="form-control input-sm" placeholder="Select  Date" id="txtToDate" data-parsley-required="true" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Title</label>
                                        <div class="col-md-8">
                                            <textarea class="form-control" id="txtTitle" rows="5"></textarea>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Level</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sLevelList, (Model.sLevelList != null) ? Model.sLevelList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sLevelList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Resource Person</label>
                                        <div class="col-md-8">
                                            <div class="row pull-right">
                                                <a href="javascript:;" class="btn btn-success pull-right" onclick="ResourcePerson()"><i class="fa fa-plus"></i> Add</a>
                                            </div> <br /><br /><br />
                                            <div id="dvIQAC1" class="row">
                                                <div class="form-group panel-group" id="accordion">
                                                    <div class="panel panel-info overflow-hidden">
                                                        <div class="panel-heading">
                                                            <h3 class="panel-title">
                                                                <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" id="dvResourcePerson1" href="#Resource_Person1">
                                                                    <i class="fa fa-plus-circle pull-right"></i>
                                                                    <span id="dvcount1">1</span> . Resource Person
                                                                </a>
                                                            </h3>
                                                        </div>
                                                        <div id="Resource_Person1" class="panel-collapse collapse">
                                                            <div class="panel-body">

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Guest</label>
                                                                    <div class="col-md-9">
                                                                        @Html.DropDownListFor(m => m.sGuestList, (Model.sGuestList != null) ? Model.sGuestList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  input-sm" })
                                                                        @Html.ValidationMessageFor(m => m.sGuestList, "", new { @class = "text-danger" })
                                                                    </div>
                                                                </div>


                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Name</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtName" value="" class="form-control" data-parsley-required="true" placeholder="Resource Person Name" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Designation</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtDesignation" value="" class="form-control" data-parsley-required="true" placeholder="Resource Person Designation" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Institution</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtInstitution" value="" class="form-control" data-parsley-required="true" placeholder="Resource Person Institution" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Place</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtPlace" value="" class="form-control" data-parsley-required="true" placeholder="Place Of Institution " />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Topic</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtTopic" class="form-control" value="" data-parsley-required="true" placeholder="Resource Person Topic" />
                                                                    </div>
                                                                </div>
