@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
    string sChecked = string.Empty;
}



<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered" id="tblIQAC">
        <thead>
            <tr>
                <th>Cycle</th>
                <th>Unit <span class="text-danger">(in numbers)</span></th>
                <th>Topic</th>
                <th>Teaching Methods(Lecture/Chalk and Talk/ICT/Seminar/Etc.)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liLessonPlan != null && Model.liLessonPlan.Count > 0)
            {
                for (int i = 1; i <= 15; i++)
                {
                    var liLessonPlan = Model.liLessonPlan.Where(x => x.CYCLE == i.ToString()).ToList();
                    if (liLessonPlan != null && liLessonPlan.Count > 0)
                    {
                        <tr cms-IQACID="@liLessonPlan.FirstOrDefault().IQAC_ID" cms-row="@liLessonPlan.FirstOrDefault().CYCLE">
                            <td>@i</td>
                            <td><input type="text" data-parsley-type="number" data-parsley-maxlength="10" class="form-control" data-parsley-required="true" value="@liLessonPlan.FirstOrDefault().UNIT" /></td>
                            <td><textarea data-parsley-required="true" data-parsley-maxlength="300" style="height:100px; width:400px;" class="form-control">@liLessonPlan.FirstOrDefault().TOPIC</textarea></td>
                            <td><input type="text" class="form-control techingPlanText" data-parsley-required="true" value="@liLessonPlan.FirstOrDefault().TEACHING_METHOD"/></td>
                            <td>
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="cssRadio_@liLessonPlan.FirstOrDefault().CYCLE" data-parsley-required="true" id="cssRadio1_@liLessonPlan.FirstOrDefault().CYCLE" value="1" @if (liLessonPlan.FirstOrDefault().STATUS == "1") { sChecked = "Checked"; } else { sChecked = string.Empty; } @sChecked />
                                    <label for="cssRadio1_@liLessonPlan.FirstOrDefault().CYCLE"> Completed</label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="cssRadio_@liLessonPlan.FirstOrDefault().CYCLE" id="cssRadio2_@liLessonPlan.FirstOrDefault().CYCLE" value="2" @if (liLessonPlan.FirstOrDefault().STATUS == "2") { sChecked = "Checked"; } else { sChecked = string.Empty; } @sChecked />
                                    <label for="cssRadio2_@liLessonPlan.FirstOrDefault().CYCLE">
                                        Partially Completed
                                    </label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="cssRadio_@liLessonPlan.FirstOrDefault().CYCLE" id="cssRadio3_@liLessonPlan.FirstOrDefault().CYCLE" value="3" @if (liLessonPlan.FirstOrDefault().STATUS == "3") { sChecked = "Checked"; } else { sChecked = string.Empty; } @sChecked />
                                    <label for="cssRadio3_@liLessonPlan.FirstOrDefault().CYCLE">
                                        Yet to be completed
                                    </label>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr cms-IQACID="" cms-row="@i">
                            <td>@i</td>
                            <td><input type="text" data-parsley-type="number" data-parsley-maxlength="10" class="form-control" /></td>
                            <td><textarea style="height:100px; width:400px;" data-parsley-maxlength="300" class="form-control"></textarea></td>
                            <td><input type="text" class="form-control techingPlanText"  /></td>

                            <td>
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="cssRadio_@i" id="cssRadio1_@i" value="1" />
                                    <label for="cssRadio1_@i"> Completed</label>
                                </div>

                                <div class="radio radio-css">
                                    <input type="radio" name="cssRadio_@i" id="cssRadio2_@i" value="2" />
                                    <label for="cssRadio2_@i">
                                        Partially Completed
                                    </label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="cssRadio_@i" id="cssRadio3_@i" value="3" />
                                    <label for="cssRadio3_@i">
                                        Yet to be compeleted
                                    </label>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                for (int i = 1; i <= 15; i++)
                {
                    <tr cms-IQACID="" cms-row="@i">
                        <td>@i</td>
                        <td><input type="text" data-parsley-type="number" data-parsley-maxlength="10" class="form-control" /></td>
                        <td><textarea style="height:100px; width:400px;" data-parsley-maxlength="300" class="form-control"></textarea></td>
                        <td><input type="text" class="form-control techingPlanText" /></td>

                        <td>
                            <div class="radio radio-css radio-success">
                                <input type="radio" name="cssRadio_@i" id="cssRadio1_@i" value="1" />
                                <label for="cssRadio1_@i"> Completed</label>
                            </div>

                            <div class="radio radio-css">
                                <input type="radio" name="cssRadio_@i" id="cssRadio2_@i" value="2" />
                                <label for="cssRadio2_@i">
                                    Partially Completed
                                </label>
                            </div>
                            <div class="radio radio-css">
                                <input type="radio" name="cssRadio_@i" id="cssRadio3_@i" value="3" />
                                <label for="cssRadio3_@i">
                                    Yet to be compeleted
                                </label>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>