@model CMS.ViewModel.ViewModel.IQACViewModel


@{
    Layout = null;
}
<div class="table-responsive col-md-12">
    <table class="table table-bordered table-hover" id="tblMembership">
        <thead>
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Member Type</th>
                <th>Board Of Study Member</th>
                <th>Academic cousil Member</th>
                <th>Period From</th>
                <th>Period To</th>
            </tr>
        </thead>
        <tfoot id="tfooter">
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Member Type</th>
                <th>Board Of Study Member</th>
                <th>Academic cousil Member</th>
                <th>Period From</th>
                <th>Period To</th>
            </tr>
        </tfoot>
        <tbody>
            @{
                if (Model.liMembership != null && Model.liMembership.Count > 0)
                {
                    int nCount = 0;
                    foreach (var item in Model.liMembership)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.DEPARTMENT</td>
                            <td>@item.STAFF_CODE</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.MEMBERSHIP_TYPE_ID</td>
                            <td>@item.BOARD_NAME</td>
                            <td>@item.COLLEGE_UNIVERSITY</td>
                            <td>@item.PERIOD</td>
                            <td>@item.PERIOD_TO</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>