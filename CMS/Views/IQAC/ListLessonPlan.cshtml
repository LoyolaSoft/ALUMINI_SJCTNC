@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">List Lesson Plan</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Lesson Plan<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Lesson Plan</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-5">
                            @Html.Label("Semester Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                               <select class="selectpicker form-control" id="ddlSemesterType">
                                   <option value=""> -- Select -- </option>
                                   <option value="1"> Odd Semester </option>
                                   <option value="2"> Even Semester </option>
                                   @*<option value="3"> Non Semester </option>*@
                               </select>
                            </div>
                        </div>

                        <div class="col-md-5">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.sCourseList, (Model.sCourseList != null) ? Model.sCourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sCourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-2 pull-right">
                            <a onclick="loadContent('/IQAC/LessonPlan')" href="javascript:;" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add/Edit</a>
                        </div>

                        <div class="col-md-2 pull-right">
                            <a  href="javascript:;" id="btnPrint" class="btn btn-success pull-right hidden"> Print</a>
                        </div>
                    </div>
                </div>

                
                <div id="dvIQACBind"></div>
            }
           
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>


<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>

    $('#ddlSemesterType').on('change', function ()
    {
        $('#sCourseList').empty();
        $('#dvIQACBind').empty();
        $.ajax({
            url: '@Url.Action("FetchCourseByStaffAndSemesterType", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sSemesterTypeId: $('#ddlSemesterType').val() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#sCourseList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $('#sCourseList').on('change', function ()
    {
        if ($('#sCourseList').val())
        {
            BindList();
        }
    });

    

    function BindList()
    {
        $.ajax({
            url:'@Url.Action("BindListLessonPlan", "IQAC")',
            method:'POST',
            datatype:'json',
            data: { sCourseId: $('#sCourseList').val()},
            success: function (data)
            {
                $('#dvIQACBind').empty();
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#dvIQACBind').append(data);
                    $('#btnPrint').removeClass('hidden');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

   

    function GetConfrim(ID) {
        if (!confirm('Are You Sure To Delete ?'))
        {
            return false;
        }
        $.ajax({
            url: '@Url.Action("DeleteLessonPlan", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sIQACID: ID },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    BindList();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }


    $('#btnPrint').on('click', function () {
        //var printContents = document.getElementById('dvApplicationForm').innerHTML;
        //var originalContents = document.body.innerHTML;
        //document.body.innerHTML = printContents;
        //window.print();
        //document.body.innerHTML = originalContents;
        ////location.reload();
        //$('.selectpicker').selectpicker('refresh');
        //loadContent('/Admission/ApplicationForm');


        //$('#btnGet').click();

        var printContents = document.getElementById('dvIQACBind').innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
    });
</script>