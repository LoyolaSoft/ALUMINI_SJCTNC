<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    handleDatepicker = function () {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            endDate: new Date,
            format: "dd/mm/yyyy",
            orientation: "left"
            // 'top': top,
            // 'left': left
        })
    }
    handleDatepicker();

    function ContentLoad() {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
    $('#tblAssociation').DataTable();
</script>

<script>

    $('#sActivityType').on('change', function () {
        if ($('#sActivityType').val() == '4') {
            $('#txtOthers').attr('data-parsley-required', 'true');
            $('#dvOthers').removeClass('hidden');
        } else {
            $('#txtOthers').attr('data-parsley-required', 'false');
            $('#dvOthers').addClass('hidden');
        }
    });
    var nCount = 2;
    function ResourcePerson() {
        var sDom = $('#dvIQAC1').clone();
        sDom.attr('id', 'dvIQAC' + nCount);
        sDom.find('a').attr('id', 'dvResourcePerson' + nCount);
        // sDom.attr('id', 'dvResourcePerson' + nCount);
        sDom.find('span').attr('id', 'dvcount' + nCount);
        sDom.find('#dvcount' + nCount).text(nCount);
        sDom.find('a').attr('href', '#Resource_Person' + nCount);
        sDom.find('#Resource_Person1').attr('id', 'Resource_Person' + nCount);

        $('#dvIQACBind').append(sDom);
        $('#dvIQAC' + nCount).find('#txtName').val('');
        $('#dvIQAC' + nCount).find('#txtDesignation').val('');
        $('#dvIQAC' + nCount).find('#txtInstitution').val('');
        $('#dvIQAC' + nCount).find('#txtPlace').val('');
        $('#dvIQAC' + nCount).find('#txtTopic').val('');
        $('#dvIQAC' + nCount).find('#txtResourcePersonId').val('');
        nCount = nCount + 1;
    }
</script>

<script>
    $(function () {
        $('#IQACAssociation-dialog').on('hidden.bs.modal', function (e) {
            nCount = 2;
            $('#iqacAssociationId').val('');
            $('#sActivityType').val('');
            $('#txtFromDate').val('');
            $('#txtToDate').val('');
            $('#sShiftList').val('');
            $('#txtOthers').val('');
            $('#txtDetails').val('');
        });
    });
    function SaveData() {
        // Validation Check ,...
        var isValid = true;
        if ($('#AssocicationModalBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }

        //for image update
        var SeminorImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#sFileUploadData').find("table tbody tr").each(function () {
            if ($(this).attr("cms-img-path")) {
                SeminorImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else {
                if ($(this).attr("id")) {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0) {
            SeminorImagePath = SeminorImagePath.slice(0, -1);
            SeminorImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto')) {
                formData.delete("sPhoto");
            }
            formData.append("sPhoto", SeminorImagePath);
        }
        if (iCount > 0) {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }

        var sJsonData = null; var sJsonList = "{liResourcePerson:[";
        sJsonData = '{"IQAC_ID":"' + $('#iqacAssociationId').val() + '",\
                      "ACTIVITY_ID":"' + $('#sActivityType').val() + '",\
                      "ACTIVITY_DATE":"' + $('#txtFromDate').val() + '",\
                      "TO_DATE":"' + $('#txtToDate').val() + '",\
                      "SHIFT_ID":"' + $('#sShiftList').val() + '",\
                      "IF_OTHERS_SPECIFY":"' + $('#txtOthers').val() + '",\
                      "DETAILS":"' + $('#txtDetails').val() + '","FILE_PATH":"' + FilePath + '"}';
        for (var i = 1; i < nCount; i++) {
            sJsonList += '{"QUESTION_ID":"2",\
                           "PERSON_NAME":"' + $('#dvIQAC' + i).find('#txtName').val() + '",\
                           "DESIGNATION":"' + $('#dvIQAC' + i).find('#txtDesignation').val() + '",\
                           "INSTITUTION":"' + $('#dvIQAC' + i).find('#txtInstitution').val() + '",\
                           "PLACE":"' + $('#dvIQAC' + i).find('#txtPlace').val() + '",\
                           "TOPIC":"' + $('#dvIQAC' + i).find('#txtTopic').val() + '",\
                           "RESOURCE_PERSON_ID":"' + $('#dvIQAC' + i).find('#txtResourcePersonId').val() + '"},';
        }
        sJsonList = sJsonList.slice(0, -1);
        sJsonList = sJsonList + "]}";

        formData.append("sJsonData", sJsonData);
        formData.append("sJsonList", sJsonList);
        $.ajax({
            url: '@Url.Action("SaveAssociationActivities", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data)
            {
                if (data.ErrorCode == "200")
                {
                    $('.modal-backdrop in').removeClass('modal-backdrop in');
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    $('#LoadList').click();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
    function FetchActivityById(Id) {
        $.ajax({
            url: '@Url.Action("FetchAssociationActivities", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { IqacId: Id },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {
                    var Count = 0;

                    if (data.liAssociationActivity[0].ACTIVITY_ID == "4") {
                        $('#txtOthers').attr('data-parsley-required', 'true');
                        $('#dvOthers').removeClass('hidden');
                    } else {
                        $('#txtOthers').attr('data-parsley-required', 'false');
                        $('#dvOthers').addClass('hidden');
                    }
                    $('#iqacAssociationId').val(data.liAssociationActivity[0].IQAC_ID);
                    $('#sActivityType').val(data.liAssociationActivity[0].ACTIVITY_ID);
                    $('#txtFromDate').val(data.liAssociationActivity[0].ACTIVITY_DATE);
                    $('#txtToDate').val(data.liAssociationActivity[0].TO_DATE);
                    $('#sShiftList').val(data.liAssociationActivity[0].SHIFT_ID);
                    $('#txtOthers').val(data.liAssociationActivity[0].IF_OTHERS_SPECIFY);
                    $('#txtDetails').text(data.liAssociationActivity[0].DETAILS);
                    BindFileInfo(data.liAssociationActivity[0].FILE_PATH, 'tbsFileUpload', 'sFileUploadData');
                    $('.selectpicker').selectpicker('refresh');

                    if (data.liResourcePerson[0].PERSON_NAME != null && data.liResourcePerson[0].PERSON_NAME != '') {
                        $.each(data.liResourcePerson, function (i, e) {
                            if (i != 0) {
                                ResourcePerson();
                            }
                            Count = i + 1;
                            $('#dvIQAC' + Count).find('#txtName').val(e.PERSON_NAME);
                            $('#dvIQAC' + Count).find('#txtDesignation').val(e.DESIGNATION);
                            $('#dvIQAC' + Count).find('#txtInstitution').val(e.INSTITUTION);
                            $('#dvIQAC' + Count).find('#txtPlace').val(e.PLACE);
                            $('#dvIQAC' + Count).find('#txtTopic').val(e.TOPIC);
                            $('#dvIQAC' + Count).find('#txtResourcePersonId').val(e.RESOURCE_PERSON_ID);

                        });
                    }



                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function GetConfirm(Id) {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("DeleteAssociationActivities", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { IqacId: Id },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    $('#LoadList').click();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }


    function FetchResourcePerson(Id) {
        $.ajax({
            url: '@Url.Action("FetchResourcePersonByAssociationId", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { IqacId: Id },
            success: function (data) {
                $('#dvResourcePersonBind').empty();
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {
                    $('#dvResourcePersonBind').append(data);
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

@* File Upload Script *@
<script>
    var formData = new FormData();
    var nsCount = 0; var nFileCount = 0;
    function FileClick(FileUpload) {
        $('#' + FileUpload).click();
    }

    function LoadFile(divUpload, FileUpload) {

        var files = document.getElementById('' + FileUpload + '').files;

        if (files.length > 3 || nFileCount >= 3) {
            swal({ title: "Warning !", text: "You can only upload a maximum of 3 files", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        var Data = '';
        if (files.length != 0) {
            // alert('File In');
            //alert(document.getElementById('' + FileUpload + '').files.length);
            for (var i = 0; i < document.getElementById('' + FileUpload + '').files.length ; i++) {
                var extension = GetFileExtension(files[i]);
                var actualFileDom = '';
                if (extension != null && extension != '') {
                    if (extension == 'jpg' || extension == 'png') {
                        actualFileDom = "<li class=''>" +
                                                      "<div class='document-file'>" +
                                                          "<a href='#'>" +
                                                              "<img src=" + window.URL.createObjectURL(files[i]) + "   alt='' cms-update='1' width='77' height='80' >" +
                                                          "</a>" +
                                                      "</div>" +
                                                      "<div class='document-name'><a href='" + window.URL.createObjectURL(files[i]) + "' download>" + files[i].name + "</a></div>" +
                                                  "</li>";
                        //actualFileDom ="<img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + UniqueName + "></img>";
                    }
                    else {
                        actualFileDom = "<li class=''>" +
                                                  "<div class='document-file'>" +
                                                  "<a href='#'>" +
                                                      "<i class='fa fa-file'></i>" +
                                                  "</a>" +
                                                  "</div>" +
                                                 "<div class='document-name'><a href='" + window.URL.createObjectURL(files[i]) + "' download  title=" + files[i].name + " cms-update='1'>" + files[i].name + "</a></div>" +
                                            "</li>";
                        //actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                    }

                    var result = "<ul class='attached-document clearfix'>" + actualFileDom + "</ul> ";

                    // data.append(files[i].name, files[i]);
                    nsCount++; nFileCount++;
                    Data += '<tr id=' + nsCount + '>\
                            <td>' + nsCount + '</td>\
                            <td>'+ result + '</td>\
                            <td><a class="btn btn-default" onclick="FileCancel(' + nsCount + ')"> Cancel </a></td>\
                         </tr>';
                    formData.append(files[i].name, files[i]);
                }
            }

            $('#tb' + FileUpload).append(Data);
            $('#' + divUpload).removeClass('hidden');
        }
    }

    
    function GetFileExtension(file) {
        // Get uploaded file extension
        var extension = file.name.split('.').pop().toLowerCase();
        var validFileExtensions = ['doc', 'docx', 'pdf', 'jpg', 'png', 'txt', 'xlsx'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            // alert("Sorry!! Upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file");
            swal({ title: "Warning !", text: "Sorry!! upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return extension = null;
        }
        else {
            return extension;
        }
    }


    function FileCancel(rowId) {
        var row = document.getElementById(rowId);
        formData.delete(rowId);
        row.parentNode.removeChild(row);
        nFileCount--;
    }
</script>


