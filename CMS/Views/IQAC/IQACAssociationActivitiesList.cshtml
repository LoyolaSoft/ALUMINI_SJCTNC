@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
}

<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">Association Activities</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Association Activities<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Association Activities</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                if (Model.sFlag)
                {
                    <div class="form-horizontal">

                        <div class="form-group col-md-12 table-responsive">
                            <div class="form-group col-md-12 pull-right">
                                <a class="btn btn-success pull-right" data-toggle="modal" href="#IQACAssociation-dialog"><i class="fa fa-plus"></i> Add</a>
                            </div>
                            <table class="table table-hover table-bordered" id="tblAssociation">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Type Of Activity</th>
                                        <th>If Other</th>
                                        <th>Date</th>
                                        <th>Details</th>
                                        <th>Resource Person</th>
                                        @*<th>File</th>*@
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.liAssociationActivity != null && Model.liAssociationActivity.Count > 0)
                                    {
                                        var count = 0;
                                        foreach (var item in Model.liAssociationActivity)
                                        {
                                            count = count + 1;
                                            <tr>
                                                <td>@count</td>
                                                <td>@item.ACTIVITY_ID</td>
                                                <td>@item.IF_OTHERS_SPECIFY</td>
                                                <td>@item.ACTIVITY_DATE</td>
                                                <td>@item.DETAILS</td>
                                                <td><a href="#IQACResourcePerson-dialog" data-toggle="modal" onclick="FetchResourcePerson(@item.IQAC_ID)"><i class="glyphicon glyphicon-eye-open"></i></a></td>
                                                @*@if (!string.IsNullOrEmpty(item.FILE_PATH))
                                                {
                                                    <td><a href="@item.FILE_PATH" download><i class="fa fa-download text-primary"></i></a></td>
                                                }
                                                else
                                                {
                                                    <td>N/A</td>
                                                }*@
                                                <td>
                                                    <a href="#IQACAssociation-dialog" onclick="FetchActivityById(@item.IQAC_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                                    <a href="javascrip:;" onclick="GetConfirm(@item.IQAC_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger alert-dismissable"> Your Not Authorized Person To Access :( . For More Information Meet ERP Incharge</div>
                }
            }

        </div>

    </div>
</div>

<a href="javascript:;" id="LoadList" class="hidden" onclick="loadContent('/IQAC/IQACAssociationActivitiesList')"></a>

<div class="modal" id="IQACAssociation-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit IQAC Association</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="AssocicationModalBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Type Of Activity</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sActivityType, (Model.sActivityType != null) ? Model.sActivityType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sActivityType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Shift</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sShiftList, (Model.sShiftList != null) ? Model.sShiftList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sShiftList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group hidden" id="dvOthers">
                                        <label class="col-md-4 control-label">If Other Specify</label>
                                        <div class="col-md-8">
                                            <input type="text" name="Others" class="form-control input-sm" placeholder="If Others Specify" id="txtOthers" />
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">From Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                <input type="text" name="txtGuidenceDate" class="form-control input-sm" placeholder="Select  Date" id="txtFromDate" data-parsley-required="true" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">To Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                <input type="text" name="txtGuidenceDate" class="form-control input-sm" placeholder="Select  Date" id="txtToDate" data-parsley-required="true" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Resource Person</label>
                                        <div class="col-md-8">
                                            <div class="row pull-right">
                                                <a href="javascript:;" class="btn btn-success pull-right" onclick="ResourcePerson()"><i class="fa fa-plus"></i> Add</a>
                                            </div> <br /><br /><br />
                                            <div id="dvIQAC1" class="row">
                                                <div class="form-group panel-group" id="accordion">
                                                    <div class="panel panel-info overflow-hidden">
                                                        <div class="panel-heading">
                                                            <h3 class="panel-title">
                                                                <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" id="dvResourcePerson1" href="#Resource_Person1">
                                                                    <i class="fa fa-plus-circle pull-right"></i>
                                                                    <span id="dvcount1">1</span> . Resource Person
                                                                </a>
                                                            </h3>
                                                        </div>
                                                        <div id="Resource_Person1" class="panel-collapse collapse">
                                                            <div class="panel-body">
                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Name</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtName" value="" class="form-control" placeholder="Resource Person Name" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Designation</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtDesignation" value="" class="form-control" placeholder="Resource Person Designation" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Institution</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtInstitution" value="" class="form-control" placeholder="Resource Person Institution" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Place</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtPlace" value="" class="form-control" placeholder="Resource Person Place" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-12 form-group">
                                                                    <label class="col-md-3 control-label">Topic</label>
                                                                    <div class="col-md-9">
                                                                        <input type="text" id="txtTopic" class="form-control" value="" placeholder="Resource Person Topic" />
                                                                    </div>
                                                                </div>
                                                                <input type="text" id="txtResourcePersonId" value="" class="hidden" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="dvIQACBind">

                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Details</label>
                                        <div class="col-md-8">
                                            <textarea class="form-control" id="txtDetails" rows="5"></textarea>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                        <div class="col-md-9">
                                            <div class="btn btn-primary" onclick="FileClick('sFileUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                            <input type="file" id="sFileUpload" class="hidden" multiple="multiple" onchange="LoadFile('sFileUploadData', 'sFileUpload')" />
                                        </div>
                                    </div>

                                    <div class="form-group hidden" id="sFileUploadData">
                                        <div class="form-group col-md-12 table-responsive">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-10">
                                                <table class="table table-bordered table-hover" id="tbl_Upload">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>File</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbsFileUpload"></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <br />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="iqacAssociationId" value="" />
    </div>
</div>


<div class="modal" id="IQACResourcePerson-dialog">
