
@model CMS.ViewModel.ViewModel.IQACViewModel
@using CMS.Utility
@{
    ViewBag.Title = "ResearchGuidanceList";
    Layout = null;
}


<div class="form-group col-md-12">
    <a class="btn btn-success pull-right form-group m-b-5" href="#IQACResearchGuidence-dialog" onclick="" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
</div>

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblIQACProject">
        <thead>
            <tr>
                <th>#</th>

                @*<th>Staff Name</th>*@
                <th>Category</th>
                <th>Student Name</th>
                <th>Register No</th>
                <th>Project Title</th>
                <th>Registration Year</th>
                <th>Completion year</th>
                @*<th>Entry Date</th>*@
                @*<th>Files</th>*@
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.liIQACResearchGuidence != null && Model.liIQACResearchGuidence.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liIQACResearchGuidence)
                {
                    count = count + 1;
                    <tr>
                        <td>@count</td>

                        @*<td>@item.FIRST_NAME</td>*@
                        <td>@item.CATEGORY</td>
                        <td>@item.STUDENT_NAME</td>
                        <td>@item.REGISTER_NUMBER</td>
                        <td>@item.PROJECT_TITLE</td>
                        <td>@item.REGISTRATION_YEAR</td>
                        <td>@item.COMPLITION_YEAR</td>
                        @*@if (!string.IsNullOrEmpty(item.FILE_PATH))
                        {
                            <td><a href="@Url.Content(item.FILE_PATH)" download><i class="fa fa-download text-primary"></i></a></td>
                        }
                        else
                        {
                            <td>N/A</td>
                        }*@
                        @*<td>@item.ENTRY_DATE</td>*@
                        <td>
                            <a href="#IQACResearchGuidence-dialog" onclick="FetchLiIQACProjectById(@item.IQAC_RESEARCH_GUDIENCE_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                            <a href="javascrip:;" onclick="GetConfirm(@item.IQAC_RESEARCH_GUDIENCE_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                }

            }

        </tbody>
    </table>
</div>

<div class="modal" id="IQACResearchGuidence-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit IQAC Research Guidance</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="IQACResearchGuidence">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">


                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Category Type</label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sIQACCategory, (Model.sIQACCategory != null) ? Model.sIQACCategory : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sIQACCategory, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Student  Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtStudentName" class="form-control" placeholder="Student Name" data-parsley-required="true" data-parsley-maxlength="80">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Register No</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtRegisterNo" class="form-control" placeholder="Register No" data-parsley-required="true" data-parsley-maxlength="10">
                                        </div>
                                    </div>


                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Project Title</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtProjectTitle" class="form-control" placeholder="Project Title" data-parsley-required="true" data-parsley-maxlength="300">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Registration  Year </label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtRegistrationYear" class="form-control" placeholder="Registration Year" data-parsley-type="number" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Completion  Year </label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtComplitionYear" class="form-control" placeholder="Complition Year" data-parsley-type="number" data-parsley-required="true">
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                        <div class="col-md-9">
                                            <div class="btn btn-primary" onclick="FileClick('ResearchGuidenceUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                            <input type="file" id="ResearchGuidenceUpload" class="hidden" multiple="multiple" onchange="LoadFile('ResearchGuidenceUploadData', 'ResearchGuidenceUpload')" />
                                        </div>
                                    </div>

                                    <div class="form-group" id="ResearchGuidenceUploadData">
                                        <div class="form-group col-md-12 table-responsive">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-10">
                                                <table class="table table-bordered table-hover" id="tbl_ResearchGuidenceUpload">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>File</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbResearchGuidenceUpload"></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="iqacProjectId" value="" />
    </div>
</div>


<script>
    function ContentLoad() {
        // Document Ready Function .
    }

    function FetchLiIQACProjectById(sProjectId) {
        //$('#IQACResearchGuidence').parsley().destroy();

        if (sProjectId != null) {
            $.ajax({
                url: "/IQAC/FetchResearchGudienceById",
                type: "post",
                data: { sIQACID: sProjectId },
                success: function (data) {
                    if (data.Message != null) {
                        alert(data.Message);
                    }
                    else {
                        if (data.oResult[0] != null) {

                            $('#txtStudentName').attr('value', data.oResult[0].STUDENT_NAME);
                            $('#txtRegisterNo').attr('value', data.oResult[0].REGISTER_NUMBER);
                            $('#txtProjectTitle').attr('value', data.oResult[0].PROJECT_TITLE);
                            $('#txtRegistrationYear').attr('value', data.oResult[0].REGISTRATION_YEAR);
                            $('#txtComplitionYear').attr('value', data.oResult[0].COMPLITION_YEAR);
                            $('#sIQACCategory option[value="' + data.oResult[0].CATEGORY_ID + '"]').attr("selected", "selected");
                            $('#iqacProjectId').attr('value', data.oResult[0].IQAC_RESEARCH_GUDIENCE_ID);
                            BindFileInfo(data.oResult[0].FILE_PATH, 'tbResearchGuidenceUpload', 'ResearchGuidenceUploadData');
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }

    function SaveData() 
    {
        var isValid = true;
        if ($('#IQACResearchGuidence').parsley().validate() !== true) isValid = false;
        if (!isValid) 
        {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        //for image update
        var ResearchGudienceImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#ResearchGuidenceUploadData').find("table tbody tr").each(function ()
        {
            if ($(this).attr("cms-img-path"))
            {
                ResearchGudienceImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else
            {
                if ($(this).attr("id"))
                {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0)
        {
            ResearchGudienceImagePath = ResearchGudienceImagePath.slice(0, -1);
            ResearchGudienceImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto'))
            {
                formData.delete("sPhoto");
            }

            formData.append("sPhoto", ResearchGudienceImagePath);
        }
        if (iCount > 0)
        {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }
       // alert($('#sIQACCategory').val());
        var sprojectId = $('#iqacProjectId').val();
        var CategoryId = $('#sIQACCategory').val();
        var StudentName = $('#txtStudentName').val();
        var RegisterNo = $('#txtRegisterNo').val();
        var ProjectTitle = $('#txtProjectTitle').val();
        var RegisrationYear = $('#txtRegistrationYear').val();
        var ComplitionYear = $('#txtComplitionYear').val();

        //alert(ProjectTitle);
        if (formData.has('sJsonData'))
        {
            formData.delete("sJsonData");
        }
        var jsonData = '{"IQAC_RESEARCH_GUDIENCE_ID":"' + sprojectId + '","CATEGORY_ID":"' + CategoryId + '","STUDENT_NAME":"' + StudentName + '","REGISTER_NUMBER":"' + RegisterNo + '","PROJECT_TITLE":"' + ProjectTitle + '","REGISTRATION_YEAR":"' + RegisrationYear + '","COMPLITION_YEAR":"' + ComplitionYear + '","FILE_PATH":"'+FilePath+'"}';

        formData.append("sJsonData",jsonData);
        var req = $.ajax({
            url: "/IQAC/SaveResearchGudience",
            type: "post",
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.Message != null && data.Message != "") {
                    if (data.ErrorCode == "200")
                    {
                        $('#btnCancel').click();
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        $('#liResearchGudience').click();
                    }
                    if (data.ErrorCode == "417") {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    if (data.ErrorCode == "503") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }
                    if (data.ErrorCode == "406") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }

                }
            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }

        });

    }





    GetConfirm = function (sProjectId) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "/IQAC/DeleteResearchGudience",
                type: "post",
                data: { sIQACID: sProjectId },
                success: function (data)
                {
                    if (data.Message != null && data.Message != "")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        $('#liResearchGudience').click();
                    }
                },
                error: function (ex)
                {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }

            });
        });

    }

    function Add()
    {
        $('#pBody').parsley().destroy();
        $('#txtStudentName').attr('value', '');
        $('#txtRegisterNo').attr('value', '');
        $('#txtProjectTitle').attr('value', '');
        $('#txtRegistrationYear').attr('value', '');
        $('#txtComplitionYear').attr('value', '');
        $('#sIQACCategory option[value=""]').attr("selected", "selected");
        $('#iqacProjectId').attr('value', '');
        $('.selectpicker').selectpicker('refresh');
    }

    $(function () 
    {
        $('#IQACResearchGuidence-dialog').on('hidden.bs.modal', function (e)
        {
            var entries = formData.entries();
            for(var pair of entries)
            {
                formData.delete(pair[0]);
            }
            $('#iqacProjectId').val('');
            $('#sIQACCategory').val('');
            $('#txtStudentName').val('');
            $('#txtRegisterNo').val('');
            $('#txtProjectTitle').val('');
            $('#txtRegistrationYear').val('');
            $('#txtComplitionYear').val('');
            nFileCount = 0; nCount = 0;
            $('.selectpicker').selectpicker('refresh');
            $('#tbResearchGuidenceUpload').empty();
        });
    });
</script>







