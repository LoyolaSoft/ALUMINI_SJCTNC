@model CMS.ViewModel.ViewModel.IQACViewModel


@{
    Layout = null;
    int nCount = 0;
    string sSelected = string.Empty;
}

<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="form-horizontal">
    <div class="form-group col-md-12">
        <a class="btn btn-primary text-white pull-right" onclick="AddNewColumn()" href="javascript:;"><i class="fa fa-plus"></i> Click To Add New Row </a>
    </div>
    
    <div class="form-group col-md-12 table-responsive">
        <table class="table table-bordered " id="tblIQAC">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Dept Code</th>
                    <th>Class Code</th>
                    @*<th>Semester</th>*@
                    <th>Activity_Date</th>
                    <th>Activity_Title</th>
                    <th>If_Other_Specify</th>
                    <th>Activity_Topic</th>
                    <th>No_Of_Students</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

            @if (Model.liPersonalAcademicActivity != null && Model.liPersonalAcademicActivity.Count > 0)
            {
                foreach (var item in Model.liPersonalAcademicActivity)
                {
                        <tr cms-IQACID="@item.IQAC_ID">
                            <td>@{nCount++;} @nCount</td>
                            <td><input type="text" class="form-control" data-parsley-maxlength="5" value="@item.DEPT_CODE" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" data-parsley-maxlength="8" value="@item.CLASS_CODE" data-parsley-required="true"/> </td>
                            @*<td><input type="text" class="form-control" maxlength="1" value="@item.SEMESTER_ID" /> </td>*@
                            <td>
                                <div class="input-group date" id="datetimepicker">
                                    <input type="text" class="form-control" value="@item.ACTIVITY_DATE" data-parsley-required="true"/>
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </td>
                            <td>
                                <select class="form-control" id="Activity" data-parsley-required="true" > 
                                    <option value=""> -- Select --</option> 
                                    <option value="Unit Test / Slip Test" @if (@item.ACTIVITY == "Unit Test / Slip Test") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Unit Test / Slip Test</option>
                                    <option value="Seminor"  @if (@item.ACTIVITY == "Seminor") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Seminor</option>
                                    <option value="Group Discussion" @if (@item.ACTIVITY == "Group Discussion") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Group Discussion</option>
                                    <option value="Quiz" @if (@item.ACTIVITY == "Quiz") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Quiz</option>
                                    <option value="Remedial Class" @if (@item.ACTIVITY == "Remedial Class") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Remedial Class</option>
                                    <option value="Special Class" @if (@item.ACTIVITY == "Special Class") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Special Class</option>
                                    <option value="Any Other" @if (@item.ACTIVITY == "Any Other") { sSelected = "Selected"; } else { sSelected = string.Empty; } @sSelected>Any Other</option>
                                 </select>
                        </td>
                            <td><input type="text" class="form-control" data-parsley-maxlength="60" value="@item.IF_OTHERS_SPECIFY" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" data-parsley-maxlength="100" value="@item.TOPIC" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" data-parsley-maxlength="3" value="@item.NO_OF_PARTICIPANTS" data-parsley-required="true" data-parsley-type="number"/> </td>
                            <td><a onclick="GetConfrim(@item.IQAC_ID)" href="javascript:;"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a></td>
                        </tr>
                   }
               }
               else
               {
                   <tr cms-IQACID="">
                       <td>@{nCount++;} @nCount</td>
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="5" data-parsley-required="true" placeholder="Department Code"/> </td>
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="8" data-parsley-required="true" placeholder="Class Code"/> </td>
                       <td>
                           <div class="input-group date" id="datetimepicker">
                               <input type="text" class="form-control" value="" data-parsley-required="true" placeholder="Select Date"/>
                               <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                           </div>
                       </td>
                       @*<td><input type="text" class="form-control" value="" maxlength="1" /> </td>*@
                       <td><select class="form-control" id="Activity" data-parsley-required="true">
                                <option value=""> -- Select --</option>
                                <option value="Unit Test / Slip Test">Unit Test / Slip Test</option>
                                <option value="Seminor">Seminor</option>
                                <option value="Group Discussion">Group Discussion</option>
                                <option value="Quiz">Quiz</option>
                                <option value="Remedial Class">Remedial Class</option>
                                <option value="Special Class">Special Class</option>
                                <option value="Any Other">Any Other</option>
                            </select> 
                        </td>
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="60" data-parsley-required="true" placeholder="If Other Specify"/> </td>
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="100" data-parsley-required="true" placeholder="Topic"/> </td>
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="3" data-parsley-required="true" data-parsley-type="number" placeholder="No Of Students"/> </td>
                       <td></td>
                   </tr>
               }
            </tbody>
        </table>
    </div>
</div>

<input type="hidden" name="name" value="@nCount" id="hdNumber" />

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script>
    handleDatepicker = function () {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
            // 'top': top,
            // 'left': left
        })
    }
    handleDatepicker();
    function AddNewColumn()
    {
        var nCount = 0;
        nCount = $('#hdNumber').val();
        nCount++;
        $('#hdNumber').val(nCount);
        var sDom = '<tr cms-IQACID="">\
                      <td>' + nCount + '</td>\
                      <td><input type="text" class="form-control" value="" data-parsley-maxlength="5" placeholder="Department Code" data-parsley-required="true"/> </td>\
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="8" placeholder="Class Code" data-parsley-required="true"/> </td>\
                       <td>\
                           <div class="input-group date" id="datetimepicker">\
                               <input type="text" class="form-control" value="" placeholder="Select Date" data-parsley-required="true"/>\
                               <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>\
                           </div>\
                       </td>\
                       <td><select class="form-control" id="Activity" data-parsley-required="true">\
                                <option value=""> -- Select --</option>\
                                <option value="Unit Test / Slip Test">Unit Test / Slip Test</option>\
                                <option value="Seminor">Seminor</option>\
                                <option value="Group Discussion">Group Discussion</option>\
                                <option value="Quiz">Quiz</option>\
                                <option value="Remedial Class">Remedial Class</option>\
                                <option value="Special Class">Special Class</option>\
                                <option value="Any Other">Any Other</option>\
                            </select> </td>\
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="60" placeholder="If Other Specify" data-parsley-required="true"/> </td>\
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="100" placeholder="Topic" data-parsley-required="true"/> </td>\
                       <td><input type="text" class="form-control" value="" data-parsley-maxlength="3" placeholder="No Of Students" data-parsley-required="true" data-parsley-type="number"/> </td><td></td>\
                    </tr>';
        $('tbody').append(sDom);
        handleDatepicker();
    }
</script>