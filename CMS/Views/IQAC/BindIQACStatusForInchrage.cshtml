@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
}


<br /><br />
<div class="col-md-12">
    <div class="col-xs-4">
        <label>Department : </label>
        <label id="lblDepartment"></label>
    </div>
    <div class="col-xs-4">
        <label>Question : </label>
        <label id="lblQuestion" class="text-center"></label>
    </div>
    <div class="col-xs-4">
        <label>Month : </label>
        <label id="lblMonth" class="text-right"></label>
    </div>
</div>
<div class="table-responsive col-md-12 form-group">
    <table class="table table-bordered table-hover" border="1" id="tblReport">
        <thead>
            <tr>
                <th>#</th>
                <th>Class</th>
                <th>Course</th>
                <th>Staff Code</th>
                <th>Name</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liReport != null && Model.liReport.Count > 0)
            {
                int nCount = 0;
                foreach (var item in Model.liReport)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.COURSE_TITLE</td>
                        <td>@item.STAFF_CODE</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.STATUS</td>
                    </tr>
                                }
                            }
        </tbody>
    </table>
</div>

