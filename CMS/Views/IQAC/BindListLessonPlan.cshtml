@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
    string sStatus = string.Empty;
}


@if (Model.liLessonPlan!=null && Model.liLessonPlan.Count>0)
{
    
     <h3 class="text-center" style="margin-left:150px; margin-top:50px">INTERNAL QUALITY ASSURANCE CELL</h3>
     <h4 class="text-center" style="margin-left:100px">@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME , @Model.liCollegeDetails.FirstOrDefault().PLACE </h4>
     <h5 class="text-center" style="margin-left:200px"><u>Lesson Plan</u></h5>
     <h5 class="text-center" style="margin-left:50px">Name Of The Stafff : @Model.liLessonPlan.FirstOrDefault().FIRST_NAME (@Model.liLessonPlan.FirstOrDefault().STAFF_CODE)  &nbsp; Department : @Model.liLessonPlan.FirstOrDefault().DEPARTMENT</h5>
     <h5 class="text-center" style="margin-left:50px">Academic Year : @Model.liLessonPlan.FirstOrDefault().ACADEMIC_YEAR  &nbsp; &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp; <span style="margin-left:80px"> Semester : @Model.liLessonPlan.FirstOrDefault().SEMESTER_ID </span></h5>
     <h5 class="text-center" style="margin-left:50px">Course : @Model.liLessonPlan.FirstOrDefault().COURSE_CODE  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp; <span style="margin-left:80px"> Subject : @Model.liLessonPlan.FirstOrDefault().COURSE_TITLE </span></h5>
}


<div class="form-group col-md-12 table-responsive" style="margin-left:10px">
    <table class="table table-bordered" border="1">
        <thead>
            <tr>
                <th>Cycle</th>
                <th>Unit</th>
                <th>Topic</th>
                <th>Teaching Methods</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liLessonPlan!=null && Model.liLessonPlan.Count>0)
            {
                foreach (var item in Model.liLessonPlan)
                {
                    <tr>
                        <td>@item.CYCLE</td>
                        <td>@item.UNIT</td>
                        <td>@item.TOPIC</td>
                        <td>@item.TEACHING_METHOD</td>
                        <td>
                            @if (item.STATUS=="1")
                            {
                                sStatus = "Completed";
                            }
                            else if (item.STATUS == "2")
                            {
                                sStatus = "Partially Completed";
                            }
                            else if (item.STATUS == "3")
                            {
                                sStatus = "Yet to be completed";
                            }
                          @sStatus
                        </td>
                        <td>
                            <a class="text-danger" href="javascript:;" onclick="GetConfrim(@item.IQAC_ID)"><i class="fa fa-trash"></i></a>
                        </td> 
                    </tr>
                }
            }
        </tbody>
    </table>
</div>