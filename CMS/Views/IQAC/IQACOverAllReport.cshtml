@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">Month Wise Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Month Wise Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Month Wise Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    
                        <div class="form-group col-md-12">
                            <div class="col-md-4">
                                @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.sAcademicYearList, (Model.sAcademicYearList != null) ? Model.sAcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sAcademicYearList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                @Html.Label("Department", htmlAttributes: new { @class = "col-md-4 control-label" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.sDepartmentList, (Model.sDepartmentList != null) ? Model.sDepartmentList : Enumerable.Empty<SelectListItem>(), null, new { @class = "from-control selectpicker", @multiple = "multiple", @data_actions_box = "true", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sDepartmentList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                @Html.Label("Staff", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.sStaffList, (Model.sStaffList != null) ? Model.sStaffList : Enumerable.Empty<SelectListItem>(), null, new { @class = "from-control selectpicker", @multiple = "multiple", @data_actions_box = "true", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sStaffList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            <div class="col-md-4">
                                @Html.Label("Questions", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(m => m.sIQACQuestionsList, (Model.sIQACQuestionsList != null) ? Model.sIQACQuestionsList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sIQACQuestionsList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                @Html.Label("Month", htmlAttributes: new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @*@Html.DropDownListFor(m => m.sMonthList, (Model.sMonthList != null) ? Model.sMonthList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(m => m.sMonthList, "", new { @class = "text-danger" })*@

                                    <select class="form-control  selectpicker" data-live-search="true" id="sMonthList" data-actions-box="true">
                                        @if (Model.liMonthList != null && Model.liMonthList.Count > 0)
                                        {
                                            int nCount = 0;
                                            <option value="0">-- Select --</option>
                                            <option value="15">2016</option>
                                            <option value="14">2017</option>
                                            <option value="13"> 2018 </option>
                                            foreach (var item in Model.liMonthList)
                                            {
                                                nCount++;
                                                <option value="@nCount">@item.DAY_ORDER_MONTH</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <a href="javascript:;" onclick="BindList()" class="btn btn-primary" title="Click To Get List"> Get</a>
                            </div>

                            @*<div class="col-md-2">
                                <a href="javascript:;" onclick="BlockIQACEntry()" class="btn btn-success" title="Click To Bock Entry"> Block This Entry</a>
                            </div>*@
                        </div>
                    
                </div>


                <div id="dvIQACBind" class="form-group col-md-12">

                </div>

            }

        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
        function ContentLoad()
        {
            // Document Ready Function .
           // $('#btnPrint').removeClass("hidden");
            //$('#btnExport').removeClass("hidden");
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>

    $('#sAcademicYearList').on('change', function ()
    {
        if ($('#sAcademicYearList').val() && $('#sIQACQuestionsList').val() && $('#sMonthList').val() && string($('#sDepartmentList').val()) && string($('#sStaffList').val()))
        {
            BindList();
        }
    });

    $('#sIQACQuestionsList').on('change', function ()
    {
        if ($('#sAcademicYearList').val() && $('#sIQACQuestionsList').val() && $('#sMonthList').val() && string($('#sDepartmentList').val()) && string($('#sStaffList').val()))
        {
            BindList();
        }
    });

    //$('#sMonthList').on('change', function ()
    //{
    //    if ($('#sAcademicYearList').val() && $('#sIQACQuestionsList').val() && $('#sMonthList').val())
    //    {
    //        BindList();
    //    }
    //});

    $('#sDepartmentList').on('change', function () {
        //alert("ok");
        if (String($('#sDepartmentList').val())) {
            //alert("test ok");
            $.ajax({
                url: '@Url.Action("FetchStaffByDepartmentByIdforReport", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sDepartmentId: String($('#sDepartmentList').val()) },
                success: function (data) {
                    $('#sStaffList').empty();
                    if (data.ErrorCode == '200')
                    {
                        $('#sStaffList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });

    function BindList()
    {
        //alert($('#sStaffList').val());
        $.ajax({
            url:'@Url.Action("BindIQACOverAllReport", "IQAC")',
            method:'POST',
            datatype:'json',
            data: { sAcademicYearList: $('#sAcademicYearList option:selected').text(), sIQACQuestionsList: $('#sIQACQuestionsList').val(), sMonthList: $('#sMonthList').val(), sDepartment: String($('#sDepartmentList').val()), sStaff: String($('#sStaffList').val()) },
            success: function (data)
            {
                //alert('Hi Sir');
                $('#dvIQACBind').empty();
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });

                } else
                {
                    var columncount = 0;
                    $('#dvIQACBind').append(data);
                    $('#tblReport').DataTable({'bPaginate': false,
                        initComplete: function () {
                            this.api().columns().every(function ()
                            {
                                if (columncount != 0)
                                {
                                    var column = this;
                                    var select = $('<select class="form-control selectpicker" data-live-search="true" ><option value="0">-- Select --</option></select>')
                                        .appendTo($(column.footer()).empty())
                                        .on('change', function () {
                                            var val = $.fn.dataTable.util.escapeRegex(
                                                $(this).val()
                                            );

                                            column
                                                .search(val ? '^' + val + '$' : '', true, false)
                                                .draw();
                                        });

                                    column.data().unique().sort().each(function (d, j) {
                                        select.append('<option value="' + d + '">' + d + '</option>')
                                    });
                                }
                                columncount++;
                            });
                        },
                        "ordering": false,
                        dom: "<'row'<'col-sm-3'l><'col-sm-9 text-right'<'m-l-10 pull-right'B>f>>rt<'pull-left'i>p", lengthMenu: [10, 25, 50, 75, 100], colReorder: !0, fixedHeader: {
                            header: !0, headerOffset: $("#header").height()
                        }
                    });
                    $('.dataTables_filter').addClass('pull-right');
                    $('#lblQuestion').text($('#sIQACQuestionsList Option:selected').text());
                    $('#lblMonth').text($('#sMonthList Option:selected').text());
                    $('#lblYear').text($('#sAcademicYearList Option:selected').text());
                    $('.selectpicker').selectpicker('refresh');
                    //$('.dataTables_info').addClass('hidden');
                        //$('#btnPrint').removeClass('hidden');
                        //$('#btnExport').removeClass('hidden');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }



    function printDiv()
    {
        $('tfoot').empty();
        $('#btnPrint').addClass("hidden");
        $('#btnExport').addClass("hidden");
        //$('#tfooter').addClass("hidden");
        $('.dataTables_filter').addClass("hidden");
        var printContents = document.getElementById('dvIQACBind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/IQAC/IQACOverAllReport');
    }


    function Export()
    {
        $('tfoot').empty();
        $('#btnPrint').addClass("hidden");
        $('#btnExport').addClass("hidden");
        //$('#tfooter').addClass("hidden");
        $('.dataTables_filter').addClass("hidden");
        var title="";
        var sAcademicYear = $('#sAcademicYearList option:selected').text();
        var Question = $('#sIQACQuestionsList option:selected').text();
        var Month = $('#sMonthList option:selected').text();
        title = sAcademicYear + "_" + Question + "_" + Month;
        let file = new Blob([$('#dvIQACBind').html()], { type: "application/vnd.ms-excel" });
            let url = URL.createObjectURL(file);
            let a = $("<a />", {
                href: url,
                download: title + ".xls"
            }).appendTo("body").get(0).click();
            //e.preventDefault();
            loadContent('/IQAC/IQACOverAllReport');
    }




    function BlockIQACEntry()
    {
        if ($('#sAcademicYearList').val() && $('#sIQACQuestionsList').val() && $('#sMonthList').val())
        {
            $.ajax({
                url: '@Url.Action("BlockMonthListForIQAC", "IQAC")',
                method: 'POST',
                datatype: 'json',
                data: { sAcademicYearList: $('#sAcademicYearList Option:selected').text(), sIQACQuestionsList: $('#sIQACQuestionsList').val(), sMonthList: $('#sMonthList Option:selected').text() },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        BindList();
                    } else
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        } else
        {
            swal({ title: "Warning !", text: "Please Select All To Continue !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
        }
    }
</script>
