@model CMS.ViewModel.ViewModel.IQACViewModel


@{
    Layout = null;
    int nCount = 0;
    
}
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->


<div class="form-horizontal">
    <div class="form-group col-md-12">
        <a class="btn btn-primary text-white pull-right" onclick="AddNewColumn()" href="javascript:;"><i class="fa fa-plus"></i> Click To Add New Row </a>
    </div>

    <div class="form-group col-md-12" data-parsley-validate="true" id="IQAC">
        <table class="table table-bordered" id="tblIQAC">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Dept Code</th>
                    <th>Date</th>
                    <th>Co - Authours</th>
                    <th>Title Of the Paper</th>
                    <th>Seminar</th>
                    <th>Place</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

            @if (Model.liResearchAcademicContributionA != null && Model.liResearchAcademicContributionA.Count > 0)
            {
                foreach (var item in Model.liResearchAcademicContributionA)
                {
                        <tr cms-IQACID="@item.IQAC_ID">
                            <td>@{nCount++;} @nCount</td>
                            <td><input type="text" class="form-control" value="@item.DEPT_CODE" maxlength="10" placeholder="Department Code" data-parsley-required="true"/> </td>
                            <td>
                                <div class="input-group date" id="datetimepicker">
                                    <input type="text" class="form-control " value="@item.RESEARCH_DATE" placeholder="Select Date" data-parsley-required="true"/>
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </td>
                            <td><input type="text" class="form-control" maxlength="60" value="@item.CO_AUTHORS" placeholder="Co Authors" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="300" value="@item.PAPER_TITLE" placeholder="Paper Title" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="50" value="@item.SEMINAR" placeholder="Seminar" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="50" value="@item.PLACE" placeholder="Place" data-parsley-required="true"/> </td>
                            <td><a onclick="GetConfrim(@item.IQAC_ID)" href="javascript:;"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a></td>
                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr cms-IQACID="">
                                        <td>@{nCount++;} @nCount</td>
                                        <td><input type="text" class="form-control" value="" maxlength="10" placeholder="Department Code" data-parsley-required="true"/> </td>
                                        <td>
                                            <div class="input-group date" id="datetimepicker">
                                                <input type="text" class="form-control" value="" placeholder="Select Date" data-parsley-required="true"/>
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control" maxlength="60" value="" placeholder="Co Authors" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="300" value="" placeholder="Paper Title" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="50" value="" placeholder="Seminar" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="50" value="" placeholder="Place" data-parsley-required="true"/> </td>
                                        <td></td>
                                    </tr>
                                            }
            </tbody>
        </table>
    </div>
</div>


<input type="hidden" name="name" value="@nCount" id="hdNumber" />
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>


<script>
    handleDatepicker = function ()
    {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
            // 'top': top,
            // 'left': left
        })
    }
    handleDatepicker();
    function AddNewColumn()
    {
        var nCount = 0;
        nCount=$('#hdNumber').val();
        nCount++;
        $('#hdNumber').val(nCount);
        var sDom = '<tr cms-IQACID="">\
                      <td>' + nCount + '</td>\
                      <td><input type="text" class="form-control" value="" maxlength="10" placeholder="Department Code" data-parsley-required="true"/></td>\
                      <td><div class="input-group date" id="datetimepicker">\
                            <input type="text" class="form-control" value="" placeholder="Select Date" data-parsley-required="true"/>\
                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>\
                        </div></td>\
                      <td><input type="text" class="form-control" maxlength="60" value="" placeholder="Co Authors" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="300" value="" placeholder="Paper Title" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="50" value="" placeholder="Seminar" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="50" value="" placeholder="Place" data-parsley-required="true"/></td>\
                      <td></td>\
                    </tr>';
        $('tbody').append(sDom);
        handleDatepicker();
    }

</script>