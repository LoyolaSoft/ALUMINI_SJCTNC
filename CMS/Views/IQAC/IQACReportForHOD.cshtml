                    <div class="col-md-12 form-group">
                        @*<div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">From</label>
                            <div class="col-md-9">
                                <div class="input-group" id="dpDateFrom">
                                    <input type="text" name="txtDateFrom" class="form-control input-sm date" placeholder="Select  Date" id="txtDateFrom" data-parsley-required="true" />
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 form-group">
