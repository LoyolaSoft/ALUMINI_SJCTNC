                                @Html.ValidationMessageFor(m => m.sAcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        @*<div class="col-md-3 form-group">
                            <label class="col-md-3 control-label">Dept</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.sDepartmentList, (Model.sDepartmentList != null) ? Model.sDepartmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sDepartmentList, "", new { @class = "text-danger" })
                            </div>
                        </div>*@

                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Staff</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.sStaffList, (Model.sStaffList != null) ? Model.sStaffList : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(m => m.sStaffList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Question</label>
                            <div class="col-md-9">
                                @*@Html.DropDownListFor(m => m.sStaffList, (Model.sStaffList != null) ? Model.sStaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                    @Html.ValidationMessageFor(m => m.sStaffList, "", new { @class = "text-danger" })*@
                                <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" data-live-search="true" id="ddlQuestions">
                                    <option value="0">-- Select --</option>
                                    <option value="3"> Co Curricular Aspects</option>
                                    <option value="4"> Extension Works</option>
                                    <option value="7"> Awards</option>
                                    <option value="8"> Subject Association</option>
                                    <option value="9"> Honour</option>
                                    <option value="10">Membership</option>
                                    <option value="11">Project</option>
                                    <option value="12"> Research Guidence</option>
                                    <option value="13"> PHD Guidence</option>
                                    <option value="14"> Participation & Prasentation</option>
                                    <option value="15"> Paper Publication</option>
                                    <option value="16"> Book Publication</option>
                                    <option value="17"> Dept Daily Activity</option>
                                    <option value="18"> Assocication Activity</option>
