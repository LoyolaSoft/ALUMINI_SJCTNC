                            <div class="col-md-9">
                                <div class="input-group" id="dpDateTo">
                                    <input type="text" name="txtDateTo" class="form-control input-sm date" placeholder="Select  Date" id="txtDateTo" data-parsley-required="true" />
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>*@

                        <div class="col-md-1 form-group">
                            <a href="javascript:;" class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                        <div class="col-md-1 form-group">
                            <a href="javascript:;" class="btn btn-success hidden" id="btnPrint" onclick="printDiv()">Print</a>
