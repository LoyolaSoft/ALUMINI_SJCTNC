@Html.HiddenFor(model=>model.sMessage)

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>


<script>
    handleDatepicker = function ()
    {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            endDate: new Date,
            format: "dd/mm/yyyy",
            orientation: "left"
            // 'top': top,
            // 'left': left
        });
    }
    handleDatepicker();

        function ContentLoad()
        {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');

</script>



<script>
    $('#sDepartmentList').on('change', function ()
    {
        if ($('#sDepartmentList').val())
        {
            $.ajax({
                url: '@Url.Action("FetchStaffByDepartmentById", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sDepartmentId: $('#sDepartmentList').val() },
                success: function (data)
                {
                    $('#sStaffList').empty();
                    if (data.ErrorCode == '200')
                    {
                        $('#sStaffList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });

    $('#btnGet').on('click', function ()
    {
        var sStaffId = String($('#sStaffList').val());
        //var Json = '{"STAFF_ID":"' + sStaffId + '","ACADEMIC_YEAR":"' + $('#sAcademicYearList Option:selected').text() + '","DATE_FROM":"' + $('#txtDateFrom').val() + '","DATE_TO":"' + $('#txtDateTo').val() + '","QUESTION_ID":"' + $('#ddlQuestions').val() + '"}';
        var Json = '{"STAFF_ID":"' + sStaffId + '","ACADEMIC_YEAR":"' + $('#sAcademicYearList Option:selected').text() + '","QUESTION_ID":"' + $('#ddlQuestions').val() + '"}';

        $.ajax({
            url: '@Url.Action("BindIQACReportForHOD", "IQAC")',

          // url: '@Url.Action("BindIQACDateWiseReportForIncharge", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sJsonData: Json },
            success: function (data)
            {
                $('#dvIQACBind').empty();
                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#dvIQACBind').append(data);
                    $('.lblDepartment').text($('#sMessage').val());
                    $('.lblYear').text($('#sAcademicYearList Option:selected').text());
                    $('#lblQuestion').text($('#ddlQuestions Option:selected').text());
                    $('#btnPrint').removeClass('hidden');
                    $('#btnExport').removeClass('hidden');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });


    function printDiv() {
        
        var printContents = document.getElementById('dvIQACBind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/IQAC/IQACReportForHOD');
    }


    function Export() {
        
        var title = "";
        var sAcademicYear = $('#sAcademicYearList option:selected').text();
        var Question = $('#sIQACQuestionsList option:selected').text();
        var Department = $('#sMessage').val();
        title = sAcademicYear + "_" + Question ;
        let file = new Blob([$('#dvIQACBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        //e.preventDefault();
        loadContent('/IQAC/IQACReportForHOD');
    }
</script>