@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
    string sStatus = string.Empty;
}

@if (Model.liLessonPlan != null && Model.liLessonPlan.Count > 0)
{
    var groubyclscrsstf = Model.liLessonPlan.GroupBy(o => new { o.STAFF_ID, o.COURSE_ID, o.CLASS_ID }).OrderBy(o =>  o.Key.CLASS_ID);

    foreach (var Gitem in groubyclscrsstf)
    {
        <div style="page-break-after:always !important;">
            <h4 class="text-center">INTERNAL QUALITY ASSURANCE CELL</h4>
            <h4 class="text-center">@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME , @Model.liCollegeDetails.FirstOrDefault().PLACE </h4>
            <h5 class="text-center">Lesson Plan</h5>
            <h5 class="text-center">Name Of The Staff :<b>@Gitem.FirstOrDefault().FIRST_NAME </b>  &nbsp; <span style="margin-left:80px"> Department : <b>@Gitem.FirstOrDefault().DEPARTMENT </b> </span></h5>
            <h5 class="text-center">Academic Year : <b> @Gitem.FirstOrDefault().ACADEMIC_YEAR </b> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <span style="margin-left:80px"> Semester :<b> @Gitem.FirstOrDefault().SEMESTER_ID </b> </span></h5>
            <h5 class="text-center">Course :<b> @Gitem.FirstOrDefault().CLASS_NAME </b> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <span style="margin-left:80px"> Subject : <b> @Gitem.FirstOrDefault().COURSE_TITLE (@Gitem.FirstOrDefault().COURSE_CODE)</b>  </span></h5>


            <div class="form-group col-md-12 table-responsive" style="margin-left:10px">
                <table class="table table-bordered" border="1">
                    <thead>
                        <tr>
                            <th class="text-center"><b> Cycle</b> </th>
                            <th class="text-center"><b> Unit</b> </th>
                            <th class="text-center"><b> Topic</b> </th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.liLessonPlan)
                        {
                            if (Gitem.FirstOrDefault().STAFF_ID == item.STAFF_ID && Gitem.FirstOrDefault().CLASS_ID == item.CLASS_ID && Gitem.FirstOrDefault().COURSE_ID == item.COURSE_ID)
                            {
                                <tr>
                                    <td>@item.CYCLE</td>
                                    <td>@item.UNIT</td>
                                    <td>@item.TOPIC</td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-danger">
        No Record(s) Found !!!
    </div>
}


