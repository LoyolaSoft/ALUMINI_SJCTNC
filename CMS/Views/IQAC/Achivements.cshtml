        {
            if ($(this).attr("cms-img-path"))
            {
                HonourImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else
            {
                if ($(this).attr("id"))
                {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0)
        {
            HonourImagePath = HonourImagePath.slice(0, -1);
            HonourImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto'))
            {
                formData.delete("sPhoto");
            }

            formData.append("sPhoto", HonourImagePath);
        }
        if (iCount > 0)
        {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }


        var sJsonData = '{"HONOR_ID":"' + $('#hdHonorId').val() + '","HONOR_TYPE_ID":"' + $('#ddlHonor').val() + '","TITLE_OF_TALK":"' + $('#txtTalkTitle').val() + '","PROGRAMME_TITLE":"' + $('#txtProgrammeTitle').val() + '","INSTITION_NAME":"' + $('#txtInstitionName').val() + '","PLACE":"' + $('#txtHonorPlace').val() + '","FROM_DATE":"' + $('#txtHonorFromDate').val() + '","TO_DATE":"' + $('#txtHonorToDate').val() + '","FILE_PATH":"' + FilePath + '"}';

        //clearing formdata sJsonData
        if (formData.has('sJsonData')) {
            formData.delete("sJsonData");
        }

        formData.append("sJsonData", sJsonData);


        $.ajax({
            url: '@Url.Action("SaveHonors", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data)
            {
                
                if (data.ErrorCode == "200")
                {
                    $('body').removeClass('modal-open');
                    $('.modal-backdrop').remove();
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    BindHonor();
                } else
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }


    function FetchHonorInfo(ID)
    {
        if (ID != null && ID != '')
        {
            $.ajax({
                url: '@Url.Action("FetchHonorById", "IQAC")',
                method:'POST',
                datatype:'json',
                data: { sHonorId: ID },
                success: function (data)
                {
                    $('#tbHUpload').empty();
                    if (data.Message!=null && data.Message!='')
