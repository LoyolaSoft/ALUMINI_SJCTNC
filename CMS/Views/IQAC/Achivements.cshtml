@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;

}



<div class="col-md-12">
    <!-- Begin Awards -->
    <div class="form-group panel-group" id="accordion">
        <div class="panel panel-info overflow-hidden">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" href="#Awards">
                        <i class="fa fa-plus-circle pull-right"></i>
                        1. Awards
                    </a>
                </h3>
            </div>
            <div id="Awards" class="panel-collapse collapse">
                <div class="panel-body">
                    <div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#Awards-dialog" data-toggle="modal"><i class="fa fa-plus"></i>Add</a>
                    </div>
                    <div class="table-responsive col-md-12">
                        <table class="table table-bordered table-hover" id="tblAwards">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Award Title</th>
                                    <th>Year</th>
                                    <th>Awarded By</th>
                                    <th>Level</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.liAwards != null && Model.liAwards.Count > 0)
                                    {
                                        int nCount = 0;
                                        foreach (var item in Model.liAwards)
                                        {
                                            <tr>
                                                <td>@{nCount++;} @nCount</td>
                                                <td>@item.AWARD_TITLE</td>
                                                <td>@item.YEAR</td>
                                                <td>@item.AWARDED_BY</td>
                                                <td>@item.LEVEL_ID</td>
                                                <td>
                                                    <a class="text-info" href="#Awards-dialog" data-toggle="modal" onclick="FetchAwardInfo(@item.AWARD_ID)"><i class="fa fa-edit"></i></a>
                                                    <a class="text-danger" href="javascript:;" onclick="DeleteAward(@item.AWARD_ID)"><i class="fa fa-trash"></i></a>
                                                </td>
                                            </tr>

                                                        }
                                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Awards -->
    <!-- Begin MemberShip In Academic Body -->
    <div class="form-group panel-group" id="accordion">
        <div class="panel panel-info overflow-hidden">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" href="#MemberShip">
                        <i class="fa fa-plus-circle pull-right"></i>
                        2. MemberShip In Academic Body
                    </a>
                </h3>
            </div>
            <div id="MemberShip" class="panel-collapse collapse">
                <div class="panel-body">
                    <div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#Membership-dialog" data-toggle="modal"><i class="fa fa-plus"></i>Add</a>
                    </div>
                    <div class="table-responsive col-md-12">
                        <table class="table table-bordered table-hover" id="tblMembership">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Type Of Membership</th>
                                    <th>Board Of Study </th>
                                    <th>Academic cousil </th>
                                    <th>Period From</th>
                                    <th>Period To</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.liMembership != null && Model.liMembership.Count > 0)
                                    {
                                        int nCount = 0;
                                        foreach (var item in Model.liMembership)
                                        {
                                            <tr>
                                                <td>@{nCount++;} @nCount</td>
                                                <td>@item.MEMBERSHIP_TYPE</td>
                                                <td>@item.BOARD_NAME</td>
                                                <td>@item.COLLEGE_UNIVERSITY</td>
                                                <td>@item.PERIOD</td>
                                                <td>@item.PERIOD_TO</td>
                                                <td>
                                                    <a class="text-info" href="#Membership-dialog" data-toggle="modal" onclick="FetchMembershipInfo(@item.MEMBERSHIP_ID)"><i class="fa fa-edit"></i></a>
                                                    <a class="text-danger" href="javascript:;" onclick="DeleteMembership(@item.MEMBERSHIP_ID)"><i class="fa fa-trash"></i></a>
                                                </td>
                                            </tr>
                                                        }
                                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End MemberShip In Academic Body -->
    <!-- Begin Subject Association -->
    <div class="form-group panel-group" id="accordion">
        <div class="panel panel-info overflow-hidden">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" href="#SubjectAssociation">
                        <i class="fa fa-plus-circle pull-right"></i>
                        3. Subject Association
                    </a>
                </h3>
            </div>
            <div id="SubjectAssociation" class="panel-collapse collapse">
                <div class="panel-body">
                    <div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#SubjectAssociation-dialog" data-toggle="modal"><i class="fa fa-plus"></i>Add</a>
                    </div>
                    <div class="table-responsive col-md-12">
                        <table class="table table-bordered table-hover" id="tblSubjectAssociation">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name of the Association</th>
                                    <th>Posision Held</th>
                                    <th>Period</th>
                                    <th>Period To</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.liSubjectAssociation != null && Model.liSubjectAssociation.Count > 0)
                                    {
                                        int nCount = 0;
                                        foreach (var item in Model.liSubjectAssociation)
                                        {
                                            <tr>
                                                <td>@{nCount++;} @nCount</td>
                                                <td>@item.ASSOCIATION_NAME</td>
                                                <td>@item.POSISION_HELD</td>
                                                <td>@item.PERIOD</td>
                                                <td>@item.PERIOD_TO</td>
                                                <td>
                                                    <a class="text-info" href="#SubjectAssociation-dialog" data-toggle="modal" onclick="FetchSubjectAssociationInfo(@item.SUBJECT_ASSOCIATION_ID)"><i class="fa fa-edit"></i></a>
                                                    <a class="text-danger" href="javascript:;" onclick="DeleteSubjectAssociationInfo(@item.SUBJECT_ASSOCIATION_ID)"><i class="fa fa-trash"></i></a>
                                                </td>
                                            </tr>

                                                        }
                                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Subject Association -->
    <!-- Begin Honour -->
    <div class="form-group panel-group" id="accordion">
        <div class="panel panel-info overflow-hidden">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" href="#Honour">
                        <i class="fa fa-plus-circle pull-right"></i>
                        4. Honour
                    </a>
                </h3>
            </div>
            <div id="Honour" class="panel-collapse collapse">
                <div class="panel-body">
                    <div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#Honour-dialog" data-toggle="modal"><i class="fa fa-plus"></i>Add</a>
                    </div>
                    <div class="table-responsive col-md-12">
                        <table class="table table-bordered table-hover" id="tblHonor">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title of Talk</th>
                                    <th>Programme Title</th>
                                    <th>Institution Name</th>
                                    <th>Place</th>
                                    <th>Form Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.liHonor != null && Model.liHonor.Count > 0)
                                    {
                                        int nCount = 0;
                                        foreach (var item in Model.liHonor)
                                        {
                                            <tr>
                                                <td>@{nCount++;} @nCount</td>
                                                <td>@item.TITLE_OF_TALK</td>
                                                <td>@item.PROGRAMME_TITLE</td>
                                                <td>@item.INSTITION_NAME</td>
                                                <td>@item.PLACE</td>
                                                <td>@item.FROM_DATE</td>
                                                <td>
                                                    <a class="text-info" href="#Honour-dialog" onclick="FetchHonorInfo(@item.HONOR_ID)" data-toggle="modal"><i class="fa fa-edit"></i></a>
                                                    <a class="text-danger" href="javascript:;" onclick="DeleteHonorInfo(@item.HONOR_ID)"><i class="fa fa-trash"></i></a>
                                                </td>
                                            </tr>

                                                        }
                                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Honour -->
</div>


<!-- Modal-->
<div class="modal" id="Publish-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Book Publish Information</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12">

                        <div class="form-group">
                            @Html.Label("Activity Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-6">
                                @Html.DropDownListFor(m => m.sActivityType, (Model.sActivityType != null) ? Model.sActivityType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sActivityType, "", new { @class = "text-danger" })
                            </div>
                        </div> <br />

                        <div id="dvBind" class="hidden">

                            <div class="form-group">
                                @Html.Label("Programme Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    @Html.DropDownListFor(m => m.sProgrammeTypeList, (Model.sProgrammeTypeList != null) ? Model.sProgrammeTypeList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sProgrammeTypeList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Date", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    <div class="input-group date" id="datetimepicker">
                                        <input type="text" class="form-control" value="" id="txtDate" data-parsley-required="true" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Title", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    <input type="text" class="form-control" id="txtTile" data-parsley-required="true" />
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Organizer", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    <input type="text" class="form-control" id="txtOrganizer" data-parsley-required="true" />
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Place", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    <input type="text" class="form-control" id="txtPlace" data-parsley-required="true" />
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Level", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    @Html.DropDownListFor(m => m.sLevelList, (Model.sLevelList != null) ? Model.sLevelList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sLevelList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Paper Title", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-6">
                                    <input type="text" class="form-control" id="txtPaperTitle" data-parsley-required="true" />
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Presenting Author", htmlAttributes: new { @class = "col-md-3 control-label " })
                                <div class="col-md-9" data-parsley-required="true">
                                    <div class="radio radio-css radio-success">
                                        <input type="radio" name="cssRadio" id="cssYes" value="option1" />
                                        <label for="cssYes">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="radio radio-css ">
                                        <input type="radio" name="cssRadio" id="cssNo" value="option2" />
                                        <label for="cssNo">
                                            No
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group ">
                                @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    <div class="btn btn-primary" onclick="FileClick('PublishUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                    <input type="file" id="PublishUpload" class="hidden" multiple="multiple" max="3" onchange="LoadFile('PublishUploadData', 'PublishUpload')" />
                                </div>
                            </div>

                            <div class="form-group " id="PublishUploadData">
                                <div class="form-group col-md-12 table-responsive">
                                    <div class="col-md-1"></div>
                                    <div class="col-md-10">
                                        <table class="table table-bordered table-hover" id="tbl_PublishUpload">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>File</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbPublishUpload"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!--End Modal-->
<!-- Begin Awards Modal -->
<div class="modal" id="Awards-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Staff Awards Info</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12" id="dvAwards" data-parsley-validate="true">

                        <div class="form-group">
                            @Html.Label("Award Title", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtAwardTile" data-parsley-required="true" placeholder="Award Title" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtYear" data-parsley-type="number" data-parsley-required="true" placeholder="Year" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Awarded By", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtAwardedBy" data-parsley-required="true" placeholder="Awarded By" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Activity Level", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.sLevelList, (Model.sLevelList != null) ? Model.sLevelList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", @data_parsley_required = "true", id = "ddlLevel" })
                                @Html.ValidationMessageFor(m => m.sLevelList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="btn btn-primary" onclick="FileClick('AwardUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                <input type="file" id="AwardUpload" class="hidden" multiple="multiple" onchange="LoadFile('AwardUploadData', 'AwardUpload')" />
                            </div>
                        </div>


                        <div class="form-group" id="AwardUploadData">
                            <div class="form-group col-md-12 table-responsive">
                                <div class="col-md-1"></div>
                                <div class="col-md-10">
                                    <table class="table table-bordered table-hover" id="tbl_AwardUpload">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>File</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbAwardUpload"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <br />

                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a id="btnAward" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<input type="Hidden" id="hdAwards" />
<!-- End Awards Modal -->
<!-- Begin Membership Modal -->
<div class="modal" id="Membership-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Staff Membership Info</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12" id="dvMembership" data-parsley-validate="true">

                        <div class="form-group">
                            @Html.Label("Academic Body", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <select class="selectpicker form-control" id="ddlMembership" data-live-search="true" data-parsley-required="true">
                                    <option value=""> -- Select -- </option>
                                    <option value="1">Board Of Study </option>
                                    <option value="2">Academic counsil </option>
                                    <option value="3">Syndicate </option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Name of the Board", htmlAttributes: new { @class = "col-md-3 control-label " })
