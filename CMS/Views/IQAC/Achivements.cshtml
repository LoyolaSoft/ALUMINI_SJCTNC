    // Save
    function SaveHonorData()
    {
        // Validation Check ,...
        var isValid = true;
        if ($('#dvHonour').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }

        //for image update
        var HonourImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
