<script>
    function GetEncryptedStringByImgPath(imgPath)
    {
        var Encrypt = "";
        $.ajax({
            url: '@Url.Action("EncryptStringForImagePath", "IQAC")',
            method: 'POST',
            async: false,
            cache: false,
            datatype: 'json',
            data: { inputString: imgPath },
            success: function (data) {

                if (data!= null && data!= '') {

                    Encrypt = data;

                }
            }, error: function (error) {

            }
        });

        return Encrypt;

    }
</script>

<script type="text/javascript">
    function BindFileInfo(FilePath,TbBind,DivId)
    {
       // alert(FilePath);
        if (FilePath != null && FilePath != '')
        {
            var str = FilePath;
            var res = str.split(",");
            //fetch img encrption by img path
           
            var Data = '';
            for (var i = 0; i < res.length; i++)
            {
                var EncryptImagePath = GetEncryptedStringByImgPath(res[i]);
                var extension = res[i].split(".");
                var actualFileDom = '';
                if (extension[1] != null && extension[1] != '')
                {
                    if (extension[1] == 'jpg' || extension[1] == 'png')
                    {
                        actualFileDom = "<li class=''>" +
                                                      "<div class='document-file'>" +
                                                          "<a href='#'>" +
                                                              "<img src=" + res[i] + "   alt='' cms-update='1' width='77' height='80' >" +
                                                          "</a>" +
                                                      "</div>" +
                                                      "<div class='document-name'><a href='" + res[i] + "' download>" + res[i] + "</a></div>" +
                                                  "</li>";
                        //actualFileDom ="<img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + UniqueName + "></img>";
                    }
                    else
                    {
                        actualFileDom = "<li class=''>" +
                                                  "<div class='document-file'>" +
                                                  "<a href='#'>" +
                                                      "<i class='fa fa-file'></i>" +
                                                  "</a>" +
                                                  "</div>" +
                                                 "<div class='document-name'><a href='" + res[i] + "' download  title=" + res[i] + " cms-update='1'>" + res[i] + "</a></div>" +
                                            "</li>";
                        //actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                    }

                    var result = "<ul class='attached-document clearfix'>" + actualFileDom + "</ul> ";

                    // data.append(files[i].name, files[i]);
                    nCount++; nFileCount++;


                    Data += '<tr id=' + nCount + ' cms-img-path=' + EncryptImagePath + '>\
                            <td>' + nCount + '</td>\
                            <td>'+ result + '</td>\
                            <td><a class="btn btn-default" onclick="FileCancel(' + nCount + ',' + TbBind + ')"> Cancel </a></td>\
                         </tr>';
                }
            }

            $('#' + TbBind).empty().append(Data);
            $('#' + DivId).removeClass('hidden');
        }
    }

    function FileCancel(nCount, TbBind)
    {
        $('#' + TbBind +'tbody tr').each(function ()
        {
            $(this).find('#' + nCount).empty();
        });
    }
</script>


@* Award Script *@
<script>
    $(function () {
        $('#Awards-dialog').on('hidden.bs.modal', function (e) {
            $('#hdAwards').val('');
            $('#txtAwardTile').val('');
            $('#txtYear').val('');
            $('#txtAwardedBy').val('');
            $('#ddlLevel').val('');
            nFileCount = 0; nCount = 0;
            $('.selectpicker').selectpicker('refresh');
            $('#tbAwardUpload').empty();
            var entries = formData.entries();
            for(var pair of entries)
            {
                formData.delete(pair[0]);
            }
        });
    });

    // Fetch Award List
    function BindAwards()
    {
        var sDom = '';
        $.ajax({
            url: '@Url.Action("FetchAwards", "IQAC")',
            method: 'POST',
            datatype: 'json',
            success: function (data)
            {
                $('#tblAwards tbody').empty();
                if (data.Message != null && data.Message!='')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    var nCount = 1;
                    $.each(data, function (n,i)
                    {
                        sDom += '<tr>\
                                    <td>' + nCount + '</td>\
                                    <td>' + i.AWARD_TITLE + '</td>\
                                    <td>' + i.YEAR + '</td>\
                                    <td>' + i.AWARDED_BY + '</td>\
                                    <td>' + i.LEVEL_ID + '</td>\
                                    <td>\
                                        <a class="text-info" href="#Awards-dialog" data-toggle="modal" onclick="FetchAwardInfo(' + i.AWARD_ID + ')"><i class="fa fa-edit"></i></a>\
                                        <a class="text-danger" href="javascript:;" onclick="DeleteAward(' + i.AWARD_ID + ')"><i class="fa fa-trash"></i></a>\
                                    </td>\
                                </tr>';
                        nCount++;
                    });
                    $('#tblAwards tbody').empty().append(sDom);

                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
    // Save
    $('#btnAward').on('click', function ()
    {
        // Validation Check ,...
        var isValid = true;
        if ($('#dvAwards').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }

        //for image update
        var AwardsImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#AwardUploadData').find("table tbody tr").each(function ()
        {
            if ($(this).attr("cms-img-path"))
            {
                AwardsImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else
            {
                if ($(this).attr("id"))
                {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0)
        {
            AwardsImagePath = AwardsImagePath.slice(0, -1);
            AwardsImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto'))
            {
                formData.delete("sPhoto");
            }

            formData.append("sPhoto", AwardsImagePath);
        }
        if (iCount > 0)
        {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }


        //alert(formData);
        var sJsonData = '{"AWARD_ID":"' + $('#hdAwards').val() + '","AWARD_TITLE":"' + $('#txtAwardTile').val() + '","YEAR":"' + $('#txtYear').val() + '","AWARDED_BY":"' + $('#txtAwardedBy').val() + '","LEVEL_ID":"' + $('#ddlLevel').val() + '","FILE_PATH":"' + FilePath + '"}';


        //clearing formdata sJsonData
        if (formData.has('sJsonData')) {
            formData.delete("sJsonData");
        }

        formData.append("sJsonData", sJsonData);
        $.ajax({
            url:'@Url.Action("SaveAward", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data)
            {
                
                if (data.ErrorCode == "200")
                {
                    $('body').removeClass('modal-open');
                    $('.modal-backdrop').remove();
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    BindAwards();
                } else
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    function FetchAwardInfo(ID)
    {
        if (ID != null && ID != '')
        {
            $.ajax({
                url: '@Url.Action("FetchAwardById", "IQAC")',
                method: 'POST',
                datatype: 'json',
                data: { sAwardId: ID },
                success: function (data)
                {
                    $('#tbAwardUpload').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else
                    {
                        $('#hdAwards').val(data[0].AWARD_ID);
                        $('#txtAwardTile').val(data[0].AWARD_TITLE);
                        $('#txtYear').val(data[0].YEAR);
                        $('#txtAwardedBy').val(data[0].AWARDED_BY);
                        $('#ddlLevel').val(data[0].LEVEL_ID);
                       // $('#AwardUpload').val(data[0].FILE_PATH);
                        //$('#AwardUpload').html(data[0].FILE_PATH);
                        //LoadFile('AwardUploadData', 'tbAwardUpload');
                        BindFileInfo(data[0].FILE_PATH, 'tbAwardUpload', 'AwardUploadData');
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }

    function DeleteAward(ID)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        }
        if (ID != null && ID != '')
        {
            $.ajax({
                url: '@Url.Action("DeleteAwards", "IQAC")',
                method: 'POST',
                datatype: 'json',
                data: { sAwardId: ID },
                success: function (data)
                {
                    if (data.ErrorCode = '200')
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        BindAwards();
                    } else
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
</script>

