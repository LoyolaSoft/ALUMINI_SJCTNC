                                <input type="text" class="form-control" id="txtBoardName" data-parsley-required="true" placeholder="Name of the Board" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("College / University", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtCollege" data-parsley-required="true" placeholder="College / University" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Period From", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtPeriod" data-parsley-required="true" data-parsley-type="number" data-parsley-maxlength="4" placeholder="Period From" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Period To", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtPeriodTo" data-parsley-required="true" data-parsley-type="number" data-parsley-maxlength="4" placeholder="Period To" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="btn btn-primary" onclick="FileClick('MemUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                <input type="file" id="MemUpload" class="hidden" multiple="multiple" onchange="LoadFile('MemUploadData', 'MemUpload')" />
                            </div>
                        </div>

                        <div class="form-group" id="MemUploadData">
                            <div class="form-group col-md-12 table-responsive">
                                <div class="col-md-1"></div>
                                <div class="col-md-10">
                                    <table class="table table-bordered table-hover" id="tbl_MemUpload">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>File</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbMemUpload"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <br />

                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a id="btnMemberShip" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdMemberId" />
<!-- End Membership Modal -->
<!-- Begin Subject Association Modal -->
<div class="modal" id="SubjectAssociation-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Staff Subject Association Info</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12" id="dvSubjectAssociation" data-parsley-validate="true">

                        <div class="form-group">
                            @Html.Label("Name of the Association", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtAssociationName" data-parsley-required="true" placeholder="Name of the Association" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Position Held", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtPositionHeld" data-parsley-required="true" placeholder="Position Held" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Period From", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtAssociationPeriod" data-parsley-required="true" data-parsley-type="number" data-parsley-maxlength="4" placeholder="Period From" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Period To", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtAssociationPeriodTo" data-parsley-required="true" data-parsley-type="number" data-parsley-maxlength="4" placeholder="Period To" />
                            </div>
                        </div>

