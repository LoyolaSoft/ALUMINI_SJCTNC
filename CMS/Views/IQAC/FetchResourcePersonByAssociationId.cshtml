@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}

<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover" id="tblResourcePerson">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Designation</th>
                <th>Institution</th>
                <th>Place</th>
                <th>Topic</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liResourcePerson!=null && Model.liResourcePerson.Count>0)
            {
                int nCount = 0;
                foreach (var item in Model.liResourcePerson)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.PERSON_NAME</td>
                        <td>@item.DESIGNATION</td>
                        <td>@item.INSTITUTION</td>
                        <td>@item.PLACE</td>
                        <td>@item.TOPIC</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>