@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
    int nCount = 0;
}

<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">Department Daily Activity</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Department Daily Activity<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Department Daily Activity</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12 form-group">
                        <a href="#Activity-dialog" class="btn btn-success pull-right" data-toggle="modal"><i class="fa fa-plus"></i> Add</a>
                    </div>
                    <div class="form-group col-md-12 table-responsive">
                        <table class="table table-bordered table-hover" id="tblDailyActivity">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Activity Date</th>
                                    <th>Activity</th>
                                    @*<th>File</th>*@
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liDailyActivity != null && Model.liDailyActivity.Count > 0)
                                {
                                    foreach (var item in Model.liDailyActivity)
                                    {
                                        nCount++;
                                        <tr>
                                            <td>@nCount</td>
                                            <td>@item.ACTIVITY_DATE</td>
                                            <td>@item.ACTIVITY</td>
                                            @*<td><a href="javascript:;" download="@item.FILE_PATH"><i class="glyphicon glyphicon-eye-open"></i></a></td>*@
                                            <td>
                                                <a href="#Activity-dialog" data-toggle="modal" onclick="FetchDailyActivityById(@item.ACTIVITY_ID)" title="Click To Edit"><i class="fa fa-edit"></i></a>
                                                <a href="javascript:;" onclick="DeleteDailyActivity(@item.ACTIVITY_ID)"><i class="fa fa-trash text-danger"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>

    </div>
</div>

<!-- Begin Activity Modal -->
<div class="modal" id="Activity-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Department Daily Activity </h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12" id="dvActivity" data-parsley-validate="true">

                        <div class="form-group">
                            @Html.Label("Activity Date", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <div class="input-group date" id="datepicker" data-date-format="dd/mm/yyyy">
                                    <input type="text" class="form-control" id="txtActivityDate" placeholder="Select Date dd/mm/yyyy">
                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Activity", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <textarea class="form-control" rows="5" cols="5" data-parsley-maxlength="1000" id="txtActivity"></textarea>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="btn btn-primary" onclick="FileClick('ActivityUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                <input type="file" id="ActivityUpload" class="hidden" multiple="multiple" onchange="LoadFile('dvActivityUpload', 'ActivityUpload')" />
                            </div>
                        </div>


                        <div class="form-group hidden" id="dvActivityUpload">
                            <div class="form-group col-md-12 table-responsive">
                                <div class="col-md-1"></div>
                                <div class="col-md-10">
                                    <table class="table table-bordered table-hover" id="tbl_ActivityUpload">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>File</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbActivityUpload"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <br />

                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<input type="Hidden" id="hdActivityId" />
<!-- End Activity Modal -->


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>

    $(function () {
        $('#Activity-dialog').on('hidden.bs.modal', function (e)
        {
            $('#hdActivityId').val('');
            $('#txtActivityDate').val('');
            $('#txtActivity').val('');
            $('.selectpicker').selectpicker('refresh');
            nFileCount = 0; nCount = 0;
            $('#tbActivityUpload').empty();
        });
    });

    function ContentLoad()
    {
        $('#tblDailyActivity').DataTable();
        //$('.dataTables_filter').addClass('pull-right');
        //$('#tblDailyActivity_previous').addClass('pull-right');

        // Document Ready Function ,..
    }


    handleDatepicker = function ()
    {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            endDate: new Date,
            format: "dd/mm/yyyy",
            orientation: "left"
            // 'top': top,
            // 'left': left
        })
    }
    handleDatepicker();

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    function FetchDailyActivityById(Id)
    {
        $.ajax({
            url: '@Url.Action("FetchDailyActivityById", "IQAC")',
            method:'POST',
            datatype: 'json',
            data: { sActivityId: Id },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#hdActivityId').val(data[0].ACTIVITY_ID);
                    $('#txtActivityDate').val(data[0].ACTIVITY_DATE);
                    $('#txtActivity').val(data[0].ACTIVITY);
                    BindFileInfo(data[0].FILE_PATH, 'tbActivityUpload', 'dvActivityUpload');
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function DeleteDailyActivity(Id)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        } else
        {
            $.ajax({
                url: '@Url.Action("DeleteDailyActivity", "IQAC")',
                method: 'POST',
                datatype: 'json',
                data: { sActivityId: Id },
                success: function (data)
                {
                    if (data.ErrorCode =='200')
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadContent('/IQAC/DailyActivityList');
                    } else
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }



    $('#btnSubmit').on('click', function ()
    {
        // Validation Check ,...
        var isValid = true;
        if ($('#dvActivity').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }

        //for image update
        var DeptActivityImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#dvActivityUpload').find("table tbody tr").each(function () 
        {
            if ($(this).attr("cms-img-path")) 
            {
                DeptActivityImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else 
            {
                if ($(this).attr("id")) 
                {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0) 
        {
            DeptActivityImagePath = DeptActivityImagePath.slice(0, -1);
            DeptActivityImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto')) 
            {
                formData.delete("sPhoto");
            }
            formData.append("sPhoto", DeptActivityImagePath);
        }
        if (iCount > 0) 
        {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }
        
        var JsonData = '';
        JsonData = '{"ACTIVITY":"' + $('#txtActivity').val() + '","ACTIVITY_DATE":"' + $('#txtActivityDate').val() + '","ACTIVITY_ID":"' + $('#hdActivityId').val() + '","FILE_PATH":"'+FilePath+'"}';
        formData.append("JsonData", JsonData);
        $.ajax({
            url: '@Url.Action("SaveDailyActivity", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data)
            {
                if (data.ErrorCode == '200')
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/IQAC/DailyActivityList');
                } else
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
</script>


@* File Upload Script *@
<script>
    var formData = new FormData();
    var nCount = 0; var nFileCount = 0;
    function FileClick(FileUpload)
    {
        $('#' + FileUpload).click();
    }

    function LoadFile(divUpload, FileUpload) {

        var files = document.getElementById('' + FileUpload + '').files;

        if (files.length > 3 || nFileCount >= 3)
        {
            swal({ title: "Warning !", text: "You can only upload a maximum of 3 files", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        var Data = '';
        if (files.length != 0) {
            //alert('File In');
            //alert(document.getElementById('' + FileUpload + '').files.length);
            for (var i = 0; i < document.getElementById('' + FileUpload + '').files.length ; i++)
            {
                    var extension = GetFileExtension(files[i]);
                    var actualFileDom='';
                    if (extension != null && extension != '')
                    {
                        if (extension == 'jpg' || extension == 'png')
                        {
                            actualFileDom = "<li class=''>" +
                                                          "<div class='document-file'>" +
                                                              "<a href='#'>" +
                                                                  "<img src=" + window.URL.createObjectURL(files[i]) + "   alt='' cms-update='1' width='77' height='80' >" +
                                                              "</a>" +
                                                          "</div>" +
                                                          "<div class='document-name'><a href='" + window.URL.createObjectURL(files[i]) + "' download>" + files[i].name + "</a></div>" +
                                                      "</li>";
                            //actualFileDom ="<img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + UniqueName + "></img>";
                        }
                        else
                        {
                            actualFileDom = "<li class=''>" +
                                                      "<div class='document-file'>" +
                                                      "<a href='#'>" +
                                                          "<i class='fa fa-file'></i>" +
                                                      "</a>" +
                                                      "</div>" +
                                                     "<div class='document-name'><a href='" + window.URL.createObjectURL(files[i]) + "' download  title=" + files[i].name + " cms-update='1'>" + files[i].name + "</a></div>" +
                                                "</li>";
                            //actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                        }

                        var result = "<ul class='attached-document clearfix'>" + actualFileDom + "</ul> ";

                        // data.append(files[i].name, files[i]);
                        nCount++; nFileCount++;
                        Data += '<tr id=' + nCount + '>\
                            <td>' + nCount + '</td>\
                            <td>'+ result + '</td>\
                            <td><a class="btn btn-default" onclick="FileCancel(' + nCount + ')"> Cancel </a></td>\
                         </tr>';
                        formData.append(files[i].name, files[i]);
                }
            }

            $('#tb' + FileUpload).append(Data);
            $('#' + divUpload).removeClass('hidden');
        }
    }

    function GetFileExtension(file)
    {
        // Get uploaded file extension
        var extension = file.name.split('.').pop().toLowerCase();
        var validFileExtensions = ['doc', 'docx', 'pdf', 'jpg', 'png', 'txt', 'xlsx'];
        if ($.inArray(extension, validFileExtensions) == -1)
        {
           // alert("Sorry!! Upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file");
            swal({ title: "Warning !", text: "Sorry!! upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return extension = null;
        }
        else
        {
            return extension;
        }
    }


    function FileCancel(rowId)
    {
        var row = document.getElementById(rowId);
        formData.delete(rowId);
        row.parentNode.removeChild(row);
        nFileCount--;
    }
</script>

<script type="text/javascript">
    function BindFileInfo(FilePath,TbBind,DivId)
    {
        if (FilePath != null && FilePath != '')
        {
            var str = FilePath;
            var res = str.split(",");
            var Data = '';
            for (var i = 0; i < res.length; i++)
            {
                //fetch img encrption by img path
                var EncryptImagePath = GetEncryptedStringByImgPath(res[i]);
                var extension = res[i].split(".");
                var actualFileDom = '';
                if (extension[1] != null && extension[1] != '')
                {
                    if (extension[1] == 'jpg' || extension[1] == 'png')
                    {
                        actualFileDom = "<li class=''>" +
                                                      "<div class='document-file'>" +
                                                          "<a href='#'>" +
                                                              "<img src=" + res[i] + "   alt='' cms-update='1' width='77' height='80' >" +
                                                          "</a>" +
                                                      "</div>" +
                                                      "<div class='document-name'><a href='" + res[i] + "' download>" + res[i] + "</a></div>" +
                                                  "</li>";
                        //actualFileDom ="<img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + UniqueName + "></img>";
                    }
                    else
                    {
                        actualFileDom = "<li class=''>" +
                                                  "<div class='document-file'>" +
                                                  "<a href='#'>" +
                                                      "<i class='fa fa-file'></i>" +
                                                  "</a>" +
                                                  "</div>" +
                                                 "<div class='document-name'><a href='" + res[i] + "' download  title=" + res[i] + " cms-update='1'>" + res[i] + "</a></div>" +
                                            "</li>";
                        //actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                    }

                    var result = "<ul class='attached-document clearfix'>" + actualFileDom + "</ul> ";

                    // data.append(files[i].name, files[i]);
                    nCount++; nFileCount++;


                    Data += '<tr id=' + nCount + ' cms-img-path=' + EncryptImagePath + '>\
                            <td>' + nCount + '</td>\
                            <td>'+ result + '</td>\
                            <td><a class="btn btn-default" onclick="FileCancel(' + nCount + ')"> Cancel </a></td>\
                         </tr>';
                }
            }

            $('#' + TbBind).append(Data);
            $('#' + DivId).removeClass('hidden');
        }
    }

    function FileCancel(rowId)
    {
        var row = document.getElementById(rowId);
        formData.delete(rowId);
        row.parentNode.removeChild(row);
        // nFileCount--;
    }
    function GetEncryptedStringByImgPath(imgPath)
    {
        var Encrypt = "";
        $.ajax({
            url: '@Url.Action("EncryptStringForImagePath", "IQAC")',
            method: 'POST',
            async: false,
            cache: false,
            datatype: 'json',
            data: { inputString: imgPath },
            success: function (data)
            {
                if (data != null && data != '')
                {
                    Encrypt = data;
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
        return Encrypt;
    }
</script>