

@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    ViewBag.Title = "PHDGuidenceList";
    Layout = null;
}


<div class="form-group col-md-12">
    <a class="btn btn-success pull-right form-group m-b-5" href="#IQACPHDGuidence-dialog" onclick="Add()" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
</div>

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblIQACProject">
        <thead>
            <tr>
                <th>#</th>

                @*<th>Staff Name</th>*@
                <th>Category</th>
                <th>Student Name</th>
                <th>Register No</th>
                <th>Project Title</th>
                <th>Registration Year</th>
                <th>Status</th>
                <th> Date</th>
                @*<th>Entry Date</th>*@

                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.liIQACPhdGuidence != null && Model.liIQACPhdGuidence.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liIQACPhdGuidence)
                {
                    count = count + 1;
                    <tr>
                        <td>@count</td>

                        @*<td>@item.FIRST_NAME</td>*@
                        <td>@item.CATEGORY_NAME</td>
                        <td>@item.STUDENT_NAME</td>
                        <td>@item.REGISTER_NUMBER</td>
                        <td>@item.PROJECT_TITLE</td>
                        <td>@item.REGISTRATION_YEAR</td>
                        <td>@item.STATUS</td>
                        <td>@item.GUDIENCE_DATE</td>
                        @*<td>@item.ENTRY_DATE</td>*@
                        <td>
                            <a href="#IQACPHDGuidence-dialog" onclick="FetchLiIQACProjectById(@item.IQAC_PHD_GUDIENCE_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                            <a href="javascrip:;" onclick="GetConfirm(@item.IQAC_PHD_GUDIENCE_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal" id="IQACPHDGuidence-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit IQAC Ph.D Guidence </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="IQACPHDGuidence">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Category Type</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sIQACCategory, (Model.sIQACCategory != null) ? Model.sIQACCategory : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sIQACCategory, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Scholar's Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtStudentName" class="form-control" placeholder="Student Name" data-parsley-required="true" data-parsley-maxlength="80">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Register No</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtRegisterNo" class="form-control" placeholder="Register No" data-parsley-required="true" data-parsley-maxlength="200">
                                        </div>
                                    </div>


                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Project Title</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtProjectTitle" class="form-control" placeholder="Project Title" data-parsley-required="true" data-parsley-maxlength="300">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Registration  Year </label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtRegistrationYear" class="form-control" placeholder="Registration Year" data-parsley-required="true">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Status </label>

                                        <div class="col-md-8">
                                            @*<input type="number" id="txtStatus" class="form-control" placeholder="Status" data-parsley-required="true">*@
                                            @Html.DropDownListFor(m => m.sStatusList, (Model.sStatusList != null) ? Model.sStatusList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true", id = "txtStatus" })
                                            @Html.ValidationMessageFor(m => m.sStatusList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label"> Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtGuidenceDate" class="form-control input-sm" placeholder="Select  Date" id="txtGuidenceDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Minimum Period Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtGuidenceDate" class="form-control input-sm" placeholder="Select  Date" id="txtminiGuidenceDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Maximum Period Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtGuidenceDate" class="form-control input-sm" placeholder="Select  Date" id="txtmaxiGuidenceDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                        <div class="col-md-9">
                                            <div class="btn btn-primary" onclick="FileClick('PHDGuidenceUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                            <input type="file" id="PHDGuidenceUpload" class="hidden" multiple="multiple" onchange="LoadFile('PHDGuidenceUploadData', 'PHDGuidenceUpload')" />
                                        </div>
                                    </div>

                                    <div class="form-group" id="PHDGuidenceUploadData">
                                        <div class="form-group col-md-12 table-responsive">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-10">
                                                <table class="table table-bordered table-hover" id="tbl_PHDGuidenceUpload">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>File</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbPHDGuidenceUpload"></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="iqacProjectId" value="" />
    </div>
</div>

<script>
    function ContentLoad() 
    {
        handleDatepicker = function () {
            "use strict";
            $(".date").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
                // 'top': top,
                // 'left': left
            }
            )
        }
        handleDatepicker();
        // Document Ready Function .
    }


    function FetchLiIQACProjectById(sProjectId) 
    {
        //$('#pBody').parsley().destroy();

        if (sProjectId != null) 
        {
            $.ajax({
                url: "/IQAC/FetchPHDGuidenceById",
                type: "post",
                data: { sIQACID: sProjectId },
                success: function (data) 
                {
                    if (data.Message != null) 
                    {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    else 
                    {
                        if (data.oResult[0] != null) 
                        {
                            BindFileInfo(data.oResult[0].FILE_PATH, 'tbPHDGuidenceUpload', 'PHDGuidenceUploadData');
                            $('#txtStudentName').attr('value', data.oResult[0].STUDENT_NAME);
                            $('#txtRegisterNo').attr('value', data.oResult[0].REGISTER_NUMBER);
                            $('#txtProjectTitle').attr('value', data.oResult[0].PROJECT_TITLE);
                            $('#txtRegistrationYear').attr('value', data.oResult[0].REGISTRATION_YEAR);
                            $('#txtStatus').val(data.oResult[0].STATUS);
                            $('#txtGuidenceDate').attr('value', data.oResult[0].GUDIENCE_DATE);
                            $('#txtminiGuidenceDate').attr('value', data.oResult[0].MINI_GUDIENCE_DATE);
                            $('#txtmaxiGuidenceDate').attr('value', data.oResult[0].MAXI_GUDIENCE_DATE);
                            $('#sIQACCategory option[value="' + data.oResult[0].CATEGORY_ID + '"]').attr("selected", "selected");
                            
                            $('#iqacProjectId').attr('value', data.oResult[0].IQAC_PHD_GUDIENCE_ID);
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }
                },
                error: function (ex) 
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }

    function SaveData() 
    {
        var isValid = true;
        if ($('#IQACPHDGuidence').parsley().validate() !== true) isValid = false;
        if (!isValid) 
        {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        //for image update
        var PHDGuidenceImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#PHDGuidenceUploadData').find("table tbody tr").each(function ()
        {
            if ($(this).attr("cms-img-path"))
            {
                PHDGuidenceImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else
            {
                if ($(this).attr("id"))
                {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0)
        {
            PHDGuidenceImagePath = PHDGuidenceImagePath.slice(0, -1);
            PHDGuidenceImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto'))
            {
                formData.delete("sPhoto");
            }

            formData.append("sPhoto", PHDGuidenceImagePath);
        }
        if (iCount > 0)
        {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }

        //alert($('#sIQACCategory').val());
        var sprojectId = $('#iqacProjectId').val();
        var CategoryId = $('#sIQACCategory').val();
        var StudentName = $('#txtStudentName').val();
        var RegisterNo = $('#txtRegisterNo').val();
        var ProjectTitle = $('#txtProjectTitle').val();
        var RegisrationYear = $('#txtRegistrationYear').val();
        var Status = $('#txtStatus').val();
        var guidenceDate = $('#txtGuidenceDate').val();
        var mini_guidenceDate = $('#txtminiGuidenceDate').val();
        var maxi_guidenceDate = $('#txtmaxiGuidenceDate').val();
        if (formData.has('sJsonData')) 
        {
            formData.delete("sJsonData");
        }
        var jsonData = '{"IQAC_PHD_GUDIENCE_ID":"' + sprojectId + '","CATEGORY_ID":"' + CategoryId + '","STUDENT_NAME":"' + StudentName + '","REGISTER_NUMBER":"' + RegisterNo + '","PROJECT_TITLE":"' + ProjectTitle + '","REGISTRATION_YEAR":"' + RegisrationYear + '","STATUS":"' + Status + '","GUDIENCE_DATE":"' + guidenceDate + '","MINI_GUDIENCE_DATE":"' + mini_guidenceDate + '","MAXI_GUDIENCE_DATE":"' + maxi_guidenceDate + '","FILE_PATH":"' + FilePath + '"}';
        formData.append("sJsonData",jsonData);

        var req = $.ajax({
            url: "/IQAC/SavePHDGuidence",
            type: "post",
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.Message != null && data.Message != "") 
                {
                    if (data.ErrorCode == "200") 
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        $('#liPHDGudience').click();
                    }
                    if (data.ErrorCode == "417") 
                    {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    if (data.ErrorCode == "503") 
                    {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }
                    if (data.ErrorCode == "406") 
                    {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }
                }
            },
            error: function (ex) 
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    GetConfirm = function (sProjectId) 
    {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () 
        {
            $.ajax({
                url: "/IQAC/DeletePHDGuidence",
                type: "post",
                data: { sIQACID: sProjectId },
                success: function (data) 
                {
                    if (data.Message != null && data.Message != "") 
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        $('#liPHDGudience').click();
                    }
                },
                error: function (ex) 
                {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }
            });
        });

    }

    function Add() 
    {
        //$('#pBody').parsley().destroy();
        $('#txtStudentName').attr('value', '');
        $('#txtRegisterNo').attr('value', '');
        $('#txtProjectTitle').attr('value', '');
        $('#txtRegistrationYear').attr('value', '');
        $('#txtStatus').val('');
        $('#txtGuidenceDate').attr('value', '');
        $('#txtminiGuidenceDate').attr('value', '');
        $('#txtmaxiGuidenceDate').attr('value', '');
        $('#sIQACCategory option[value=""]').attr("selected", "selected");
        $('#iqacProjectId').attr('value', '');
        $('.selectpicker').selectpicker('refresh');
    }


    $(function () 
    {
        $('#IQACPHDGuidence-dialog').on('hidden.bs.modal', function (e)
        {
            var entries = formData.entries();
            for(var pair of entries)
            {
                formData.delete(pair[0]);
            }
            $('#txtStudentName').val('');
            $('#iqacProjectId').val('');
            $('#txtRegisterNo').val('');
            $('#txtProjectTitle').val('');
            $('#txtRegistrationYear').val('');
            $('#txtStatus').val('');
            $('#txtGuidenceDate').val('');
            $('#txtminiGuidenceDate').val('');
            $('#txtmaxiGuidenceDate').val('');
            $('#sIQACCategory').val('');
            nFileCount = 0; nCount = 0;
            $('.selectpicker').selectpicker('refresh');
            $('#tbPHDGuidenceUpload').empty();
        });
    });

</script>









