@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;

}

<div class="table-responsive col-md-12">
    <table class="table table-bordered table-hover" id="tblSubjectAssociation">
        <thead>
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Name of the Association</th>
                <th>Posision Held</th>
                <th>Period From</th>
                <th>Period To</th>
            </tr>
        </thead>
        <tfoot id="tfooter">
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Name of the Association</th>
                <th>Posision Held</th>
                <th>Period From</th>
                <th>Period To</th>
            </tr>
        </tfoot>
        <tbody>
            @{
                if (Model.liSubjectAssociation != null && Model.liSubjectAssociation.Count > 0)
                {
                    int nCount = 0;
                    foreach (var item in Model.liSubjectAssociation)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.DEPARTMENT</td>
                            <td>@item.STAFF_CODE</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.ASSOCIATION_NAME</td>
                            <td>@item.POSISION_HELD</td>
                            <td>@item.PERIOD</td>
                            <td>@item.PERIOD_TO</td>
                            
                        </tr>

                                    }
                                }
            }
        </tbody>
    </table>
</div>