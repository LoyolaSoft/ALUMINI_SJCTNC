@{
    Layout = null;
}

@if (Model.liTeachingSubjectWorkload != null && Model.liTeachingSubjectWorkload.Count > 0)
{
    int count = 0;
    <div class="col-md-12 table-responsive">

        @*if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
            {
            <div class="text-center">
                <img class="image" />
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
            </div>
            <div class="text-center">

                <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                <h5>
                    LIBRARY  REPORT FOR <label id="lblReportName">m</label> &nbsp;-(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                        { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } }) <br />

                </h5>
            </div>
            }*@
        <label class="text-center col-xs-10" id="lblQuestion">1. Teaching Subject Workload</label> <br />
        <label class="text-center col-xs-10 lblMonth" id="lblMonth"></label>
        <br />


        <div>
            <table class="table table-bordered table-hover" id="tblReport" border="1">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name of the staff</th>
                        <th>Dept</th>
                        <th>Class</th>
                        <th>Sem</th>
                        <th>SubjectTaught</th>
                        <th>Subject Code</th>
                        <th>Lecture Alloted</th>
                        <th>Lecture Taken</th>
                        <th>Practical Alloted</th>
                        <th>Practical Taken</th>
                        <th>Casual Leave</th>
                        <th>On duty</th>
                        <th>Medical Leave</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.liTeachingSubjectWorkload)
                    {
                    <tr>
                        <td>@{count++;}@count</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.DEPARTMENT_CODE</td>
                        <td>@item.CLASS_CODE</td>
                        <td>@item.SEMESTER_ID</td>
                        <td>@item.COURSE_TITLE</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.LECTURE_ALLOTTED</td>
                        <td>@item.LECTURE_TAKEN</td>
                        <td>@item.PRACTICAL_ALLOTTED</td>
                        <td>@item.PRACTICAL_TAKEN</td>
                        <td>@item.CASUAL_LEAVE</td>
                        <td>@item.ON_DUTY</td>
                        <td>@item.MEDICAL_LEAVE</td>
                    </tr>
                                }
                </tbody>
            </table>
            <hr />
        </div>
    </div>
}


