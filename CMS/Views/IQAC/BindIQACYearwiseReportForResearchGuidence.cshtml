@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblIQACResearchGuidence">
        <thead>
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Category</th>
                <th>Student Name</th>
                <th>Register No</th>
                <th>Project Title</th>
                <th>Registration Year</th>
                <th>Completion year</th>
            </tr>
        </thead>
        <tfoot id="tfooter">
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Category</th>
                <th>Student Name</th>
                <th>Register No</th>
                <th>Project Title</th>
                <th>Registration Year</th>
                <th>Completion year</th>
            </tr>
        </tfoot>
        <tbody>

            @if (Model.liIQACResearchGuidence != null && Model.liIQACResearchGuidence.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liIQACResearchGuidence)
                {
                    count = count + 1;
                    <tr>
                        <td>@count</td>
                        <td>@item.DEPARTMENT</td>
                        <td>@item.STAFF_CODE</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CATEGORY</td>
                        <td>@item.STUDENT_NAME</td>
                        <td>@item.REGISTER_NUMBER</td>
                        <td>@item.PROJECT_TITLE</td>
                        <td>@item.REGISTRATION_YEAR</td>
                        <td>@item.COMPLITION_YEAR</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>