    public string GetuniqueNameForImage(string pathName)
    {
        //var fileName = file.name;
        //var File = fileName.split(".");
        string sgrievanceCode = string.Empty;
        sgrievanceCode = pathName;
        StringBuilder builder = new StringBuilder();
        byte[] hash;
        using (HMACSHA1 sha1 = new HMACSHA1(ASCIIEncoding.ASCII.GetBytes(sgrievanceCode)))
        {
            hash = sha1.ComputeHash(UTF8Encoding.UTF8.GetBytes(pathName));
            Random random = new Random();
            for (int i = 0; i < 4; i++)
            {
                builder.Append(random.Next(i, hash.Length));
            }

        }
        return builder.ToString();
    }



    public string EncryptString(string inputString)
    {
        byte[] b = System.Text.ASCIIEncoding.ASCII.GetBytes(inputString);
        string encrypted = Convert.ToBase64String(b);
        return encrypted;
    }

    public string BindFileDom1(string filePath)
    {
        string fileDom = string.Empty;
        string fileDom1 = string.Empty;
        var TotalPath = filePath.Split(',');
        var extension = string.Empty;
        var uniqueName = string.Empty;
        var UniqueBodyName = string.Empty;
        var UniqueFileName = string.Empty;
        var UniqueNameForFileCancel = string.Empty;
        var EncryptImagePath = string.Empty;
        int fCount = 0;
        var result = string.Empty;
        string Dom1 = string.Empty;
        Dom1 = @"<div class='col-md-12 table-responsive'>" +
                   "<table class='table m-b-0'>" +
                   "<thead>" +
                   "<tr>" +
                             "<th>PREVIEW</th>" +
                             "<th>FILE INFO</th>" +
                             "<th>ACTION</th>" +
                    "</tr>" +
                   "</thead>" +
                     "<tbody id='thisid'>" +
                       "dataforbind" +
                     "</tbody>" +
                 "</table>" +
             "</div>";



        foreach (var path in TotalPath)
        {
            var File = path.Split('.');
            // var filename = path.match(/[-_\w]+[.][\w]+$/i)[0];
            var filename = System.IO.Path.GetFileName(path);

            extension = File[1];
            uniqueName = GetuniqueNameForImage(path);
            uniqueName = uniqueName + bCount;
            UniqueNameForFileCancel = uniqueName + fCount;
            UniqueBodyName = uniqueName + "body";
            UniqueFileName = uniqueName + "fAttachmentForIQAC"+ fCount;
            EncryptImagePath = EncryptString(path);
            fileDom1 = extension.ToLower() == "jpg" || extension.ToLower() == "png" ? "<li class=''>" +
                                          "<div class='document-file'>" +
                                              "<a href='#'>" +
                                                  "<img src=" + path + "   alt='' cms-update='1' width=77 height=80  height=''>" +
                                              "</a>" +
                                          "</div>" +
                                          "<div class='document-name'><a href='" + path + "' download>" + filename + "</a></div>" +
                                      "</li>" : "<li class=''>" +
                                      "<div class='document-file'>" +
                                      "<a href='#'>" +
                                          "<i class='fa fa-file'></i>" +
                                      "</a>" +
                                      "</div>" +
                                     "<div class='document-name'><a href='" + path + "' download  title=" + filename + " cms-update='1'>" + filename + "</a></div>" +
                                "</li>";

            result = "<ul class='attached-document clearfix'>" + fileDom1 + "</ul> ";







            fileDom += "<tr id = " + UniqueNameForFileCancel + " cms-img-path='" + EncryptImagePath + "'> " +
                                "<td>" +
                                    "<span class='preview'>" + result + "</span>" +
                                "</td>" +
                                "<td>" +
                                    "<div>" +
                                        "<dl>" +
                                            "<dt class=text-inverse>File Name:</dt>" +
                                            "<dd class=name>" + filename + "</dd>" +
                                        "</dl>" +
                                    "</div>" +
                                    "<strong class='error text-danger'></strong>" +
                                "</td>" +

                                "<td nowrap=>" +
                                "<div class='col-md-4'>" +
                                        "<button class='btn btn-default cancel width-100 p-r-20' onclick=FileCancel('" + UniqueNameForFileCancel + "')>" +
                                        "<i class='fa fa-trash fa-fw pull-left m-t-2 m-r-5 text-muted'></i>" +
                                            "<span>Cancel</span>" +
                                        "</button>" +
                                  "</div>" +
                                  "<div class='col-md-4'>" +
                                        "thisisforfile" +
                                   "</div>" +


                                "</td>" +
                            "</tr>";




            if (fCount == 0)
            {
                var fileDom3 = @"<span class='btn btn-primary fileinput-button m-r-3'>" +
                                 "<i class='fa fa-plus'></i>" +
                                 "<span>" +
                                    " Add File..." +
                                     "<input type='file' id='" + UniqueFileName + "' class='form-control' onchange=readFiles('" + UniqueFileName + "','" + UniqueBodyName + "')>" +
                                 "</span>" +
                             "</span>";
                fileDom = fileDom.Replace("thisisforfile", fileDom3);

                Dom1 = Dom1.Replace("thisid", UniqueBodyName);
            }
            else
            {
                fileDom = fileDom.Replace("thisisforfile", "");
            }



            fCount = fCount + 1;
        }
        Dom1 = Dom1.Replace("dataforbind", fileDom);


        bCount++;
        return Dom1;
    }
}


