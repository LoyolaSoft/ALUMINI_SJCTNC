@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}


<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">IQAC Individual Staff Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">IQAC Individual Staff Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">IQAC Individual Staff Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">

                        <div class="col-md-3">
                            @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.sAcademicYearList, (Model.sAcademicYearList != null) ? Model.sAcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sAcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            @Html.Label("Staff", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.sStaffList, (Model.sStaffList != null) ? Model.sStaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sStaffList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        @*<div class="col-md-3">
                            @Html.Label("Month", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                <select class="form-control  selectpicker" data-live-search="true" id="sMonthList">
                                    @if (Model.liMonthList != null && Model.liMonthList.Count > 0)
                                    {
                                        int nCount = 0;
                                        <option value=""> -- Select -- </option>
                                        <option value="13"> 2018 </option>
                                        foreach (var item in Model.liMonthList)
                                        {
                                            nCount++;
                                            <option value="@nCount">@item.DAY_ORDER_MONTH</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>*@

                        <div class="col-md-1">
                            <a href="javascript:;" class="btn btn-success hidden" onclick="printDiv()" id="btnPrint"> Print </a>
                        </div>
                        <div class="col-md-1">
                            <a href="javascript:;" class="btn btn-success hidden" onclick="Export()" id="btnExport"> Export </a>
                        </div>

                    </div>
                </div>


                <div id="dvIQACBind" class="form-group col-md-12">

                </div>

            }

        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>

    $('#sAcademicYearList').on('change', function ()
    {
        if ($('#sAcademicYearList').val() && $('#sIQACQuestionsList').val() && $('#sMonthList').val())
        {
            BindList();
        }
    });

    $('#sStaffList').on('change', function ()
    {
        if ($('#sAcademicYearList').val() && $('#sStaffList').val())
        {
            BindList();
        }
    });

    //$('#sMonthList').on('change', function ()
    //{
    //    if ($('#sAcademicYearList').val() && $('#sStaffList').val() && $('#sMonthList').val())
    //    {
    //        BindList();
    //    }
    //});

    function BindList()
    {
        
        $.ajax({
            url:'@Url.Action("BindIQACIndividualReport", "IQAC")',
            method:'POST',
            datatype:'json',
            data: { sAcYear: $('#sAcademicYearList option:selected').text(), sStaff: $('#sStaffList').val(), sMonthId: $('#sMonthList').val() },
            success: function (data)
            {
                $('#dvIQACBind').empty();
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });

                } else
                {
                    $('#btnPrint').removeClass('hidden');
                    $('#btnExport').removeClass('hidden');
                    var columncount = 0;
                    $('#dvIQACBind').append(data);
                    $('.lblMonth').text($('#sMonthList Option:selected').text());
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }


    function printDiv()
    {
        $('#btnPrint').addClass("hidden");
        $('#btnExport').addClass("hidden");
        $('#tfooter').addClass("hidden");
        $('.dataTables_filter').addClass("hidden");
        var printContents = document.getElementById('dvIQACBind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/IQAC/IQACIndividualReport');
    }


    function Export()
    {
        $('#btnPrint').addClass("hidden");
        $('#btnExport').addClass("hidden");
        $('#tfooter').addClass("hidden");
        $('.dataTables_filter').addClass("hidden");
        var title="";
        var sAcademicYear = $('#sAcademicYearList option:selected').text();
        var Question = $('#sIQACQuestionsList option:selected').text();
        var Month = $('#sMonthList option:selected').text();
        title = sAcademicYear + "_" + Question + "_" + Month;
        let file = new Blob([$('#dvIQACBind').html()], { type: "application/vnd.ms-excel" });
            let url = URL.createObjectURL(file);
            let a = $("<a />", {
                href: url,
                download: title + ".xls"
            }).appendTo("body").get(0).click();
            //e.preventDefault();
            loadContent('/IQAC/IQACIndividualReport');
    }



</script>
