
@model CMS.ViewModel.ViewModel.IQACViewModel
@using CMS.Utility
@{
    ViewBag.Title = "ProjectList";
    Layout = null;
}



<div class="form-group col-md-12">
    <a class="btn btn-success pull-right form-group m-b-5" href="#IQACProject-dialog" onclick="Add()" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
</div>

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblIQACProject">
        <thead>
            <tr>
                <th>#</th>

                @*<th>Staff Name</th>*@
                <th>Project Type</th>
                <th>Project Title</th>
                <th>Duration</th>
                <th>Period From</th>
                <th>Period To</th>
                <th>Type of Funding</th>
                <th>Funding Agency</th>
                <th>Amount</th>
                @*<th>Entry Date</th>*@

                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.liIQACProject != null && Model.liIQACProject.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liIQACProject)
                {
                    count = count + 1;
                    <tr>
                        <td>@count</td>

                        @*<td>@item.FIRST_NAME</td>*@
                        <td>@item.PROJECT_TYPE</td>
                        <td>@item.PROJECT_TITLE</td>
                        <td>@item.DURATION</td>
                        <td>@item.PERIOD</td>
                        <td>@item.PERIOD_TO</td>
                        <td>@item.TYPE_OF_FUNDING</td>
                        <td>@item.FUNDING_AGENCY</td>
                        <td>@item.AMOUNT</td>
                        @*<td>@item.ENTRY_DATE</td>*@




                        <td>
                            <a href="#IQACProject-dialog" onclick="FetchLiIQACProjectById(@item.IQAC_PROJECT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                            <a href="javascrip:;" onclick="GetConfirm(@item.IQAC_PROJECT_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                        </td>
                    </tr>
                }

            }

        </tbody>
    </table>
</div>


<div class="modal" id="IQACProject-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit IQAC Project</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="IQACProject">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">


                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Project  type</label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sIQACProjecttype, (Model.sIQACProjecttype != null) ? Model.sIQACProjecttype : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sIQACProjecttype, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Project  Title</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtProjectTitle" class="form-control" placeholder="Project Tilte" data-parsley-required="true" data-parsley-maxlength = "300" >
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Duration</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtDuration" class="form-control" placeholder="Duration" data-parsley-required="true" data-parsley-maxlength = "80">
                                        </div>
                                    </div>

                                  
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Period From</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtProjectPeriod" class="form-control" placeholder="Period From" data-parsley-required="true" data-parsley-type="number" data-parsley-maxlength = "4">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Period To</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtProjectPeriodTo" class="form-control" placeholder="Period To" data-parsley-required="true" data-parsley-type="number" data-parsley-maxlength="4">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Type of funding </label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sIQACTypeofFunding, (Model.sIQACTypeofFunding != null) ? Model.sIQACTypeofFunding : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.sIQACTypeofFunding, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Funding Agency </label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtfunding" class="form-control" placeholder="Type of funding " data-parsley-required="true" data-parsley-maxlength = "80">
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Amount </label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtAmount" class="form-control" placeholder="Amount " data-parsley-required="true">
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                                        <div class="col-md-9">
                                            <div class="btn btn-primary" onclick="FileClick('ProjectUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                            <input type="file" id="ProjectUpload" class="hidden" multiple="multiple" onchange="LoadFile('ProjectUploadData', 'ProjectUpload')" />
                                        </div>
                                    </div>

                                    <div class="form-group" id="ProjectUploadData">
                                        <div class="form-group col-md-12 table-responsive">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-10">
                                                <table class="table table-bordered table-hover" id="tbl_ProjectUpload">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>File</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbProjectUpload"></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary" >Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="iqacProjectId" value="" />
    </div>
</div>

<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        function FetchLiIQACProjectById(sProjectId)
        {
            //$('#pBody').parsley().destroy();

            if (sProjectId != null)
            {
                $.ajax({
                    url: "/IQAC/FetchProjectById",
                    type:"POST",
                    datatype:'json',
                    data: { sIQACID: sProjectId },
                    success:function(data)
                    {
                        if(data.Message!=null)
                        {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        else {
                            if (data.oResult[0] != null)
                            {
                                $('#txtProjectTitle').attr('value', data.oResult[0].PROJECT_TITLE);
                                $('#txtDuration').attr('value', data.oResult[0].DURATION);
                                $('#txtProjectPeriod').attr('value', data.oResult[0].PERIOD);
                                $('#txtProjectPeriodTo').attr('value', data.oResult[0].PERIOD_TO);
                                $('#txtfunding').attr('value', data.oResult[0].FUNDING_AGENCY);
                                $('#txtAmount').attr('value', data.oResult[0].AMOUNT);
                                $('#sIQACProjecttype option[value="' + data.oResult[0].PROJECT_TYPE + '"]').attr("selected", "selected");
                                $('#sIQACTypeofFunding option[value="' + data.oResult[0].TYPE_OF_FUNDING + '"]').attr("selected", "selected");
                                $('#iqacProjectId').attr('value', data.oResult[0].IQAC_PROJECT_ID);
                                BindFileInfo(data.oResult[0].FILE_PATH, 'tbProjectUpload', 'ProjectUploadData');
                                $('.selectpicker').selectpicker('refresh');
                            }
                        }
                    },
                    error:function(ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            }
        }

        function SaveData() 
        {
            var isValid = true;
            if ($('#IQACProject').parsley().validate() !== true) isValid = false;
            if (!isValid) 
            {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            //for image update
            var ProjectImagePath = '';
            var FilePath = '';
            var fCount = 0;
            var iCount = 0;
            $('#ProjectUploadData').find("table tbody tr").each(function ()
            {
                if ($(this).attr("cms-img-path"))
                {
                    ProjectImagePath += $(this).attr("cms-img-path") + ",";
                    fCount = parseInt(fCount) + 1;
                }
                else
                {
                    if ($(this).attr("id"))
                    {
                        FilePath += $(this).attr("id") + ",";
                        iCount = parseInt(iCount) + 1;
                    }
                }
            });

            if (fCount > 0)
            {
                ProjectImagePath = ProjectImagePath.slice(0, -1);
                ProjectImagePath += '';
                //clearing formdata sJsonData
                if (formData.has('sPhoto'))
                {
                    formData.delete("sPhoto");
                }

                formData.append("sPhoto", ProjectImagePath);
            }
            if (iCount > 0)
            {
                FilePath = FilePath.slice(0, -1);
                FilePath += '';
            }

            var sprojectId = $('#iqacProjectId').val();
            var ProjectType = $('#sIQACProjecttype').val();
            var ProjectTitle = $('#txtProjectTitle').val();
            var Duration = $('#txtDuration').val();
            var Period = $('#txtProjectPeriod').val();
            var PeriodTo = $('#txtProjectPeriodTo').val();
            var TypeOfFunding = $('#sIQACTypeofFunding').val();
            var FundingAgency = $('#txtfunding').val();
            var Amount = $('#txtAmount').val();
         
            if (formData.has('sJsonData')) 
            {
                formData.delete("sJsonData");
            }
            var jsonData = '{"IQAC_PROJECT_ID":"' + sprojectId + '","PROJECT_TYPE":"' + ProjectType + '","PROJECT_TITLE":"' + ProjectTitle + '","DURATION":"' + Duration + '","PERIOD":"'+Period+'","PERIOD_TO":"'+PeriodTo+'","TYPE_OF_FUNDING":"'+TypeOfFunding+'","FUNDING_AGENCY":"'+FundingAgency+'","AMOUNT":"'+Amount+'","FILE_PATH":"'+FilePath+'"}';

            formData.append("sJsonData",jsonData);
              var req=  $.ajax({
                  url: "/IQAC/SaveProject",
                    type: "post",
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.Message != null && data.Message != "")
                        {
                            if (data.ErrorCode == "200")
                            {
                                $('#btnCancel').click();
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                $('#liProject').click();
                            }
                            if (data.ErrorCode == "417") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                            if (data.ErrorCode == "503") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }
                            if (data.ErrorCode == "406") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }

                        }
                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
              });
        }


   


    GetConfirm = function (sProjectId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "/IQAC/DeleteProject",
        type: "post",
        data: { sIQACID: sProjectId },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                $('#liProject').click();
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }

    function Add() {
        nFileCount = 0; nCount = 0;
            //$('#pBody').parsley().destroy();

            $('#txtProjectTitle').attr('value', '');
            $('#txtDuration').attr('value', '');
            $('#txtProjectPeriod').attr('value', '');
            $('#txtProjectPeriodTo').attr('value', '');
            $('#txtfunding').attr('value', '');
            $('#txtAmount').attr('value', '');
            $('#sIQACProjecttype option[value=""]').attr("selected", "selected");
            $('#sIQACTypeofFunding option[value=""]').attr("selected", "selected");           
            $('#iqacProjectId').attr('value', '');
            $('.selectpicker').selectpicker('refresh');
        }
    $(function () {
        $('#IQACProject-dialog').on('hidden.bs.modal', function (e) {
            var entries = formData.entries();
            for(var pair of entries)
            {
                formData.delete(pair[0]);
            }
            nFileCount = 0; nCount = 0;
            $('#txtProjectTitle').attr('value', '');
            $('#txtDuration').attr('value', '');
            $('#txtProjectPeriod').attr('value', '');
            $('#txtProjectPeriodTo').attr('value', '');
            $('#txtfunding').attr('value', '');
            $('#txtAmount').attr('value', '');
            $('#sIQACProjecttype option[value=""]').attr("selected", "selected");
            $('#sIQACTypeofFunding option[value=""]').attr("selected", "selected");           
            $('#iqacProjectId').attr('value', '');
            $('#tbProjectUpload').empty();
            $('.selectpicker').selectpicker('refresh');
        });
    });
        
</script>





