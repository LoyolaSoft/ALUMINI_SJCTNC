@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblIQACProject">
        <thead>
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Project Type</th>
                <th>Project Title</th>
                <th>Duration</th>
                <th>Period From</th>
                <th>Period To</th>
                <th>Type of Funding</th>
                <th>Funding Agency</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tfoot id="tfooter">
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Project Type</th>
                <th>Project Title</th>
                <th>Duration</th>
                <th>Period From</th>
                <th>Period To</th>
                <th>Type of Funding</th>
                <th>Funding Agency</th>
                <th>Amount</th>
            </tr>
        </tfoot>
        <tbody>

            @if (Model.liIQACProject != null && Model.liIQACProject.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liIQACProject)
                {
                    count = count + 1;
                    <tr>
                        <td>@count</td>
                        <td>@item.DEPARTMENT</td>
                        <td>@item.STAFF_CODE</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.PROJECT_TYPE</td>
                        <td>@item.PROJECT_TITLE</td>
                        <td>@item.DURATION</td>
                        <td>@item.PERIOD</td>
                        <td>@item.PERIOD_TO</td>
                        <td>@item.TYPE_OF_FUNDING</td>
                        <td>@item.FUNDING_AGENCY</td>
                        <td>@item.AMOUNT</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>