@model CMS.ViewModel.ViewModel.IQACViewModel



@{
    Layout = null;
    int nCount = 0;
}



<div class="form-horizontal">
    <div class="form-group col-md-12">
        <a class="btn btn-primary text-white pull-right" onclick="AddNewColumn()" href="javascript:;"><i class="fa fa-plus"></i> Click To Add New Row </a>
    </div>

    <div class="form-group col-md-12">
        <table class="table table-bordered" id="tblIQAC">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Dept Code</th>
                    <th>Type Of Project</th>
                    <th>Title Of the Project</th>
                    <th>Duration</th>
                    <th>Funding Agency</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

            @if (Model.liResearchProjects != null && Model.liResearchProjects.Count > 0)
            {
                foreach (var item in Model.liResearchProjects)
                {
                        <tr cms-IQACID="@item.IQAC_ID">
                            <td>@{nCount++;} @nCount</td>
                            <td><input type="text" class="form-control" value="@item.DEPT_CODE" maxlength="10" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="60" value="@item.PROJECT_TYPE" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="300" value="@item.PROJECT_TITLE" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="50" value="@item.DURATION" data-parsley-required="true"/> </td>
                            <td><input type="text" class="form-control" maxlength="50" value="@item.FUNDING_AGENCY" data-parsley-required="true"/> </td>
                            <td><a onclick="GetConfrim(@item.IQAC_ID)" href="javascript:;"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a></td>
                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr cms-IQACID="">
                                        <td>@{nCount++;} @nCount</td>
                                        <td><input type="text" class="form-control" maxlength="10" value="" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="60" value="" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="300" value="" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="50" value="" data-parsley-required="true"/> </td>
                                        <td><input type="text" class="form-control" maxlength="50" value="" data-parsley-required="true"/> </td>
                                        <td></td>
                                    </tr>
                                            }
            </tbody>
        </table>
    </div>
</div>


<input type="hidden" name="name" value="@nCount" id="hdNumber" />

<script>
   
    function AddNewColumn()
    {
        var nCount = 0;
        nCount=$('#hdNumber').val();
        nCount++;
        $('#hdNumber').val(nCount);
        var sDom = '<tr cms-IQACID="">\
                      <td>' + nCount + '</td>\
                      <td><input type="text" class="form-control" value="" maxlength="10" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="60" value="" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="300" value="" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="50" value="" data-parsley-required="true"/></td>\
                      <td><input type="text" class="form-control" maxlength="50" value="" data-parsley-required="true"/></td><td></td>\
                    </tr>';
        $('tbody').append(sDom);
    }

</script>