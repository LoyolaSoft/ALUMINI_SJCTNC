@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}

<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">IQAC  Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">IQAC  Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">IQAC  Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12 form-group">
                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Year</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.sAcademicYearList, (Model.sAcademicYearList != null) ? Model.sAcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sAcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Question</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.sIQACQuestionsList, (Model.sIQACQuestionsList != null) ? Model.sIQACQuestionsList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sIQACQuestionsList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                       @*<div class="col-md-4 form-group">
                            @Html.Label("Month", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                <select class="form-control  selectpicker" data-live-search="true" id="sMonthList">
                                    @if (Model.liMonthList != null && Model.liMonthList.Count > 0)
                                    {
                                        int nCount = 0;
                                        <option value=""> -- Select -- </option>
                                        foreach (var item in Model.liMonthList)
                                        {
                                            nCount++;
                                            <option value="@nCount">@item.DAY_ORDER_MONTH</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>*@

                    </div>
                    
                    <div class="col-md-12 form-group">
                        <div class="col-md-4 form-group">
                            @Html.Label("Semester", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                <select class="form-control  selectpicker" data-live-search="true" id="sSemesterTypeId">
                                    <option value=""> -- Select -- </option>
                                    <option value="1"> Odd Semester </option>
                                    <option value="2"> Even Semester </option>
                                    <option value="3"> Non Semester </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 form-group">
                            <a href="javascript:;" id="btnGet" onclick="GetIQACStatus()" class="btn btn-primary">Get</a>
                        </div>
                        <div class="col-md-2 form-group">
                            <a href="javascript:;" id="btnPrint" onclick="printDiv()" class="btn btn-success">Print</a>
                        </div>
                        <div class="col-md-2 form-group">
                            <a href="javascript:;" id="btnExport" onclick="Export()" class="btn btn-success">Export</a>
                        </div>
                    </div>
                        
                    
                    <div class="col-md-12 form-group">
                        <div id="dvIQACBind"></div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- Hidden Filed -->
@Html.HiddenFor(model=>model.sMessage)
<!-- Hidden Filed -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
    function GetIQACStatus()
    {
        var sStaffId = $('#sMessage').val();
        var Json = '{"STAFF_ID":"' + sStaffId + '","ACADEMIC_YEAR":"' + $('#sAcademicYearList Option:selected').text() + '","QUESTION_ID":"' + $('#sIQACQuestionsList').val() + '","MONTH_ID":"' + $('#sMonthList').val() + '","SEMESTER_TYPE_ID":"' + $('#sSemesterTypeId').val() + '"}';
         $.ajax({
                url: '@Url.Action("BindIQACStatus", "IQAC")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonData: Json },
                success: function (data)
                {
                    $('#dvIQACBind').empty();
                    $('#dvIQACBind').append(data);
                    $('#lblQuestion').text($('#sIQACQuestionsList Option:selected').text());
                    $('#lblMonth').text($('#sMonthList Option:selected').text());
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
    }

    function printDiv()
    {
        var printContents = document.getElementById('dvIQACBind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/IQAC/IQACStatus');
    }


    function Export()
    {
        var title = "";
        var sAcademicYear = $('#sAcademicYearList option:selected').text();
        var Question = $('#sIQACQuestionsList option:selected').text();
        title = Question;
        let file = new Blob([$('#dvIQACBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        //e.preventDefault();
        loadContent('/IQAC/IQACIndividualStatus');
    }
</script>