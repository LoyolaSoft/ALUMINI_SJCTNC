<script>


    var formData = new FormData();
    var Dom = "";

    function readFiles(sourceDiv, focusDiv) {
        var file = document.getElementById('' + sourceDiv + '').files[0];
        // Read first file
        Dom = $('#' + focusDiv + '');
        setup_reader(file, focusDiv);
    }

    function setup_reader(file, focusDiv) {
        //var file = files;

        var name = file.name;
        var reader = new FileReader();
        reader.onloadend = function (e) {

            readerLoaded(e, file, name, focusDiv);
        };
        reader.readAsBinaryString(file);
        // After reading, read the next file.
    }

    function readerLoaded(e, file, name, focusDiv) {
        var _size = file.size;
        var extension = GetFileExtension(file);
        var size = GetFileSize(file);

        var UniqueName;
        var actualKey;
        //var iProgress = GetProgressRate(_size);

        if (size != null && size != '') {
            var actualFileDom;
            UniqueName = GetuniqueNameForFile(file);



            if (extension != null && extension != '') {
                if (extension == 'jpg' || extension == 'png') {


                    actualFileDom = "<li class=''>" +
                                                  "<div class='document-file'>" +
                                                      "<a href='#'>" +
                                                          "<img src=" + window.URL.createObjectURL(file) + "   alt='' cms-update='1' width=77 height=80  height='' cms-sp=" + UniqueName + ">" +
                                                      "</a>" +
                                                  "</div>" +
                                                  "<div class='document-name'><a href='" + window.URL.createObjectURL(file) + "' download>" + name + "</a></div>" +
                                              "</li>";
                    //actualFileDom ="<img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-sp=" + UniqueName + "></img>";
                }
                else {

                    actualFileDom = "<li class=''>" +
                                              "<div class='document-file'>" +
                                              "<a href='#'>" +
                                                  "<i class='fa fa-file'></i>" +
                                              "</a>" +
                                              "</div>" +
                                             "<div class='document-name'><a href='" + window.URL.createObjectURL(file) + "' download  title=" + name + " cms-update='1'>" + name + "</a></div>" +
                                        "</li>";

                    //actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                }

                var result = "<ul class='attached-document clearfix'>" + actualFileDom + "</ul> ";
                var filedom = AppendFileDom(result, name, size, file, UniqueName);
                //formData.append(actualKey, file);
                // Dom.html('');

                Dom.append(filedom);
            }
        }
    }

    function GetFileExtension(file) {
        // Get uploaded file extension
        var extension = file.name.split('.').pop().toLowerCase();
        var validFileExtensions = ['doc', 'docx', 'pdf', 'jpg', 'png', 'txt', 'xlsx'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            alert("Sorry!! Upload only 'doc', 'docx', 'pdf','jpf','png','txt','xlsx' file")
            //$(this).replaceWith($(this).val('').clone(true));
            return extension = null;
        }
        else {
            return extension;
        }
    }

    function GetFileSize(file) {
        var _size = file.size;
        var fileSize = _size;
        var fSExt = new Array('Bytes', 'KB', 'MB', 'GB'),
        i = 0; while (_size > 900) { _size /= 1024; i++; }
        var exactSize = (Math.round(_size * 100) / 100) + ' ' + fSExt[i];

        if (fileSize > 1000000) {
            alert("Sorry!! Max allowed file size is 1 mb");
            // Clear fileuload control selected file
            // $(this).replaceWith($(this).val('').clone(true));
            $('#fAttachment').val('');
            //Dom.find('img').remove();
            return exactSize = null;

        }
        else {
            return exactSize;
        }

    }

    function GetProgressRate(size) {

        var dataTotal = 0;
        // sum up files lengths
        dataTotal = dataTotal + size;
        var iProgress = parseInt((dataTotal / 1000) * 100 / 1024);
        return iProgress;
    }

    function GetuniqueNameForFile(file) {
        var fileName = file.name;
        var File = fileName.split(".");
        var MaxValue = 100;
        var randomValue = Math.floor((Math.random() * parseInt(MaxValue)) + 1);
        var Length = File[0].length;
        var UniqueName = randomString(Length) + randomValue;
        return UniqueName;
    }

    function randomString(Length) {
        var chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXTZabcdefghiklmnopqrstuvwxyz";

        var randomstring = '';
        for (var i = 0; i < Length; i++) {
            var rnum = Math.floor(Math.random() * chars.length);
            randomstring += chars.substring(rnum, rnum + 1);
        }
        return randomstring;
    }

    function AppendFileDom(fileDom, fileName, exactSize, file, uniqueName) {
        var filedom = "<tr id=" + uniqueName + ">" +
                        "<td>" +
                            "<span class='preview'>" + fileDom + "</span>" +
                        "</td>" +
                        "<td>" +
                            "<div>" +
                                "<dl>" +
                                    "<dt class=text-inverse>File Name:</dt>" +
                                    "<dd class=name>" + fileName + "</dd>" +
                                    "<dt class=text-inverse>File Size:</dt>" +
                                    "<dd class=size>" + exactSize + "</dd>" +
                                "</dl>" +
                            "</div>" +
                            "<strong class='error text-danger'></strong>" +
                        "</td>" +
                        "<td nowrap=>" +
                                "<button class='btn btn-default cancel width-100 p-r-20' onclick=FileCancel('" + uniqueName + "')>" +
                                "<i class='fa fa-trash fa-fw pull-left m-t-2 m-r-5 text-muted'></i>" +
                                    "<span>Cancel</span>" +
                                "</button>" +

                        "</td>" +
                    "</tr>";
        formData.append(uniqueName, file);
        return filedom;

    }

    //for update image
    function AppendFileDom1(Data) {

        //
        if (Data != null && Data != "") {
            //
            for (var i = 0; Data.length; i++) {
                var UniqueName = GetuniqueNameForImage(Data[i].FILE_PATH);
                formData.append(UniqueName, Data[i].FILE_PATH);
            }

        }

        var filedom = "<tr id=" + uniqueName + ">" +
                        "<td>" +
                            "<span class='preview'>" + fileDom + "</span>" +
                        "</td>" +
                        "<td>" +
                            "<div>" +
                                "<dl>" +
                                    "<dt class=text-inverse>File Name:</dt>" +
                                    "<dd class=name>" + fileName + "</dd>" +
                                    "<dt class=text-inverse>File Size:</dt>" +
                                    "<dd class=size>" + exactSize + "</dd>" +
                                "</dl>" +
                            "</div>" +
                            "<strong class='error text-danger'></strong>" +
                        "</td>" +
                        "<td>" +
                                "<div class=progress rounded-corner m-b-15>" +
                                    "<div class=progress-bar style='width:" + iProgress + "%;max-width:100;'>" + iProgress + "%</div>" +
                                "</div>" +
                        "</td>" +
                        "<td nowrap=>" +
                                "<button class='btn btn-default cancel width-100 p-r-20' onclick=FileCancel('" + uniqueName + "')>" +
                                "<i class='fa fa-trash fa-fw pull-left m-t-2 m-r-5 text-muted'></i>" +
                                    "<span>Cancel</span>" +
                                "</button>" +

                        "</td>" +
                    "</tr>";
        formData.append(uniqueName, file);
        return filedom;

    }

    function FileCancel(rowId) {
        var row = document.getElementById(rowId);
        formData.delete(rowId);
        row.parentNode.removeChild(row);
    }



</script>





