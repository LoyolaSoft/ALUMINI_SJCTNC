@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}



<div class="table-responsive col-md-12">
    <table class="table table-bordered table-responsive table-hover" id="tblAwards">
        <thead>
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Award Title</th>
                <th>Awarded By</th>
                <th>Level</th>
            </tr>
        </thead>
        <tfoot id="tfooter">
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Award Title</th>
                <th>Awarded By</th>
                <th>Level</th>
            </tr>
        </tfoot>
        <tbody>
            @{
                if (Model.liAwards != null && Model.liAwards.Count > 0)
                {
                    int nCount = 0;
                    foreach (var item in Model.liAwards)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.DEPARTMENT</td>
                            <td>@item.STAFF_CODE</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.AWARD_TITLE</td>
                            <td>@item.AWARDED_BY</td>
                            <td>@item.LEVEL</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>