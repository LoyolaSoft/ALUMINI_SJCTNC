@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
    string sStatus = string.Empty;
}




@if (Model.liLessonPlan != null && Model.liLessonPlan.Count > 0)
{
    <h3 class="text-center"  margin-top:50px">INTERNAL QUALITY ASSURANCE CELL</h3>
    <h4 class="text-center" >@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME , @Model.liCollegeDetails.FirstOrDefault().PLACE </h4>
    <h5 class="text-center" ><u>Lesson Plan</u></h5>
    <h5 class="text-center" >Name Of The Stafff : @Model.liLessonPlan.FirstOrDefault().FIRST_NAME (@Model.liLessonPlan.FirstOrDefault().STAFF_CODE)  &nbsp; Department : @Model.liLessonPlan.FirstOrDefault().DEPARTMENT</h5>
    <h5 class="text-center" >Academic Year : @Model.liLessonPlan.FirstOrDefault().ACADEMIC_YEAR  &nbsp; &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp; <span style="margin-left:80px"> Semester : @Model.liLessonPlan.FirstOrDefault().SEMESTER_ID </span></h5>
    <h5 class="text-center" >Course : @Model.liLessonPlan.FirstOrDefault().COURSE_CODE  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp;  &nbsp; <span style="margin-left:80px"> Subject : @Model.liLessonPlan.FirstOrDefault().COURSE_TITLE </span></h5>


    <div class="form-group col-md-12 table-responsive" style="margin-left:10px">
        <table class="table table-bordered" border="1">
            <thead>
                <tr>
                    <th>Cycle</th>
                    <th>Unit</th>
                    <th>Topic</th>
                    @*<th>Status</th>*@
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.liLessonPlan)
                {
                    <tr>
                        <td>@item.CYCLE</td>
                        <td>@item.UNIT</td>
                        <td>@item.TOPIC</td>
                        @*<td>
                            @if (item.STATUS == "1")
                            {
                                sStatus = "Completed";
                            }
                            else if (item.STATUS == "2")
                            {
                                sStatus = "Partially Completed";
                            }
                            else if (item.STATUS == "3")
                            {
                                sStatus = "Yet to be completed";
                            }
                            @sStatus
                        </td>*@
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-danger">
        No Record(s) Found !!!
    </div>
}


