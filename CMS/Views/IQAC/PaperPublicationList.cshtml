@model CMS.ViewModel.ViewModel.IQACViewModel

@{
    Layout = null;
    int ncount = 0;
}


<div class="col-md-12 table-responsive">
    <div class="form-group col-md-12 pull-right">
        <a class="btn btn-success pull-right" data-toggle="modal" href="#PaperPublication-dialog"><i class="fa fa-plus"></i> Add</a>
    </div> <br />
    <table class="table table-bordered" id="tblIQAC">
        <thead>
            <tr>
                <th>#</th>
                <th>Paper Title</th>
                <th>Name of the Journel</th>
                <th>Year</th>
                <th>Volume</th>
                <th>Issue Number</th>
                <th>Page Number</th>
                <th>ISSN Number</th>
                <th>ISBN Number</th>
                @*<th>Scopus </th>
                    <th>Web of Science </th>
                    <th>UGC Listed </th>
                    <th>Seriol Number </th>*@
                <th>Impact Fact </th>
                <th>Citations </th>
                <th>Citation Index </th>
                <th>Others </th>
                @*<th>Corresponding Author </th>
                    <th>First Author </th>*@
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.liPaperPublication != null && Model.liPaperPublication.Count > 0)
                {
                    foreach (var item in Model.liPaperPublication)
                    {
                        <tr>
                            <td>@{ncount++;} @ncount</td>
                            <td>@item.PAPER_TITLE</td>
                            <td>@item.JOURNEL_NAME</td>
                            <td>@item.PUBLICATION_YEAR</td>
                            <td>@item.PUBLICATION_VOLUME</td>
                            <td>@item.ISSUE_NUMBER</td>
                            <td>@item.PAGE_NUMBER</td>
                            <td>@item.ISSN_NUMBER</td>
                            <td>@item.ISBN_NUMBER</td>
                            @*<td>@item.SCOPUS_ID</td>
                                <td>@item.WEB_OF_SCIENCE</td>
                                <td>@item.UGC_LISTED</td>
                                <td>@item.SERIAL_NUMBER</td>*@
                            <td>@item.IMPACT_FACT</td>
                            <td>@item.CITATIONS</td>
                            <td>@item.CITATION_INDEX</td>
                            <td>@item.OTHERS</td>
                            @*<td>@item.CORRESPONDING_AUTHOR</td>
                                <td>@item.FIRST_AUTHOR</td>*@
                            <td>
                                <a class="text-primary" href="#PaperPublication-dialog" onclick="FetchActivityById(@item.IQAC_PAPER_PUBLICATION_ID)" data-toggle="modal"><i class="fa fa-edit"></i></a>
                                <a class="text-danger" href="javascript:;" onclick="GetConfrim(@item.IQAC_PAPER_PUBLICATION_ID)"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                                    }
                                }
            }
        </tbody>
    </table>
</div>


<div class="modal" id="PaperPublication-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Paper Publication Info</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12" id="dvPaperPublication" data-parsley-validate="true">


                        <div class="form-group">
                            @Html.Label("Paper Title", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtPaperPublicationTitle" data-parsley-required="true" placeholder="Paper Title" data-parsley-maxlength="500" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Name of the Journal", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtJournel" data-parsley-required="true" placeholder="Name of the Journal" data-parsley-maxlength="300" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Year", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtPaperPublicationYear" data-parsley-required="true" placeholder="Year (Number)" data-parsley-type="integer" data-parsley-maxlength="60" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Month List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @*@Html.DropDownListFor(m => m.sMonthList, (Model.sMonthList != null) ? Model.sMonthList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.sMonthList, "", new { @class = "text-danger" })*@

                                <select class="form-control  selectpicker" data-live-search="true" id="sSupMonthList">
                                    @if (Model.liSupMonthList != null && Model.liSupMonthList.Count > 0)
                                    {
                                        <option value=""> -- Select -- </option>
                                        foreach (var item in Model.liSupMonthList)
                                        {
                                            <option value="@item.MONTH_ID">@item.MONTH_NAME</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>


                        <div class="form-group">
                            @Html.Label("Volume", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtVolume" data-parsley-required="true" data-parsley-type="integer" placeholder="Volume (Number)" data-parsley-maxlength="60" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Issue Number", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtIssueNumber" data-parsley-required="true" placeholder="Issue Number (Number)" data-parsley-type="integer" data-parsley-maxlength="15" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("UGC Number(If Applicable)", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtUgcNumber" data-parsley-required="true" placeholder="Issue Number (Number)" data-parsley-type="integer" data-parsley-maxlength="15" />
                            </div>
                        </div>
                        @*<div class="form-group">
                                @Html.Label("Others", htmlAttributes: new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    <select class="selectpicker form-control" id="ddlOthers" >
                                        <option value="">-- Select --</option>
                                        <option value="1"> SCI </option>
                                        <option value="2"> CCSI/SCIE </option>
                                    </select>
                                </div>
                            </div>*@

                        <div class="form-group">
                            @Html.Label("Others", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="Others" id="Others1" value="1" />
                                    <label for="Others1">
                                        SCI
                                    </label>
                                </div>
                                <div class="radio radio-css ">
                                    <input type="radio" name="Others" id="Others2" value="2" />
                                    <label for="Others2">
                                        CCSI/SCIE
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Page Number", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtPageNumber" data-parsley-required="true" placeholder="Page Number" data-parsley-maxlength="15" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("ISSN Number", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtISSNNumber" data-parsley-required="true" placeholder="ISSN Number" data-parsley-maxlength="15" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("ISBN Number", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtISBNNumber" data-parsley-required="true" placeholder="ISBN Number" data-parsley-maxlength="15" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Scopus ", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="Scopus" id="Scopus1" value="1" data-parsley-required="true" />
                                    <label for="Scopus1">
                                        Yes
                                    </label>
                                </div>
                                <div class="radio radio-css ">
                                    <input type="radio" name="Scopus" id="Scopus2" value="2" />
                                    <label for="Scopus2">
                                        No
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Web of Science", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="WebOfScience" id="WebOfScience1" value="1" data-parsley-required="true" />
                                    <label for="WebOfScience1">
                                        Yes
                                    </label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="WebOfScience" id="WebOfScience2" value="2" />
                                    <label for="WebOfScience2">
                                        No
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("UGC Listed", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="UGCListed1" id="UGCListed1" onclick="ShowSericalNumber()" value="1" data-parsley-required="true" />
                                    <label for="UGCListed1">
                                        Yes
                                    </label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="UGCListed1" id="UGCListed2" value="2" onclick="ShowSericalNumber()" />
                                    <label for="UGCListed2">
                                        No
                                    </label>
                                </div>
                            </div>

                        </div>

                        <div class="form-group hidden" id="dvSerialNumber">
                            @Html.Label("Serial Number", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtSerialNumber" placeholder="Serial Number" data-parsley-type="integer" data-parsley-maxlength="15" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Impact Factor", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtImpactFact" data-parsley-required="true" placeholder="Impact Fact" data-parsley-maxlength="60" />
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Citations", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtCitations" data-parsley-required="true" placeholder="No of Citations" data-parsley-maxlength="15" />
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label("Citation Index", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtCitationIndex" data-parsley-required="true" placeholder="Google Sholar/Scoup Us/CROSSREF/Pubmed/wos" data-parsley-maxlength="15" />
                            </div>
                        </div>


                        <div class="form-group">
                            @Html.Label("Corresponding Author", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="CorrespondingAuthor" id="CorrespondingAuthor1" value="1" data-parsley-required="true" />
                                    <label for="CorrespondingAuthor1">
                                        Yes
                                    </label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="CorrespondingAuthor" id="CorrespondingAuthor2" value="2" />
                                    <label for="CorrespondingAuthor2">
                                        No
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("First Author", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="radio radio-css radio-success">
                                    <input type="radio" name="FirstAuthor" id="FirstAuthor1" value="1" data-parsley-required="true" />
                                    <label for="FirstAuthor1">
                                        Yes
                                    </label>
                                </div>
                                <div class="radio radio-css">
                                    <input type="radio" name="FirstAuthor" id="FirstAuthor2" value="2" />
                                    <label for="FirstAuthor2">
                                        No
                                    </label>
                                </div>
                            </div>
                        </div>


                        <div class="form-group">
                            @Html.Label("File Upload", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <div class="btn btn-primary" onclick="FileClick('PaperPublicationUpload')"> <i class="fa fa-plus"></i>  File</div><br />
                                <input type="file" id="PaperPublicationUpload" class="hidden" multiple="multiple" onchange="LoadFile('PaperPublicationUploadData', 'PaperPublicationUpload')" />
                            </div>
                        </div>

                        <div class="form-group" id="PaperPublicationUploadData">
                            <div class="form-group col-md-12 table-responsive">
                                <div class="col-md-1"></div>
                                <div class="col-md-10">
                                    <table class="table table-bordered table-hover" id="tbl_PaperPublicationUpload">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>File</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbPaperPublicationUpload"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a id="btnSubmit" class="btn btn-sm btn-primary" onclick="SubmitData()">Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdPaperPublicationId" />

<script>



    function ShowSericalNumber() {
        if ($('#UGCListed1').is(':checked')) {
            $('#dvSerialNumber').removeClass('hidden');
            $('#txtSerialNumber').attr('data-parsley-required', 'true');
        } else {
            $('#dvSerialNumber').addClass('hidden');
            $('#txtSerialNumber').removeAttr('data-parsley-required');
            $('#txtSerialNumber').val('');
        }
    }
    function SubmitData() {
        if ($('#txtISSNNumber').val()) {
            $('#txtISBNNumber').removeAttr('data-parsley-required');
        } else if ($('#txtISBNNumber').val()) {
            $('#txtISSNNumber').removeAttr('data-parsley-required');
        } else {
            $('#txtISSNNumber').attr('data-parsley-required', 'true');
        }
        var isValid = true;
        if ($('#dvPaperPublication').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }

        var sOthers = 0;
        if ($('#Others1').is(':checked')) {
            sOthers = 1;
        } else if ($('#Others2').is(':checked')) {
            sOthers = 2;
        }

        //for image update
        var PaperPublicationImagePath = '';
        var FilePath = '';
        var fCount = 0;
        var iCount = 0;
        $('#PaperPublicationUploadData').find("table tbody tr").each(function () {
            debugger;
            if ($(this).attr("cms-img-path")) {
                PaperPublicationImagePath += $(this).attr("cms-img-path") + ",";
                fCount = parseInt(fCount) + 1;
            }
            else {
                if ($(this).attr("id")) {
                    FilePath += $(this).attr("id") + ",";
                    iCount = parseInt(iCount) + 1;
                }
            }
        });

        if (fCount > 0) {
            PaperPublicationImagePath = PaperPublicationImagePath.slice(0, -1);
            PaperPublicationImagePath += '';
            //clearing formdata sJsonData
            if (formData.has('sPhoto')) {
                formData.delete("sPhoto");
            }
            formData.append("sPhoto", PaperPublicationImagePath);
        }
        if (iCount > 0) {
            FilePath = FilePath.slice(0, -1);
            FilePath += '';
        }



        var Scope = 0;
        if ($('#Scopus1').is(':checked')) {
            Scope = 1;
        } else if ($('#Scopus2').is(':checked')) {
            Scope = 2;
        }

        var WebOfScience = 0;
        if ($('#WebOfScience1').is(':checked')) {
            WebOfScience = 1;
        } else if ($('#WebOfScience2').is(':checked')) {
            WebOfScience = 2;
        }

        var UGCListed = 0;
        if ($('#UGCListed1').is(':checked')) {
            UGCListed = 1;
        } else if ($('#UGCListed2').is(':checked')) {
            UGCListed = 2;
        }

        var CorrespondingAuthor = 0;
        if ($('#CorrespondingAuthor1').is(':checked')) {
            CorrespondingAuthor = 1;
        } else if ($('#CorrespondingAuthor2').is(':checked')) {
            CorrespondingAuthor = 2;
        }

        var FirstAuthor = 0;
        if ($('#FirstAuthor1').is(':checked')) {
            FirstAuthor = 1;
        } else if ($('#FirstAuthor2').is(':checked')) {
            FirstAuthor = 2;
        }

        if (formData.has('sJsonData')) {
            formData.delete("sJsonData");
        }
        var sJsonData = '{"IQAC_PAPER_PUBLICATION_ID":"' + $('#hdPaperPublicationId').val() + '",\
                          "PAPER_TITLE":"' + $('#txtPaperPublicationTitle').val() + '",\
                          "JOURNEL_NAME":"' + $('#txtJournel').val() + '",\
                          "PUBLICATION_YEAR":"' + $('#txtPaperPublicationYear').val() + '",\
                           "MONTH_ID":"' + $('#sSupMonthList').val() + '",\
                          "PUBLICATION_VOLUME":"' + $('#txtVolume').val() + '",\
                          "ISSUE_NUMBER":"' + $('#txtIssueNumber').val() + '",\
                          "UGC_NUMBER":"' + $('#txtUgcNumber').val() + '",\
                          "OTHERS":"' + sOthers + '",\
                          "PAGE_NUMBER":"' + $('#txtPageNumber').val() + '",\
                          "ISSN_NUMBER":"' + $('#txtISSNNumber').val() + '",\
                          "ISBN_NUMBER":"' + $('#txtISBNNumber').val() + '",\
                          "SCOPUS_ID":"' + Scope + '",\
                          "WEB_OF_SCIENCE":"' + WebOfScience + '",\
                          "UGC_LISTED":"' + UGCListed + '",\
                          "SERIAL_NUMBER":"' + $('#txtSerialNumber').val() + '",\
                          "IMPACT_FACT":"' + $('#txtImpactFact').val() + '",\
                          "CITATIONS":"' + $('#txtCitations').val() + '",\
                          "CITATION_INDEX":"' + $('#txtCitationIndex').val() + '",\
                          "CORRESPONDING_AUTHOR":"' + CorrespondingAuthor + '",\
                          "FIRST_AUTHOR":"' + FirstAuthor + '","FILE_PATH":"' + FilePath + '"}';
        formData.append("sJsonData", sJsonData);

        $.ajax({
            url: '@Url.Action("SavePaperPublication", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    $('#btnCancel').click();
                    $('.modal-backdrop').removeClass('modal-backdrop');
                    $('#liPaperPublication').click();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }



    function FetchActivityById(Id) {
        $.ajax({
            url: '@Url.Action("FetchPaperPublicationById", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sPaperPublicationId: Id },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {
                    $('#hdPaperPublicationId').val(data[0].IQAC_PAPER_PUBLICATION_ID);
                    $('#txtPaperPublicationTitle').val(data[0].PAPER_TITLE);
                    $('#txtJournel').val(data[0].JOURNEL_NAME);
                    $('#txtPaperPublicationYear').val(data[0].PUBLICATION_YEAR);
                    $('#txtVolume').val(data[0].PUBLICATION_VOLUME);
                    $('#txtIssueNumber').val(data[0].ISSUE_NUMBER);
                    $('#txtUgcNumber').val(data[0].UGC_NUMBER);
                    $('#txtPageNumber').val(data[0].PAGE_NUMBER);
                    $('#txtISSNNumber').val(data[0].ISSN_NUMBER);
                    $('#txtISBNNumber').val(data[0].ISBN_NUMBER);
                    $('#txtSerialNumber').val(data[0].SERIAL_NUMBER);
                    $('#txtImpactFact').val(data[0].IMPACT_FACT);
                    $('#txtCitations').val(data[0].CITATIONS);
                    $('#txtCitationIndex').val(data[0].CITATION_INDEX);
				    $('#sSupMonthList').val(data[0].MONTH_ID);
                    BindFileInfo(data[0].FILE_PATH, 'tbPaperPublicationUpload', 'PaperPublicationUploadData');
                    if (data[0].SCOPUS_ID == "1")
                        $('#Scopus1').click();
                    else if (data[0].SCOPUS_ID == "2")
                        $('#Scopus2').click();

                    if (data[0].OTHERS == "1") {
                        $('#Others1').click();
                    } else if (data[0].OTHERS == "2") {
                        $('#Others2').click();
                    }
                    $('.selectpicker').selectpicker('refresh');

                    if (data[0].WEB_OF_SCIENCE == "1")
                        $('#WebOfScience1').click();
                    else if (data[0].WEB_OF_SCIENCE == "2")
                        $('#WebOfScience2').click();

                    if (data[0].UGC_LISTED == "1") {
                        $('#UGCListed1').click();
                        $('#dvSerialNumber').removeClass('hidden');
                        $('#txtSerialNumber').attr('data-parsley-required', 'true');
                    }
                    else if (data[0].UGC_LISTED = "2")
                        $('#UGCListed2').click();

                    if (data[0].CORRESPONDING_AUTHOR == "1")
                        $('#CorrespondingAuthor1').click();
                    else if (data[0].CORRESPONDING_AUTHOR == "2")
                        $('#CorrespondingAuthor2').click();

                    if (data[0].FIRST_AUTHOR == "1")
                        $('#FirstAuthor1').click();
                    else if (data[0].FIRST_AUTHOR == "2")
                        $('#FirstAuthor2').click();
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function GetConfrim(Id) {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("DeletePaperPublication", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sPaperPublicationId: Id, sMonthId: $('#sSupMonthList').val() },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    $('#liPaperPublication').click();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
