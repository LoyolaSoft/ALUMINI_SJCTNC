@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}

<div class="col-md-12 table-responsive">
    <table class="table table-bordered" id="tblIQACPaperPublication">
        <thead>
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Paper Title</th>
                <th>Name of the Journel</th>
                <th>Year</th>
                <th>Volume</th>
                <th>Issue Number</th>
                <th>Page Number</th>
                <th>ISSN Number</th>
                <th>ISBN Number</th>
                <th>Impact Fact </th>
                <th>Citation Index </th>
            </tr>
        </thead>
        <tfoot id="tfooter">
            <tr>
                <th>#</th>
                <th>Department </th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Paper Title</th>
                <th>Name of the Journel</th>
                <th>Year</th>
                <th>Volume</th>
                <th>Issue Number</th>
                <th>Page Number</th>
                <th>ISSN Number</th>
                <th>ISBN Number</th>
                <th>Impact Fact </th>
                <th>Citation Index </th>
            </tr>
        </tfoot>
        <tbody>
            @{
                if (Model.liPaperPublication != null && Model.liPaperPublication.Count > 0)
                {
                    int ncount = 0;
                    foreach (var item in Model.liPaperPublication)
                    {
                        <tr>
                            <td>@{ncount++;} @ncount</td>
                            <td>@item.DEPARTMENT</td>
                            <td>@item.STAFF_CODE</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.PAPER_TITLE</td>
                            <td>@item.JOURNEL_NAME</td>
                            <td>@item.PUBLICATION_YEAR</td>
                            <td>@item.PUBLICATION_VOLUME</td>
                            <td>@item.ISSUE_NUMBER</td>
                            <td>@item.PAGE_NUMBER</td>
                            <td>@item.ISSN_NUMBER</td>
                            <td>@item.ISBN_NUMBER</td>
                            <td>@item.IMPACT_FACT</td>
                            <td>@item.CITATION_INDEX</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>