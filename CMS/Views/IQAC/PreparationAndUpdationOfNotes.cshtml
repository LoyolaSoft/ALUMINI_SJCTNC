@model CMS.ViewModel.ViewModel.IQACViewModel

@{ 
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<style>
    .fileinput-button input {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        opacity: 0;
        -ms-filter: 'alpha(opacity=0)';
        font-size: 200px !important;
        direction: ltr;
        cursor: pointer;
    }

    button, input, optgroup, select, textarea {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
    }

    .btn {
        font-weight: 600;
        line-height: 20px;
        padding: 6px 12px;
        transition: all .1s ease-in-out;
        box-shadow: none !important;
    }

        .btn:not(:disabled):not(.disabled) {
            cursor: pointer;
        }

    .fileinput-button {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .btn, .input-group-addon:focus {
        outline: 0 !important;
    }
</style>
<style type="text/css">
    .attached-document {
        list-style-type: none;
        margin: 15px 0 0;
        padding: 0;
    }

    .bg-white {
        background: #fff !important;
        color: #000 !important;
    }

    .attached-document > li {
        width: 180px;
        float: left;
        background: #fff;
        color: #222;
        font-weight: 600;
        position: relative;
        margin-right: 15px;
        margin-bottom: 15px;
        border: 1px solid #d9dfe5;
    }

    .fa-file:before {
        /*content: "\f15b";*/
    }

    .attached-document > li .document-file {
        height: 70px;
        background: 0 0;
        overflow: hidden;
        text-align: center;
        line-height: 70px;
        font-size: 32px;
        margin: -1px;
    }

    .attached-document > li .document-name {
        padding: 5px 10px;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        background: #f1f3f4;
    }

    .fa-camera:before {
        /*content: "\f030";*/
    }

    z-depth-1, .grievance, nav, .card-panel, .card, .toast, .dropdown-content, .collapsible, .side-nav {
        box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.16), 0 2px 10px 0 rgba(0, 0, 0, 0.12);
    }

    .widget-chat .widget-chat-body {
        padding: 5px;
        background: #f5f5f5;
    }

    .widget-chat .widget-chat-media {
        width: 59px;
        height: 57px;
        /*position: absolute;*/
        bottom: 3px;
        left: 0;
        border-radius: 38px;
        overflow: hidden;
        text-align: center;
        line-height: 38px;
    }

    .widget-chat .with-media .widget-chat-info {
        /*margin-left: 53px;*/
        min-width: 60%;
    }

    .widget-chat .widget-chat-info-container {
        background: #fff;
        /*display: inline-block;*/
        padding: 8px 12px;
        border-radius: 18px;
        position: relative;
        /*color: #fff;*/
    }

    .widget-chat .widget-chat-item {
        color: #000;
        position: relative;
        min-height: 38px;
        padding: 3px 0;
    }

    .widget-chat .widget-chat-name {
        font-weight: 600;
        padding: 5px;
    }

    .text-indigo {
        color: #5856D6 !important;
    }

    .widget-chat .widget-chat-message {
        font-weight: 600;
        color: #222;
        padding: 5px;
    }

    .widget-chat .widget-chat-time {
        position: absolute;
        right: 12px;
        bottom: 8px;
        font-style: italic;
        color: #999;
        font-weight: 500;
        font-size: 11px;
    }
</style>


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">IQAC</a></li>
        <li class="active">Staff Teaching And Learning</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Staff Teaching And Learning<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Staff Teaching And Learning</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-4 form-group">
                            @Html.Label("Semester", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                <select class="selectpicker form-control" id="ddlSemesterType">
                                    <option value=""> -- Select -- </option>
                                    <option value="1"> Odd Semester </option>
                                    <option value="2"> Even Semester </option>
                                    @*<option value="3"> Non Semester </option>*@
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4 form-group">
                            @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.sCourseList, (Model.sCourseList != null) ? Model.sCourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sCourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Month List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @*@Html.DropDownListFor(m => m.sMonthList, (Model.sMonthList != null) ? Model.sMonthList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.sMonthList, "", new { @class = "text-danger" })*@
                                <select class="form-control  selectpicker" data-live-search="true" id="sMonthList">
                                    @if (Model.liMonthList != null && Model.liMonthList.Count > 0)
                                    {
                                        <option value=""> -- Select -- </option>
                                        foreach (var item in Model.liMonthList)
                                        {
                                            <option value="@item.DAY_ID">@item.DAY_ORDER_MONTH</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>


                <div id="dvIQACBind" data-parsley-validate="true"></div>
                
            }
            <div class="col-lg-12">
                <a href="javascript:;" class="btn btn-success hidden" id="btnSubmit">Submit</a>
            </div>
        </div>

    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>

    $('#ddlSemesterType').on('change', function () {
        $('#sCourseList').empty();
        $('#dvIQACBind').empty();
        $.ajax({
            url: '@Url.Action("FetchCourseByStaffAndSemesterType", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sSemesterTypeId: $('#ddlSemesterType').val() },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {
                    $('#sCourseList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $('#sCourseList').on('change', function ()
    {
        if ($('#sCourseList').val() && $('#sMonthList').val())
        {
            BindList();
        }
    });

    $('#sMonthList').on('change', function ()
    {
        if ($('#sCourseList').val() && $('#sMonthList').val())
        {
            BindList();
        }
    });

    function BindList()
    {
        $.ajax({
            url:'@Url.Action("BindPreparationAndUpdationOfNotes", "IQAC")',
            method:'POST',
            datatype:'json',
            data: { sCourseId: $('#sCourseList').val(), sMonthId: $('#sMonthList').val() },
            success: function (data)
            {
                $('#dvIQACBind').empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#dvIQACBind').append(data);
                    $('#btnSubmit').removeClass('hidden');
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }

    $('#btnSubmit').on('click', function ()
    {
        var count = 0;
        var sJsonData = "{liPreparation:[";
        $('#tblIQAC tbody tr').each(function ()
        {
            sJsonData += '{"IQAC_ID":"' + $(this).closest('tr').find('input:eq(0)').attr('cms-IQACID') + '","CLASS_ID":"' + $(this).attr('cms-ClassId') + '","COURSE_ID":"' + $('#sCourseList').val() + '","MONTH_ID":"' + $('#sMonthList').val() + '","TITLE":"' + $(this).closest('tr').find('input:eq(0)').val() + '","AUTHOR":"' + $(this).closest('tr').find('input:eq(1)').val() + '","PUBLICATION":"' + $(this).closest('tr').find('input:eq(2)').val() + '","YEAR_OF_PUBLICATION":"' + $(this).closest('tr').find('input:eq(3)').val() + '","PLACE_OF_LIBRARY":"' + $(this).closest('tr').find('input:eq(4)').val() + '","WEBSITE_REFFERED":"' + $(this).closest('tr').find('input:eq(5)').val() + '","E_RESOURSE_DEVELOPED":"' + $(this).closest('tr').find('input:eq(6)').val() + '"},';
        });

        var filetablecount = $('#tblIQACFileUpload tbody > tr').find("table").length;
        if (parseInt(filetablecount)>0)
        {
            sJsonData.slice(0, -1);
            sJsonData += '],';
            sJsonData += "liUPreparation:[";
        }

        $('#tblIQACFileUpload tbody tr.tblCCStaff').each(function () {
           
            
            var FilePath = "";
            var ImagePath = "";
            var fCount = 0;
            var iCount = 0;

            var classId = $(this).attr('cms-ClassId');
            var IQACId = $(this).closest('tr').find('input:eq(0)').attr('cms-IQACID') != "" && $(this).closest('tr').find('input:eq(0)').attr('cms-IQACID')!=null?$(this).closest('tr').find('input:eq(0)').attr('cms-IQACID'):"";


            if ($(this).find("table"))
            {
                $(this).find("table tbody tr").each(function () {
                    if ($(this).attr("cms-img-path")) {
                        ImagePath += $(this).attr("cms-img-path") + ",";
                        iCount = parseInt(fCount) + 1;
                    }
                    else {
                        if ($(this).attr("id")) {
                            FilePath += $(this).attr("id") + ",";
                            fCount = parseInt(fCount) + 1;
                        }
                    }
                });
            }

           
            if(fCount>0)
            {
                FilePath = FilePath.slice(0, -1);
                FilePath += '';
                sJsonData += '{"IQAC_ID":"' + IQACId + '","CLASS_ID":"' + classId + '","COURSE_ID":"' + $('#sCourseList').val() + '","MONTH_ID":"' + $('#sMonthList').val() + '","FILE_PATH":"' + FilePath + '","IMG_PATH":""},';
                count = parseInt(count) + 1;
            }
            if (iCount > 0) {
                ImagePath = ImagePath.slice(0, -1);
                ImagePath += '';
                sJsonData += '{"IQAC_ID":"' + IQACId + '","CLASS_ID":"' + classId + '","COURSE_ID":"' + $('#sCourseList').val() + '","MONTH_ID":"' + $('#sMonthList').val() + '","FILE_PATH":"","IMG_PATH":"' + ImagePath + '"},';
                count = parseInt(count) + 1;
            }
          
        });
       
            sJsonData.slice(0, -1);
            sJsonData += ']}';
       



        // Validation Check ,...  
        var isValid = true;
        if ($('#dvIQACBind').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        //clearing formdata sJsonData
        if (formData.has('sJsonData'))
        {
            formData.delete("sJsonData");
        }

        formData.append("sJsonData", sJsonData);

        $.ajax({
            url:'@Url.Action("SavePreparationAndUpdationOfNotes", "IQAC")',
            type: "post",
            data: formData,
            contentType: false,
            processData: false,
            datatype: "json",
            success: function (data)
            {
                if (data.ErrorCode=="200")
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    BindList();
                } else
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    function GetConfrim(ID) {
        if (!confirm('Are You Sure To Delete ?')) {
            return false;
        }
        $.ajax({
            url: '@Url.Action("DeletePreparationAndUpdationOfNotes", "IQAC")',
            method: 'POST',
            datatype: 'json',
            data: { sIQACID: ID },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    BindList();
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>