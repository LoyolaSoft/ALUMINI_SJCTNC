@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    Layout = null;
    
}
<hr />
<div id="GuidanceDetails">
    <h2 style="text-align:center;">Mentoring Student List</h2>
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>Roll No</th>
                    <th>Student Name</th>
                    <th>Programme Name</th>
                    <th>Staff Name</th>
                    <th>Batch</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.limentorstulist != null && Model.limentorstulist.Any())
                {
                    foreach (var item in Model.limentorstulist)
                    {
                        <tr>
                            <td> @item.ROLL_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.STAFF_NAME</td>
                            <td>@item.BATCH</td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No data available.</td>
                    </tr>
                }
            </tbody>
        </table>
        
    </div>
</div>
