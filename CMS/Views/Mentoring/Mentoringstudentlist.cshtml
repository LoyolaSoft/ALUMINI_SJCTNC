@model CMS.ViewModel.ViewModel.MentoringViewModel

@{
    ViewBag.Title = "WeekwiseHourWiseReport";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}




<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Mentoring</a></li>
        <li class="active"> Mentoring Student List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Mentoring Student List <small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Mentoring Student List </h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-1 form-group"></div>
                        <div class="col-md-3 form-group">

                            @Html.LabelFor(model => model.Bacthlist, "Batch", htmlAttributes: new { @class = "control-label col-md-2" })

                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Bacthlist, (Model.Bacthlist != null) ? Model.Bacthlist : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.Bacthlist, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-3 form-group">

                            @Html.LabelFor(model => model.Shiftlist, "Shift", htmlAttributes: new { @class = "control-label col-md-2" })

                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Shiftlist, (Model.Shiftlist != null) ? Model.Shiftlist : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.Shiftlist, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-3 form-group">
                            @Html.LabelFor(model => model.liprogramme, "Programme List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.liprogramme, (Model.liprogramme != null) ? Model.liprogramme : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.liprogramme, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-2 form-group">
                            <button class="btn btn-primary pull-right" id="btnGet"> Get </button>
                        </div>
                        <div class="col-md-2 form-group">
                            <button class="btn btn-primary pull-right" id="btnsumbitted"> Sumbit </button>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div id="dvAttendanceReport">

                    </div>

                </div>
                @*<div class="col-md-2 form-group>

                    </div>*@
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        // $('.selectpicker').selectpicker('refresh');
        $("#txtDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });

    $('#Shiftlist').on('change', function ()
{


        if ($('#Shiftlist').val(), $('#Bacthlist'))
{
    $.ajax({
        url: '@Url.Action("Fetchprogrammeidbyshiftid", "Mentoring")',
        method: 'POST',
        datatype: 'json',
        data: {
            sShift: $('#Shiftlist').val(),
            sBatch: $('#Bacthlist').val(),
        },
        success: function (data)
        {
            $('#liprogramme').empty();
            if (data.Message != null && data.Message != '')
            {
                alert(data.Message);
            } else
            {
                $('#liprogramme').append(data.sResult);
                $('.selectpicker').selectpicker('refresh');
            }
        }, error: function (error)
        {
            alert('Internal Server Error !');
        }
    });
        }
    });

    $('#btnGet').on('click', function ()
    {
       debugger;
        if ($('#Bacthlist').val()
            && $("#Shiftlist").val())
    {
        $.ajax({
            url:'@Url.Action("BindStudentlistforstaff", "Mentoring")',
            method: 'POST',
            datatype:'json',
            data: {
                sShift: $('#Shiftlist').val(),
                sBatch: $('#Bacthlist').val(),
                sProgramme: $('#liprogramme').val()
            },
            success: function (data)
            {
                $('#dvAttendanceReport').empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#dvAttendanceReport').append(data);
                    $('#btnsumbitted').removeClass('hidden');
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    } else {
        alert('Please Select All The Fileds');
    }
    });





