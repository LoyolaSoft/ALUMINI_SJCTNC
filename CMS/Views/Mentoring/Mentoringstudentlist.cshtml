    $('#btnsumbitted').on('click', function ()
{
        debugger;
        var BATCH_LIST = $('#Bacthlist').val();
        var STUDENT_ID = $('#studentid').val();
        var CLASS_ID = $('#class_Id').val();
        var MENTORINT_ID = $('#menterid').val();
        var jsonData = '{"BATCH_LIST":"' + BATCH_LIST + '","STUDENT_ID":"' + STUDENT_ID + '","CLASS_ID":"' + CLASS_ID + '","MENTORINT_ID":"' + MENTORINT_ID + '"}';
     var req=  $.ajax({
         url: "/Mentoring/SaveStudentListforMentoring",
        type: "post",
        data: { sJsonData: jsonData },
        success: function (data) {

            if (data.ErrorCode == "200")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
               // loadContent('/Library/Rules');
            }
            if (data.ErrorCode == "417") {
                swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
            if (data.ErrorCode == "503" || data.ErrorCode == "208") {
                swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
            }



        },
        error: function (ex) {
            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
   });
});

</script>


