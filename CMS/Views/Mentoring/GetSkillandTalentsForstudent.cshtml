@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    Layout = null;
    int n = 0;
}

<input type="hidden" id="STUDENT_ID" value="@ViewBag.StudentId" />

<div class="container mt-3">
    <h4 class="text-center mb-3"><b>Skill And Talents</b></h4>

    <div class="text-right mb-2">
        <button class="btn btn-success btn-sm"
                id="btnOpenAddSkill"
                data-toggle="modal"
                data-target="#skillModal">
            <i class="fa fa-plus"></i> Add Skill
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover" id="tblSkills">
            <thead class="text-center">
                <tr>
                    <th>S.No</th>
                    <th>Semester</th>
                    <th>Skill</th>
                    <th width="100">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.liSkillAndTalents != null && Model.liSkillAndTalents.Any())
                {
                    foreach (var item in Model.liSkillAndTalents)
                    {
                        n++;
                        <tr>
                            <td class="text-center">@n</td>
                            <td class="text-center">@item.SEMESTER_NAME</td>
                            <td>@item.SKILLS</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-xs skill-edit"
                                        data-id="@item.SKILLS_AND_TALENTS_ID">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-xs skill-delete"
                                        data-id="@item.SKILLS_AND_TALENTS_ID">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="skillModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="skillModalTitle">Add Skill</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="SKILL_RECORD_ID" />

                <div class="form-group">
                    <label>Semester <span class="text-danger">*</span></label>
                    @Html.DropDownList(
                        "SKILL_SEMESTER_ID",
                        Model.SemesterList,
                        "-- Select --",
                        new { @class = "form-control", id = "SKILL_SEMESTER_ID" }
                    )
                </div>

                <div class="form-group">
                    <label>Skill <span class="text-danger">*</span></label>
                    <input type="text" id="SKILL_NAME_INPUT" class="form-control" />
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveSkill">Save</button>
                <button class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Initialize DataTable
        if (!$.fn.DataTable.isDataTable('#tblSkills')) {
            $('#tblSkills').DataTable({
                "pageLength": 10,
                "ordering": true,
                "searching": true
            });
        }

        // ADD - Clear Form
        $('#btnOpenAddSkill').click(function () {
            $('#skillModalTitle').text('Add Skill');
            $('#SKILL_RECORD_ID').val('');
            $('#SKILL_SEMESTER_ID').val('');
            $('#SKILL_NAME_INPUT').val('');
        });

        // EDIT - Load Data via AJAX
        $('#tblSkills').on('click', '.skill-edit', function () {
            var id = $(this).data('id');
            $('#skillModalTitle').text('Edit Skill');

            $.get('@Url.Action("GetSkillById","Mentoring")', { id: id }, function (res) {
                if (res) {
                        $('#SKILL_RECORD_ID').val(res.SKILLS_AND_TALENTS_ID);
                        $('#SKILL_SEMESTER_ID').val(res.SEMESTER_ID);
                        $('#SKILL_NAME_INPUT').val(res.SKILLS);
                        $('#skillModal').modal('show');
                } else {
                        swal('Error', 'Unable to load details', 'error');
                }
            }).fail(function () {
                swal('Error', 'Server error', 'error');
            });
        });

        // SAVE / UPDATE
        $('#btnSaveSkill').click(function () {

            var semId = $('#SKILL_SEMESTER_ID').val();
            var semName = $('#SKILL_SEMESTER_ID option:selected').text();

            var data = {
                SKILLS_AND_TALENTS_ID: $('#SKILL_RECORD_ID').val(),
                STUDENT_ID: $('#STUDENT_ID').val(),
                SEMESTER_ID: semId,
                SEMESTER_NAME: semName,
                SKILLS: $('#SKILL_NAME_INPUT').val()
            };

            if (!data.SEMESTER_ID || !data.SKILLS) {
                swal('Warning', 'Semester and Skill are required', 'warning');
                return;
            }

            $.post('@Url.Action("SaveSkillAndTalents","Mentoring")', data, function (res) {
                if (res && res.success !== false) {
                    $('#skillModal').modal('hide');
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open');

                    swal('Success', res.message || 'Saved successfully', 'success');

                    setTimeout(function () {
                        if (typeof BindSkillsandTalents === 'function') {
                            BindSkillsandTalents();
                        } else {
                            $('#stuSkillTalents').click();
                        }
                    }, 300);
                } else {
                    swal('Error', res.message || 'Error occurred', 'error');
                }
            }).fail(function () {
                swal('Error', 'Server error', 'error');
            });
        });

        // DELETE
        $('#tblSkills').on('click', '.skill-delete', function () {
            var id = $(this).data('id');

            swal({
                title: 'Delete this skill?',
                type: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }, function (isConfirm) {
                if (isConfirm) {
                    $.post('@Url.Action("DeleteSkill","Mentoring")', { id: id }, function (res) {
                        if (res.success) {
                            swal('Deleted', 'Skill removed successfully', 'success');
                            setTimeout(function () {
                                if (typeof BindSkillsandTalents === 'function') {
                                    BindSkillsandTalents();
                                } else {
                                    $('#stuSkillTalents').click();
                                }
                            }, 300);
                        } else {
                             swal('Error', res.message || 'Failed to delete', 'error');
                        }
                    }).fail(function () {
                        swal('Error', 'Server error', 'error');
                    });
                }
            });
        });

    });
</script>
