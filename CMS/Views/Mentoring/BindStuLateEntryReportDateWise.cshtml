
@{
    int count = 0;
}
@if (Model.liStuLateFee != null && Model.liStuLateFee.Count > 0)
{
    @*<input type="hidden" id="STUDENT_ID" value="@ViewBag.StudentId" />*@
    @*<div class="alignRight">
        <div class="form-group col-md-1">
            <a class="btn btn-success" id="" onclick="printDiv('printmethandUnit')">Print</a>
        </div>
        
    </div>*@
    <div id="printmethandUnit">
        
        <br />
        <hr />
        <div class="form-horizontal">
            <div class="form-group col-md-12">
                <table class="table table-bordered table-hover" id="tbltpmReport">
                    <thead>
                        <tr>
                            <th><b>#</b></th>
                            <th><b>Entry Date</b></th>
                            <th><b>Time</b></th>
                            <th><b>Roll No</b></th>
                            <th><b>Student Name</b></th>
                            <th><b>Class </b></th>
                            @*<th><b>Class Code</b></th>*@
                            <th><b>Stu Mobile</b></th>
                            <th><b>Father Mobile</b></th>
                       
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var items in Model.liStuLateFee)
                        {
                            count++;

                            <tr>
                                <td>@count</td>
                                <td>@items.ENTRY_DATE</td>
                                <td>@items.ENTRY_TIME</td>
                                <td>@items.ROLL_NO</td>
                                <td>@items.FIRST_NAME</td>
                                <td>@items.CLASS_NAME</td>
                                @*<td>@items.CLASS_CODE</td>*@

                                <td>
                                    @items.STU_MOBILENO
                                </td>
                                <td>
                                    @items.FR_MOBILE
                                </td>
                                
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

}
else
{
    <div class="bg-danger text-center">
        <h3>No Records Found</h3>
    </div>
}
