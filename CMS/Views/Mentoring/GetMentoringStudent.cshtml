@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    ViewBag.Title = "GetMentoringStudent";
}

<div class="panel panel-default">
    <div class="panel-body">
        <div id="">
            <form id="editmentorvisist">
                @if (Model.liVisitedStudentdet != null && Model.liVisitedStudentdet.Count > 0)
                {
                    foreach (var item in Model.liVisitedStudentdet)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="rollNo">Roll No</label>
                                    <input type="text" class="form-control" id="rollNo" name="ROLL_NO" value="@item.ROLL_NO" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="firstName">Name</label>
                                    <input type="text" class="form-control" id="firstName" name="FIRST_NAME" value="@item.FIRST_NAME" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="classCode">Class</label>
                                    <input type="text" class="form-control" id="classCode" name="classCode" value="@item.CLASS_CODE" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="natureOfVisit">Nature Of Visit</label>
                                    <input type="text" class="form-control" id="natureOfVisit" name="natureOfVisit" value="@item.NATURE_OF_VISIT" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="initialContactVisit">Initial Contact Visit</label>
                                    <input type="text" class="form-control" id="initialContactVisit" name="INITIAL_CONTACT_VISIT" value="@item.INITIAL_CONTACT_VISIT" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="visitDate">Visit Date</label>
                                    <input type="date" class="form-control" id="visitDate" name="VISIT_DATE"
                                           value="@(!string.IsNullOrEmpty(item.VISIT_DATE) ? DateTime.Parse(item.VISIT_DATE).ToString("yyyy-MM-dd") : "")" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="visitTime">Visit Time</label>
                                    <input type="text" class="form-control" id="visitTime" name="VISIT_TIME" value="@item.VISIT_TIME" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="visitDuration">Visit Duration</label>
                                    <input type="text" class="form-control" id="visitDuration" name="VISIT_DURATION" value="@item.VISIT_DURATION" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="matterDiscussed">Matter Discussed</label>
                                    <input type="text" class="form-control" id="matterDiscussed" name="MATTER_DISCUSSED" value="@item.MATTER_DISCUSSED" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="conclusionArrivedAt">Conclusion Arrived At</label>
                                    <input type="text" class="form-control" id="conclusionArrivedAt" name="CONCULATION_ARRIVED_AT" value="@item.CONCLUSION_ARRIVED_AT" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="actionTaken">Action Taken</label>
                                    <input type="text" class="form-control" id="actionTaken" name="ACTION_TAKEN" value="@item.ACTION_TAKEN" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="generalImpression">General Impression</label>
                                    <input type="text" class="form-control" id="generalImpression" name="GENERAL_IMPRESSION" value="@item.GENERAL_IMPRESSION" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="dateOfNextVisit">Date of Next Visit</label>
                                    <input type="date" class="form-control" id="dateOfNextVisit" name="DATE_OF_NEXT_VISIT"
                                           value="@(!string.IsNullOrEmpty(item.DATE_OF_NEXT_VISIT) ? DateTime.Parse(item.DATE_OF_NEXT_VISIT).ToString("yyyy-MM-dd") : "")" />
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="STUDENT_ID" id="STUDENT_ID" value="@item.STUDENT_ID" />
                    }
                }

            </form>

        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        var dateValue = $('#dateOfNextVisit').val();
        if (dateValue) {
            var formattedDate = new Date(dateValue);
            var dd = String(formattedDate.getDate()).padStart(2, '0');
            var mm = String(formattedDate.getMonth() + 1).padStart(2, '0');
            var yyyy = formattedDate.getFullYear();
            var customFormattedDate = dd + '-' + mm + '-' + yyyy;
            console.log(customFormattedDate);
        }
    });

</script>