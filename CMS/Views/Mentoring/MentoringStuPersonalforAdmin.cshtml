<script>


    function ContentLoad() {
        handleDatepicker = function () {
            "use strict";
            $("#txtDateFrom,#txtDateTo").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            })
        }
        handleDatepicker();
    };

    var stuid = 0;
