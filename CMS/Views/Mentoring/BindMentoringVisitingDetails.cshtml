@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    ViewBag.Title = "BindMentoringVisitingDetails";
    Layout = null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<div class="panel panel-default">
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered" id="tbladmin">
                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Roll No</th>
                        <th>Name</th>
                        <th>Class</th>
                        <th>Nature Of Visit</th>
                        <th>Initial Contact Visit</th>
                        <th>Visit Date</th>
                        <th>Visit Time</th>
                        <th>Visit Duration</th>
                        <th>Matter Discussed</th>
                        <th>Conclusion Arrived</th>
                        <th>Action Taken</th>
                        <th>General Impression</th>
                        <th>Next Visit Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.liVisitedStudentdet != null && Model.liVisitedStudentdet.Any())
                    {
                        var student = Model.liVisitedStudentdet.FirstOrDefault();
                        int count = 0;
                        foreach (var item in Model.liVisitedStudentdet)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>@item.ROLL_NO</td>
                                <td>@item.FIRST_NAME</td>
                                <td>@item.CLASS_CODE</td>
                                <td>@item.NATURE_OF_VISIT</td>
                                <td>@item.INITIAL_CONTACT_VISIT</td>
                                <td>@item.VISIT_DATE</td>
                                <td>@item.VISIT_TIME</td>
                                <td>@item.VISIT_DURATION</td>
                                <td>@item.MATTER_DISCUSSED</td>
                                <td>@item.CONCLUSION_ARRIVED_AT</td>
                                <td>@item.ACTION_TAKEN</td>
                                <td>@item.GENERAL_IMPRESSION</td>
                                <td>@item.DATE_OF_NEXT_VISIT</td>
                                <td>
                                    <a href="#modalmentor" data-toggle="modal" onclick="openEditModal('@item.STUDENT_ID')" title="Click To Edit">
                                        <i class="fa fa-edit text-primary"></i>
                                    </a>

                                    <a href="#" onclick="GetConfirm('@item.STUDENT_ID', '@item.ROLL_NO')" title="Click To Delete"><i class="fa fa-trash text-danger"></i></a>
                                </td>

                            </tr>

                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="15" class="text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalmentor" tabindex="-1" role="dialog" aria-labelledby="editStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit </h4>
            </div>
            <div class="modal-body" id="mentorvisitedit">

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitEvent" class="btn btn-sm btn-primary" data-dismiss="modal">Update</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

   function openEditModal(studentId) {
    debugger;
    $.ajax({
        url: '@Url.Action("GetMentoringStudent", "Mentoring")',
        type: 'GET',
        dataType:'html',
        data: { studentId: studentId },
        success: function (data) {
           // console.log("AJAX Response:", data);
            debugger
            if (data) {
                $('#mentorvisitedit').html(data); 
                $('#modalmentor').modal('show');
            } else {
                alert('No data found for the provided student ID.');
            }
        },
        error: function (xhr, status, error) {
            debugger
          //  console.error('AJAX Error:', status, error);
            alert('An error occurred: ' + error);
        }
    });
}


    function GetConfirm(studentId) {
        debugger
        Swal.fire({
            title: 'Are you sure?',
            text: `You are about to delete the student`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {

                $.ajax({
                    url: "@Url.Action("DeleteMentorDetails", "Mentoring")",
                    type: 'POST',
                    data: { studentId: studentId },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire(
                                'Deleted!',
                                response.message,
                                'success'
                            );

                            location.reload();
                        } else {
                            Swal.fire(
                                'Error!',
                                response.message,
                                'error'
                            );
                        }
                    },
                    error: function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while processing the request.',
                            'error'
                        );
                    }
                });
            }
        },2000);
    }

    $('#btnSubmitEvent').click(function () {
    var formData = $('#editmentorvisist').serialize();

    $.ajax({
        url: '@Url.Action("UpdateMentroingVisitDet", "Mentoring")',
        type: 'POST',
        data: formData,
        success: function (response) {
            if (response.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Update successful',
                    text: response.message || 'The operation was successful.',
                    confirmButtonText: 'OK'
                });
                $('#modalStudent').modal('hide');
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Update failed',
                    text: response.errorMessage || 'Something went wrong.',
                    confirmButtonText: 'Try Again'
                });
            }
        },
        error: function (xhr, status, error) {
            Swal.fire({
                icon: 'error',
                title: 'An error occurred',
                text: error,
                confirmButtonText: 'OK'
            });
        }
    });
    });
   
</script>
