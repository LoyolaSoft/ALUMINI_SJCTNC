            $("#anotherreport").hide(); // Hide the first div
            $("#mentoringstudentlsit").show(); // Show the second div
        });

        // When #backtoreport is clicked, revert the divs
        $("#backtoreport").click(function () {
            $("#mentoringstudentlsit").hide(); // Hide the second div
            $("#anotherreport").show(); // Show the first div
        });
    });

</script>

