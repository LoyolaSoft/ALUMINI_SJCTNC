<script>
    /* ==========================================================
       GLOBAL VARIABLES
    ========================================================== */
    var selectedStudentId = @Session[Common.SESSION_VARIABLES.USER_ID];

    /* ==========================================================
       DOCUMENT READY
    ========================================================== */
    $(document).ready(function () {


        //$("#studetailsbtn").trigger("click");
        // Disable all tabs initially
        $('.nav-tabs a').addClass('disabled');

        // Hide mentoring student list initially
        $("#mentoringstudentlsit").hide();
    });

    /* ==========================================================
       COMMON CHECK FUNCTION
    ========================================================== */
    function isStudentSelected() {
        if (!selectedStudentId) {
            alert('Please select a student and click GET first');
            return false;
        }
        return true;
    }

    /* ==========================================================
       GET BUTTON → LOAD PERSONAL DETAILS
    ========================================================== */
    $('#studetailsbtn').on('click', function () {

        var studentId = selectedStudentId;

        if (!studentId) {
            alert('Please select a student');
            return;
        }

        // Store globally
        selectedStudentId = studentId;

        $.ajax({
            url: '@Url.Action("GetPersonaldetForStudent", "Mentoring")',
            type: 'POST',
            data: { studentId: selectedStudentId },
            success: function (data) {

                $('#studentlistreport').html(data);

                // Enable tabs after GET
                $('.nav-tabs a').removeClass('disabled');

                // Activate Personal Details tab
                $('#studetailsbtn').tab('show');
            },
            error: function () {
                alert('Internal Server Error');
            }
        });
    });


    $('#OverallMentorAssessment').on('click', function ()
{
       $.ajax({
           url: '@Url.Action("GetOverallMentorAssessment", "Mentoring")',
           method: 'POST',
           datatype:'json',
           data: {
               studentId: selectedStudentId
           },
           success: function (data)
           {
               $('#semesterwiseoverallassessment').empty();
               if (data.Message != null && data.Message != '')
               {
                   alert(data.Message);
               } else
               {
                   $('#semesterwiseoverallassessment').append(data);


               }
           }, error: function (error)
           {
               alert('Internal Server Error !');
           }
       });

});
    $('#NewOverallMentorAssessment').on('click', function ()
{
       $.ajax({
           url: '@Url.Action("GetNewOverallMentorAssessment", "Mentoring")',
           method: 'POST',
           datatype:'json',
           data: {
               studentId: selectedStudentId
           },
           success: function (data)
           {
               $('#Newsemesterwiseoverallassessment').empty();
               if (data.Message != null && data.Message != '')
               {
                   alert(data.Message);
               } else
               {
                   $('#Newsemesterwiseoverallassessment').append(data);


               }
           }, error: function (error)
           {
               alert('Internal Server Error !');
           }
       });

});
