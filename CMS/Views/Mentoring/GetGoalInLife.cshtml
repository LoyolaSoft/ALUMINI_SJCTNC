@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    Layout = null;
}

<style>
/* ================================
   Scoped Styles for Goal Form
================================ */
#goalDetailsForm {
    max-width: 760px;
    margin: 30px auto;
    font-family: inherit;
}

#goalDetailsForm .goal-box {
    background: #f8f9fa;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 25px;
}

#goalDetailsForm .goal-box h4 {
    font-weight: 600;
    margin-bottom: 20px;
    color: #2c3e50;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 8px;
}

#goalDetailsForm .form-group {
    margin-bottom: 18px;
}

#goalDetailsForm .form-group label {
    font-weight: 600;
    margin-bottom: 6px;
    display: block;
}

#goalDetailsForm .form-group input,
#goalDetailsForm .form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
    transition: all 0.2s;
    background-color: #fff;
}

#goalDetailsForm .form-group input:focus,
#goalDetailsForm .form-group textarea:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
    outline: none;
}

#goalDetailsForm .text-end {
    text-align: right;
}

#goalDetailsForm .btn-save {
    padding: 8px 28px;
    background-color: #28a745;
    color: #fff;
    border: none;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.25s ease;
}

#goalDetailsForm .btn-save:hover {
    background-color: #218838;
}

/* Responsive */
@@media (max-width: 576px) {
    #goalDetailsForm .form-group input,
    #goalDetailsForm .form-group textarea {
        font-size: 13px;
    }
}
</style>

<div class="container">
    <form id="goalDetailsForm">
        <input type="hidden" name="STUDENT_ID" value="@ViewBag.StudentId" />

        <div class="goal-box">
            <h4>🎯 Goal in Life</h4>

            @if (Model.liGoalInLife != null && Model.liGoalInLife.Any())
            {
                var item = Model.liGoalInLife.First();
                <input type="hidden" name="GOAL_ID" value="@item.GOAL_ID" />

                <div class="form-group">
                    <label>Goal in Life</label>
                    <textarea name="GOAL_IN_LIFE">@item.GOAL_IN_LIFE</textarea>
                </div>

                <div class="form-group">
                    <label>Your Strength</label>
                    <textarea name="STRENGTH">@item.STRENGTH</textarea>
                </div>

                <div class="form-group">
                    <label>Your Weakness</label>
                    <textarea name="WEAKNESS">@item.WEAKNESS</textarea>
                </div>

                <div class="form-group">
                    <label>Your Role Model</label>
                    <input type="text" name="ROLE_MODEL" value="@item.ROLE_MODEL" />
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Goal in Life</label>
                    <textarea name="GOAL_IN_LIFE"></textarea>
                </div>

                <div class="form-group">
                    <label>Your Strength</label>
                    <textarea name="STRENGTH"></textarea>
                </div>

                <div class="form-group">
                    <label>Your Weakness</label>
                    <textarea name="WEAKNESS"></textarea>
                </div>

                <div class="form-group">
                    <label>Your Role Model</label>
                    <input type="text" name="ROLE_MODEL" />
                </div>
            }

            <div class="text-end">
                <button type="submit" class="btn-save btn btn-success">
                    <i class="fa fa-save"></i> Save Details
                </button>
            </div>
        </div>
    </form>
</div>

<script>
$(document).ready(function() {
    $('#goalDetailsForm').on('submit', function (e) {
        e.preventDefault();

        $.ajax({
            url: '@Url.Action("SaveGoalInLife", "Mentoring")',
            type: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                if (res && res.success !== false) {
                    swal('Success', res.message || 'Details saved successfully', 'success');
                } else {
                    swal('Error', res.message || 'Failed to save data', 'error');
                }
            },
            error: function () {
                swal('Error', 'Failed to save data', 'error');
            }
        });
    });
});
</script>