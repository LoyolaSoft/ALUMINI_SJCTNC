@model CMS.ViewModel.ViewModel.MentoringViewModel

@{
    ViewBag.Title = "BindStudentlistforstaff";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<style>
    .table thead th {
        background-color: #007bff !important;
        color: white !important;
        text-align: center;
    }

    .present {
        background-color: #d1ecf1 !important;
        color: #0c5460 !important;
    }

    .absent {
        background-color: #f8d7da !important;
        color: #721c24 !important;
    }

    .chart-container {
        position: relative;
        margin: auto;
        height: 200px !important;
        width: 200px !important;
    }

    .list-group-item {
        font-size: 1.2rem !important;
        padding: 15px !important;
    }

    .bg-success {
        background-color: #28a745 !important;
    }

    .text-white {
        color: white !important;
    }

    body {
        font-family: 'Roboto', sans-serif;
        margin: 0;
        padding: 20px;
    }

    .attendance-table {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        border-collapse: collapse;
    }

        .attendance-table th, .attendance-table td {
            text-align: left;
            padding: 10px;
        }

        .attendance-table td {
            border-bottom: 1px solid #ddd;
        }

    .lab {
        font-weight: 500 !important;
    }

    .val {
        text-align: right !important;
    }

    .note {
        font-size: 0.9rem;
        color: gray;
    }

    .attendance-status {
        text-align: center;
        margin-top: 20px;
        padding: 15px;
        font-size: 1.2rem;
        font-weight: bold;
        color: white;
        background-color: #28a745;
        border-radius: 5px;
    }

    .satisfactory {
        background-color: #28a745;
    }

    .good {
        background-color: #ffc107;
    }

    .poor {
        background-color: #dc3545;
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content">

    <div class="panel panel-primary" id="panel">
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">

                <table class="table table-bordered text-center">
                    <thead>

                        <tr class="text-center">
                            <th>Select List</th>
                            <th>Roll No</th>
                            <th>Name</th>
                            <th>Class Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item1 in Model.listudentlist)
                        {

                            if (item1 != null)
                            {
                                <tr>

                                    <td>
                                        <input type="checkbox" class="studentCheckbox" value="@item1.STUDENT_ID">
                                    </td>
                                    <!-- Hidden input to store selected IDs -->
                                    <input type="hidden" id="studentid">
                                    <td>@item1.ROLL_NO</td>
                                    <td>@item1.FIRST_NAME</td>

                                    <td>@item1.CLASS_NAME</td>
                                    <input type="hidden" id="menterid" value="@item1.MENTORINT_ID" />
                                    <input type="hidden" id="class_Id" value="@item1.CLASS_ID" />

                                </tr>
                            }
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>

</div>


<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    $(document).on('change', '.studentCheckbox', function () {
        let selectedIds = [];

      
        $('.studentCheckbox:checked').each(function () {
            selectedIds.push($(this).val());
        });

        
        $('#studentid').val(selectedIds.join(','));

      
    });


</script>



