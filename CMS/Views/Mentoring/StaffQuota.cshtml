@model CMS.ViewModel.ViewModel.AttendanceViewModel
@{
    ViewBag.Title = "StaffQuota";
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Staff</a></li>
        <li class="active">Staff Quota</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Staff Quota <small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Staff Quata</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">
                <div class="col-md-4 form-group">

                    @Html.LabelFor(model => model.DepartmentList, "Department", htmlAttributes: new { @class = "control-label col-md-4" })

                    <div class="col-md-8">
                        @Html.DropDownListFor(m => m.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", size = "5" })
                        @Html.ValidationMessageFor(m => m.DepartmentList, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 form-group">
                    @Html.LabelFor(model => model.StaffListDDL, "Faculty Name", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(m => m.StaffListDDL, (Model.StaffListDDL != null) ? Model.StaffListDDL : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true",size = "5" })
                        @Html.ValidationMessageFor(m => m.StaffListDDL, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-4 form-group">
                    <button class="btn btn-primary" id="btnGet"> Get </button>
                </div>

                <div class="form-group col-md-12">
                    <div id="dvStafftable"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
        $("#txtDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
    }
      
        $('#DepartmentList').on('change', function () {
            var departmentId = $(this).val();

    if (departmentId) {
        $.ajax({
            url: "@Url.Action("FetchStaffByDepartmentId", "Attendance")",
            method: 'POST',
            dataType: 'json',
            data: { sDepartmentId: departmentId.toString() },
            success: function (data) {
                var staffDropdown = $('#StaffListDDL');
                staffDropdown.empty();
                staffDropdown.append('<option value="">-- Select --</option>');

                if (data.ErrorCode === "200") {
                    debugger;
                    staffDropdown.append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                } else {
                    alert(data.Message);
                }
            },
            error: function () {
                alert('Internal Server Error!');
            }
        });
            }
        });




        $('#btnGet').on('click', function ()
        {
            
                $.ajax({
                    url:"@Url.Action("BindStaffforMentoringQuota", "Mentoring")",
                    method:'POST',
                    datatype: 'json',
                    data: {  sDeptids: $('#DepartmentList').val().toString(), sStaffids: $('#StaffListDDL').val().toString() }, 
                    success:function (data)
                    {
                        $('#dvStafftable').empty();
                        if (data.Message!=null && data.Message!='')
                        {
                            alert(data.Message);
                        }else
                        {
                            $('#dvStafftable').empty(data);
                            $('#dvStafftable').append(data);
                            //$(".table").DataTable({ "paging": false,"ordering":false});
                            
                        }
                    },error:function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            
        });

    // Print Function ,...
        function printDiv()
        {
            var printContents = document.getElementById('dvAttendanceReport').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            loadContent('/Attendance/AttendanceSubmissionForPrincipal');
        }
</script>

