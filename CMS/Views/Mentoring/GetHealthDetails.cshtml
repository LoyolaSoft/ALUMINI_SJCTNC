@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    Layout = null;

    CMS.ViewModel.Model.MENTORING_HEALTH_DETAILS editData = null;

    if (Model != null && Model.liStudentHealthDetails != null && Model.liStudentHealthDetails.Count > 0)
    {
        editData = Model.liStudentHealthDetails[0];
    }

    int disabilityPercent = 0;
    if (editData != null && editData.DISABILITY_PERCENTAGE != null)
    {
        int.TryParse(editData.DISABILITY_PERCENTAGE.ToString(), out disabilityPercent);
    }
}

<style>
    .health-box {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 20px;
    }

    .health-table label {
        margin-bottom: 0px;
        font-weight: 500;
        cursor: pointer;
    }

    .disability-section {
        display: none;
        background: #fdfdfd;
        padding: 15px;
        border: 1px dashed #ccc;
        border-radius: 5px;
        margin-top: 10px;
    }
</style>

<div class="container mt-3">
    <div class="health-box">
        <div class="row align-items-center mb-3">
            <div class="col-md-6">
                <h4 class="text-primary mb-0"><b><i class="fa fa-heartbeat"></i> Student Health Profile</b></h4>
            </div>
            <div class="col-md-6 text-right">
                <button type="button" class="btn btn-success btn-sm" onclick="printHealthProfile()">
                    <i class="fa fa-print"></i> Print Profile
                </button>
            </div>
        </div>

        <div id="healthPrintArea">
            <input type="hidden" id="HEALTH_RECORD_ID" value="@(editData != null ? editData.STUDENT_HEALTH_ID : "")" />

            <div class="table-responsive">
                <table class="table table-hover health-table">
                    <tbody>
                        <tr>
                            <td width="30%"><b>Asthma</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_ASTHMA" value="Yes" @(editData != null && editData.ASTHMA == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_ASTHMA" value="No" @(editData != null && editData.ASTHMA == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Allergy</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_ALLERGY" value="Yes" @(editData != null && editData.ALLERGY == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_ALLERGY" value="No" @(editData != null && editData.ALLERGY == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Diabetes</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_DIABETES" value="Yes" @(editData != null && editData.DIABETES == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_DIABETES" value="No" @(editData != null && editData.DIABETES == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Heart Disease</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_HEART" value="Yes" @(editData != null && editData.HEART_DISEASE == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_HEART" value="No" @(editData != null && editData.HEART_DISEASE == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Wheezing</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_WHEEZING" value="Yes" @(editData != null && editData.WHEEZING == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_WHEEZING" value="No" @(editData != null && editData.WHEEZING == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Skin Disease</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_SKIN" value="Yes" @(editData != null && editData.SKIN_DISEASE == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_SKIN" value="No" @(editData != null && editData.SKIN_DISEASE == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Hysteria</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_HYSTERIA" value="Yes" @(editData != null && editData.HYSTERIA == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_HYSTERIA" value="No" @(editData != null && editData.HYSTERIA == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Any Disability</b></td>
                            <td>
                                <label class="radio-inline mr-3">
                                    <input type="radio" name="HEALTH_ANY_DISABILITY" value="Yes" @(editData != null && editData.ANY_DISABILITY == "Yes" ? "checked" : "") /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" name="HEALTH_ANY_DISABILITY" value="No" @(editData != null && editData.ANY_DISABILITY == "No" ? "checked" : "") /> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td><b>Any Other</b></td>
                            <td>
                                <textarea id="HEALTH_ALLERGY_REASON" class="form-control" rows="3" placeholder="Enter other health details...">@(editData != null ? editData.ALLERGY_REASON : "")</textarea>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <div class="disability-section px-3 py-2">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Disability Type</label>
                        <select id="HEALTH_DISABILITY_TYPE" class="form-control">
                            <option value="">-- Select Type --</option>
                            <option value="Visual" @(editData != null && editData.DISABILITY_TYPE == "Visual" ? "selected" : "")>Visual</option>
                            <option value="Hearing" @(editData != null && editData.DISABILITY_TYPE == "Hearing" ? "selected" : "")>Hearing</option>
                            <option value="Physical" @(editData != null && editData.DISABILITY_TYPE == "Physical" ? "selected" : "")>Physical</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Disability Percentage (%)</label>
                        <input type="number" id="HEALTH_DISABILITY_PERCENT" class="form-control" value="@disabilityPercent" min="0" max="100" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="button" id="btnSaveHealthDetails" class="btn btn-success">
                <i class="fa fa-save"></i> Save Health Data
            </button>
        </div>

    </div>
</div>

<script>
$(document).ready(function () {
    var healthSaveBusy = false;

    function toggleDisabilityFields() {
        var val = $('input[name="HEALTH_ANY_DISABILITY"]:checked').val();
        if (val === "Yes") {
            $('.disability-section').slideDown();
        } else {
            $('.disability-section').slideUp();
            $('#HEALTH_DISABILITY_TYPE').val('');
            $('#HEALTH_DISABILITY_PERCENT').val(0);
        }
    }

    toggleDisabilityFields();

    $('input[name="HEALTH_ANY_DISABILITY"]').on('change', toggleDisabilityFields);

    $('#btnSaveHealthDetails').click(function () {
        if (healthSaveBusy) return;
        healthSaveBusy = true;

        var anyDisability = $('input[name="HEALTH_ANY_DISABILITY"]:checked').val();
        var disabilityType = $('#HEALTH_DISABILITY_TYPE').val();
        var percentage = $('#HEALTH_DISABILITY_PERCENT').val();

        if (!anyDisability) {
            swal('Warning', 'Please select if student has any disability', 'warning');
            healthSaveBusy = false;
            return;
        }

        if (anyDisability === "Yes") {
            if (!disabilityType || !percentage || percentage <= 0) {
                swal('Warning', 'Please provide disability type and percentage', 'warning');
                healthSaveBusy = false;
                return;
            }
        }

        var data = {
            STUDENT_HEALTH_ID: $('#HEALTH_RECORD_ID').val(),
            STUDENT_ID: $('#studentlist').val(),
            ASTHMA: $('input[name="HEALTH_ASTHMA"]:checked').val(),
            ALLERGY: $('input[name="HEALTH_ALLERGY"]:checked').val(),
            DIABETES: $('input[name="HEALTH_DIABETES"]:checked').val(),
            HEART_DISEASE: $('input[name="HEALTH_HEART"]:checked').val(),
            WHEEZING: $('input[name="HEALTH_WHEEZING"]:checked').val(),
            SKIN_DISEASE: $('input[name="HEALTH_SKIN"]:checked').val(),
            HYSTERIA: $('input[name="HEALTH_HYSTERIA"]:checked').val(),
            ANY_DISABILITY: anyDisability,
            DISABILITY_TYPE: disabilityType,
            DISABILITY_PERCENTAGE: percentage,
            ALLERGY_REASON: $('#HEALTH_ALLERGY_REASON').val()
        };

        $(this).prop('disabled', true);

        $.ajax({
            url: '@Url.Action("SaveHealthDetails", "Mentoring")',
            type: 'POST',
            data: data,
            success: function () {
                swal('Success', 'Health details saved successfully', 'success');
            },
            error: function () {
                swal('Error', 'Failed to save health details', 'error');
            },
            complete: function () {
                $('#btnSaveHealthDetails').prop('disabled', false);
                healthSaveBusy = false;
            }
        });
    });
});

function printHealthProfile() {
    var printContents = document.getElementById('healthPrintArea').innerHTML;
    var originalContents = document.body.innerHTML;
    document.body.innerHTML = '<html><head><title>Health Profile</title></head><body>' + printContents + '</body></html>';
    window.print();
    document.body.innerHTML = originalContents;
    $('#StuHealthDet').click();
}
</script>