@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    ViewBag.Title = "AddGroupSessioninfo";
}

<div class="panel panel-default">
    <div class="panel-body" style="overflow-x: auto;">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(
                                model => model.AcademicYear,
                                Model.AcademicYear ?? Enumerable.Empty<SelectListItem>(),
                                "--select--",
                                new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "Acyear" }
                            )
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(
                                model => model.ShiftList,
                                Model.ShiftList ?? Enumerable.Empty<SelectListItem>(),
                                "--select--",
                                new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "shift" }
                            )
                            @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ProgramName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(
                                model => model.ProgramName,
                                Model.ProgramName ?? Enumerable.Empty<SelectListItem>(),
                                "--select--",
                                new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" }
                            )
                            @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ClassName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(
                                model => model.ClassName,
                                Model.ClassName ?? Enumerable.Empty<SelectListItem>(),
                                "--select--",
                                new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "ClName" }
                            )
                            @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.StuName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <select class="form-control input-sm default-select2" id="StuName">
                                <option value="0">--select--</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.VisitDate, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <input type="date" class="form-control input-sm" id="VisitDate" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.VisitTime, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <input type="time" class="form-control input-sm" id="VisitTime" />
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.VisitDuration, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <input type="text" class="form-control input-sm" id="VisitDuration" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.MatterDiscussed, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <textarea class="form-control input-sm" id="MatterDiscussed" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ConclusionArrived, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <textarea class="form-control input-sm" id="ConclusionArrived" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ActionTaken, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <textarea class="form-control input-sm" id="ActionTaken" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ImpressionaboutStudent, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <textarea class="form-control input-sm" id="ImpressionaboutStudent" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ShortReview, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <textarea class="form-control input-sm" id="ShortReview" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.NextVisitDate, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <input type="date" class="form-control input-sm" id="NextVisitDate" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script>

   $("#ProgramName").on("change", function () {
    var programName = $("#ProgramName").val();
    var shiftId = $("#shift").val();
       var academicYear = $('#Acyear').val().trim();

    if (!academicYear || academicYear === '0' || !shiftId || !programName) {
        alert('Please select all required values: Program Name, Shift, and Academic Year.');
        return false;
    }

    $.ajax({
        url: "@Url.Action("BindClass", "Mentoring")",
        method: "POST",
        dataType: "json",
        data: {
            sProgramId: programName,
            sShiftId: shiftId,
            AcademicYear: academicYear
        },
        success: function (response) {
            if (response && response.length > 0) {
                var classNameDropdown = $("#ClName");
                classNameDropdown.empty();
                classNameDropdown.append('<option value="">-- select --</option>');
                $.each(response, function (index, item) {
                    classNameDropdown.append(`<option value="${item.CLASS_ID}">${item.CLASS_NAME}</option>`);
                });
                $('.selectpicker').selectpicker('refresh');
            } else {
                alert('No class data found for the selected criteria.');
            }
        },
        error: function () {
            alert('An internal server error occurred. Please try again later.');
        }
    });
});


        // Get Shift
    $("#shift").on("change", function () {
        var sShift = $("#shift").val();
            $.ajax({
                url: "@Url.Action("GetProgramByShift", "Mentoring")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift },
                success: function (data) {
                    $("#ProgramName").empty();
                    $("#ProgramName").append('<option value="">-- Select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
    });


    // Fetch Students ..


           $("#ClName").on("change", function () {
    var ProgramName = $("#ProgramName").val();
    var ClassName = $("#ClName").val();
    var AcademicYear = $('#Acyear').val();

    if (AcademicYear == '' || AcademicYear == '0') {
        alert('Please Choose All The Values...!!!');
        return false;
    }

    $.ajax({
        url: "@Url.Action("FetchStudents", "Mentoring")",
        method: "POST",
        datatype: "json",
        data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
        success: function (data) {
            $("#StuName").empty();
            $("#StuName").append('<option value="">-- select --</option>');
            $.each(data, function (index, item) {
                $("#StuName").append('<option value="' + item.value + '">' + item.text + '</option>');
            });
        },
        error: function (error) {
            alert('Internal Server Error !');
        }
    });
});


</script>

