@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    ViewBag.Title = "PersonalDetails";
}
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#" onclick="loadContent('@Url.Action("ADMIN","DashBoard")')"></a></li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin panel -->
    <div class="panel panel-default panel-with-tabs" data-sortable-id="ui-unlimited-tabs-2">
        <div class="panel-heading p-0">
            <div class="panel-heading-btn m-r-10 m-t-10">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-inverse" data-click="panel-expand"><i class="fa fa-expand"></i></a>
            </div>
            <!-- begin nav-tabs -->
            <div class="tab-overflow" data-parsley-validate="true" name="form-wizard">
                <ul class="nav nav-tabs">
                    <li class="nav-item active" id="personaldet"><a href="#nav-tab1-1"> class="nav-link active" data-toggle="tab">Personal Details</a></li>
                    <li class="" id="familydet"><a href="#nav-tab1-2" data-url="@Url.Action("Mentoring","PersonalDetails")" data-toggle="tab">Family Details</a></li>
                    <li class="" id="languagedet"><a href="#nav-tab1-3" data-toggle="tab">Language Details</a></li>
                    <li class="" id="academicdet"><a href="#nav-tab1-4" data-toggle="tab">Academic Details</a></li>
                    <li class="" id="Healthdet"><a href="#nav-tab1-5" data-toggle="tab">Health Details</a></li>
                    <li class="" id="Valuesdet"><a href="#nav-tab1-6" data-toggle="tab">Values</a></li>
                    <li class="" id="Interventiondet"><a href="#nav-tab1-7" data-toggle="tab">Intervention and Guidance Details</a></li>
                </ul>
            </div>
        </div>
        <div class="panel-body">
            <div class="tab-content">
                <div class="tab-pane fade" id="nav-tab1-2" data-parsley-validate="true">
                    <div class="panel-body noPadding">
                        <div class="form-group col-md-12">
                            <div class="row">
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(
                                            model => model.AcademicYear,
                                            Model.AcademicYear ?? Enumerable.Empty<SelectListItem>(),
                                            "--select--",
                                            new { @class = "form-control selectpicker", @data_live_search = "true", @data_tab = "2", @id = "Acyear" }
                                        )
                                        @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(
                                            model => model.ShiftList,
                                            Model.ShiftList ?? Enumerable.Empty<SelectListItem>(),
                                            "--select--",
                                            new { @class = "form-control selectpicker", @data_live_search = "true", @data_tab = "2", @id = "shift" }
                                        )
                                        @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.ProgramName, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(
                                            model => model.ProgramName,
                                            Model.ProgramName ?? Enumerable.Empty<SelectListItem>(),
                                            "--select--",
                                            new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @data_tab = "2" }
                                        )
                                        @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.ClassName, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(
                                            model => model.ClassName,
                                            Model.ClassName ?? Enumerable.Empty<SelectListItem>(),
                                            "--select--",
                                            new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @data_tab = "2", @id = "ClName" }
                                        )
                                        @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.StuName, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        <select class="form-control input-sm default-select2 selectpicker" data-tab="2" id="StuName">
                                            <option value="0">--select--</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group col-md-6">
                                    <button class="btn btn-primary" id="btnFamGet" type="button">Get</button>
                                </div>
                            </div>
                            <div class="col-md-12" id="dvReportFamily"></div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
