@model CMS.ViewModel.ViewModel.MentoringViewModel
@{
    Layout = null;
}
<style>
    /* Make input text larger and bold */
    #dvPersonalPrint .form-control {
        font-weight: bold !important;
        font-size: 16px !important;
        color: #000 !important; /* Ensure high contrast */
    }
</style>
<div class="form-container mt-3" id="dvPersonalPrint">

    <h4 class="text-center mb-4"><b><i class="fa fa-user-circle"></i> Student Personal Profile</b></h4>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <tbody>
                    @if (Model.listudentList != null && Model.listudentList.Any())
                    {
                        var item = Model.listudentList.First();

                        <tr><td width="30%"><b>Name</b></td><td><input class="form-control" id="PERSONAL_FIRST_NAME" value="@item.FIRST_NAME" /></td></tr>
                        <tr><td><b>Roll No</b></td><td><input class="form-control" id="PERSONAL_ROLL_NO" value="@item.ROLL_NO" /></td></tr>
                        <tr><td><b>Register No</b></td><td><input class="form-control" id="PERSONAL_REGISTER_NO" value="@item.REGISTER_NO" /></td></tr>
                        <tr><td><b>Shift</b></td><td><input class="form-control bg-light" value="@item.SHIFT_NAME" readonly /></td></tr>
                        <tr><td><b>Department</b></td><td><input class="form-control bg-light" value="@item.DEPARTMENT" readonly /></td></tr>

                        <tr>
                            <td><b>Date Of Birth</b></td>
                            <td>
                                <input type="date" class="form-control" id="PERSONAL_DOB"
                                       value="@(!string.IsNullOrEmpty(item.DATE_OF_BIRTH) ? DateTime.Parse(item.DATE_OF_BIRTH).ToString("yyyy-MM-dd") : "")" />
                            </td>
                        </tr>

                        <tr><td><b>Gender</b></td><td><input class="form-control bg-light" value="@item.GENDER_NAME" readonly /></td></tr>
                        <tr><td><b>Class</b></td><td><input class="form-control bg-light" value="@item.CLASS_NAME" readonly /></td></tr>
                        <tr><td><b>Father Name</b></td><td><input class="form-control" id="PERSONAL_FATHER_NAME" value="@item.FATHER_NAME" /></td></tr>
                        <tr><td><b>Father Occupation</b></td><td><input class="form-control" id="PERSONAL_FR_OCCUPATION" value="@item.FR_OCCUPATION" /></td></tr>
                        <tr><td><b>Mother Name</b></td><td><input class="form-control" id="PERSONAL_MOTHER_NAME" value="@item.MOTHER_NAME" /></td></tr>
                        <tr><td><b>Mother Occupation</b></td><td><input class="form-control" id="PERSONAL_MO_OCCUPATION" value="@item.MO_OCCUPATION" /></td></tr>
                        <tr><td><b>Guardian Name</b></td><td><input class="form-control" id="PERSONAL_GUARDIAN_NAME" value="@item.GUARDIAN_NAME" /></td></tr>
                        <tr><td><b>Guardian Occupation</b></td><td><input class="form-control" id="PERSONAL_GUARDIAN_OCCUPATION" value="@item.GUARDIAN_OCCUPATION" /></td></tr>
                        <tr><td><b>Annual Income</b></td><td><input class="form-control" id="PERSONAL_ANNUAL_INCOME" value="@item.ANNUAL_INCOME" /></td></tr>
                        <tr><td><b>Caste</b></td><td><input class="form-control" id="PERSONAL_CASTE" value="@item.CASTE" /></td></tr>
                        <tr><td><b>Community</b></td><td><input class="form-control" id="PERSONAL_COMMUNITY" value="@item.COMMUNITY" /></td></tr>
                        <tr><td><b>Religion</b></td><td><input class="form-control" id="PERSONAL_RELIGION" value="@item.RELIGION" /></td></tr>
                        <tr><td><b>Siblings</b></td><td><input class="form-control" id="PERSONAL_SIBLINGS" value="@item.SIBLINGS" /></td></tr>
                        <tr><td><b>Student Mobile</b></td><td><input class="form-control" id="PERSONAL_MOBILENO" value="@item.STU_MOBILENO" /></td></tr>
                        <tr><td><b>Parent Mobile</b></td><td><input class="form-control" id="FATHER_MOBILE" value="@item.FR_MOBILE" /></td></tr>
                        <tr><td><b>Email</b></td><td><input class="form-control" id="PERSONAL_EMAILID" value="@item.STU_EMAILID" /></td></tr>
                        <tr><td><b>Blood Group</b></td><td><input class="form-control bg-light" value="@item.BLOOD_GROUP_NAME" readonly /></td></tr>
                        <tr><td><b>Address</b></td><td><textarea class="form-control" id="PERSONAL_ADDRESS" rows="2">@item.ADDRESS_LINE1</textarea></td></tr>
                        <tr><td><b>Aadhar</b></td><td><input class="form-control" id="PERSONAL_AADHAR" value="@item.AADHAR_NUMBER" /></td></tr>
                        <tr><td><b>UMIS NO</b></td><td><input class="form-control" id="PERSONAL_UMIS" value="@item.UMIS_NO" /></td></tr>
                        <tr><td><b>EMIS NO</b></td><td><input class="form-control" id="PERSONAL_EMIS" value="@item.EMIS_NO" /></td></tr>
                        <tr><td><b>Travelling</b></td><td><input class="form-control" id="PERSONAL_TRAVELLING" value="@item.TRAVELLING" /></td></tr>


                        <!-- Hidden IDs -->
                        <input type="hidden" id="RECORD_MENTOR_STUDENT_ID" value="@item.MENTOR_STUDENT_ID" />
                        <input type="hidden" id="RECORD_STUDENT_ID" value="@item.STUDENT_ID" />
                        <input type="hidden" id="RECORD_DEPT_ID" value="@item.DEPT_ID" />
                        <input type="hidden" id="RECORD_SHIFT_ID" value="@item.SHIFT_ID" />
                        <input type="hidden" id="RECORD_CLASS_ID" value="@item.CLASS_ID" />
                        <input type="hidden" id="RECORD_PROGRAM_ID" value="@item.PROGRAM_ID" />
                        <input type="hidden" id="RECORD_BLOOD_GROUP" value="@item.BLOOD_GROUP" />
                        <input type="hidden" id="RECORD_GENDER_ID" value="@item.GENDER" />
                        <input type="hidden" id="RECORD_RELIGION_ID" value="@item.RELIGIONID" />
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4 text-right">
        <button class="btn btn-primary" id="btnUpdatePersonalDetails">
            <i class="fa fa-save"></i> Update Personal Profile
        </button>
    </div>
</div>

<script>
$(function () {
    var personalUpdateBusy = false;

    $('#btnUpdatePersonalDetails').click(function (e) {
        if (personalUpdateBusy) return;
        personalUpdateBusy = true;

        var dataObj = {
            MENTOR_STUDENT_ID: $('#RECORD_MENTOR_STUDENT_ID').val(),
            STUDENT_ID: $('#RECORD_STUDENT_ID').val(),
            FIRST_NAME: $('#PERSONAL_FIRST_NAME').val(),
            ROLL_NO: $('#PERSONAL_ROLL_NO').val(),
            REGISTER_NO: $('#PERSONAL_REGISTER_NO').val(),
            SHIFT_ID: $('#RECORD_SHIFT_ID').val(),
            DEPT_ID: $('#RECORD_DEPT_ID').val(),
            CLASS_ID: $('#RECORD_CLASS_ID').val(),
            PROGRAM_ID: $('#RECORD_PROGRAM_ID').val(),
            DATE_OF_BIRTH: $('#PERSONAL_DOB').val(),
            GENDER: $('#RECORD_GENDER_ID').val(),
            FATHER_NAME: $('#PERSONAL_FATHER_NAME').val(),
            FR_OCCUPATION: $('#PERSONAL_FR_OCCUPATION').val(),
            MOTHER_NAME: $('#PERSONAL_MOTHER_NAME').val(),
            MO_OCCUPATION: $('#PERSONAL_MO_OCCUPATION').val(),
            GUARDIAN_NAME: $('#PERSONAL_GUARDIAN_NAME').val(),
            GUARDIAN_OCCUPATION: $('#PERSONAL_GUARDIAN_OCCUPATION').val(),
            ANNUAL_INCOME: $('#PERSONAL_ANNUAL_INCOME').val(),
            CASTE: $('#PERSONAL_CASTE').val(),
            COMMUNITY: $('#PERSONAL_COMMUNITY').val(),
            RELIGION: $('#PERSONAL_RELIGION').val(),
            SIBLINGS: $('#PERSONAL_SIBLINGS').val(),
            BLOOD_GROUP: $('#RECORD_BLOOD_GROUP').val(),
            RELIGIONID: $('#RECORD_RELIGION_ID').val(),
            STU_MOBILENO: $('#PERSONAL_MOBILENO').val(),
            STU_EMAILID: $('#PERSONAL_EMAILID').val(),
            ADDRESS: $('#PERSONAL_ADDRESS').val(),
            UMIS: $('#PERSONAL_UMIS').val(),
            EMIS: $('#PERSONAL_EMIS').val(),
            TRAVELLING: $('#PERSONAL_TRAVELLING').val(),
            FR_MOBILE: $('#FATHER_MOBILE').val()
        };

        if (!dataObj.STUDENT_ID) {
            swal('Error', 'Student identification failed', 'error');
            personalUpdateBusy = false;
            return;
        }

        $(this).prop('disabled', true);

        $.ajax({
            url: '@Url.Action("UpdatePersonalDet", "Mentoring")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dataObj),
            success: function (res) {
                if (res.success !== false) {
                    swal('Success', 'Personal profile updated successfully', 'success');
                } else {
                    swal('Error', res.message || 'Failed to update profile', 'error');
                }
            },
            error: function () {
                swal('Error', 'Server error during update', 'error');
            },
            complete: function() {
                $('#btnUpdatePersonalDetails').prop('disabled', false);
                personalUpdateBusy = false;
            }
        });
    });

});
</script>

