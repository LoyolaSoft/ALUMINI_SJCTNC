

﻿@{
    ViewBag.Title = "CFFeeManualEntry";
}


@using (Html.BeginForm("CFFeeManualEntry", "PaymentGateway", FormMethod.Post))
{
    <label for="passkey">Passkey:</label>
    <input type="text" id="passkey" name="passkey" required />
    <br />
    <br />

    <label for="orderids">ORDER IDs (one per line):</label>
    <br />
    <textarea id="orderids" name="orderids" rows="10" cols="50"></textarea>
    <br />
    <br />

    <input type="submit" value="Submit" />
}

