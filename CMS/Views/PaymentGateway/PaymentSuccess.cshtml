@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{
    ViewBag.Title = "Payment Success";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<style>
    .receipt-container {
        max-width: 600px;
        margin: 50px auto;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .receipt-header {
        background: linear-gradient(135deg, #00b09b, #96c93d);
        color: white;
        padding: 40px 20px;
        text-align: center;
        position: relative;
    }

    .success-icon {
        background: white;
        color: #00b09b;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .college-info {
        padding: 30px;
        text-align: center;
        border-bottom: 1px dashed #eee;
    }

    .college-logo {
        max-width: 100px;
        margin-bottom: 15px;
    }

    .college-name {
        font-size: 22px;
        font-weight: 700;
        color: #333;
        margin: 0;
        line-height: 1.2;
    }

    .payment-details {
        padding: 40px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
        font-size: 16px;
    }

    .detail-label {
        color: #777;
        font-weight: 500;
    }

    .detail-value {
        color: #333;
        font-weight: 600;
    }

    .receipt-footer {
        padding: 30px;
        text-align: center;
        background: #f9f9f9;
    }

    .btn-print {
        background: #333;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-print:hover {
            background: #555;
            transform: translateY(-2px);
            color: white;
        }

    @@media print {
        .breadcrumb, .footer, .header, .sidebar, .btn-print, .btn-scroll-to-top {
            display: none !important;
        }

        .receipt-container {
            box-shadow: none;
            margin: 0;
            width: 100%;
            max-width: none;
        }

        body {
            background: white !important;
        }
    }
</style>

<div class="content">
    <ol class="breadcrumb pull-right">
        <li class="breadcrumb-item"><a href="@Url.Action("DashboardIndex", "Dashboard")">Home</a></li>
        <li class="breadcrumb-item active">Payment Receipt</li>
    </ol>
    <div class="clearfix"></div>

    <div class="receipt-container" id="printableReceipt">
        <div class="receipt-header">
            <div class="success-icon">
                <i class="fa fa-check"></i>
            </div>
            <h2 style="margin:0; font-weight: 700;">Payment Successful</h2>
            <p style="margin-top:10px; opacity: 0.9;">Your transaction has been processed successfully.</p>
        </div>

        <div class="college-info">
            @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
            {
                <img src="@Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO" class="college-logo" alt="Logo" />

                <h1 class="college-name">@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h1>

                <p class="text-muted" style="margin-top:5px;">@Model.liCollegeDetails.FirstOrDefault().PLACE</p>
            }
        </div>

        <div class="payment-details">
            <div class="detail-row">
                <span class="detail-label">Order ID</span>
                <span class="detail-value">@Model.FeeTransaction.ORDER_ID</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Transaction Date</span>
                <span class="detail-value">@(string.IsNullOrEmpty(Model.FeeTransaction.PAYMENT_DATE) ? DateTime.Now.ToString("dd MMM yyyy, hh:mm tt") : Model.FeeTransaction.PAYMENT_DATE)</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Status</span>
                <span class="detail-value text-success">SUCCESS</span>
            </div>
        </div>

        <div class="receipt-footer">
            @*<a href="javascript:window.print();" class="btn-print">
                <i class="fa fa-print m-r-5"></i> Print Receipt
            </a>*@
            <button  class="btn-print" style="background: #00b09b; margin-left: 10px;" onclick="loadAdmitCard()">
                <i class="fa fa-id-card-o m-r-5"></i> Download Convocation Acknowledgement
            </button>
            <p style="margin-top:20px; font-size: 13px; color: #999;">
                Thank you for your payment. <br />
                Please keep this receipt for your records.
            </p>
        </div>
    </div>
</div>

<script>

    function loadAdmitCard(){
        loadContent('/Alumnae/Alumnaecard');
    
    }
  
</script>
