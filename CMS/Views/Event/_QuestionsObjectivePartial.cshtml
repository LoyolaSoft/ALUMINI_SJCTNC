@model List<CMS.ViewModel.Model.EventFBQuestion>

@if (Model != null && Model.Any())
{
    <button class="btn btn-success mb-2" id="btnAddQuestion">Add Objective</button>
    <hr />
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Question Type</th>
                <th>Question</th>
                <th>Objective</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                int counter = 1;
            }
            @foreach (var q in Model)
            {
                <tr data-id="@q.QUESTION_OBJECT_ID">
                    <td>@counter</td>
                    <td>@q.QUESTION_TYPE</td>
                    <td>@q.QUESTION</td>
                    <td>@q.OBJECTIVES</td>
                    <td>
                        <button class="btn btn-sm btn-primary btn-edit"
                                data-id="@q.QUESTION_OBJECT_ID"
                                data-event="@q.EVENT_ID">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-danger btn-delete"
                                data-id="@q.QUESTION_OBJECT_ID"
                                data-event="@q.EVENT_ID">
                            Delete
                        </button>

                    </td>
                </tr>
                counter++;
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <div class="alert alert-warning d-flex justify-content-between align-items-center p-3">
        <p class="m-0 text-warning" style="font-size:16px; font-weight:600;">
            No questions found for this event and role.
        </p>
    </div>
}
