@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{
    ViewBag.Title = "EventRegisterationForm";
}

<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/css/lightbox.min.css">
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Event Rigisteration Form</a></li>
        <li class="active">Event Rigisteration Form</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Event Rigisteration Form<small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Event Rigisteration Form</h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 pull-right">
                <a href="#modal-dialog" data-toggle="modal" id="Add" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
            </div>
            <br /><br />
            <div class="col-md-12 form-group table-responsive">

                <table class="table table-bordered table-hover" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Event Name</th>
                            <th>Venue</th>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Time </th>
                            <th>Mode </th>
                            @*<th>Class Year </th>*@
                            <th>Role </th>
                            <th>No of Register </th>
                            <th>Class </th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liEventRegisterForm != null && Model.liEventRegisterForm.Count > 0)
                        {
                            int nCount = 0;
                            foreach (var item in Model.liEventRegisterForm)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.EVENT_NAME</td>
                                    <td>@item.EVENT_VENUE</td>
                                    <td>@item.TITLE</td>
                                    <td>@item.DATE</td>
                                    <td>@item.EVENT_TIME</td>
                                    <td>@item.MODE_NAME</td>
                                    <td>@item.ROLE_NAME</td>
                                    <td>@item.NO_OF_REGISTER</td>
                                    <td>@item.CLASS_NAME</td>
                                    <td>

                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>

                                    <td>
                                        <a href="#modal-dialog" data-toggle="modal" class="text-primary" onclick="FetchEventRegisterById(@item.EVENT_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfirm(@item.EVENT_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<div class="modal" id="modal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="EventRegister">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <input type="hidden" id="EventID" />

                            <div class="form-group">
                                <label class="control-label col-md-3">Event Name</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="EventName" class="form-control" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Venue</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="Venue" class="form-control" required />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-3">Title </label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="Title" class="form-control" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3"> Date</label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        <input type="text" id="date" class="form-control date" autocomplete="off" />
                                        <span class="input-group-addon bg-purple">
                                            <i class="fa fa-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>


                            <div class="form-group">
                                <label class="control-label col-md-3"> Time</label>
                                <div class="col-md-9">
                                    <input type="time" name="name" id="Time" class="form-control" />
                                    
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3"> Mode</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                           model => model.liSupEventMode,
                                             (Model.liSupEventMode != null) ? Model.liSupEventMode : Enumerable.Empty<SelectListItem>(),

                                           new
                                           {
                                               @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",
                                               id = "Mode",
                                               @data_live_search = "true",
                                               //  @data_parsley_required = "true",
                                               @data_parsley_trigger = "change",
                                               multiple = "multiple",
                                               @data_actions_box = "true"
                                           })
                                    @Html.ValidationMessageFor(m => m.liSupEventMode, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group">
                                <label class="control-label col-md-3"> Role</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                           model => model.liSupRole,
                                             (Model.liSupRole != null) ? Model.liSupRole : Enumerable.Empty<SelectListItem>(),

                                           new
                                           {
                                               @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",
                                               id = "Role",
                                               @data_live_search = "true",
                                               // @data_parsley_required = "true",
                                               @data_parsley_trigger = "change",
                                               multiple = "multiple",
                                               @data_actions_box = "true"
                                           })
                                    @Html.ValidationMessageFor(m => m.liSupRole, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="form-group">
                                <label class="control-label col-md-3"> Class Year</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                           model => model.liYearlist,
                                             (Model.liYearlist != null) ? Model.liYearlist : Enumerable.Empty<SelectListItem>(),

                                           new
                                           {
                                               @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",
                                               id = "ClassYear",
                                               @data_live_search = "true",
                                               // @data_parsley_required = "true",
                                               @data_parsley_trigger = "change",
                                               multiple = "multiple",
                                               @data_actions_box = "true"
                                           })
                                    @Html.ValidationMessageFor(m => m.liYearlist, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-3"> Shift</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                           model => model.liSupShift,
                                             (Model.liSupShift != null) ? Model.liSupShift : Enumerable.Empty<SelectListItem>(),

                                           new
                                           {
                                               @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",
                                               id = "Shift",
                                               @data_live_search = "true",
                                               // @data_parsley_required = "true",
                                               @data_parsley_trigger = "change",
                                               multiple = "multiple",
                                               @data_actions_box = "true"
                                           })
                                    @Html.ValidationMessageFor(m => m.liSupShift, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-3"> Programme</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                           model => model.liprogramLevel,
                                             (Model.liprogramLevel != null) ? Model.liprogramLevel : Enumerable.Empty<SelectListItem>(),

                                                new
                                           {
                                               @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",
                                               id = "Programme",
                                               @data_live_search = "true",
                                               // @data_parsley_required = "true",
                                               @data_parsley_trigger = "change",
                                               multiple = "multiple",
                                               @data_actions_box = "true"
                                           })
                                    @Html.ValidationMessageFor(m => m.liprogramLevel, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group">
                                <label class="control-label col-md-3"> Class Name</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                           model => model.liLCasslist,
                                             (Model.liLCasslist != null) ? Model.liLCasslist : Enumerable.Empty<SelectListItem>(),

                                           new
                                           {
                                               @class = "form-control selectpicker show-menu-arrow show-tick",
                                               id = "ClassList",
                                               @data_live_search = "true",
                                                //@data_parsley_required = "true",
                                               @data_parsley_trigger = "change",
                                               multiple = "multiple",
                                               @data_actions_box = "true"
                                           })
                                    @Html.ValidationMessageFor(m => m.liLCasslist, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group">
                                <label class="control-label col-md-3"> No of Register</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="Register" class="form-control" required />
                                </div>
                            </div>



                        </div>

                    </div>



                    <div class="col-md-4 form-group">
                        <div class="col-md-8">
                            <input type="checkbox" id="IsActive" /> &nbsp; &nbsp; IsActive
                        </div>
                    </div>

                </div>


            </div>
            <br />
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" onclick="SaveEventRegisteration()" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/js/lightbox.min.js"></script>
<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>

<script>
    $(".date").datepicker({
        todayHighlight: true,
        autoclose: true,
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');



    $("#Programme").on("change", function () {
        FetchFPUPClass();
    });
    $("#ClassYear").on("change", function () {
        FetchFPUPClass();
    });


     function FetchFPUPClass()
                         {
         var ProgramName = String($("#Programme").val());
         var classyear = String($("#ClassYear").val());
         var sShift = String($("#Shift").val());
         if ($("#ClassYear").val() && $("#Shift").val() && $("#Programme").val())
                             {
                                 $.ajax({
                                     url: "@Url.Action("FetchClassListByClassYarandShift", "Event")",
                                     method: "POST",
                                     datatype: "json",
                                     data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                                     success: function (data) {
                                         $("#ClassList").empty();
                                         $("#ClassList").append( data);
                                         $('.selectpicker').selectpicker('refresh');
                                     }, error: function (error) {
                                         alert('Internal Server Error ! ');
                                     }
                                 });
                             }
                         };
    $("#Shift").on("change", function ()
                         {
        FetchFPUPClass();
                         });
    $("#Programme").on("change", function ()
                         {
        FetchFPUPClass();
                         });



    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
    });

   
    $("#Add").on('click', function () {

        // Text fields
        $('#EventName').val('');
        $('#Venue').val('');
        $('#Title').val('');

        $('#date').datepicker('clearDates');
        $('#Time').val('');
        $('#Mode').selectpicker('val', '');
        $('#Role').selectpicker('val', '');
        $('#Programme').selectpicker('val', '');
        $('#ClassYear').selectpicker('val', '');
        $('#Shift').selectpicker('val', '');
        $('#ClassList').selectpicker('val', '');
        $('#Register').val('');
        $("#IsActive").prop("checked", false);
        $('#ClassYear').prop('disabled', false);
        $('#Shift').prop('disabled', false);
        $('#ClassList').prop('disabled', false);
        $('#Programme').prop('disabled', false);
        $('.selectpicker').selectpicker('refresh');
 
    });



    $('#btnSubmit').on('click', function () {
     var isValid = true;
        if ($('#EventRegister').parsley().validate() !== true) isValid = false;

     // ✅ Extra validation for From Date <= To Date
        var Date = $('#date').val();
        var Time = $('#Time').val();


     if (!isValid) {
         myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
         return false;
     }

     var IsActive = $('#IsActive').is(':checked') ? 1 : 0;
        var sJsonData = '{"EVENT_ID":"' + $("#EventID").val() +
            '","EVENT_NAME":"' + $('#EventName').val() +
            '","EVENT_VENUE":"' + $('#Venue').val() +
            '","TITLE":"' + $('#Title').val() +
            '","DATE":"' + $('#date').val() +
            '","EVENT_TIME":"' + $('#Time').val() +
            '","MODE":"' + $('#Mode').val() +
            '","ROLE":"' + $('#Role').val() +
            '","PROGRAM_YEAR":"' + $('#Programme').val() +
            '","CLASS_YEAR":"' + $('#ClassYear').val() +
            '","SHIFT":"' + $('#Shift').val() +
            '","CLASSES_ID":"' + $('#ClassList').val() +
            '","NO_OF_REGISTER":"' + $('#Register').val() +
         '","IS_ACTIVE":"' + IsActive + '"}';

     $.ajax({
         url: '@Url.Action("SaveEventRegisteration", "Event")',
         method: 'POST',
         data: { Register: sJsonData },
         success: function (data) {
             if (data.ErrorCode == "200") {
                 swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 2800, type: 'success', animation: true });
             } else {
                 swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 2800, type: 'error', animation: true });
             }
             loadContent('/Event/EventRegisterationForm');
         },
         error: function () {
             alert('Internal Server Error !');
         }
     });
    });


    function FetchEventRegisterById(Id) {
        $.ajax({
            url: '/Event/FetchEventRegisterById',
            method: 'POST',
            datatype: 'json',
            data: { EventID: Id },
            success: function (data) {
                $('#EventID').val(data.oResult[0].EVENT_ID);
                $('#EventName').val(data.oResult[0].EVENT_NAME);
                $('#Venue').val(data.oResult[0].EVENT_VENUE);
                $('#Title').val(data.oResult[0].TITLE);
                $('#date').val(data.oResult[0].DATE);
                $('#Time').val(data.oResult[0].EVENT_TIME);
                $('#Role').val(data.oResult[0].ROLE);
                $('#Register').val(data.oResult[0].NO_OF_REGISTER);

                $('#ClassYear').val(data.oResult[0].CLASS_YEAR);
                $('#Shift').val(data.oResult[0].SHIFT);
                $('#ClassList').val(data.oResult[0].CLASS_ID);
                $('#Programme').val(data.oResult[0].PROGRAM_YEAR);
                $('#ClassYear').prop('disabled', true);
                $('#Shift').prop('disabled', true);
                $('#ClassList').prop('disabled', true);
                $('#Programme').prop('disabled', true);
                //$('#ClassYear option[value="' + data.oResult[0].CLASS_YEAR + '"]').attr("selected", "selected");
                //$('#Shift option[value="' + data.oResult[0].SHIFT + '"]').attr("selected", "selected");
                //$('#ClassList option[value="' + data.oResult[0].CLASS_ID + '"]').attr("selected", "selected");
                //$('#Programme option[value="' + data.oResult[0].PROGRAM_YEAR + '"]').attr("selected", "selected");
                $('#Mode option[value="' + data.oResult[0].MODE + '"]').attr("selected", "selected");
                $('.selectpicker').selectpicker('refresh');

                if (data.oResult[0].IS_ACTIVE == 1) {
                    $("#IsActive").prop("checked", true);
                } else {
                    $("#IsActive").prop("checked", false);
                }
            }, error: function () {
                alert('Internal Server Error !');
            }
        });
    }


      function GetConfirm(id) {
      swal({
          title: "Are you sure want to Delete..?",
          type: "warning",
          showCancelButton: true,
          confirmButtonClass: "btn-danger",
          confirmButtonText: "Yes, I agree!",
          closeOnConfirm: false
      }, function () {
          $.ajax({
              url: "@Url.Action("DeleteEventRegisterById", "Event")",
              type: "post",
              data: { EventID: id },
              success: function (data) {
                  if (data.ErrorCode != null && data.ErrorCode == "402") {
                      swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                  } else {
                      swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                  }
                  loadContent('/Event/EventRegisterationForm');
              },
              error: function () {
                  swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
              }
          });
      });
  }

   

</script>