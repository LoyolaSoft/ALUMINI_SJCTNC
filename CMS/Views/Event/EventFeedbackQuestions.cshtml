@model CMS.ViewModel.Model.EventFeedbackViewModel
@using CMS.ViewModel.ViewModel
@{
    ViewBag.Title = "Event Feedback Questions";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />

<div id="content" class="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Events</a></li>
        <li class="active">Event Feedback Questions</li>
    </ol>

    <h1 class="page-header">Event Feedback Questions</h1>

    <div class="panel panel-info">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand">
                    <i class="fa fa-expand"></i>
                </a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload">
                    <i class="fa fa-repeat"></i>
                </a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse">
                    <i class="fa fa-minus"></i>
                </a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove">
                    <i class="fa fa-times"></i>
                </a>
            </div>
            <h4 class="panel-title">Select Event</h4>
        </div>

        <div class="panel-body">
            <div class="form-horizontal">
                <!-- Event Dropdown -->
                <div class="form-group col-md-4">
                    @Html.Label("Event Name", htmlAttributes: new { @class = "col-md-4 control-label" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(
                            m => m.SelectedEventId,
                            Model.EventSelectList ?? Enumerable.Empty<SelectListItem>(),
                            "--- Select Event ---",
                            new { @class = "form-control selectpicker show-menu-arrow show-tick", @id = "ddlEvent", @data_live_search = "true" }
                        )
                        @Html.ValidationMessageFor(m => m.SelectedEventId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group col-md-4">
                    @Html.Label("Role", htmlAttributes: new { @class = "col-md-4 control-label" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(
                            m => m.SelectedRoleId,
                            Enumerable.Empty<SelectListItem>(),
                            "--- Select Role ---",
                            new { @class = "form-control selectpicker show-menu-arrow show-tick", @id = "ddlRole", @data_live_search = "true" }
                        )
                        @Html.ValidationMessageFor(m => m.SelectedRoleId, "", new { @class = "text-danger" })
                    </div>
                </div>


            </div>
            <br />

            <div id="page-loader-index" class="fade in hide">
                <span class="spinner"></span>
            </div>

            <div id="divQuestionView"></div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/jquery/jquery.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<!-- Swal -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
$(document).ready(function () {
    $('.selectpicker').selectpicker();

    $('#ddlEvent').on('change', function () {
        var selectedEventId = $(this).val();

        if (selectedEventId) {
            $.ajax({
                url: '@Url.Action("GetRolesByEvent", "Event")',
                type: 'GET',
                data: { eventId: selectedEventId },
                success: function (roles) {
                    $('#ddlRole').empty();
                    $('#ddlRole').append('<option value="">--- Select Role ---</option>');
                    $.each(roles, function (i, role) {
                        $('#ddlRole').append('<option value="' + role.Value + '">' + role.Text + '</option>');
                    });
                    $('#ddlRole').selectpicker('refresh');
                }
            });

        } else {
            $('#ddlRole').empty()
                .append('<option value="">--- Select Role ---</option>')
                .selectpicker('refresh');
            $('#divQuestionView').html('');
        }
    });

    $('#ddlRole').on('change', function () {
        loadQuestions();
    });


    function loadQuestions() {
        var eventId = $('#ddlEvent').val();
        var roleId = $('#ddlRole').val();

        if (eventId && roleId) {
            $('#divQuestionView').html("<p>Loading questions...</p>");

            $.ajax({
                url: '@Url.Action("GetQuestions", "Event")',
                type: 'GET',
                data: {
                    eventId: eventId,
                    roleId: roleId
                },
                success: function (data) {
                    $('#divQuestionView').html(data);
                },
                error: function () {
                    Swal.fire("Error", "Failed to load questions!", "error");
                }
            });
        } else {
            $('#divQuestionView').html('');
        }
    }

    // Function to open a modal (Add or Edit)
function openQuestionModal(url, data) {
    // Remove existing modal if any
    $("#questionModal").remove();

    // Fetch modal HTML via AJAX
    $.get(url, data, function (html) {
        $("body").append(html);

        // Show modal and ensure cleanup on close
        $("#questionModal").modal("show").one('hidden.bs.modal', function () {
            $(this).remove();
        });
    });
}

// Add Question
$(document).on("click", "#btnAddQuestion", function () {
    var eventId = $('#ddlEvent').val();
    var roleId = $('#ddlRole').val();

    if (!eventId || !roleId) {
        Swal.fire("Warning", "Please select Event and Role first.", "warning");
        return;
    }

    openQuestionModal('@Url.Action("AddQuestion", "Event")', { eventId: eventId, roleId: roleId });
});

// Edit Question
$(document).on("click", ".btn-edit", function () {
    var questionId = $(this).data("id");

    openQuestionModal('@Url.Action("EditQuestion", "Event")', { questionId: questionId });
});

// Save Question (delegated, unbind previous handler to avoid duplicates)
$(document).off("submit", "#questionForm").on("submit", "#questionForm", function (e) {
    e.preventDefault();
    var form = $(this);

    $.post(form.attr("action"), form.serialize(), function (res) {
        if (res.success) {
            Swal.fire("Success", res.message, "success");
            $("#questionModal").modal("hide");
            loadQuestions(); // reload the question list
        } else {
            Swal.fire("Error", res.message, "error");
        }
    });
});


    // Delete Question
    $(document).on("click", ".btn-delete", function () {
        var questionId = $(this).data("id");

        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to delete this question?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('@Url.Action("DeleteQuestion", "Event")', { questionId: questionId }, function (res) {
                    if (res.success) {
                        Swal.fire("Deleted!", res.message, "success");
                        loadQuestions();
                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                });
            }
        });
    });



    // Close modal on Cancel button click (for dynamically loaded modal)
    $(document).on("click", "#questionModal .btn-secondary", function () {
        $("#questionModal").modal("hide");
    });


});
</script>
