@model CMS.ViewModel.Model.EventFBObjectiveMappingVM

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="modal fade" id="objectiveModal"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h5 class="modal-title">
                    Objective Mapping — Event: @Model.EVENT_ID | Role: @Model.ROLE_ID
                </h5>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                @using (Html.BeginForm("SaveObjectiveMapping", "Event", FormMethod.Post, new { id = "objectiveForm" }))
                {
                    @Html.HiddenFor(m => m.EVENT_ID)
                    @Html.HiddenFor(m => m.ROLE_ID)
                    @Html.HiddenFor(m => m.QUESTION_OBJECT_ID)

                    <div class="form-group mb-3">
                        <label>Select Question(s)</label>
                        @Html.DropDownListFor(
                            m => m.SelectedQuestions,
                            Model.QuestionList,
                            new
                                 {
                                @class = "form-control selectpicker",
                                multiple = "multiple",
                                data_live_search = "true",
                                data_actions_box = "true",
                                id = "ddlQuestions"
                            })
                    </div>

                    <div class="form-group mb-3">
                        <label>Select Objective(s)</label>
                        @Html.DropDownListFor(
                            m => m.SelectedObjectives,
                            Model.ObjectiveList,
                            new
                                 {
                                @class = "form-control selectpicker",
                                multiple = "multiple",
                                data_live_search = "true",
                                data_actions_box = "true",
                                id = "ddlObjectives"
                            })
                    </div>

                    <!-- FOOTER -->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Save Mapping</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
