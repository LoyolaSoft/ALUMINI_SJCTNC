@model CMS.ViewModel.Model.EventFBQuestion

<div class="modal fade" id="questionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@((Convert.ToInt32(Model.QUESTION_ID) > 0) ? "Edit Question" : "Add Question")</h5>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("SaveQuestion", "Event", FormMethod.Post, new { id = "questionForm" }))
                {
                    @Html.HiddenFor(m => m.QUESTION_ID)
                    @Html.HiddenFor(m => m.EVENT_ID)
                    @Html.HiddenFor(m => m.ROLE_ID)
                    @Html.HiddenFor(m => m.ACADEMIC_YEAR)
                    
                    <div class="form-group">
                        @Html.LabelFor(m => m.QUESTION)
                        @Html.TextAreaFor(m => m.QUESTION, new { @class = "form-control", rows = 3 })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.QUESTION_TYPE)
                        @Html.DropDownListFor(
                            m => m.QUESTION_TYPE,
                            (IEnumerable<SelectListItem>)ViewBag.QuestionTypes,
                            "--- Select Question Type ---",
                            new { @class = "form-control" }
                        )
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
