@model CMS.ViewModel.ViewModel.HostelViewModel


@{
    ViewBag.Title = "HostelRegistrationPrintView";
    string YES = "YES";
    string No = "NO";
}
@if (Model.liStudentInfo != null && Model.liStudentInfo.Count > 0)
{
    <div class="col-md-12 row">
        <div class="col-md-9 pull-left ">
            <center>
                <table>
                    <tr>
                        <td class="text-center"><h1>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME  HOSTEL</h1></td>
                    </tr>
                    <tr>
                        <td class="text-center"><h3>@Model.liCollegeDetails.FirstOrDefault().PLACE  .</h3></td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <center><h2>HOSTEL APPLICATION FORM</h2></center>
                        </td>
                    </tr>
                </table>
            </center>
        </div>
        <div class="col-md-3 pull-right">
            <div id="dvImportStudentImage">
                @*<label class="col-md-3 control-label">Photo</label>*@
                <div class="fileupload fileupload-new" data-provides="fileupload">
                    <div class="thumbnail" style="width: 150px; height: 185px;">
                        <p><center>AFFIEX HERE YOUR PASSPORT SIZE PHOTOGRAPH TAKEN WITHIN A PERION OF THREE MONTHS</center></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />


    <div class="col-md-12 row" style="page-break-inside:avoid !important;">
        <table class="table table-bordered table-responsive" width="100%">
            <tr>
                <th><b>Name</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().FIRST_NAME @Model.liStudentInfo.FirstOrDefault().LAST_NAME</td>
                <th><b>DOB</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().DATE_OF_BIRTH</td>
            </tr>
            <tr>
                <th>Major</th>
                <td>@Model.liStudentInfo.FirstOrDefault().PROGRAMME_NAME</td>
                <th><b>Class</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().CLASS_NAME</td>
            </tr>
            <tr>
                <th>Caste</th>
                <td>@Model.liStudentInfo.FirstOrDefault().CASTE</td>
                <th><b>Religion</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().RELIGION</td>
            </tr>
            @*<tr>
                <th>Father Name</th>
                <td>@Model.liStudentInfo.FirstOrDefault().FATHER_NAME</td>
                <th><b>Mobile</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().FR_MOBILE</td>
            </tr>*@
            <tr>
                <th><b>Extra Curricular</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().TALENT</td>
                <th><b>Blood Group</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().BLOOD_GROUP_NAME</td>
            </tr>
            <tr>
                <th>Roman Cathelic</th>
                <td>
                    @if (Model.liStudentInfo.FirstOrDefault().RELIGION_ID == "1")
                    { @YES}
                else
                    { @No}
                </td>
                <th><b>Relation in Campus</b></th>
                <td>
                    @if (Model.liStudentInfo.FirstOrDefault().IS_RELATION == "1")
                    { @YES}
                else
                    { @No}
                </td>
            </tr>
            <tr>
                <th><b>Contact Mobile</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().C_PHONENO</td>
                <th><b>Email</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().STU_EMAILID</td>
            </tr>
            <tr>
                <th><b>Door No</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().C_DOOR_DETAIL</td>
                <th><b>Village</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().C_VILLAGE_AREA</td>
            </tr>
            <tr>
                <th><b>City</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().C_TALUK</td>
                <th><b>District</b></th>
                <td>@Model.liStudentInfo.FirstOrDefault().C_DISTRICT</td>
            </tr>

        </table>
    </div>
    <div class="col-md-12 row" style="page-break-inside:avoid !important;">
        @if (Model.liStuRelation != null && Model.liStuRelation.Count > 0)
        {
        <table class="table table-bordered table-responsive">
            <caption><b>Details of the family members :</b></caption>
            <thead>
                <tr>
                    <th>
                        Relationship
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        Occupation
                    </th>
                    <th>
                        Income
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.liStuRelation != null && Model.liStuRelation.Count > 0)
                {
                    foreach (var item in Model.liStuRelation)
                    {

                        <tr class="tr_clone" cms-relationid="@item.RELATION_ID">
                            <td>
                                @item.RELATION_SHIP
                            </td>
                            <td>
                                @item.RELATION_NAME
                            </td>
                            <td>
                                @item.INCOME
                            </td>
                            <td>
                                @item.INCOME
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        }
    </div>

    <div class="col-md-12 row" style="page-break-inside:avoid !important;">
        <div id="dvImportFamilyPhoto">
            <div class="fileupload fileupload-new" data-provides="fileupload">
                <div class="fileupload-new thumbnail" style="width: 720px; height: 350px;">
                    <p><center>FAMILY PHOTO MAXI SIZE</center></p>
                </div>
            </div>
        </div>
    </div>
    <div>
        <br />
        <div class="col-md-8 col-lg-offset-2">
            <div class="col-md-4 col-lg-offset-1">
                <div class="m-b-10 pull-left"><b>Signature of the Parent</b></div>
            </div>
            <div class="col-md-4 col-lg-offset-1">
                <div class="m-b-10 pull-right"><b>Applicant's Signature</b></div>
            </div>
        </div>
    </div>
}