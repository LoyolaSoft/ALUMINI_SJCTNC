@model CMS.ViewModel.ViewModel.HostelViewModel

@{
    ViewBag.Title = "ListHostelStudents";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


@*<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />*@
<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->



<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Hostel Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin #page-loader -->
    @*<div id="page-loader" class="fade in"><span class="spinner"></span></div>*@
    <!-- end #page-loader -->
    <!-- begin page-header -->
    <h1 class="page-header">Hostel Student List</h1>
    <!-- end page-header -->
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Hostel Student List</h3>
        </div>
        <div class="panel-body">

            <div class="form-group">
                <a class="btn bg-green pull-right" title="Add Student" href="#Hostel-dialog" data-toggle="modal"><i class="fa fa-plus"></i> Add</a>
            </div><br /><br />

            <div class="form-group table-responsive">
                @{ int count = 0;}
                <table class="table table-hover table-bordered" id="tblStudentList">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Roll No</th>
                            <th>Register No</th>
                            <th>Class</th>
                            <th>Name</th>
                            <th>Block</th>
                            @*<th>Cot No</th>
                            <th>Room No</th>*@
                            <th>Hostel</th>
                            <th>Left</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liHostelStudentList != null)
                        {
                            foreach (var item in Model.liHostelStudentList)
                            {
                                <tr id="@item.STUDENT_ID">
                                    <td>@{count++;} @count</td>
                                    <td>@item.ROLL_NO</td>
                                    <td>@item.REGISTER_NO</td>
                                    <td>@item.CLASS_NAME</td>
                                    <td>@item.NAME</td>
                                    <td>@item.BLOCK_NAME</td>
                                    @*<td>@item.COT_NO</td>
                                    <td>@item.ROOM_NO</td>*@
                                    <td>@item.HOSTEL_NAME</td>
                                    @if (item.IS_LEFT == "1")
                                    {
                                        <td>YES</td>
                                    }
                                    else
                                    {
                                        <td>NO</td>
                                    }                                   
                                    <td>
                                        <a href="#Hostel-dialog" onclick="FetchHostelStudent(@item.STU_HOSTEL_ID,@item.CLASS_ID)" title="Click To Edit" data-toggle="modal"><i class="fa fa-edit text-primary"></i></a>
                                        <a href="javascript:;" onclick="GetConfrim(@item.STU_HOSTEL_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                              }
                          }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal" id="Hostel-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Hostel Student</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="form-group">
                                    <label class="control-label col-md-3">Class List</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Hostel List</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.HostelList, (Model.HostelList != null) ? Model.HostelList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Student List</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Admitted Date</label>
                                    <div class="col-md-9">
                                        <div class="input-group date" id="datetimepicker1">
                                            <input type="text" class="form-control input-sm" id="AdmittedDate" placeholder="Select Date"/>
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Admitted Year</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.YearList, (Model.YearList != null) ? Model.YearList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Block List</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.BlockList, (Model.BlockList != null) ? Model.BlockList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Room No</label>
                                    <div class="col-md-9">
                                        <input type="text" class="form-control input-sm" id="RommNo" placeholder="Enter Room No" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3">Cot No</label>
                                    <div class="col-md-9">
                                        <input type="text" class="form-control input-sm" id="CotNo" placeholder="Enter Cot No" />
                                    </div>
                                </div>

                                <div class="form-group hidden" id="HDIsLeft">
                                    <label class="control-label col-md-3">Is Left</label>
                                    <div class="col-md-9 checkbox checkbox-css">
                                        <input type="checkbox" id="IsLeft" />
                                        <label for="IsLeft"></label>
                                    </div>
                                </div>
                          
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Filed-->
<input type="text" class="hidden" id="HDStuHostelId" />

<!-- Hidden Filed-->

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
        handleDatepicker = function () {
            "use strict";
            $("#AdmittedDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
        }
        handleDatepicker();
    }

    $('#tblStudentList').DataTable();

    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');


    // Fetch Student By ClassId ...
    $('#ClassList').on('change', function ()
    {
        GetStudentByClassId($('#ClassList').val(),0);
    });

    function GetStudentByClassId(sClassId,sStudentId)
    {

        $('#StudentList').empty();
        $.ajax({
            url: '@Url.Action("FetchStudentByClassId", "CertificateCourse")',
            method: 'POST',
            datatype: 'json',
            data: { sClassId: sClassId },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    //myAlert(data.Message, 'gritter-danger', '');
                    alert(data.Message);
                } else
                {
                    $('#StudentList').append('<option value=""> -- Select -- </option>' + data.sResult);
                    $('#StudentList').val(sStudentId);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                //myAlert('Internal Server Error !', 'gritter-danger', '');
                alert('Internal Server Error !');
            }
        });
    }

    // Fetch Block By Hostel Id ...
    $('#HostelList').on('change', function ()
    {
        GetBlockListByHostelId($('#HostelList').val(), 0);
    });

    function GetBlockListByHostelId(sHostelId,sBlockId)
    {
        $.ajax({
            url: '@Url.Action("FetchBlockListByHostelId", "Hostel")',
            method: 'POST',
            datatype: 'json',
            data: { sHostelId: sHostelId },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    //myAlert(data.Message, 'gritter-danger', '');
                    alert(data.Message);
                } else
                {
                    $('#BlockList').empty();
                    $('#BlockList').append('<option value=""> -- Select -- </option>' + data.sResult);
                    $('#BlockList').val(sBlockId);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }
    // Fetch Hostel Student Info By Id ...
    function FetchHostelStudent(Stu_Hostel_Id,sClassId)
    {
        $.ajax({
            url:'@Url.Action("FetchHostelStudentById", "Hostel")',
            method: 'POST',
            datatype:'json',
            data: { sStuHostelId: Stu_Hostel_Id },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    //myAlert(data.Message, 'gritter-danger', '');
                    alert(data.Message);
                } else
                {
                    GetStudentByClassId(sClassId, data[0].STUDENT_ID);
                    GetBlockListByHostelId(data[0].HOSTEL_ID, data[0].BLOCK_ID);
                    $('#ClassList').val(sClassId);
                    $('#HDStuHostelId').val(data[0].STU_HOSTEL_ID);
                    $('#HostelList').val(data[0].HOSTEL_ID);
                   // $('#StudentList').val(data[0].STUDENT_ID);
                  //  $("#StudentList option[value='" + data[0].STUDENT_ID + "']").prop("selected", true);
                    $('#AdmittedDate').val(data[0].ADMITTED_DATE);
                    $("#YearList option:contains(" + data[0].ADMITTED_YEAR + ")").attr('selected', 'selected');
                   // $('#BlockList').val(data[0].BLOCK_ID);
                    $('#RommNo').val(data[0].ROOM_NO);
                    $('#CotNo').val(data[0].COT_NO);
                    $('#HDIsLeft').removeClass('hidden');            
                    if (data[0].IS_LEFT=="1")
                    {                        
                        $('#IsLeft').click();
                    }
                    $('#ClassList').attr('disabled', true);
                    $('#StudentList').attr('disabled', true);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
               // myAlert('Internal Server Error !', 'gritter-danger', '');
                alert('Internal Server Error !');
            }
        });
    }

    // Delete Hostel Student Info ...
    function GetConfrim(Stu_Hostel_Id)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        } else
        {
            $.ajax({
                url: '@Url.Action("DeleteHostelStudent", "Hostel")',
                method: 'POST',
                datatype: 'json',
                data: { sStuHostelId: Stu_Hostel_Id },
                success: function (data) {
                    alert(data.Message);
                    //myAlert(data.Message, 'gritter-success', '');
                    loadContent('/Hostel/ListHostelStudents');
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    //myAlert('Internal Server Error !', 'gritter-danger', '');
                }
            });
        }
        
    }

    // On Submit ...
    $('#btnSubmit').on('click', function ()
    {    
        var IsLeft = 0;
        if ($('#IsLeft').is(":checked"))
        {
            IsLeft = 1;
        }
        var JsonData = null;
        JsonData = '{"STU_HOSTEL_ID":"' + $('#HDStuHostelId').val() + '",\
                      "STUDENT_ID":"' + $('#StudentList').val() + '",\
                      "HOSTEL_ID":"' + $('#HostelList').val() + '",\
                      "BLOCK_ID":"' + $('#BlockList').val() + '",\
                      "ROOM_NO":"' + $('#RommNo').val() + '",\
                      "COT_NO":"' + $('#CotNo').val() + '",\
                      "ADMITTED_YEAR":"' + $('#YearList Option:selected').text() + '",\
                      "ADMITTED_DATE":"' + $('#AdmittedDate').val() + '",\
                      "IS_LEFT":"' + IsLeft + '"}';
        //&& $('#BlockList').val() != 0 
        if ($('#StudentList').val() != 0 && $('#HostelList').val() != 0 && $('#YearList Option:selected').text() != "--Select--")
        {
            $.ajax({
                url: '@Url.Action("SaveHostelStudent", "Hostel")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonData: JsonData },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                        loadContent('/Hostel/ListHostelStudents');
                    } else
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    }
                    
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        } else {
            alert('Please Fill All The Filed To Continue !');
            return false;
        }
        
    });

    // Clear Modal values ...
    $(function () {
        $('#Hostel-dialog').on('hidden.bs.modal', function (e) {
            $('#HDStuHostelId').val('');
            $('#StudentList').val('');
            $('#HostelList').val('');
            $('#BlockList').val('');
            $('#RommNo').val('');
            $('#CotNo').val('');
            $('#YearList').val('');
            $('#AdmittedDate').val('');
            if ($('#IsLeft').is(":checked"))
            {
                $('#IsLeft').click();
            }
            $('.selectpicker').selectpicker('refresh');
        });
    });
</script>