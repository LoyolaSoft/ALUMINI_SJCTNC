@model CMS.ViewModel.ViewModel.HostelViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "HostelStudentPromotion";
    Layout = null;
}

<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>

        <li class="active">Hostel Student Promotion List </li>
    </ol>
    <h2 class="page-header">Hostel Student Promotion  </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Hostel Student Promotion List </h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal" id="validatediv" data-parsley-validate="true">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group  col-md-6" id="dvClassWisePromotion">
                        @Html.Label("From Year", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",@id="fromac", @data_parsley_required = "true" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group  col-md-6" id="dvClassWisePromotion">
                        @Html.Label("To Year", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",@id="toac", @data_parsley_required = "true" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>                   
                </div>
                <div class="col-md-12">
                    <div class="form-group  col-md-6" id="dvClassWisePromotion">
                        @Html.Label("From Hostel", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.HostelList, (Model.HostelList != null) ? Model.HostelList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",@id="fromhostel", @data_parsley_required = "true" })
                            @Html.ValidationMessageFor(model => model.HostelList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group  col-md-6" id="dvClassWisePromotion">
                        @Html.Label("To Hostel", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.HostelList, (Model.HostelList != null) ? Model.HostelList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",@id="tohostel", @data_parsley_required = "true" })
                            @Html.ValidationMessageFor(model => model.HostelList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                   
                </div>
                <div class="col-md-12">
                    <div class="form-group  col-md-6" id="dvClassWisePromotion">
                        @Html.Label("Class Year", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.YearList, (Model.YearList != null) ? Model.YearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true",multiple="multiple" })
                            @Html.ValidationMessageFor(model => model.YearList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @*<div class="col-md-3" id="divClassWisePromotion">
                        <a class="btn btn-primary  form-group m-b-5" id="btnGet" onclick="PromoteHostelStudent()">Promotion</a>
                    </div>*@
                    <div class="col-md-3 hidden" id="divClassWisePromotion" style="padding-left:50px">
                        <a class="btn btn-success  form-group m-b-5" id="btnPromotion" onclick="PromoteHostelStudent()">Promotion</a>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div id="divStudentPromotion">
                    <!--Need to use this fied to bind Student List-->
                </div>
            </div>

        </div>


    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/jquery-ui/ui/minified/jquery-ui.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    $('.selectpicker').selectpicker({
        size: 4
    });
</script>
<script>
    function SelectOrUnselect()
    {

            if (AllchkID.checked == true) {
                $('#StudentList tbody tr').each(function () {
                    $(this).find('input[type="checkbox"]').each(function () {
                        $('input[type="checkbox"]').attr("checked", true);
                    });
                });
            }
            else {
                $('#StudentList tbody tr').each(function () {
                    $(this).find('input[type="checkbox"]').each(function () {
                        $('input[type="checkbox"]').attr("checked", false);
                    });
                });
            }
        }
</script>
<script>

    $('#YearList').on('change', function ()
    {
        if ($('#fromac').val() && $('#YearList').val() && $("#fromhostel").val())
        {
            var fromhostel = $("#fromhostel").val();
            var fromac = $('#fromac option:selected').text();
            var toac = $('#toac').val();
            var classyear = String($('#YearList').val());
            $.ajax({
                url: "@Url.Action("BindStudentForPromotion", "Hostel")",
                method: "POST",
                data: { sClassyear: classyear, sAcyear: fromac, sHostel: fromhostel },
                datatype: "json",
                success: function (data)
                {
                    $('#divStudentPromotion').empty();
                    $('#divStudentPromotion').append(data);
                    $('#divClassWisePromotion').removeClass('hidden');
                    $('#StudentList').DataTable({"bPaginate":false});

                }, error: function (data)
                {
                    alert("Internal Server Error!");
                }

            });
        }
        else
        {
            alert('Please Select the Academic Year and Class Year..!');
            return false;
        }
    });

    function PromoteHostelStudent()
    {
        var isValid = true;
        if ($('#validatediv').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {         
            return false;
        }
        var ClassYear = $('#YearList').val();
        var toacyear = $('#toac option:selected').text();
        var tohostel = $('#tohostel').val();
      
        if (!confirm('Are you sure to Promote the students to the ' + toacyear + ' Academicyear ?')) {
            return false;
        }
        var StudentId

        $('#StudentList tbody tr').each(function () {
            $(this).find('td').each(function () {
                var chkBox = $(this).find('input[type="checkbox"]');
                if (chkBox.is(':checked')) {
                    StudentId = '"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '"';
                }
            });
        });
        if (StudentId == null) {
            alert('Please select the student to upgrade...!!!');
            return false;
        }

        var JsonData;

        JsonData = '{"StudentPromotionList":[';
        $('#StudentList tbody tr').each(function () {

            $(this).find('td').each(function () {
                var chkBox = $(this).find('input[type="checkbox"]');
                if (chkBox.is(':checked'))
                {
                    JsonData += '{"CLASS_YEAR":"' + ClassYear + '","ACADEMIC_YEAR":"' + toacyear + '",';
                    JsonData += '"' + "STUDENT_ID" + '":"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '","' + "HOSTEL_ID" + '":"' + tohostel + '","' + "NAME" + '":"' + $(this).find('input[type="checkbox"]').attr("cms-name") + '"},';

                }
            });
        });
        JsonData = JsonData.slice(0, -1);
        JsonData +=
        ']}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateHostelPromotion", "Hostel")",
            method: "POST",
            data: { sStudent: JsonData },
            async:true,
            datatype: "json",
            success: function (data)
            {
                alert(data.Message);

            }, error: function (data)
            {
                alert('Internal Server Errorr..!');
            }
        });

    }


</script>
