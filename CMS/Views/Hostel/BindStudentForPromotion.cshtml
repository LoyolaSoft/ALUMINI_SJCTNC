@model CMS.ViewModel.ViewModel.HostelViewModel
@{
    Layout = null;
    int count = 0;
}
<table class="table table-hover table-bordered" id="StudentList">
    <thead>
        <tr>
            <th>#</th>
            <th>
                <input type="checkbox" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" /> Select All
            </th>

            <th>Roll No</th>
            <th>Student Name</th>
            <th>Date Of Birth</th>
            <th>Hostel</th>
        </tr>
    </thead>

    @if (Model.liHostelStudentList != null)
    {
        foreach (var item in Model.liHostelStudentList)
        {
            <tr cms-studentid="@item.STUDENT_ID">
                <td>
                    @{ count++;}@count
                </td>
                <td>
                    <input type="checkbox" name="myTextEditBox" id="chkID" cms-studentid="@item.STUDENT_ID" cms-hostelid="@item.HOSTEL_ID" cms-name="@item.NAME" />
                </td>

                <td>@item.ROLL_NO</td>
                <td>@item.NAME</td>
                <td>@item.DATE_OF_BIRTH</td>
                <td>@item.HOSTEL_NAME</td>
            </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"><p>No records available !!!</p></td>
                            </tr>
                        }


</table>
