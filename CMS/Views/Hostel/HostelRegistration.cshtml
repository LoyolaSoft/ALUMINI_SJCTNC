            if ($('#IsRelativesYes').is(":checked"))
                IsRelation = 1;
            else
                IsRelation = 0;
            json = '{"STU_EMAILID":"' + $('#txtMail').val() + '","TALENT":"' + $('#txtExtraCurricularActivity').val() + '","FIRST_NAME":"' + $('#txtFirstName').val() + '","LAST_NAME":"' + $('#txtInitial').val() + '","DATE_OF_BIRTH":"' + $('#txtdob').val() + '","PROGRAM_ID":"' + $('#ddlMajor').val() + '","RELIGION":"' + $('#ddlReligion').val() + '","COMMUNITY":"' + $('#ddlCaste').val() + '","BLOOD_GROUP":"' + $('#ddlBloodGroup').val() + '","ADDRESS_ID":"' + $('#hdAddressId').val() + '","PARISH_NAME":"' + $('#txtParishName').val() + '","IS_RELATION":"' + IsRelation + '","CLASS_ID":"' + $('#ddlClass').val() + '","STUDENT_ID":"' + $('#hdStudent_Id').val() + '","RENEWAL_REGISTRATION_ID":"' + $('#txtHostelRegistrationId').val() + '",';
            json += '"C_DISTRICT":"' + $('#txtCDistrict').val() + '","C_DOOR_DETAIL":"' + $('#txtCDoorNo').val() + '","C_STREET":"' + $('#txtCStreet').val() + '","C_TALUK":"' + $('#txtCCity').val() + '","C_PINCODE":"' + $('#txtCPinCode').val() + '","C_VILLAGE_AREA":"' + $('#txtCVillage').val() + '","C_PHONENO":"' + $('#txtCMobileNo').val() + '","C_PINCODE":"' + $('#txtCPinCode').val() + '",';
            if ($('#chAddress').is(":checked")) {
                json += '"P_DISTRICT":"' + $('#txtCDistrict').val() + '","P_DOOR_DETAIL":"' + $('#txtCDoorNo').val() + '","P_STREET":"' + $('#txtCStreet').val() + '","P_TALUK":"' + $('#txtCCity').val() + '","P_PINCODE":"' + $('#txtCPinCode').val() + '","P_VILLAGE_AREA":"' + $('#txtCVillage').val() + '","P_PHONENO":"' + $('#txtCMobileNo').val() + '","P_PINCODE":"' + $('#txtCPinCode').val() + '"}';
            }
            else {
                json += '"P_DISTRICT":"' + $('#txtPDistrict').val() + '","P_DOOR_DETAIL":"' + $('#txtPDoorNo').val() + '","P_STREET":"' + $('#txtPStreet').val() + '","P_TALUK":"' + $('#txtPCity').val() + '","P_PINCODE":"' + $('#txtPPinCode').val() + '","P_VILLAGE_AREA":"' + $('#txtPVillage').val() + '","P_PHONENO":"' + $('#txtPMobileNo').val() + '","P_PINCODE":"' + $('#txtPPinCode').val() + '"}';
            }

            var fileData = new FormData();
            //var fileUpload = $("#UserImage").get(0);
            //var files = fileUpload.files;
            //// Looping over all files and add it to FormData object
            //for (var j = 0; j < files.length; j++)
            //{
            //    fileData.append(files[j].name, files[j]);
            //}
            fileData.append("sHostelPersonal", json);
            fileData.append("sAdmission_No", $('#hdAdmission_No').val());
            fileData.append("Student_Id", $('#hdStudent_Id').val());

            $.ajax({
                url: "@Url.Action("SaveOrUpdateHostelPersonalInfo", "Hostel")",
                method: "POST",
                contentType: false, // Not to set any content header
                processData: false,
                data: fileData,
                // async: false,
                success: function (ObjJsonData) {
                    if (ObjJsonData.sResult != null && ObjJsonData.sResult != '') {
                        $('#txtHostelRegistrationId').val(ObjJsonData.sResult);
                    }
                    if (ObjJsonData.ErrorCode != null && ObjJsonData.ErrorCode != '') {
                        $('#hdAddressId').val(ObjJsonData.ErrorCode);
                    }
                    myAlert(ObjJsonData.Message, 'gritter-success', '');
                    FetchStudentRelations();
                }, error: function (error) {
                    myAlert('Internal Server Error !', 'gritter-danger', '');
                }
            });
        }


        // Save Or Upload Siblings Details ...
        function SaveOrUpdateFamilyDetails(e) {
            var i = 1;
            var RelationJson;
            var IsSubmitted;
            RelationJson = '{"liRelation":[';
            $('#RelatoinsList tbody tr').each(function () {
                RelationId = $(this).attr("cms-relationid");
                tdRelation = $(this).find('td').find('#relation option:selected').val();
                tdName = $(this).find('td').find('#txtName').val();
                tdOccupation = $(this).find('td').find('#Occupation option:selected').val();
                tdIncome = $(this).find('td').find('#txtIncome').val();
                RelationJson += '{"RELATION_ID":"' + RelationId + '","STUDENT_ID":"' + $('#hdStudent_Id').val() + '","RELATION_NAME":"' + tdName + '","RELATION_SHIP":"' + tdRelation + '","OCCUPATION":"' + tdOccupation + '","INCOME":"' + tdIncome + '"},';
                i++;
            });
            if (i > 0) {
                RelationJson = RelationJson.slice(0, -1);
            }
            RelationJson += ']}';
            if ($('#chkDeclaration').is(":checked"))
                IsSubmitted = 1;
            else
                IsSubmitted = 0;
            $.ajax({
                url: "@Url.Action("SaveOrUpdateFamilyDetails", "Hostel")",
                method: "POST",
                datatype: "json",
                data: { sRelationJson: RelationJson, sIsSubmitted: IsSubmitted },
                //async: false,
                success: function (ObjJsonData) {
                    myAlert(ObjJsonData.Message, 'gritter-success', '');
                    FetchStudentRelations();
                }, error: function (error) {
                    myAlert('Sorry .Internal Server Error !', 'gritter-danger', '');
                }
            });
        }


