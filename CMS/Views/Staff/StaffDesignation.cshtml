@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "StaffDesignation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Staff Designation</li>
    </ol>
    <h1 class="page-header">Staff Designation</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Staff Designation</h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("AcademicYear", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control inputsm",@data_live_search="true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div> 
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control inputsm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>                    
                </div>
                <div class="col-md-12" id="dvStaffDesination">

                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <a class="btn btn-success disabled" id="btnSaveStaffDesignation">Submit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>

        function ContentLoad() {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
        $('#ShiftList').on("change", function () {
            var sAcademicYear = $('#AcademicYear option:selected').text();
            if (sAcademicYear == '' || sAcademicYear == '0') {
                alert('Please Choose AcademicYear...!!!');
                return false;
            }
            FetchDesignation();
        });
        function FetchDesignation() {
            $.ajax({
                url: "@Url.Action("FetchStaffDesignationByAcademicYear", "Staff")",
                method: "POST",
                datatype: "json",
                data: { AcademicYear: $('#AcademicYear option:selected').text(),sShift:$('#ShiftList').val() },
                success: function (data) {
                    $('#dvStaffDesination').empty();
                    $('#dvStaffDesination').append(data);
                    $('.selectpicker').selectpicker('refresh');
                    $("#tblStaffDesignation").DataTable({ paging: false });
                    $('#btnSaveStaffDesignation').removeClass("disabled");                  
                    $('.selectpicker').selectpicker({
                        size: 5
                    });
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            })
        }       
        $('#btnSaveStaffDesignation').click(function ()
        {                 
            var jsonObject;
            if (jsonObject == null) {
                jsonObject = '{"LiJsonStaffDesignation":[';
                $('#tblStaffDesignation tbody tr').each(function () {                   
                    jsonObject += '{"DESIGNATION_ID":"' + $(this).attr("cms-desingationId") + '","STAFF_ID":"' + $(this).attr("cms-staffId") + '","DESIGNATION":"' + String($(this).find('#ddlDesignation').val()) + '","INCHARGE":"' + ($(this).find('#ddlIncharge option:selected').val()) + '","ACADEMIC_YEAR":"' + ($('#AcademicYear option:selected').text()) + '"},';
                });
                jsonObject = jsonObject.slice(0, -1);
                jsonObject += ']}';               
            }
            $.ajax({ 
                url: "@Url.Action("SaveStaffDesignation", "Staff")",
                method: "post",
                content: "application/json; charset=utf-8",
                data: { JsonStaffDesignation: jsonObject },
                success: function (data) {                               
                    alert(data.Message);
                    FetchDesignation();
                }, error: function (e) {
                    alert('Internal Server Error !');
                }
            });

        });
</script>
    
