@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "ClassStudentAttendanceMarkProfile";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ClassWise Student Report</li>
    </ol>
    <h1 class="page-header">ClassWise Student Report</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ClassWise Student Report</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-5 form-group">
                @Html.Label("Class", htmlAttributes: new { @class = "col-md-4 control-label " })
                <div class="col-md-8">
                    @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                    @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-12" id="binddiv">

            </div>
        </div>
    </div>
</div>

<div class="modal" id="ciamark">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Student Mark</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div  id="divciamark">

                </div>
            </div>

        </div>

    </div>
</div>

<div class="modal" id="semmark">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Student Mark</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div id="divsemmark">

                </div>
            </div>

        </div>

    </div>
</div>

<div class="modal" id="profile">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Student Profile</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div  id="divprofile">

                </div>
            </div>

        </div>

    </div>
</div>

<div class="modal" id="attendance">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Student Attendance</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div  id="divattendance">

                </div>
            </div>

        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('Refresh');

    $('#ClassList').on('change', function ()
    {
        var clsid = $(this).val();
        $.ajax({
            url: "@Url.Action("BindClasswiseStudent", "Staff")",
            type: "post",
            data: { sClassId: clsid },
            success: function (data) {
                $('#binddiv').empty();
                $('#binddiv').append(data);
                $('#tblstudent').DataTable({});
            },
            error: function (ex) {
                alert(ex.Message);
            }
        });

    });
    function Attendance(ID)
    {
        $.ajax({
            url: "@Url.Action("StudentAttendance", "Staff")",
            type: "post",
            data: { sStudentId: ID },
            success: function (data)
            {
                $('#divattendance').empty();
                $('#divattendance').append(data);
            },
            error: function (ex) {
                alert(ex.Message);
            }
        });
    }
    function CIAMark(ID)
    {
        $.ajax({
            url: "@Url.Action("StudentCIAMark", "Staff")",
            type: "post",
        data: { sStudentId: ID },
        success: function (data)
        {
            $('#divciamark').empty();
            $('#divciamark').append(data);
        },
        error: function (ex) {
            alert(ex.Message);
        }
    });
    }
    function SemMark(ID)
    {
        $.ajax({
            url: "@Url.Action("StudentSemsterMark", "Staff")",
            type: "post",
        data: { sStudentId: ID },
        success: function (data)
        {
            $('#divsemmark').empty();
            $('#divsemmark').append(data);
        },
        error: function (ex) {
            alert(ex.Message);
        }
    });
    }
    function Profile(ID)
    {
        $.ajax({
            url: "@Url.Action("StudentProfile", "Staff")",
            type: "post",
        data: { sStudentId: ID },
        success: function (data)
        {
            $('#divprofile').empty();
            $('#divprofile').append(data);
        },
        error: function (ex) {
            alert(ex.Message);
        }
    });
    }

</script>
