
@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="container" style="width:800px;">
    @if (Model.liStfPayslip != null)
    {
        foreach (var item in Model.liStfPayslip)
        {

            <div class="">
                @if (Model.liCollegeDetails != null)
                {
                    <div class="row">
                        <div class="col-md-12 text-center">
                            <div class="col-md-1 text-center">
                                <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="height: 90px" />
                            </div>
                            <div class="text-center col-md-11">
                                <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h3>
                                <h5>@Model.liCollegeDetails.FirstOrDefault().GRADE</h5>
                                <h5>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY</h5>
                                <h5>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_ADDRESS</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <br />
            <div class="text-center">
                <h4><b> Payslip __________</b></h4>
            </div>
            <br />
            <div class="text-center">
                <table class="payslip-table">
                    <tr>
                        <td>1. Employee Number</td>

                        <td>: @item.STAFF_CODE</td>
                    </tr>
                    <tr>
                        <td>2. Name</td>

                        <td>: @item.FIRST_NAME</td>
                    </tr>
                    <tr>
                        <td>3. Designation</td>

                        <td>: @item.DESIGNATION</td>
                    </tr>
                    <tr>
                        <td>4. Department</td>

                        <td>: @item.DEPARTMENT</td>
                    </tr>
                    <tr>
                        <td>5. Sex/Religion & Community</td>

                        <td>: @item.GENDER/@item.COMMUNITY</td>
                    </tr>
                    <tr>
                        <td>6. Date of Birth</td>

                        <td>: @item.DATE_OF_BIRTH</td>
                    </tr>
                    <tr>

                        <td>7. Date of Appointment</td>

                        <td>: @item.DATE_OF_JOIN</td>
                    </tr>
                    <tr>
                        <td>8. Employees' Provident Fund Number</td>

                        <td>: @item.EPF_NO</td>
                    </tr>
                    <tr>
                        <td>9. EPF - UAN Number</td>

                        <td>: @item.UAN_NO</td>
                    </tr>
                    <tr>
                        <td>10. Bank AC Number (IFSC Code)</td>

                        <td>: @item.BANK_AC_NO - @item.IFSC_CODE</td>
                    </tr>
                    <tr>
                        <td>11. PAN No./Aadhaar No.</td>

                        <td>: @item.PAN_NO / @item.AADTHAR_NO</td>
                    </tr>
                    <tr>
                        <td>12. Voter ID</td>

                        <td>: @item.VOTER_ID</td>
                    </tr>
                    <tr>
                        <td>13. Email ID</td>

                        <td>: @item.EMAIL</td>
                    </tr>
                    <tr>

                        <td>14. Mobile Number</td>

                        <td>: @item.MOBILE_NO</td>
                    </tr>

                    <!-- Add other rows as needed -->
                </table>

            </div>
        }
        <div class="text-center">
            <h3><b>Salary Particulars</b> </h3>
        </div>
        <div class="">
            <table class="table table-bordered table-hover ">
                <thead>
                    <tr>
                        <th class="text-center" colspan="2">
                            <b> Income Details</b>
                        </th>
                        <th colspan="4" class="text-center"><b>Deductions Details</b> </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Basic</td>
                        <td>78764</td>
                        <td>PF</td>
                        <td>sffs</td>
                        <td>ESI</td>
                        <td>sdfsf</td>
                    </tr>
                    <tr>
                        <td>DA(16%)</td>
                        <td>3434</td>
                        <td>LIC</td>
                        <td>454</td>
                        <td>Festival Advance(2/10)</td>
                        <td>23</td>
                    </tr>
                    <tr>
                        <td>Package</td>
                        <td>343</td>
                        <td>Welfare Loan</td>
                        <td>3434</td>
                        <td>Medical Insurance</td>
                        <td>343</td>
                    </tr>
                    <tr>
                        <td>SP. ALW.</td>
                        <td>233</td>
                        <td>Prof.Tax</td>
                        <td>4343</td>
                        <td>Fathers Day</td>
                        <td>4343</td>
                    </tr>
                    <tr>
                        <td>Other.</td>
                        <td>3564</td>
                        <td>IT.</td>
                        <td>54454</td>
                        <td>Others</td>
                        <td>343</td>
                    </tr>
                    <tr>
                        <td>PP</td>
                        <td>787</td>
                        <td colspan="3" class="text-right"><b>Total Deduction(PF+ESI)</b></td>
                        <td>4564564</td>
                    </tr>
                    <tr>
                        <td><b>Gross</b></td>
                        <td>563453</td>
                        <td colspan="3" class="text-right"><b>Net Pay(Gross-PF-ESI)</b></td>
                        <td>56767</td>
                    </tr>
                    <tr>
                        <td colspan="5" class="text-right"><b>Net Pay</b></td>
                        <td>563453</td>

                    </tr>
                    <tr>
                        <td colspan="5" class="text-right"><b>Other Deduction Total</b></td>
                        <td>563453</td>

                    </tr>
                    <tr><td colspan="6" class="text-center"><b>Take Home Salary(100% Net Pay - Other Deduction Total):- 878</b></td></tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div>
            <h3>No Slip Found For This Month</h3>
        </div>
    }
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>