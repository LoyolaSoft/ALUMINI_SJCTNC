@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "ListStuCourseRemark";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List StudentCourse Remark</li>
    </ol>
    <h1 class="page-header">List StudentCourse Remark</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List StudentCourse Remark</h4>
        </div>
        <div class="panel-body">          
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })                
                <div class="col-md-12">                    
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.liLCasslist, (Model.liLCasslist != null) ? Model.liLCasslist : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liLCasslist, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>                   
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="form-group">
                          <a class="btn btn-success" @*href="@Url.Action("AddStuCourseRemark", "Staff")"*@ href="javascript:;" onclick="loadContent('/Staff/AddStuCourseRemark')" id="btnAddRemark">Add/Edit</a>
                        </div>
                    </div>                   
                </div>
                <div class="col-md-12" id="dvStuCourseRemark">

                </div>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>   
    function ContentLoad() {
        // Document Ready Function .
    }
        $('.selectpicker').selectpicker({
            size: 5
        });       
        $('.selectpicker').selectpicker('refresh');
        $('#liLCasslist').on("change", function () {
            var sAcademicYear = $('#liLCasslist').val();
            if (sAcademicYear == '' || sAcademicYear == '0') {
                alert('Please Choose Class...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("GetCourseListByClassIdAndStaffId", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sClassId: $('#liLCasslist').val() },
                success: function (data) {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value="">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            })
        });
    $('#CourseList').on("change", function () {
        var sAcademicYear = $('#CourseList').val();
        if (sAcademicYear == '' || sAcademicYear == '0') {
            alert('Please Choose Course...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("FetchStuCourseRemarkByCourseId", "Staff")",
            method: "POST",
            datatype: "json",
            data: { sCourseId: $('#CourseList').val(), sClassId: $('#liLCasslist').val() },
            success: function (data) {
                $("#dvStuCourseRemark").empty();              
                $("#dvStuCourseRemark").append(data);
                $("#tblStuCourseRemark").DataTable({});
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        })
    });
</script>
   