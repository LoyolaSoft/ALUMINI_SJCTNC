@model CMS.ViewModel.ViewModel.StaffViewModel
@{ Layout = null;  int count = 0; }

<div class="form-group">
    <div class="col-md-12 table-responsive">
       
        <table id="tblStudent" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Roll No</th>
                    <th>Register No</th>
                    <th>Admission No</th>
                    <th>Student Name</th>
                    <th>Dob</th>
                    <th>Class</th>
                    <th>Course</th>
                    <th>Mobile</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.liStudent != null)
                {
                    foreach (var item in Model.liStudent)
                    {
                        <tr>
                            <td>@{count++;} @count</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.REGISTER_NO</td>
                            <td>@item.ADMISSION_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.DATE_OF_BIRTH</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.COURSE</td>
                            <td>@item.MOBILE</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>