@model CMS.ViewModel.ViewModel.StudentViewModel
@{ 
    Layout = null;
}
@if (Model.liSemestermark != null && Model.liSemestermark.Count>0)
{
<div class="form-group  table-responsive" id="divprint">
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-4">
                @Html.Label("Reg No", htmlAttributes: new { @class = "col-md-3 control-label " })
                <div class="col-md-8">
                    <label>@Model.liSemestermark.FirstOrDefault().REGISTER_NO</label>
                </div>
            </div>
            <div class="col-md-4">
                @Html.Label("Name", htmlAttributes: new { @class = "col-md-2 control-label " })
                <div class="col-md-8">
                    <label>@Model.liSemestermark.FirstOrDefault().NAME</label>
                </div>
            </div>
        </div>
    </div>
    <br>

    <table border="1" id="tblsemstermark" style="padding:10px;">
        <thead>
            <tr>
                <th style="padding:3px">#</th>
                <th style="padding:3px">Sem</th>
                <th style="padding:3px">Course</th>
                <th style="padding:3px">Mark</th>
                <th style="padding:3px">Result</th>
                <th style="padding:3px">Grade</th>
                <th style="padding:3px">Pass Month</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.liSemestermark != null && Model.liSemestermark.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liSemestermark)
                {
                    count = count + 1;

                    <tr>
                        <td style="padding:3px">@count</td>

                        <td style="padding:3px">@item.SEMESTER_NAME</td>
                        <td style="padding:3px">@item.COURSE_TITLE</td>
                        <td style="padding:3px">@item.TOTAL</td>
                        <td style="padding:3px">@item.RESULT</td>
                        <td style="padding:3px">@item.GRADE</td>
                        <td style="padding:3px">@item.M_PASS</td>
                    </tr>
                }

            }

        </tbody>
    </table>
    <br>


</div>
}