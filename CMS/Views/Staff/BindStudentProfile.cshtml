@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    Layout = null;
}

<div class="table-responsive">
    @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
    {

        <div class="">
            <center>
                <img src="@Model.liStudentList.FirstOrDefault().PHOTO" style="height:80px;width:110px">
            </center>
            <br>
            <br>
            <div class="col-md-12">

                <div class="form-group col-md-12">
                    @Html.Label("Roll No", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        <label>@Model.liStudentList.FirstOrDefault().ROLL_NO</label>
                    </div>
                </div>



                <div class="form-group col-md-12">
                    @Html.Label("Name", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        <label>@Model.liStudentList.FirstOrDefault().FIRST_NAME</label>
                    </div>
                </div>

            </div>


            <div class="form-group col-md-12">
                @Html.Label("Register No", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.liStudentList.FirstOrDefault().REGISTER_NO</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.liStudentList.FirstOrDefault().CLASS_NAME</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Father Name", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.liStudentList.FirstOrDefault().FATHER_NAME</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Mobile No", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.liStudentList.FirstOrDefault().STU_MOBILENO</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Address", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.liStudentList.FirstOrDefault().ADDRESS</label>
                </div>
            </div>


        </div>
    }
    else
    {
        <div class="alert alert-info">
            No  Record Found..!
        </div>
    }
</div>



