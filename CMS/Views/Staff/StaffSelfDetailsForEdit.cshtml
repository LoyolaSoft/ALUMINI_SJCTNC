@model CMS.ViewModel.ViewModel.StaffViewModel

@{
    ViewBag.Title = "StaffSelfDetailsForEdit";
    Layout = null;
}

<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">My Staff Details</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Staff Details</h1>
    <!-- end page-header -->
    <div class="row">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                </div>
                <h3 class="panel-title">My Staff Details</h3>
            </div>
            <div class="panel-body">

                <div class="form-group row" style="margin-bottom: 15px;">
                    <div class="col-md-6">
                        <span class="text-muted" style="font-size: 13px;">View and manage your personal staff information.</span>
                    </div>
                    <div class="col-md-6 text-right">
                        @if (Model.lstStaffList != null && Model.lstStaffList.Count > 0)
                        {
                            var staffItem = Model.lstStaffList.FirstOrDefault();
                            <a class="btn btn-primary" href="javascript:;" onclick="loadContent('/Staff/EditStaffInfomationByID/@staffItem.STAFF_ID?fromSelfEdit=true')">
                                <i class="fa fa-edit"></i> Edit My Details
                            </a>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-12 table-responsive" style="padding-left: 0; padding-right: 0;">
                        @{int count = 0; }
                        <table id="StaffInfo" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 50px; text-align: center;">S.No</th>
                                    <th>Staff Code</th>
                                    <th>Name</th>
                                    <th>Department</th>
                                    <th>Gender</th>
                                    <th>Shift</th>
                                    <th>Date of Birth</th>
                                    <th style="text-align: center;">Status</th>
                                    <th style="width: 80px; text-align: center;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.lstStaffList != null && Model.lstStaffList.Count > 0)
                                {
                                    foreach (var item in Model.lstStaffList)
                                    {
                                        <tr>
                                            <td style="text-align: center;">@{count++;} @count</td>
                                            <td><strong>@Html.DisplayFor(modelItem => item.STAFF_CODE)</strong></td>
                                            <td>@Html.DisplayFor(modelItem => item.FIRST_NAME)</td>
                                            <td>@Html.DisplayFor(modelItem => item.DEPARTMENT)</td>
                                            <td>@Html.DisplayFor(modelItem => item.GENDER_NAME)</td>
                                            <td>@Html.DisplayFor(modelItem => item.SHIFT_NAME)</td>
                                            <td>@Html.DisplayFor(modelItem => item.DATE_OF_BIRTH)</td>
                                            <td style="text-align: center;">
                                                @if (item.IS_LEFT == "0")
                                                {
                                                    <span class="badge badge-success" style="background-color: #10b981;">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger" style="background-color: #ef4444;">Left</span>
                                                }
                                            </td>
                                            <td style="text-align: center;">
                                                <a class="btn btn-xs btn-primary" href="javascript:;" title="Edit Staff Details" onclick="loadContent('/Staff/EditStaffInfomationByID/@item.STAFF_ID?fromSelfEdit=true')">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted" style="padding: 25px;">No staff details found for the logged-in user.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad() {
        if (!$.fn.DataTable.isDataTable('#StaffInfo')) {
            $("#StaffInfo").DataTable({
                dom: "lBfrtip",
                buttons: [
                    { extend: "copy", className: "btn-sm" },
                    { extend: "excel", className: "btn-sm" },
                    { extend: "print", className: "btn-sm" }
                ],
                responsive: true,
                paging: false,
                searching: false,
                info: false
            });
        }
    }

    $(document).ready(function () {
        ContentLoad();
    });
</script>
