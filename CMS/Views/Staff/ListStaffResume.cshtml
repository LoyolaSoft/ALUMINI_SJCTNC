@model CMS.ViewModel.ViewModel.StaffViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Staff Resume</li>
    </ol>
    <h1 class="page-header">List Staff Resume</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Staff Resume</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-12 form-group table-responsive">
                <div class="form-group">
                    <a href="#stfResume" data-toggle="modal" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
                </div>
                <br /><br />
              <table class="table table-bordered">
                  <thead>
                      <tr>
                          <th>#</th>
                          <th>Name</th>
                          <th>Address</th>
                          <th>Qualification</th>
                          <th>Mobile No</th>
                          <th>E-Mail</th>
                          <th>Religion</th>
                          <th>Subject</th>
                          <th>Date</th>
                          <th>Action</th>
                      </tr>
                  </thead>
                  <tbody>
                      @if (Model.liStaffResume!=null && Model.liStaffResume.Count>0)
                      {
                          int nCount = 0;
                          foreach (var item in Model.liStaffResume)
                          {
                              <tr>
                                  <td>@{nCount++;} @nCount</td>
                                  <td>@item.STAFF_NAME</td>
                                  <td>@item.ADDRESS</td>
                                  <td>@item.QUALIFICATION_ID</td>
                                  <td>@item.CONTACT_NO</td>
                                  <td>@item.EMAIL_ID</td>
                                  <td>@item.RELIGION_ID</td>
                                  <td>@item.SUBJECT</td>
                                  <td>@item.ENTRY_DATE</td>
                                  <td>
                                      <a href="#stfResume" data-toggle="modal" class="text-primary" onclick="FetchResume(@item.RESUME_ID)"><i class="fa fa-edit"></i></a>
                                      <a href="javascript:;" class="text-danger" onclick="DeleteResume(@item.RESUME_ID)"><i class="fa fa-trash"></i></a>
                                  </td>
                              </tr>
                           }
                       }
                       else
                       {
                           <tr>
                               <td colspan="9" style="text-align:center;"> No Record(s) Found ...!</td>
                           </tr>
                       }
                  </tbody>
              </table> 
            </div>
        </div>
    </div>
</div>

<div class="modal" id="stfResume">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Staff Resume</h4>
            </div>
            <div class="modal-body form-horizontal" data-parsley-validate="true" id="pBody">
                <div class="form-group">
                    @Html.Label("Name", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.ObjResume.STAFF_NAME, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Name", @data_parsley_required = "true", @data_parsley_length = "[3,30]" } })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Address", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        <textarea class="form-control m-b-10" id="ObjResume_ADDRESS" rows="5" data-parsley-required = "true" data-parsley-length = "[3,100]"> Address</textarea>
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Qualification", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @*@Html.DropDownListFor(model => model.Qualification, (Model.Qualification != null) ? Model.Qualification : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })*@
                        @Html.EditorFor(model => model.ObjResume.QUALIFICATION_ID, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Qualification", @data_parsley_required = "true", @data_parsley_length = "[2,20]" } })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Mobile No", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.ObjResume.CONTACT_NO, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Mobile No", @data_parsley_required = "true", @data_parsley_length = "[9,10]" } })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("E-Mail Id", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.ObjResume.EMAIL_ID, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Email Id", @data_parsley_required = "true", @data_parsley_length = "[3,20]" } })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Religion", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.Religion, (Model.Religion != null) ? Model.Religion : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Subject", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.ObjResume.SUBJECT, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Subject", @data_parsley_required = "true", @data_parsley_length = "[3,20]" } })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" onclick="SubmitData()" class="btn btn-primary">Submit</a>
                <button type="button" data-dissmiss="modal"  class="btn btn-default">Cancel</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdResumeId" />

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('Refresh');
</script>

<script>
    function FetchResume(ID)
    {
        $.ajax({
            url: "@Url.Action("FetchStaffResumeById", "Staff")",
            type: "post",
            datatype: "json",
            data: { sResumeId: ID },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
               {
                   swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
               } else
                {
                   $('#hdResumeId').val(data[0].RESUME_ID);
                   $('#ObjResume_STAFF_NAME').val(data[0].STAFF_NAME);
                   $('#ObjResume_ADDRESS').val(data[0].ADDRESS);
                   $('#ObjResume_QUALIFICATION_ID').val(data[0].QUALIFICATION_ID);
                   $('#ObjResume_CONTACT_NO').val(data[0].CONTACT_NO);
                   $('#ObjResume_EMAIL_ID').val(data[0].EMAIL_ID);
                   $('#Religion').val(data[0].RELIGION_ID);
                   $('#ObjResume_SUBJECT').val(data[0].SUBJECT);
                   $('.selectpicker').selectpicker('refresh');
               }
            },
            error: function (ex)
            {
                swal({ title: "Error!", text: "Internal Server Error !", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function SubmitData()
    {
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }
        var sJson = '{"RESUME_ID":"' + $('#hdResumeId').val() + '",\
                      "STAFF_NAME":"' + $('#ObjResume_STAFF_NAME').val() + '",\
                      "ADDRESS":"' + $('#ObjResume_ADDRESS').val() + '",\
                      "QUALIFICATION_ID":"' + $('#ObjResume_QUALIFICATION_ID').val() + '",\
                      "CONTACT_NO":"' + $('#ObjResume_CONTACT_NO').val() + '",\
                      "EMAIL_ID":"' + $('#ObjResume_EMAIL_ID').val() + '",\
                      "RELIGION_ID":"' + $('#Religion').val() + '",\
                      "SUBJECT":"' + $('#ObjResume_SUBJECT').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveStaffResume", "Staff")",
            type: "post",
            datatype: "json",
            data: { sJson: sJson },
            success: function (data)
            {
                if (data.ErrorCode=="200") 
                {
                    $('#stfResume').modal('hide');
                    swal({ title: "Success!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/staff/ListStaffResume');
                } else
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            },
            error: function (ex)
            {
                swal({ title: "Error!", text: "Internal Server Error !", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function DeleteResume(ID)
    {
        if (!confirm('are you sure to delete ?')) 
        {
            return false;
        }
        $.ajax({
            url: "@Url.Action("DeleteResume", "Staff")",
            type: "post",
            datatype: "json",
            data: { sResumeId: ID },
            success: function (data)
            {
                if (data.ErrorCode=="200")
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/staff/ListStaffResume');
                } else
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            },
            error: function (ex)
            {
                swal({ title: "Error!", text: "Internal Server Error !", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>
