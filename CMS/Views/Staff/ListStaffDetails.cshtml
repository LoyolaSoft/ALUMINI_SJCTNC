@model CMS.ViewModel.ViewModel.StaffViewModel

@{
    ViewBag.Title = "ListStaffDetails";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;

}


<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;" @*href="@Url.Action("ADMIN","DashBoard")"*@>Home</a></li>
        <li class="active">List Staff Details</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Staff List</h1>
    <!-- end page-header -->
    <div class="row">
        @*<div id="dvStaffList"></div>*@
        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h3 class="panel-title">Staff List</h3>
            </div>
            <div class="panel-body">

                    <div class="form-group">
                        <div class="col-md-12">
                            <a class="btn btn-success pull-right" @*href="@Url.Action("StaffInfo", "Staff")"*@ href="javascript:;" onclick="loadContent('/Staff/StaffInfo')"><i class="fa fa-plus"> Add</i></a>
                        </div>
                    </div>
                    <br /><br />
                    <div class="form-group">
                        <div class="col-md-12 table-responsive">
                            @{int count = 0; }
                            <table id="StaffInfo" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>S.No</th>
                                        <th>Staff Code</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th>Gender</th>
                                        <th>Shift</th>
                                        <th>Date of Birth</th>
                                        <th>IS_LEFT</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.lstStaffList != null && Model.lstStaffList.Count>0)
                                    {
                                        foreach (var item in Model.lstStaffList)
                                        {
                                            <tr>
                                                <td>@{count++;} @count</td>
                                                <td>@Html.DisplayFor(modelItem => item.STAFF_CODE)</td>
                                                <td>@Html.DisplayFor(modelItem => item.FIRST_NAME)</td>
                                                <td>@Html.DisplayFor(modelItem => item.DEPARTMENT)</td>
                                                <td>@Html.DisplayFor(modelItem => item.GENDER_NAME)</td>
                                                <td>@Html.DisplayFor(modelItem => item.SHIFT_NAME)</td>
                                                <td>@Html.DisplayFor(modelItem => item.DATE_OF_BIRTH)</td>
                                                @if (item.IS_LEFT == "0")
                                                {
                                                    <td><i class="fa fa-close text-danger"></i></td>
                                                }
                                                else
                                                {
                                                    <td><i class="fa fa-check text-success"></i></td>
                                                }
                                                <td>
                                                    <a @*href="@Url.Action("EditStaffInfomation","Staff",new { id=@item.STAFFID})"*@ href="javascript:;" onclick="loadContent('/Staff/EditStaffInfomation/@item.STAFF_ID')"><i class="fa fa-edit text-primary"></i></a>
                                                    <a href="javascript:;" onclick="GetConfirm('@item.STAFF_ID' ,'@item.STAFF_CODE')"><i class="fa fa-trash text-danger"></i></a>
                                                </td>
                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td>No Data Found ...</td>
                                                        </tr>
                                                    }
                                </tbody>
                            </table>
                        </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        function ContentLoad() {
            // Document Ready Function .
            // GetStaffList();
            $("#StaffInfo").DataTable({
                dom: "lBfrtip", buttons: [{
                    extend: "copy", className: "btn-sm"
                }
                , {
                    extend: "excel", className: "btn-sm"
                }
                , {
                    extend: "print", className: "btn-sm"
                }
                ], responsive: !0,
                //"paging": false,
            });
        }
        //$(document).ready(function ()
        //{
        //    GetStaffList();
        //    // $("#StaffInfo").DataTable();
        //});
        // Get staff List ...
        GetStaffList=function()
        {
            $.ajax({
                url:"@Url.Action("StaffList", "Staff")",
                type: "json",
                success:function(data)
                {
                    $("#dvStaffList").empty();
                    $("#dvStaffList").append(data);
                    $("#StaffInfo").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                        , {
                            extend: "excel", className: "btn-sm"
                        }
                        , {
                            extend: "print", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": false,
                    });
                },error:function(error)
                {
                    alert('Internal Server Error');
                }
            });
        }


        // Delete Staff ...
        function GetConfirm(STAFFID, STAFFCODE)
        {
            if (!confirm('Are you sure to delete ?'))
            {
                return false;
            } else
            {
                $.ajax({
                    url:"@Url.Action("DeleteStaff", "Staff")",
                    method: "POST",
                    datatype:"json",
                    data: { sStaffId: STAFFID, UserName: STAFFCODE },
                    success:function(data)
                    {
                        alert(data);
                        loadContent('/Staff/ListStaffDetails');
                    },error:function(error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
</script>

