@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "ListRoleBasedApproval";
   Layout=null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Role Based Approver</li>
    </ol>
    <h1 class="page-header">List Role Based Approver</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Role Based Approver</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#rolebasedapprover" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblrolebasedapprover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Role Name</th>
                            <th>Approver Role</th>
                            <th>Approver Level</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.lirolebasedapproval != null && Model.lirolebasedapproval.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.lirolebasedapproval)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>
                                    <td>@item.ROLE_NAME</td>
                                    <td>@item.APPROVER_ROLE</td>
                                    <td>@item.LEVEL_NAME</td>
                                    <td>
                                        <a href="#rolebasedapprover" onclick="FetchRolebasedApproval(@item.APPROVAL_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.APPROVAL_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="rolebasedapprover">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="text" id="approvalid" class="hidden">
                                    
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Role</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Role", (Model.ROLE != null) ? Model.ROLE : Enumerable.Empty<SelectListItem>(),"--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "ddlrole" })
                                            @Html.ValidationMessageFor(model => model.ROLE, "", new { @class = "text-danger" })
                                        </div>
                                    </div> 
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Approver Role</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Approver Role", (Model.ROLE != null) ? Model.ROLE : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "ddlapproverrole" })
                                            @Html.ValidationMessageFor(model => model.ROLE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Approval Level</label>

                                        <div class="col-md-8">
                                            @Html.DropDownList("Approval Level", (Model.APPROVAL_LEVEL != null) ? Model.APPROVAL_LEVEL : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm itemddl", @data_live_search = "true", @data_parsley_required = "true", @id = "APPROVAL_LEVEL" })
                                            @Html.ValidationMessageFor(model => model.APPROVAL_LEVEL, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
  
    $('#tblrolebasedapprover').DataTable();

    function FetchRolebasedApproval(ID)
    {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchRoleBasedApprovalById", "Staff")",
                type: "post",
                data: { sApprovalId: ID },
                success: function (data)
                {
                    if (data != null)
                    {
                        $('#approvalid').val(data.APPROVAL_ID);
                        $('#ddlrole').val(data.ROLE_ID);
                        $('#ddlapproverrole').val(data.APPROVER_ROLE_ID);
                        $('#APPROVAL_LEVEL').val(data.APPROVAL_LEVEL);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function ()
    {
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }

        JsonData = '{"APPROVAL_ID":"' + $('#approvalid').val() + '","ROLE_ID":"' + $('#ddlrole').val() + '","APPROVER_ROLE_ID":"' + $('#ddlapproverrole').val() + '","APPROVAL_LEVEL":"' + $('#APPROVAL_LEVEL').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateRoleBasedApproval", "Staff")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {

                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Staff/ListRoleBasedApproval');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteRoleBasedApproval", "Staff")",
        type: "post",
        data: { sApprovalId: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Staff/ListRoleBasedApproval');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

    }


</script>









