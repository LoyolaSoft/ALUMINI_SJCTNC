@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    Layout = null;
}
<div class="table-responsive">

    @if (Model.lileaveapply != null && Model.lileaveapply.Count > 0 && Model.lirolebasedapproval != null && Model.lirolebasedapproval.Count > 0)
    {
        var grouplevel = @Model.lirolebasedapproval.GroupBy(o => o.APPROVAL_LEVEL).ToList();

        <input type="text" class="form-control hidden" id="leaveapplyid" value="@Model.lileaveapply.FirstOrDefault().LEAVE_APPLY_ID">


        <div class="">
            <center>
                <img src="@Model.lileaveapply.FirstOrDefault().PHOTO" style="height:80px;width:110px">
            </center>
            <br>
            <br>
            <div class="col-md-12">

                <div class="form-group col-md-12">
                    @Html.Label("Staff Code", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        <label>@Model.lileaveapply.FirstOrDefault().STAFF_CODE</label>
                    </div>
                </div>



                <div class="form-group col-md-12">
                    @Html.Label("Name", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        <label>@Model.lileaveapply.FirstOrDefault().FIRST_NAME</label>
                    </div>
                </div>

            </div>

            <div class="col-md-12">
                <div class="form-group col-md-12">
                    @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        <div class="alert alert-info">@Model.lileaveapply.FirstOrDefault().DESCRIPTION</div>
                    </div>
                </div>
                <input type="text" class="hidden" id="lel1" value="@Model.lileaveapply.FirstOrDefault().APPROVAL_STATUS1">

                <input type="text" class="hidden" id="lel2" value="@Model.lileaveapply.FirstOrDefault().APPROVAL_STATUS2">

                @if (grouplevel.Exists(o => o.FirstOrDefault().APPROVAL_LEVEL == "1"))
                {
                    <div class="col-md-12 form-group">
                        @Html.Label("Level-1", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <select class="selectpicker form-control" data-live-search="true" id="level1" onchange="Bindvalue1()">
                                <option value="0">--Select--</option>
                                @foreach (SelectListItem option in Model.LeaveStatus)
                                {
                                    <option value="@option.Value" @(option.Value == Model.lileaveapply.FirstOrDefault().APPROVAL_STATUS1 ? "selected='selected'" : "")>@option.Text</option>

                                }
                            </select>

                        </div>
                    </div>
                }
                @if (grouplevel.Exists(o => o.FirstOrDefault().APPROVAL_LEVEL == "2"))
                {
                    <div class="col-md-12 form-group">
                        @Html.Label("Level-2", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <select class="selectpicker form-control" data-live-search="true" id="level2" onchange="Bindvalue2()">
                                <option value="0">--Select--</option>
                                @foreach (SelectListItem option in Model.LeaveStatus)
                                {
                                    <option value="@option.Value" @(option.Value == Model.lileaveapply.FirstOrDefault().APPROVAL_STATUS2 ? "selected='selected'" : "")>@option.Text</option>

                                }
                            </select>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No  Record Found..!
        </div>
    }
</div>

<script>
    function Bindvalue1() {
        $('#lel1').val($('#level1').val());
    }
    function Bindvalue2() {
        $('#lel2').val($('#level2').val());
    }
</script>