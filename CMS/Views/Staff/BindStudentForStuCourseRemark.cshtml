@model CMS.ViewModel.ViewModel.StaffViewModel
@{ Layout = null; int count = 0;}

@if (Model.liCIA_Staff_Info != null && Model.liCIA_Staff_Info.Count > 0)
{
    <div class="invoice-header">
        <div class="invoice-from">
            <small></small>
            <address class="m-t-5 m-b-5">
                <strong>
                    <label>Course Name : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().COURSE_TITLE</span>
                </strong><br />
                <strong>
                    <label>Course Code &nbsp; : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().COURSE_CODE</span>
                </strong><br />
                <strong>
                    <label>Department : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().DEPARTMENT</span>
                </strong><br />
            </address>
        </div>
        <div class="invoice-to">
            <small></small>
            <address class="m-t-5 m-b-5">
                <strong>
                    <label>Staff Name(s) : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().STAFF_NAME</span>
                </strong><br />
                <strong>
                    <label>Semester  &nbsp; : </label><span class="semi-bold" id="sSemester"> @Model.liCIA_Staff_Info.FirstOrDefault().SEMESTER_ID</span>
                </strong><br />
                <strong>
                    <label>Class Name : </label><span class="semi-bold"> @Model.liCIA_Staff_Info.FirstOrDefault().CLASS_NAME</span>
                </strong><br />

            </address>
        </div>

    </div>
    <br />
}
<div class="table-responsive col-md-12">
    <table class="table table-bordered table-hover" id="tblAddStuCourseRemark">
        <thead>
            <tr>
                <th width="5px">
                    #
                </th>                
                <th >
                     Register No                    
                </th>
                <th>
                    Roll No
                </th>                
                <th>
                    Name
                </th>
                <th>
                    Mark
                </th>
                <th width="30%">
                    Remark
                </th>               
            </tr>
        </thead>
        <tbody>
            @if (Model.liStu_Course_Remark != null && Model.liStu_Course_Remark.Count > 0)
            {
                foreach (var item in Model.liStu_Course_Remark)
                {
                    <tr cms-remarkid="@item.REMARK_ID" cms-classid="@item.CLASS_ID" cms-cousrseid="@item.COURSE_ID"  cms-studentid="@item.STUDENT_ID" cms-cia-group-id="@item.COURSE_GROUP_ID">
                        <td width="5px">
                            @{ count++;}
                            @count
                        </td>                                            
                        <td>
                            @Html.DisplayFor(m => item.REGISTER_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.ROLL_NO)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.STUDENT_NAME)
                        </td>
                        <td>
                            @Html.DisplayFor(m => item.COURSE_GROUP_MARK)
                        </td>
                        <td width="30%">
                            <input id="" class="form-control" type="text" style='height:50px;width:300px;' value="@item.REMARK" maxlength="200"  />
                        </td>                        
                    </tr>
                                    }
                                }

        </tbody>
    </table>
</div>
