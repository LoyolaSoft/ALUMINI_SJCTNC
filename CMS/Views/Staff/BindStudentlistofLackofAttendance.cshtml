@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    Layout = null;
    int count = 0;
}
<div class="col-md-12">
    <table class="table table-bordered" id="tblstudent">
        <thead>
            <tr>
                <th>#</th>
                <th>Roll No</th>
                <th>First Name</th>
                <th>Class</th>
                <th>Attendance Percentage</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
            {
                foreach (var item in Model.liStudentList)
                {
                    count++;
            <tr>
                <td>@count</td>
                <td>@item.ROLL_NO</td>
                <td>@item.FIRST_NAME</td>
                <td>@item.CLASS_NAME</td>
                <td>@item.ATTENDANCE_PERCENTAGE%</td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>
