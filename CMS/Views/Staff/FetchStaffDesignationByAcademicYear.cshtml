@model CMS.ViewModel.ViewModel.StaffViewModel
@{ Layout = null; int count = 0;}
<div class="table-responsive col-md-12">
    <table class="table table-bordered table-hover" id="tblStaffDesignation">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    Staff Code
                </th>
                <th>
                    staff_Name
                </th>
                <th>
                    Category
                </th>
                <th>
                    Department
                </th>
                <th>
                    Designation
                </th>
                <th>
                    Incharge
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStfDesignation != null && Model.liStfDesignation.Count > 0)
            {
                var staffId = Model.liStfDesignation.GroupBy(O => O.STAFF_ID).ToList();
                foreach (var items in staffId)
                {
                    <tr cms-desingationId="@items.FirstOrDefault().DESIGNATION_ID" cms-staffId="@items.FirstOrDefault().STAFF_ID">
                        <td>
                            @{ count++;}
                            @count
                        </td>


                        <td>
                            @Html.DisplayFor(m => items.FirstOrDefault().STAFF_CODE)
                        </td>


                        <td>
                            @Html.DisplayFor(m => items.FirstOrDefault().FIRST_NAME)
                        </td>


                        <td>
                            @Html.DisplayFor(m => items.FirstOrDefault().CATEGORY)
                        </td>


                        <td>
                            @Html.DisplayFor(m => items.FirstOrDefault().DEPARTMENT)
                        </td>


                        <td>


                            <div>
                                @if (Model.liDesignation != null)
                                {
                                    var designation = Model.liStfDesignation.Where(o => o.STAFF_ID == items.FirstOrDefault().STAFF_ID).ToList();
                                    string sSelected = string.Empty;
                                    <select class="form-control m-b-10 selectpicker" id="ddlDesignation" data-live-search="true" multiple>
                                        <option value="0">--Select--</option>
                                        @if (designation != null && designation.Count > 0)
                                        {
                                            foreach (var iDesignation in Model.liDesignation)
                                            {
                                                foreach (var item in designation)
                                                {
                                                    if (item.DESIGNATION == iDesignation.DESIGNATIONID)
                                                    {
                                                        sSelected = "selected";
                                                    }
                                                }
                                                <option value="@iDesignation.DESIGNATIONID" @sSelected>@iDesignation.DESIGNATION</option>
                                                sSelected = string.Empty;
                                            }
                                        }
                                        else
                                        {

                                            foreach (var iDesignation in Model.liDesignation)
                                            {
                                                if (items.FirstOrDefault().DESIGNATION == iDesignation.DESIGNATIONID)
                                                {
                                                    sSelected = "selected";
                                                }
                                                else
                                                {
                                                    sSelected = string.Empty;
                                                }

                                                <option value="@iDesignation.DESIGNATIONID" @sSelected>@iDesignation.DESIGNATION</option>
                                            }
                                        }
                                        
                                        
                                    </select>
                                }
                            </div>
                        </td>
                        <td>
                            @*<div>
                                    @if (Model.liInchargeStaff != null)
                                    {

                                        string sSelected = string.Empty;
                                        <select class="form-control m-b-10 selectpicker" id="ddlIncharge" data-live-search="true">
                                          <option value="0">--Select--</option>
                                            @foreach (var liIncharge in Model.liInchargeStaff)
                                            {
                                                if (item.INCHARGE == liIncharge.STAFF_ID)
                                                {
                                                    sSelected = "selected";
                                                }
                                                else
                                                {
                                                    sSelected = string.Empty;
                                                }

                                                <option value="@liIncharge.STAFF_ID" @sSelected>@liIncharge.FIRST_NAME</option>
                                            }
                                        </select>
                                    }
                                </div>*@
                        </td>
                    </tr>
                                    }
                                }

        </tbody>
    </table>
</div>
