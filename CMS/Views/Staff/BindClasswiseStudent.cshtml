@model CMS.ViewModel.ViewModel.StaffViewModel
@{ 
    Layout = null;
}
<table class="table table-hover table-bordered" id="tblstudent">
    <thead>
        <tr>
            <th>#</th>
            <th>Roll No</th>
            <th>Register No</th>
            <th>Name</th>
            <th>Attendance</th>
            <th>CIA Mark</th>
            <th>Sem Mark</th>
            <th>Profile</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
        {
            var count = 0;
            foreach (var item in Model.liStudentList)
            {
                count = count + 1;

                <tr>
                    <td>@count</td>

                    <td>@item.ROLL_NO</td>
                    <td>@item.REGISTER_NO</td>
                    <td>@item.FIRST_NAME</td>
                 
                    <td><a href="#attendance" onclick="Attendance(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a></td>
                    <td><a href="#ciamark" onclick="CIAMark(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a></td>
                    <td><a href="#semmark" onclick="SemMark(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a></td>
                    <td><a href="#profile" onclick="Profile(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a></td>
                </tr>
            }

        }
    </tbody>
</table>