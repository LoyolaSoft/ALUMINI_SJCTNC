                                ,"ACADEMIC_YEAR":"'+ ACADEMIC_YEAR + '"\
                            } ';
                        }
            $.ajax({
                url:"@Url.Action("SaveStaffPersonal", "Staff")",
                method: "POST",
                datatype: "html",
                data: { str: JsonData, sBaseImage: photo.base64String, sExtension: photo.sextension },
                success: function (data)
                {

                    if (data.Message == "200") {
                        swal({ title: "Success !", text: 'Record(s) saved successfully !', showConfirmButton: false, timer: 4000, type: 'success', animation: true });
                        loadContent('/Staff/StaffDetailsforEdit');
                    }
                    else if (data.Message == "406") {
                        swal({ title: "Failed !", text: 'Failed to save Records !', showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                    }
                    else if (data.Message == "409") {
                        swal({ title: "Warning !", text: 'Student Already Exits ...!', showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                    }
                    else {
                        swal({ title: "Failed !", text: 'Something Wrong Check Your Input!', showConfirmButton: false, timer: 3000, type: 'error', animation: true });

                    }
                }, error: function (error)
                {

                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        });



</script>

