                                ,"SPECIAL_ALLOWANCE":"'+ SPECIAL_ALLOWANCE + '"\
                                ,"OTHERS_SALARY":"'+ OTHERS_SALARY + '"\
                                ,"PP_SALARY":"'+ PP_SALARY + '"\
                                ,"GROSS_SALARY":"'+ GROSS_SALARY + '"\
                                ,"BANK_AC_NO":"'+ BANK_AC_NO + '"\
                                ,"IS_LEFT":"'+ Is_left + '"\
                                ,"DATE_OF_EPF":"'+ DATE_OF_EPF + '"\
