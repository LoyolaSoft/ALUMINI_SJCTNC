        function ContentLoad()
        {
            // Document Ready Function .
            Notification.init();

            HandleDatePicker = function ()
            {
                "use strict";
                $("#DATE_OF_BIRTH,#DATE_OF_JOIN,#DATE_OF_ENTRY_TEACHING,#LEAVING_DATE,#DATE_OF_EPF").datepicker({
                    todayHighlight: true,
                    autoclose: true,
                    endDate: new Date(),
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                })
                $("#RETIREMENT_DATE").datepicker({
                    todayHighlight: true,
                    autoclose: true,
                    endDate: false,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                })
            }
            HandleDatePicker();

            // PersonalInfo ....
            PersonalInfo= function ()
            {
                $.ajax({
                    url: "@Url.Action("StaffPersoanlInfo", "Staff")",
                    method: "POST",
                    datatype: "html",
                    success: function (data)
                    {
                        $('#dvPersonal').empty();
                        $('#dvPersonal').append(data);
                        $('.selectpicker').selectpicker('refresh');
                    }, error: function (error)
                    {
                        alert('Internal Server Error ..!');
                    }
                });
        }
        // PersonalInfo();
        }


