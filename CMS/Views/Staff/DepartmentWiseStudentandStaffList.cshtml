@model CMS.ViewModel.ViewModel.StaffViewModel
@{
    ViewBag.Title = "DepartmentWiseStudentandStaffList";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/css/jquery.jqGauges.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/morris/morris.css" rel="stylesheet" />


<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#" onclick="loadContent('@Url.Action("ADMIN","DashBoard")')"></a></li>
       
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-default panel-with-tabs" data-sortable-id="ui-unlimited-tabs-2">
        <div class="panel-heading p-0">
            <div class="panel-heading-btn m-r-10 m-t-10">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-inverse" data-click="panel-expand"><i class="fa fa-expand"></i></a>
            </div>
            <!-- begin nav-tabs -->
            <div class="tab-overflow" data-parsley-validate="true" name="form-wizard">
                <ul class="nav nav-tabs">
                    @*<li class="prev-button"><a href="javascript:;" data-click="prev-tab" aria-controls="first" class="text-inverse"><i class="fa fa-arrow-left"></i></a></li>*@

                    <li class="nav-item active" id="studentlist"><a href="#nav-tab1-1" class="nav-link active" data-toggle="tab">Student List</a></li>
                    <li class="" id="stafflist"><a href="#nav-tab1-2" data-toggle="tab">Staff List</a></li>
                    
                </ul>
            </div>
        </div>
        <div class="panel-body">
            <div class="tab-content">
                <div class="tab-pane fade active in" id="nav-tab1-1" data-parsley-validate="true">                   
                    <div class="col-md-12" id="studentlist">
                        @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
                        {
                            <table class="table table-hover table-bordered" id="tblstudent">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Class</th>
                                        <th>Roll No</th>
                                        <th>Register No</th>
                                        <th>Name</th>
                                        <th>DOB</th>
                                        <th>Mobile</th>
                                        <th>Profile</th>

                                        
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.liStudentList != null && Model.liStudentList.Count > 0)
                                    {
                                        var count = 0;
                                        foreach (var item in Model.liStudentList)
                                        {
                                            count = count + 1;

                                            <tr>
                                                <td>@count</td>
                                                <td>@item.CLASS_NAME</td>
                                                <td>@item.ROLL_NO</td>
                                                <td>@item.REGISTER_NO</td>
                                                <td>@item.FIRST_NAME</td>
                                                <td>@item.DATE_OF_BIRTH</td>
                                                <td>@item.STU_MOBILENO</td>
                                                <td><a href="#studentprofile" onclick="StudentProfile(@item.STUDENT_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a></td>
                                            </tr>
                                        }

                                    }
                                </tbody>
                            </table>
                        }
                    </div>                                 
                </div>
                <div class="tab-pane fade" id="nav-tab1-2" data-parsley-validate="true">                   
                    <div class="col-md-12" id="stafflist">
                        @if (Model.lstStaffList != null && Model.lstStaffList.Count > 0)
                        {
                            <table class="table table-hover table-bordered" id="tblstaff">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Staff Code</th>
                                        <th>Name</th>
                                        <th>DOB</th>
                                        <th>DOJ</th>
                                        <th>Shift</th>
                                        <th>Profile</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.lstStaffList != null && Model.lstStaffList.Count > 0)
                                    {
                                        var count = 0;
                                        foreach (var item in Model.lstStaffList)
                                        {
                                            count = count + 1;

                                            <tr>
                                                <td>@count</td>

                                                <td>@item.STAFF_CODE</td>
                                                <td>@item.FIRST_NAME</td>
                                                <td>@item.DATE_OF_BIRTH</td>
                                                <td>@item.DATE_OF_JOIN</td>
                                                <td>@item.SHIFT_NAME</td>
                                                <td><a href="#staffprofile" onclick="StaffProfile(@item.STAFF_ID)" data-toggle="modal" class="btn btn-primary text-primary"><i style="color:white" class="glyphicon glyphicon-eye-open" title="View"></i></a></td>

                                            </tr>
                                        }

                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    
                </div>
           
            </div>
        </div>
    </div>
    <!-- end panel -->
</div>
<div class="modal" id="studentprofile">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Student Profile</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div id="divstudentprofile">

                </div>
            </div>

        </div>

    </div>
</div>
<div class="modal" id="staffprofile">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Staff Profile</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div id="divstaffprofile">

                </div>
            </div>

        </div>

    </div>
</div>
<script src="~/Content/assets/plugins/morris/raphael.min.js"></script>
<script src="~/Content/assets/plugins/morris/morris.js"></script>
<script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap.min.js"></script>
<script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap-world-merc-en.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    $('#tblstaff,#tblstudent').DataTable({});
    function StaffProfile(ID)
    {
       
        if(ID!=null && ID!='')
        {
            $.ajax({
                url: "@Url.Action("BindStaffProfile", "Staff")",
                type: "post",
                data: { sStaffId: ID },
            success: function (data)
            {
                $('#divstaffprofile').empty();
                $('#divstaffprofile').append(data);
            },
            error: function (ex) {
                alert(ex.Message);
            }
        });
        }
    }
    function StudentProfile(ID)
    {
      
        if(ID!=null && ID!='')
        {
            $.ajax({
                url: "@Url.Action("BindStudentProfile", "Staff")",
                type: "post",
                data: { sStudentId: ID },
            success: function (data)
            {
                $('#divstudentprofile').empty();
                $('#divstudentprofile').append(data);
            },
            error: function (ex) {
                alert(ex.Message);
            }
        });
    }
    }
    
</script>
