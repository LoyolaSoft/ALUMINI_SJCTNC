@model CMS.ViewModel.ViewModel.StaffViewModel
@{ 
    Layout = null;
}
<div class="table-responsive">
    @if (Model.lstStaffList != null && Model.lstStaffList.Count > 0)
    {


        <div class="">
            <center>
                <img src="@Model.lstStaffList.FirstOrDefault().PHOTO" style="height:80px;width:110px">
            </center>
            <br>
            <br>
            <div class="col-md-12">

                <div class="form-group col-md-12">
                    @Html.Label("Staff Code", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        <label>@Model.lstStaffList.FirstOrDefault().STAFF_CODE</label>
                    </div>
                </div>



                <div class="form-group col-md-12">
                    @Html.Label("Name", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        <label>@Model.lstStaffList.FirstOrDefault().FIRST_NAME</label>
                    </div>
                </div>

            </div>
            <div class="form-group col-md-12">
                @Html.Label("Gender", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().GENDER_NAME</label>
                </div>
            </div>

            <div class="form-group col-md-12">
                @Html.Label("DOB", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().DATE_OF_BIRTH</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("DOJ", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().DATE_OF_JOIN</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().SHIFT_NAME</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Religion", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().RELIGION</label>
                </div>
            </div>
            <div class="form-group col-md-12">
                @Html.Label("Mobile No", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().MOBILE_NO</label>
                </div>
            </div>

            <div class="form-group col-md-12">
                @Html.Label("Address", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    <label>@Model.lstStaffList.FirstOrDefault().ADDRESS</label>
                </div>
            </div>


        </div>
    }
    else
    {
        <div class="alert alert-info">
            No  Record Found..!
        </div>
    }
</div>

