@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{
    ViewBag.Title = "DailyAbsenteesSMS";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Daily Absentees SMS</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Daily Absentees SMS</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Daily Absentees SMS</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        @*<div class="form-group col-md-4">
                                <label class="control-label col-md-5">Date To</label>
                                <div class="col-md-7">
                                    <div class="input-group date" id="datetimepicker2">
                                        <input type="text" id="txtDateTo" class="form-control input-sm" placeholder="Select Date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>*@
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Shift, "App.Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Shift, "Shift", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgrammeMode, "Pro.Mode", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeMode, (Model.ProgrammeMode != null) ? Model.ProgrammeMode : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeMode, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgrammeList, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Hours, "Hours", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Hours, (Model.Hours != null) ? Model.Hours : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.Hours, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1 ">
                            <a class="btn btn-primary pull-right" id="btnGet">Get</a>
                        </div>
                    </div>
                    @*<div class="form-group col-lg-12">
                            <div class="form-group col-md-1 ">
                                <a class="btn btn-primary pull-right" id="btnGet">Get</a>
                            </div>
                        </div>*@
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="dvAbsentReportBind"></div>
                    <a class="btn btn-primary" id="btnSendSMS">Send SMS</a>
                </div>
            }
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>

    $('.selectpicker').selectpicker({
        size: 6
    });

    function ContentLoad() {
    }

    $('#btnGet').on('click', function () {
        loadGird();
    });

    $('#btnSendSMS').on('click', function () {        
        SendAbsenteesSMS();
    });
    $("#ProgrammeMode").on("change", function () {
        LoadProgramme();
    });
    LoadProgramme = function () {
        var ShiftList = String($('#Shift').val());
        var ApplicationType = String($('#ApplicationType').val());
        var ProgrammeModeList = String($('#ProgrammeMode').val());
        if (ShiftList != 0 && ProgrammeModeList != 0) {
            $.ajax({
                url: "@Url.Action("BindProgrammesByShiftAndProgrammeMode", "Communication")",
                method: "POST",
                datatype: "json",
                data: { sShift: ShiftList, sProgrammeMode: ProgrammeModeList, sApplicationType: ApplicationType },
                success: function (data) {
                    $("#ProgrammeList").empty();
                    $("#ProgrammeList").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        } else {
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    };
    function loadGird() {
        var programmeGroupId = String($('#ProgrammeList').val());
        var Hours = String($('#Hours').val());
        if (programmeGroupId != 0 && Hours != 0) {
            $.ajax({
                url: "@Url.Action("BindAbsenteeslistByCurrentDate", "Communication")",
                method: "POST",
                datatype: "json",
                data: { sProgrammeGroupIds: programmeGroupId, sHoursIds: Hours },
                success: function (data) {
                    $("#dvAbsentReportBind").empty();
                    $("#dvAbsentReportBind").append(data);

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }

    };
    function SendAbsenteesSMS() {
        var programmeGroupId = String($('#ProgrammeList').val());
        var Hours = String($('#Hours').val());
        if (programmeGroupId != 0 && Hours != 0) {
            $.ajax({
                url: "@Url.Action("SendSMSAbsenteeslistByCurrentDate", "Communication")",
                method: "POST",
                datatype: "json",
                data: { sProgrammeGroupIds: programmeGroupId, sHoursIds: Hours },
                success: function (data) {
                    alert(data.Message);
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    };
</script>