@model CMS.ViewModel.ViewModel.CommunicationViewModel
@using CMS.Utility
@{
    ViewBag.Title = "GeneralMail";
    Layout = null;
}
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div id="content" class="content">
        <div class="form-horizontal">
            <!-- BEGIN breadcrumb -->
            <ul class="breadcrumb pull-right">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item active">General EMail>
            </ul>
            <!-- END breadcrumb -->
            <h1 class="page-header">
                General EMail
            </h1>
            <div class="panel panel-primary">
                <div class="panel-heading bg-primary">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">General EMail</h4>
                </div>
                <div class="form-horizontal">
                    <div class="panel-body">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-md-12">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label class="col-md-3 control-label pull-left">SMS for</label>
                                    <div class="col-md-9">
                                        <div class="radio radio-css radio-success radio-inline">
                                            <input type="radio" name="inline_radio" id="rbtnStudent" value="1" />
                                            <label for="rbtnStudent">
                                                Student
                                            </label>
                                        </div>
                                        <div class="radio radio-css radio-warning radio-inline">
                                            <input type="radio" name="inline_radio" id="rbtnStaff" value="2" />
                                            <label for="rbtnStaff">
                                                Staff
                                            </label>
                                        </div>
                                        <div class="radio radio-css radio-primary radio-inline">
                                            <input type="radio" name="inline_radio" id="rbtnHostel" value="2" />
                                            <label for="rbtnHostel">
                                                Hostel
                                            </label>
                                        </div>
                                        <div class="radio radio-css radio-pink radio-inline">
                                            <input type="radio" name="inline_radio" id="rbtnBoth" value="3" />
                                            <label for="rbtnBoth">
                                                Both
                                            </label>
                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group pull-left">
                                    <label class="col-md-2 control-label">Type</label>
                                    <div class="col-md-9">
                                        <div class="radio radio-css radio-inline radio-primary">
                                            <input type="radio" name="radio-inline" id="rbtnAll" value="1" checked />
                                            <label for="rbtnAll">
                                                All
                                            </label>
                                        </div>
                                        <div class="radio radio-css radio-inline radio-primary">
                                            <input type="radio" name="radio-inline" id="rbtnIndividual" value="2" />
                                            <label for="rbtnIndividual">
                                                Individual
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="col-md-6 col-md-offset-4 control-label">
                                        Record Count
                                    </label>
                                    <div class="col-md-2">
                                        <label class="label label-danger" id="lblCount" clientidmode="static">0</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <br><br>
                            <div class="col-md-8 hidden" id="divClass" clientidmode="static">
                                <div class="form-group">
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.Programme, "Programmee", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5, @multiple = "multiple", @data_actions_box = "true" })
                                            @Html.ValidationMessageFor(model => model.Programme, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5, @multiple = "multiple", @data_actions_box = "true" })
                                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-1 pull-left">
                                        <a class="btn btn-primary input-sm" id="btnGetClass">Get</a>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6 hidden" id="divStaffCategory" clientidmode="static">
                                <div class="form-group">
                                    <div class="form-group col-md-10">
                                        @Html.LabelFor(model => model.StaffType, "Staff Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            @Html.DropDownListFor(model => model.StaffCategoryList, (Model.StaffCategoryList != null) ? Model.StaffCategoryList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_size = 5, @multiple = "multiple", @data_actions_box = "true" })
                                            @Html.ValidationMessageFor(model => model.StaffCategoryList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <a class="btn btn-primary input-sm" id="btnStaffCategory">Get</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="hidden" id="BindInformation">

                            </div>
                        </div>
                        <div class="col-lg-12">
                            <br />
                            <label class="control-label pull-left"> &nbsp;&nbsp;&nbsp; Message Content</label>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <div class="radio-inline">
                                        <input type="radio" name="radio-Message" id="rbtnText" value="1" checked />
                                        <label for="rbtnText">Text</label>
                                    </div>

                                    @*<div class="radio-inline">
                                            <input type="radio" name="radio-Message" id="rbtnLanguage" value="3" />
                                            <label for="rbtnLanguage">Language</label>
                                        </div>*@
                                </div>
                            </div>

                            @*<div class="col-md-2 pull-right">
                                    <div class="form-group hidden" id="dvOpLanguage">
                                        <label class="control-label">Language</label>&nbsp;&nbsp;&nbsp;&nbsp;
                                        <div id='translControl' class="control-label"></div>

                                    </div>
                                </div>*@

                            <div class="col-lg-4 hidden" id="dvLagType">
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Language Type</label>
                                    <div class="col-sm-7">
                                        <div class="radio-inline">
                                            <input type="radio" name="radio-Language" id="rbtnEng" value="1" checked />
                                            <label for="rbtnEng">
                                                English
                                            </label>
                                        </div>
                                        <div class="radio-inline">
                                            <input type="radio" name="radio-Language" id="rbtnOthers" value="2" />
                                            <label for="rbtnOthers">
                                                Others
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>

                        <div class="col-lg-12">
                            <label class="col-sm-3 control-label">content</label>
                            <textarea name="text" class="summernote form-control" id="txtEmailContent" title="Contents"></textarea>
                            <br />
                        </div>
                        @*<div class="col-md-12">
                                <div class="col-md-12">
                                    <label class="control-label">
                                        Message
                                    </label>
                                    <textarea id="txtMessageContent" rows="5" cols="10" class="form-control tamil" maxlength="612"></textarea>
                                </div>
                            </div>*@
                        <div class="col-md-12"></div>
                        <br><br>
                        <div class="col-md-12">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="col-md-8">
                                        <input type="email" name="email" value="" class="form-control m-b-5 input-sm" id="txtTestEmailId" placeholder="eg:example@gmail.com" title="Enter valid mailId" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" id="btnTestMail" class="btn btn-warning w-md waves-effect waves-light m-b-5 input-sm">Test</button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 ">
                                <button type="reset" id="btnClear" Style="margin-left: 5px;" class="pull-right btn btn-danger m-b-5 input-sm">Clear</button>
                                <button type="button" id="btnSendSMS" class="pad pull-right btn btn-success input-sm">Send</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/TamilFont/tamil.js"></script>
<script src="~/Content/assets/TamilFont/utf.js"></script>

<script>
    $('.selectpicker').selectpicker({
        size: 5
    });

    function ContentLoad() {
        $("#txtEmailContent").summernote();
        // Document Ready Function .
        $("#StaffType option[value='@Common.SupRole.STUDENT']").remove();
        //function for txtmessage
        var text_max = 612;
        $('#divCharCount').html(text_max + 'Total characters');
    }
</script>
<script>
    var sCreditCount = null;
    $("#rbtnStudent").on('click', function () {
        $("#lblCount").text('0');
        if ($("#rbtnStudent").attr("checked", "checked")) {
            $("#divClass").removeClass("hidden");
            $('#BindInformation').addClass("hidden");
            $('#btnGetClass').addClass("hidden");
            $("#divStaffCategory").addClass("hidden");
            if ($('#rbtnIndividual').is(":checked")) {
                $('#btnGetClass').removeClass("hidden");
            }
        }
    });
    $("#rbtnStaff").on('click', function () {
        $("#lblCount").text('0');
        $('#BindInformation').addClass("hidden");
        $("#divClass").addClass("hidden");
        $("#divStaffCategory").removeClass("hidden");
        if ($('#rbtnAll').is(":checked")) {
            $("#btnStaffCategory").addClass("hidden");
        }
        else {
            $("#btnStaffCategory").removeClass("hidden");
        }
    });
    $("#rbtnBoth").on('click', function () {
        if ($('#rbtnAll').is(":checked")) {
            BothRecordCount();
            $("#divClass").addClass("hidden");
            $("#divStaffCategory").addClass("hidden");
        }
        else {
            return false;
        }
    });
    $("#rbtnHostel").on('click', function () {
        if ($('#rbtnAll').is(":checked")) {
            HostelRecordCount();
            $("#divClass").addClass("hidden");
            $("#divStaffCategory").addClass("hidden");
        }
        else {
            return false;
        }
    });
    $("#rbtnAll").on('click', function () {
        $('#BindInformation').addClass("hidden");
        //if ($('#rbtnStaff').is(":checked")) {
        //    StaffRecordCount();
        //}
        if ($('#rbtnBoth').is(":checked")) {
            BothRecordCount();
            $("#divClass").addClass("hidden");
            $("#divStaffCategory").addClass("hidden");
        }
        $('#btnStaffCategory').addClass("hidden");
        $('#btnGetClass').addClass("hidden");
    });
    $("#rbtnStudent").on('change', function () {
        $("#Programme").val('');
        $("#StaffType").val('');
        $("#ClassList").empty();
        $('.selectpicker').selectpicker('refresh');
    });
    $("#rbtnAll").on('change', function () {
        $("#Programme").val('');
        $("#StaffType").val('');
        $("#ClassList").empty();
        $('.selectpicker').selectpicker('refresh');
    });
    $("#rbtnBoth").on('change', function () {
        $("#Programme").val('');
        $("#StaffType").val('');
        $("#ClassList").empty();
        $('.selectpicker').selectpicker('refresh');
    });
    $("#rbtnStaff").on('change', function () {
        $("#Programme").val('');
        $("#StaffType").val('');
        $("#ClassList").empty();
        $('.selectpicker').selectpicker('refresh');
    });
    $("#rbtnIndividual").on('change', function () {
        $("#Programme").val('');
        $("#StaffType").val('');
        $("#ClassList").empty();
        $('.selectpicker').selectpicker('refresh');
    });
    $('#rbtnIndividual').on('click', function () {
        var staff = $('#rbtnStaff:checked').length;
        var student = $('#rbtnStudent:checked').length;
        var both = $('#rbtnBoth:checked').length;
        if (both) {
            alert('Please Do not choose both for Individual Message!!!');
            return false;
        }
        if (!student && !staff && !both) {
            alert('Please Choose SMS Option...!!!');
            return false;
        }
        if (student) {
            $('#btnGetClass').removeClass("hidden");
            $("#lblCount").text('0');
        }
        if (staff) {
            $('#btnStaffCategory').removeClass("hidden");
            $("#lblCount").text('0');
        }
    });
    $('#rbtnBoth').on('click', function () {
        var both = $('#rbtnIndividual:checked').length;
        if (both) {
            alert('Please Do not choose both for Individual Message...!!!');
            return false;
        }
    });

</script>
<script>
    $('#btnTestMail').click(function () {
        alert('test');
        var str;
        var vTestEmailId = $('#txtTestEmailId').val();
        var vEmailContent = $('#txtEmailContent').summernote('code');
        str = btoa(vEmailContent);
        if (vTestEmailId != null && vEmailContent != null) {
            $.ajax({
                url: "@Url.Action("SendTestEmail", "Communication")",
                method: "POST",
                datatype: "json",
                data: { sTestEmailId: vTestEmailId, sEmailContent: str },
                success: function (data) {
                    alert(data.Message);
                }, error: function (error) {
                    alert("Internal Server Error ...!!!");
                }
            });
        }
    });
</script>
<script>
    $('#Programme').on("change", function () {
        var vDepartment = String($('#Programme').val());
        $.ajax({
            url: '@Url.Action("GetClassByDepartmentIds", "Communication")',
            data: { sDepartmentIds: vDepartment },
            success: function (objResult) {
                if (objResult.Message != null) {
                    alert(objResult.Message);
                }
                else {
                    $('#ClassList').empty();
                    $('#ClassList').append(objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    });
    $('#ClassList').on("change", function () {
        var vClass = String($('#ClassList').val());
        if ($('#rbtnAll').is(":checked")) {
            $.ajax({
                url: '@Url.Action("FetchClasswiseRecordsCount", "Communication")',
                method: "POST",
                datatype: "json",
                data: { sClassIds: vClass },
                success: function (data) {
                    if (data.Message != null) {
                        alert(data.Message);
                    }
                    if (data.sResult != null) {
                        $('#lblCount').text(data.sResult);
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            })
        }
        else {
            return false;
        }
    });
    $('#StaffCategoryList').on("change", function () {
        var vRole = String($('#StaffCategoryList').val());
        if ($('#rbtnAll').is(":checked")) {
            $.ajax({
                url: '@Url.Action("FetchStaffRecordsCount", "Communication")',
                method: "POST",
                datatype: "json",
                data: { sRole: vRole },
                success: function (data) {
                    if (data.Message != null) {
                        alert(data.Message);
                    }
                    if (data.sResult != null) {
                        $('#lblCount').text(data.sResult);
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            })
        }
        else {
            return false;
        }
    });
    //GetBtn Clicked to get ClassWiseStudentDetails
    $('#btnGetClass').on("click", function () {
        var vClassList = String($('#ClassList').val());
        $("#lblCount").text('0');
        if (vClassList.length != 0 && vClassList != "null") {
            if ($("#rbtnIndividual").is(":checked")) {
                $.ajax({
                    url: '@Url.Action("BindClassWiseInfoForIndividual", "Communication")',
                    data: { sClassIdS: vClassList },
                    success: function (data) {
                        if (data.Message != null) {
                            alert(data.Message);
                        }
                        $('#BindInformation').removeClass("hidden");
                        var divHtml = $('#BindInformation');
                        divHtml.empty();
                        divHtml.html(data);
                        $("#divToSelect,#SelectedTable").css({ "max-height": "200px", "overflow-y": "auto", "border": "1px solid" });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
        }
        else {
            alert("Please Select Class!!!");
        }
    });
    $('#btnStaffCategory').on("click", function () {
        var vStaffCategoryList = String($('#StaffType').val());
        if (vStaffCategoryList.length != 0 && vStaffCategoryList != "null") {
            if ($("#rbtnIndividual").is(":checked")) {
                $.ajax({
                    url: '@Url.Action("BindStaffInfoForIndividual", "Communication")',
                    data: { sStaffCategoryId: vStaffCategoryList },
                    success: function (data) {
                        if (data.Message != null) {
                            alert(data.Message);
                        }
                        $('#BindInformation').removeClass("hidden");
                        var divHtml = $('#BindInformation');
                        divHtml.empty();
                        divHtml.html(data);
                        $("#divToSelect,#SelectedTable").css({ "max-height": "200px", "overflow-y": "auto", "border": "1px solid" });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
        } else {
            alert("Please Select The Staff Category...!!!");
        }
    });

    //For Send the Selected Student to OtherSide
    SendSelectedStudent = function () {
        $('#SelectedTable').removeClass('hidden');
        $('#StudentToSelect tbody tr').each(function () {
            var StudentId = $(this).attr("cms-studentid");
            var StuClassId = $(this).attr("cms-StuClassId");
            $(this).find('td').each(function () {
                var chkBox = $(this).find('input[type="checkbox"]');
                var Class = ($(this).closest('tr').find('td:eq(1)').text());
                var Name = ($(this).closest('tr').find('td:eq(2)').text());
                var Email = ($(this).closest('tr').find('td:eq(3)').text());
                if (chkBox.is(':checked')) {
                    $(this).parents("tr").remove();
                    var createchkBox = '<input type="checkbox" name="myTextEditBox" id="chkID"/>';
                    var table = document.getElementById("SelectedStudent");
                    var row = table.insertRow(1);
                    $("#SelectedStudent tbody").append(row);
                    row.setAttribute("cms-studentid", StudentId);
                    row.setAttribute("cms-StuClassId", StuClassId);
                    var cell1 = row.insertCell(0);
                    var cell2 = row.insertCell(1);
                    var cell3 = row.insertCell(2);
                    var cell4 = row.insertCell(3);
                    cell1.innerHTML = createchkBox;
                    cell2.innerHTML = Class;
                    cell3.innerHTML = Name;
                    cell4.innerHTML = Email;
                }
            });
        });
        $('#lblCount').text($("#SelectedStudent tbody tr").length);
    }
</script>
