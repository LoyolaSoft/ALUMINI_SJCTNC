@model CMS.ViewModel.ViewModel.AttendanceViewModel

@{int count = 0;}


@if (Model.liAttendanceReport != null)
{
    <div class="alert bg-danger"><b>Total Absentees : @Model.liAttendanceReport.Count() </b> </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Date</th>
            <th>Class</th>
            <th>Mobile No</th>
            <th>Hour(s)</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.liAttendanceReport != null )
        {

            foreach (var item in Model.liAttendanceReport)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td>@item.FIRST_NAME</td>
                    <td>@item.ATTENDENCE_DATE</td>
                    <th>@item.CLASS_NAME</th>
                    <td>@item.MOBILE</td>
                    <td>@item.HOUR_FROM</td>
                </tr>
            }

        }
        else
        {
            <tr>
                <td colspan="6">No Records Found..!</td>
            </tr>
        }
        
    </tbody>    
</table>
