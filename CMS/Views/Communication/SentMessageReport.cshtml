
@model CMS.ViewModel.ViewModel.CommunicationViewModel

@{
    Layout = null;
    ViewBag.Title = "SentMessageReport";
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- HTML for loader (hidden initially) -->
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">SMS</a></li>
        <li class="active">SMS Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">SMS Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">SMS Report</h4>
        </div>

        <div class="panel-body">

            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12 form-horizontal">
                <ul class="nav nav-tabs">
                    <li class="nav-items active" id="SMSBalance">
                        <a href="#BindSMSBalance" data-toggle="tab" class="nav-link active">
                            <span class="d-sm-none">SMS Balance</span>
                        </a>
                    </li>
                    <li class="nav-items" id="BindDateWiseSMS">
                        <a href="#BindDateWiseSMSReport" data-toggle="tab" class="nav-link">
                            <span class="d-sm-none">Date Wise SMS List</span>
                        </a>
                    </li>

                </ul>
                <div class="tab-content">

                    @* Bind Date Wise SMS Report *@

                    <div class="tab-pane fade" id="BindDateWiseSMSReport">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-6 form-group">
                                    @Html.Label("From Date", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-8">
                                        <div class="input-group">
                                            <input class="form-control date" id="txtStartDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    @Html.Label("To Date", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-8">
                                        <div class="input-group ">
                                            <input class="form-control date" id="txtEndDate" placeholder="Pick Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 ">
                                <div class="col-md-5 form-group">
                                    @Html.Label("Message Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.messageType, (Model.messageType != null) ? Model.messageType : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary" id="btnGet" onclick="BindSMSReport()"> Get </button>
                                </div>

                                <div class="col-md-1">
                                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvAttendanceReport')"> Print </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="tab-pane fade" id="BindSMSBalance">
                        <div class="row">

                            <div class="col-md-12 ">

                                <div class="col-md-1">
                                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvSMSReport')"> Print </button>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div id="dvSMSReport"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        $('#BindSMSBalance').addClass("active in");
        $('.nav-items').on("click", function () {

            $('#dvSMSReport').html('');

        });
        //$(".date").datepicker({
        //    todayHighlight: true,
        //    autoclose: !0,
        //    endDate: new Date(),
        //    format: "dd/mm/yyyy",
        //    orientation: "right bottom"
        //});
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
    });

    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $(".date").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )

            }
            handleDatepicker();
        });

        loadSMSBalance();
    }
    $("#SMSBalance").on('click', function () {
        loadSMSBalance();
    });
    function loadSMSBalance()
{

        $.ajax({
            url:'@Url.Action("BindSMSBalance", "Communication")',
            method:'POST',
            datatype:'json',
            data: { },
            success: function (data)
            {
                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvSMSReport').empty();
                    $('#dvSMSReport').append(data);
            },
            eror: function (error)
            {
                swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
}

</script>


<script>
    function BindSMSReport()
{
        if ($('#messageType').val() && $('#txtStartDate').val() && $('#txtEndDate').val())
    {
        $.ajax({
            url:'@Url.Action("BindDateWiseSMSReport", "Communication")',
            method:'POST',
            datatype:'json',
            data: { sMessageType: String($('#messageType').val()), sFromDate: $('#txtStartDate').val(), sToDate: $('#txtEndDate').val() },
            success: function (data)
            {

                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                }else
                {
                    $('.btnPrint').removeClass('hidden');
                    $('.btnExport').removeClass('hidden');
                    $('#dvSMSReport').empty();
                    $('#dvSMSReport').append(data);
                }
            }, eror: function (error)
            {
                swal({ title: "Warning !", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
            }
        });
    }
            else {

        swal({ title: "Error !", text: "Please Select All Field's", showConfirmButton: false, timer: 1000, type: 'error', animation: true });

    }
}


</script>
