        //For Send the Selected Staff to Other Side

        function SendSelectedStaff() {
            $('#StaffSelectedTable').removeClass('hidden');
            $('#StaffToSelect tbody tr').each(function () {

                var StaffId = $(this).attr("cms-staffid");

                $(this).find('td').each(function () {
                    var chkBox = $(this).find('input[type="checkbox"]');
                    var Class = ($(this).closest('tr').find('td:eq(1)').text());
                    var Name = ($(this).closest('tr').find('td:eq(2)').text());
                    var Email = ($(this).closest('tr').find('td:eq(3)').text());
                    if (chkBox.is(':checked')) {
                        $(this).parents("tr").remove();
                        var createchkBox = '<input type="checkbox" name="myTextEditBox" id="chkID"/>';
                        var table = document.getElementById("SelectedStaff");
                        var row = table.insertRow(1);
                        $("#SelectedStaff tbody").append(row);
                        row.setAttribute("isp-staffid", StaffId);
                        var cell1 = row.insertCell(0);
                        var cell2 = row.insertCell(1);
                        var cell3 = row.insertCell(2);
                        var cell4 = row.insertCell(3);
                        cell1.innerHTML = createchkBox;
                        cell2.innerHTML = Class;
                        cell3.innerHTML = Name;
                        cell4.innerHTML = Email;
                    }
                });
            });
            $('#lblCount').text($("#SelectedStaff tbody tr").length);
        };
    </script>
    <script>
        $('#btnSendSMS').on("click", function () {
            if (!$("#rbtnStudent").is(":checked") && !$("#rbtnStaff").is(":checked") && !$("#rbtnBoth").is(":checked") && !$("#rbtnHostel").is(":checked")) {
                alert('Please Choose Any SMS Option ...!');
                return false;
            }

            var Option = '';
            if ($("#rbtnLanguage").is(":checked")) {
                Option = '1';
            }
            //Check the testMobile
            var TestMobileNo = $('#txtMobile').val();
            if (TestMobileNo != '') {
                alert('Please Clear the Mobile Number');
                return false;
            } else {
                var sMessageContent = $('#txtMessageContent').val();
                var Json;
                if (sMessageContent != null && sMessageContent != '') {
                    if ($("#rbtnIndividual").is(":checked")) {
                        if ($("#rbtnIndividual").is(":checked") && $("#rbtnStudent").is(":checked")) {
                            if ($('#SelectedStudent >tbody >tr').length > 0) {
                                Json = '{"listSMS":[';
                                $('#SelectedStudent tbody tr').each(function () {
                                    var StudentId = $(this).attr("cms-studentid");
                                    var clsId = $(this).attr("cms-StuClassId");
                                    var Mobile = ($(this).closest('tr').find('td:eq(3)').text());
                                    var Is_staff = '2';
                                    //Json += '{"mobiles":"' + Mobile + '","sms":"' + sMessageContent + '","custom":"' + StudentId + '","custom1":"' + clsId + '","custom2":"' + Is_staff + '","CreditCount":"' + sCreditCount + '"},';
                                    Json += '{"mobiles":"' + Mobile + '","sms":"' + sMessageContent + '"},';
                                });
                                Json = Json.slice(0, -1);
                                Json += ']}';
                                $.ajax({
                                    url: '@Url.Action("SendBulkMessageInDovesoft", "Communication")',
                                    method: 'POST',
                                    datatype: "json",
                                    data: { sContent: sMessageContent, JsonIndividualMessage: Json,slanguageOption:Option},
                                    success: function (data) {
                                        if (data.Message != null) {
                                            alert(data.Message)
                                        }
                                    },
                                    error: function () {
                                        alert('Internal Server Error ! ');
                                    }
                                })

                            } else {
                                alert('There is no Student to Send SMS')
                            }
                        }
                        else if ($("#rbtnIndividual").is(":checked") && $("#rbtnStaff").is(":checked")) {
                            if ($('#SelectedStaff >tbody>tr').length > 0) {
                                Json = '{"listSMS":[';
                                $('#SelectedStaff tbody tr').each(function () {
                                    var StaffId = $(this).attr("isp-staffid");
                                    var clsId = '';
                                    var Mobile = ($(this).closest('tr').find('td:eq(3)').text());
                                    var Is_staff = '3';
                                    //Json += '{"to":"' + Mobile + '","message":"' + sMessageContent + '","custom":"' + StaffId + '","custom1":"' + clsId + '","custom2":"' + Is_staff + '","CreditCount":"' + sCreditCount + '"},';
                                     Json += '{"mobiles":"' + Mobile + '","sms":"' + sMessageContent + '"},';
                                });
                                Json = Json.slice(0, -1);
                                Json += ']}';
                                $.ajax({
                                    url: '@Url.Action("SendBulkMessageInDovesoft", "Communication")',
                                    method: 'POST',
                                    datatype: "json",
                                    data: { sContent: sMessageContent, JsonIndividualMessage: Json, sCredit: sCreditCount, slanguageOption: Option },
                                    success: function (data) {
                                        if (data.Message != null) {
                                            alert(data.Message)
                                        }
                                    },
                                    error: function () {
                                        alert('Internal Server Error ! ');
                                    }
                                })

                            } else {
                                alert('There is no Staff to Send SMS')
                            }
                        }

                    }

                    //btnAllclicked
                    if ($("#rbtnAll").is(":checked")) {
                        var AddStaff = null;
                        if ($("#rbtnAll").is(":checked") && $("#rbtnStudent").is(":checked")) {
                            var vClassList = String($('#ClassList').val());
                            if (vClassList != 0 && vClassList != null) {
                                if ($("#chkAddStaff").prop("checked") == true) {
                                    AddStaff = '1';
                                }
                                $.ajax({
                                    url: '@Url.Action("SendBulkMessageInDovesoft", "Communication")',
                                    method: "POST",
                                    datatype: "json",
                                    data: { sSMSMode: "2", sContent: sMessageContent, sClassId: vClassList, ChStaff: AddStaff, sCredit: sCreditCount, slanguageOption: Option },
                                    success: function (data) {
                                        if (data.Message != null) {
                                            alert(data.Message)
                                            return false;
                                        }
                                    }, error: function (error) {
                                        alert('Error');
                                    }
                                })
                            } else {
                                alert("Please Select Class!!!");
                            }

                        } else if ($("#rbtnAll").is(":checked") && $("#rbtnStaff").is(":checked")) {
                            var vRole = String($('#StaffCategoryList').val());
                            if (vRole != 0 && vRole != null) {
                                $.ajax({
                                    url: '@Url.Action("SendBulkMessageInDovesoft", "Communication")',
                                    method: "POST",
                                    datatype: "json",
                                    data: { sSMSMode: "3", sContent: sMessageContent, sCredit: sCreditCount, sRole: vRole, slanguageOption: Option },
                                    success: function (data) {
                                        if (data.Message != null) {
                                            alert(data.Message)
                                            return false;
                                        }
                                    }, error: function (error) {
                                        alert('Error');
                                    }
                                })
                            }

                            else {
                                alert("Please Select Staff Type!!!");
                            }
                        }
                        else if ($("#rbtnAll").is(":checked") && $("#rbtnHostel").is(":checked")) {

                            $.ajax({
                                url: '@Url.Action("SendBulkMessageInDovesoft", "Communication")',
                                method: "POST",
                                datatype: "json",
                                data: { sSMSMode: "11", sContent: sMessageContent, sCredit: sCreditCount, slanguageOption: Option },
                                success: function (data) {
                                    if (data.Message != null)
                                    {
                                        alert(data.Message)
                                        return false;
                                    }
                                }, error: function (error) {
                                    alert('Error');
                                }
                            })

                        }
                    }
                    //btn Both Clicked
                    if ($("#rbtnBoth").is(":checked") && $("#rbtnAll").is(":checked")) {
                        $.ajax({
                            url: '@Url.Action("SendBulkMessageInDovesoft", "Communication")',
                            method: "POST",
                            datatype: "json",
                            data: { sSMSMode: "1", sContent: sMessageContent, sCredit: sCreditCount, slanguageOption: Option },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message)
                                    return false;
                                }
                            }, error: function (error) {
                                alert('Error');
                            }
                        })
                    }
                } else {
                    alert("No Message Content");
                }
            }


        })
    </script>
