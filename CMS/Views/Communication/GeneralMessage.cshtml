    <script>
        $('#btnTestSMS').click(function () {
            if ($("#txtMessageContent").val() && $("#txtMobile").val())
            {
                var Option = '';
                if ($("#rbtnLanguage").is(":checked")) {
                    Option = '1';
                }

                var JsonData = null;
                var ApIMode;
                if ($("#chkVoiceCall").is(":checked")) {
                    ApIMode = '2';
                }
                JsonData = '{"CONTENT":"' + $("#txtMessageContent").val() + '","RECEIPIENT_NOS":"' + $("#txtMobile").val() + '"}';
                $.ajax({
                    url: "@Url.Action("TestMessage", "Communication")",
                    method: "POST",
                    datatype: "json",
                    data: { JsonTestMessage: JsonData, sApIMode: ApIMode, UniCode: Option },
                    success: function (data) {
                        alert(data.Message);
                    }, error: function (error) {
                        alert("Internal Server Error ...!!!");
                    }
                });
            }
        });
    </script>
    <script>
        $('#Programme').on("change", function () {
            var vProgrammeGroupId = String($('#Programme').val());
            $.ajax({
                url: '@Url.Action("GetClassByProgrammeGroupId", "Communication")',
                data: { sProgrammeGroupId: vProgrammeGroupId },
                success: function (objResult) {
                    if (objResult.Message != null) {
                        alert(objResult.Message);
                    }
                    else {
                        $('#ClassList').empty();
                        $('#ClassList').append(objResult.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        });
        $('#ClassList').on("change", function () {
            var vClass = String($('#ClassList').val());
            if ($('#rbtnAll').is(":checked")) {
                $.ajax({
                    url: '@Url.Action("FetchClasswiseRecordsCount", "Communication")',
                    method: "POST",
                    datatype: "json",
                    data: { sClassIds: vClass },
                    success: function (data) {
                        if (data.Message != null) {
                            alert(data.Message);
                        }
                        if (data.sResult != null) {
                            $('#lblCount').text(data.sResult);
                        }
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                })
            }
            else {
                return false;
            }
        });
        $('#StaffCategoryList').on("change", function () {
            var vRole = String($('#StaffCategoryList').val());
            if ($('#rbtnAll').is(":checked")) {
                $.ajax({
                    url: '@Url.Action("FetchStaffRecordsCount", "Communication")',
                    method: "POST",
                    datatype: "json",
                    data: { sRole: vRole },
                    success: function (data) {
                        if (data.Message != null) {
                            alert(data.Message);
                        }
                        if (data.sResult != null) {
                            $('#lblCount').text(data.sResult);
                        }
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                })
            }
            else {
                return false;
            }
        });
        //GetBtn Clicked to get ClassWiseStudentDetails
        $('#btnGetClass').on("click", function () {
            var vClassList = String($('#ClassList').val());
            $("#lblCount").text('0');
            if (vClassList.length != 0 && vClassList != "null") {
                if ($("#rbtnIndividual").is(":checked")) {
                    $.ajax({
                        url: '@Url.Action("BindClassWiseInfoForIndividual", "Communication")',
                        data: { sClassIdS: vClassList },
                        success: function (data) {
                            if (data.Message != null) {
                                alert(data.Message);
                            }
                            $('#BindInformation').removeClass("hidden");
                            var divHtml = $('#BindInformation');
                            divHtml.empty();
                            divHtml.html(data);
                            $("#divToSelect,#SelectedTable").css({ "max-height": "200px", "overflow-y": "auto", "border": "1px solid" });
                        },
                        error: function (xhr, textStatus, error) {
                            alert(error + "\n");
                        }
                    });
                }
            }
            else {
                alert("Please Select Class!!!");
            }
        });
        $('#btnStaffCategory').on("click", function () {
            var vStaffCategoryList = String($('#StaffType').val());
            if (vStaffCategoryList.length != 0 && vStaffCategoryList != "null") {
                if ($("#rbtnIndividual").is(":checked")) {
                    $.ajax({
                        url: '@Url.Action("BindStaffInfoForIndividual", "Communication")',
                        data: { sStaffCategoryId: vStaffCategoryList },
                        success: function (data) {
                            if (data.Message != null) {
                                alert(data.Message);
                            }
                            $('#BindInformation').removeClass("hidden");
                            var divHtml = $('#BindInformation');
                            divHtml.empty();
                            divHtml.html(data);
                            $("#divToSelect,#SelectedTable").css({ "max-height": "200px", "overflow-y": "auto", "border": "1px solid" });
                        },
                        error: function (xhr, textStatus, error) {
                            alert(error + "\n");
                        }
                    });
                }
            } else {
                alert("Please Select The Staff Category...!!!");
            }
        });

        //For Send the Selected Student to OtherSide
        SendSelectedStudent = function ()
        {
            alert('');
            $('#SelectedTable').removeClass('hidden');
            $('#StudentToSelect tbody tr').each(function () {
                var StudentId = $(this).attr("cms-studentid");
                var StuClassId = $(this).attr("cms-StuClassId");
                $(this).find('td').each(function () {
                    var chkBox = $(this).find('input[type="checkbox"]');
                    var Class = ($(this).closest('tr').find('td:eq(1)').text());
                    var Name = ($(this).closest('tr').find('td:eq(2)').text());
                    var Email = ($(this).closest('tr').find('td:eq(3)').text());
                    if (chkBox.is(':checked')) {
                        $(this).parents("tr").remove();
                        var createchkBox = '<input type="checkbox" name="myTextEditBox" id="chkID"/>';
                        var table = document.getElementById("SelectedStudent");
                       // var row = table.insertRow(1);
                        $("#SelectedStudent tbody").append(table.insertRow(1));
                        row.addClass('selectedstudent');
                        row.setAttribute("cms-studentid", StudentId);
                        row.setAttribute("cms-StuClassId", StuClassId);
                        var cell1 = row.insertCell(0);
                        var cell2 = row.insertCell(1);
                        var cell3 = row.insertCell(2);
                        var cell4 = row.insertCell(3);
                        cell1.innerHTML = createchkBox;
                        cell2.innerHTML = Class;
                        cell3.innerHTML = Name;
                        cell4.innerHTML = Email;
                    }
                });
            });
            $('#lblCount').text($("#SelectedStudent tbody tr").length);
        }
    </script>
