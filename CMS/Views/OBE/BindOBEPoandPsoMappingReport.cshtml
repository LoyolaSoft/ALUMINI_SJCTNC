@model CMS.ViewModel.ViewModel.OBEViewModel

@{
    Layout = null; int nCount = 0;
}
@if (Model.liObeCoPoMapping != null && Model.liObeCoPoMapping.Count > 0)
{
    <table class="table table-responsive">
        <thead>
            <tr>
                <th>S.No.</th>
                <th>Course Code</th>
                <th>Course Title</th>
                <th>Entry Status</th>
                <th>Hod Verify</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liObeCoPoMapping)
            {
                <tr>
                    <td>@{nCount++;}@nCount</td>
                    <td>@item.COURSE_CODE</td>
                    <td>@item.COURSE_TITLE</td>
                    <td>
                        @if (item.ENTRY_ID != "0")
                        {
                            <a class="text-success"><i class="fa fa-check"></i></a>
                        }
                        else
                        {
                            <a class="text-danger"><i class="fa fa-check"></i></a>
                        }
                    </td>
                    <td>
                        @if (item.IS_VERIFY != "0")
                        {
                            <a class="text-success"><i class="fa fa-check"></i></a>
                        }
                        else
                        {
                            <a class="text-danger"><i class="fa fa-check"></i></a>
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
}
