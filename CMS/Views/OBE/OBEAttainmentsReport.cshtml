@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    ViewBag.Title = "OBEAttainmentsReport";

    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<link href="~/Content/assets/printout1.css" media="print" rel="stylesheet" />

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }

    #staticcolumn {
        position: sticky;
        left: 0;
        z-index: 0;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">OBE</a></li>
        <li class="active">OBE CO Attainments Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">OBE CO Attainments Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">OBE CO Attainments Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            @Html.Label("Semester", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                <select class="selectpicker form-control" id="ddlSemester">
                                    <option value="0"> -- Select -- </option>
                                    <option value="1">Odd Semester</option>
                                    <option value="2">Even Semester</option>
                                    <option value="3">Non Semester</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12 form-group">
                        <div class="col-md-4 form-group">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @if (Model.ClassList != null)
                                {
                                    @Html.DropDownListFor(m => m.ClassList, Model.ClassList, "---Select---", new { @class = "selectpicker form-control  select2", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                }
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Component", htmlAttributes: new { @class = "col-md-4 control-label" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.OBECOComponent, (Model.OBECOComponent != null) ? Model.OBECOComponent : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12 form-group">
                        <div class="form-group col-md-4">
                            <div class="col-md-8">
                                <a id="submit" href="#" onclick="BindData()" class="btn btn-primary pull-right">Get</a>
                            </div>

                        </div>
                        <div class="col-md-4 form-group">
                            <div class="col-md-8">
                                <a href="#" id="btnExport" class="btn btn-success">Export</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-horizontal">
                    <div class="col-lg-12 landScape" id="dvOBEAttainments"></div>
                </div>


            }


        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {

   }

    $('.selectpicker').selectpicker({
            size: 6
        });
    $('.selectpicker').selectpicker('refresh');

    $('#ClassList').on('change', function ()
    {

        $.ajax({
            url: '@Url.Action("FetchCourseByClassIdAndSemTypeId", "OBE")',
            method:'POST',
            datatype: 'json',
            data: { sClassId: $('#ClassList').val(), sSemesterTypeId: $('#ddlSemester').val(), sAcYear: $('#AcademicYearList Option:selected').text() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#CourseList').empty();
                    $('#CourseList').append(data.sResult); // cms-sSemesterId
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $("#AcademicYearList").on("change", function ()
    {
        var AcademicYear = $("#AcademicYearList option:selected").text();
        $.ajax(
        {
            url: "@Url.Action("ExamSettingByAcademicYear", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sACYear: AcademicYear },
            success: function (data)
            {
                $("#ExamSetting").empty();
                $("#ExamSetting").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (error)
            {
                alert('Internal Server Error ! ');
            }
        });
    });
    function BindData()
    {
        if ($('#CourseList').val())
        {
            $('#dvOBEAttainments').empty();

            var AcademicYear = $("#AcademicYearList option:selected").text();
            $.ajax({
                url: "@Url.Action("BindOBEAttainmentsReport", "OBE")",
                method: "POST",
                datatype: "json",
                data: {
                    sAcyear: AcademicYear, sExamSettingId: $('#ExamSetting').val(),
                    sCourseId: $('#CourseList').val(), sClassId: $('#ClassList').val(),
                    sCOComponentId: $('#OBECOComponent').val(), sSemester: $('#ddlSemester').val()
                },
                success: function (data)
                {
                    $('#dvOBEAttainments').append(data);
                    $('.selectpicker').selectpicker('refresh');


                }, error: function (error)
                {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else
        {
            alert('Please Choose All Fields .....!');
        }

    };

    function printDiv(divName)
    {
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;

            window.print();

            document.body.innerHTML = originalContents;
            loadContent('/OBE/OBEAttainmentsReport');
    }
    $("#btnExport").click(function (e)
    {

        let file = new Blob([$('#dvOBEAttainments').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download:"AttainmentReport.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });


</script>




