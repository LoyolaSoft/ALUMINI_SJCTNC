@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;

}
<div class="form-group col-md-12 table-responsive pull-right">
    <div class="col-md-12">
        @if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
        {
            <p>Course Code:@Model.liCLOCoursewiseAttainment.FirstOrDefault().COURSE_CODE</p>
            <p>Course Title:@Model.liCLOCoursewiseAttainment.FirstOrDefault().COURSE_TITLE</p>
        }

    </div>
    <table class="table table-bordered table-hover pull-right" id="tbl">
        <thead>
            <tr>
                <th>CLO</th>
                <th>SEM</th>
                <th>SEM 80%</th>
                <th>CIA</th>
                <th>CIA 20%</th>
                <th>Attainment</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                {

                    foreach (var Coitem in Model.liCLOCoursewiseAttainment)
                    {
                        <tr>
                            <td>@Coitem.OBE_COLEVEL</td>
                            <td>@Coitem.EXTERNAL_SEC</td>
                            <td>@Coitem.EXTERNAL</td>
                            <td>@Coitem.INTERNAL_SEC</td>
                            <td>@Coitem.INTERNAL</td>
                            <td>@Coitem.TOTAL_ATTAINMENT</td>



                        </tr>
                    }


                }
            }
        </tbody>
    </table>
</div>

