<script>
        function ContentLoad() {


        }
        $('.selectpicker').selectpicker({
            size: 6
        });
    $('.selectpicker').selectpicker('refresh');

    $('#SemesterList').on('change', function ()
        {
            $('#dvOBEMarkbind').empty();
        $.ajax({
            url: '@Url.Action("FetchCourseByAcademicYearandSemester", "OBE")',
            method:'POST',
            datatype: 'json',
            data: { sSemesterId: $('#SemesterList').val(), sAcYear: $('#AcademicYearList Option:selected').text() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#CourseList').empty();
                    $('#CourseList').append(data.sResult); // cms-sSemesterId
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });





    function BindData() {
        if ($('#SemesterList').val() ) {
            $('#dvOBEMarkbind').empty();
            var AcademicYear = $("#AcademicYearList option:selected").text();

            $.ajax({
                url: "@Url.Action("BindOBEPoandPso", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sSemesterId: $('#SemesterList').val(), sACYear: AcademicYear, sCourseId: $('#CourseList').val(), sMapping: $('#ddlMapping').val()},
                success: function (data) {
                    $('#dvOBEMarkbind').append(data);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Choose All Fields .....!');
        }

        };

    $('#btnSubmit').on('click', function () {
        var count = 0;
        if (parseInt($('#CourseList').val()) != 0) {
            addLoadingPanel();
            var sCourseId = $('#CourseList').val();
            var sMapping= $('#ddlMapping').val();
            var sJson;
            if (sJson == null) {
                sJson = '{"OBECOPOMatrix":[';
                $('#tblobeCOPOMatrix tbody tr').each(function () {
                    $(this).find('td').each(function () {
                        if ($(this).find('input[type="number"]').val()) {
                            sJson += '{"OBE_MAPPING_ID":"' + $(this).find('input[type="number"]').attr("copomatrixid") + '","OBE_COLEVEL_ID":"' + $(this).find('input[type="number"]').attr("colevel") + '","OBE_POLEVEL_ID":"' + $(this).find('input[type="number"]').attr("polevel") + '",';
                            sJson += '"OBE_CO_PO_MARK":"' + $(this).find('input[type="number"]').val() + '","COURSE_ID":"' + sCourseId + '","PO_TYPE":"' + sMapping+'"},';
                            count++;
                        }
                    });
                }); if (count > 0) {
                    sJson = sJson.slice(0, -1);
                }
                sJson += ']}';
                // alert(sJson);
            }
            $.ajax({
                url: "@Url.Action("SaveBindOBECOPOMatrix", "OBE")",
                async: false,
                method: "POST",
                content: "application/json; charset=utf-8",
                data: { sJsonData: sJson },
                success: function (data) {
                    if (data.ErrorCode = "200") {
                        alert(data.Message);
                    }
                    BindData()
                    removeload();
                }, error: function (e) {
                    removeload();
                    alert(e);
                }
            });
        } else {

            alert('Please select course...!');
        }
    });

    $('#btnVerify').on('click', function () {
        var sCourseId = $('#CourseList').val();
        var sMapping = $('#ddlMapping').val();

        $.ajax({
            url: "@Url.Action("VerifyOBECOPOMatrix", "OBE")",
            async: false,
            method: "POST",
            content: "application/json; charset=utf-8",
            data: { sCourseId: sCourseId, sMapping: sMapping },
            success: function (data) {
                if (data.ErrorCode = "200") {
                    alert(data.Message);
                }
                BindData()
                removeload();
                }, error: function (e) {
                    removeload();
                    alert(e);
                }
        });
    });

    function printDiv(divName) {
         

        var printContents = document.getElementById(divName).innerHTML;
        const imgData = myChart.canvas.toDataURL();
        const img = new Image();
        img.src = imgData;
        img.onload = function () {
            const printWindow = window.open('', 'Print Chart');
            printWindow.document.write('<html><head><title>Print Chart</title></head><body>');
            printWindow.document.write('<div class="table table-hover table-bordered table-striped table-responsive">' + printContents + '</div>');
            printWindow.document.write('<img src="' + imgData + '" style="width:100%">');
            printWindow.document.write('</body></html>');
            printWindow.print();

        }

    }

</script>








