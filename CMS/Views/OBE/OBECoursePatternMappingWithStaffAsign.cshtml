@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    ViewBag.Title = "Semester Mark Entry";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">OBE Course Pattern Mapping</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">OBE Course Pattern Mapping</h1>
    <!-- end page-header -->
    
    <ul class="nav nav-tabs">
        <li class="active"><a href="#tab-mapping" data-toggle="tab">OBE Course Pattern Mapping</a></li>
        <li><a href="#tab-staffwise" data-toggle="tab" onclick="ClearStaffTable()">Staff Wise Course List</a></li>
    </ul>

    <div class="tab-content">
        <!-- begin tab-pane 1 -->
        <div class="tab-pane fade active in" id="tab-mapping">
            <!-- begin panel -->
            <div class="panel panel-primary" data-sortable-id="ui-general-1">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">OBE Course Pattern Mapping</h4>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="row">
                                <div class="form-group col-md-4">
                                    @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group col-md-4">
                                    @Html.Label("Result Month", htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ResultMonth, (Model.ResultMonth != null) ? Model.ResultMonth : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.ResultMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group col-md-4">
                                    @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" id="Semester" data-selected-text-format="count">
                                            <option value="0">--Select--</option>
                                            <option value="1">I</option>
                                            <option value="2">II</option>
                                            <option value="3">III</option>
                                            <option value="4">IV</option>
                                            <option value="5">V</option>
                                            <option value="6">VI</option>
                                        </select>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    @Html.Label("Application Type", htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                <div class="col-md-4 form-group">
                                    @Html.Label("Component", htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.OBECOComponent, (Model.OBECOComponent != null) ? Model.OBECOComponent : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                <div class="form-group col-md-4 pull-right">
                                    <div class="col-md-6">
                                        <a id="submit" href="#" onclick="PatternMapping()" class="btn btn-primary pull-right">Get</a>
                                    </div>
                                </div>
                            </div>


                            <div id="bindtable">

                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- end tab-pane 1 -->
        <!-- begin tab-pane 2 -->
        <div class="tab-pane fade" id="tab-staffwise">
            <div class="panel panel-primary" data-sortable-id="ui-general-2">
                <div class="panel-heading">
                    <h4 class="panel-title">Staff Wise Course List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                             <div class="form-group col-md-4">
                                @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownList("AcademicYearStaff", (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                </div>
                            </div>

                            <div class="form-group col-md-4">
                                @Html.Label("Result Month", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    <select class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" id="ResultMonthStaff" data-live-search="true">
                                        <option value="0">--Select--</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group col-md-4">
                                @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" id="SemesterStaff" data-selected-text-format="count">
                                        <option value="0">--Select--</option>
                                        <option value="1">I</option>
                                        <option value="2">II</option>
                                        <option value="3">III</option>
                                        <option value="4">IV</option>
                                        <option value="5">V</option>
                                        <option value="6">VI</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                @Html.Label("Application Type", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownList("ApplicationTypeStaff", (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Component", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownList("OBECOComponentStaff", (Model.OBECOComponent != null) ? Model.OBECOComponent : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4 pull-right">
                                <div class="col-md-6">
                                    <a id="submitStaff" href="#" onclick="StaffWiseMapping()" class="btn btn-primary pull-right">Get Staff List</a>
                                </div>
                            </div>
                        </div>
                        <div id="bindstafftable">

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end tab-pane 2 -->
    </div>
</div>

<!-- end panel -->



<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>

<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
@*<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>*@
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {

    }

    $('.selectpicker').selectpicker({
        size: 4
    });

    $("#AcademicYearList").on("change", function () {
        var AcademicYear = $("#AcademicYearList option:selected").text();
        $.ajax({
            url: "@Url.Action("ExamSettingByAcademicYear", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sACYear: AcademicYear },
            success: function (data) {
                $("#ResultMonth").empty();
                $("#ResultMonth").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });

    function PatternMapping() {
        var AcYear = $('#AcademicYearList option:selected').text();
        var Examsetting = $("#ResultMonth").val();
        var Semester = $("#Semester").val();
        $.ajax({
            url: "@Url.Action("BindOBECoursePatternMappingWithStaffAsign", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sExamSetting: Examsetting, sAcYear: AcYear, sSemester: Semester, sCOComponentId: $('#OBECOComponent').val(), sApptype: $('#ApplicationType').val()},
            success: function (data) {

                $('#bindtable').empty();
                $('#bindtable').append(data);
            }
             , error: function (error) {
                 swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
             }
        });
    }

    $("#AcademicYearStaff").on("change", function () {
        var AcademicYear = $("#AcademicYearStaff option:selected").text();
        $.ajax({
            url: "@Url.Action("ExamSettingByAcademicYear", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sACYear: AcademicYear },
            success: function (data) {
                $("#ResultMonthStaff").empty();
                $("#ResultMonthStaff").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });

    function ClearStaffTable() {
        $('#bindstafftable').empty();
    }

    function StaffWiseMapping() {
        var AcYear = $('#AcademicYearStaff option:selected').text();
        var Examsetting = $("#ResultMonthStaff").val();
        var Semester = $("#SemesterStaff").val();
        var AppType = $("#ApplicationTypeStaff").val();
        var Component = $("#OBECOComponentStaff").val();

        if (AcYear == "" || Examsetting == "0" || Component == "") {
            swal({ title: "Warning !", text: 'Please select all filters!', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return;
        }

        $.ajax({
            url: "@Url.Action("BindStaffWiseCourseList", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sExamSetting: Examsetting, sAcYear: AcYear, sSemester: Semester, sCOComponentId: Component, sApptype: AppType },
            success: function (data) {
                $('#bindstafftable').empty();
                $('#bindstafftable').append(data);
            },
            error: function (error) {
                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function ToggleCourses(staffId) {
        $("#courses-" + staffId).toggle();
    }

    function SendEmail() {
        var selectedStaff = [];
        $('.staff-checkbox:checked').each(function () {
            selectedStaff.push($(this).val());
        });

        if (selectedStaff.length == 0) {
            swal({ title: "Warning !", text: 'Please select at least one staff member!', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return;
        }

        swal({
            title: "Are you sure?",
            text: "You want to send email to " + selectedStaff.length + " staff members?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes, send it!",
            closeOnConfirm: false
        }, function () {
            var AcYear = $('#AcademicYearStaff option:selected').text();
            var Examsetting = $("#ResultMonthStaff").val();
            var Component = $("#OBECOComponentStaff").val();

            $.ajax({
                url: "@Url.Action("SendEmailToStaff", "OBE")",
                method: "POST",
                data: { staffIds: selectedStaff, sExamSetting: Examsetting, sAcYear: AcYear, sCOComponentId: Component },
                success: function (data) {
                    if (data.ErrorCode == "Accepted") {
                        swal("Sent!", data.Message, "success");
                        StaffWiseMapping(); // Refresh table
                    } else {
                        swal("Error!", data.Message, "error");
                    }
                },
                error: function (error) {
                    swal("Error!", "Failed to send email.", "error");
                }
            });
        });
    }

    function SelectAllStaff(chk) {
        $('.staff-checkbox:not(:disabled)').prop('checked', chk.checked);
    }



</script>


