@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;
    int nCount = 0;
}

<div class="body-content">
    <div class="col-md-12" style="height:40px;background-color:#4396bb;color:white;font-size:20px;align-content:center;text-align:center;">
        @Model.UDF1
    </div>
    <br /><br /><br />
    <div class="col-md-12 row">
        <div class="col-md-3">
            <table class="table table-hover table-bordered table-striped table-responsive" border="1">
                <thead style="background-color:lightblue">
                    <tr>
                        <td>S.No.</td>
                        <td>K Level</td>
                        <td>Percentage</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LiOBEQuestionMarkEntry)
                    {
                        <tr>
                            <td>@{nCount++;}@nCount</td>
                            <td>@item.OBE_RBT_LEVEL</td>
                            <td>@item.PERCENTAGE</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
        <div class="col-md-9">
            <div class="" id="chartsdiv">
                <canvas id="myChart"></canvas>
            </div>
        </div>
    </div>
</div>
