<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var liobe = @Html.Raw(Json.Encode(ViewBag.likLevel));
        var Labels = [];
        var Percentage = [];
        var QuestionLevel = [];

        if (liobe != null) {
            for (var i = 0; i < liobe.length; i++) {
                Labels.push(liobe[i].OBE_RBT_LEVEL);
                Percentage.push(liobe[i].PERCENTAGE);
                QuestionLevel.push(liobe[i].QUESTION_LEVEL);
            }
        }

        var data = {
            labels: Labels,
            datasets: [{
                label: "Knowledge Level % ",
                data: Percentage,
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(255, 159, 64, 0.2)',
                    'rgba(255, 205, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(153, 102, 255, 0.2)'
                ],
                borderColor: [
                    'rgb(255, 99, 132)',
                    'rgb(255, 159, 64)',
                    'rgb(255, 205, 86)',
                    'rgb(75, 192, 192)',
                    'rgb(54, 162, 235)',
                    'rgb(153, 102, 255)'
                ],
                borderWidth: 1
            }]
        };

        var config = {
            type: 'bar',
            data: data,
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            },
        };

        var ctx = document.getElementById('myChart');
        if (ctx) {
            var myChart = new Chart(ctx, config);
        }
    });
</script>