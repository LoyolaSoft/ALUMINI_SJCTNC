@model CMS.ViewModel.Model.OBE_CLAIM_ENTRY
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Claim for Question Paper Setting</title>
    <style>
        body { font-family: 'Times New Roman', Times, serif; font-size: 14px; color: #333; line-height: 1.6; }
        .container { width: 100%; max-width: 800px; margin: 0 auto; padding: 20px; }
        .header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
        .header h2 { margin: 5px 0; text-transform: uppercase; }
        .header p { margin: 2px 0; font-weight: bold; }
        .section-title { font-weight: bold; text-decoration: underline; margin-top: 15px; margin-bottom: 5px; display: block; }
        .label { font-weight: bold; }
        .value { border-bottom: 1px dotted #000; display: inline-block; padding-left: 5px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; }
        table, th, td { border: 1px solid black; }
        th, td { padding: 6px; text-align: left; }
        th { background-color: #f2f2f2; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        
        .footer { margin-top: 30px; }
        .signature-row { display: flex; justify-content: space-between; margin-top: 20px; width: 100%; }
        .sig-block { text-align: center; width: 250px; display: inline-block; }
        .sig-line { border-top: 1px solid #000; margin-top: 40px; padding-top: 5px; font-weight: bold; }
        
        .bank-box { border: 1px solid #000; padding: 10px; margin-top: 10px; }
        
        @@media print {
            .container { border: none; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>St. Joseph's College (Autonomous)</h2>
            <p>Special Heritage Status, Awarded with A++ Grade (4th Cycle) by NAAC</p>
            <p>Tiruchirappalli - 620 002</p>
            <h3 style="margin-top: 10px; text-decoration: underline;">OFFICE OF THE CONTROLLER OF EXAMINATIONS</h3>
            <h4>CLAIM FOR QUESTION PAPER SETTING</h4>
        </div>

        <div style="margin-bottom: 15px;">
            <div style="margin-bottom: 8px;">
                <span class="label">Programme:</span> <span class="value" style="width: 70%;">@Model.PROGRAMME</span>
            </div>
            <div style="margin-bottom: 8px;">
                <span class="label">Course Code:</span> <span class="value" style="width: 25%;">@Model.COURSE_CODE</span>
                <span class="label" style="margin-left: 20px;">Course Title:</span> <span class="value" style="width: 45%;">@Model.COURSE_TITLE</span>
            </div>
        </div>

        <span class="section-title">Remuneration Details:</span>
        <table>
            <thead>
                <tr>
                    <th style="width: 50%;">Description</th>
                    <th class="text-center" style="width: 15%;">Rate (Rs.)</th>
                    <th class="text-center" style="width: 15%;">No. of Papers</th>
                    <th class="text-right" style="width: 20%;">Amount (Rs.)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Question Paper Setting (@Model.REMUNERATION_TYPE)</td>
                    <td class="text-center">@(Model.REMUNERATION_TYPE == "UG" ? "400" : "600")</td>
                    <td class="text-center">@Model.NO_OF_QUESTION</td>
                    <td class="text-right">@Model.QUESTION_AMOUNT</td>
                </tr>
                <tr>
                    <td>Preparation of Scheme/Solution</td>
                    <td class="text-center">100</td>
                    <td class="text-center">@Model.NO_OF_QUESTION</td>
                    <td class="text-right">@Model.SCHEME_AMOUNT</td>
                </tr>
                <tr>
                    <td colspan="3">Postal Charges / Other Expenses</td>
                    <td class="text-right">@Model.POSTAL_CHARGES</td>
                </tr>
                <tr>
                    <th colspan="3" class="text-right">Total Claim Amount</th>
                    <th class="text-right">@Model.TOTAL_CLAIM</th>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 10px;">
            <span class="label">Rupees in Words:</span> 
            <span class="value" style="width: 80%; font-weight: bold; font-style: italic;">@Model.RUPEES_IN_WORDS</span>
        </div>

        <span class="section-title">Staff Particulars & Bank Details:</span>
        <div class="bank-box">
            <div style="margin-bottom: 8px;">
                <span class="label">Name of the Staff:</span> <span class="value" style="width: 70%;">@Model.STAFF_NAME</span>
            </div>
            <div style="margin-bottom: 8px;">
                <span class="label">Designation:</span> <span class="value" style="width: 70%;">@Model.DESIGNATION</span>
            </div>
            <div style="margin-bottom: 8px;">
                <span class="label">Official Address:</span> <span class="value" style="width: 80%;">@Model.OFFICIAL_ADDRESS</span>
            </div>
            <div style="margin-bottom: 8px;">
                <span class="label">Mobile No:</span> <span class="value" style="width: 200px;">@Model.MOBILE_NO</span>
            </div>
            
            <div style="border-top: 1px solid #ccc; margin-top: 10px; padding-top: 10px;">
                <div style="margin-bottom: 8px;">
                    <span class="label">Account No:</span> <span class="value" style="width: 250px;">@Model.AC_NO</span>
                    <span class="label" style="margin-left: 20px;">IFSC Code:</span> <span class="value" style="width: 150px;">@Model.IFS_CODE</span>
                </div>
                <div style="margin-bottom: 8px;">
                    <span class="label">Bank Name:</span> <span class="value" style="width: 250px;">@Model.BANK</span>
                    <span class="label" style="margin-left: 20px;">Branch:</span> <span class="value" style="width: 150px;">@Model.BRANCH</span>
                </div>
            </div>
        </div>

        <div class="footer">
            <p style="font-weight: bold; font-style: italic;">Certified that I have set the question paper(s) as per the guidelines given by the COE.</p>
            
            <table style="border: none; margin-top: 30px;">
                <tr style="border: none;">
                    <td style="border: none; width: 50%; padding: 0;">
                        <div style="border-top: 1px solid #000; width: 150px; margin-top: 40px; text-align: center; font-weight: bold;">Date</div>
                    </td>
                    <td style="border: none; width: 50%; padding: 0; text-align: right;">
                        <div style="border-top: 1px solid #000; width: 250px; margin-top: 40px; display: inline-block; text-align: center; font-weight: bold;">Signature of Question Setter</div>
                    </td>
                </tr>
            </table>
            
            <div style="margin-top: 40px; border: 2px solid #000; padding: 10px; text-align: center;">
                <p style="margin: 0; font-weight: bold; text-decoration: underline;">FOR OFFICE USE ONLY</p>
                <table style="border: none; margin-top: 30px;">
                    <tr style="border: none;">
                        <td style="border: none; width: 50%; padding: 0; text-align: center;">
                            <div style="border-top: 1px solid #ccc; width: 180px; margin-top: 30px; display: inline-block; font-weight: bold;">Superintendent</div>
                        </td>
                        <td style="border: none; width: 50%; padding: 0; text-align: center;">
                            <div style="border-top: 1px solid #ccc; width: 220px; margin-top: 30px; display: inline-block; font-weight: bold;">Controller of Examinations</div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
