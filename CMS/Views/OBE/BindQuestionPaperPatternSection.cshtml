@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;
    int Count = 0;
}
<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover" id="tblDvOBEQuestionPaperpattern">
        <thead>
            <tr>
                <th>#</th>
                <th>OBE Ques.Level</th>
                <th>Section</th>
                <th>Question Count</th>
                <th>Tobe.Attend</th>
                <th>Mark (Each Question)</th>
                <th>Mark (Each Section)</th>
                <th>Section Description</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.LiOBEQuestionPaperPattern != null && Model.LiOBEQuestionPaperPattern.Count > 0)
                {
                    foreach (var item in Model.LiOBEQuestionPaperPattern)
                    {
                        <tr>
                            <td>@{Count++;} @Count</td>
                            <td>@item.OBE_QUESTIONLEVEL</td>
                            <td>@item.SECTION_NAME</td>
                            <td>@item.TOTAL_QUESTION</td>
                            <td>@item.TO_BE_ATTEND</td>
                            <td>@item.MARK_FOR_EACH_QUESTION</td>
                            <td>@item.MARK_FOR_EACH_SECTION</td>
                            <td>@item.SECTION_DECRIPTION</td>
                            <td>
                                <a href="#Edit-dialog" onclick="FetchOBEPatternById('@item.OBE_QUESTIONPAPERPATTERNSECTION_ID')" data-toggle="modal"><i class="fa fa-edit"></i></a>
                                <a href="javasript:;" onclick="GetConfirm('@item.OBE_QUESTIONPAPERPATTERNSECTION_ID');"><i class="fa fa-trash text-danger"></i></a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
