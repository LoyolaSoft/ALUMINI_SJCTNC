@model CMS.ViewModel.ViewModel.OBEViewModel

@using CMS.Utility;
@{
    Layout = null;

    //double TOTAL_MARK = 0;
}
@if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
{
    if (Model.liCLOCoursewiseAttainment.FirstOrDefault().PO_TYPE == "1")
    {
        <div class="col-md-12 m-t-5 col-sm-12 col-lg-12 table-responsive invoice-content">

            <table class="table table-hover " border="1" id="Attainments">
                <thead>
                    <tr>CO PO Attainment</tr>
                    <tr>
                        <th></th>
                        @if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                        {
                            var grppo = Model.liCLOCoursewiseAttainment.GroupBy(o => o.OBE_POLEVEL_ID).ToList();
                            if (grppo != null && grppo.Count > 0)
                            {
                                foreach (var item in grppo)
                                {
                                    <th> @item.FirstOrDefault().OBE_POLEVEL</th>
                                }
                            }
                        }
                    </tr>


                </thead>
                <tbody>
                    @{
                        if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                        {

                            if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                            {
                                var grpco = Model.liCLOCoursewiseAttainment.GroupBy(o => o.OBE_COLEVEL_ID).ToList();
                                if (grpco != null && grpco.Count > 0)
                                {
                                    foreach (var Co in grpco)
                                    {
                                        <tr>
                                            <td> @Co.FirstOrDefault().OBE_COLEVEL</td>
                                            @{
                                                var grppo = Model.liCLOCoursewiseAttainment.GroupBy(o => o.OBE_POLEVEL_ID).ToList();
                                                if (grppo != null && grppo.Count > 0)
                                                {
                                                    foreach (var po in grppo)
                                                    {
                                                        var grppoco = Model.liCLOCoursewiseAttainment.Where(o => o.OBE_POLEVEL_ID == po.FirstOrDefault().OBE_POLEVEL_ID
                                                        && o.OBE_COLEVEL_ID == Co.FirstOrDefault().OBE_COLEVEL_ID).ToList();
                                                        if (grppoco != null && grppoco.Count > 0)
                                                        {
                                                            foreach (var cocp in grppoco)
                                                            {
                                                                <td>@cocp.OBE_CO_PO_MARK</td>
                                                            }

                                                        }
                                                        else
                                                        {

                                                        }


                                                    }
                                                }
                                                else
                                                {

                                                }

                                            }

                                        </tr>
                                    }
                                }
                            }

                        }
                    }


                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="col-md-12 m-t-5 col-sm-12 col-lg-12 table-responsive invoice-content">

            <table class="table table-hover " border="1" id="Attainments">
                <thead>
                    <tr>CO PSO Attainment</tr>
                    <tr>
                        <th></th>
                        @if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                        {
                            var grppo = Model.liCLOCoursewiseAttainment.GroupBy(o => o.OBE_POLEVEL_ID).ToList();
                            if (grppo != null && grppo.Count > 0)
                            {
                                foreach (var item in grppo)
                                {
                                    <th> @item.FirstOrDefault().OBE_PSOLEVEL</th>
                                }
                            }
                        }
                    </tr>


                </thead>
                <tbody>
                    @{
                        if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                        {

                            if (Model.liCLOCoursewiseAttainment != null && Model.liCLOCoursewiseAttainment.Count > 0)
                            {
                                var grpco = Model.liCLOCoursewiseAttainment.GroupBy(o => o.OBE_COLEVEL_ID).ToList();
                                if (grpco != null && grpco.Count > 0)
                                {
                                    foreach (var Co in grpco)
                                    {
                                        <tr>
                                            <td> @Co.FirstOrDefault().OBE_COLEVEL</td>
                                            @{
                                                var grppo = Model.liCLOCoursewiseAttainment.GroupBy(o => o.OBE_POLEVEL_ID).ToList();
                                                if (grppo != null && grppo.Count > 0)
                                                {
                                                    foreach (var po in grppo)
                                                    {
                                                        var grppoco = Model.liCLOCoursewiseAttainment.Where(o => o.OBE_POLEVEL_ID == po.FirstOrDefault().OBE_POLEVEL_ID
                                                        && o.OBE_COLEVEL_ID == Co.FirstOrDefault().OBE_COLEVEL_ID).ToList();
                                                        if (grppoco != null && grppoco.Count > 0)
                                                        {
                                                            foreach (var cocp in grppoco)
                                                            {
                                                                <td>@cocp.OBE_CO_PO_MARK</td>
                                                            }

                                                        }
                                                        else
                                                        {

                                                        }


                                                    }
                                                }
                                                else
                                                {

                                                }

                                            }

                                        </tr>
                                    }
                                }
                            }

                        }
                    }


                </tbody>

            </table>

        </div>
    }
}





