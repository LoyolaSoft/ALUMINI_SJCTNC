@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    /**/

    Layout = null;

}
@if (Model.UDF1 == "1")
{
    <div class="alert alert-success">CO and PO Mapping</div>
    <div class="col-md-12 table-responsive row">
        <table class="table table-bordered table-hover pull-right" id="tblobeCOPOMatrix">
            <thead>
                <tr>
                    <th>#</th>
                    @{
                        if (Model.LiOBEPOLevel != null && Model.LiOBEPOLevel.Count > 0)
                        {
                            foreach (var item in Model.LiOBEPOLevel)
                            {
                                <th>@item.OBE_POLEVEL</th>
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.LiOBEPOLevel != null && Model.LiOBEPOLevel.Count > 0 && Model.LiOBECOLevel != null && Model.LiOBECOLevel.Count > 0)
                    {
                        foreach (var Coitem in Model.LiOBECOLevel)
                        {
                            <tr>
                                <td>@Coitem.OBE_COLEVEL</td>
                                @{
                                    foreach (var Poitem in Model.LiOBEPOLevel)
                                    {
                                        if (Model.liObeCoPoMapping != null && Model.liObeCoPoMapping.Count > 0)
                                        {
                                            var COPOMark = Model.liObeCoPoMapping.Where(s => s.OBE_COLEVEL_ID == Coitem.OBE_COLEVEL_ID && s.OBE_POLEVEL_ID == Poitem.OBE_POLEVEL_ID && s.PO_TYPE == "1").ToList();
                                            if (COPOMark != null && COPOMark.Count > 0)
                                            {
                                                <td><input type="number" class="form-control input-sm" courseid="@COPOMark.FirstOrDefault().COURSE_ID" copomatrixid="@COPOMark.FirstOrDefault().OBE_MAPPING_ID" colevel="@Coitem.OBE_COLEVEL_ID" polevel="@Poitem.OBE_POLEVEL_ID" maxlength="5" min="0" value="@COPOMark.FirstOrDefault().OBE_CO_PO_MARK" /></td>
                                            }
                                            else
                                            {
                                                <td><input type="number" class="form-control input-sm" style="" courseid="" copomatrixid="" colevel="@Coitem.OBE_COLEVEL_ID" polevel="@Poitem.OBE_POLEVEL_ID" maxlength="5" min="0" value="" /></td>
                                            }
                                        }
                                        else
                                        {
                                            <td><input type="number" class="form-control input-sm" style="" courseid="" copomatrixid="" colevel="@Coitem.OBE_COLEVEL_ID" polevel="@Poitem.OBE_POLEVEL_ID" maxlength="5" min="0" value="" /></td>
                                        }
                                    }
                                }

                            </tr>
                        }


                    }
                }
            </tbody>
        </table>
    </div>
    <br />
    <div class="alert alert-info row col-md-12" style="text-align:center;font-size:14px;font-weight:800;">
        3 - H , 2 - M , 1 - L
    </div>

}
else
{
    <div class="alert alert-success">PO and PSO Mapping</div>
    <div class="col-md-12 table-responsive ">
        <table class="table table-bordered table-hover pull-right" id="tblobeCOPOMatrix">
            <thead>
                <tr>
                    <th>#</th>
                    @{
                        if (Model.LiOBEPSOLevel != null && Model.LiOBEPSOLevel.Count > 0)
                        {
                            foreach (var item in Model.LiOBEPSOLevel)
                            {
                                <th>@item.OBE_PSOLEVEL</th>
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.LiOBEPSOLevel != null && Model.LiOBEPSOLevel.Count > 0 && Model.LiOBECOLevel != null && Model.LiOBECOLevel.Count > 0)
                    {
                        foreach (var Coitem in Model.LiOBECOLevel)
                        {
                            <tr>
                                <td>@Coitem.OBE_COLEVEL</td>
                                @{
                                    foreach (var Poitem in Model.LiOBEPSOLevel)
                                    {
                                        if (Model.liObeCoPoMapping != null && Model.liObeCoPoMapping.Count > 0)
                                        {
                                            var COPOMark = Model.liObeCoPoMapping.Where(s => s.OBE_COLEVEL_ID == Coitem.OBE_COLEVEL_ID && s.OBE_POLEVEL_ID == Poitem.OBE_PSOLEVEL_ID && s.PO_TYPE == "2").ToList();
                                            if (COPOMark != null && COPOMark.Count > 0)
                                            {
                                                <td><input type="number" class="form-control input-sm" courseid="@COPOMark.FirstOrDefault().COURSE_ID" copomatrixid="@COPOMark.FirstOrDefault().OBE_MAPPING_ID" colevel="@Coitem.OBE_COLEVEL_ID" polevel="@Poitem.OBE_PSOLEVEL_ID" maxlength="5" min="0" value="@COPOMark.FirstOrDefault().OBE_CO_PO_MARK" /></td>
                                            }
                                            else
                                            {
                                                <td><input type="number" class="form-control input-sm" style="" courseid="" copomatrixid="" colevel="@Coitem.OBE_COLEVEL_ID" polevel="@Poitem.OBE_PSOLEVEL_ID" maxlength="5" min="0" value="" /></td>
                                            }
                                        }
                                        else
                                        {
                                            <td><input type="number" class="form-control input-sm" style="" courseid="" copomatrixid="" colevel="@Coitem.OBE_COLEVEL_ID" polevel="@Poitem.OBE_PSOLEVEL_ID" maxlength="5" min="0" value="" /></td>
                                        }
                                    }
                                }

                            </tr>
                        }


                    }
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info row col-md-12" style="text-align:center;font-size:14px;font-weight:800;">
        3 - H , 2 - M , 1 - L
    </div>
}
