@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;
    int nCount = 0;
}
<div class="body-content">
    <div class="col-md-12 m-t-5 col-sm-12 col-lg-12 table-responsive">
        @if (Model.liClasscoursestaff != null && Model.liClasscoursestaff.Count > 0)
        {
            <table class="table table-hover table-bordered table-striped" id="OBESubmitList">
                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Staff Code</th>
                        <th>Staff Name</th>
                        <th>Class Name</th>
                        <th>Course Code</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.liClasscoursestaff)
                    {
                        <tr>
                            <td>@{nCount++;}@nCount</td>
                            <td>@item.STAFF_CODE</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.COURSE_CODE</td>
                            <td>
                                @if (item.IS_DELETED != "1")
                                {
                                    <a class="text-success" onclick="UpdateActive('@item.OBE_EXAM_MARK_ENTERED_ID','1')"><i class="fa fa-check"></i></a>
                                }
                                else
                                {
                                    <a class="text-danger" onclick="UpdateActive('@item.OBE_EXAM_MARK_ENTERED_ID','0')"><i class="fa fa-times"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="bg-danger text-center">
                <h3>No Records Found </h3>
            </div>
        }
    </div>
</div>
