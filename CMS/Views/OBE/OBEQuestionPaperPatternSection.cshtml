@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;
    ViewBag.Title = "OBEQuestionPaperPatternSection";
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">OBEQuestionPaperPatternSection</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">OBE Question Paper Pattern Section</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">OBE Question Paper Pattern Section</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12">
                            <div class="col-md-4 form-group">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("OBE Pattern", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.QuestionPattern, (Model.QuestionPattern != null) ? Model.QuestionPattern : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.QuestionPattern, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-1 form-group">
                                <a class="btn btn-primary" id="btnGet" onclick="GetQuestions()">Get</a>
                            </div>
                            <div class="col-md-1 form-group pull-right">
                                <a class="btn btn-success" href="#Edit-dialog" id="btnAdd" data-toggle="modal">Add</a>
                            </div>
                        </div>
                        <div class="col-md-12" id="DvOBEQuestionPaperpattern">

                        </div>
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<div class="modal" id="Edit-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit OBEQuestionPaperPatternSection</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <input type="hidden" id="hdQuestionId" value="">
                            <input type="hidden" id="hdExamSettingId" value="">
                            <input type="hidden" id="hdOBEPatternId" value="">
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Setting</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" value="" class="form-control" id="txtExamSetting" disabled />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">OBE Pattern</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" value="" class="form-control" id="txtobeQuestionPaperPattern" disabled />
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.Label("Question Level", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.OBEQuestionLevel, (Model.OBEQuestionLevel != null) ? Model.OBEQuestionLevel : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.OBEQuestionLevel, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.Label("Section", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Section, (Model.Section != null) ? Model.Section : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Section, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Question Count</label>
                                <div class="col-md-9">
                                    <input type="number" name="name" min="0" value="" class="form-control" id="TOTAL_QUESTION" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">To be Attend</label>
                                <div class="col-md-9">
                                    <input type="number" name="name" min="0" value="" class="form-control" id="TO_BE_ATTEND" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">either or Qus?</label>
                                <div class="col-md-4">
                                    <input type="radio" name="either" value="1" id="either_or_yes" />
                                    <label for="either_or_yes" class="col-md-9">Yes</label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" name="either" value="0" id="either_or_NO" />
                                    <label for="either_or_NO" class="col-md-9">No</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Mark (Each Question)</label>
                                <div class="col-md-9">
                                    <input type="number" min="0" name="name" value="" class="form-control" id="MARK_FOR_EACH_QUESTION" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Mark (Each Section)</label>
                                <div class="col-md-9">
                                    <input type="number" min="0" name="name" value="" class="form-control" id="MARK_FOR_EACH_SECTION" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Section Description</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" value="" class="form-control" id="SECTION_DECRIPTION" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnEditSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad() {
        // handleSummernote();
    }

    $('.selectpicker').selectpicker('refresh');
    $('.selectpicker').selectpicker({
        size: 5
    });


    function GetQuestions() {
        if ($('#QuestionPattern').val()) {
            $.ajax({
                url: "@Url.Action("BindQuestionPaperPatternSection", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sOBEQuestionPaperPatternId: $('#QuestionPattern').val() },
                success: function (data) {
                    $('#DvOBEQuestionPaperpattern').empty();
                    $('#DvOBEQuestionPaperpattern').append(data);
                    $('#tblDvOBEQuestionPaperpattern').DataTable({ "bPaginate": false });
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Choose All Fields .....!');
        }
    };


    $("#ExamSetting").on("change", function () {
        if ($(this).val()) {
            $.ajax({
                url: "@Url.Action("FetchOBEQuestionPaperPattern", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sExamSettingId: $(this).val() },
                success: function (data) {
                    $("#QuestionPattern").empty();
                    $("#QuestionPattern").append('<option value="">---Select---</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Select the Fields ...!')
        }
    });


    function FetchOBEPatternById(id) {
        $('#hdQuestionId').val(id);
        if ($('#ExamSetting').val() && (id != null && id != "")) {
            $.ajax({
                url: "@Url.Action("FetchOBEQuestionPaperPatternSectionbyId", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sOBEQuestionPaperPatternSectionId: id },
                success: function (data) {
                    $('#txtExamSetting').val($("#ExamSetting option:selected").text());
                    $('#txtobeQuestionPaperPattern').val($("#QuestionPattern option:selected").text());
                    $('#hdOBEPatternId').val(data[0].OBE_QUESTIONPAPERPATTERN_ID);
                    $('#OBEQuestionLevel').val(data[0].OBE_QUESTIONLEVEL_ID);
                    $('#Section').val(data[0].SECTION_ID);
                    $('#TOTAL_QUESTION').val(data[0].TOTAL_QUESTION);
                    $('#TO_BE_ATTEND').val(data[0].TO_BE_ATTEND);
                    $('#MARK_FOR_EACH_QUESTION').val(data[0].MARK_FOR_EACH_QUESTION);
                    $('#MARK_FOR_EACH_SECTION').val(data[0].MARK_FOR_EACH_SECTION);
                    $('#SECTION_DECRIPTION').val(data[0].SECTION_DECRIPTION);
                    if (data[0].EITHER_OR=="1") {
                        $('#either_or_yes').prop('checked', true);
                    }
                    else if (data[0].EITHER_OR == "0")  {
                        $('#either_or_NO').prop('checked', true);
                    }
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Choose All Fields .....!');
        }
    };

    function GetConfirm(ID) {

        swal({
            title: "Info !",
            text: "Are you sure want to Delete ?",
            type: "info",
            showCancelButton: true,
            confirmButtonClass: "btn-success",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("DeleteOBEQuestionPaperPatternSection", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sOBEQuestionStructureId: ID },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode != "") {
                        if (data.ErrorCode == "202") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                            GetQuestions();
                        }
                        else {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                        }
                    }
                    else {
                        if (data.Message != null && data.Message != "") {
                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                        }
                    }

                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        })
    }

    $('#btnEditSubmit').on('click', function () {
         
        var jsonObject;

        var status = $('input[name="either"]:checked').val();
        if (typeof status === "undefined") {
            status = "0";
        }

        jsonObject = '{"OBE_QUESTIONPAPERPATTERNSECTION_ID":"' + $('#hdQuestionId').val() + '","OBE_QUESTIONPAPERPATTERN_ID":"' + $('#QuestionPattern').val() + '","OBE_QUESTIONLEVEL_ID":"' + $('#OBEQuestionLevel').val() + '","SECTION_ID":"' + $('#Section').val() + '","TOTAL_QUESTION":"' + $('#TOTAL_QUESTION').val() + '","TO_BE_ATTEND":"' + $('#TO_BE_ATTEND').val() + '","MARK_FOR_EACH_QUESTION":"' + $('#MARK_FOR_EACH_QUESTION').val() + '","MARK_FOR_EACH_SECTION":"' + $('#MARK_FOR_EACH_SECTION').val() + '","SECTION_DECRIPTION":"' + $('#SECTION_DECRIPTION').val() + '","EITHER_OR":"' + status+'"}'
        if (jsonObject != null) {
            $.ajax({
                url: "@Url.Action("SaveOBEQuestionPaperPatternSection", "OBE")",
                method: "post",
                content: "application/json; charset=utf-8",
                data: { sJsonData: jsonObject },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode != "") {
                        if (data.ErrorCode == "202") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                            GetQuestions();
                        }
                        else {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                        }
                    }
                    else {
                        if (data.Message != null && data.Message != "") {
                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                        }
                    }
                }, error: function (e) {
                    swal({ title: "Error !", text: "Internal Server Error !", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                }
            });
        }

    });

    $('#Edit-dialog').on('hidden.bs.modal', function () {
        $(".modal-body input:not([type='radio'])").val("");
        $('#OBEQuestionLevel').val("0");
        $('#Section').val("0");
        $('input[name="either"]').prop('checked', false);
        $('.selectpicker').selectpicker('refresh');
    });
</script>
