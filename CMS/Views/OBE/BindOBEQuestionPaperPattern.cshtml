@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;
    int Count = 0;
}
<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover" id="tblDvOBEQuestionPaperpattern">
        <thead>
            <tr>
                <th>#</th>
                <th>OBE Pattern</th>
                <th>Total Hours</th>
                <th>Total Question</th>
                <th>Total Mark</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.LiOBEQuestionPaperPattern != null && Model.LiOBEQuestionPaperPattern.Count > 0)
                {
                    foreach (var item in Model.LiOBEQuestionPaperPattern)
                    {
                        <tr>
                            <td>@{Count++;} @Count</td>
                            <td>@item.OBE_QUESTIONPAPERPATTERN</td>
                            <td>@item.TOTAL_HOUR</td>
                            <td>@item.TOTAL_QUESTION</td>
                            <td>@item.TOTAL_MARK</td>
                            <td>
                                <a href="#Edit-dialog" onclick="FetchOBEPatternById('@item.OBE_QUESTIONPAPERPATTERN_ID')" data-toggle="modal"><i class="fa fa-edit"></i></a>
                                <a href="javasript:;" onclick="GetConfirm('@item.OBE_QUESTIONPAPERPATTERN_ID');"><i class="fa fa-trash text-danger"></i></a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>