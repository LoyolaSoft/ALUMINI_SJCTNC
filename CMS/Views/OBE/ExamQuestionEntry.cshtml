<!-- MathJax / CKEditor -->
<script src="https://cdn.ckeditor.com/4.22.1/standard-all/ckeditor.js"></script>
<script type="text/x-mathjax-config">
    MathJax.Hub.Config({
        TeX: { extensions: ["mhchem.js"] }
    });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.4/MathJax.js?config=TeX-AMS_HTML"></script>

<script>
    var currentStep = 1;
    var completedSteps = {
        1: false,
        2: false,
        3: false,
        4: false
    };
    var lastFinalizedCourse = null; // Failsafe: Track the course finalized in this session

    function loadProgress() {
        var userId = '@Session[CMS.Utility.Common.SESSION_VARIABLES.USER_ID]';
        var saved = localStorage.getItem('ExamQuestionEntryWorkflow_' + userId);
        if (saved) {
            completedSteps = JSON.parse(saved);
        }
        
        // Failsafe recovery: check if we have a recently finalized course in this session
        var savedCourse = localStorage.getItem('OBE_LastFinalized_' + userId);
        if (savedCourse) {
            lastFinalizedCourse = JSON.parse(savedCourse);
        }
        
        updateTabStates();

        var furthest = 1;
        for (var i = 1; i <= 4; i++) {
            if (completedSteps[i]) {
                furthest = (i < 4) ? i + 1 : 4;
            }
        }
        showTab(furthest);
    }

    function saveProgress() {
        var userId = '@Session[CMS.Utility.Common.SESSION_VARIABLES.USER_ID]';
        localStorage.setItem('ExamQuestionEntryWorkflow_' + userId, JSON.stringify(completedSteps));
    }

    function showTab(step) {
        if (step > 1 && !completedSteps[step - 1] && step > currentStep) {
            swal("Wait!", "Please complete the previous step first.", "warning");
            return;
        }
        
        // Finalized check for Pane 4
        if (step === 4 && !completedSteps[3]) {
            swal("Notice", "Please finalize the Question Entry (Step 3) before proceeding to the Claim Form.", "info");
            return;
        }

        $('.workflow-pane').hide();
        $('#pane-' + step).show();
        $('.workflow-tab').removeClass('active');
        $('#tab-' + step).addClass('active');

        currentStep = step;
        updateTabStates();

        if (step === 4) {
            fetchFinalizedCourses();
        }
    }

    function calculateClaim() {
        var type = $('#claimRemunType').val();
        var noOfQp = parseInt($('#claimNoOfQp').val()) || 0;
        var schemeAmt = parseFloat($('#claimSchemeAmt').val()) || 0;
        var postalAmt = parseFloat($('#claimPostalAmt').val()) || 0;

        var qpRate = (type === 'UG') ? 400 : 600;
        var totalQpAmt = qpRate * noOfQp;

        $('#claimQpAmt').val(totalQpAmt.toFixed(2));

        var totalClaim = totalQpAmt + schemeAmt + postalAmt;
        $('#spanTotalClaim').text(totalClaim.toFixed(2));
        $('#hdnTotalClaim').val(totalClaim.toFixed(2));

        var words = NumberToWords(totalClaim);
        $('#spanWords').text(words);
        $('#hdnRupeesInWords').val(words);
    }

    function NumberToWords(amount) {
        var words = "";
        var amount_parts = amount.toString().split(".");
        var whole_amount = parseInt(amount_parts[0]);
        var decimal_amount = amount_parts.length > 1 ? parseInt(amount_parts[1]) : 0;

        if (whole_amount == 0) return "Zero Only";

        var units = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
        var tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];

        function convert(n) {
            if (n < 20) return units[n];
            if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 !== 0 ? " " + units[n % 10] : "");
            if (n < 1000) return units[Math.floor(n / 100)] + " Hundred" + (n % 100 !== 0 ? " and " + convert(n % 100) : "");
            if (n < 100000) return convert(Math.floor(n / 1000)) + " Thousand" + (n % 1000 !== 0 ? " " + convert(n % 1000) : "");
            if (n < 10000000) return convert(Math.floor(n / 100000)) + " Lakh" + (n % 100000 !== 0 ? " " + convert(n % 100000) : "");
            return convert(Math.floor(n / 10000000)) + " Crore" + (n % 10000000 !== 0 ? " " + convert(n % 10000000) : "");
        }

        words = convert(whole_amount) + " Only";
        return words;
    }

    function fetchFinalizedCourses() {
        var examSettingId = $('#ddlExamSetting').val();
        if (!examSettingId) {
            swal("Wait", "Please select an Exam in Step 3 first.", "warning");
            showTab(3);
            return;
        }

        $('#ddlClaimCourse').empty().append('<option value="">-- Loading Courses... --</option>');
        
        $.ajax({
            url: '@Url.Action("GetFinalizedCourses", "OBE")',
            type: 'POST',
            data: { examSettingId: examSettingId },
            success: function (response) {
                console.log("OBE DEBUG: fetchFinalizedCourses response received", response);
                var ddl = $('#ddlClaimCourse');
                ddl.empty();
                ddl.append('<option value="">--Select Finalized Course--</option>');
                
                var finalCourseList = [];
                var courseIdsMap = {}; // Use plain object for maximum browser compatibility

                // 1. Add courses from server
                if (response.success && response.data && response.data.length > 0) {
                    $.each(response.data, function (i, item) {
                        var cid = String(item.COURSE_ID || "");
                        if (cid && !courseIdsMap[cid]) {
                            finalCourseList.push({
                                id: cid,
                                text: item.COURSE_CODE + ' - ' + item.COURSE_TITLE
                            });
                            courseIdsMap[cid] = true;
                        }
                    });
                }
                console.log("OBE DEBUG: After server merge, count:", finalCourseList.length);

                // 2. Merge with session failsafe if missing from server list
                if (lastFinalizedCourse && lastFinalizedCourse.COURSE_ID) {
                    var fid = String(lastFinalizedCourse.COURSE_ID);
                    if (fid && !courseIdsMap[fid]) {
                        console.log("OBE DEBUG: Injecting session course into list:", fid);
                        finalCourseList.push({
                            id: fid,
                            text: lastFinalizedCourse.COURSE_TEXT
                        });
                        courseIdsMap[fid] = true;
                    }
                }

                // 3. Render unified list
                if (finalCourseList.length > 0) {
                    $.each(finalCourseList, function (i, item) {
                        ddl.append('<option value="' + item.id + '">' + item.text + '</option>');
                    });

                    // 4. Smart Auto-selection
                    if (lastFinalizedCourse && lastFinalizedCourse.COURSE_ID) {
                        var autoId = String(lastFinalizedCourse.COURSE_ID);
                        console.log("OBE DEBUG: Auto-selecting session course:", autoId);
                        ddl.val(autoId);
                        loadClaim();
                    } else if (finalCourseList.length === 1) {
                        console.log("OBE DEBUG: Auto-selecting only available course:", finalCourseList[0].id);
                        ddl.val(finalCourseList[0].id);
                        loadClaim();
                    }
                } else {
                    console.log("OBE DEBUG: No courses found anywhere.");
                    swal({
                        title: "No Finalized Courses Found",
                        text: "If you just finalized questions in Step 3, please wait a moment and click 'Try Again'. You can also manually import the current course.",
                        type: "info",
                        showCancelButton: true,
                        confirmButtonText: "Try Again",
                        cancelButtonText: "Close"
                    }, function(isConfirm) {
                        if (isConfirm) fetchFinalizedCourses();
                    });
                }
            },
            error: function () {
                swal("Error", "Failed to fetch finalized courses.", "error");
            }
        });
    }


    function loadClaim() {
        var courseId = $('#ddlClaimCourse').val();
        var examSettingId = $('#ddlExamSetting').val();

        if (!courseId) {
            $('#claimForm').hide();
            return;
        }

        if (!examSettingId) {
            swal("Selection Required", "Please select an Exam Setting.", "info");
            return;
        }

        $('#claimLoading').show();
        $('#claimForm').hide();

        $.ajax({
            url: '@Url.Action("GetClaimEntry", "OBE")',
            type: 'POST',
            data: { courseId: courseId, examSettingId: examSettingId },
            success: function (response) {
                $('#claimLoading').hide();
                $('#claimForm').show();

                // Prefill basic info if fields are empty
                var courseText = $('#ddlClaimCourse option:selected').text();
                var exploded = courseText.split('-');
                var code = exploded[0] ? exploded[0].trim() : "";
                var title = exploded[1] ? exploded[1].trim() : "";

                if (!$('#claimCourseCode').val()) $('#claimCourseCode').val(code);
                if (!$('#claimCourseTitle').val()) $('#claimCourseTitle').val(title);

                if (response.data) {
                    var data = response.data;
                    
                    // Priority prefill from backend if available
                    if (data.COURSE_CODE) $('#claimCourseCode').val(data.COURSE_CODE);
                    if (data.COURSE_TITLE) $('#claimCourseTitle').val(data.COURSE_TITLE);
                    if (data.PROGRAMME) $('#claimProgramme').val(data.PROGRAMME);

                    if (response.success) {
                        $('#hdnClaimId').val(data.CLAIM_ID);
                        $('#claimRemunType').val(data.REMUNERATION_TYPE);
                        $('#claimNoOfQp').val(data.NO_OF_QUESTION);
                        $('#claimSchemeAmt').val(data.SCHEME_AMOUNT);
                        $('#claimPostalAmt').val(data.POSTAL_CHARGES);
                        $('#claimStaffName').val(data.STAFF_NAME);
                        if (data.MOBILE_NO) $('#claimMobile').val(data.MOBILE_NO);
                        if (data.DESIGNATION) $('#claimDesignation').val(data.DESIGNATION);
                        if (data.OFFICIAL_ADDRESS) $('#claimAddress').val(data.OFFICIAL_ADDRESS);
                        if (data.AC_NO) $('#claimAccNo').val(data.AC_NO);
                        if (data.BANK) $('#claimBank').val(data.BANK);
                        if (data.BRANCH) $('#claimBranch').val(data.BRANCH);
                        if (data.IFS_CODE) $('#claimIfsc').val(data.IFS_CODE);
                        
                        if (data.SUBMISSION_STATUS === '2' || data.SUBMISSION_STATUS === 'SUBMITTED') {
                            $('#claimStatusBadge').html('<span class="label label-success p-5" style="font-size:14px;"><i class="fa fa-check"></i> Final Submitted</span>');
                            $('#claimForm input, #claimForm select, #claimForm textarea').prop('disabled', true);
                            $('#btnSaveClaimDraft, #btnSubmitClaim').hide();
                            $('#btnPreviewClaim').show();
                        } else {
                            $('#claimStatusBadge').html('<span class="label label-warning p-5" style="font-size:14px;">Draft</span>');
                            $('#claimForm input, #claimForm select, #claimForm textarea').prop('disabled', false);
                            $('#btnSaveClaimDraft, #btnSubmitClaim').show();
                            $('#btnPreviewClaim').show();
                        }
                    }
                } else {
                    $('#hdnClaimId').val('');
                    $('#claimStatusBadge').html('<span class="label label-info p-5" style="font-size:14px;">New Claim</span>');
                    $('#claimStaffName').val('@Session[CMS.Utility.Common.SESSION_VARIABLES.USER_NAME]');
                }
                calculateClaim();
            },
            error: function () {
                $('#claimLoading').hide();
                $('#claimForm').show();
                swal("Error", "Failed to load claim details.", "error");
            }
        });
    }

    function saveClaim(status) {
        var formData = {};
        $('#claimForm').serializeArray().forEach(function(item) {
            formData[item.name] = item.value;
        });
        
        formData.SUBMISSION_STATUS = status;
        formData.COURSE_ID = $('#ddlClaimCourse').val();
        formData.EXAM_SETTING_ID = $('#ddlExamSetting').val();

        if (status === 'SUBMITTED') {
            swal({
                title: "Are you sure?",
                text: "Once submitted, you cannot edit the claim form!",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, Final Submit!",
                closeOnConfirm: false
            }, function () {
                performSaveClaim(formData);
            });
        } else {
            performSaveClaim(formData);
        }
    }

    function performSaveClaim(formData) {
        $.ajax({
            url: '@Url.Action("SaveClaimEntry", "OBE")',
            type: 'POST',
            data: { sJsonData: JSON.stringify(formData) },
            success: function (response) {
                if (response.success) {
                    swal("Success", response.message, "success");
                    loadClaim();
                    if (formData.SUBMISSION_STATUS === 'SUBMITTED') {
                        completedSteps[4] = true;
                        saveProgress();
                        updateTabStates();
                    }
                } else {
                    swal("Error", response.message, "error");
                }
            },
            error: function () {
                swal("Error", "Failed to save claim.", "error");
            }
        });
    }

    function previewClaim() {
        var claimId = $('#hdnClaimId').val();
        if (!claimId) {
            swal("Error", "Please save the claim first.", "error");
            return;
        }
        window.open('@Url.Action("PrintClaimForm", "OBE")?claimId=' + claimId, '_blank');
    }
    function SubmitCourseFinalStatus(callback) {
        var courseId = $('#ddlCourse').val();
        var examSettingId = $('#ddlExamSetting').val();
        
        if(courseId && examSettingId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveCourseFinalStatus", "OBE")',
                data: { courseId: courseId, examSettingId: examSettingId },
                success: function(res) {
                    if(callback) callback();
                },
                error: function() {
                    if(callback) callback();
                }
            });
        } else {
            if(callback) callback();
        }
    }

    function handleStep3Finish() {
        // MANDATORY: Capture current course info for Step 4 failsafe immediately
        var currentCourseId = $('#ddlCourse').val();
        var currentCourseText = $('#ddlCourse option:selected').text();
        
        if (currentCourseId) {
            lastFinalizedCourse = {
                COURSE_ID: currentCourseId,
                COURSE_TEXT: currentCourseText
            };
            // Persist to localStorage for robustness across any unintentional refreshes
            var userId = '@Session[CMS.Utility.Common.SESSION_VARIABLES.USER_ID]';
            localStorage.setItem('OBE_LastFinalized_' + userId, JSON.stringify(lastFinalizedCourse));
        }

        // Check if there are any rows that are NOT finalized yet
        var unfinalizedRowsData = [];
        var allRowsFinalized = true;

        $('.tblQusEntryStructure tbody tr').each(function () {
            var row = $(this);
            if (row.find('.locked-label').is(':hidden')) {
                allRowsFinalized = false;
            }
        });

        if (!allRowsFinalized) {
            swal({
                title: "Finalize Questions?",
                text: "You have unfinalized questions for this course. You must finalize them to proceed to the Claim Form correctly. Finalize now?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                confirmButtonText: "Yes, Finalize & Proceed",
                cancelButtonText: "No, Just Proceed",
                closeOnConfirm: false
            }, function (isConfirm) {
                if (isConfirm) {
                    FinalSubmitAllQuestions(function() {
                        SubmitCourseFinalStatus(function() {
                            // Small delay to ensure DB commit is visible to next request
                            setTimeout(function() {
                                completeStep(3);
                            }, 500);
                        });
                    });
                } else {
                    completeStep(3);
                }
            });
        } else {
            SubmitCourseFinalStatus(function() {
                completeStep(3);
            });
        }
    }

    function completeStep(step) {
        completedSteps[step] = true;
        saveProgress();
        updateTabStates();

        if (step < 4) {
            showTab(step + 1);
        }
    }

    function updateTabStates() {
        $('.workflow-tab').each(function (index) {
            var step = index + 1;
            var $tab = $(this);
            
            if (completedSteps[step]) {
                $tab.addClass('completed').removeClass('disabled');
                $tab.find('.tick-mark').show();
            } else {
                $tab.removeClass('completed');
                $tab.find('.tick-mark').hide();
                
                if (step > 1 && !completedSteps[step - 1]) {
                    $tab.addClass('disabled');
                } else {
                    $tab.removeClass('disabled');
                }
            }
        });
    }

    // Required by Dashboard's loadContent() - must be defined for every page
    function ContentLoad() {
    }

    // Initialize on startup
    $(document).ready(function() {
        loadProgress();
        $('.selectpicker').selectpicker();

        // Sync Exam Setting dropdowns and load syllabus cards
        $('#ddlExamSetting').on('change', function() {
            var val = $(this).val();
            $('#ddlExamSettingSyllabus').val(val).selectpicker('refresh');
            LoadSyllabusCards();
        });

        $('#ddlExamSettingSyllabus').on('change', function() {
            var val = $(this).val();
            $('#ddlExamSetting').val(val).selectpicker('refresh');
            LoadSyllabusCards();
        });
    });

    function LoadSyllabusCards() {
        var examSettingId = $('#ddlExamSettingSyllabus').val();
        if (!examSettingId) {
            $('#syllabusCourseCards').html('<div class="col-md-12 text-center text-muted p-5"><i class="fa fa-book fa-3x mb-3 opacity-50"></i><p>Please select an Exam Setting to view the assigned courses.</p></div>');
            return;
        }

        $('#syllabusCourseCards').html('<div class="col-md-12 text-center p-5"><i class="fa fa-spinner fa-spin fa-3x text-primary"></i><br/><br/>Loading assigned courses...</div>');

        $.ajax({
            type: "GET",
            url: "@Url.Action("GetStaffCourseSyllabusList", "OBE")",
            data: { examSettingId: examSettingId },
            success: function (result) {
                if (result.ErrorCode == 202) {
                    var html = '';
                    if (result.oResult && result.oResult.length > 0) {
                        result.oResult.forEach(function (item) {
                            var hasSyllabus = item.FILE_PATH != null && item.FILE_PATH != '';
                            var cardClass = hasSyllabus ? "" : "no-file";
                            
                            html += '<div class="col-md-4 col-sm-6">';
                            html += '   <div class="syllabus-card ' + cardClass + '" onclick="' + (hasSyllabus ? "OpenSyllabusViewer('" + item.FILE_PATH + "', '" + item.COURSE_CODE + "')" : "swal(\"Not Available\", \"Syllabus for this course has not been uploaded yet.\", \"info\")") + '">';
                            html += '       <div class="course-code">' + item.COURSE_CODE + '</div>';
                            html += '       <div class="course-title">' + item.COURSE_TITLE + '</div>';
                            html += '       <div class="view-icon-box" title="' + (hasSyllabus ? 'View Syllabus' : 'Not Available') + '">';
                            html += '           <i class="fa ' + (hasSyllabus ? 'fa-eye' : 'fa-exclamation-triangle') + '"></i>';
                            html += '       </div>';
                            html += '   </div>';
                            html += '</div>';
                        });
                    } else {
                        html = '<div class="col-md-12 text-center text-muted p-5"><i class="fa fa-folder-open-o fa-3x mb-3 opacity-50"></i><p>No courses found for the selected exam setting.</p></div>';
                    }
                    $('#syllabusCourseCards').html(html);
                } else {
                    swal('Error', 'Failed to load courses.', 'error');
                }
            },
            error: function () {
                swal('Error', 'An error occurred while fetching data.', 'error');
            }
        });
    }

    function OpenSyllabusViewer(path, code) {
        var baseUrl = "@Url.Content("~/")";
        if (path.startsWith('/')) {
            path = path.substring(1);
        }
        var url = baseUrl + path;
        $('#syllabusModalLabel').html('<i class="fa fa-file-text-o mr-2"></i> Syllabus: ' + code);
        $('#syllabusIframe').attr('src', url);
        $('#syllabusViewModal').modal('show');
    }

