    function DownloadWord() {
        var content = document.getElementById('previewModalContent').innerHTML;
        var header = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="utf-8"><title>Question Paper</title>' +
            '<style>body{font-family:"Times New Roman",Times,serif;font-size:12pt;} table{border-collapse:collapse;width:100%;} th,td{border:1px solid #999;padding:5px 8px;} th{background:#e8e8e8;} .no-print{display:none;}</style></head><body>';
        var footer = '</body></html>';
        var blob = new Blob([header + content + footer], { type: 'application/msword' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'QuestionPaper.doc';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    // Function to handle saving per grid row
    function SaveQuestionData(btn, isFinalSubmit) {
        debugger;
        var row = $(btn).closest('tr');
        var qidSelector = row.find('.hdnQuestionId');
        var questionId = qidSelector.val(); 
        var unitId = row.find('.liObeUnit').val();
        var levelId = row.find('.liObeQus').val();
        var questionNo = row.find('td:eq(0)').text().trim(); // E.g. "1.A"

        var editorId = row.find('.editor-textarea').attr('id');
        var questionHtml = '';
        if (CKEDITOR.instances[editorId]) {
            questionHtml = CKEDITOR.instances[editorId].getData();
            $('#' + editorId).val(questionHtml); // Fix: Sync the raw textarea value
        }

        var courseId = $('#ddlCourse').val();
        var examSettingId = $('#ddlExamSetting').val();

        var isValid = true;
        
        if (unitId == "" || unitId == "0" || typeof unitId === "undefined") {
            row.find('.liObeUnit').closest('div').addClass('has-error');
            isValid = false;
        } else {
            row.find('.liObeUnit').closest('div').removeClass('has-error');
        }

        if (levelId == "" || levelId == "0" || typeof levelId === "undefined") {
            row.find('.liObeQus').closest('div').addClass('has-error');
            isValid = false;
        } else {
            row.find('.liObeQus').closest('div').removeClass('has-error');
        }

        var rawText = questionHtml.replace(/(<([^>]+)>)/gi, "").replace(/&nbsp;/g, '').trim();
        if (rawText == "" && questionHtml.indexOf('<img') === -1 && questionHtml.indexOf('<span class="math-tex"') === -1) {
            swal("Warning", "Question text cannot be empty. Please enter the question", "warning");
            isValid = false;
        }

        if (!isValid) {
            swal('Warning', 'Please fill all mandatory fields (Unit, Level, Question Text) for this row.', 'warning');
            return false;
        }

        var obj = {
            QUESTION_ID: questionId,
            QUESTION: questionHtml,
            OBE_UNIT_ID: unitId,
            QUESTION_LEVEL_ID: levelId,
            COURSE_ID: courseId,
            EXAM_SETTING_ID: examSettingId,
            FORMULA_EQUATION: questionNo // Using FORMULA_EQUATION slot to temporarily hold the qNum logic to identify it for update if needed.
        };

        if (isFinalSubmit) {
            swal({
                title: 'Final Submit?',
                text: "You won't be able to edit this question after final submission!",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, submit it!'
            }, function (isConfirm) {
                if (isConfirm) {
                    processAjaxSave(row, btn, obj, true, qidSelector);
                }
            });
        } else {
            processAjaxSave(row, btn, obj, false, qidSelector);
        }
    }

    function processAjaxSave(row, btn, obj, finalSubmit, qidSelector) {
        var thisBtn = $(btn);
        var oldHtml = thisBtn.html();
        thisBtn.html('<i class="fa fa-spinner fa-spin"></i>');
        thisBtn.prop('disabled', true);

        $.ajax({
            type: "POST",
            url: "@Url.Action("SaveQuestionEntry", "OBE")",
            data: { sJsonData: JSON.stringify(obj), IsFinalSubmit: finalSubmit },
            success: function (result) {
                thisBtn.prop('disabled', false);
                thisBtn.html(oldHtml);
                if (result.ErrorCode == 202) {
                    if (finalSubmit) {
                        swal('Success', result.Message, 'success');
                        row.find('.btn-draft').hide();
                        row.find('.label-success').show();
                        
                        // Disable dropdowns
                        row.find('.liObeUnit, .liObeQus').prop('disabled', true);
                        row.find('.liObeUnit, .liObeQus').selectpicker('refresh');
                        
                        // Set editor readonly
                        var editorId = row.find('.editor-textarea').attr('id');
                        CKEDITOR.instances[editorId].setReadOnly(true);
                    } else {
                        if (result.sResult) {
                            qidSelector.val(result.sResult);
                            swal('Success', 'Draft saved successfully.', 'success');
                        }
                    }
                } else {
                    swal('Error', result.Message || "Operation failed", 'error');
                }
            },
            error: function () {
                thisBtn.prop('disabled', false);
                thisBtn.html(oldHtml);
                swal('Error', 'An error occurred while saving data.', 'error');
            }
        });
    }

    function FinalSubmitAllQuestions(callback) {
        var courseId = $('#ddlCourse').val();
        var examSettingId = $('#ddlExamSetting').val();
        var allValid = true;
        var questionsData = [];
        
        $('.tblQusEntryStructure tbody tr').each(function () {
            var row = $(this);
            // Skip already submitted ones
            if (row.find('.locked-label').is(':visible')) return;

            var qidSelector = row.find('.hdnQuestionId');
            var questionId = qidSelector.val(); 
            var unitId = row.find('.liObeUnit').val();
            var levelId = row.find('.liObeQus').val();
            var questionNo = row.find('td:eq(0)').text().trim();
            
            var editorId = row.find('.editor-textarea').attr('id');
            var questionHtml = '';
            if (CKEDITOR.instances[editorId]) {
                questionHtml = CKEDITOR.instances[editorId].getData();
                $('#' + editorId).val(questionHtml); // Fix: Sync the raw textarea value
            }

            var rowValid = true;
            if (unitId == "" || unitId == "0" || typeof unitId === "undefined") {
                row.find('.liObeUnit').closest('div').addClass('has-error');
                rowValid = false;
            } else {
                row.find('.liObeUnit').closest('div').removeClass('has-error');
            }

            if (levelId == "" || levelId == "0" || typeof levelId === "undefined") {
                row.find('.liObeQus').closest('div').addClass('has-error');
                rowValid = false;
            } else {
                row.find('.liObeQus').closest('div').removeClass('has-error');
            }

            var rawText = questionHtml.replace(/(<([^>]+)>)/gi, "").replace(/&nbsp;/g, '').trim();
            if (rawText == "" && questionHtml.indexOf('<img') === -1 && questionHtml.indexOf('<span class="math-tex"') === -1) {
                rowValid = false;
            }

            if (!rowValid) {
                allValid = false;
                row.css('background-color', '#fff3f3');
            } else {
                row.css('background-color', '');
                questionsData.push({
                    row: row,
                    qidSelector: qidSelector,
                    obj: {
                        QUESTION_ID: questionId,
                        QUESTION: questionHtml,
                        OBE_UNIT_ID: unitId,
                        QUESTION_LEVEL_ID: levelId,
                        COURSE_ID: courseId,
                        EXAM_SETTING_ID: examSettingId,
                        FORMULA_EQUATION: questionNo
                    }
                });
            }
        });

        if (!allValid) {
            swal('Warning', 'Please fill all mandatory fields (Unit, Level, Question Text) for all pending rows. The invalid rows have been highlighted red.', 'warning');
            return;
        }

        if (questionsData.length === 0) {
            swal('Info', 'All questions are already submitted.', 'info');
            return;
        }

        swal({
            title: 'Final Submit All?',
            text: "You won't be able to edit these questions after final submission!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, submit all!'
        }, function (isConfirm) {
            if (isConfirm) {
                // start batch submit
                submitQueue(questionsData, 0, callback);
            }
        });
    }

    function submitQueue(queue, index, callback) {
        if (index >= queue.length) {
            if (callback && typeof callback === 'function') {
                callback();
            } else {
                swal('Success', 'All questions have been successfully submitted.', 'success');
            }
            return;
        }
        var item = queue[index];
        var row = item.row;
        
        row.find('.btn-draft').html('<i class="fa fa-spinner fa-spin"></i>');
        row.find('.btn-draft').prop('disabled', true);

        $.ajax({
            type: "POST",
            url: "@Url.Action("SaveQuestionEntry", "OBE")",
            data: { sJsonData: JSON.stringify(item.obj), IsFinalSubmit: true },
            success: function (result) {
                if (result.ErrorCode == 202) {
                    row.find('.btn-draft').hide();
                    row.find('.label-success').show();
                    
                    row.find('.liObeUnit, .liObeQus').prop('disabled', true);
                    row.find('.liObeUnit, .liObeQus').selectpicker('refresh');
                    
                    var editorId = row.find('.editor-textarea').attr('id');
                    CKEDITOR.instances[editorId].setReadOnly(true);
                    
                    submitQueue(queue, index + 1, callback);
                } else {
                    swal('Error', 'Failed processing question ' + item.obj.FORMULA_EQUATION + ': ' + result.Message, 'error');
                    row.find('.btn-draft').html('<i class="fa fa-save"></i>');
                    row.find('.btn-draft').prop('disabled', false);
                }
            },
            error: function () {
                swal('Error', 'An error occurred while saving data for question ' + item.obj.FORMULA_EQUATION, 'error');
                row.find('.btn-draft').html('<i class="fa fa-save"></i>');
                row.find('.btn-draft').prop('disabled', false);
            }
        });
    }
</script>

