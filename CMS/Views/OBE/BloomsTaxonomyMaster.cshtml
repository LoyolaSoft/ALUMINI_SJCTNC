@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    Layout = null;
    ViewBag.Title = "BloomsTaxonomyMaster";
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<style>
    .custom-preview-table th { background-color: #348fe2 !important; color: white !important; }
    .custom-preview-table td { vertical-align: middle !important; }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">BloomsTaxonomyMaster</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Blooms Taxonomy Master</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Blooms Taxonomy Master</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12 text-right" style="margin-bottom: 15px;">
                            <a class="btn btn-info" href="#previewModal" data-toggle="modal" style="margin-right: 10px;">
                                <i class="fa fa-eye"></i> Preview
                            </a>
                            <a class="btn btn-success" href="#AddModal" id="btnAdd" data-toggle="modal" onclick="clearData()">
                                <i class="fa fa-plus"></i> Add New
                            </a>
                        </div>
                        <div class="col-md-12" id="divBindData">
                            <!-- Data will be loaded here -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-12 -->
    </div>
    <!-- end row -->
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="AddModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Blooms Taxonomy Master</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <input type="hidden" id="hdnBloomId" name="bloom_id" value="0" />
                    
                    <div class="form-group mb-3 text-left">
                        <label class="control-label col-md-3">K Level <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.OBEQuestionLevel, Model.OBEQuestionLevel, "--Select K Level--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @id = "ddlKLevel", @data_live_search = "true" })
                        </div>
                    </div>

                    <div class="form-group mb-3 text-left" style="margin-top: 15px;">
                        <label class="control-label col-md-3">Cognitive Process <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtCognitiveProcess" name="cognitive_process" />
                        </div>
                    </div>

                    <div class="form-group mb-3 text-left" style="margin-top: 15px;">
                        <label class="control-label col-md-3">Description <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <textarea class="form-control" id="txtDescription" name="description" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="form-group mb-3 text-left" style="margin-top: 15px;">
                        <label class="control-label col-md-3">Action Verbs <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <textarea class="form-control" id="txtActionVerbs" name="action_verbs" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="form-group mb-3 text-left" style="margin-top: 15px;">
                        <label class="control-label col-md-3">Question Stems <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <textarea class="form-control" id="txtSampleQuestionStems" name="sample_question_stems" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="form-group mb-3 text-left" style="margin-top: 15px;">
                        <label class="control-label col-md-3">Display Order <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <input type="number" class="form-control" id="txtDisplayOrder" name="display_order" value="1" min="1" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSave" class="btn btn-sm btn-primary" onclick="SaveData()">Save</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal">
    <div class="modal-dialog modal-lg" style="width: 95%;">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="color:white;">×</button>
                <h4 class="modal-title" style="color:white;">Blooms Taxonomy Preview</h4>
            </div>
            <div class="modal-body overflow-auto">
                <table class="table table-bordered table-striped custom-preview-table">
                    <thead>
                        <tr>
                            <th>Level</th>
                            <th>Cognitive Process</th>
                            <th>Description</th>
                            <th>Action Verbs</th>
                            <th>Sample Question Stems</th>
                        </tr>
                    </thead>
                    <tbody id="previewTableBody">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>

    $(document).ready(function () {
        $('.selectpicker').selectpicker('refresh');
        BindData();
    });

    function BindData() {
        $.ajax({
            type: "POST",
            url: "@Url.Action("BindBloomsTaxonomyMaster", "OBE")",
            success: function (msg) {
                $("#divBindData").html(msg);
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });
    }

    function clearData() {
        $('#hdnBloomId').val('0');
        $('#ddlKLevel').val('');
        $('#txtCognitiveProcess').val('');
        $('#txtDescription').val('');
        $('#txtActionVerbs').val('');
        $('#txtSampleQuestionStems').val('');
        $('#txtDisplayOrder').val('1');
        $('.selectpicker').selectpicker('refresh');
        
        $('[id^=ddlKLevel], #txtCognitiveProcess, #txtDescription, #txtActionVerbs, #txtSampleQuestionStems').closest('.form-group').removeClass('has-error');
    }

    function SaveData() {
        var kLevel = $('#ddlKLevel').val();
        var cogProcess = $('#txtCognitiveProcess').val();
        var description = $('#txtDescription').val();
        var actionVerbs = $('#txtActionVerbs').val();
        var sampleQStems = $('#txtSampleQuestionStems').val();
        var displayOrder = $('#txtDisplayOrder').val();

        var isValid = true;

        if (kLevel == "") {
            $('#ddlKLevel').closest('.form-group').addClass('has-error');
            isValid = false;
        } else {
            $('#ddlKLevel').closest('.form-group').removeClass('has-error');
        }

        if (cogProcess.trim() == "") {
            $('#txtCognitiveProcess').closest('.form-group').addClass('has-error');
            isValid = false;
        } else {
            $('#txtCognitiveProcess').closest('.form-group').removeClass('has-error');
        }

        if (description.trim() == "") {
            $('#txtDescription').closest('.form-group').addClass('has-error');
            isValid = false;
        } else {
            $('#txtDescription').closest('.form-group').removeClass('has-error');
        }

        if (actionVerbs.trim() == "") {
            $('#txtActionVerbs').closest('.form-group').addClass('has-error');
            isValid = false;
        } else {
            $('#txtActionVerbs').closest('.form-group').removeClass('has-error');
        }

        if (sampleQStems.trim() == "") {
            $('#txtSampleQuestionStems').closest('.form-group').addClass('has-error');
            isValid = false;
        } else {
            $('#txtSampleQuestionStems').closest('.form-group').removeClass('has-error');
        }

        if (!isValid) {
            swal('Warning', 'Please fill all mandatory fields.', 'warning');
            return false;
        }

        var obj = {
            bloom_id: $('#hdnBloomId').val(),
            k_level: kLevel,
            cognitive_process: cogProcess,
            description: description,
            action_verbs: actionVerbs,
            sample_question_stems: sampleQStems,
            display_order: displayOrder
        };

        $.ajax({
            type: "POST",
            url: "@Url.Action("SaveBloomsTaxonomyMaster", "OBE")",
            data: { sJsonData: JSON.stringify(obj) },
            success: function (result) {
                if (result.ErrorCode == 202) {
                    swal('Success', result.Message, 'success');
                    $('#AddModal').modal('hide');
                    BindData();
                } else {
                    swal('Error', result.Message, 'error');
                }
            },
            error: function () {
                swal('Error', 'An error occurred while saving data.', 'error');
            }
        });
    }

    function EditOBE(id) {
        clearData();
        $.ajax({
            type: "POST",
            url: "@Url.Action("FetchBloomsTaxonomyMasterById", "OBE")",
            data: { bloom_id: id },
            success: function (result) {
                if (result != null && result.length > 0) {
                    var data = result[0];
                    $('#hdnBloomId').val(data.bloom_id);
                    $('#ddlKLevel').val(data.k_level);
                    $('#txtCognitiveProcess').val(data.cognitive_process);
                    $('#txtDescription').val(data.description);
                    $('#txtActionVerbs').val(data.action_verbs);
                    $('#txtSampleQuestionStems').val(data.sample_question_stems);
                    $('#txtDisplayOrder').val(data.display_order);
                    $('.selectpicker').selectpicker('refresh');
                    $('#AddModal').modal('show');
                }
            },
            error: function () {
                swal('Error', 'An error occurred while fetching data.', 'error');
            }
        });
    }

    function DeleteOBE(id) {
        swal({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }, function (isConfirm) {
            if (isConfirm) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("DeleteBloomsTaxonomyMaster", "OBE")",
                    data: { bloom_id: id },
                    success: function (data) {
                        if (data.ErrorCode == 202) {
                            swal('Deleted!', data.Message, 'success');
                            BindData();
                        } else {
                            swal('Error', data.Message, 'error');
                        }
                    },
                    error: function () {
                        swal('Error', 'An error occurred while deleting data.', 'error');
                    }
                });
            }
        });
    }
</script>
