@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    ViewBag.Title = "OBECoLevelCalculationForCoe";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
@*<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />*@
<link href="~/Content/assets/printout1.css" media="print" rel="stylesheet" />

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }

    #staticcolumn {
        position: sticky;
        left: 0;
        z-index: 0;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">OBE Calculation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">OBE Calculation<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">OBE Calculation</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            @Html.Label("Semester", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                <select class="selectpicker form-control" id="ddlSemester">
                                    <option value="0"> -- Select -- </option>
                                    <option value="1">Odd Semester</option>
                                    <option value="2">Even Semester</option>
                                    <option value="3">Non Semester</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12 form-group">
                        <div class="col-md-4 form-group">
                            @Html.Label("Report Type", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                <select class="selectpicker form-control" id="ddlReportType">
                                    <option value="0"> -- Select -- </option>
                                    <option value="1">Student Course Wise</option>
                                    <option value="2">Student Wise</option>
                                    <option value="3">Course Wise</option>
                                    <option value="4">Class Course Wise</option>
                                    <option value="5">Class Wise</option>
                                    <option value="6">Programme Wise</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4 form-group hidden" id="dvClass">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @if (Model.ClassList != null)
                                {
                                    @Html.DropDownListFor(m => m.ClassList, Model.ClassList, "---Select---", new { @class = "selectpicker form-control  select2", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                }
                            </div>
                        </div>

                        <div class="col-md-4 form-group hidden" id="dvStudent">
                            @Html.Label("Student", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.StudentList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="col-md-4 form-group hidden" id="dvCourse">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="col-md-4 form-group hidden" id="dvProgramme">
                            @Html.Label("Programme Name", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Exam Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <select id="ddlExamType" class="form-control    selectpicker show-menu-arrow show-tick">
                                    <option value="1">Internal</option>
                                    <option value="2">External</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12 form-group">

                        <div class="form-group col-md-4 pull-right">
                            <div class="col-md-8">
                                <a id="submit" href="#" onclick="BindData()" class="btn btn-primary pull-right">Get</a>
                            </div>
                            <div class="col-md-1 col-md-offset-2 pull-right">
                                <a href="javascript:;" id="sPrint" onclick="printDiv('dvOBEMarkbind')" class="btn btn-success m-b-10 pull-right"><i class="fa fa-print m-r-5"></i>Print</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-horizontal">
                    <div class="col-lg-12 landScape" id="dvOBEMarkbind"></div>
                </div>
            }

        </div>

    </div>
</div>
<!-- end #content -->




<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
@*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                introJs().start();
            }, 500);

        });
    </script>*@

<script>
        function ContentLoad() {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });

            var $table = $('table'),
                $bodyCells = $table.find('tbody tr:first').children(),
                colWidth;

            // Get the tbody columns width array
            colWidth = $bodyCells.map(function () {
                return $(this).width();
            }).get();

            // Set the width of thead columns
            $table.find('thead tr').children().each(function (i, v) {
                $(v).width(colWidth[i]);
            });

        }
        $('.selectpicker').selectpicker({
            size: 6
        });
    $('.selectpicker').selectpicker('refresh');

        $('#ClassList').on('change', function ()
        {
            $('#dvOBEMarkbind').empty();
        $.ajax({
            url: '@Url.Action("FetchCourseByClassIdAndSemTypeId", "OBE")',
            method:'POST',
            datatype: 'json',
            data: { sClassId: $('#ClassList').val(), sSemesterTypeId: $('#ddlSemester').val(), sAcYear: $('#AcademicYearList Option:selected').text() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#CourseList').empty();
                    $('#CourseList').append(data.sResult); // cms-sSemesterId
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#ClassList').on('change', function ()
        {
            $('#dvOBEMarkbind').empty();
        $.ajax({
            url: '@Url.Action("FetchStudentByClassId", "OBE")',
            method:'POST',
            datatype: 'json',
            data: { sClassId: $('#ClassList').val() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#StudentList').empty();
                    $('#StudentList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $('#StudentList').on('change', function ()
        {
        $('#dvOBEMarkbind').empty();
        var AcademicYear = $("#AcademicYearList option:selected").text();
        $.ajax({
            url: '@Url.Action("FetchCourseDetailsByStudentIdandExamSettingId", "OBE")',
            method:'POST',
            datatype: 'json',
            data: { sStudentId: $('#StudentList').val(), sExamSettingId: $('#ExamSetting').val(), sAcYear: AcademicYear},
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#CourseList').empty();
                    $('#CourseList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#ddlReportType').on('change', function () {
        var sReportType = $('#ddlReportType').val();
        if (sReportType == "1") {
            $('#dvClass').removeClass('hidden');
            $('#dvStudent').removeClass('hidden');
            $('#dvCourse').removeClass('hidden');
            $('#dvProgramme').addClass('hidden');
        }
        else if (sReportType == "2") {
            $('#dvClass').removeClass('hidden');
            $('#dvStudent').removeClass('hidden');
            $('#dvCourse').addClass('hidden');
            $('#dvProgramme').addClass('hidden');
        }
        else if (sReportType == "3") {
            $('#dvClass').removeClass('hidden');
            $('#dvStudent').addClass('hidden');
            $('#dvCourse').removeClass('hidden');
            $('#dvProgramme').addClass('hidden');
        }
        else if (sReportType == "4") {
            $('#dvClass').removeClass('hidden');
            $('#dvStudent').addClass('hidden');
            $('#dvCourse').removeClass('hidden');
            $('#dvProgramme').addClass('hidden');
        }
        else if (sReportType == "5") {
            $('#dvClass').removeClass('hidden');
            $('#dvStudent').addClass('hidden');
            $('#dvCourse').addClass('hidden');
            $('#dvProgramme').addClass('hidden');
        }
        else if (sReportType == "6") {
            $('#dvClass').addClass('hidden');
            $('#dvStudent').addClass('hidden');
            $('#dvCourse').addClass('hidden');
            $('#dvProgramme').removeClass('hidden');
        }
    });

    $("#AcademicYearList").on("change", function () {
        var AcademicYear = $("#AcademicYearList option:selected").text();
        $.ajax({
            url: "@Url.Action("ExamSettingByAcademicYear", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sACYear: AcademicYear },
            success: function (data) {
                $("#ExamSetting").empty();
                $("#ExamSetting").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });



    function BindData() {
        if ($('#CourseList').val()) {
            $('#dvOBEMarkbind').empty();
            var AcademicYear = $("#AcademicYearList option:selected").text();
            var vReportType = $("#ddlReportType").val();
            var vProgramme = $("#ProgrammeList").val();
            $.ajax({
                url: "@Url.Action("BindOBECoLevelCalculationForCoe", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sExamSettingId: $('#ExamSetting').val(), sCourseId: $('#CourseList').val(), sClassId: $('#ClassList').val(), sExamType: $('#ddlExamType').val(), sACYear: AcademicYear, sReportType: vReportType, sStudentId: $('#StudentList').val(), sProgramme: vProgramme},
                success: function (data) {
                    $('#dvOBEMarkbind').append(data);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Choose All Fields .....!');
        }

        };




    function printDiv(divName) {
         

        var printContents = document.getElementById(divName).innerHTML;
        const imgData = myChart.canvas.toDataURL();
        const img = new Image();
        img.src = imgData;
        img.onload = function () {
            const printWindow = window.open('', 'Print Chart');
            printWindow.document.write('<html><head><title>Print Chart</title></head><body>');
            printWindow.document.write('<div class="table table-hover table-bordered table-striped table-responsive">' + printContents + '</div>');
            printWindow.document.write('<img src="' + imgData + '" style="width:100%">');
            printWindow.document.write('</body></html>');
            printWindow.print();

        }

    }

</script>







