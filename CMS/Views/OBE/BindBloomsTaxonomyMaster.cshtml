@model CMS.ViewModel.ViewModel.OBEViewModel
@{
    int i = 0;
}
<div class="table-responsive">
    <table class="table table-bordered table-striped" id="data_table">
        <thead class="bg-primary">
            <tr>
                <th>S.No</th>
                <th>K Level</th>
                <th>Cognitive Process</th>
                <th>Description</th>
                <th>Action Verbs</th>
                <th>Sample Question Stems</th>
                <th>Display Order</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LiBloomsTaxonomyMaster != null && Model.LiBloomsTaxonomyMaster.Count > 0)
            {
                foreach (var item in Model.LiBloomsTaxonomyMaster)
                {
                    <tr class="align-middle">
                        <td>@(++i)</td>
                        <td>@item.k_level</td>
                        <td>@item.cognitive_process</td>
                        <td>@item.description</td>
                        <td>@item.action_verbs</td>
                        <td>@item.sample_question_stems</td>
                        <td>@item.display_order</td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="return EditOBE('@item.bloom_id');" title="Edit"><i class="fa fa-pencil"></i></a>
                            <a class="btn btn-sm btn-danger" href="javascript:void(0)" onclick="return DeleteOBE('@item.bloom_id');" title="Delete"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function () {
        $('#data_table').DataTable({
            "pageLength": 10,
            "ordering": false
        });

        // Generate dynamic preview rows
        var previewHtml = '';
        @if (Model.LiBloomsTaxonomyMaster != null && Model.LiBloomsTaxonomyMaster.Count > 0)
        {
            foreach(var item in Model.LiBloomsTaxonomyMaster)
            {
                <text>
                previewHtml += '<tr>';
                previewHtml += '<td>@Html.Raw(HttpUtility.JavaScriptStringEncode(item.k_level))</td>';
                previewHtml += '<td>@Html.Raw(HttpUtility.JavaScriptStringEncode(item.cognitive_process))</td>';
                previewHtml += '<td>@Html.Raw(HttpUtility.JavaScriptStringEncode(item.description))</td>';
                previewHtml += '<td>@Html.Raw(HttpUtility.JavaScriptStringEncode(item.action_verbs))</td>';
                previewHtml += '<td>@Html.Raw(HttpUtility.JavaScriptStringEncode(item.sample_question_stems != null ? item.sample_question_stems.Replace("\n", "<br/>") : ""))</td>';
                previewHtml += '</tr>';
                </text>
            }
        }
        $('#previewTableBody').html(previewHtml);
    });
</script>
