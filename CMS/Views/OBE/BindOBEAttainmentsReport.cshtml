@model CMS.ViewModel.ViewModel.OBEViewModel

@using CMS.Utility;
@{
    Layout = null;
    //string TOTAL_MARK = string.Empty;
    double TOTAL_MARK = 0;
}
<div>
    <div class="invoice-company">

    </div>
    @if (Model.LiOBEQuestionPaperStructure != null && Model.LiOBEQuestionPaperStructure.Count > 0)
    {
        <div class="col-md-12 m-t-5 col-sm-12 col-lg-12 table-responsive">
            <table class="table table-hover " border="1" id="Attainments">
                <tr>
                    <td>
                        <strong>
                            <label>Programme Name : </label><span class="semi-bold"> @Model.LiCOAttainments.FirstOrDefault().PROGRAMME_NAME</span>
                        </strong><br />
                    </td>
                    <td>
                        <strong>
                            <label>Year : </label><span class="semi-bold">@Model.sAcyear</span>
                        </strong><br />
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>
                            <label>Class &nbsp; : </label><span class="semi-bold"> @Model.LiCOAttainments.FirstOrDefault().CLASS_NAME</span>
                        </strong><br />
                    </td>
                    <td>
                        <strong>
                            <label>Semester  &nbsp; : @Model.sSemester</label><span class="semi-bold" id="sSemester"></span>
                        </strong><br />
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>
                            <label>Course &nbsp; Name: </label><span class="semi-bold"> @Model.LiCOAttainments.FirstOrDefault().COURSE_TITLE</span>
                        </strong><br />
                    </td>
                    <td>
                        <strong>
                            <label>Course Code : </label><span class="semi-bold"> @Model.LiCOAttainments.FirstOrDefault().COURSE_CODE</span>
                        </strong><br />
                    </td>
                </tr>
            </table>
        </div>



    }


    <div class="col-md-12 m-t-5 col-sm-12 col-lg-12 table-responsive invoice-content">
        @*@{int count = 0;}*@
        <table class="table table-hover " border="1" id="Attainments">
            <thead>
                <tr>
                    <th>
                        CO
                    </th>

                    @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                    {
                        var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();

                        foreach (var item in grpco)
                        {
                            int co = 0;
                            var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                            foreach (var qusno in grpqusno)
                            {
                                var grprbt1 = Model.LiCOAttainments.Where(o => o.QUS_NO == qusno.FirstOrDefault().QUS_NO
                                && o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL).ToList();
                                foreach (var i in grprbt1)
                                {
                                    co++;
                                }
                            }


                            <th colspan="@co">@item.FirstOrDefault().OBE_COLEVEL  </th>
                        }


                    }

                    <th>Total</th>
                    <th>Grade</th>

                </tr>
                <tr>
                    <th>
                        Blooms Taxonomoy Level
                    </th>
                    @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                    {
                        var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                        foreach (var item in grpco)
                        {
                            var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                            foreach (var qusno in grpqusno)
                            {
                                var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                foreach (var item1 in grprbt)
                                {
                                    <th>@item1.OBE_RBT_LEVEL  </th>
                                }
                            }


                        }
                    }

                    <th></th>
                    <th></th>
                </tr>
                <tr>
                    <th>
                        Question Number

                    </th>
                    @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                    {
                        var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                        foreach (var item in grpco)
                        {
                            var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                            foreach (var qusno in grpqusno)
                            {
                                var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                foreach (var item1 in grprbt)
                                {
                                    <th>@item1.QUS_NO  </th>
                                }
                            }


                        }
                    }
                    <th></th>
                    <th></th>
                </tr>
                <tr>
                    <th>
                        Maximum Marks
                    </th>
                    @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                    {
                        var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                        foreach (var item in grpco)
                        {
                            var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                            foreach (var qusno in grpqusno)
                            {
                                var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                foreach (var item1 in grprbt)
                                {
                                    <th>@item1.MAX_MARK  </th>
                                    TOTAL_MARK += Convert.ToDouble(item1.MAX_MARK);
                                }
                            }


                        }
                    }
                    <th>
                        @TOTAL_MARK
                    </th>
                    <th>
                        Grade
                    </th>

                </tr>
                <tr>
                    <th>Roll. No.</th>
                </tr>
            </thead>
            <tbody>

                @if (Model.liobemarks != null && Model.liobemarks.Count > 0)
                {

                    var studentlist = Model.liobemarks.GroupBy(o => o.STUDENT_ID).ToList();
                    if (studentlist != null && studentlist.Count > 0)
                    {

                        foreach (var item in studentlist)
                        {
                            TOTAL_MARK = 0;

                            <tr>
                                <td>
                                    @item.FirstOrDefault().ROLL_NO
                                </td>
                                @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                                {
                                    var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                                    if (grpco != null && grpco.Count > 0)
                                    {
                                        foreach (var co in grpco)
                                        {
                                            var grpqusno = Model.LiCOAttainments.Where(X => X.CO_LEVEL == co.FirstOrDefault().CO_LEVEL).GroupBy(o => o.QUS_NO).ToList();
                                            if (grpqusno != null && grpqusno.Count > 0)
                                            {
                                                foreach (var qusno in grpqusno)
                                                {
                                                    var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == co.FirstOrDefault().CO_LEVEL
                                                    && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();

                                                    if (grprbt != null && grprbt.Count > 0)
                                                    {
                                                        foreach (var item1 in grprbt)
                                                        {
                                                            var stu = Model.liobemarks.Where(o => o.STUDENT_ID == item.FirstOrDefault().STUDENT_ID &&
                                                              o.OBE_QUESTIONMARKSTRUCTURE_ID == item1.QUS_NO).ToList();
                                                            if (stu != null && stu.Count > 0)
                                                            {

                                                                <td>@stu.FirstOrDefault().SECURED_MARK</td>
                                                                TOTAL_MARK += Convert.ToDouble(@stu.FirstOrDefault().SECURED_MARK);
                                                            }
                                                            else
                                                            {
                                                                <td>-</td>
                                                            }

                                                        }
                                                    }
                                                    else
                                                    {

                                                    }

                                                }
                                            }
                                            else
                                            {

                                            }



                                        }
                                    }
                                    else
                                    {

                                    }

                                }

                                <td>@TOTAL_MARK</td>
                                <td></td>
                            </tr>
                        }
                    }

                    <tr></tr>
                    <tr>

                        <td>
                            Number of students
                        </td>
                        @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                        {
                            var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                            foreach (var item in grpco)
                            {
                                var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                                foreach (var qusno in grpqusno)
                                {
                                    var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                    && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                    foreach (var item1 in grprbt)
                                    {
                                        <td>@item1.NO_OF_STUDENT  </td>

                                    }
                                }


                            }
                        }
                        @{var stuc = Model.liobemarks.GroupBy(o => o.STUDENT_ID).ToList();
                            if (stuc != null && stuc.Count > 0)
                            {
                                <td>@stuc.Count()</td>
                            }
                            else
                            {
                                <td>0</td>
                            }
                        }

                    </tr>
                    <tr>

                        <td>
                            Score above 50%
                        </td>
                        @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                        {
                            var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                            foreach (var item in grpco)
                            {
                                var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                                foreach (var qusno in grpqusno)
                                {
                                    var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                    && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                    foreach (var item1 in grprbt)
                                    {
                                        <td>@item1.THRESSHOLD  </td>

                                    }
                                }


                            }
                        }
                    </tr>
                    <tr>

                        <td>
                            Attainment %

                        </td>
                        @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                        {
                            var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                            foreach (var item in grpco)
                            {
                                var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                                foreach (var qusno in grpqusno)
                                {
                                    var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                    && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                    foreach (var item1 in grprbt)
                                    {
                                        <td>@item1.ATTAINMENT  </td>

                                    }
                                }


                            }
                        }
                    </tr>
                    <tr>

                        <td>
                            Attainment on 3 point scale

                        </td>
                        @if (Model.LiCOAttainments != null && Model.LiCOAttainments.Count > 0)
                        {
                            var grpco = Model.LiCOAttainments.GroupBy(o => o.CO_LEVEL).ToList();
                            foreach (var item in grpco)
                            {
                                var grpqusno = Model.LiCOAttainments.GroupBy(o => o.QUS_NO).ToList();
                                foreach (var qusno in grpqusno)
                                {
                                    var grprbt = Model.LiCOAttainments.Where(o => o.CO_LEVEL == item.FirstOrDefault().CO_LEVEL
                                    && o.QUS_NO == qusno.FirstOrDefault().QUS_NO).ToList();
                                    foreach (var item1 in grprbt)
                                    {
                                        <td>@item1.POINTSCALE  </td>

                                    }
                                }


                            }
                        }
                    </tr>

                    <tr></tr>




                }





            </tbody>

        </table>

    </div>
</div>


