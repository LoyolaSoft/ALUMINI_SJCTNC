@model CMS.ViewModel.ViewModel.OBEViewModel

@{
    ViewBag.Title = "OBEStudentMarkEntry";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
@*<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />*@
<link href="~/Content/assets/printout1.css" media="print" rel="stylesheet" />

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }

    #staticcolumn {
        position: sticky;
        left: 0;
        z-index: 0;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">OBE Mark Entry</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">OBE Mark Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">OBE Mark Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @if (Model.ClassList != null)
                                {
                                    @Html.DropDownListFor(m => m.ClassList, Model.ClassList, "---Select---", new { @class = "selectpicker form-control  select2", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                }
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12 form-group">
                        <div class="col-md-4 form-group">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Component", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.OBECOComponent, (Model.OBECOComponent != null) ? Model.OBECOComponent : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Exam Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <select id="ddlExamType" class="form-control    selectpicker show-menu-arrow show-tick">
                                    <option value="1">Internal</option>
                                    <option value="2">External</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-4 pull-right">
                            <div class="col-md-8">
                                <a id="submit" href="#" onclick="BindData()" class="btn btn-primary pull-right">Get</a>
                            </div>
                            <div class="col-md-2 form-group hidden" id="btnCIAMove">
                                <a class="btn btn-success" id="btnCIAPush" href="#mdCIAPush" data-toggle="modal" onclick="BindData()">CIA Push</a>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="form-horizontal">
                    <div class="col-lg-12 landScape" id="dvOBEMarkbind"></div>
                </div>
            }
            <div class="col-md-12 row">
                <div class="col-lg-4 hidden" id="dvsubmit">
                    <a href="#" class="btn-success btn " id="btnSubmit">Submit</a>
                </div>
                <div class="col-lg-4 hidden " id="dvFinalsubmit">
                    <a href="#" class="btn-success btn " id="btnFinalSubmit">Final Submit</a>
                </div>
            </div>

        </div>

    </div>
</div>
<!-- end #content -->

<div class="modal" id="mdCIAPush">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">CIA Push</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-md-3">Course Component</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ComponentList, (Model.ComponentList != null) ? Model.ComponentList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnModalSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
