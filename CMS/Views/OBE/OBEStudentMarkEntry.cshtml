<script>
        function ContentLoad() {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });

            var $table = $('table'),
                $bodyCells = $table.find('tbody tr:first').children(),
                colWidth;

            // Get the tbody columns width array
            colWidth = $bodyCells.map(function () {
                return $(this).width();
            }).get();

            // Set the width of thead columns
            $table.find('thead tr').children().each(function (i, v) {
                $(v).width(colWidth[i]);
            });

        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
        $('#ClassList').on('change', function () {
            var inp = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("GetCourseListByClassIdAndStaffId", "OBE")",
                async: false,
                data: { sClassId: inp },
                success: function (option) {
                    var select = $('#CourseList');
                    select.empty();
                    select.append('<option value="0" >---Select---</option>' + option);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (ex) {
                    alert(ex);
                }

            });
        });

    $("#AcademicYearList").on("change", function () {
        var AcademicYear = $("#AcademicYearList option:selected").text();
        $.ajax({
            url: "@Url.Action("ExamSettingByAcademicYear", "OBE")",
            method: "POST",
            datatype: "json",
            data: { sACYear: AcademicYear },
            success: function (data) {
                $("#ExamSetting").empty();
                $("#ExamSetting").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });



    function BindData() {
        if ($('#CourseList').val()) {
            $('#dvOBEMarkbind').empty();
            if ($('#ddlExamType').val()=="1") {
                $('#btnCIAMove').removeClass('hidden');
                $('#dvsubmit').removeClass('hidden');
                $('#btnMove').addClass('hidden');
            }
            else {
                $('#btnMove').removeClass('hidden');
                $('#dvsubmit').removeClass('hidden');
                $('#btnCIAMove').addClass('hidden');
                $('#dvFinalsubmit').removeClass('hidden');
            }
            var AcademicYear = $("#AcademicYearList option:selected").text();
            $.ajax({
                url: "@Url.Action("BindOBEQuestionMarkEntry", "OBE")",
                method: "POST",
                datatype: "json",
                data: { sExamSettingId: $('#ExamSetting').val(), sCourseId: $('#CourseList').val(), sClassId: $('#ClassList').val(), sCOComponentId: $('#OBECOComponent').val(), sExamType: $('#ddlExamType').val(), sAcademicYear: AcademicYear},
                success: function (data) {
                    //$('#dvOBEMarkbind').append(data);
                    var divHtml = $('#dvOBEMarkbind');
                    divHtml.empty();
                    divHtml.html(data);
                    $('.selectpicker').selectpicker('refresh');

                    SumTotal();
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Choose All Fields .....!');
        }

        };

    function Validate() {
        var validate = 0;
        $('#OBEMarkList tbody tr td').each(function () {
            if ($(this).find('input[type="number"]').attr("cmsstudentid")) {
                if (parseInt($(this).find('input[type="number"]').val()) > parseInt($(this).find('input[type="number"]').attr("max"))) {
                    $(this).find('input[type="number"]').css('color', 'red');
                    validate = 1;
                } else {
                    $(this).find('input[type="number"]').css('color', 'black');
                }
            }
        });
        return validate;
    }
    function sValidate()
    {
       var svalidate = 0;
       var nCount = 1;
        $('#OBEMarkList tbody tr').each(function ()
        {
            nCount++;
            var secA=0;
            var secB=0;
            var secC=0;
            var secD = 0;
            var QusNo = [];
            $(this).find('td').each(function ()
            {

                if ($(this).find('input[type="number"]').attr("cmsstudentid"))
                {
                    //alert($(this).find('input[type="number"]').attr("cmsomark"));
                    if ($(this).find('input[type="number"]').val() != "" && $(this).find('input[type="number"]').val() != "0")
                    {

                        if ($(this).find('input[type="number"]').attr("cmssectionid") == "1") {
                            secA++;
                            if ($(this).find('input[type="number"]').attr("cmsTobeAttened") < secA) {
                                $(this).find('input[type="number"]').css('color', 'red');
                                $("table tr:eq(" + nCount + ") td:eq(0)").css('color', 'red');
                                svalidate = 1;
                                return false;
                            }

                        }
                        else if ($(this).find('input[type="number"]').attr("cmssectionid") == "2") {
                             
                            secB++;
                            var classNo = $(this).find('input[type="number"]').attr("cmsqno").split(' ')[0];
                            if (QusNo.length > 0) {
                                let comp = QusNo.find(x => x == classNo);
                                if (comp == undefined || comp == 'undefined') {
                                    QusNo.push(classNo);
                                }
                                else {
                                    $(this).find('input[type="number"]').css('color', 'red');
                                    $("table tr:eq(" + nCount + ") td:eq(0)").css('color', 'red');
                                    svalidate = 1;
                                    return false;
                                }

                            } else {
                                QusNo.push(classNo);
                            }
                            if ($(this).find('input[type="number"]').attr("cmsTobeAttened") < secB) {

                                $(this).find('input[type="number"]').css('color', 'red');
                                $("table tr:eq("+nCount+") td:eq(0)").css('color', 'red');
                                svalidate = 1;
                                return false;
                            }

                        }
                        else if ($(this).find('input[type="number"]').attr("cmssectionid") == "3") {
                            secC++;
                            var classNo = $(this).find('input[type="number"]').attr("cmsqno").split(' ')[0];
                            if (QusNo.length > 0) {
                                let comp = QusNo.find(x => x == classNo);
                                if (comp == undefined || comp == 'undefined') {
                                    QusNo.push(classNo);
                                }
                                else {
                                    $(this).find('input[type="number"]').css('color', 'red');
                                    $("table tr:eq(" + nCount + ") td:eq(0)").css('color', 'red');
                                    svalidate = 1;
                                    return false;
                                }

                            } else {
                                QusNo.push(classNo);
                            }
                            if ($(this).find('input[type="number"]').attr("cmsTobeAttened") < secC) {
                                $(this).find('input[type="number"]').css('color', 'red');
                                $("table tr:eq(" + nCount + ") td:eq(0)").css('color', 'red');
                                svalidate = 1;
                                return false;
                            }

                        }
                        else if ($(this).find('input[type="number"]').attr("cmssectionid") == "4") {
                            secD++;
                            if ($(this).find('input[type="number"]').attr("cmsTobeAttened") < secD) {
                                $(this).find('input[type="number"]').css('color', 'red');
                                $("table tr:eq(" + nCount + ") td:eq(0)").css('color', 'red');
                                svalidate = 1;
                                return false;
                            }

                        }
                        else {
                            console.log("hello");
                        }
                    } else {
                        $(this).find('input[type="number"]').css('color', 'black');
                    }
                }
            });

        });
        return svalidate;

    }
