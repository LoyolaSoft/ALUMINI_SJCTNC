                                sJson2 += '{"STUDENT_ID":"' + sStudentId + '","COURSE_ID":"' + sCourseId + '","OBE_COMPONENT_ID":"' + $('#OBECOComponent').val() + '","EXAM_SETTING_ID":"' + sExamSettingId + '","OBE_ABSENT_ID":"' + sAbsenteeId + '"},';
                                ncount++;
                            }

                        });
                    }

            });
                if (ncount > 0) {
                    sJson2 = sJson2.slice(0, -1);
                }

                sJson2 += ']}';
            }


            $.ajax({
                url: "@Url.Action("SaveOBEQuestionMarkEntry", "OBE")",
                async: false,
                method: "POST",
                content: "application/json; charset=utf-8",
                data: { sJsonData: sJson, SJsonAbsentee: sJson2},
                success: function (data) {
                    confirm(data.Message);
                    BindData()
                    removeload();
                }, error: function (e) {
                    removeload();
                    alert(e);
                }
            });
        } else {

            alert('Please select course...!');
        }
    });

    function SumTotal() {
        $('#OBEMarkList tbody tr').each(function () {
            var Total = 0;
            if ($(this).attr("cmsrstudentid")) {
                $(this).find('td').each(function () {
                    if ($(this).find('input[type="number"]').attr("cmsstudentid")) {
                        if (($(this).find('input[type="number"]').val() != "")) {
                            Total += parseFloat(($(this).find('input[type="number"]').val()))
                        }
                    }
                    if ($(this).find('input[type="number"]').attr("cmsrtotal")) {
                        $(this).find('input[type="number"]').val(Total);
                    }
                })
            }
        });
    }
        function printDiv(divName) {
