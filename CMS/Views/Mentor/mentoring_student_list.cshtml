@model CMS.ViewModel.ViewModel.SupportDataViewModel
@{
    ViewBag.Title = "mentoring_student_list";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<style>
    body {
        background: #f3f6fa;
    }
    .content {
        padding:1px;
    }
    /* 🌟 Center Container */
    .center-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    /* 🌟 Modern Center Card */
    .staff-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        margin: 10px auto;
        max-width: 500px; /* ⭐ Fixed width to center nicely */
        width: 100%;
        text-align: center;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.10);
        transition: 0.25s ease;
    }

        .staff-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        }

    /* Profile Photo */
    .staff-photo {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border-radius: 50%;
        border: 5px solid #e1f2ff;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        margin-bottom: 20px;
    }

    /* Staff Name */
    .staff-card h4 {
        font-weight: 700;
        margin-top: 10px;
        color: #003d66;
        letter-spacing: 0.5px;
    }

    /* Staff ID */
    .staff-card p {
        color: #888;
        margin-top: -6px;
        font-size: 1rem;
    }

    /* Section Title */
    .section-title {
        font-weight: 700;
        color: #fff;
        background: #0077b6;
        padding: 12px;
        border-radius: 8px;
        margin: 25px auto;
        width: 70%;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    /* Detail Rows */
    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 5px;
        border-bottom: 1px dashed #ccc;
    }

    .detail-label {
        font-weight: 600;
        color: #005b7f;
        width: 40%;
        text-align: left;
    }

    .detail-value {
        color: #444;
        width: 60%;
        text-align: right;
    }

    /* Mobile */
    @@media (max-width: 768px) {
        .staff-card {
            max-width: 90%;
            padding: 10px;
        }

        .detail-row {
            flex-direction: column;
            text-align: left;
        }

        .detail-value {
            text-align: left;
            margin-top: 5px;
        }
    }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Mentoring List</li>
    </ol>
    <h1 class="page-header text-center">Mentoring Details</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <h4 class="panel-title">Mentoring Staff</h4>
        </div>

        <div class="panel-body">

            @if (Model.liMentorStudent != null && Model.liMentorStudent.Count > 0)
            {
                var s = Model.liMentorStudent.FirstOrDefault();

                <div class="center-wrapper">

                    <div class="staff-card">

                        @if (!string.IsNullOrEmpty(s.PHOTO))
                        {
                            <img src="@s.PHOTO" class="staff-photo" />
                        }
                        else
                        {
                            <img src="~/Content/assets/img/transparent/e-user.jpg" class="staff-photo" />
                        }

                        <h4>@s.FIRST_NAME</h4>
                        <p>@s.STAFF_ID</p>

                        <div class="section-title">Staff Details</div>
                        <div style="color:#d9534f; font-size:15px; font-weight:bold; text-align:center; margin-top:10px;">

                            Meeting Room: @Model.liMentorStudent.FirstOrDefault().ROOM_NO

                        </div>
                        <div class="detail-row">
                            <div class="detail-label">Name:</div>
                            <div class="detail-value">@s.FIRST_NAME</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Phone No:</div>
                            <div class="detail-value">@s.MOBILE_NO</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Designation:</div>
                            <div class="detail-value">@s.DESIGNATION</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Department:</div>
                            <div class="detail-value">@s.DEPARTMENT</div>
                        </div>

                    </div>
                </div>
            }
            else
            {
                <div style="color:#d9534f; font-size:18px; font-weight:bold; text-align:center; margin-top:10px;">
                    No Mentor Allocated. Please Contact Your Class Teacher.
                </div>



            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
