@model CMS.ViewModel.ViewModel.SupportDataViewModel
@{
    ViewBag.Title = "MentorStudentListForStaff";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/css/lightbox.min.css" rel="stylesheet" />

<style>
    .img-thumb {
        padding: 4px;
        line-height: 1.42857143;
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        transition: all .2s ease-in-out;
        max-width: 100%;
        height: 70px;
        width: 70px;
    }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Mentor Student List</li>
    </ol>
    <h1 class="page-header">Mentor Student List</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Mentor Student List</h4>
        </div>

        <div class="panel-body no-padding">
            <br />
            @if (Model.liMentorForStaff != null && Model.liMentorForStaff.Count > 0)
            {
                var count = 0;
                <!-- RIGHT ALIGNED BUTTONS -->
                <div class="text-right" style="margin-bottom:10px;">
                    <button class="btn btn-success btnPrint" onclick="printDiv()">Print</button>
                    <button class="btn btn-primary btnExport" onclick="Export()">Export</button>
                    <a href="@Url.Action("ExportallData", "Mentor")" class="btn btn-info btnExportAll"><i class="fa fa-file-excel-o"></i> Export All Data</a>
                </div>
                <div>
                    <div style="color:#d9534f; font-size:18px; font-weight:bold; text-align:center; margin-top:10px;">
                        <p>Meeting Room: @Model.liMentorForStaff.FirstOrDefault().ROOM_NO </p>
                    </div>
                </div>
                <!-- EXPORT + PRINT CONTENT -->
                <div id="divbind">
                    <div class=" col-md-12 table-responsive">
                        <table class="table table-hover table-bordered" id="tblMentorStudent">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Roll No</th>
                                    <th>Details</th>
                                    <th>Photo</th>
                                    <th>Name</th>
                                    <th>Class Name</th>
                                    <th>Department</th>
                                    <th>Stu Mobile</th>
                                    <th>Father No</th>


                                </tr>
                            </thead>
                            <tbody>


                                @foreach (var item in Model.liMentorForStaff)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.ROLL_NO</td>
                                        <td>
                                            <a onclick="ViewStudentDetails('@item.STUDENT_ID')" title="CliCk To View"><i class="fa fa-eye text-primary"></i></a>
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrEmpty(item.PHOTO))
                                            {
                                                <img src="@item.PHOTO" class="img-thumb" alt="@item.ROLL_NO" />
                                            }
                                            else
                                            {
                                                <img src="~/Content/assets/img/transparent/e-user.jpg" class="img-thumb" alt="@item.ROLL_NO Icon" />
                                            }
                                        </td>
                                        <td>@item.FIRST_NAME</td>
                                        <td>@item.CLASS_NAME</td>
                                        <td>@item.DEPARTMENT</td>
                                        <td>@item.STU_MOBILENO</td>
                                        <td>@item.FR_MOBILE</td>

                                    </tr>
                                }


                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div style="color:#d9534f; font-size:18px; font-weight:bold; text-align:center; margin-top:10px;">
                    No Student Allocated.
                </div>

            }
        </div>
        <br />
    </div>
</div>




<div class="modal fade" id="studentModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Student Details</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="row pull-center p-3">
                <div class="col-md-3 btnPrintDiv">
                    <button class="btn btn-success btnPrint" onclick="printStudentDiv()"> Print </button>
                </div>
                <div class="col-md-3 btnExcelDiv">
                    <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                </div>
            </div>
            <div class="modal-body" id="studentDetailsBody">
                <!-- Details will be loaded dynamically here -->
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/js/lightbox.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>


    function Export() {
        $('#tblMentorStudent').DataTable().destroy();
        var title = "Student_Report";
        let file = new Blob([$('#divbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        $('#tblMentorStudent').DataTable({});
    }

    function printDiv() {
        $('#tblMentorStudent').DataTable().destroy();

        var divContents = document.getElementById('divbind').innerHTML;

        // Open new window for printing
        var printWindow = window.open('', '', 'height=600,width=800');

        // Include all page CSS
        printWindow.document.write('<html><head><title>Print</title>');
        $('link[rel=stylesheet]').each(function () {
            printWindow.document.write('<link rel="stylesheet" href="' + $(this).attr('href') + '" />');
        });
        printWindow.document.write('</head><body>');
        printWindow.document.write(divContents);
        printWindow.document.write('</body></html>');

        printWindow.document.close();
        printWindow.focus();

        printWindow.print();
        printWindow.close();
        $('#tblMentorStudent').DataTable({});
    }
    function printStudentDiv() {

        var divContents = document.getElementById('studentDetailsBody').innerHTML;

        // Open new window for printing
        var printWindow = window.open('', '', 'height=600,width=800');

        // Include all page CSS
        printWindow.document.write('<html><head><title>Print</title>');
        $('link[rel=stylesheet]').each(function () {
            printWindow.document.write('<link rel="stylesheet" href="' + $(this).attr('href') + '" />');
        });
        printWindow.document.write('</head><body>');
        printWindow.document.write(divContents);
        printWindow.document.write('</body></html>');

        printWindow.document.close();
        printWindow.focus();

        printWindow.print();
        printWindow.close();
    }


    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblMentorStudent').DataTable({});
        //add
    });



    function ViewStudentDetails(studentId) {
        $.ajax({
            url: '@Url.Action("ViewStudentListByStudentId", "Mentor")',
            method: 'POST',
            datatype: 'json',
            data: { sStudentId: studentId },
            success: function (data) {
                $('#studentDetailsBody').empty();
                if (data.Message != null && data.Message != '') {
                    alert(data.Message);
                } else {
                    $('#studentDetailsBody').append(data);
                    $('#studentModal').modal('show');
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }
</script>
