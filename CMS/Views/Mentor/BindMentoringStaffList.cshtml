@model CMS.ViewModel.ViewModel.SupportDataViewModel

<style>
    .mentor-table-container {
        margin-top: 25px;
        margin-bottom: 25px;
        padding: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        font-size: 14px;
        text-align: center;
    }

    th {
        background: #007bff;
        color: white;
        padding: 12px;
        font-size: 15px;
    }

    td {
        padding: 10px;
        vertical-align: middle;
    }

    tr:nth-child(even) {
        background: #f9f9f9;
    }

    td, th {
        border: 1px solid #ddd;
    }

    .no-record {
        text-align: center;
        padding: 45px;
        font-size: 20px;
        color: #a94442;
        font-weight: bold;
    }

        .no-record i {
            font-size: 28px;
            margin-right: 10px;
            color: #d9534f;
        }
</style>

<div class="mentor-table-container">
    @if (Model.liAllotedMentorList != null && Model.liAllotedMentorList.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Staff Name</th>
                    @*<th>Staff Gender</th>*@
                    <th>Roll No</th>
                    <th>Student Name</th>
                    @*<th>Student Gender</th>*@
                    <th>Class</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staffGroup in Model.liAllotedMentorList.GroupBy(g => new { g.STAFF_ID, g.STAFF_NAME, g.STAFF_GENDER }))
                {
                    var rowCount = staffGroup.Count();
                    bool firstRow = true;

                    foreach (var item in staffGroup)
                    {
                        <tr>
                            @if (firstRow)
                            {
                                <td rowspan="@rowCount" style="font-weight:bold; background:#eef5ff;">@item.STAFF_NAME</td>
                                @*<td rowspan="@rowCount" style="font-weight:bold; background:#eef5ff;">@item.STAFF_GENDER</td>*@
                                firstRow = false;
                            }

                            <td style="text-align:left;">@item.ROLL_NO</td>
                            <td style="text-align:left;">@item.STUDENT_NAME</td>
                            @*<td style="text-align:left;">@item.STUDENT_GENDER</td>*@
                            <td style="text-align:left;">@item.CLASS_NAME</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="no-record">
            <i class="fa fa-exclamation-circle"></i> No Records Found
        </div>
    }
</div>
