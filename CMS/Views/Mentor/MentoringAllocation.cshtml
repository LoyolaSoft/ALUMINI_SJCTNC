

@model CMS.ViewModel.Model.TransferCertificate

@{
    ViewBag.Title = "MentoringAllocation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("STUDENT","DashBoard")">Home</a></li>
        <li><a href="@Url.Action("TransferCertificate","Student")">Mentoring Staff Allocation</a></li>
        <li class="active">Mentoring Staff Allocation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Mentoring Staff Allocation</h1>
    <!-- end page-header -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Mentoring Staff Allocation</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row m-t-5">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.programmeLevel, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.programmeLevel, (Model.programmeLevel != null) ? Model.programmeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.programmeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row m-t-5">

                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgramName, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ClassYear, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ClassYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <a id="btnSubmit" class="btn btn-primary pull-right">Process</a>
                        </div>
                        <div class="form-group col-md-1">
                            <a id="BtnGet" class="btn btn-primary pull-right">Get</a>
                        </div>
                    </div>

                    <br /><br /><br />
                    <div class="form-horizontal">
                        <div class="col-md-12" id="bindData">

                        </div>

                    </div>

                </div>
            }
        </div>
    </div>

</div>

<script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $('.selectpicker').selectpicker({
        size: 4
    });
    ContentLoad = function () {
        $('.multiselect').multiselect({
            includeSelectAllOption: true,
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true,
            maxHeight: 200,
            numberDisplayed: 1,
            templates: {
                button: '<button type="button" class="multiselect dropdown-toggle form-control input-sm col-md-9 " data-toggle="dropdown"><span class="multiselect-selected-text"></span> <b class="caret"></b></button>',
                ul: '<ul class="multiselect-container dropdown-menu" style="max-width:350px;"></ul>'
            }
        });
    }
</script>
<script>
    $("#ShiftList").on("change", function ()
    {
        fetchProgramme();
    });
    $("#programmeLevel").on("change", function ()
    {
        fetchProgramme();
    });
    function fetchProgramme()
    {
        var sShift = $("#ShiftList").val().join(",");
        var pLevel = $("#programmeLevel").val();
        if ($("#ShiftList").val() && $("#programmeLevel").val())
        {
            $.ajax({
                url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift, programmeLevel: pLevel },
                success: function (data) {
                    $("#ProgramName").empty();
                    $("#ProgramName").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    $("#ProgramName").on("change", function () {
        FetchClass();
    });
    $("#ClassYear").on("change", function () {
        FetchClass();
    });
    function FetchClass()
    {
            var ProgramName = String($("#ProgramName").val());
            var classyear = $("#ClassYear").val();
        var sShift = $("#ShiftList").val().join(",");
        if ($("#ClassYear").val() && $("#ShiftList").val() && $("#ProgramName").val())
        {
            $.ajax({
                url: "@Url.Action("BindDDLClassList", "Student")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                success: function (data) {
                    $("#ClassName").empty();
                    $("#ClassName").append( data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };

    $("#ClassName").on("change", function () {
        FetchStudentDetails();
    });
    $("#AcademicYear").on("change", function () {
        FetchStudentDetails();
    });
    function FetchStudentDetails()
    {
            var ProgramName = $("#ProgramName").val();
        var ClassName = String($("#ClassName").val());
        var classyear = $("#ClassYear").val();

            var AcademicYear = $('#AcademicYear option:selected').text();
        if ($("#ClassName").val() && $('#AcademicYear option:selected').text())
        {
            if (AcademicYear == '--select--' || AcademicYear == '0') {
                alert('Please Choose All The Values...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("FetchStudentListByAcYearClass", "Student")",
                method: "POST",
                datatype: "json",
                data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
                success: function (option) {
                    $('#StuName').attr("multiple", "multiple");
                    $("#StuName").empty().append(option).multiselect("destroy").multiselect({
                        includeSelectAllOption: true,
                        enableFiltering: true,
                        enableCaseInsensitiveFiltering: true,
                        maxHeight: 200,
                        numberDisplayed: 1,
                        templates: {
                            button: '<button type="button" class="multiselect dropdown-toggle form-control input-sm col-md-9 " data-toggle="dropdown"><span class="multiselect-selected-text"></span> <b class="caret"></b></button>',
                            ul: '<ul class="multiselect-container dropdown-menu" style="max-width:350px;"></ul>'
                        }
                    });

                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    };
  $("#btnSubmit").on("click", function () {

    var sShift = ($("#ShiftList").val() || []).join(",");
    var classyear = ($("#ClassYear").val() || []).join(",");
    var AcademicYear = $("#AcademicYear option:selected").text();
    var ProgramName = ($("#ProgramName").val() || []).join(",");
    var Programlevel = $("#programmeLevel").val();

    // Validation
    if (!AcademicYear || AcademicYear === "0" || !ProgramName || ProgramName.length === 0 ||
        !sShift || sShift.length === 0 || !classyear || classyear.length === 0 ||
        !Programlevel || Programlevel === "0")
    {
        Swal.fire({
            icon: "warning",
            title: "Validation Error",
            text: "Please choose all the values!"
        });
        return false;
    }

    Swal.fire({
        title: "Are you sure?",
        text: "Do you want to process mentoring allocation?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, process",
        cancelButtonText: "Cancel"
    }).then((result) => {

        if (result.isConfirmed) {

            $("#btnSubmit").prop("disabled", true).text("Processing...");

            $.ajax({
                url: '@Url.Action("SaveStaffMetoringAllotment", "Mentor")',
                type: "POST",
                data: {
                    sAcademicYear: AcademicYear,
                    sProgramName: ProgramName,
                    sShift: sShift,
                    classyear: classyear,
                    sProgramLevel: Programlevel
                },
                success: function (response) {

                    Swal.fire({
                        icon: response.Status ? "success" : "info",
                        title: response.Status ? "Success" : "Info",
                        text: response.Message
                    });

                    $("#btnSubmit").prop("disabled", false).text("Process");
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Internal Server Error!"
                    });
                    $("#btnSubmit").prop("disabled", false).text("Process");
                }
            });
        }
    });
});

  $("#BtnGet").on("click", function () {

    var sShift = ($("#ShiftList").val() || []).join(",");
    var classyear = ($("#ClassYear").val() || []).join(",");
    var AcademicYear = $("#AcademicYear option:selected").text();
    var ProgramName = ($("#ProgramName").val() || []).join(",");
    var Programlevel = $("#programmeLevel").val();

    // Validation
    if (!AcademicYear || AcademicYear === "0" ||
        !ProgramName || ProgramName.length === 0 ||
        !sShift || sShift.length === 0 ||
        !classyear || classyear.length === 0 ||
        !Programlevel || Programlevel === "0") {

        Swal.fire({
            icon: 'warning',
            title: 'Warning',
            text: 'Please Choose All The Values...!!!'
        });
        return false;
    }

    // Loader
    Swal.fire({
        title: 'Please wait...',
        html: 'Loading data...',
        allowOutsideClick: false,
        allowEscapeKey: false,
        allowEnterKey: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    $.ajax({
        url: '@Url.Action("BindMentoringStaffList", "Mentor")',
        type: "POST",
        data: {
            sAcademicYear: AcademicYear,
            sProgramName: ProgramName,
            sShift: sShift,
            classyear: classyear,
            sProgramLevel: Programlevel
        },
        success: function (response) {
            Swal.close();  // close loader
            $("#bindData").html(response);
            $("#btnSubmit").prop("disabled", false).text("Process");


        },
        error: function () {
            Swal.close();
            $("#btnSubmit").prop("disabled", false).text("Process");
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Internal Server Error!'
            });
        }
    });

});


</script>

