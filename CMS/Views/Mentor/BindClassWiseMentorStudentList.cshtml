@model CMS.ViewModel.ViewModel.MentoringViewModel
@using CMS.Utility;
@{
    Layout = null;
    int count = 0;
}


<div class="row">
    <div class="form-horizontal">
        <div class="col-md-12"></div>
    </div>
</div>
<hr />
@if (Model.StudentTagMapping != null)
{
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="tblTagMapping">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Roll No</th>
                        <th>First Name</th>
                        <th>Staff Name</th>
                        <th>Department</th>
                        <th>Staff Mobile</th>

                    </tr>
                </thead>

                <tbody>
                    @foreach (var student in Model.StudentTagMapping)
                    {
                        count++;
                        <tr cms-student-id="@student.STUDENT_ID"
                            cms-class-id="@student.CLASS_ID">

                            <td>@count</td>
                            <td>@student.ROLL_NO</td>
                            <td>@student.STUDENT_NAME</td>
                            <td>@student.STAFF_NAME</td>
                            <td>@student.DEPARTMENT</td>
                            <td>@student.MOBILE_NO</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>


    </div>
}
else
{
    <div class="alert bg-pink">Sorry! No records available.</div>
}

<!-- JS Libraries -->
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>





