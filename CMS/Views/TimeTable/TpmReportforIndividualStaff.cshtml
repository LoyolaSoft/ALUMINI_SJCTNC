<div class="content" id="content">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">CITS Report</li>
    </ol>
    <h2 class="page-header">CITS Consolidated Report </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CITS Consolidated Report </h4>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-12">
                    <ul class="nav nav-tabs">
                        <li class="nav-items active">
                            <a href="#bindDateWiseReport" data-toggle="tab" class="nav-link active">
                                <span class="d-sm-none">Date Wise</span>
                                @*<span class="d-sm-block d-none">Report</span>*@
                            </a>
                        </li>
                        <li class="nav-items">
                            <a href="#bindStaffWiseReport" data-toggle="tab" class="nav-link">
                                <span class="d-sm-none">Staff Wise</span>
                                @*<span class="d-sm-block d-none">Report</span>*@
                            </a>
                        </li>
                        <li class="nav-items " id="bindOverAllReport">
                            <a href="#bindOverAllReportAchor" data-toggle="tab" class="nav-link">
                                <span class="d-sm-none">OverAll Report</span>
                                @*<span class="d-sm-block d-none">Report</span>*@
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade" id="bindDateWiseReport">
                            <div class="form-horizontal">
                                <div class="col-md-12">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-5" })
                                        <div class="col-md-7">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker ", @data_live_search = "true", @data_parsley_required = "true", @id = "DAcyear" })
                                                @Html.ValidationMessageFor(m => m.AcademicYear, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Sem Type</label>
                                        <div class="col-md-8">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.SemesterTypeList, (Model.SemesterTypeList != null) ? Model.SemesterTypeList : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker ", @data_live_search = "true", @data_parsley_required = "true", @id = "DSemType" })
                                                @Html.ValidationMessageFor(m => m.SemesterTypeList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">From Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="datetimepicker1">
                                                <input class="form-control" id="Datefrom" placeholder="Pick Date" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">To Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="datetimepicker1">
                                                <input class="form-control" id="Dateto" placeholder="Pick Date" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <a href="javascript:;" id="btnGetDateWise" class="btn btn-sm btn-primary m-b-10 pull-right"> Get</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="bindStaffWiseReport">
                            <div class="form-horizontal">
                                <div class="col-md-12">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker ", @data_live_search = "true", @data_parsley_required = "true", @id = "sAcyear" })
                                                @Html.ValidationMessageFor(m => m.AcademicYear, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-3">Sem Type</label>
                                        <div class="col-md-9">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.SemesterTypeList, (Model.SemesterTypeList != null) ? Model.SemesterTypeList : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker ", @data_live_search = "true", @data_parsley_required = "true", @id = "sSemType" })
                                                @Html.ValidationMessageFor(m => m.SemesterTypeList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", @data_parsley_required = "true" })
                                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.CourseList, htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_parsley_required = "true" })
                                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="bindOverAllReportAchor">
                            <div class="form-horizontal">
                                <div class="col-md-12">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-5" })
                                        <div class="col-md-7">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker ", @data_live_search = "true", @data_parsley_required = "true", @id = "oAcyear" })
                                                @Html.ValidationMessageFor(m => m.AcademicYear, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Sem Type</label>
                                        <div class="col-md-8">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.SemesterTypeList, (Model.SemesterTypeList != null) ? Model.SemesterTypeList : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker ", @data_live_search = "true", @data_parsley_required = "true", @id = "oSemType" })
                                                @Html.ValidationMessageFor(m => m.SemesterTypeList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group col-lg-12">
                <div id="divbindPage">
                    <!--Need to use this fied to bind Student List-->
                </div>
            </div>
        </div>
    </div>
}
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        $('#bindDateWiseReport').addClass("active in");
        $('.nav-items').on("click", function () {

            $('#divbindPage').html('');

        });
        var todayDate = new Date();
        var day = todayDate.getDate();
        var month = todayDate.getMonth() + 1;
        var year = todayDate.getFullYear();
        if (day < 10) {
            day = '0' + day
        }
        if (month < 10) {
            month = '0' + month;
        }
        var formatDate = day + '/' + month + '/' + year;
        document.getElementById('Datefrom').value = formatDate;

    });
    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $("#Datefrom").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
                $("#Dateto").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
            }
            handleDatepicker();
        });
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>
<script>
    function Validate() {
        $("#Dateto").rules('add', { greaterThan: "#Datefrom" });
    }

    $("#btnGetDateWise").on('click', function () {
            var DateFrom = $("#Datefrom").val();
        var DateTo = $("#Dateto").val();
        var acYear = $("#DAcyear option:Selected").text();
        var semType = $("#DSemType").val();
        if ($("#Dateto").val() && $("#Datefrom").val() && $("#DAcyear").val() && $("#DSemType").val())
        {
                $.ajax({
                    url: '@Url.Action("BindCITSReportinDateWise", "TimeTable")',
                    data: { sdate: DateFrom, edate: DateTo, sAcyear: acYear, sSemType:semType },
                    success: function (option) {
                        var dvDateWiseStudentPaidStatus = $('#divbindPage');
                        dvDateWiseStudentPaidStatus.empty();
                        dvDateWiseStudentPaidStatus.append(option);

                        $("#tbltpmReport").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                            , {
                                extend: "excel", className: "btn-sm"
                            }
                            , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": true, "ordering": true
                        });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
    });
    $("#CourseList").on('change', function () {
        BindCourseWiseCITSReport();
    });
    $("#ClassList").on('change', function () {
       
        fetchCourseList();
        
    });
    $("#sAcyear").on('change', function () {
       
        FetchClassList();
        
    });
    $("#sSemType").on('change', function () {
        
        FetchClassList();
        
    });
    function FetchClassList()
{
        var acYear = $("#sAcyear option:Selected").text();
        var semType = $("#sSemType").val();
        if ($("#sSemType").val() && $("#sAcyear").val()) {

            $.ajax({
                url: "@Url.Action("FetchttClassByAcYearandSem", "TimeTable")",
                method: "POST",
                datatype: "html",
                data: { sAcYear: acYear, SemType: semType },
                success: function (data) {
                     
                    var select = $("#ClassList");
                    select.empty();
                    if (data.sResult != null && data.sResult != '') {
                        select.append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');

                    } else {
                        myAlert(data.Message, 'gritter-danger', '');
                        $('.selectpicker').selectpicker('refresh');
                    }
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    myAlert('Internal Server Error ...!', 'gritter-danger', '');
                }
            });
        }
    };
    function fetchCourseList()
{
        var ClassID = String($("#ClassList").val());
        var acYear = $("#sAcyear option:Selected").text();
        var semType = $("#sSemType").val();
        if ($("#ClassList").val() && $("#sAcyear option:Selected").text() && $("#sSemType").val())
        {
            $.ajax({
                url: "@Url.Action("FetchttCourseByClassID", "TimeTable")",
                method: "POST",
                datatype: "html",
                data: { sClassID: ClassID, sAcYear: acYear, semType: semType },
                success: function (data) {
                    var select = $("#CourseList");
                    select.empty();
                    

                    if (data.sResult != null && data.sResult != '') {
                        select.append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else {
                        myAlert(data.Message, 'gritter-danger', '');
                        $('.selectpicker').selectpicker('refresh');
                    }
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    myAlert('Internal Server Error ...!', 'gritter-danger', '');
                }
            });
        }
    };



    function BindCourseWiseCITSReport() {
        var ClassID = String($("#ClassList").val());
        var CourseID = String($("#CourseList").val());
        var acYear = $("#sAcyear option:Selected").text();
        var semType = $("#sSemType").val();
        if ($("#ClassList").val() && $("#sAcyear option:Selected").text() && $("#CourseList").val() && $("#sSemType").val())
        {
            $.ajax({
                url: '@Url.Action("BindCITSReportinCourseWise", "TimeTable")',
                data: { sClass: ClassID, sCourse: CourseID, SacYear: acYear, semType: semType },
                success: function (option) {
                    var dvDateWiseStudentPaidStatus = $('#divbindPage');
                    dvDateWiseStudentPaidStatus.empty();
                    dvDateWiseStudentPaidStatus.append(option);

                    $("#tbltpmReport").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                        , {
                            extend: "excel", className: "btn-sm"
                        }
                        , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": true, "ordering": true
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    };
    $("#oAcyear").on('change', function () {

        OverAllCITSReport();

    });
    $("#oSemType").on('change', function () {

        OverAllCITSReport();

    });
     function OverAllCITSReport() {
        var acYear = $("#oAcyear option:Selected").text();
        var semType = $("#oSemType").val();
        if ($("#oAcyear option:Selected").text() && $("#oSemType").val())
        {
            $.ajax({
                url: '@Url.Action("BindCITSReportinSubjectWiseforStraff", "TimeTable")',
                data: { sAcYear: acYear, semType: semType },
                success: function (option) {
                    var dvDateWiseStudentPaidStatus = $('#divbindPage');
                    dvDateWiseStudentPaidStatus.empty();
                    dvDateWiseStudentPaidStatus.append(option);

                    $("#tbltpmReport").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                            , {
                            extend: "excel", className: "btn-sm"
                        }
                            , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": true, "ordering": true
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }

    }

</script>
