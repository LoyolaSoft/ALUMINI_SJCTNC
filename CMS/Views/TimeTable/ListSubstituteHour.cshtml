@model CMS.ViewModel.ViewModel.TimeTableViewModel

@{ 
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Substitute Hour</li>
    </ol>
    <h1 class="page-header">Substitute Hour</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Substitute Hour</h4>
        </div>
        <div class="panel-body" id="maindiv">

            <div class="form-horizontal">
                <div class="col-md-12">
                    <div class="form-group col-md-5">
                        @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true"})
                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                        </div>

                    </div>

                    <div class="form-group  col-md-2">
                        <button name="get" class="btn btn-primary" id="btnGet">Get</button>
                    </div>
                    <div class="form-group col-md-2 pull-right">
                        <div class="col-md-6"><button name="excel" id="excel" class="btn btn-success">Excel</button><br></div>
                        <div class="col-md-6"><button class="btn btn-primary" onclick="printDiv('loaddiv')" id="print">Print</button></div>
                    </div>
                </div>
                <div class="col-md-12 form-group table-responsive">
                    <div id="loaddiv">

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


<div class="modal" id="EditModal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Edit Class Wise Time Table</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">

                    <div class="form-group">
                        <label class="control-label col-md-3"> Day Order : </label>
                        <div class="col-md-9">
                            <label class="control-label"> <b id="lblDayOrder"></b> </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3"> Hour : </label>
                        <div class="col-md-9">
                            <label class="control-label"> <b id="lblHour"></b> </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3"> Class : </label>
                        <div class="col-md-9">
                            <label class="control-label"> <b id="lblClass"></b> </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3"> Course : </label>
                        <div class="col-md-9">
                            <label class="control-label"> <b id="lblCourse"></b> </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3"> Staff : </label>
                        <div class="col-md-9">
                            <select id="ddlStaff" class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" data-live-search="true">
                                <option value="">-- select --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Date : </label>
                        <div class="col-md-9">
                            <select id="ddlDate" class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" data-live-search="true">
                                <option value="">-- select --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Substitute Staff : </label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" id="btnSubmit" class="btn btn-default" data-dismiss="modal">Submit</button>
                <button type="submit" id="btnRemove" class="btn btn-default" data-dismiss="modal">Remove</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Feilds-->
<input type="text" class="form-control input-sm hidden" disabled id="txtSubstituteId" />
<input type="text" class="form-control input-sm hidden" disabled id="txtDayOrderId" />
<input type="text" class="form-control input-sm hidden" disabled id="txtHourId" />
<input type="text" class="form-control input-sm hidden" disabled id="txtCourseId" />
<input type="text" class="form-control input-sm hidden" disabled id="txtStaffId" />
<!-- Hidden Feilds-->



<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        $('.selectpicker').selectpicker({
            size: 4
        });
    }

    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        //loadContent('/TIMETABLE/TimetableReportStaffBased');
    }

    $('#excel').live('click', function ()
    {
        let file = new Blob([$('#loaddiv').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "SubstituteHour.xls"
        }).appendTo("body").get(0).click();

    });

    $('#btnGet').on('click', function ()
    {
        var sClassId = $('#ClassList').val();
        $.ajax({
            url: "/TimeTable/BindSubstituteHourByClassId",
            method: "POST",
            datatype: "json",
            data: { sClassId: sClassId },
            success: function (data)
            {
                $('#loaddiv').empty();
                $('#loaddiv').append(data);
            },
            error: function ()
            {
                alert('Internal Server Error !');
            }
        })
    });
</script>




@* Value td Click Event *@
<script>
        
        $("table.table td.editable").live("click", function ()
        {
            var HourId = $(this).attr('cms-hourid');
            var DayId = $(this).attr('cms-dayid');
            var ClassId = $('#ClassList').val();
            var CourseId = $(this).attr('cms-courseid');
            var StaffId = $(this).attr('cms-staffid');
            var SubstituteId = $('#txtSubstituteId').val();
            
            var sJsonData;
            sJsonData = '{"SUBSTITUTE_ID":"' + SubstituteId + '","CLASS_ID":"' + ClassId + '","DAY_ORDER_ID":"' + DayId + '","HOUR_ID":"' + HourId + '","COURSE_ID":"' + CourseId + '","STAFF_ID":"' + StaffId + '"}';
            $.ajax({
                url: '@Url.Action("FetchSubstituteHurinfo", "TimeTable")',
                data: { sJson: sJsonData },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#EditModal-dialog').modal();
                        $('#lblDayOrder').text(data.liSubstituteHour[0].DAY_ORDER);
                        $('#lblHour').text(data.liSubstituteHour[0].HOUR);
                        $('#lblClass').text(data.liSubstituteHour[0].CLASS_NAME);
                        $('#lblCourse').text(data.liSubstituteHour[0].COURSE_TITLE);
                        $('#ddlStaff').empty();
                        $('#ddlStaff').append("<option value=''> -- Select -- </option>");
                        if (data.liSubstituteHour != null)
                        {
                            $.each(data.liSubstituteHour, function (i, e)
                            {
                                $('#ddlStaff').append("<option value='" + e.STAFF_ID + "'> " + e.STAFF_CODE + "</option>");
                            });
                        }
                        
                        $('#ddlDate').empty();
                        $('#ddlDate').append("<option value=''> -- Select -- </option>");
                        if (data.liCalender!=null)
                        {
                            $.each(data.liCalender, function (i, e)
                            {
                                $('#ddlDate').append("<option value='" + e.DAY_ORDER_DATE + "'> " + e.DAY_ORDER_DATE + "</option>");
                            });
                        }

                        $('#ddlStaff').val(data.liSubstituteHour[0].STAFF_ID);
                        $('#ddlDate').val(data.liSubstituteHour[0].DATE_ORDER_DATE);
                        $('#StaffList').val(data.liSubstituteHour[0].INCHARGE_ID);

                        // Hidden Fields ...,
                        $('#txtSubstituteId').val(data.liSubstituteHour[0].SUBSTITUTE_ID);
                        $('#txtDayOrderId').val(DayId);
                        $('#txtHourId').val(HourId);
                        $('#txtCourseId').val(data.liSubstituteHour[0].COURSE_ID);
                    }
                    //alert(data.Message); //$('#btnGet').click();
                   $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error)
                {
                    alert('Internal Server Error !');
                }
            });
        });
</script>


@* On Submit *@
<script>
        $('#btnSubmit').on('click', function ()
        {
            var SubstituteId = $('#txtSubstituteId').val();
            var DayOrderId = $('#txtDayOrderId').val();
            var HourId = $('#txtHourId').val();
            var ClassId = $('#ClassList').val();
            var CourseId = $('#txtCourseId').val();
            var StaffId = $('#ddlStaff').val();
            var Date = $('#ddlDate').val();
            var InchargeId = $('#StaffList').val();
            if (CourseId != null)
            {
                var ObjJsonData = '{"SUBSTITUTE_ID":"' + SubstituteId + '","DAY_ORDER_DATE":"' + Date + '","DAY_ORDER_ID":"' + DayOrderId + '","HOUR_ID":"' + HourId + '","CLASS_ID":"' + ClassId + '","COURSE_ID":"' + CourseId + '","STAFF_ID":"' + InchargeId + '","STAFF_CODE":"' + StaffId + '","INCHARGE_ID":"' + InchargeId + '"}';
                $.ajax({
                    url: '@Url.Action("SaveSubstituteHour", "TimeTable")',
                    method: 'POST',
                    datatype:'json',
                    data: { sSubstitute: ObjJsonData },
                    success: function (data)
                    {
                        alert(data.Message); 
                        $('#btnGet').click();
                    },
                    error: function (xhr, textStatus, error)
                    {
                        // alert(error + "\n");
                        alert('Internal Server Error !');
                    }
                });
            }
        });

        $('#btnRemove').on('click', function ()
        {
            var SubstituteId = $('#txtSubstituteId').val();
            DeleteSubstitute(SubstituteId);
        });

        function DeleteSubstitute(ID)
        {
            if (ID != null && ID != '')
            {
                if (!confirm('Are you sure to delete ?'))
                {
                    return false;
                }
                $.ajax({
                    url: '@Url.Action("DeleteSubstituteHour", "TimeTable")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sSubstituteId: ID },
                    success: function (data)
                    {
                        alert(data.Message);
                        $('#btnGet').click();
                    },
                    error: function (xhr, textStatus, error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }

       
</script>