    function btnexport(divname) {
        var StaffID = $("#StaffList option:selected").text();
        var SemType = $("#SSemester option:selected").text();
        var sAcYear = $("#SAcYear option:selected").text();

        // Retrieve table content
        var content = $(divname).html();

        // Create Blob for export
        let file = new Blob([content], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);

        // Trigger download
        let a = $("<a />", {
            href: url,
            download: `CITS-${StaffID}-${sAcYear}-${SemType} Sem.xls`,
        }).appendTo("body")[0].click();

        // Cleanup
        setTimeout(() => {
            URL.revokeObjectURL(url);
            a.remove();
        }, 100);
    }



    async function exportToExcel(divname, chartId) {
        const tableElement = document.querySelector(divname);

        // Prepare Table Data
        const data = [];
        const headers = [];
        tableElement.querySelectorAll("thead th").forEach((th) => headers.push(th.innerText));
        data.push(headers);

        tableElement.querySelectorAll("tbody tr").forEach((row) => {
            const rowData = [];
            row.querySelectorAll("td").forEach((cell) => rowData.push(cell.innerText));
            data.push(rowData);
        });

        // Create SheetJS Workbook
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet(data);
        XLSX.utils.book_append_sheet(wb, ws, "Table Data");

        // Add Chart as Image
        const chartElement = document.querySelector(chartId);
        const canvas = await html2canvas(chartElement);
        const imgData = canvas.toDataURL("image/png");

        // Excel doesn't natively support images in JavaScript; images must be added via plugins/server-side processing.
        // To keep things simple, export the table and prompt users to manually attach the image.
        console.log("Chart exported as image:", imgData);

        // Save Excel File
        XLSX.writeFile(wb, "Report.xlsx");
        alert("Excel exported. Please manually attach the chart image.");
    }



    function convertHTMLtoPDF() {
        const { jsPDF } = window.jspdf;

        let doc = new jsPDF('l', 'mm', [1500, 1400]);
        let pdfjs = document.querySelector('#divbindPages');

        doc.html(pdfjs, {
            callback: function (doc) {
                doc.save("newpdf.pdf");
            },
            x: 12,
            y: 12
        });
    }


</script>

