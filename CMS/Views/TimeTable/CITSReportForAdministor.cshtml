<script>
    $(document).ready(function () {
        $('#bindGlobalEntryReport').addClass("active in");
        $('.nav-items').on("click", function () {

            $('#divbindPage').html('');

        });

        //var todayDate = new Date();
        //var day = todayDate.getDate();
        //var month = todayDate.getMonth() + 1;
        //var year = todayDate.getFullYear();
        //if (day < 10) {
        //    day = '0' + day
        //}
        //if (month < 10) {
        //    month = '0' + month;
        //}
        //var formatDate = day + '/' + month + '/' + year;
        //document.getElementById('Datefrom').value = formatDate;


        globalEntryList();

    });
    $('#GSemester').on('change', function () {
        globalEntryList();
    })
    $('#GAcYear').on('change', function () {
        globalEntryList();
    })
    function globalEntryList()
    {
        var SemType = $("#GSemester").val();
        var sAcYear = $("#GAcYear option:Selected").text();
        if ($("#GSemester").val() && $("#GAcYear option:Selected").text())
        {
            $.ajax({
                url: '@Url.Action("BindCITSAdministratorEntryList", "TimeTable")',
                data: { sAcyear:sAcYear, SemType: SemType },
                success: function (option) {
                    var dvDateWiseStudentPaidStatus = $('#divbindPage');
                    dvDateWiseStudentPaidStatus.empty();
                    dvDateWiseStudentPaidStatus.append(option);

                    $("#tbltpmReport").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                            , {
                            extend: "excel", className: "btn-sm"
                        }
                            , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": true, "ordering": true
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    }
    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $("#Datefrom").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
                $("#Dateto").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
            }
            handleDatepicker();
        });
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>
<script>
    function Validate() {
        $("#Dateto").rules('add', { greaterThan: "#Datefrom" });
    }

    $("#btnGetDateWise").on('click', function () {
            var DateFrom = $("#Datefrom").val();
        var DateTo = $("#Dateto").val();
        if (DateFrom != null && DateFrom != "" && DateTo != null && DateTo != "") {
                $.ajax({
                    url: '@Url.Action("BindCITSReportinDateWise", "TimeTable")',
                    data: { sdate: DateFrom, edate: DateTo },
                    success: function (option) {
                        var dvDateWiseStudentPaidStatus = $('#divbindPage');
                        dvDateWiseStudentPaidStatus.empty();
                        dvDateWiseStudentPaidStatus.append(option);

                        $("#tbltpmReport").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                            , {
                                extend: "excel", className: "btn-sm"
                            }
                            , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": true, "ordering": true
                        });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
    });

    $("#ClassList").on("change", function ()
{
        var ClassID = String($("#ClassList").val());

    $.ajax({
        url:"@Url.Action("FetchttCourseByClassID", "TimeTable")",
        method: "POST",
        datatype: "html",
        data: { sClassID: ClassID },
        success: function (data)
        {
            var select = $("#CourseList");
            select.empty();
            if (data.sResult != null && data.sResult != '')
            {
                select.append( data.sResult);
            } else {
                myAlert(data.Message, 'gritter-danger', '');
            }
            $('#CourseList').selectpicker('refresh');
        },error:function(error)
        {
            myAlert('Internal Server Error ...!', 'gritter-danger', '');
        }
    });
    });


    $("#CourseList").on('change', function () {
        var ClassID = String($("#ClassList").val());
        var CourseID = String($("#CourseList").val());
        if (ClassID != null && ClassID != "" && CourseID != null && CourseID != "") {
            $.ajax({
                url: '@Url.Action("BindCITSReportinCourseWise", "TimeTable")',
                data: { sClass: ClassID, sCourse: CourseID },
                success: function (option) {
                    var dvDateWiseStudentPaidStatus = $('#divbindPage');
                    dvDateWiseStudentPaidStatus.empty();
                    dvDateWiseStudentPaidStatus.append(option);

                    $("#tblCourseWiseReport").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                        , {
                            extend: "excel", className: "btn-sm"
                        }
                        , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": true, "ordering": true
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    });
    $("#StaffList").on('change', function () {

        var StaffID=  $("#StaffList").val();
        var SemType = $("#SSemester").val();
        var sAcYear = $("#SAcYear option:Selected").text();
        if ($("#StaffList").val() && $("#SSemester").val() && $("#SAcYear").val())
        {
            $.ajax({
                url: '@Url.Action("BindCITSReportStaffWiseforHOD", "TimeTable")',
                data: { staffId: StaffID, sAcYear: sAcYear, SemType: SemType },
                success: function (option) {
                    var dvDateWiseStudentPaidStatus = $('#divbindPage');
                    dvDateWiseStudentPaidStatus.empty();
                    dvDateWiseStudentPaidStatus.append(option);
                    $("#stfBtnPrint").removeClass('hidden');
                    $("#stfExport").removeClass('hidden')
                    $("#tblCourseWiseReport").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                            , {
                            extend: "excel", className: "btn-sm"
                        }
                            , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": true, "ordering": true
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }

    });
    $("#pStaffList").on('change', function () {
        fetchStaffreportForPdf();
    });
    $("#pSemester").on('change', function () {
        fetchStaffreportForPdf();
    });
    $("#pAcYear").on('change', function () {
        fetchStaffreportForPdf();
    });
    function fetchStaffreportForPdf()
    {
    var StaffID=  String($("#pStaffList").val());
    var SemType = $("#pSemester").val();
    var sAcYear = $("#pAcYear option:Selected").text();
    if ($("#pStaffList").val() && $("#pSemester").val() && $("#pAcYear").val())
    {
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("BindCITSReportStaffWiseforPdf", "TimeTable")',
            data: { staffId: StaffID, sAcYear: sAcYear, SemType: SemType },
            success: function (option) {
                $('#loader').hide();
                var dvDateWiseStudentPaidStatus = $('#divbindPage');
                dvDateWiseStudentPaidStatus.empty();
                dvDateWiseStudentPaidStatus.append(option);
                $("#PdfbtnPrint").removeClass('hidden');
                $("#PdfbtnExport").removeClass('hidden')
            },
            error: function (xhr, textStatus, error) {
                $('#loader').hide();
                alert(error + "\n");
            }
        });

    }

        };


