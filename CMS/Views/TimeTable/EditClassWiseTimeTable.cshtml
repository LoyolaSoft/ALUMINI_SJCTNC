@model CMS.ViewModel.ViewModel.TimeTableViewModel

@{ 
    Layout = null;
    int count = 0;
}

@if (Model.lstTimeTable!=null && Model.lstTimeTable.Count>0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Class</th>
                <th>Course</th>
                <th>Name</th>
                <th>Hour Type</th>
                <th>Hour</th>
                <th id="Action">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.lstTimeTable)
            {
                <tr>
                    <td>@{count++;} @count</td>
                    <td>@item.CLASS_CODE</td>
                    <td>@item.COURSE_CODE</td>
                    <td>@item.STAFF_CODE</td>
                    <td>@item.Hour_Type</td>
                    <td>@item.HOUR</td>
                    <td>
                        <a href="#" onclick="FetchTimeTableById(@item.Time_Table_Id);" data-toggle="modal"><i class="fa fa-edit text-primary" title="Cick To Edit"></i></a>
                        <a href="#" onclick="DeleteTimeTable(@item.Time_Table_Id);" data-dismiss="modal"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

