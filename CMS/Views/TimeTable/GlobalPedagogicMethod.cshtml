</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        var todayDate = new Date();
        var day = todayDate.getDate();
        var month = todayDate.getMonth() + 1;
        var year = todayDate.getFullYear();
        if (day < 10) {
            day = '0' + day
        }
        if (month < 10) {
            month = '0' + month;
        }
        var formatDate = day + '/' + month + '/' + year;
        document.getElementById('Datefrom').value = formatDate;

    });
    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $("#Datefrom").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
            }
            handleDatepicker();
        });
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>
<script>
    function Validate() {
        $("#Dateto").rules('add', { greaterThan: "#Datefrom" });
    }
    $('#btnSubmitfrom').on('click', function () {
    // Validate form using Parsley.js
    if ($('#formValidate').parsley().validate() !== true) {
        myAlert('Something went wrong! Please check your inputs!', 'gritter-warning', '');
        return false;
    }

    var DateFrom = $("#Datefrom").val();
    var ClassId = String($("#ClassList").val());
    var HourId =String($("#HourList").val());
    var Topic = $(".topicTitle").val();
    var SubTopic = $(".supTitle").val();
        var Unit = $("#UnitList").val();
    var MethodologyList = $("#MethodologyList").val();

    // Check if DateFrom is selected
    if (DateFrom != null && DateFrom != "") {
        // Iterate over selected MethodologyList
        $.each(MethodologyList, function(index, Methodology) {
            // Make AJAX call for each Methodology
            $.ajax({
                url: '/TimeTable/SaveGlobalPedagogicMethod',
                method: 'POST',
                data: {
                    sdate: DateFrom,
                    sClassId: ClassId,
                    SHourId: HourId,
                    sUnit: Unit,
                    sTopic: Topic,
                    sSubTopic: SubTopic,
                    sMethodology: Methodology
                },
                success: function (data) {
                    if (data.ErrorCode == "406") {
                        swal({ title: "Message!", text: data.Message, timer: 2500, icon: 'error', animation: true });
                    } else {
                        swal({ title: "Message!", text: data.Message, timer: 2500, icon: 'success', animation: true });
                    }
                },
                error: function (xhr, textStatus, error) {
                    swal({ title: "Error!", text: error, timer: 2500, icon: 'error', animation: true });
                }
            });
        });
    }
});

    function FetchProgrammeList() {
            var Shift =String($("#ShiftList").val());
    var Department =String($("#Departmentlist").val());

$.ajax({
    url:"@Url.Action("FetchProgrmmebyShiftandDept", "TimeTable")",
    method: "POST",
    datatype: "html",
    data: { ShiftID: Shift, sDepartment: Department },
    success: function (data)
    {
        var select = $("#ProgrammeList");
        select.empty();
        if (data.sResult != null && data.sResult != '')
        {
            select.append( data.sResult);
        } else {
            myAlert(data.Message, 'gritter-danger', '');
        }
        $('#ProgrammeList').selectpicker('refresh');
    },error:function(error)
    {
        myAlert('Internal Server Error ...!', 'gritter-danger', '');
    }
});
    }
    $("#ShiftList").on("change", function ()
{
        FetchProgrammeList()
    });
    $("#Departmentlist").on("change", function () {
        FetchProgrammeList()
    });
    $("#ProgrammeList").on("change", function ()
{
        var ProgrammeID = String($("#ProgrammeList").val());

    $.ajax({
        url:"@Url.Action("FetchClassByProgrammeID", "TimeTable")",
        method: "POST",
        datatype: "html",
        data: { sProgrammeId: ProgrammeID},
        success: function (data)
        {
            var select = $("#ClassList");
            select.empty();
            if (data.sResult != null && data.sResult != '')
            {
                select.append( data.sResult);
            } else {
                myAlert(data.Message, 'gritter-danger', '');
            }
            $('#ClassList').selectpicker('refresh');
        },error:function(error)
        {
            myAlert('Internal Server Error ...!', 'gritter-danger', '');
        }
    });
});
</script>






