        </div>
        <div class="panel-body">
            <div class="form-horizontal">

                <div class="col-md-12" id="formValidate" data-parsley-validate="true">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-3">Date</label>
                            <div class="col-md-9">
                                <div class="form-group input-group date" id="datetimepicker1">
                                    <input class="form-control" id="Datefrom" placeholder="Pick Date" />
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Departmentlist, htmlAttributes: new { @class = "control-label col-md-3" })
