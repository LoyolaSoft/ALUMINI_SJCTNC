                                <div class=" form-group">
                                    @Html.DropDownListFor(m => m.Departmentlist, (Model.Departmentlist != null) ? Model.Departmentlist : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(m => m.Departmentlist, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class=" form-group">
                                    @Html.DropDownListFor(m => m.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @data_parsley_required = "true", @multiple = "multiple" })
                                    @Html.ValidationMessageFor(m => m.ShiftList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ProgrammeList, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class=" form-group">
                                    @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class=" form-group">
                                    @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.HourList, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class=" form-group">
                                    @Html.DropDownListFor(m => m.HourList, (Model.HourList != null) ? Model.HourList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(m => m.HourList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.UnitList, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class=" form-group">
                                    @Html.DropDownListFor(m => m.UnitList, (Model.UnitList != null) ? Model.UnitList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(m => m.UnitList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Topic Title</label>
                            <div class="col-md-9">
                                <div class=" form-group">
                                    <textarea class="form-control topicTitle" required></textarea>

                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Sup Title</label>
                            <div class="col-md-9">
                                <div class=" form-group">
                                    <textarea class="form-control supTitle" required></textarea>
                                </div>
