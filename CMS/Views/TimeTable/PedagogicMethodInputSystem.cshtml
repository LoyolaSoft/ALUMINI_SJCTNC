<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    $(document).ready(function () {
        var todayDate = new Date();
        var day = todayDate.getDate();
        var month = todayDate.getMonth() + 1;
        var year = todayDate.getFullYear();
        if (day < 10) {
            day = '0' + day
        }
        if (month < 10) {
            month = '0'+ month;
        }
        var formatDate = day + '/' + month + '/' + year;
        document.getElementById('Datefrom').value = formatDate;

    });
    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $("#Datefrom").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )

            }
            handleDatepicker();
        });
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>
<script>
    function Validate() {
        $("#Dateto").rules('add', { greaterThan: "#Datefrom" });
    }
</script>
<script>


    $('#Datefrom').on('change', function () {

        loadpage()

    });
    function loadpage() {
        var DateFrom = $("#Datefrom").val();
if (DateFrom != null && DateFrom != "") {
    $.ajax({
        url: '@Url.Action("BindPedagogicMethodInputSystem", "TimeTable")',
        data: { sdate: DateFrom },
        success: function (option) {
            var dvDateWiseStudentPaidStatus = $('#divDateWiseStudentPaidStatus');
            dvDateWiseStudentPaidStatus.empty();
            dvDateWiseStudentPaidStatus.append(option);
            $('#sPrint').removeClass('hidden');
            //$("#DateWiseStudentFeePaidStatusList").DataTable({
            //    dom: "lBfrtip", buttons: [{
            //        extend: "copy", className: "btn-sm"
            //    }
            //    , {
            //        extend: "excel", className: "btn-sm"
            //    }
            //    , {
            //        extend: "pdf", className: "btn-sm"
            //    }
            //    ], responsive: !0, "paging": false, "ordering": false
            //});
        },
        error: function (xhr, textStatus, error) {
            alert(error + "\n");
        }
    });
}
    }

</script>





