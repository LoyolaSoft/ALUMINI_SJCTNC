                    success: function (data)
                    {
                        $('#ddlCourse').empty();
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#ddlCourse').append('<option value="">-- select --</option>' + data);
                            $('.selectpicker').selectpicker('refresh');
                        }
                    },
                    error: function (xhr, textStatus, error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }*@
    </script>

    

    @* On Submit *@
    <script>
        $('#btnSubmit').on('click', function ()
        {
            var TimeTableId = $('#txtTimeTableId').val();
            var ClassId = $('#ClassList').val();
            var CourseId = $('#ddlCourse').val();
            var StaffId = $('#ddlStaff').val();
            var DayOrderId = $('#txtDayOrder').val();
            var HourId = $('#txtHour').val();
            var HourType = $('#ddlHourType').val();
            var SemesterId = $('#txtSemesterId').val();
            if (CourseId != null)
            {
                $.ajax({
                    url: '@Url.Action("UpdateClassWiseTimeTable", "TimeTable")',
                    data: { sCourseId: CourseId, sClassId: ClassId, sTimeTableId: TimeTableId, sStaffId: StaffId, sDayOrderId: DayOrderId, sHourId: HourId, sHourType: HourType, sSemesterId: SemesterId },
                    success: function (option)
                    {
                        alert(option);
                        loadGird();
                    },
                    error: function (xhr, textStatus, error)
                    {
                        // alert(error + "\n");
                        alert('Internal Server Error !');
                    }
                });
            }
        });

        $('#btnRemove').on('click', function ()
        {
            var TimeTableId = $('#txtTimeTableId').val();
            DeleteTimeTable(TimeTableId);
        });

        function DeleteTimeTable(ID)
        {
            if (ID != null && ID != '')
            {
                if (!confirm('Are you sure to delete ?'))
                {
                    return false;
                }
                $.ajax({
                    url: '@Url.Action("DeleteTimeTable", "TimeTable")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sTimeTableId: ID },
                    success: function (data)
                    {
                        alert(data.Message);
                        loadGird();
                    },
                    error: function (xhr, textStatus, error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }

        function FetchTimeTableById(sTimeTableId)
        {
            GetDropDown();
            
            if (sTimeTableId != null && sTimeTableId != '')
            {
                $.ajax({
                    url:'@Url.Action("FetchTimeTableById", "TimeTable")',
                    method:'POST',
                    datatype:'json',
                    data: { sTimeTableId: sTimeTableId },
                    success: function (data)
                    {
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#MultiTimeTable').modal('hide');
                            $('#EditModal-dialog').modal();

                            $('#ddlCourse').val(data[0].Course_Id);
                            $('#ddlStaff').val(data[0].Staff_Id);
                            $('#ddlHourType').val(data[0].Hour_Type);

                            $('#txtTimeTableId').val(data[0].Time_Table_Id);
                            $('#txtClassId').val(data[0].Class_Id);
                            $('#txtDayOrder').val(data[0].Day_Order_Id);
                            $('#txtHour').val(data[0].Hour_Id);
                            $('#txtSemesterId').val(data[0].Semester_Id);
                            $('#txtHourType').val(data[0].Hour_Type);

                            $('#txtClass').val($('#ClassList option:selected').text());
                            
                            if ($('#txtTimeTableId').val())
                            {
                                $('#btnRemove').show();
                            } else
                            {
                                $('#btnRemove').hide();
                            }

                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
    </script>

<div class="modal" id="EditModal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Edit Class Wise Time Table</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                        
                    <div class="form-group">
                            <label class="control-label col-md-3">Hour Type</label>
                            <div class="col-md-9">
                                <select id="ddlHourType" class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" data-live-search="true">
                                    <option value="">-- select --</option>
                                </select>
                            </div>
                        </div>
                    
                    <div class="form-group">
                            <label class="control-label col-md-3">Class</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control input-sm" disabled id="txtClass" />
                            </div>
                        </div>

                    <div class="form-group">
                            <label class="control-label col-md-3">Course</label>
                            <div class="col-md-9">
                                <select id="ddlCourse" class="selectpicker form-control input-sm" data-live-search = "true">
                                    <option value="">-- select --</option>
                                </select>
                            </div>
                        </div>

                    <div class="form-group">
                            <label class="control-label col-md-3">Staff</label>
                            <div class="col-md-9">
                                <select id="ddlStaff" class="selectpicker form-control input-sm" data-live-search = "true">
                                    <option value="">-- select --</option>
                                </select>
                            </div>
                        </div>

                    <div class="form-group">
                            <label class="control-label col-md-3">Day Order</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control input-sm" disabled id="txtDayOrder" />
                            </div>
                        </div>

                    <div class="form-group">
                            <label class="control-label col-md-3">Hour</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control input-sm" disabled id="txtHour" />
                            </div>
                        </div>

                </div>
            </div>
            <div class="modal-footer">
                <span class="text-warning pull-left" id="txtStatic"></span>
                <button type="submit" id="btnSubmit" class="btn btn-default"  data-dismiss="modal">Submit</button>
                <button type="submit" id="btnRemove" class="btn btn-default"  data-dismiss="modal">Remove</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Feilds-->
<input type="text" class="form-control input-sm hidden" disabled id="txtClassId" />
<input type="text" class="form-control input-sm hidden" disabled id="txtSemesterId" />
