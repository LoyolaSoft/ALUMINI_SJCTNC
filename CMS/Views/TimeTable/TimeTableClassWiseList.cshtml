@model CMS.ViewModel.ViewModel.TimeTableViewModel

@{
    ViewBag.Title = "TimeTableClassWiseList";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    @using (Html.BeginForm())
    { @Html.AntiForgeryToken()
        <ol class="breadcrumb pull-right">
            <li><a @*href="@Url.Action("Admin", "Dashboard")"*@ href="javascript:;">Home</a></li>

            <li class="active">Timetable Classwise List </li>
        </ol>
        <h2 class="page-header">Timetable </h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Timetable Classwise List </h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="col-md-12">

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-1" })
                            <div class="col-md-10">
                                @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        
                        <div class="form-group col-md-3 pull-right hidden" id="btnAdd">
                            <a class="btn btn-success pull-right" href="javascript:;" onclick="FetchAllDropDownForTimeTable();"><i class="fa fa-plus" title="Add"> Add</i></a>
                        </div>
                        
                    </div>

                    <div class="col-lg-12">
                        <div id="divTimeTableInfo">
                            <!--Need to use this fied to bind Student List-->
                        </div>
                    </div>
                </div>
            </div>
        </div>

    }
</div>

    <script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        //$("#ClassList").select2();
    </script>

    @* Class Change Event *@
    <script>
        $('#ClassList').on('change', function ()
        {
            $('#btnAdd').removeClass('hidden');
            loadGird();
        });
        function loadGird()
        {
            var vClassId = $('#ClassList').val();
            if (vClassId != 0)
            {
                $.ajax({
                    url: '@Url.Action("BindTimeTableInfo", "TimeTable")',
                    data: { sClassId: vClassId },
                    success: function (option)
                    {
                        var dvStudentPromotion = $('#divTimeTableInfo');
                        dvStudentPromotion.empty();
                        dvStudentPromotion.append(option);
                    },
                    error: function (xhr, textStatus, error)
                    {
                        alert(error + "\n");
                    }
                });

            } else
            {
                alert('Please Select Class...!!!');
            }
        }
    </script>

    @* Value td Click Event *@
    <script>
        var sCourseId;
        var sStaffId;
        var Is_Static = null;
        $("table.table td.editable").live("click", function ()
        {
            var ClassId = $('#ClassList').val();
            var SelectedClassId = $('#ClassList').val();
            var HourId = $(this).attr('cms-hourid');
            var DayId = $(this).attr('cms-dayid');
            var HourType = $(this).attr('cms-hourtype');
            var TimeTableId = $(this).attr('cms-timetalbeid');
            var SemesterId = $(this).attr('cms-semesterid');
            var CourseId = $(this).attr('cms-courseid');
            var StaffId = $(this).attr('cms-staffid');
            var tCount = $(this).attr('cms-tcount');
            
            var sJson;
            sJson = '{"Count":"' + tCount + '","Class_Id":"' + ClassId + '","S_CLASS_ID":"' + SelectedClassId + '","Day_Order_Id":"' + DayId + '","Hour_Id":"' + HourId + '","hourType":"' + HourType + '","Time_Table_Id":"' + TimeTableId + '","Semester_Id":"' + SemesterId + '","Course_Id":"' + CourseId + '","Staff_Id":"' + StaffId + '"}';
            $.ajax({
                url: '@Url.Action("EditClassWiseTimeTable", "TimeTable")',
                data: { sTimetable: sJson },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message); // To Show Error Message ....
                    } else if (data.hourType != null && data.hourType != '')
                    {
                        
                        // If Single TimeTable Value Retruns ...
                        Is_Static = data.IS_STATIC;
                        if (Is_Static != null && Is_Static == "1")
                        {
                            $('#txtStatic').text("This is Static Hour !");
                        } else {
                            $('#txtStatic').text("");
                        }
                        
                        var sOption = '<option value=""> -- Select -- </option>';
                        $('#EditModal-dialog').modal();

                        $('#ddlHourType').empty();
                        $('#ddlHourType').append(sOption + data.hourType);
                        $('#ddlHourType').val(HourType);

                        $('#ddlCourse').empty();
                        $('#ddlCourse').append(sOption + data.sCourseId);
                        $('#ddlCourse').val(CourseId);

                        $('#ddlStaff').empty();
                        $('#ddlStaff').append(sOption + data.sStaffId);
                        $('#ddlStaff').val(StaffId);

                        $('#txtClass').val($('#ClassList option:selected').text());
                        $('#txtTimeTableId').val(TimeTableId);
                        $('#txtClassId').val(SelectedClassId);
                        $('#txtDayOrder').val(DayId);
                        $('#txtHour').val(HourId);
                        $('#txtHourType').val(HourType);
                        if (SemesterId != null && SemesterId != '')
                        {
                            $('#txtSemesterId').val(SemesterId);
                        } else
                        {
                            $('#txtSemesterId').val(data);
                        }
                        
                        if ($('#txtTimeTableId').val())
                        {
                            $('#btnRemove').show();
                        } else {
                            $('#btnRemove').hide();
                        }
                    } else
                    {
                        // If Multiple TimeTable Value Retruns ...
                        $('#dvMultiTimeTable').empty();
                        $('#dvMultiTimeTable').append(data);
                        $('#MultiTimeTable').modal();
                        
                    }
                   
                    //dvMultiTimeTable
                    //MultiTimeTable-dialog
                        
                        
                       // FetchStaffByClassAndCourse();
                       
                        $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error)
                {
                    alert('Internal Server Error !');
                }
            });
        });
    </script>

    @* Get Dropdown *@
    <script>
        GetDropDown = function (ID)
        {
            var ClassId = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("GetCourseAndStaff", "TimeTable")",
                method: "POST",
                data: { sClassId: ClassId },
                datatype: "json",
                success: function (data)
                {

                    var ddl = JSON.parse(data);
                    
                    $('#ddlCourse').empty();
                    $('#ddlCourse').append('<option value="0">-- select --</option>' + ddl.COURSE_CODE);
                    $('#ddlCourse').val(sCourseId);
                    $('#ddlStaff').empty();
                    $('#ddlStaff').append('<option value="0">-- select --</option>' + ddl.Staff_Id);
                    $('#ddlStaff').val(sStaffId);
                    $('#ddlHourType').empty();
                    $('#ddlHourType').append('<option value="0">-- select --</option>' + ddl.hourType);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
        GetTemplate = function () {
            var ClassId = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("GetTemplateByClassId", "TimeTable")",
                method: "POST",
                data: { sClassId: ClassId },
                datatype: "json",
                success: function (data) {

                    var ddl = JSON.parse(data);
                    $('#ddlHourType').empty();
                    $('#ddlHourType').append('<option value="0">-- select --</option>' + ddl.hourType);
                    //$('#ddlCourse').val(sCourseId);
                    //$('#ddlStaff').empty();
                    //$('#ddlStaff').append('<option value="0">-- select --</option>' + ddl.Staff_Id);
                    //$('#ddlStaff').val(sStaffId);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    </script>

    @* Table Empty td Click *@
    <script>
        $("table.table td.alert").live("click", function ()
        {
            alert('Please assign course and staff for this hour...!!!');
        });
    </script>

    <script>
        function FetchAllDropDownForTimeTable()
        {
            var ClassId = $('#ClassList').val();
            $.ajax({
                url:'@Url.Action("FetchAllDropDownForTimeTable", "TimeTable")',
                method:'POST',
                datatype:'json',
                data: { sClassId: ClassId },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else {
                        var ddl = JSON.parse(data);

                        $('#MultiddlHourType').empty();
                        $('#MultiddlHourType').append('<option value="">-- select --</option>' + ddl.hourType);

                        $('#MultiddlDayOrder').empty();
                        $('#MultiddlDayOrder').append('<option value="">-- select --</option>' + ddl.Day_Order_Id);

                        $('#MultiddlHour').empty();
                        $('#MultiddlHour').append('<option value="">-- select --</option>' + ddl.Hour_Id);

                        $('#MultiddlCourse').empty();
                        $('#MultiddlCourse').append('<option value="">-- select --</option>' + ddl.COURSE_ROOT_ID);

                        

                        $('#MultiModal-dialog').modal();
                        $('.selectpicker').selectpicker('refresh');
                    }
                    
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }

        $("#MultiddlCourse").on("change", function ()
        {
            $.ajax({
                url:'@Url.Action("GetStaffByCourseId", "TimeTable")',
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ClassList').val(), sCourseId: $("#MultiddlCourse").val() },
                success: function (data)
                {
                    $('#MultiddlStaff').empty();
                    $('#MultiddlStaff').append('<option value="">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        });


        $('#MultibtnSubmit').on('click', function ()
        {
            var JsonData = null;
            JsonData = '{"hourType":"' + $('#MultiddlHourType').val() + '","Day_Order_Id":"' + $('#MultiddlDayOrder').val() + '","Hour_Id":"' + $('#MultiddlHour').val() + '","Course_Id":"' + $('#MultiddlCourse').val() + '","Staff_Id":"' + $('#MultiddlStaff').val() + '","Class_Id":"' + $('#ClassList').val() + '"}';
            $.ajax({
                url:'@Url.Action("SaveTimeTableMultiple", "TimeTable")',
                method: 'POST',
                datatype: 'json',
                data: { sTimeTable: JsonData },
                success: function (data)
                {
                    alert(data.Message);
                    loadGird();
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        });
    </script>
  

    @* Course Change Event *@
    <script>
        $('#ddlCourse').on('change', function ()
        {
            FetchStaffByClassAndCourse();
        });

        

        function FetchStaffByClassAndCourse()
        {
            var CourseId = $('#ddlCourse').val();
            var ClassId = $('#ClassList').val();
            if ($('#ddlCourse').val())
            {
                $.ajax({
                    url: '@Url.Action("GetStaffByCourseId", "TimeTable")',
                    data: { sCourseId: CourseId, sClassId: ClassId },
                    success: function (data) {
                        $('#ddlStaff').empty();
                        if (data != null && data != '') {
                            $('#ddlStaff').append('<option value="">-- select --</option>' + data);
                            $('.selectpicker').selectpicker('refresh');
                        }
                        else
                        {
                            $('#ddlStaff').empty();
                            alert('Please assign the staff for this course in class course staff...!!!');
                        }
                    },
                    error: function (xhr, textStatus, error) {
                        alert('Internal Server Error !');
                    }
                });
            }
            
        }

        @*$('#ddlHourType').on('change', function ()
        {
            FetchCourseByHourType();
        });

        function FetchCourseByHourType() 
        {
            
            if ($('#ddlHourType').val()) {
                $.ajax({
                    url: '@Url.Action("GetStaffByCourseId", "TimeTable")',
