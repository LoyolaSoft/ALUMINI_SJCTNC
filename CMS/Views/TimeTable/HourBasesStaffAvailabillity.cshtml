@model CMS.ViewModel.ViewModel.TimeTableViewModel


@{
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">TimeTable</a></li>
        <li class="active">Staff</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">IQAC Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">TimeTable Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-3">
                            @Html.Label("Shift", htmlAttributes: new { @class = "col-md-4 control-label" })
                            <div class="col-md-6">
                                <select class="form-control selectpicker" id="shift">
                                    <option value="0">-- Select --</option>
                                    <option value="1">I</option>
                                    <option value="2">II</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("Day Order", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-6">
                                @Html.DropDownListFor(m => m.DayOrderList, (Model.DayOrderList != null) ? Model.DayOrderList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.DayOrderList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            @Html.Label("Hour", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.HourList, (Model.HourList != null) ? Model.HourList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.HourList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <a href="javascript:;" onclick="Bindstafflist()" class="btn btn-success" title="Click To ">Get</a>
                        </div>

                    </div>
                </div>


                <div id="dvBind" class="form-group col-md-12">

                </div>

            }

        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
        function ContentLoad()
        {

            // Document Ready Function .
           // $('#btnPrint').removeClass("hidden");
            //$('#btnExport').removeClass("hidden");
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>
    function Bindstafflist()
    {
        if ($("#shift").val() && $("#DayOrderList").val() && $("#HourList").val()) {
            $.ajax({
                url:"@Url.Action("BindStaffAvailabillity", "TimeTable")",
                datetype:"json",
                method:"POST",
                data: { dayorder: $("#DayOrderList").val(), hour: $("#HourList").val(), Shift: $("#shift").val() },
                success:function (data) {
                    $("#dvBind").empty();
                    $("#dvBind").append(data);
                    $('.table').DataTable({ "bPaginate": false });
                },error:function (data) {
                    alert("Internal Server Error!");
                }
            });
        }
        else {
            alert("Please Choose The Dayorder and Hours");
        }
    }
</script>
