@model CMS.ViewModel.ViewModel.TimeTableViewModel
@{
    ViewBag.Title = "StaffOverallTimetable";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
@{string CourseCode = string.Empty; string CourseTitle = string.Empty; string ttTimeTable = string.Empty;}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/css/style.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
@*<style type="text/css" media="print">
   
    table {
        font-family: arial, sans-serif;
     
        width: 100%;
    }

    table tbody tr td{
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }
</style>*@
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">TimeTable</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">TimeTable</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">TimeTable</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12" id="divprint">
                        <div class="row table-responsive" id="event">
                            @if (Model.liTimetable != null && Model.liTimetable.Count > 0)
                            {
                                var liGroupShift = Model.liTimetable.GroupBy(x => x.SHIFT).OrderBy(x => x.FirstOrDefault().SHIFT).ToList();
                                foreach (var Groupitem in liGroupShift)
                                {
                                    var liTimeTable = Model.liTimetable.Where(x => x.SHIFT == Groupitem.FirstOrDefault().SHIFT).ToList();
                                    @*<div id="dvTimeTable" class="col-md-12"> Time Table For SHIFT - @Groupitem.FirstOrDefault().SHIFT</div>*@
                                    <table  id="TimeTableClassWiseList" class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                @if (Model.lstHours != null && Model.lstHours.Count > 0)
                                                {
                                                    foreach (var dataitem in Model.lstHours)
                                                    {
                                                        <th><b> Hour- @dataitem.HOUR</b></th>
                                                    }
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.lstDayOrders != null && Model.lstDayOrders.Count > 0)
                                            {
                                                foreach (var dataitem in Model.lstDayOrders)
                                                {
                                                    <tr>
                                                        <td><b> Day- @dataitem.DAY</b></td>
                                                        @foreach (var item in Model.lstHours)
                                                        {
                                                            if (liTimeTable != null && liTimeTable.Count > 0)
                                                            {
                                                                var TimeTableList = liTimeTable.Where(s => s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                                var TimeTable = TimeTableList.Where(s => s.Hour_Id == item.HOUR_ID && s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                                if (TimeTable != null && TimeTable.Count > 0)
                                                                {
                                                                    ttTimeTable = string.Join(",", TimeTable.Select(x => x.CLASS_CODE.ToString()).ToArray());
                                                                    <td>
                                                                        @{ CourseCode = "(" + @TimeTable.FirstOrDefault().COURSE_CODE + ")";}
                                                                        @TimeTable.FirstOrDefault().hourType<br />
                                                                        @{ CourseTitle = @TimeTable.FirstOrDefault().COURSE_TITLE; }
                                                                        @CourseTitle - @CourseCode <br />
                                                                        @ttTimeTable
                                                                    </td>
                                                                            }
                                                                            else if (Model.liSubstituteList != null && Model.liSubstituteList.Count > 0)
                                                                            {
                                                                                var liSubstituteList = Model.liSubstituteList.Where(s => s.HOUR_ID == item.HOUR_ID && s.DAY_ORDER_ID == dataitem.DAY_ORDER_ID && s.SHIFT == Groupitem.FirstOrDefault().SHIFT).ToList();
                                                                                if (liSubstituteList != null && liSubstituteList.Count > 0)
                                                                                {
                                                                                    <td>
                                                                                        @liSubstituteList.FirstOrDefault().HOUR_TYPE<br />
                                                                                        @liSubstituteList.FirstOrDefault().DAY_ORDER_DATE<br />
                                                                                        @liSubstituteList.FirstOrDefault().CLASS_NAME<br />
                                                                                        @liSubstituteList.FirstOrDefault().STAFF_CODE<br />
                                                                                    </td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td></td>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                                }
                                                                            }
                                                                            else if (Model.liSubstituteList != null && Model.liSubstituteList.Count > 0)
                                                                            {
                                                                                var liSubstituteList = Model.liSubstituteList.Where(s => s.HOUR_ID == item.HOUR_ID && s.DAY_ORDER_ID == dataitem.DAY_ORDER_ID && s.SHIFT == Groupitem.FirstOrDefault().SHIFT).ToList();
                                                                                if (liSubstituteList != null && liSubstituteList.Count > 0)
                                                                                {
                                                                                    <td>
                                                                                        @liSubstituteList.FirstOrDefault().HOUR_TYPE<br />
                                                                                        @liSubstituteList.FirstOrDefault().DAY_ORDER_DATE<br />
                                                                                        @liSubstituteList.FirstOrDefault().CLASS_NAME<br />
                                                                                        @liSubstituteList.FirstOrDefault().STAFF_CODE<br />
                                                                                    </td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td></td>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                                }
                                                                            }
                                                    </tr>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <tr>
                                                                                    <td><p>No records available !!!</p></td>
                                                                                </tr>
                                                                            }
                                        </tbody>
                                    </table>
                                                                                }
                                                                            }
                        </div>
                    </div>
                </div>
              
            }
            <div class="form-group col-lg-12 ">
                <div class="form-group col-md-1 pull-right">
                    <a href="#" class="btn btn-success pull-right" id="btnPrint" onclick="printDiv('divprint')">Print</a>
                </div>
            </div>
            </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script>
        $('.selectpicker').selectpicker({
            size: 4
        });
</script>

<script>
    function printDiv(divName)
    {
        var divToPrint = document.getElementById('divprint').innerHTML;
        var htmlToPrint = '' +
            '<style type="text/css">' +
            'table th, table td {' +
            'border:1px solid #000;' +
            'padding:0.5em;' +
            '}' +
            '</style>';
        htmlToPrint += divToPrint;
        //var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(htmlToPrint);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
    }

</script>

