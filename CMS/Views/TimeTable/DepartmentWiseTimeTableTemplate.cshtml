@model CMS.ViewModel.ViewModel.TimeTableViewModel

@{
    ViewBag.Title = "DepartmentWiseTimeTableTemplate";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a @*href="@Url.Action("TimeTableDepartmentWiseTemplateList","TimeTable")"*@ href="javascript:;" onclick="loadContent('/TimeTable/TimeTableDepartmentWiseTemplateList')">List Department Wise TimeTable Template </a></li>
            <li class="active">Add Department Wise TimeTable Template </li>
        </ol>
        <h1 class="page-header">Department Wise TimeTable Template </h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Add Department Wise TimeTable Template</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="col-md-6 col-md-offset-3">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group">
                                @Html.LabelFor(model => model.SettingList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.SettingList, (Model.SettingList != null) ? Model.SettingList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.SettingList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Departmentlist, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Departmentlist, (Model.Departmentlist != null) ? Model.Departmentlist : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "true" })
                                    @Html.ValidationMessageFor(model => model.Departmentlist, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @*<div class="form-group">
                                @Html.Label("Is Active", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.CheckBox("IS_ACTIVE", new { @class = "input-sm" })

                                </div>
                            </div>*@

                            <div class="form-group pull-right ">
                                <div class="col-md-12">
                                    <a id="btnSubmit" value="SUBMIT" class="btn btn-primary">Submit</a>
                                    <a id="" @*href="@Url.Action("TimeTableDepartmentWiseTemplateList","TimeTable")"*@ href="javascript:;" onclick="loadContent('/TimeTable/TimeTableDepartmentWiseTemplateList')" value="SUBMIT" class="btn btn-danger">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('#SettingList').on('change', function () {
            var Setting = $("#SettingList").val();
            $.ajax({
                url: "@Url.Action("FetchDepartmentByTimeTableSettingId", "TimeTable")",
                method: "POST",
                datatype: "html",
                data: { sSettingId: Setting },
                success: function (objResult) {
                    $('#Departmentlist').empty();
                    $('#Departmentlist').empty().append(objResult.sResult).selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ..!');
                }
            });
        });
        $('#btnSubmit').on('click', function () {
            var Setting = $("#SettingList").val();
            var Department = String($("#Departmentlist").val());
            var JsonData;
            JsonData = '{"SETTING_ID":"' + Setting + '","DEPARTMENT_ID":"' + Department + '"}';
            if (Setting != 0 && Department != 0) {
                $.ajax({
                    url: "@Url.Action("SaveDepartmentWiseTimeTableTemplate", "TimeTable")",
                    method: "POST",
                    datatype: "html",
                    data: { DepartmentWiseTimeTableTemplate: JsonData },
                    success: function (objResult) {
                        alert(objResult.Message);
                    }, error: function (error) {
                        alert('Internal Server Error ..!');
                    }
                });
            }
            else {
                alert('Enter correct values...!!!');
            }
        });
    </script>
