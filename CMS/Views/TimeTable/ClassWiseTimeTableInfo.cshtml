@model CMS.ViewModel.ViewModel.TimeTableViewModel

@{
    ViewBag.Title = "ClassWiseTimeTableInfo";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a @*href="@Url.Action("TimeTableClassWiseList","TimeTable")"*@ href="javascript:;" onclick="loadContent('/TimeTable/TimeTableClassWiseList')">List Class Wise Time Table </a></li>
            <li class="active">Add Class Wise Time Table </li>
        </ol>
        <h1 class="page-header">Class Wise Time Table </h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Add Class Wise Time Table</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="col-md-6 col-md-offset-3">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.DayOrderList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.DayOrderList, (Model.DayOrderList != null) ? Model.DayOrderList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.DayOrderList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ClassList, (Model.ClassList!=null)? Model.ClassList:Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.CourseList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.StaffList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                           
                            <div class="form-group">
                                @Html.LabelFor(model => model.HourList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.HourList, (Model.HourList != null) ? Model.HourList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.HourList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.SemesterList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.SemesterList, (Model.SemesterList != null) ? Model.SemesterList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.SemesterList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.HourType, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.HourType, (Model.HourType != null) ? Model.HourType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.HourType, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group pull-right ">
                                <div class="col-md-12">
                                    <a id="btnSubmit" value="SUBMIT" class="btn btn-primary">Submit</a>
                                    <a id="" @*href="@Url.Action("TimeTableClassWiseList","TimeTable")"*@ href="javascript:;" onclick="loadContent('/TimeTable/TimeTableClassWiseList')" value="SUBMIT" class="btn btn-danger">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    <script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
</script>
    @*<script>
        $("#ClassList,#CourseList,#StaffList").select2();
    </script>*@
    <script>
        $('#ClassList').on('change', function () {
            var ClassId = $('#ClassList').val();
            if (ClassId != null) {
                $.ajax({
                    url: '@Url.Action("GetCourseByClassId", "TimeTable")',
                    data: { sClassId: ClassId, sDayOrderId: $("#DayOrderList").val() },
                    success: function (option) {
                        var ddl = JSON.parse(option);

                        $('#CourseList').empty();
                        $('#CourseList').append('<option value="">-- select --</option>' + ddl.Course_Id);

                        //$("#SemesterList").empty();
                        //$("#SemesterList").append('<option value="">-- select --</option>' + ddl.Semester_Id);

                        $("#HourList").empty();
                        $("#HourList").append('<option value="">-- select --</option>' + ddl.Hour_Id);
                        //$('#ddlStaff').val(sStaffId);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error) {
                        alert('Internal Server Error !' + "\n");
                    }
                });
            }
        });
    </script>
    <script>
        $('#CourseList').on('change', function () {
            var CourseId = $('#CourseList').val();
            var ClassId = $('#ClassList').val();
           
            if (CourseId != 0) {
                $.ajax({
                    url: '@Url.Action("GetStaffByCourseId", "TimeTable")',
                    data: { sCourseId: CourseId, sClassId: ClassId },
                    success: function (option) {
                       // var ddl = JSON.parse(option);
                       
                        if ((option.Staff_Id) != 0)
                        {
                            $('#StaffList').empty();
                            $('#StaffList').append('<option value="">-- select --</option>' + option);
                            $('.selectpicker').selectpicker('refresh');
                        }
                        else {
                            alert('Please assign the staff for this course in class course staff...!!!');
                        }

                        //$('#ddlStaff').val(sStaffId);
                    },
                    error: function (xhr, textStatus, error) {
                        alert('Internal Server Error !' + "\n");
                    }
                });
            }
        });
    </script>
    <script>
        $("#btnSubmit").on("click", function () {
            var ClassId = $("#ClassList").val();
            var CourseId = $("#CourseList").val();
            var StaffId = $("#StaffList").val();
            var DayOrderId = $("#DayOrderList").val();
            var HourId = $("#HourList").val();
            var SemesterId = $("#SemesterList").val();
            var HourTypeId = $("#HourType").val();
            var JsonData;
            if (JsonData == null) {
                JsonData = '{"Class_Id":"' + ClassId + '","Course_Id":"' + CourseId + '","Staff_Id":"' + StaffId + '","Day_Order_Id":"' + DayOrderId + '","Hour_Id":"' + HourId + '","Semester_Id":"' + SemesterId + '","hourType":"' + HourTypeId + '","COURSE_ROOT_ID":"' + CourseId + '"}';
            }
            if (ClassId != 0 && StaffId != 0 && DayOrderId != 0 && HourId != 0 && HourTypeId!=0) {
                $.ajax({
                    url: "@Url.Action("SaveClassWiseTimeTable", "TimeTable")",
                    method: "POST",
                    datatype: "html",
                    data: { TimeTableInfo: JsonData },
                    success: function (data) {
                        alert(data);
                    }, error: function (error) {
                        alert('Internal Server Error ..!');
                    }
                });
            }
            else {
                alert('Enter the correct values...!!!');
            }
        });
    </script>

