@model CMS.ViewModel.ViewModel.TimeTableViewModel

@{ 
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">TimeTable Report</li>
    </ol>
    <h1 class="page-header">TimeTable Report</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">TimeTable Report</h4>
        </div>
        <div class="panel-body" id="maindiv">

            <div class="form-horizontal">
                <div class="col-md-12">
                    <div class="form-group col-md-5">
                        @Html.Label("Select Staff", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "staffid" })
                            @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                        </div>

                    </div>

                    <div class="form-group  col-md-2">
                        <button name="get" class="btn btn-primary" id="btnGet">Get</button>
                    </div>
                    <div class="form-group col-md-2 pull-right">
                        <div class="col-md-6"><button name="excel" id="excel" class="btn btn-success">Excel</button><br></div>
                        <div class="col-md-6"><button class="btn btn-primary" onclick="printDiv('loaddiv')" id="print">Print</button></div>
                    </div>
                </div>
                <div class="col-md-12 form-group table-responsive">
                    <div id="loaddiv">

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        $('.selectpicker').selectpicker({
            size: 6
        });
    }

    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/TIMETABLE/TimeTableReportForIncharge');
    }
    $('#excel').on('click', function () {

        let file = new Blob([$('#loaddiv').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "Student Wise Course" + "_Year.xls"
        }).appendTo("body").get(0).click();
        loadContent('/TIMETABLE/TimeTableReportForIncharge');

    });
    $('#btnGet').on('click', function ()
    {
        var staffid = $('#staffid').val();
        $.ajax({
            url: "/TimeTable/BindTimetableReport",
            method: "POST",
            datatype: "json",
            data: { sStaffId: staffid },
            success: function (data)
            {
                $('#loaddiv').empty();
                $('#loaddiv').append(data);
                $('#lblStaff').append('Individual Time Table Report For :: ' + $('#staffid option:Selected').text());
            },
            error: function ()
            {
                alert('Internal Server Error !');
            }
        })
    });
</script>
