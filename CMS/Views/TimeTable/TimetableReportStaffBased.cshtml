@model CMS.ViewModel.ViewModel.TimeTableViewModel
@{
    ViewBag.Title = "TimetableReportStaffBased";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">TimeTable Report</li>
    </ol>
    <h1 class="page-header">TimeTable Report</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">TimeTable Report</h4>
        </div>
        <div class="panel-body" id="maindiv">

            <div class="form-horizontal">
                <div class="col-md-12">
                    <div class="form-group col-md-3">
                        @Html.Label("Ac Year", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-3">
                        @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            <select class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" id="ddlSemesterType">
                                <option value=""> -- Select -- </option>
                                <option value="1"> Odd Semester </option>
                                <option value="2"> Even Semester </option>
                                <option value="3"> Non Semester </option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "staffid", @data_actions_box = "true", @multiple = "multiple" })
                            @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group  col-md-1">
                        <button name="get" class="btn btn-primary" id="btnGet">Get</button>
                    </div>
                    <div class="form-group col-md-2 pull-right">
                        <div class="col-md-6"><button name="excel" id="excel" class="btn btn-success">Excel</button><br></div>
                        <div class="col-md-6"><button class="btn btn-primary" onclick="printDiv('loaddiv')" id="print">Print</button></div>
                    </div>
                </div>
                <div class="col-md-12 form-group table-responsive">
                    <div id="loaddiv">

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad() {
        $('.selectpicker').selectpicker({
            size: 6
        });

        $('.selectpicker').selectpicker('refresh');
    }

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/TIMETABLE/TimetableReportStaffBased');
    }
    $('#excel').on('click', function () {

        let file = new Blob([$('#loaddiv').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "Student Wise Course" + "_Year.xls"
        }).appendTo("body").get(0).click();

    });
    $('#ddlSemesterType').on('change', function () {
        FetchStaffList()
    });
    $('#AcademicYear').on('change', function () {
        FetchStaffList()
    });
    function FetchStaffList()
    {
         
        if ($('#ddlSemesterType').val() && $('#AcademicYear').val())
        {
            $.ajax({
                url: "/TimeTable/FetchStaffByAcYearandSemtype",
                method: "POST",
                datatype: "json",
                data: { sSemesterTypeId: $('#ddlSemesterType').val(), sAcYear: $('#AcademicYear option:selected').text() },
                success: function (data) {
                    $('#staffid').empty();


                    if (data.sResult != null && data.sResult != '') {
                        $('#staffid').append(data.sResult);
                    } else {
                        $('#staffid').empty();
                        myAlert(data.Message, 'gritter-danger', '');
                    }
                    // Refresh the selectpicker for the specific dropdown
                    $('#staffid').selectpicker('refresh');
                },
                error: function (error) {
                    myAlert('Internal Server Error ...!', 'gritter-danger', '');
                }

            })
        }
    };
    $('#btnGet').on('click', function () {
        var staffid = String($('#staffid').val());
        if ($('#ddlSemesterType').val() && staffid != '') {
            $.ajax({
                url: "/TimeTable/BindTimetableReportForAllStaffBasedAcYear",
                method: "POST",
                datatype: "json",
                data: { sSemesterTypeId: $('#ddlSemesterType').val(), sStaffId: staffid, sAcYear: $('#AcademicYear option:selected').text() },
                success: function (data) {
                    $('#loaddiv').empty();
                    $('#loaddiv').append(data);
                    $('.lblSemester').append($('#ddlSemesterType option:Selected').text());
                    $('.lblAcYear').append($('#AcademicYear option:Selected').text());
                },
                error: function () {
                    alert('Internal Server Error !');
                }
            })
        }

    });
</script>
