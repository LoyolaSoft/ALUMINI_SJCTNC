    $('.contClass').on('click', function () {

        if ($(this).is(':checked')) {
            var currentRow = $(this).closest('tr');
            var previousRow = currentRow.prev('tr');
            if (!previousRow.parsley().validate()) {
                isValid = false;
                myAlert('Something went wrong! Please check your inputs!', 'gritter-warning', '');
                return false; // Exit the loop if validation fails
            }


            // Get data from previous row
            var unit = previousRow.find('.unitId').val();
            var topicTitle = previousRow.find('.topicTitle').val();
            var supTitle = previousRow.find('.supTitle').val();
            var methodologies = previousRow.find('.methodologyId').val();

            // Append data to current row
            currentRow.find('.unitId').val(unit);
            currentRow.find('.topicTitle').val(topicTitle);
            currentRow.find('.supTitle').val(supTitle);

            // Set selected methodologies in the dropdown (assuming multiselect)
            currentRow.find('.methodologyId').val(methodologies);
            currentRow.find('.methodologyId').selectpicker('refresh'); // Refresh selectpicker if using Bootstrap Select

            // Optionally, you can clear and reset validations if any
            currentRow.find('.unitId').parsley().reset();
            currentRow.find('.topicTitle').parsley().reset();
            currentRow.find('.supTitle').parsley().reset();
            currentRow.find('.methodologyId').parsley().reset();
        }
        else {
            var currentRow = $(this).closest('tr');
            // Append data to current row
            currentRow.find('.unitId').val("");
            currentRow.find('.topicTitle').val("");
            currentRow.find('.supTitle').val("");

            // Set selected methodologies in the dropdown (assuming multiselect)
            currentRow.find('.methodologyId').val("");
            currentRow.find('.methodologyId').selectpicker('refresh');
        }
        });

    $(".IsSubstitute").on('click', function () {
    if ($(this).is(':checked')) {
        var currenttr = $(this).closest("tr");
        var varcurrentDiv = currenttr.find('.SubstituteStafflist');
        varcurrentDiv.removeClass("hidden");
        var hourID = $(this).val();
        var shift = $(this).attr('shift');
        var date = $('#Datefrom').val();

        $.ajax({
            url: "@Url.Action("FetchSubStaffforTpm", "TimeTable")",
            method: "POST",
            datatype: "html",
            data: { shourID: hourID, sdate: date, sshift: shift },
            success: function (data) {
                var select = currenttr.find(".SupStaffs");
                select.empty();
                if (data.sResult != null && data.sResult != '') {
                    select.append(data.sResult);
                } else {
                    myAlert(data.Message, 'gritter-danger', '');
                }
                // Refresh the selectpicker for the specific dropdown
                select.selectpicker('refresh');
            },
            error: function (error) {
                myAlert('Internal Server Error ...!', 'gritter-danger', '');
            }
        });

    } else {
        var currenttr = $(this).closest("tr");
        var varcurrentDiv = currenttr.find('.SubstituteStafflist');
        varcurrentDiv.addClass("hidden");
    }
});

</script>
