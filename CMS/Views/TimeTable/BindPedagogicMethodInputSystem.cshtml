                            <th><b>Class</b></th>
                            <th><b>Course Code</b></th>
                            <th><b>Hour</b></th>
                            <th><b>Unit</b></th>
                            <th><b>Topic Title</b></th>
                            <th><b>Sub Topic</b></th>
                            <th><b>Methodology</b></th>
                            <th><b>CC</b></th>
                            <th><b>Substitute</b></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var items in Model.liStaffCourseList)
                        {
                            count++;

                            if (!string.IsNullOrEmpty(items.PENDAGOGIC_ID))
                            {
                                <tr class="nav-tab1" data-parsley-validate="true">
                                    @*<td>@count</td>*@
                                    @*<td>@items.DAY_ORDER_DATE</td>*@
                                    <td>@items.CLASS_CODE </td>
                                    <td>@items.COURSE_CODE</td>
                                    <td>@items.HOUR</td>

                                    <td>
                                        @items.UNIT_NAME
                                    </td>
                                    <td>@items.TOPIC_TITLE</td>
                                    <td>@items.SUP_TOPIC</td>
                                    <td>
                                        @items.METHODOLOGY_NAME
                                    </td>
                                    <td></td>
                                    <td>@items.FIRST_NAME</td>
                                </tr>
                            }
                            else
                            {
                                ccCount++;
                                <tr class="nav-tab1" data-parsley-validate="true">
                                    @*<td>@count</td>*@
                                    @*<td>@items.DAY_ORDER_DATE</td>*@
                                    <td value="@items.CLASS_ID" class="classId">@items.CLASS_CODE</td>
                                    <td value="@items.COURSE_ID" class="CourseID">@items.COURSE_CODE</td>
                                    <td value="@items.HOUR_ID" class="hour">@items.HOUR</td>

                                    <td>
                                        <div class=" col-md-12">

                                            @Html.DropDownListFor(model => model.UnitList, (Model.UnitList != null) ? Model.UnitList : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control unitId", @data_live_search = "true", @data_parsley_required = "true" })
                                            @Html.ValidationMessageFor(model => model.UnitList, "", new { @class = "text-danger" })

                                        </div>
                                    </td>
                                    <td><textarea class="form-control topicTitle" required></textarea></td>
                                    <td><textarea class="form-control supTitle" required></textarea></td>
                                    <td>
                                        <div>

                                            <div class="col-md-12">
                                                @Html.DropDownListFor(m => m.MethodologyList, (Model.MethodologyList != null) ? Model.MethodologyList : Enumerable.Empty<SelectListItem>(), "--- Select ---", new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_parsley_required = "true" })  @*, @multiple = "multiple",  @data_actions_box = "true" *@
                                                @Html.ValidationMessageFor(m => m.MethodologyList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </td>
                                    @*@if (lastHour + 1 == Convert.ToInt16(items.HOUR_ID) && lastHour != 0)
                                        {
                                            <td><input type="checkbox" class="contClass" /></td>

                                        }
                                        else
                                        {
                                            <td></td>
                                        }*@
                                    @if (ccCount == 1)
                                    {
                                        <td></td>
                                    }
                                    else
                                    {
                                        <td><input type="checkbox" class="contClass" /></td>
                                    }
                                    @{
                                        lastHour = Convert.ToInt16(items.HOUR_ID);
                                    }
                                    <td>
                                        <input type="checkbox" class="IsSubstitute" value="@items.HOUR_ID" shift="@items.SHIFT" />
                                        <div class="form-horizontal SubstituteStafflist hidden">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  SupStaffs", @data_live_search = "true" })
                                                @Html.ValidationMessageFor(m => m.StaffList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div>
                <div>
                    <a href="javascript:;" id="btnSubmitAll" class="btn btn-sm btn-primary m-b-10 pull-right"> Submit</a>

                </div>
            </div>
        </div>
    </div>
}
else
{
    <br />
    <br />
    <div class="bg-danger text-center">
        <h3>No Record's Found</h3>
    </div>
}
