@model CMS.ViewModel.ViewModel.OnlineClassViewModel

@{
    Layout = null;
}

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Online Class</li>
    </ol>
    <h2 class="page-header">Online Class</h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Online Class</h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal" id="Validate">
                <div class="col-md-12 form-group table-responsive">
                    @if (Model.liOnlineClass != null && Model.liOnlineClass.Count > 0)
                    {
                        var liGroupShift = Model.liOnlineClass.GroupBy(x => x.SHIFT).OrderBy(x => x.FirstOrDefault().SHIFT).ToList();
                        foreach (var Groupitem in liGroupShift)
                        {
                            var liOnlineClass = Model.liOnlineClass.Where(x => x.SHIFT == Groupitem.FirstOrDefault().SHIFT).ToList();
                            <div id="dvShift" class="col-md-12"> Time Table For SHIFT - @Groupitem.FirstOrDefault().SHIFT</div>
                            <table class="table table-bordered table-hover" id="tblOnlineClass">
                                <thead>
                                    <tr>
                                        <th>Hour</th>
                                        <th>Hour Type</th>
                                        <th>Class</th>
                                        <th>Course</th>
                                        <th>Staff</th>
                                        <th>Link</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.liHours != null && Model.liHours.Count > 0)
                                        {
                                            foreach (var HourItem in Model.liHours)
                                            {
                                                var liOnlineClassHours = liOnlineClass.Where(x => x.HOUR_ID == HourItem.HOUR_ID).ToList();
                                                <tr>
                                                    <td>@HourItem.HOUR</td>
                                                    @if (liOnlineClassHours != null && liOnlineClassHours.Count > 0)
                                                    {
                                                        <td>@liOnlineClassHours.FirstOrDefault().HOURTYPE</td>
                                                        <td>@liOnlineClassHours.FirstOrDefault().CLASS_CODE</td>
                                                        <td>
                                                            ( @liOnlineClassHours.FirstOrDefault().COURSE_CODE )<br />
                                                            @liOnlineClassHours.FirstOrDefault().COURSE_TITLE
                                                        </td>
                                                        <td>@liOnlineClassHours.FirstOrDefault().STAFF_CODE</td>
                                                        <td><a href="@liOnlineClassHours.FirstOrDefault().ONLINE_CLASS_LINK" target="_blank"> Click here</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                                            }
                                        }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
{
    string sCollege = string.Empty;
    <div class="modal fade shadow-lg p-3 mb-5 bg-white rounded" id="OnlineClassInfo">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                    <h4 class="modal-title"><b class="text-primary">@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME ONLINE CLASS @DateTime.Now.Year.ToString() - @DateTime.Now.AddYears(1).ToString("yyyy") </b> </h4>
                </div>
                <div class="modal-body ">
                    <div class="text-justify">
                        <p style="font-weight: bold;font-size: 12pt;"> Dear Users,</p>
                        <p>Welcome to @Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME ONLINE CLASS</p>
                        <p>Online Classes start from 03-08-2020</p>
                        <p>For First Years UG & PG from 19-08-2020</p>
                        <p style="font-weight: bold;font-size: 12pt;">To attend Online Classes</p>
                        <ul>1.Close all the web pages in your PC / Laptop / Smart Phone</ul>
                        <ul>2.Open your email account given by the College (Example Your Roll Number @if (Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE == "SJC") { sCollege = "@sjctnc.edu.in"; } else { sCollege = "@hcctrichy.ac.in"; } @sCollege)</ul>
                        <ul>3.Open the next page to enter into “erp.sjctnc.in”</ul>
                        <ul>4.Use your User Name: Roll Number and given Password to enter your ERP Site</ul>
                        <ul>5.Click “Online Classes” in menu</ul>
                        <ul>6.You will be getting your Time Table</ul>
                        <ul>7.Click the link given in the Time Table to enter into the Class</ul>
                        <ul>8.In Online Class you are advised to keep the decorum and serenity</ul>
                        <p style="font-weight: bold;font-size: 12pt;">Timings : Shift-I & Shift-II</p>
                        <ul>I-Hour – 10.00 a.m.</ul>
                        <ul>II-Hour – 11.30 a.m.</ul>
                        <ul>III-Hour – 2.30 p.m.</ul>
                        <!--<iframe class="col-md-5 " src="https://www.youtube.com/embed/-pcqncHySWI" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen=""></iframe> -->
                    </div>
                </div>
                <div class="modal-footer">

                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="hdCollegeCode" value="@Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE" />
}


<script>
    function ContentLoad()
    {

    }
    (function ()
    {
        if ($('#hdCollegeCode').val() == "SJC") {
            $('#OnlineClassInfo').modal('show');
        }
    });
    
</script>