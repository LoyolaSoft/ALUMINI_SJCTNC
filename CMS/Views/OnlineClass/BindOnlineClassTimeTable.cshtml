@model CMS.ViewModel.ViewModel.OnlineClassViewModel

<div class="col-md-12 form-group table-responsive">
    @if (Model.liOnlineClass != null && Model.liOnlineClass.Count > 0)
    {
        var liGroupShift = Model.liOnlineClass.GroupBy(x => x.SHIFT).OrderBy(x => x.FirstOrDefault().SHIFT).ToList();
        foreach (var Groupitem in liGroupShift)
        {
            var liOnlineClass = Model.liOnlineClass.Where(x => x.SHIFT == Groupitem.FirstOrDefault().SHIFT).ToList();
            <div id="dvShift" class="col-md-12"> Time Table For SHIFT - @Groupitem.FirstOrDefault().SHIFT</div>
            <table class="table table-bordered table-hover" id="tblOnlineClass">
                <thead>
                    <tr>
                        <th>Hour</th>
                        <th>Hour Type</th>
                        <th>Class</th>
                        <th>Course</th>
                        <th>Staff</th>
                        <th>Link</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.liHours != null && Model.liHours.Count > 0)
                        {
                            foreach (var HourItem in Model.liHours)
                            {
                                var liOnlineClassHours = liOnlineClass.Where(x => x.HOUR_ID == HourItem.HOUR_ID).ToList();
                                <tr>
                                    <td>@HourItem.HOUR</td>
                                    @if (liOnlineClassHours != null && liOnlineClassHours.Count > 0)
                                    {
                                        <td>@liOnlineClassHours.FirstOrDefault().HOURTYPE</td>
                                                        <td>@liOnlineClassHours.FirstOrDefault().CLASS_CODE</td>
                                                        <td>
                                                            ( @liOnlineClassHours.FirstOrDefault().COURSE_CODE )<br />
                                                            @liOnlineClassHours.FirstOrDefault().COURSE_TITLE
                                                        </td>
                                                        <td>@liOnlineClassHours.FirstOrDefault().STAFF_CODE</td>
                                                        <td><a href="@liOnlineClassHours.FirstOrDefault().ONLINE_CLASS_LINK" target="_blank"> Click here</a></td>
                                    }
                                    else
                                    {
                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                    }
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
                            }
                        }
</div>