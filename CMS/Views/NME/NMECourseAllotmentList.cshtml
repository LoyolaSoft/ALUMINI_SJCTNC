@model CMS.ViewModel.ViewModel.NMEViewModel

@{
    ViewBag.Title = "NMECourseAllotmentList";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List NME Class Course Allotment</li>
    </ol>
    <h1 class="page-header">NME Class Course Allotment</h1>
   
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List NME Class Course Allotment </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/NME/NMECourseAllotment')" @*href="@Url.Action("NMECourseAllotment","NME")"*@><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <br />
            @{ int count = 0;}
            @if (Model.lstNMECourseAllotment != null)
            {
                <div class="table-responsive col-md-12">
                <table class="table table-bordered table-hover table-responsive" id="NMECourseAllotmentList">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Shift
                            </th>
                            <th>
                                Course Code
                            </th>
                            <th>
                                Course Title
                            </th>
                            <th>
                                Alloted Seats
                            </th>
                            <th>
                                Academic Year
                            </th>
                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.lstNMECourseAllotment)
                {
                            <tr>
                                <td>
                                    @{ count++;}
                                    @count
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SHIFT_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.COURSE_CODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.ALLOTED_SEATS)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ACADEMIC_YEAR)
                                </td>
                                <td>
                                    <a @*href="@Url.Action("EditNMECourseAllotment","NME",new { id=@item.ALLOTMENT_ID})"*@  href="javascript:;" onclick="loadContent('/NME/EditNMECourseAllotment/@item.ALLOTMENT_ID')"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                    <a href="javascript:;" onclick="GetConfrim(@item.ALLOTMENT_ID);" @*href="@Url.Action("DeleteNMECourseAllotment","NME",new { id=@item.ALLOTMENT_ID})" onclick="return confirm('Are you sure want to delete ?');"*@><i class="fa fa-trash text-danger" title="Delete"></i></a>
                                </td>
                            </tr>
                                        }
                    </tbody>
                </table>
                    </div>
                                        }
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $("#NMECourseAllotmentList").DataTable({
            "bPaginate": false
        });


        function GetConfrim(ID)
        {
            if (!confirm('Are you sure to delete ?')) 
            {
                return false;
            }
            $.ajax({
                url: "@Url.Action("DeleteNMECourseAllotment", "NME")",
                method: "POST",
                datatype: "json",
                data: { id: ID },
                success: function (data) 
                {
                    alert(data);
                    loadContent('/NME/NMECourseAllotmentList');
                },error:function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    </script>

