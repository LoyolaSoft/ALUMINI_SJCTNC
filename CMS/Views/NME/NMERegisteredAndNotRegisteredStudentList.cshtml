
@model CMS.ViewModel.ViewModel.NMEViewModel

@{
    ViewBag.Title = "NMERegisteredAndNotRegisteredStudentList";
    Layout = null;
}

<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">NME Registration List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">NME Registration List</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">NME Registration List</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

            <div class="form-horizontal">

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="row">
                    <div class="form-group col-md-4">
                        <label class="control-label col-md-4">AC Year</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-3">
                        @Html.Label("Type", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" id="type">
                                <option value="0">--- Select ---</option>
                                <option value="1">Registered</option>
                                <option value="2">Not Registered</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-3">
                        @Html.LabelFor(model => model.SemesterList, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.SemesterList, (Model.SemesterList != null) ? Model.SemesterList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.SemesterList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-1">
                        <a class="btn btn-primary" id="GetDetails" onclick="bindNMEReport()"> Get</a>
                    </div>
                    <div class="col-md-1">
                        <a class="btn btn-success btnPrint hidden" onclick="printDiv('dvBind')"> Print </a>
                    </div>
                    <div class="col-md-1">
                        <a class="btn btn-info btnExport hidden" onclick="Export()"> Export </a>
                    </div>

                </div>
                <br />
                <hr />
                <br />
                <div class="col-md-12">
                    <div class="form-group" id="dvBind">

                    </div>
                </div>

            </div>
            }


        </div>
    </div>
    <!-- end panel -->
</div>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<!-- ================== BEGIN PAGE LEVEL SCRIPT ================== -->
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>

    $('.selectpicker').selectpicker({
        size: 6
    });
    ContentLoad = function () {

        $('.selectpicker').selectpicker('refresh');

    }
    $('#tblNMERegistration').DataTable({
        dom: "lBfrtip", buttons: [{ extend: "copy", className: "btn-sm" },
        { extend: "csv", className: "btn-sm" },
        { extend: "excel", className: "btn-sm" },
        { extend: "pdf", className: "btn-sm" },
        { extend: "print", className: "btn-sm" }
        ]
    });


    $("#SemesterList").on("change", function ()
    {
        bindNMEReport();

    });
        function bindNMEReport() {
            var Semester = $("#SemesterList").val();
                var type = $('#type').val();
                var AcademicYear = $('#AcademicYearList option:selected').text();
                    if (AcademicYear == '' || AcademicYear == '0') {
                        alert('Please Choose All The Values...!!!');
        return false;
    }
           $.ajax({
                url: "@Url.Action("BindNMERegisteredStudentList", "NME")",
                method: "POST",
                datatype: "json",
               data: { sAcademicYear: AcademicYear, sSemestertype: Semester, sType: type },
               success: function (data)
               {
                   $('.btnPrint').removeClass('hidden');
                   $('.btnExport').removeClass('hidden');
                    $("#dvBind").empty();
                    $("#dvBind").append(data);
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }


    $("#ClassList").on("change", function ()
    {

        BindSemesterExamResult();

     });


    function printDiv(divName) {
        var table = $('#tblNMERegistration').DataTable();
        table.destroy();
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;

        loadContent('/NME/NMERegisteredAndNotRegisteredStudentList');
    }
    function Export() {
        var title = "";
        var table = $('#tblNMERegistration').DataTable();
        table.destroy();
        //var sSatff = $('#StaffListByDepartmet option:selected').text();
        title = "NME_report";
        let file = new Blob([$('#dvBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();

        $('#tblNMERegistration').DataTable({
            dom: "lBfrtip", buttons: [{ extend: "copy", className: "btn-sm" },
            { extend: "csv", className: "btn-sm" },
            { extend: "excel", className: "btn-sm" },
            { extend: "pdf", className: "btn-sm" },
            { extend: "print", className: "btn-sm" }
            ]
        });
    }

</script>






