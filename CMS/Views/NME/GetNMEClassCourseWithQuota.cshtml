@model CMS.ViewModel.ViewModel.NMEViewModel

@{
    Layout = null;
    double nRemainQuota = 0;
}

<div class="body-content">
    <div class="col-md-12 m-t-5 col-sm-12 col-lg-12 table-responsive" style="min-height:450px;">
        @{ int count = 0;}
        @if (Model.lstBindNMEClassCourse != null)
        {

            <table class="table table-hover table-bordered" id="NMEClassCourseQuota">
                <thead>
                    <tr>
                        <th>
                            #
                        </th>
                        <th>Course Code</th>
                        <th>Course Title</th>
                        <th>Total Quota</th>
                        <th>Class Quota</th>
                        <th>Registered Student</th>
                        <th>Remaining Quota</th>
                        <th>Alloted Seats</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.lstBindNMEClassCourse)
                    {
                        <tr>
                            <td>
                                @{ count++;}
                                @count
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.COURSE_CODE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ALLOTED_SEATS)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.QUOTA)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.STUDENT_COUNT)
                            </td>
                            <td>
                                @{
                                    nRemainQuota = Convert.ToDouble(item.QUOTA) - Convert.ToDouble(item.STUDENT_COUNT);
                                    @nRemainQuota
                                }
                            </td>
                            <td>
                               
                                @if (nRemainQuota <= 0)
                                {
                                    <input id="txtClassQuota" class="form-control" type="number" style="width:75px !important;" step=".01" max="@item.ALLOTED_SEATS" value=""
                                           cms-totalquota="@item.ALLOTED_SEATS"
                                           cms-sumofquota="@nRemainQuota"
                                           cms-courserootid="@item.COURSE_ROOT_ID" />
                                }
                                else
                                {
                                    <input id="txtClassQuota" class="form-control" type="number" style="width:75px !important;" step=".01" max="@item.TOTALQUOTA" value=""
                                           cms-totalquota="@item.ALLOTED_SEATS"
                                           cms-sumofquota="@nRemainQuota"
                                           cms-courserootid="@item.COURSE_ROOT_ID" />
                                }
                            </td>
                        </tr>
                                    }
                </tbody>
            </table>
                                    }
    </div>
</div>