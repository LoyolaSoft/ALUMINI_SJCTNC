@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    Layout = null;
    int count = 0;
}
<div class="col-md-12">
    <table class="table table-bordered table-responsive">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Short Name</th>
                <th>Action Name</th>
                <th>ControllerName</th>
                <th>Grouped</th>
                <th>Order</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liDashBoardModel != null && Model.liDashBoardModel.Count > 0)
            {
                foreach (var item in Model.liDashBoardModel)
                {
                    <tr id="@item.DASHBOARD_ID">
                        <td>@{count++;}@count</td>
                        <td>@item.SHORT_NAME</td>
                        <td>@item.ACTION_NAME</td>
                        <td>@item.CONTROLLER_NAME</td>
                        @if (item.IS_GROUP == "1")
                        {
                            <td>Yes</td>

                        }
                        else
                        {
                            <td>No</td>
                        }
                        <td>@item.IS_ORDER</td>
                        <td>
                            <a href="#InsertModal-dialog" onclick="FetchMenuDetails(@item.DASHBOARD_ID)" data-toggle="modal" class="text-primary" title="Click To Edit"><i class="fa fa-edit text-primary"></i></a>
                            <a onclick="GetConfirm('@item.DASHBOARD_ID')" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7">No Record Found..!</td></tr>
            }
        </tbody>
    </table>
</div>

