@model CMS.ViewModel.ViewModel.DashboardViewModel

<div class="col-sm-8">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h3 class="panel-title"><i class="fa fa-flag"></i> Events</h3>
                </div>
                <div class="panel-body noPadding">
                    <div class="row myMargin" id="event">
                        <marquee direction="up" scrolldelay="150" onmouseover="stop();" onmouseout="start();">
                            <div class="height-sm">
                                @if (Model.liCalenderEvents != null && Model.liCalenderEvents.Count > 0)
                                {
                                    var groupdate = Model.liCalenderEvents.GroupBy(x => x.EVENT_START_DATE).ToList();
                                    <ul class="media-list media-list-with-divider media-messaging">
                                        @if (groupdate != null && groupdate.Count > 0)
                                        {
                                            foreach (var item in groupdate)
                                            {
                                                <li class="media media-sm">
                                                    <a href="javascript:;" class="pull-left">
                                                        <img src="" alt="" class="media-object rounded-corner" />
                                                    </a>
                                                    <div class="media-body">
                                                        <h5 class="media-heading"><b>@item.FirstOrDefault().EVENT_START_DATE</b></h5>
                                                        @{
                                                            var IndDate = Model.liCalenderEvents.Where(x => x.EVENT_START_DATE == item.FirstOrDefault().EVENT_START_DATE).ToList();
                                                            if (IndDate != null && IndDate.Count > 0)
                                                            {
                                                                var fileExtension = string.Empty;


                                                                foreach (var item1 in IndDate)
                                                                {
                                                                    <div class="d-flex align-items-center" style="margin: 0; display: inline-flex; align-items: center;">
                                                                        <p>
                                                                            @Html.Raw(HttpUtility.HtmlDecode(item1.EVENT_NAME))
                                                                            @{
                                                                                var filePath = item1.IMAGE;
                                                                                if (filePath != null)
                                                                                {
                                                                                    fileExtension = System.IO.Path.GetExtension(filePath).ToLower();
                                                                                }
                                                                            }

                                                                            @if (!string.IsNullOrEmpty(fileExtension))
                                                                            {
                                                                                if (fileExtension == ".jpg" || fileExtension == ".jpeg" || fileExtension == ".png" || fileExtension == ".gif")
                                                                                {
                                                                                    <a href="@filePath" target="_blank">&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-file-image-o" style="font-size: 20px;"></i></a>
                                                                                }
                                                                                else if (fileExtension == ".pdf")
                                                                                {
                                                                                    <a href="@filePath" target="_blank">&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-file-pdf-o" style="font-size: 20px;"></i></a>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <a href="@filePath" target="_blank">&nbsp;&nbsp;&nbsp;&nbsp;Downlod</a>
                                                                                }
                                                                            }
                                                                        </p>
                                                                    </div>
                                                                    <br />
                                                                }
                                                            }
                                                        }

                                                    </div>
                                                </li>
                                            }
                                        }

                                    </ul>
                                }
                            </div>
                        </marquee>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

