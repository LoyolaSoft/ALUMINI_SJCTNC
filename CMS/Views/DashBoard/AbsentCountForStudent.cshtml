@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    Layout = null;
    string nCourses = string.Empty;
}
<div class="col-md-3 col-sm-6">
    <div class="widget widget-stats bg-gradient-purple">
        <div class="stats-icon"><i class="fa fa-tachometer"></i></div>
        <div class="stats-info">
            <h4>Absent Count</h4>
            <p>
                @if (Model.liAttendanceReport != null && Model.liAttendanceReport.Count > 0)
                {
                    nCourses = Model.liAttendanceReport.Count.ToString();
                }
                else
                {
                    nCourses = "0";
                }
                @nCourses

            </p>
        </div>
        <div class="stats-link">
            <a href="#Course-dialog" data-toggle="modal">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
        </div>
    </div>
    <div class="modal" id="Course-dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                    <h4 class="modal-title">List Absent Details </h4>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal row">
                        <div class="col-md-12 table-responsive">
                            <table class="table table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <td>#</td>
                                        <td>Student</td>
                                        <td>Attendance Date</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.liAttendanceReport != null && Model.liAttendanceReport.Count > 0)
                                    {
                                        int nCount = 0;
                                        var nRow = @Model.liAttendanceReport.Count + 1;
                                        <tr>
                                            <td rowspan="@nRow" style="text-align:center;">@{nCount++;} @nCount</td>
                                            <td rowspan="@nRow" style="text-align:center;">@Model.liAttendanceReport.FirstOrDefault().FIRST_NAME<br />@Model.liAttendanceReport.FirstOrDefault().ADMISSION_NO</td>

                                        </tr>
                                        foreach (var item in Model.liAttendanceReport)
                                        {

                                            <tr><td>@item.ATTENDENCE_DATE</td></tr>

                                        }
                                    }
                                </tbody>
                            </table>
                            <br />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>
