@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    ViewBag.Title = "DashboardMenu";
    Layout = null;
}

<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    @Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Dashboard Settings</li>
    </ol>
    <h2 class="page-header">Dashboard Settings</h2>

    <div class="panel">
        <div class="panel-heading bg-primary text-white">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"><i class="fa fa-cogs"></i> Dashboard Configuration</h4>
        </div>
        <div class="panel-body">
            <!-- Tabs Navigation -->
            <ul class="nav nav-tabs nav-tabs-inverse" style="margin-bottom: 20px;">
                <li class="active"><a href="#tab-menu-items" data-toggle="tab" aria-expanded="true"><i class="fa fa-list-ul"></i> Dashboard Menu Items</a></li>
                <li class=""><a href="#tab-role-access" data-toggle="tab" aria-expanded="false"><i class="fa fa-user-secret"></i> Role Based Access</a></li>
            </ul>

            <!-- Tabs Content -->
            <div class="tab-content" style="padding: 15px 0 0 0; background: none; border: none;">
                <!-- Tab 1: Dashboard Menu Items -->
                <div class="tab-pane fade active in" id="tab-menu-items">
                    <div class="row m-b-15">
                        <div class="col-md-12">
                            <a href="#InsertModal-dialog" data-toggle="modal" id="btnAdd" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add Menu Item</a>
                        </div>
                    </div>
                    <div class="form-horizontal">
                        <div class="col-lg-12 form-group">
                            <div id="bindtableMenu" class="table-responsive">
                                <!-- Dashboard menu items table binds here -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: Role Based Access -->
                <div class="tab-pane fade" id="tab-role-access">
                    <div class="well well-sm clearfix" style="background: #f5f7f8; border: 1px solid #e2e7eb; border-radius: 4px; padding: 15px; margin-bottom: 20px;">
                        <div class="row">
                            <div class="col-md-6 col-xs-12">
                                <div class="form-group clearfix m-b-0">
                                    <label class="control-label col-md-3 col-xs-12" style="padding-top: 7px; font-weight: 600;">Filter by Role:</label>
                                    <div class="col-md-9 col-xs-12">
                                        @Html.DropDownList("FilterRole", (Model.lirole != null) ? Model.lirole : Enumerable.Empty<SelectListItem>(), "--select role--", new { @class = "selectpicker show-menu-arrow show-tick form-control input-sm", @data_live_search = "true", id = "ddlFilterRole" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-xs-12 m-t-xs-10">
                                <a href="#RoleMenuModal-dialog" data-toggle="modal" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add Role Access</a>
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal">
                        <div class="col-lg-12 form-group">
                            <div id="bindtableRoleMenu" class="table-responsive">
                                <p class="text-center text-muted">Please select a role to view mapped dashboard menus.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 1: Add/Edit Menu Item -->
    <div class="modal" id="InsertModal-dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Menu Details</h4>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        <input type="hidden" name="STUDENT_ID" id="DASHBOARD_ID" value="" />
                        <div class="form-group">
                            <label class="control-label col-md-3">ShortName</label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.SHORT_NAME, new { htmlAttributes = new { @class = "form-control input-sm", Placeholder = "Short Name" } })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Action Name</label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.ACTION_NAME, new { htmlAttributes = new { @class = "form-control input-sm", Placeholder = "Action Name" } })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Controller Name</label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.CONTROLLER_NAME, new { htmlAttributes = new { @class = "form-control input-sm", Placeholder = "Controller Name" } })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Is_grouped</label>
                            <div class="col-md-9">
                                <label class="radio-inline">
                                    <input type="radio" id="txtyes" value="1" name="is_group" /> Yes
                                </label>
                                <label class="radio-inline">
                                    <input type="radio" id="txtno" value="0" name="is_group" checked /> No
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Menu Order</label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.IS_ORDER, new { htmlAttributes = new { @class = "form-control input-sm", Placeholder = "Menu Order" } })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <span class="text-warning pull-left" id="txtStatic"></span>
                    <button type="submit" id="btnSubmit" class="btn btn-primary" data-dismiss="modal">Submit</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 2: Map Role to Dashboard Menus -->
    <div id="RoleMenuModal-dialog" class="modal" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Map Role to Dashboard Menus</h4>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">Role</label>
                            <div class="col-md-9">
                                @Html.DropDownList("RoleTab2", (Model.lirole != null) ? Model.lirole : Enumerable.Empty<SelectListItem>(), "--select role--", new { @class = "selectpicker show-menu-arrow show-tick form-control input-sm", @data_live_search = "true", id = "ddlRoleTab2" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Menu List</label>
                            <div class="col-md-9">
                                @Html.DropDownList("MenuTab2", (Model.liMenu != null) ? Model.liMenu : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick form-control input-sm", @data_live_search = "true", id = "ddlMenuTab2", @multiple = "multiple" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <span class="text-warning pull-left" id="txtStaticRoleMenu"></span>
                    <button type="button" id="btnSubmitRoleMenu" class="btn btn-primary" data-dismiss="modal">Submit</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
        loadGird();
        loadGirdRoleMenu();
    }
    
    $('.selectpicker').selectpicker('refresh');

    $('#InsertModal-dialog').on('hidden.bs.modal', function () {
        $('#DASHBOARD_ID').val('');
        $('#SHORT_NAME').val('');
        $('#ACTION_NAME').val('');
        $('#CONTROLLER_NAME').val('');
        $('#IS_ORDER').val('');
        $('#txtno').prop('checked', true);
    });

    $('#RoleMenuModal-dialog').on('hidden.bs.modal', function () {
        $('#ddlRoleTab2').val('').selectpicker('refresh');
        $('#ddlMenuTab2').val('').selectpicker('refresh');
    });

    // Tab 1: Load Dashboard Menu Grid
    function loadGird() {
        $.ajax({
            url: "@Url.Action("BindDashBoardMenuList", "DashBoard")",
            method: "POST",
            datatype: "json",
            success: function (data) {
                $('#bindtableMenu').empty().append(data);
            }, error: function (error) {
                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    // Tab 1: Submit Add/Edit Menu Item
    $('#btnSubmit').on('click', function () {
        var sJsonData = {};
        sJsonData.DASHBOARD_ID = $('#DASHBOARD_ID').val();
        sJsonData.SHORT_NAME = $('#SHORT_NAME').val();
        sJsonData.ACTION_NAME = $('#ACTION_NAME').val();
        sJsonData.CONTROLLER_NAME = $('#CONTROLLER_NAME').val();
        sJsonData.IS_ORDER = $('#IS_ORDER').val();
        var status = "0";
        status = $('input[name="is_group"]:checked').val();
        sJsonData.IS_GROUP = status;

        $.ajax({
            url: '@Url.Action("UpdateDashboardMenu", "DashBoard")',
            method: 'POST',
            datatype: 'json',
            data: { sJsonvalue: JSON.stringify(sJsonData) },
            success: function (data) {
                $('.modal-backdrop').remove();
                if (data.ErrorCode == "202") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadGird();
                }
                else {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });

    // Tab 1: Fetch Menu Item Details for editing
    function FetchMenuDetails(DashBoard_id) {
        $.ajax({
            url: "@Url.Action("FetchDashBoardMenu", "DashBoard")",
            method: "POST",
            datatype: "json",
            data: { sDashBoard_id: DashBoard_id },
            success: function (data)
            {
                $('#DASHBOARD_ID').val(data.DASHBOARD_ID);
                $('#SHORT_NAME').val(data.SHORT_NAME);
                $('#ACTION_NAME').val(data.ACTION_NAME);
                $('#CONTROLLER_NAME').val(data.CONTROLLER_NAME);
                $('#IS_ORDER').val(data.IS_ORDER);
                if (data.IS_GROUP == "1") {
                    $('#txtyes').prop('checked', true);
                }
                else {
                    $('#txtno').prop('checked', true);
                }
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    }

    // Tab 1: Delete Menu Item
    function GetConfirm(ID) {
        swal({
            title: "Confirmation",
            text: "Are you sure you want to Delete this menu item?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "@Url.Action("DeleteDashboardMenu", "Dashboard")",
                method: "POST",
                datatype: "json",
                data: { sDashBoard_id: ID },
                success: function (data) {
                    if (data.ErrorCode != "202") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadGird();
                    }
                    else {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });
    }

    // Tab 2: Change filter role
    $('#ddlFilterRole').on('change', function () {
        loadGirdRoleMenu();
    });

    // Tab 2: Load Role-based access grid
    function loadGirdRoleMenu() {
        var vRoleId = $('#ddlFilterRole').val();
        if (!vRoleId || vRoleId == "") {
            $('#bindtableRoleMenu').empty().append('<p class="text-center text-muted">Please select a role to view mapped dashboard menus.</p>');
            return;
        }
        $.ajax({
            url: "@Url.Action("BindRoleBasedDashBoardMenu", "DashBoard")",
            method: "POST",
            datatype: "json",
            data: { sRoleId: vRoleId },
            success: function (data) {
                $('#bindtableRoleMenu').empty().append(data);
            }, error: function (error) {
                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    // Tab 2: Submit Role-based access mapping
    $('#btnSubmitRoleMenu').on('click', function () {
        var vMenuList = String($('#ddlMenuTab2').val());
        var vRoleId = $('#ddlRoleTab2').val();
        if (!vRoleId || vRoleId == "" || !vMenuList || vMenuList == "null" || vMenuList == "") {
            swal({ title: "Warning!", text: "Please select both Role and Menu Items.", type: "warning" });
            return false;
        }
        var sArray = vMenuList.split(',');
        var sJsonData = '{"JsonMenuList":[';
        for (var i = 0; i < sArray.length; i++) {
            sJsonData += '{"sroleId":"' + vRoleId + '","sMenuId":"' + sArray[i] + '"},';
        }
        sJsonData = sJsonData.slice(0, -1); sJsonData += ']}';

        $.ajax({
            url: '@Url.Action("InsertRoleBasedDashBoardMenu", "DashBoard")',
            method: 'POST',
            datatype: 'json',
            data: { sJsonvalue: sJsonData },
            success: function (data) {
                $('.modal-backdrop').remove();
                if (data.ErrorCode == "202") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    $('#ddlFilterRole').val(vRoleId).selectpicker('refresh');
                    loadGirdRoleMenu();
                }
                else {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });

    // Tab 2: Toggle status of mapped role menu item
    function GetConfirmRoleMenu(ID, IsActive) {
        swal({
            title: "Confirmation",
            text: "Are you sure you want to change the status of this mapping?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "@Url.Action("ActiveDeActiveDashBoardMenu", "Dashboard")",
                method: "POST",
                datatype: "json",
                data: { sUserRole_id: ID, sActive: IsActive },
                success: function (data) {
                    if (data.ErrorCode != "202") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadGirdRoleMenu();
                    }
                    else {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });
    }
</script>
