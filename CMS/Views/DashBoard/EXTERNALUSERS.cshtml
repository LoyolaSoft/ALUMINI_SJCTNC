@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    ViewBag.Title = "EXTERNALUSERS";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    //Layout = null;
}



<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">External User Dashboard</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">External User Dashboard</h1>
    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6 col-lg-12">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="fa fa-inbo"></i></div>
                <div class="stats-info">
                    <h4>Word Of The Day</h4>
                    <p><marquee onmouseover="stop();" onmouseout="start();"> My grace is sufficient for you, for my power is made perfect in weakness. 2 Corinthians 12:9 .</marquee></p>
                    @*<p><div id="ourmanna-verse">Loading...</div></p>*@
                </div>
                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
    </div>

    <div class="row">
        <div class="panel">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h3 class="panel-title"><i class="fa fa-inbox"></i>FeedBack Courses</h3>
            </div>
            <div class="panel-body noPadding">
                <div class="col-md-12 table-responsive">
                    <label>If You Have Any Query Please Contact : </label>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Department</th>
                                <th>Name</th>
                                <th>Mobile No</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.liStaff != null && Model.liStaff.Count > 0)
                            {
                                int nCount = 0;
                                foreach (var item in Model.liStaff)
                                {
                                    <tr>
                                        <td>@{nCount++;} @nCount</td>
                                        <td>@item.DEPARTMENT</td>
                                        <td>@item.FIRST_NAME</td>
                                        <td>@item.MOBILE</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                
                <div class="col-md-12 table-responsive">
                    <label>Alloted Course Are :</label>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Department</th>
                                <th>Course Code</th>
                                <th>Course Title</th>
                                <th>Semester</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.liCourse!=null && Model.liCourse.Count>0)
                            {
                                int nCount = 0;
                                foreach (var item in Model.liCourse)
                                {
                                    <tr>
                                        <td>@{nCount++;} @nCount</td>
                                        <td>@item.DEPARTMENT</td>
                                        <td>@item.COURSE_CODE</td>
                                        <td>@item.COURSE_TITLE</td>
                                        <td>@item.SEMESTER_ID</td>
                                        <td>
                                            <a href="javascript:;" onclick="loadContent('/FEEDBACK/ExternalUserFeedBackEntry?sCourseId=@item.COURSE_ROOT_ID&sCourseCode=@item.COURSE_CODE&sFeedbackId=@item.FEEDBACK_ID');" class="btn btn-success"> View </a>
                                        </td>
                                    </tr>
                                  }
                              }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>