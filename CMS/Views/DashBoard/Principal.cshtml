                        Fee collection
                    </h4>
                    <div id="fee_collection" class="morris-inverse"></div>
                </div>
                <div class="widget-chart-sidebar bg-black-darker">
                    <div class="chart-number">
                        @ViewBag.TotalStudents
                        <small>Users</small>
                    </div>

