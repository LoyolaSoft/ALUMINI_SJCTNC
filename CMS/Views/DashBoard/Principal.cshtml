@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    ViewBag.Title = "Principal";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    //Layout = null;
}

@section Styles{
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
}
<style>
    #ourmanna-verse {
        padding: 10px;
        margin: 10px;
        /*background: rgba(0, 0, 0, 0.3);
    border-color: rgba(0, 0, 0, 0.3);*/
        -webkit-border-radius: 5px;
        -moz-border-radius: 5px;
        border-radius: 5px;
    }

    #mannaverse {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    #mannaverse-reference:before {
        content: "- ";
    }

    #mannaverse-reference {
        text-align: right;
        font-size: 12px;
    }

    #mannaverse-version {
        color: #ddd;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Principal</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Principal Dashboard</h1>

    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6 col-lg-12">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="fa fa-inbo"></i></div>
                <div class="stats-info">
                    <h4>Word Of The Day</h4>
                    <p><div id="ourmanna-verse">Loading...</div></p>
                </div>
                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
    </div>
    @*@if (Model.liappdownload != null)
    {

    }
    else
    {
        Html.RenderPartial("AppDownloaded");
    }*@

    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-white text-inverse">
                <div class="stats-icon stats-icon-lg stats-icon-square bg-gradient-blue"><i class="ion-university"></i></div>
                <div class="stats-title">Total Students</div>
                <div class="stats-number">@ViewBag.TotalStudents</div>
                <div class="stats-progress progress">
                    <div class="progress-bar" style="width: 100%;"></div>
                </div>
                @*<div class="stats-desc">View details</div>*@
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
