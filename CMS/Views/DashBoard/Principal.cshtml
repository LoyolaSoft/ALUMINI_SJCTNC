                <div class="stats-number">@ViewBag.FeedbackTotal</div>
                <div class="stats-progress progress">
                    <div class="progress-bar" style="width: @ViewBag.FeedbackPercentage%;"></div>
                </div>
                @*<div class="stats-desc">View details</div>*@
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-white text-inverse">
                <div class="stats-icon stats-icon-lg stats-icon-square bg-gradient-blue"><i class="ion-ios-paper"></i></div>
                <div class="stats-title">Total Staff</div>
                <div class="stats-number">@ViewBag.TotalStaff</div>
                <div class="stats-progress progress">
                    <div class="progress-bar" style="width: 76.3%;"></div>
                </div>
                @*<div class="stats-desc">View details</div>*@
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
