                    {
                        <div class="form-group text-center"> Today Collection</div>

                        <ul class="chart-legend" style="bottom:initial !important">
                            @foreach (var item in Model.liFeeTransaction)
                            {
                                <li><i class="fa fa-circle-o fa-fw text-info m-r-5"></i>  <span style="color:#4cd964"> @item.FREQUENCY_TYPE-</span><b>@item.COLLECTED</b></li>
                            }
                        </ul>
                    }

                </div>
            </div>
