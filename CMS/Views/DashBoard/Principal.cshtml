@section scripts{
    <script src="~/Content/assets/plugins/morris/raphael.min.js"></script>
    <script src="~/Content/assets/plugins/morris/morris.js"></script>
    <script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap-world-merc-en.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-calendar/js/bootstrap_calendar.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="http://www.ourmanna.com/verses/api/js/" type="text/javascript"></script>
    @*<script src="~/Content/assets/js/dashboard-v2.min.js"></script>*@
    <script>
        $(document).ready(function ()
        {
           // Chart();
         //   PieChart();
          //  ExamChart();
           // StatisticalChart();
            handleDashboardDatepicker();
        });

        handleDashboardDatepicker = function () {
            "use strict";
            $("#datepicker-inline").datepicker({
                todayHighlight: !0
            }
            )
        }

        function StatisticalChart()
        {
            var $arrColors = ['#34495E', '#26B99A',  '#666', '#3498DB'];
            var JsonData='[';
            var chartvalue = @Html.Raw(Json.Encode(ViewBag.Statusticalfeecollection));
            if(chartvalue!=null)
            {

                for(var i = 0; i< chartvalue.length; i++)
                {
                    JsonData += '{"x":"'+ chartvalue[i].FREQUENCY_NAME + '","a":"'+chartvalue[i].COLLECTED+'"},';
                }
            }
            JsonData = JsonData.slice(0, -1);
            JsonData += ']';

            var obj = JSON.parse(JsonData);

            Morris.Bar({
                element:'statisticalreport',
                data:obj,
                xkey: 'x',
                ykeys: ['a'],
                labels: [''],
                barRatio: 0.4,


            });
        }

        function PieChart()
        {
            var JsonData='[';
            var chartvalue = @Html.Raw(Json.Encode(ViewBag.licollegeday));
            if(chartvalue!=null)
            {
                for(var i = 0; i< chartvalue.length; i++)
                {
                    JsonData += '{"label":"Total days","value":"'+chartvalue[i].TOTAL_REGISTER+'", "labelColor":"#C0CA33"},{"label":"Remaining days","value":"'+chartvalue[i].PASSED+'","labelColor":"#00897B"},';
                }
            }
            JsonData = JsonData.slice(0, -1);
            JsonData += ']';

            var obj = JSON.parse(JsonData);

            Morris.Donut({
                element:'collegedays',
                data:obj,
                labelColor: "#9CC4E4",

                labels: ['Total Register', 'Passed']
            });
        }
        function ExamChart()
        {
            var JsonData='[';
            var chartvalue = @Html.Raw(Json.Encode(ViewBag.lichartdata));
            if(chartvalue!=null)
            {

                for(var i = 0; i< chartvalue.length; i++)
                {
                    JsonData += '{"x":"'+ chartvalue[i].SEMSTER_NAME + '","a":"'+chartvalue[i].TOTAL_REGISTER+'","b":"'+chartvalue[i].PASSED+'"},';
                }
            }
            JsonData = JsonData.slice(0, -1);
            JsonData += ']';
            var obj = JSON.parse(JsonData);

            Morris.Bar({
                element:'exam_chart',
                data:obj,
                xkey: 'x',
                ykeys: ['a','b'],
                labels: ['Total Register', 'Passed'],
                barColors: ["#0cec39", "#9848d3", "#1AB244", "#9848d3"],
            });
        }

        function Chart()
        {

            var JsonData='[';
            var collection = @Html.Raw(Json.Encode(ViewBag.FeeCollection));
            if(collection!=null)
            {
                for(var i = 0; i< collection.length; i++)
                {
                    JsonData += '{"x":"'+ collection[i].PAYMENT_DATE + '","a":"'+collection[i].COLLECTED+'"},';
                }

                JsonData = JsonData.slice(0, -1);
                JsonData += ']';
                var obj = JSON.parse(JsonData);
                var arrColors = ['#007aff', '#ef0117',  '#4caf50', '#a550dd','#673ab7','#ef0117'];

                Morris.Area({
                    element:'fee_collection',
                    data: obj,
                    xkey: 'x',
                    // gridTextSize: 10,
                    ykeys: ['a'],
                    parseTime: false,
                    hideHover: 'auto',
                    behaveLikeLine: true,
                    lineWidth: '2px',
                    labels:['Amount'],
                    lineColors:["#4287f5"],
                    //pointFillColors: ['#87d688']

                });
            }
        }
    </script>
    <script>
        function HandleFeeTransaction()
        {
            $.ajax({
                url: '@Url.Action("FetchFeeTransactions", "DashBoard")',
                method: 'POST',
                datatype: 'json',
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        //data.sMonthData, data.sMonthLabel     || data.sFeeData, data.sFeeColor


                        handleVisitorsLineChart(data.sMonthData, data.sMonthLabel);
                        handleVisitorsDonutChart(data.sFeeData, data.sFeeColor);
                        handleScheduleCalendar();
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        };

    </script>
    <script>

        var getMonthName = function (e)
        {
            var t = [];
            return t[0] = "January",
            t[1] = "February",
            t[2] = "March",
            t[3] = "April",
            t[4] = "May",
            t[5] = "Jun",
            t[6] = "July",
            t[7] = "August",
            t[8] = "September",
            t[9] = "October",
            t[10] = "November",
            t[11] = "December",
            t[e]
        }

        ,
        getDate = function (e)
        {
            var t = new Date(e),
            r = t.getDate(),
            o = t.getMonth() + 1,
            i = t.getFullYear();
            return r < 10 && (r = "0" + r),
            o < 10 && (o = "0" + o),
            t = i + "-" + o + "-" + r
        }

        ,
        handleVisitorsLineChart = function (e,month)
        {
            //alert(e);
            Morris.Line({
                element: "visitors-line-chart", data: e, xkey: "x", ykeys: ["y"], xLabelFormat: month
                , labels: ["Page Views", "Unique Visitors"], lineColors: ["#007aff"], pointFillColors: ["#3086e4"], lineWidth: "2px", pointStrokeColors: ["rgba(0,0,0,0.6)", "rgba(0,0,0,0.6)"], resize: !0, gridTextFamily: "inherit", gridTextColor: "rgba(255,255,255,0.4)", gridTextWeight: "normal", gridTextSize: "12px", gridLineColor: "rgba(255,255,255,0.15)", hideHover: "auto"
            })
        }

        ,
        handleVisitorsDonutChart = function (e,color)
        {
            Morris.Donut({
                element: "visitors-donut-chart", data: e, colors: color, labelFamily: "inherit", labelColor: "rgba(255,255,255,0.4)", labelTextSize: "12px", backgroundColor: "#111"
            }
            )
        }

        ,

        handleScheduleCalendar = function ()
        {
            var e = ["January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"],
            t = ["S",
            "M",
            "T",
            "W",
            "T",
            "F",
            "S"],
            r = new Date,
            o = r.getMonth() + 1,
            i = r.getFullYear(),
            a = [["2/" + o + "/" + i,
            "Popover Title",
            "#",
            "#007aff",
            "Some contents here"],
            ["5/" + o + "/" + i,
            "Tooltip with link",
            "http://www.seantheme.com/color-admin-v1.3",
            "#222"],
            ["18/" + o + "/" + i,
            "Popover with HTML Content",
            "#",
            "#222",
            'Some contents here <div class="text-right"><a href="http://www.google.com">view more >>></a></div>'],
            ["28/" + o + "/" + i,
            "Color Admin V1.3 Launched",
            "http://www.seantheme.com/color-admin-v1.3",
            "#222"]],
            n = $("#schedule-calendar");
            $(n).calendar({
                months: e, days: t, events: a, popover_options:
                    {
                        placement: "top", html: !0
                    }
            }),
            $(n).find("td.event").each(function ()
            {
                var e = $(this).css("background-color");
                $(this).removeAttr("style"), $(this).find("a").css("background-color", e)
            }),
            $(n).find(".icon-arrow-left, .icon-arrow-right").parent().on("click", function ()
            {
                $(n).find("td.event").each(function ()
                {
                    var e = $(this).css("background-color");
                    $(this).removeAttr("style"), $(this).find("a").css("background-color", e)
                })
            })
        }




    </script>
