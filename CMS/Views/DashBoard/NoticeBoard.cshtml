                        <!-- Details Modal -->
                        <div class="modal fade" id="DetailsModal" data-backdrop="static">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <button type="button" class="close text-white" data-dismiss="modal" aria-hidden="true">×</button>
                                        <h4 class="modal-title"><i class="fa fa-info-circle"></i> Notice Content</h4>
                                    </div>
                                    <div class="modal-body" id="details-content" style="max-height: 500px; overflow-y: auto;">
                                        <!-- Content populated via JS -->
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>

<script>
    function ContentLoad() {
        loadGird();
        $('.datepicker').datepicker({ format: 'dd/mm/yyyy', autoclose: true, todayHighlight: true });
        $('#DESCRIPTION').summernote({
            height: 200,
            placeholder: 'Detailed announcement...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['fontname', ['fontname']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['height', ['height']],
                ['table', ['table']],
                ['insert', ['link', 'picture', 'hr']],
                ['view', ['fullscreen', 'codeview', 'help']]
            ]
        });
    }

    function loadGird() {
        var sClassYear = $('#FilterClassYear').val();
        var sAppType = $('#FilterAppType').val();
        var sShift = $('#FilterShift').val();

        $.ajax({
            url: "@Url.Action("BindNoticeBoardList", "DashBoard")",
            method: "POST",
            data: { sClassYear: sClassYear, sAppType: sAppType, sShift: sShift },
            success: function (data) {
                $('#bindtable').html(data);
            }
        });
    }

    $(document).ready(function () {
        $('.selectpicker').selectpicker('refresh');

        // Filter change trigger
        $(document).on('change', '#FilterClassYear, #FilterAppType, #FilterShift', function () {
            loadGird();
        });

        // Student roll logic
        $("#RoleId").change(function () {
            var selectedRoles = $(this).val();
            if (selectedRoles && selectedRoles.includes("5")) {
                $("#stuFilters").slideDown();
            } else {
                $("#stuFilters").slideUp();
            }
        });

        $('#btnSaveNotice').on('click', function () {
            var files = $('#FILE_NAME')[0].files[0];
            var existingFileName = $('#FileNameDisplay').val();

            var roleVal = $('#RoleId').val();
            var appTypeVal = $('#AppType').val();
            var classYearVal = $('#ClassYear').val();
            var shiftVal = $('#Shift').val();

            var roleString = roleVal ? (Array.isArray(roleVal) ? roleVal.join(',') : roleVal) : '';
            var appTypeString = appTypeVal ? (Array.isArray(appTypeVal) ? appTypeVal.join(',') : appTypeVal) : '';
            var classYearString = classYearVal ? (Array.isArray(classYearVal) ? classYearVal.join(',') : classYearVal) : '';
            var shiftString = shiftVal ? (Array.isArray(shiftVal) ? shiftVal.join(',') : shiftVal) : '';

            if (!$('#NOTICEBOARD').val()) {
                swal({ title: "Error!", text: "Please enter Title", type: 'error' });
                return false;
            }

            var sJsonData = {
                NOTICEBOARD_ID: $('#NOTICEBOARD_ID').val(),
                NOTICEBOARD: $('#NOTICEBOARD').val(),
                ROLE_ID: roleString,
                APPTYPE: appTypeString,
                CLASS_YEAR: classYearString,
                SHIFT: shiftString,
                LINK_UPLOAD: $('#LINK_UPLOAD').val(),
                FILE_NAME: existingFileName,
                IS_ACTIVE: $('#IS_ACTIVE_CHECKBOX').is(':checked') ? "1" : "0",
                IS_COMMENT_ENABLE: $('#IS_COMMENT_ENABLE').is(':checked') ? "1" : "0",
                IS_FILE_UPLOAD_ENABLE: $('#IS_FILE_UPLOAD_ENABLE').is(':checked') ? "1" : "0",
                DESCRIPTION: $('#DESCRIPTION').summernote('code'),
                FILE_TYPE: $('input[name="FILE_TYPE"]:checked').val(),
                DUE_DATE: $('#DUE_DATE').val()
            };

            var formData = new FormData();
            formData.append("sJsonvalue", JSON.stringify(sJsonData));
            if (files) formData.append("FILE_NAME", files);

            $.ajax({
                url: '@Url.Action("UpdateNoticeBoard", "DashBoard")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.ErrorCode == "202") {
                        swal({ title: "Success !", text: data.Message, type: 'success', timer: 1500 });
                        $('#InsertModal-dialog').modal('hide');
                        loadGird();
                    } else {
                        swal({ title: "Error!", text: data.Message, type: 'error' });
                    }
                },
                error: function (ex) {
                    swal({ title: "Error!", text: "Internal Server Error or Request Failed", type: 'error' });
                }
            });
        });
    });

    function toggleFileType(type) {
        if (type === 'LINK') {
            $('#LinkGroup').show();
            $('#FileGroup').hide();
        } else {
            $('#LinkGroup').hide();
            $('#FileGroup').show();
        }
    }

    function FetchMenuDetails(id) {
        $.ajax({
            url: "@Url.Action("FetchNoticeBoard", "DashBoard")",
            method: "POST",
            data: { sNoticeBoard_id: id },
            success: function (data) {
                $('#NOTICEBOARD_ID').val(data.NOTICEBOARD_ID);
                $('#NOTICEBOARD').val(data.NOTICEBOARD);
                $('#DESCRIPTION').summernote('code', data.DESCRIPTION);
                $('#DUE_DATE').val(data.DUE_DATE);
                $('#FileNameDisplay').val(data.FILE_NAME);
                $('#LINK_UPLOAD').val(data.LINK_UPLOAD);

                if (data.ROLE_ID) $('#RoleId').val(data.ROLE_ID.split(','));
                if (data.APPTYPE) $('#AppType').val(data.APPTYPE.split(','));
                if (data.CLASS_YEAR) $('#ClassYear').val(data.CLASS_YEAR.split(','));
                if (data.SHIFT) $('#Shift').val(data.SHIFT.split(','));

                $('#IS_ACTIVE_CHECKBOX').prop('checked', data.IS_ACTIVE == "1");
                $('#IS_COMMENT_ENABLE').prop('checked', data.IS_COMMENT_ENABLE == "1");
                $('#IS_FILE_UPLOAD_ENABLE').prop('checked', data.IS_FILE_UPLOAD_ENABLE == "1");

                if (data.ROLE_ID && data.ROLE_ID.includes("5")) $("#stuFilters").show();
                else $("#stuFilters").hide();

                if (data.FILE_TYPE) {
                    $('input[name="FILE_TYPE"][value="' + data.FILE_TYPE + '"]').prop('checked', true);
                    toggleFileType(data.FILE_TYPE);
                }

                // Explicitly refresh all selectpickers to ensure UI updates
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (err) {
                swal({ title: "Error!", text: "Failed to fetch notice details.", type: 'error' });
            }
        });
    }

    function GetConfirm(id) {
        swal({
            title: "Delete Notice?",
            text: "This action cannot be undone.",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: "Yes, delete it!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("DeleteNoticeBoard", "DashBoard")",
                method: "POST",
                data: { sNoticeBoard_id: id, sIsdelete: "1" },
                success: function (data) {
                    if (data.ErrorCode == "202") {
                        swal({ title: "Deleted!", text: data.Message, type: 'success', timer: 1500 });
                        loadGird();
                    } else {
                        swal({ title: "Error!", text: data.Message, type: 'error' });
                    }
                },
                error: function (xhr, status, error) {
                    swal({ title: "Error!", text: "Failed to delete notice. Please make sure it's not being used elsewhere.", type: 'error' });
                }
            });
        });
       
    }

    function showDetailsModal(id) {
        var desc = $('#desc-data-' + id).html();
        $('#details-content').html(desc);
        $('#DetailsModal').modal('show');
    }

    $('#InsertModal-dialog').on('hidden.bs.modal', function () {
        $('#NOTICEBOARD_ID').val('');
        $('#NOTICEBOARD').val('');
        $('#DESCRIPTION').val('');
        $('#DUE_DATE').val('');
        $('#FileNameDisplay').val('');
        $('#LINK_UPLOAD').val('');
        $('#RoleId, #AppType, #ClassYear, #Shift').val([]).selectpicker('refresh');
        $('#IS_ACTIVE_CHECKBOX').prop('checked', false);
        $('#IS_COMMENT_ENABLE').prop('checked', false);
        $('#IS_FILE_UPLOAD_ENABLE').prop('checked', false);
        $('#DESCRIPTION').summernote('code', '');
        $("#stuFilters").hide();
    });
</script>
