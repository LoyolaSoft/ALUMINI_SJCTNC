@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    ViewBag.Title = "Notice Board Management";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />

<style>
    .page-header-premium {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f0f3f5;
    }

    .premium-toolbar {
        background: #fff;
        padding: 15px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        margin-bottom: 30px;
    }

    .filter-group {
        display: flex;
        gap: 15px;
        align-items: flex-end;
    }

    .filter-item {
        flex: 1;
    }

        .filter-item label {
            font-weight: 700;
            text-transform: uppercase;
            color: #adb5bd;
            margin-bottom: 5px;
            display: block;
        }

    .btn-add-premium {
        background: #00acac;
        color: #fff;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: 8px;
        transition: 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-add-premium:hover {
            background: #008a8a;
            color: #fff;
            transform: translateY(-2px);
        }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .page-header-premium {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .premium-toolbar {
            padding: 15px;
        }

        .filter-group {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .btn-add-premium {
            width: 100%;
            justify-content: center;
        }

        .col-md-6.border-right {
            border-right: none;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
    }
</style>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">Notice board</li>
        </ol>
        <h1 class="page-header">Notice board</h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Notice board</h4>
            </div>
            <div class="panel-body">
                <div class="col-md-12">
                    <div class="" id="">
                        @Html.AntiForgeryToken()

                        <div class="page-header-premium">
                            <div>
                                <h1 class="page-header" style="margin: 0;">Notice Board <small>Management</small></h1>
                            </div>
                            <div>
                                <a href="#InsertModal-dialog" data-toggle="modal" id="btnAdd" class="btn-add-premium">
                                    <i class="fa fa-plus-circle"></i> ADD NEW NOTICE
                                </a>
                            </div>
                        </div>

                        <!-- Filters -->
                        @*<div class="premium-toolbar">
            <div class="filter-group">
                <div class="filter-item">
                    <label>Class Year</label>
                    @Html.DropDownList("FilterClassYear", (Model.ClassYear ?? Enumerable.Empty<SelectListItem>()), "All Year", new { @class = "selectpicker form-control", @data_live_search = "true", @id = "FilterClassYear" })
                </div>
                <div class="filter-item">
                    <label>Application Type</label>
                    @Html.DropDownList("FilterAppType", (Model.AppType ?? Enumerable.Empty<SelectListItem>()), "All AppType", new { @class = "selectpicker form-control", @data_live_search = "true", @id = "FilterAppType" })
                </div>
                <div class="filter-item">
                    <label>Shift</label>
                    @Html.DropDownList("FilterShift", (Model.Shift ?? Enumerable.Empty<SelectListItem>()), "All Shift", new { @class = "selectpicker form-control", @data_live_search = "true", @id = "FilterShift" })
                </div>
            </div>
        </div>*@

                        <!-- Data List -->
                        <div class="row">
                            <div id="bindtable">
                                <!-- Bound list content -->
                            </div>
                        </div>

                        <!-- Modal -->
                        <div class="modal fade" id="InsertModal-dialog" data-keyboard="false" data-backdrop="static">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-inverse text-white">
                                        <button type="button" class="close text-white" data-dismiss="modal" aria-hidden="true">×</button>
                                        <h4 class="modal-title">Notice Board Configuration</h4>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-horizontal">
                                            <input type="hidden" name="NOTICEBOARD_ID" id="NOTICEBOARD_ID" value="" />
                                            <div class="form-group">
                                                <label class="control-label col-md-3">Description</label>
                                                <div class="col-md-9">
                                                    <textarea id="DESCRIPTION" class="form-control" placeholder="Detailed announcement..." rows="5"></textarea>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 border-right">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3">Title</label>
                                                        <div class="col-md-9">
                                                            <input type="text" id="NOTICEBOARD" class="form-control" placeholder="Enter Notice Title" />
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3">Due Date</label>
                                                        <div class="col-md-9">
                                                            <input type="text" id="DUE_DATE" class="form-control datepicker" placeholder="dd/mm/yyyy" autocomplete="off" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-3">Target Roles</label>
                                                        <div class="col-md-9">
                                                            @Html.DropDownListFor(model => model.RoleId, (Model.RoleId ?? Enumerable.Empty<SelectListItem>()), new { @class = "selectpicker form-control", @data_live_search = "true", @data_actions_box = "true", @id = "RoleId", @multiple = "multiple" })
                                                        </div>
                                                    </div>

                                                    <div id="stuFilters" style="display:none; background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                                                        <p class="text-primary" style="font-weight: 700;  text-transform: uppercase;">Student Targeting</p>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3">App Type</label>
                                                            <div class="col-md-9">
                                                                @Html.DropDownListFor(model => model.AppType, (Model.AppType ?? Enumerable.Empty<SelectListItem>()), new { @class = "selectpicker form-control", @id = "AppType", @multiple = "multiple" })
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3">Year</label>
                                                            <div class="col-md-9">
                                                                @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear ?? Enumerable.Empty<SelectListItem>()), new { @class = "selectpicker form-control", @id = "ClassYear", @multiple = "multiple" })
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-3">Shift</label>
                                                            <div class="col-md-9">
                                                                @Html.DropDownListFor(model => model.Shift, (Model.Shift ?? Enumerable.Empty<SelectListItem>()), new { @class = "selectpicker form-control", @id = "Shift", @multiple = "multiple" })
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3">Attachment</label>
                                                        <div class="col-md-9">
                                                            <div class="radio-inline">
                                                                <label><input type="radio" name="FILE_TYPE" value="LINK" onclick="toggleFileType('LINK')" checked> Link</label>
                                                            </div>
                                                            <div class="radio-inline">
                                                                <label><input type="radio" name="FILE_TYPE" value="PDF" onclick="toggleFileType('PDF')"> PDF</label>
                                                            </div>

                                                            <div id="LinkGroup" class="m-t-10">
                                                                <input type="text" id="LINK_UPLOAD" name="LINK_UPLOAD" class="form-control" placeholder="https://..." />
                                                            </div>
                                                            <div id="FileGroup" class="m-t-10" style="display:none;">
                                                                <input type="file" id="FILE_NAME" name="FILE_NAME" class="form-control" />
                                                                <input type="text" id="FileNameDisplay" class="form-control m-t-5" readonly placeholder="No file selected" />
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3">Configuration</label>
                                                        <div class="col-md-9">
                                                            <div class="checkbox-inline">
                                                                <label><input type="checkbox" id="IS_ACTIVE_CHECKBOX" value="1"> Publish Notice</label>
                                                            </div>
                                                            <div class="checkbox-inline">
                                                                <label><input type="checkbox" id="IS_COMMENT_ENABLE" value="1"> Enable Comment</label>
                                                            </div>
                                                            <div class="checkbox-inline" style="margin-left: 0; display: block; margin-top: 10px;">
                                                                <label><input type="checkbox" id="IS_FILE_UPLOAD_ENABLE" value="1"> Enable File Upload</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                        <button type="button" id="btnSaveNotice" class="btn btn-primary" style="background:#00acac; border-color:#00acac;">Save Notice</button>
                                    </div>
