@model CMS.ViewModel.ViewModel.DashboardViewModel

<div class="table-responsive">
    <table class="premium-table">
        <thead>
            <tr>
                <th>#</th>
                <th>User Details</th>
                <th>Response</th>
                <th>Status</th>
                <th>Attachment</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liNoticeBoardLog != null && Model.liNoticeBoardLog.Count > 0)
            {
                int i = 0;
                foreach (var item in Model.liNoticeBoardLog)
                {
                    i++;
                    <tr>
                        <td>@i</td>
                        <td>
                            <div style="font-weight: 700; color: #1e293b;">@item.FIRST_NAME</div>
                            <div class="role-pill">@item.ROLE_NAME</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.COMMENTS))
                            {
                                <div style="font-size: 13px; color: #334155;">@item.COMMENTS</div>
                            }
                            else
                            {
                                <span style="color: #94a3b8; font-style: italic;">No comments</span>
                            }
                        </td>
                        <td>
                            @if (item.IS_ACCEPTED == "1")
                            {
                                <span class="badge badge-success">Accepted</span>
                            }
                            else if (item.IS_CANCELED == "1")
                            {
                                <span class="badge badge-danger">Declined</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.FILE_PATH))
                            {
                                <a href="@item.FILE_PATH" target="_blank" class="btn-xs btn-primary">
                                    <i class="fa fa-download"></i> View File
                                </a>
                            }
                            else
                            {
                                <span style="color: #94a3b8;">-</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center; padding: 20px; color: #94a3b8;">
                        No responses found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
