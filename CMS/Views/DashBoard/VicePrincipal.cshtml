    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h3 class="panel-title"><i class="fa fa-calendar"></i> Timetable</h3>
                </div>
                <div class="panel-body noPadding">
                    <div class="row myMargin" id="event">
                        <table class="table table-bordered text-center" id="TimeTableClassWiseList">
                            <thead>
                                <tr>
                                    <th></th>
                                    @if (Model.lstHours != null)
                                    {
                                        foreach (var dataitem in Model.lstHours)
                                        {
                                            <th><b> Hour- @dataitem.HOUR</b></th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.lstDayOrders != null)
                                {
                                    foreach (var dataitem in Model.lstDayOrders)
                                    {
                                        <tr>
                                            <td><b> Day- @dataitem.DAY</b></td>
                                            @foreach (var item in Model.lstHours)
                                            {
                                                if (Model.liTimetable != null && Model.liTimetable.Count > 0)
                                                {
                                                    var TimeTableList = Model.liTimetable.Where(s => s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                    var TimeTable = TimeTableList.Where(s => s.Hour_Id == item.HOUR_ID && s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                    if (TimeTable != null && TimeTable.Count > 0)
                                                    {
                                                        ttTimeTable = string.Join(",", TimeTable.Select(x => x.CLASS_CODE.ToString()).ToArray());
                                                        <td>
                                                            @{ CourseCode = "(" + @TimeTable.FirstOrDefault().COURSE_CODE + ")";}
                                                            @TimeTable.FirstOrDefault().hourType<br />
                                                            @{ CourseTitle = @TimeTable.FirstOrDefault().COURSE_TITLE; }
                                                            @CourseTitle - @CourseCode <br />
                                                            @ttTimeTable
                                                        </td>

                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>
                                    }

                                }
                                else
                                {
                                    <tr>
                                        <td><p>No records available !!!</p></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end Event -->
