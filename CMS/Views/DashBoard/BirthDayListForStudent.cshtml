@model CMS.ViewModel.ViewModel.DashboardViewModel
<div class="col-md-8">

    <div class="panel panel-inverse">
        <div class="panel-heading">
            <h4 class="panel-title">
                <i class="fa fa-birthday-cake"> Today Birth Day Celebraties </i><span class="label bg-blue pull-right">
                    Students - @if (Model.liStudentBirthDayList != null && Model.liStudentBirthDayList.Count > 0)
                    {@Model.liStudentBirthDayList.Count}
                </span>
            </h4>
        </div>
        <div class="panel-body">
            <marquee direction="up" onmouseover="stop();" onmouseout="start();">
                <div class="height-sm">
                    <ul class="media-list media-list-with-divider media-messaging">
                        @if (Model.liStudentBirthDayList != null && Model.liStudentBirthDayList.Count > 0)
                        {
                            foreach (var item in Model.liStudentBirthDayList)
                            {
                                <li class="media media-sm">
                                    <a href="javascript:;" class="pull-left">
                                        <img src="@item.PHOTO" alt="" class="media-object rounded-corner" />
                                    </a>
                                    <div class="media-body">
                                        <h5 class="media-heading"><b>@item.FIRST_NAME</b></h5>
                                        <p>
                                            Roll No : @item.ROLL_NO <br />
                                            Register No : @item.REGISTER_NO <br />
                                            Class : @item.CLASS_NAME <br />
                                        </p>
                                    </div>
                                </li>
                            }
                        }

                    </ul>
                </div>
            </marquee>
        </div>

    </div>

</div>
