@model CMS.ViewModel.ViewModel.DashboardViewModel

<div class="table-responsive">
    <table class="table table-striped table-bordered" id="data-table">
        <thead>
            <tr>
                <th width="5%">S.No</th>
                <th>Student Name / Reg No</th>
                <th width="10%">Viewed</th>
                <th>Response / Comments</th>
                <th width="10%">Attachment</th>
                <th width="15%">Responded Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liNoticeBoardLog != null && Model.liNoticeBoardLog.Count > 0)
            {
                int i = 0;
                foreach (var item in Model.liNoticeBoardLog)
                {
                    i++;
                    <tr>
                        <td>@i</td>
                        <td>
                            <div style="font-weight:bold;">@item.FIRST_NAME</div>
                        </td>
                        <td>
                            @if (item.IS_VIEWED == "1")
                            {
                                <span class="label label-success">Yes</span>
                            }
                            else
                            {
                                <span class="label label-danger">No</span>
                            }
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(item.COMMENTS) ? "-" : item.COMMENTS)
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.FILE_PATH))
                            {
                                <a href="@Url.Content(item.FILE_PATH)" target="_blank" class="btn btn-xs btn-primary">
                                    <i class="fa fa-download"></i> Download
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(item.CREATED_DATE) ? "-" : item.CREATED_DATE)
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No responses found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    if ($.fn.DataTable.isDataTable('#data-table')) {
        $('#data-table').DataTable().destroy();
    }
    $('#data-table').DataTable({
        responsive: true
    });
</script>
