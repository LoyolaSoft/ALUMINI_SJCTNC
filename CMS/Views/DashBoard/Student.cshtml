@model CMS.ViewModel.ViewModel.DashboardViewModel
@using CMS.Utility
@using CMS.ViewModel.ViewModel
@{
    ViewBag.Title = "Student";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    //Layout = null;
    string CourseCode = string.Empty;
    string ttTimeTable = string.Empty;
    string sDayOrder = string.Empty;
    int nCourses = 0;
    var sAcedemicYear = (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR] != null) ? Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR].ToString() : string.Empty;

    var sAcedemicYearPlusOne = Convert.ToInt64(sAcedemicYear) + 1;
}

<style>
    #ourmanna-verse {
        padding: 10px;
        margin: 10px;
        /*background: rgba(0, 0, 0, 0.3);
    border-color: rgba(0, 0, 0, 0.3);*/
        -webkit-border-radius: 5px;
        -moz-border-radius: 5px;
        border-radius: 5px;
    }

    #mannaverse {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    #mannaverse-reference:before {
        content: "- ";
    }

    #mannaverse-reference {
        text-align: right;
        font-size: 12px;
    }

    #mannaverse-version {
        color: #ddd;
    }
</style>



<link href="~/Content/assets/plugins/fullcalendar/fullcalendar.print.css" rel="stylesheet" media='print' />
<link href="~/Content/assets/plugins/fullcalendar/fullcalendar.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/morris/morris.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">StudentDashboard</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Dashboard</h1>
    <div class="row">
        <!-- begin col-3 -->
        <div class="col-lg-12">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="fa fa-inbo"></i></div>
                <div class="stats-info">
                    <h4>Word Of The Day</h4>
                    <p><div id="ourmanna-verse">Loading...</div></p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="fa fa-calendar"></i></div>
                <div class="stats-info">
                    <h4>Day Order</h4>
                    <p>
                        @if (!string.IsNullOrEmpty(Session[Common.SESSION_VARIABLES.DAY_ORDER].ToString()))
                        {
                            sDayOrder = Session[Common.SESSION_VARIABLES.DAY_ORDER].ToString();
                        }
                        else
                        {
                            sDayOrder = "0";
                        }
                        @sDayOrder
                    </p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-aqua">
                <div class="stats-icon"><i class="fa fa-qrcode"></i></div>
                <div class="stats-info">
                    <h4>Attendance Percentage</h4>
                    <p>
                        @*@{
                                var percentage =ViewBag.CurrentSemAttendancePercentage;
                            }
                            @percentage*@
                        0
                    </p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-purple">
                <div class="stats-icon"><i class="fa fa-tachometer"></i></div>
                <div class="stats-info">
                    <h4>Courses</h4>
                    <p>
                        @if (Model.liCourseDetails != null && Model.liCourseDetails.Count > 0)
                        {
                            nCourses = Model.liCourseDetails.Count;
                        }
                        @nCourses

                    </p>
                </div>
                <div class="stats-link">
                    <a href="#Course-dialog" data-toggle="modal">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-orange">
                <div class="stats-icon"><i class="ion-ios-clock"></i></div>
                <div class="stats-info">
                    <h4>Time</h4>
                    <p id="currenttime"></p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
    </div>
    <style>
        .lms-box {
            background: #fff;
            border-left: 6px solid #007bff;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            margin-bottom: 15px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 8px;
            transition: 0.3s ease;
        }

            .lms-box:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

            .lms-box .lms-info {
                flex-grow: 1;
            }

                .lms-box .lms-info h5 {
                    font-size: 18px;
                    margin: 0;
                    color: #333;
                }

                .lms-box .lms-info p {
                    margin: 5px 0 0;
                    font-size: 20px;
                    font-weight: bold;
                    color: #444;
                }

            .lms-box .lms-icon {
                font-size: 32px;
                color: #007bff;
                margin-right: 15px;
            }

            .lms-box .lms-action a {
                font-weight: 600;
                color: #007bff;
                text-decoration: none;
            }

        @@media (max-width: 576px) {
            .lms-box {
                flex-direction: column;
                align-items: flex-start;
            }

                .lms-box .lms-action {
                    margin-top: 10px;
                }
        }
    </style>

