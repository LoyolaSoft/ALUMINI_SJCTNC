                                    <table class="table table-bordered text-center" id="TimeTableClassWiseList">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                @if (Model.lstHours != null)
                                                {
                                                    foreach (var dataitem in Model.lstHours)
                                                    {
                                                        <th><b> Hour- @dataitem.HOUR</b></th>
                                                    }
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.lstDayOrders != null)
                                            {
                                                foreach (var dataitem in Model.lstDayOrders)
                                                {
                                                    <tr cms-timetableid="@dataitem.DAY_ORDER_ID">
                                                        <td><b> Day- @dataitem.DAY</b></td>
                                                        @foreach (var item in Model.lstHours)
                                                        {
                                                            if (Model.liTimetable != null && Model.liTimetable.Count > 0)
                                                            {
                                                                var TimeTableList = Model.liTimetable.Where(s => s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                                var TimeTable = TimeTableList.Where(s => s.Hour_Id == item.HOUR_ID).ToList();
                                                                if (TimeTable != null && TimeTable.Count > 0)
                                                                {

                                                                    ttTimeTable = TimeTable.FirstOrDefault().Time_Table_Id;
                                                                    if (TimeTable.Count > 1)
                                                                    {
                                                                        ttTimeTable = string.Join(",", TimeTable.Select(x => x.Time_Table_Id.ToString()).ToArray());

                                                                    }
                                                                    <td id="tdTimeTable">
                                                                        @foreach (var item1 in TimeTable)
                                                                        {
                                                                            @item1.COURSE_TITLE
                                                                            { CourseCode = "(" + @item1.COURSE_CODE + ")"; }
                                                                            if (CourseCode != "()")
                                                                            {
                                                                                @CourseCode <br />
                                                                                @item1.STAFF_CODE
                                                                            }
                                                                            <br>
                                                                        }

                                                                    </td>

                                                                }
                                                                else
                                                                {
                                                                    <td class="editable" cms-dayid="@dataitem.DAY_ORDER_ID" cms-hourid="@item.HOUR_ID"></td>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <td class="editable" cms-dayid="@dataitem.DAY_ORDER_ID" cms-hourid="@item.HOUR_ID"></td>
                                                            }
                                                        }
                                                    </tr>
                                                }

                                            }
                                            else
                                            {
                                                <tr>
                                                    <td><p>No records available !!!</p></td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
