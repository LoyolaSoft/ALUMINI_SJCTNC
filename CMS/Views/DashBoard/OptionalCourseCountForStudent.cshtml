@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    Layout = null;
    string nCourses = string.Empty;
}
<div class="col-md-3 col-sm-6">
    <div class="widget widget-stats bg-gradient-purple">
        <div class="stats-icon"><i class="fa fa-tachometer"></i></div>
        <div class="stats-info">
            <h4>Courses</h4>
            <p>
                @if (Model.liCourseDetails != null && Model.liCourseDetails.Count > 0)
                {
                    nCourses = Model.liCourseDetails.Count.ToString();
                }
                else
                {
                    nCourses = "0";
                }
                @nCourses

            </p>
        </div>
        <div class="stats-link">
            <a href="#Course-dialog" data-toggle="modal">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
        </div>
    </div>
    <div class="modal" id="Course-dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                    <h4 class="modal-title">List Course Details </h4>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal row">
                        <div class="col-md-12 table-responsive">
                            <table class="table table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <td>#</td>
                                        <td>Sem</td>
                                        <td>Course Code</td>
                                        <td>Course Title</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.liCourseDetails != null && Model.liCourseDetails.Count > 0)
                                    {
                                        int nCount = 0;
                                        foreach (var item in Model.liCourseDetails)
                                        {
                                            <tr>
                                                <td>@{nCount++;} @nCount</td>
                                                <td>@item.SEMESTER_NAME</td>
                                                <td>@item.COURSE_CODE</td>
                                                <td>@item.COURSE_TITLE</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            <br />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>
