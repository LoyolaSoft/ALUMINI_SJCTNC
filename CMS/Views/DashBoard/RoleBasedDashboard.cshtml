@model CMS.ViewModel.ViewModel.DashboardViewModel

@{
    ViewBag.Title = "RoleBasedDashboard";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
@*<link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />*@

<div class="content" id="content">

    @Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>

        <li class="active">Role Based Dashboard Menu </li>
    </ol>
    <h2 class="page-header">Role Based Dashboard Menu </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Role Based Dashboard Menu</h4>
        </div>
        <div class="panel-body">
            <div class="form-inline">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12 row">
                    <div class="form-group col-md-12">
                        <div class="col-md-4">
                            <label class="control-label col-md-3">Role</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.lirole, (Model.lirole != null) ? Model.lirole : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.lirole, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="col-md-4"></div>
                            <div class="col-md-8" id="submit">
                                <a href="#InsertModal-dialog" data-toggle="modal" class="btn btn-success pull-right">ADD</a>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
            <br /><br /><br />
            <div class="form-horizontal">
                <div class="col-lg-12 form-group">
                    <div id="bindtable" class="table-responsive">
                        <!--Need to use this fied to bind class course-->
                    </div>
                </div>
            </div>

        </div>

    </div>
    <div id="InsertModal-dialog" class="modal" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header ">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                    <h4 class="modal-title ">Menu Details</h4>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        <input type="hidden" name="STUDENT_ID" id="DASHBOARD_ID" value="" />
                        <div class="form-group">
                            <label class="control-label col-md-3">Role</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.lirole, (Model.lirole != null) ? Model.lirole : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlRole", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.lirole, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Menu List</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.liMenu, (Model.liMenu != null) ? Model.liMenu : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true", @multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.liMenu, "", new { @class = "text-danger" })
                            </div>
                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <span class="text-warning pull-left" id="txtStatic"></span>
                    <button type="submit" id="btnSubmit" class="btn btn-default" data-dismiss="modal">Submit</button>
                    <button type="submit" id="btnRemove" class="btn btn-default" data-dismiss="modal">Remove</button>
                </div>
            </div>
        </div>
    </div>


    <script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    @*<script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>*@
    <script>
        function ContentLoad() {
            // Document Ready Function
            //alert('hi');

        }
        $('.selectpicker').selectpicker('refresh');
        //$("#AcademicYearList,#ClassList").select2();


    </script>
    <script>
        $('#lirole').change(function () {

            loadGird();
      });

        function loadGird() {
            var vRoleId = $('#lirole').val();
        $.ajax({
            url: "@Url.Action("BindRoleBasedDashBoardMenu", "DashBoard")",
            method: "POST",
            datatype: "json",
            data: { sRoleId: vRoleId},
            success: function (data) {

                $('#bindtable').empty();
                $('#bindtable').append(data);

            }, error: function (error) {

                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
      }
        $('#btnSubmit').on('click', function () {
            debugger;
            var sJsonData;
            var vMenuList = String($('#liMenu').val());
            var vRoleId = $('#ddlRole').val();
            var sArray = vMenuList.split(',');
            sJsonData = '{"JsonMenuList":[';
            for (var i = 0; i < sArray.length; i++) {
                sJsonData += '{"sroleId":"' + vRoleId + '","sMenuId":"' + sArray[i] + '"},';
            }
            sJsonData = sJsonData.slice(0, -1); sJsonData += ']}';
            console.log(sJsonData);
            $.ajax({
                url: '@Url.Action("InsertRoleBasedDashBoardMenu", "DashBoard")',
                method: 'POST',
                datatype: 'json',
                data: { sJsonvalue: sJsonData },
                success: function (data) {
                    $('.modal-backdrop').remove();
                    if (data.ErrorCode == "202") {

                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadGird();
                    }
                    else {

                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        });




    function GetConfirm(ID,IsActive)
    {
        swal({
            title: "Confirmation",
            text: "Are you sure Active/Deactice ?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
         function () {
             $.ajax({
                 url: "@Url.Action("ActiveDeActiveDashBoardMenu", "Dashboard")",
                 method: "POST",
                 datatype: "json",
                 data: { sUserRole_id: ID, sActive: IsActive },
                 success: function (data) {
                     if (data.ErrorCode != "202") {
                         swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                         loadGird();

                     }
                     else {
                         swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                     }
                 }, error: function (error) {
                     alert('Internal Server Error ! ');
                 }
             });
         });
    }


    </script>
    <script>
        //$('#InsertModal-dialog').modal({
        //    backdrop: 'static',
        //    keyboard: false
        //});
        $('#InsertModal-dialog').on('hidden.bs.modal', function () {
            $('#lirole').val('');
            $('#liMenu').val('');
        });
    </script>
