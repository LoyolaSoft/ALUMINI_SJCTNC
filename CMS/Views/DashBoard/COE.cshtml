
@model CMS.ViewModel.ViewModel.DashboardViewModel
@using CMS.Utility
@{
    ViewBag.Title = "COE";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    //Layout = null;
}
@section Styles{
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/morris/morris.css" rel="stylesheet" />
}

<style>
    #ourmanna-verse {
        padding: 10px;
        margin: 10px;
        /*background: rgba(0, 0, 0, 0.3);
    border-color: rgba(0, 0, 0, 0.3);*/
        -webkit-border-radius: 5px;
        -moz-border-radius: 5px;
        border-radius: 5px;
    }

    #mannaverse {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    #mannaverse-reference:before {
        content: "- ";
    }

    #mannaverse-reference {
        text-align: right;
        font-size: 12px;
    }

    #mannaverse-version {
        color: #ddd;
    }
</style>
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">COE DashBoard</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">COE DashBoard</h1>
    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6 col-lg-12">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="fa fa-inbo"></i></div>
                <div class="stats-info">
                    <h4>Word Of The Day</h4>
                    @*<p><marquee onmouseover="stop();" onmouseout="start();"> My grace is sufficient for you, for my power is made perfect in weakness. 2 Corinthians 12:9 .</marquee></p>*@
                    <p><div id="ourmanna-verse">Loading...</div></p>
                </div>
                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
    </div>
    @if (Model.liappdownload != null)
    {

    }
    else
    {
        Html.RenderPartial("AppDownloaded");
    }
    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="ion-ios-world"></i></div>
                <div class="stats-info">
                    <h4>Day Order</h4>
                    @if (Session[Common.SESSION_VARIABLES.DAY_ORDER] != null)
                    {
                        <p>@Session[Common.SESSION_VARIABLES.DAY_ORDER].ToString()</p>
                    }
                    else
                    {
                        if (@Session[Common.SESSION_VARIABLES.IS_HOLIDAY].ToString() == "1")
                        {
                            <p>Holiday</p>
                        }
                        else
                        {
                            <p> 0 </p>
                        }
                    }

                </div>

                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-aqua">
                <div class="stats-icon"><i class="ion-ios-upload"></i></div>
                <div class="stats-info">
                    <h4>TOTAL STUDENTS</h4>
                    <p>5745</p>
                </div>
                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-purple">
                <div class="stats-icon"><i class="ion-ios-pie"></i></div>
                <div class="stats-info">
                    <h4>TOTAL STAFF</h4>
                    <p>231</p>
                </div>
                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-orange">
                <div class="stats-icon"><i class="ion-ios-clock"></i></div>
                <div class="stats-info">
                    <h4>TIME</h4>
                    <p id="currenttime"></p>
                </div>
                @*<div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>*@
            </div>
        </div>
    </div>
    <!-- end row -->

    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-sm-12">
                    <div class="panel ">
                        <div class="panel-heading">
                            <div class="panel-heading-btn">
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                            </div>
                            <h3 class="panel-title"><i class="fa fa-inbox"></i>Examination Report</h3>
                        </div>
                        <div class="panel-body noPadding">
                            <div class="col-md-12">

                                <div class="" id="chartdiv">


                                </div>
                                <br>
                                <br>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-8">
            <div class="row">
                <div class="col-sm-12">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <div class="panel-heading-btn">
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                            </div>
                            <h3 class="panel-title"><i class="fa fa-flag"></i> Events</h3>
                        </div>
                        <div class="panel-body noPadding">
                            <div class="row myMargin" id="event">
                                <marquee direction="up" scrolldelay="150" onmouseover="stop();" onmouseout="start();">
                                    <div class="height-sm">
                                        @if (Model.liCalenderEvents != null && Model.liCalenderEvents.Count > 0)
                                        {
                                            <ul class="media-list media-list-with-divider media-messaging">
                                                @foreach (var item in Model.liCalenderEvents)
                                                {
                                                    <li class="media media-sm">
                                                        <a href="javascript:;" class="pull-left">
                                                            <img src="" alt="" class="media-object rounded-corner" />
                                                        </a>
                                                        <div class="media-body">
                                                            <h5 class="media-heading"><b>@item.EVENT_START_DATE</b> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@item.EVENT_NAME</h5>

                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </marquee>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="panel panel-inverse">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Calendar</h4>
                </div>
                <div class="panel-body">
                    <div class="height-sm">
                        <div id="datepicker-inline" class="datepicker-full-width"><div></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts{
    <script src="~/Content/assets/plugins/morris/raphael.min.js"></script>
    <script src="~/Content/assets/plugins/morris/morris.js"></script>
    <script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap-world-merc-en.js"></script>
    <script src="~/Content/assets/plugins/fullcalendar/lib/moment.min.js"></script>
    <script src="~/Content/assets/plugins/fullcalendar/fullcalendar.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/js/calendar.demo.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/js/dashboard.min.js"></script>
    <script type="text/javascript" src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>
    <script src="http://www.ourmanna.com/verses/api/js/" type="text/javascript"></script>
    <script>
        $(document).ready(function () {
            //   Dashboard.init();
            handleDashboardDatepicker = function () {
                "use strict";
                $("#datepicker-inline").datepicker({
                    todayHighlight: !0
                }
                )
            }
            handleDashboardDatepicker();
            Chart();
        });
        function Chart()
        {
            var JsonData='[';
            var chartvalue = @Html.Raw(Json.Encode(ViewBag.lichartdata));
            if(chartvalue!=null)
            {

                for(var i = 0; i< chartvalue.length; i++)
                {
                    JsonData += '{"x":"'+ chartvalue[i].SEMSTER_NAME + '","a":"'+chartvalue[i].TOTAL_REGISTER+'","b":"'+chartvalue[i].PASSED+'"},';
                }

                JsonData = JsonData.slice(0, -1);
                JsonData += ']';
                var obj = JSON.parse(JsonData);

                Morris.Bar({
                    element:'chartdiv',
                    data:obj,
                    xkey: 'x',
                    ykeys: ['a','b'],
                    labels: ['Total Register', 'Passed'],
                    barColors: ["#1531B2", "#82302a", "#1AB244", "#B29215"],
                });
            }
            
        }


        var refreshTimerId;
        function startTimer() {
            refreshTimerId = setInterval(function () {
                if (document.getElementById("currenttime")) {
                    document.getElementById("currenttime").innerHTML = new Date().toLocaleTimeString();
                }
            }, 1000);
        }
        startTimer();
    </script>
}







