@model CMS.ViewModel.ViewModel.DashboardViewModel

@{

    Layout = null;
}

<div class="col-md-8">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel ">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h3 class="panel-title"><i class="fa fa-inbox"></i>PassPerCentage Report</h3>
                </div>
                <div class="panel-body noPadding">
                    <div class="col-md-12 table-responsive height-lg">
                        <div class="col-md-12">
                            <div class="col-md-4">

                            </div>

                            <div class="col-md-4 text-center" style="width:350px;">
                                <div class="d-flex flex-wrap">
                                    @*<button type="button" class="btn btn-success me-1 mb-1" onclick="changeToBar('line')">Line</button>
                                        <button type="button" class="btn btn-danger me-1 mb-1" onclick="changeToBar('bar')">Bar</button>
                                        <button type="button" id="chartpie" class="btn btn-primary me-1 mb-1" onclick="changeToBar('pie')">Pie</button>
                                        <button type="button" class="btn btn-info me-1 mb-1" onclick="changeToBar('doughnut')">Doughnut</button>*@
                                </div>

                            </div>
                            <div class="col-md-4">

                            </div>
                        </div>
                        <div class="" id="chartsdiv">
                            <canvas id="myChart"></canvas>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>


</script>

<script>



    var semster =@Html.Raw(Json.Encode(ViewBag.lisem));
    var marks = @Html.Raw(Json.Encode(ViewBag.lisemester));

        var Classes =@Html.Raw(Json.Encode(ViewBag.liclass));
    var ChartType = 'line';

    function changeToBar(e) {
        var randomColor;        config.type = e;
        if (e == 'pie') {
            for (var i = 0; i < Classes.length; i++) {
                randomColor = getMultipleRandom(arrColors, Classes.length)
                config.data.datasets[0].backgroundColor = randomColor;
                config.data.datasets[0].borderColor = randomColor;
            }
        }
        else if (e == 'doughnut') {
            for (var i = 0; i < Classes.length; i++) {
                randomColor = getMultipleRandom(arrColors, Classes.length)
                config.data.datasets[0].backgroundColor = randomColor;
                config.data.datasets[0].borderColor = randomColor;
            }
        }
        else {
             randomColor = getMultipleRandom(arrColors, 1)
            config.data.datasets[0].backgroundColor = randomColor;
            config.data.datasets[0].borderColor = randomColor;
        }
        myChart.update();
    }
    function getMultipleRandom(arr, num) {
        const shuffled = [...arr].sort(() => 0.5 - Math.random());

        return shuffled.slice(0, num);
    }
    var classyear = [];
        var classyear_name = [];
        var SemesterName = [];
        var percentdata = []
        var JsonData = '[';


    var arrColors = ['#D32F2F', '#AD1457', '#6A1B9A', '#512DA8', '#303F9F', '#1976D2', '#0288D1', '#0097A7', '#00796B', '#388E3C', '#AFB42B', '#FFA000', '#616161','#455A64'];
    if (marks != null && semster != null && Classes != null) {
        for (var p = 0; p < Classes.length; p++) {
            classyear.push(Classes[p].CLASS_YEAR);
            }
        for (var p = 0; p < Classes.length; p++) {
            classyear_name.push("CLASSYEAR-" + Classes[p].CLASS_YEAR);
            }
            for (var p = 0; p < semster.length; p++) {
                SemesterName.push("Semester-" + semster[p].SEMESTER_NAME);
            }


                JsonData += '{"label":"Pass Percentage",';
                var backgroundcolor = '';
                percentdata = [];


                var random = Math.floor(Math.random() * arrColors.length);
                JsonData += '"backgroundColor":';
                console.log(ChartType);
                if(ChartType== 'pie') {
                    console.log('if inside ');
                    JsonData += '[' + getMultipleRandom(arrColors,4)+']'
                }
                else {
                    JsonData += '"' + arrColors[random] + '"'
                }
                JsonData += ',"borderColor":"' + arrColors[random] + '", "data":';
                for (var j = 0; j < Classes.length; j++) {

                    for (var k = 0; k < marks.length; k++) {
                        if (marks[k].CLASS_YEAR == Classes[j].CLASS_YEAR ) {
                            percentdata.push(marks[k].TOTAL);
                        }
                    }

                }
                JsonData += '[' + percentdata + '],'
                JsonData = JsonData.slice(0, -1);
                JsonData += '},';


            JsonData = JsonData.slice(0, -1);
            JsonData += ']';
            //alert(JsonData);
            var obj = JSON.parse(JsonData);
            //console.log(obj);
        }
        var data = {
            labels: classyear_name,
            datasets: obj
        };
        var config = {
            type: ChartType,
            data: data,
            options: {}
        };
    var myChart = new Chart(
        document.getElementById('myChart'),
            config
        );


</script>