@model CMS.ViewModel.ViewModel.DashboardViewModel
@{
    Layout = null;
    int count = 0;
}
<div class="col-md-12">
    <table class="table table-bordered table-responsive">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Role Name</th>
                <th>Menu Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liDashBoardModel != null && Model.liDashBoardModel.Count > 0)
            {
                foreach (var item in Model.liDashBoardModel)
                {
                    <tr id="@item.USER_ROLE_ID">
                        <td>@{count++;}@count</td>
                        <td>@item.ROLE_NAME</td>
                        <td>@item.SHORT_NAME</td>
                        @if (item.IS_ACTIVE == "1")
                        {
                            <td>
                                <a class="text-success" onclick="GetConfirmRoleMenu('@item.USER_ROLE_ID',0)" title="Click To Active"><i class="fa fa-check"></i></a>
                            </td>
                        }
                        else
                        {
                            <td>
                                <a class="text-danger" onclick="GetConfirmRoleMenu('@item.USER_ROLE_ID',1)" title="Click To DeActive"><i class="fa fa-times"></i></a>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4">No Record Found..!</td></tr>
            }
        </tbody>
    </table>
</div>
