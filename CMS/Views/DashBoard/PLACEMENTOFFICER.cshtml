                                                @foreach (var item in Model.liCalenderEvents)
                                                {
                                                    <li class="media media-sm">
                                                        <a href="javascript:;" class="pull-left">
                                                            <img src="" alt="" class="media-object rounded-corner" />
                                                        </a>
                                                        <div class="media-body">
