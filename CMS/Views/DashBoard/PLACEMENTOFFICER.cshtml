        <div class="col-sm-4">
            <div class="panel panel-inverse">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Calendar</h4>
                </div>
                <div class="panel-body">
                    <div class="height-sm">
                        <div id="datepicker-inline" class="datepicker-full-width"><div></div></div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
@section scripts{
    <script src="~/Content/assets/plugins/morris/raphael.min.js"></script>
    <script src="~/Content/assets/plugins/morris/morris.js"></script>
    <script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/Content/assets/plugins/jquery-jvectormap/jquery-jvectormap-world-merc-en.js"></script>
    <script src="~/Content/assets/plugins/fullcalendar/fullcalendar.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/js/calendar.demo.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/js/dashboard.min.js"></script>
    <script type="text/javascript" src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>
    @*<script src="http://www.ourmanna.com/verses/api/js/" type="text/javascript"></script>*@
    <script>

        $(document).ready(function () {
            //   Dashboard.init();
            Chart();
            handleDashboardDatepicker = function () {
                "use strict";
                $("#datepicker-inline").datepicker({
                    todayHighlight: !0
                }
                )
            }
            handleDashboardDatepicker();
        });

        var refreshTimerId;

        function startTimer() {
            refreshTimerId = setInterval(function () {
                if (document.getElementById("currenttime")) {
                    document.getElementById("currenttime").innerHTML = new Date().toLocaleTimeString();
                }
            }, 1000);
        }
        startTimer();

        function synch()
        {
            $('#page-loader').removeClass('fade in hide');
            $('#page-loader').addClass('fade in ');
            $.ajax({
                url: '@Url.Action("UpdateSettlements", "fee")',
                method: 'POST',
                datatype: 'json',
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {

                        $('#page-loader').removeClass('fade in ');
                        $('#page-loader').addClass('fade in hide');
                        alert(data.Message);
                    }
                }, error: function (error)
                {

                    $('#page-loader').removeClass('fade in ');
                    $('#page-loader').addClass('fade in hide');
                    alert('Internal Server Error !');
                }
            });
        }
        function Chart()
        {

            var JsonData='[';
            var collection = @Html.Raw(Json.Encode(ViewBag.FeeCollection));
            if(collection!=null)
            {
                for(var i = 0; i< collection.length; i++)
                {
                    JsonData += '{"x":"'+ collection[i].PAYMENT_DATE + '","a":"'+collection[i].COLLECTED+'"},';
                }

                JsonData = JsonData.slice(0, -1);
                JsonData += ']';
                var obj = JSON.parse(JsonData);
                var arrColors = ['#007aff', '#ef0117',  '#4caf50', '#a550dd','#673ab7','#ef0117'];

                Morris.Area({
                    element:'chartdiv',
                    data: obj,

                    xkey: 'x',
                    // gridTextSize: 10,
                    ykeys: ['a'],
                    parseTime: false,
                    hideHover: 'auto',
                    behaveLikeLine: true,
                    lineWidth: '2px',
                    labels:['Amount'],
                    lineColors:["#4287f5"],
                    //pointFillColors: ['#87d688']






                });
            }
        }


    </script>
}

