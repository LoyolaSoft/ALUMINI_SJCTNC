                                <center><h4>Fees Settlementwise Collection</h4></center>
                                <div class="" id="chartdiv" data-colors="#0079fd,#41c94f,#1ab394">


                                </div>
                                <br>
                                <br>

                            </div>

                        </div>
                    </div>
