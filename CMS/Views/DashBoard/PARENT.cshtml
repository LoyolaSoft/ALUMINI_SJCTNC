                        $('#dayOrderDate').attr('value', calEvent.start.format('DD/MM/YYYY'));
                        $('#dayOrderEndDate').attr('value', calEvent.end.format('DD/MM/YYYY'));
                        $('#dayId').attr('value', calEvent.id);

                        $('#cbxIsHoliday').removeAttr("checked");

                        $('#ddlDayOrderList option[value=' + calEvent.dayorderid + ']').attr('selected', 'selected');
