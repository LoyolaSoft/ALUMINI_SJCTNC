
@model CMS.ViewModel.ViewModel.DashboardViewModel
@using CMS.Utility
@{
    ViewBag.Title = "Secretaory";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    //Layout = null;
}

<style>
    #ourmanna-verse {
        padding: 10px;
        margin: 10px;
        /*background: rgba(0, 0, 0, 0.3);
    border-color: rgba(0, 0, 0, 0.3);*/
        -webkit-border-radius: 5px;
        -moz-border-radius: 5px;
        border-radius: 5px;
    }

    #mannaverse {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    #mannaverse-reference:before {
        content: "- ";
    }

    #mannaverse-reference {
        text-align: right;
        font-size: 12px;
    }

    #mannaverse-version {
        color: #ddd;
    }
</style>


@{string CourseCode = string.Empty; string CourseTitle = string.Empty; string ttTimeTable = string.Empty;}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">SecretaryDashboard</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Secretary Dashboard</h1>
    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6 col-lg-12">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="fa fa-inbo"></i></div>
                <div class="stats-info">
                    <h4>Word Of The Day</h4>
                    @*<p><marquee onmouseover="stop();" onmouseout="start();"> My grace is sufficient for you, for my power is made perfect in weakness. 2 Corinthians 12:9 .</marquee></p>*@
                    <p><div id="ourmanna-verse">Loading...</div></p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
    </div>
    @*@if (Model.liappdownload != null)
    {

    }
    else
    {
        Html.RenderPartial("AppDownloaded");
    }*@

    <div class="row">
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-blue">
                <div class="stats-icon"><i class="ion-ios-world"></i></div>
                <div class="stats-info">
                    <h4>Day Order</h4>
                    @if (@Session[Common.SESSION_VARIABLES.DAY_ORDER].ToString() != null && @Session[Common.SESSION_VARIABLES.DAY_ORDER].ToString() != "")
                    {
                        <p>@Session[Common.SESSION_VARIABLES.DAY_ORDER].ToString()</p>
                    }
                    else
                    {
                        if (@Session[Common.SESSION_VARIABLES.IS_HOLIDAY].ToString() == "1")
                        {
                            <p>Holiday</p>
                        }
                        else
                        {
                            <p>0</p>
                        }
                    }

                </div>

                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-aqua">
                <div class="stats-icon"><i class="ion-ios-upload"></i></div>
                <div class="stats-info">
                    <h4>Assignments</h4>
                    <p>@ViewBag.TotalAssignment</p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-purple">
                <div class="stats-icon"><i class="ion-ios-pie"></i></div>
                <div class="stats-info">
                    <h4>TOTAL STAFF</h4>
                    <p>@ViewBag.TotalStaff</p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
        <!-- begin col-3 -->
        <div class="col-md-3 col-sm-6">
            <div class="widget widget-stats bg-gradient-orange">
                <div class="stats-icon"><i class="ion-ios-clock"></i></div>
                <div class="stats-info">
                    <h4>TIME TABLE</h4>
                    <p>00:12:23</p>
                </div>
                <div class="stats-link">
                    <a href="javascript:;">View Detail <i class="fa fa-arrow-circle-o-right"></i></a>
                </div>
            </div>
        </div>
        <!-- end col-3 -->
    </div>
    <!-- end row -->
    <!-- begin row -->
    <div class="row">
        <div class="col-md-8">
            <div class="row">
                <div class="col-sm-12">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <div class="panel-heading-btn">
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                            </div>
                            <h3 class="panel-title"><i class="fa fa-flag"></i> Events</h3>
                        </div>
                        <div class="panel-body noPadding">
                            <div class="row myMargin" id="event">
                                <marquee direction="up" scrolldelay="150" onmouseover="stop();" onmouseout="start();">
                                    <div class="height-sm" @*data-scrollbar="true"*@>
                                        @if (Model.liCalenderEvents != null && Model.liCalenderEvents.Count > 0)
                                        {
                                            <ul class="media-list media-list-with-divider media-messaging">
                                                @foreach (var item in Model.liCalenderEvents)
                                                {
                                                    <li class="media media-sm">
                                                        <a href="javascript:;" class="pull-left">
                                                            <img src="" alt="" class="media-object rounded-corner" />
                                                        </a>
                                                        <div class="media-body">
                                                            <h5 class="media-heading"><b>@item.EVENT_START_DATE</b></h5>
                                                            <p>
                                                                @item.EVENT_NAME
                                                            </p>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </marquee>



                                @*<div class="alert bg-pink alert-dismissible">
                                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                                    No Data Found.

                                    <div id="chartContainer1"></div>

                                </div>*@
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- begin col-4 -->
        <div class="col-md-4">
            <div class="panel panel-inverse">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Calendar</h4>
                </div>
                <div class="panel-body">
                    <div id="datepicker-inline" class="datepicker-full-width"><div></div></div>
                </div>
            </div>
        </div>
        <!-- end col-4 -->
    </div>

    <!-- Substitute Hour -->

    @if (Model.liSubstituteList != null && Model.liSubstituteList.Count > 0)
    {
        var liGroup = Model.liSubstituteList.GroupBy(x => x.SHIFT).ToList();
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <div class="panel-heading-btn">
                            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                        </div>
                        <h3 class="panel-title"><i class="fa fa-calendar"></i> Substitute Hours</h3>
                    </div>
                    <div class="panel-body noPadding">
                        <div class="row myMargin table-responsive" id="event">
                            @foreach (var item in liGroup)
                            {
                                <div class="col-md-12"> Shift - @item.FirstOrDefault().SHIFT</div>
                                <table class="table table-bordered text-center" id="TimeTableClassWiseList">
                                    <thead>
                                        <tr>
                                            @if (Model.lstHours != null && Model.lstHours.Count > 0)
                                            {
                                                foreach (var dataitem in Model.lstHours)
                                                {
                                                    <th><b> Hour- @dataitem.HOUR</b></th>
                                                }
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.lstHours != null && Model.lstHours.Count > 0)
                                        {
                                            var liSubstitute = Model.liSubstituteList.Where(x => x.SHIFT == item.FirstOrDefault().SHIFT).GroupBy(x => x.STAFF_ID).ToList();
                                            if (liSubstitute != null && liSubstitute.Count > 0)
                                            {
                                                foreach (var Substituteitem in liSubstitute)
                                                {
                                                    <tr>
                                                        @{
                                                            foreach (var Houritem in Model.lstHours)
                                                            {
                                                                <td>
                                                                    @{var liHour = Model.liSubstituteList.Where(x => x.HOUR_ID == Houritem.HOUR_ID && x.STAFF_ID == Substituteitem.FirstOrDefault().STAFF_ID && x.SHIFT == Substituteitem.FirstOrDefault().SHIFT).ToList();
                                                                        if (liHour != null && liHour.Count > 0)
                                                                        {
                                                                            foreach (var sHouritem in liHour)
                                                                            {

                                                                                @sHouritem.DAY_ORDER_DATE<br />
                                                                                @sHouritem.HOUR_TYPE<br />
                                                                                @sHouritem.CLASS_CODE<br />
                                                                                @sHouritem.STAFF_NAME<br />
                                                                                <hr />
                                                                                <br />
                                                                            }
                                                                        }
                                                                    }
                                                                </td>
                                                            }
                                                        }
                                                    </tr>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td><p>No records available !!!</p></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Substitute Hour -->
    <!-- Begin Event -->
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h3 class="panel-title"><i class="fa fa-calendar"></i> Timetable</h3>
                </div>
                <div class="panel-body noPadding">
                    <div class="row myMargin" id="event">
                        <table class="table table-bordered text-center" id="TimeTableClassWiseList">
                            <thead>
                                <tr>
                                    <th></th>
                                    @if (Model.lstHours != null)
                                    {
                                        foreach (var dataitem in Model.lstHours)
                                        {
                                            <th><b> Hour- @dataitem.HOUR</b></th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.lstDayOrders != null)
                                {
                                    foreach (var dataitem in Model.lstDayOrders)
                                    {
                                        <tr>
                                            <td><b> Day- @dataitem.DAY</b></td>
                                            @foreach (var item in Model.lstHours)
                                            {
                                                if (Model.liTimetable != null && Model.liTimetable.Count > 0)
                                                {
                                                    var TimeTableList = Model.liTimetable.Where(s => s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                    var TimeTable = TimeTableList.Where(s => s.Hour_Id == item.HOUR_ID && s.Day_Order_Id == dataitem.DAY_ORDER_ID).ToList();
                                                    if (TimeTable != null && TimeTable.Count > 0)
                                                    {
                                                        ttTimeTable = string.Join(",", TimeTable.Select(x => x.CLASS_CODE.ToString()).ToArray());
                                                        <td>
                                                            @{ CourseCode = "(" + @TimeTable.FirstOrDefault().COURSE_CODE + ")";}
                                                            @TimeTable.FirstOrDefault().hourType<br />
                                                            @{ CourseTitle = @TimeTable.FirstOrDefault().COURSE_TITLE; }
                                                            @CourseTitle - @CourseCode <br />
                                                            @ttTimeTable
                                                        </td>

                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>
                                    }

                                }
                                else
                                {
                                    <tr>
                                        <td><p>No records available !!!</p></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end Event -->
    
</div>

@section scripts{
    <script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/js/dashboard.min.js"></script>
    <script src="http://www.ourmanna.com/verses/api/js/" type="text/javascript"></script>
    <script>
        $(document).ready(function () {
            //   Dashboard.init();

            handleDashboardDatepicker = function () {
                "use strict";
                $("#datepicker-inline").datepicker({
                    todayHighlight: !0
                }
                )
            }
            handleDashboardDatepicker();
        });
    </script>
}

