@model CMS.ViewModel.ViewModel.DashboardViewModel
<div class="col-md-4">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel ">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h3 class="panel-title"><i class="fa fa-inbox"></i>College Topper</h3>
                </div>
                <div class="panel-body noPadding">
                    <div class="col-md-12 table-responsive">
                        <div class="col-md-12">
                            <marquee direction="up" onmouseover="stop();" onmouseout="start();">
                                <div class="height-lg">
                                    <ul class="media-list media-list-with-divider media-messaging">
                                        @if ( Model.liStudent != null && Model.liStudent.Count > 0 )
                                        {
                                            var groupedprogramme = Model.liStudent.GroupBy(o => o.PROGRAMME_GROUP_ID);
                                            foreach (var prog in groupedprogramme)
                                            {
                                                var classList = Model.liStudent.Where(o => o.PROGRAMME_GROUP_ID == prog.FirstOrDefault().PROGRAMME_GROUP_ID).GroupBy(x => x.CLASS_ID);
                                                foreach (var classitem in classList)
                                                {
                                                    var studentList = Model.liStudent.Where(x => x.PROGRAMME_GROUP_ID == prog.FirstOrDefault().PROGRAMME_GROUP_ID && x.CLASS_ID == classitem.FirstOrDefault().CLASS_ID).OrderByDescending(o => o.TOTAL).ToList();
                                                    if (studentList.Count > 0 && studentList != null)
                                                    {
                                                        foreach (var item in studentList.Take(1))
                                                        {
                                                            <li class="media media-sm">
                                                                <a href="javascript:;" class="pull-left">
                                                                    <img src="@item.PHOTO" alt="" class="media-object rounded-corner" />
                                                                </a>
                                                                <div class="media-body">
                                                                    <h5 class="media-heading"><b>@item.FIRST_NAME</b></h5>
                                                                    <p>
                                                                        Roll No : @item.ROLL_NO <br />
                                                                        Register No : @item.REGISTER_NO <br />
                                                                        Class : @item.CLASS_NAME <br />
                                                                    </p>
                                                                </div>
                                                            </li>
                                                        }
                                                    }
                                                }

                                            }
                                        }
                                    </ul>
                                </div>
                            </marquee>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
