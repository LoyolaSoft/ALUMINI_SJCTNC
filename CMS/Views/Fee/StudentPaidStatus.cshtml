@model CMS.ViewModel.ViewModel.FeeTransactionViewModel

@{
    ViewBag.Title = "StudentPaidStatus";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Student Fee Paid Status</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Fee Paid Status</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Fee Paid Status</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.liFrequencyType, "Frequency", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.liFrequencyType, (Model.liFrequencyType != null) ? Model.liFrequencyType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liFrequencyType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.liShift, "Shift", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.liShift, (Model.liShift != null) ? Model.liShift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liShift, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.liProgrammeModeList, "ProgrammeMode", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.liProgrammeModeList, (Model.liProgrammeModeList != null) ? Model.liProgrammeModeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liProgrammeModeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.liProgrammeGroup, "Programme", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.liProgrammeGroup, (Model.liProgrammeGroup != null) ? Model.liProgrammeGroup : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true",multiple="multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.liProgrammeGroup, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.liClassList, "Class", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.liClassList, (Model.liClassList != null) ? Model.liClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", multiple = "multiple" , @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.liClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <a class="btn btn-primary" title="click to get Status" id="btnGetCollegePaidStatus">Get</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="divClassWiseStudentPaidStatus"></div>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script>
    $('.selectpicker').selectpicker({
        size: 4
    });
    function ContentLoad() {

    }
    $("#liShift").on("change", function () {
        LoadProgramme();
    });
    $("#liProgrammeModeList").on("change", function () {
        LoadProgramme();
    });
    LoadProgramme = function () {
        var ShiftList = $('#liShift').val();
        var ProgrammeModeList = $('#liProgrammeModeList').val();
        if (ShiftList != 0 && ProgrammeModeList != 0) {
            $.ajax({
                url: "@Url.Action("BindProgrammeGroupByShiftAndProgrammeMode", "Fee")",
                method: "POST",
                datatype: "json",
                data: { sShift: ShiftList, sProgrammeMode: ProgrammeModeList },
                success: function (data) {
                    $("#liProgrammeGroup").empty();
                    $("#liProgrammeGroup").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        } else {
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }

    LoadClass = function () {
        var vProgramme = String($('#liProgrammeGroup').val());      
        if (vProgramme != 0) {
            $.ajax({
                url: "@Url.Action("FetchClassByProgrammeGroupId", "Fee")",
                method: "POST",
                datatype: "json",
                data: { sProgrammeGroupIds: vProgramme },
                success: function (data) {
                    $("#liClassList").empty();
                    $("#liClassList").append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        } else {
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }
    $("#liProgrammeGroup").on("change", function () {
        LoadClass();
    });
    $("#btnGetCollegePaidStatus").on("click", function () {
        var FrequencyId = $('#liFrequencyType').val();
            var ClassId = String($('#liClassList').val());
            if (FrequencyId != 0 && ClassId != 0) {
                $.ajax({
                    url: '@Url.Action("BindStudentPaidStatus", "Fee")',
                    data: { sFrequencyId: FrequencyId, sClassId: ClassId },
                    success: function (option) {
                        var dvClassWiseStudentPaidStatus = $('#divClassWiseStudentPaidStatus');
                        dvClassWiseStudentPaidStatus.empty();
                        dvClassWiseStudentPaidStatus.append(option);
                        $("#ClassWiseStudentFeePaidStatusList").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                            , {
                                extend: "excel", className: "btn-sm"
                            }
                            , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": false,
                        });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
            else {
                alert('Please Select Frequency Type And Class...!!!');
            }
    });
    function GetFeeAccounts(RazorId,ClassYear,ProgrammeGroup)
    {
        var PAYMENT_ID = RazorId;
        var classYear = ClassYear;
        var ProgrammeGroup = ProgrammeGroup;
        var Frequency = $('#liFrequencyType').val();        
        if (PAYMENT_ID != 0 && classYear != 0 && ProgrammeGroup != 0 && Frequency != 0) {
            $.ajax({
                url: '@Url.Action("BindStudentAmountByRazorAccount", "Fee")',
                data: { sRazorPaymentId: PAYMENT_ID, sFrequencyId: Frequency, sProgrammeGroupId: ProgrammeGroup, sClassYearId: classYear },
                success: function (option) {
                    var dvClassWiseStudentPaidStatus = $('#SelectedStudentFeeAccount');
                    dvClassWiseStudentPaidStatus.empty();
                    dvClassWiseStudentPaidStatus.append(option);                    
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
        else {
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }
</script>
<div class="modal fade" id="ViewFeeStudentAccount-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-orange-lighter">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <p class="modal-title f-s-15 f-w-200 text-white">View Fee Account</p>
            </div>
            <div class="modal-body">
                <div class="from-group" id="SelectedStudentFeeAccount"></div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>