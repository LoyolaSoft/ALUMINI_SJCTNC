@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{
    ViewBag.Title = "HeadWiseFeeReport";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    @using (Html.BeginForm())
    { @Html.AntiForgeryToken()
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>

            <li class="active"> Head Wise Fee Status</li>
        </ol>
        <h2 class="page-header"> Head Wise Fee Status </h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Head Wise Fee Status </h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="col-md-12">
                        @Html.HiddenFor(model => model.FeeTransaction.DATE_FROM)
                        @Html.HiddenFor(model => model.FeeTransaction.DATE_TO)
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.liAcademicYear, "Academic Year", htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.liAcademicYear, (Model.liAcademicYear != null) ? Model.liAcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liAcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.FeeTransaction.DATE_FROM, "Date From", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-7">
                                <div class="input-group date" id="datetimepicker1">
                                    @Html.EditorFor(model => model.FeeTransaction.DATE_FROM, new { htmlAttributes = new { @class = "form-control", id = "Datefrom", placeholder = "Pick Starting Date" } })
                                    @Html.ValidationMessageFor(model => model.FeeTransaction.DATE_FROM, "", new { @class = "text-danger" })
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.FeeTransaction.DATE_TO, "Date To", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <div class="input-group date" id="datetimepicker1">
                                    @Html.EditorFor(model => model.FeeTransaction.DATE_TO, new { htmlAttributes = new { @class = "form-control", id = "Dateto", placeholder = "Pick Ending Date" } })
                                    @Html.ValidationMessageFor(model => model.FeeTransaction.DATE_TO, "", new { @class = "text-danger" })
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.liProgrammeModeList, "Programme Mode", htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.liProgrammeModeList, (Model.liProgrammeModeList != null) ? Model.liProgrammeModeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liProgrammeModeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.liSupFeeFrequency, "Frequency", htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.liSupFeeFrequency, (Model.liSupFeeFrequency != null) ? Model.liSupFeeFrequency : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liSupFeeFrequency, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.liClassLevel, "Class Level", htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.liClassLevel, (Model.liClassLevel != null) ? Model.liClassLevel : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liClassLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.liClassYear, "Class Year", htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.liClassYear, (Model.liClassYear != null) ? Model.liClassYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liClassYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(model => model.liHead, "Head", htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.liHead, (Model.liHead != null) ? Model.liHead : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" ,@multiple="true" , @data_actions_box = "true"})
                                @Html.ValidationMessageFor(model => model.liHead, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-1 pull-right">
                            <a href="javascript:;" id="btnGet" onclick="BindFeeDetails()" class="btn btn-sm btn-primary m-b-10 pull-right"> Get</a>
                        </div>
                        @*<div class="col-md-1 pull-right">
                                <a href="javascript:;" id="sPrint" onclick="printDiv('divDayWiseFeeCollectionPrincipalView')" class="btn btn-sm btn-success m-b-10 pull-right hidden"><i class="fa fa-print m-r-5"></i> Print</a>
                            </div>*@
                    </div>
                    <div class="col-md-12 m-b-5">
                        <div id="divHeadWiseFeeCollection">
                            <!--Need to use this fied to bind Student List-->
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        $('.selectpicker').selectpicker({
            size: 4
        });
    </script>
    <script>
        ContentLoad = function () {
            //Ready Function()

            $(document).ready(function () {
                handleDatepicker = function () {
                    "use strict";
                    $("#Datefrom,#Dateto").datepicker({
                        todayHighlight: true,
                        autoclose: true,
                        endDate: new Date(),
                        format: "dd/mm/yyyy",
                        orientation: "down bottom",
                        zIndexOffset: '15',
                        defaultDate: new Date()
                    }
                    )
                }
                handleDatepicker();
                var sDateFrom = $('#FeeTransaction_DATE_FROM').val();
                var sDateTo = $('#FeeTransaction_DATE_TO').val();
                if (sDateFrom != '' && sDateTo != '') {
                    $('#Datefrom').val(sDateFrom);
                    $('#Dateto').val(sDateTo);
                    //BindFeeDetails();
                }
            });
        }
        LoadHeadWiseFeeReport = function () {

            loadContent('/Fee/HeadWiseFeeReport');
        }
        $('#liAcademicYear').change(function () {
            $("#liProgrammeModeList").val($("#liProgrammeModeList option:first").val());
            $('#Datefrom').val('');
            $('#Dateto').val('');
            $('.selectpicker').selectpicker('refresh');
        });
        $('#liProgrammeModeList').change(function () {
            var sDateFrom = $('#Datefrom').val();
            var sDateTo = $('#Datefrom').val();
            if ($("#liAcademicYear").val() != '' && sDateFrom != '' && sDateTo != '') {
                var sAcademicYear = $('#liAcademicYear option:selected').text();
                $.ajax({
                    url: "@Url.Action("GetFeeFrequencyByAcademicyear", "Fee")",
                    async: false,
                    data: { AcYear: sAcademicYear },
                    success: function (objResult) {
                        $('#liSupFeeFrequency').append(objResult.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
            else {
                alert('Please Select Academicyear And Dates...!!!');
                $("#liProgrammeModeList").val($("#liProgrammeModeList option:first").val());
                $('.selectpicker').selectpicker('refresh');
            }
        });
        $('#liSupFeeFrequency').change(function () {
            var sDateFrom = $('#Datefrom').val();
            var sDateTo = $('#Datefrom').val();
            var sFrequency = $('#liSupFeeFrequency').val();
            var sProgrammeMode = $("#liProgrammeModeList").val();
            if ($("#liAcademicYear").val() != '' && sDateFrom != '' && sDateTo != '' && sFrequency != '' && sProgrammeMode!='') {
                var sAcademicYear = $('#liAcademicYear option:selected').text();
                $.ajax({
                    url: "@Url.Action("GetSupHeadByFreqencyAndProgramme", "Fee")",
                    async: false,
                    data: { AcYear: sAcademicYear, Frequency: sFrequency, ProgrammeMode: sProgrammeMode },
                    success: function (objResult) {
                        $('#liHead').append(objResult.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
            else {
                alert('Please Select Academicyear And Dates...!!!');
                $("#liSupFeeFrequency").val($("#liSupFeeFrequency option:first").val());
                $('.selectpicker').selectpicker('refresh');
            }
        });
    </script>
    <script>
        function Validate() {
            $("#Dateto").rules('add', { greaterThan: "#Datefrom" });
        }
    </script>
    <script>
        function BindFeeDetails() {
            var DateFrom = $("#Datefrom").val();
            var DateTo = $("#Dateto").val();
            var sFrequency = $('#liSupFeeFrequency').val();
            var sProgrammeMode = $("#liProgrammeModeList").val();
            var sClassYear = $("#liClassYear").val();
            var sClassLevel = $("#liClassLevel").val();
            var sHead =String($('#liHead').val());
            //if (Date.parse(DateFrom) > Date.parse(DateTo)) {
            //    alert('Date Range is wrong...!!!');
            //    return false;
            //}
            if ($("#liAcademicYear").val() != '' && DateFrom != '' && DateTo != '' && sFrequency != '' && sProgrammeMode != '' && sHead!='') {
                var sAcademicYear = $('#liAcademicYear option:selected').text();
                $.ajax({
                    url: '@Url.Action("BindHeadWiseFeeCollection", "Fee")',
                    data: { sDateFrom: DateFrom, sDateTo: DateTo, AcYear: sAcademicYear, Frequency: sFrequency, ProgrammeMode: sProgrammeMode, Head: sHead, ClassYear: sClassYear, ClassLevel: sClassLevel },
                    success: function (option) {
                        var dvDayWiseStudentPaidStatus = $('#divHeadWiseFeeCollection');
                        dvDayWiseStudentPaidStatus.empty();
                        dvDayWiseStudentPaidStatus.append(option);
                        //$('#sPrint').removeClass('hidden');                  
                        $("#DayWiseFeePaidStatus").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                            , {
                                extend: "excel", className: "btn-sm"
                            }
                            , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": false, "ordering": false
                        });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
            else {
                alert('Please Select All The Values...!!!');
            }
        }
    </script>
    <script>
        function printDiv(divName) {
            $('.dt-buttons').addClass('hidden');
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            LoadHeadWiseFeeReport();
        }
    </script>

