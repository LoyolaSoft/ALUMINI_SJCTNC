@model CMS.ViewModel.ViewModel.FeeReportViewModel

@{ Layout = null; int count = 0;}
<div class="form-group col-md-12 table-responsive" id="dvPrint">
    <div class="form-group col-md-12" id="Tittle">
        <h3 class="text-center"><b>DateWise Fee Report</b></h3>
    </div>
    <table class="table table-bordered table-hover" id="tblDateWiseCollection">
        <thead>
            <tr>
                <th>#</th>
                <th>Admission No</th>
                <th>Roll No</th>
                <th>Receipt No</th>
                <th>Name</th>
                <th>Date</th>
                <th>Class</th>
                <th>Collected</th>
                <th>Payment</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFeeReport != null && Model.liFeeReport.Count > 0)
            {
                foreach (var item in Model.liFeeReport)
                {
                    <tr>
                        <td>@{count++;} @count</td>
                        <td>@item.ADMISSION_NO</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.RECEIPT_NO</td>   
                        <td>@item.NAME</td>
                        <td>@item.TRANSACTION_DATE</td>
                        <td>@item.CLASS_NAME</td>
                        <td><b>₹ @item.COLLECTED</b></td>
                        <td> @item.PAYMENT_MODE</td>              
                     </tr>
                  }       
                }        
        </tbody>
    </table>
</div>