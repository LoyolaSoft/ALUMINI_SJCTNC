@model CMS.ViewModel.ViewModel.FeeTransactionViewModel

@{
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>

        <li class="active"> Update Paid List</li>
    </ol>
    <h2 class="page-header"> Update Paid List </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> Update Paid List </h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">

                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.liAcademicYear, "Ac Year", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.liAcademicYear, (Model.liAcademicYear != null) ? Model.liAcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.liAcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.liSupFeeFrequency, "Frequency", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.liSupFeeFrequency, (Model.liSupFeeFrequency != null) ? Model.liSupFeeFrequency : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.liSupFeeFrequency, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        @Html.Label("Upload", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            <input type="file" class="hidden" id="ExcelUpload" />
                            <a class="btn btn-primary" onclick="ClickFile()">File</a>
                        </div>
                    </div>

                    <div class="col-md-1 pull-right">
                        <a href="javascript:;" id="btnGet" onclick="SaveFile()" class="btn btn-sm btn-primary m-b-10 pull-right"> Submit</a>
                    </div>

                </div>

            </div>

        </div>
    </div>
}
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    function ContentLoad() {
        // Document Ready Function .
    }
    $('#liAcademicYear').on('change', function ()
    {
        $('#liSupFeeFrequency').empty();
        $.ajax({
            url:'@Url.Action("FetchFrequencyByAcademicYear", "Fee")',
            method:'POST',
            datatype: 'json',
            data: { Academicyear: $('#liAcademicYear Option:selected').text() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Warning Message!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
                } else
                {
                    $('#liSupFeeFrequency').append("<option value=''> -- select -- </option>" + data.sResult);
                }
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    });

    function ClickFile()
    {
        $('#ExcelUpload').click();
    }

    function SaveFile()
    {
        var sFlag=false;
        var formData = new FormData();
        var sFile = $('#ExcelUpload').get(0).files;
        if (sFile.length != 0)
        {
            for (var i = 0; i < sFile.length; i++)
            {
                formData.append(sFile[i].name, sFile[i]);
                sFlag=true;
            }
        }
        formData.append("AC_YEAR", $('#liAcademicYear Option:selected').text());
        formData.append("FREQUENCY_ID", $('#liSupFeeFrequency').val());
        formData.append("FREQUENCY", $('#liSupFeeFrequency  Option:selected').text());
        if ($('#liAcademicYear').val() && $('#liSupFeeFrequency').val() && sFlag)
        {
            $.ajax({
                url: '@Url.Action("SaveFeePaymentUpdates", "Fee")',
                method: 'POST',
                datatype: 'json',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data)
                {
                    alert(data.Message);
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }

    }
</script>