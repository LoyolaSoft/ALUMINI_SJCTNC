@model CMS.ViewModel.ViewModel.FeeViewModel


@{
    Layout = null;
}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Late Fee</a></li>
        <li class="active">Fee Entry </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Gate Fee Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Gate Fee Entry  </h4>
        </div>
        <div class="panel-body table-responsive">
            <div class="form-horizontal">
                <div class="col-md-12 form-group">
                    <div class="col-md-5">
                        @Html.Label("Roll No", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtRollNo" onchange="LoadData()" />
                        </div>
                    </div>

                    <div class="col-md-5" id="dvAmount">
                            @Html.Label("Amount", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="txtAmount" value="20"/>
                            </div>
                        </div>

                    <div class="col-md-2">
                        <a class="btn btn-primary" id="btnSubmit" onclick="GateFeeEntry()"> Submit </a>
                    </div>
                </div>

                <div class="col-md-12 form-group">
                    <div id="dvBindGateFee"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function LoadData()
    {
        var RollNo = $('#txtRollNo').val().replace('*', '');
        $.ajax({
            url: '@Url.Action("BindStudentLateFeeInfoByDate", "Fee")',
            method: 'POST',
            datatype: 'json',
            data: { sRollNo: RollNo },
            success: function (data)
            {
                if (data.Message != null && data.Message!='')
                {
                    alert(data.Message);
                }
                $('#dvBindGateFee').empty();
                $('#dvBindGateFee').append(data);

            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }

    function GateFeeEntry()
    {
          var RollNo = $('#txtRollNo').val().replace('*','');
          $.ajax({
              url:'@Url.Action("SaveGateFeeEntry", "Fee")',
              method:'POST',
              datatype: 'json',
              data: { sRollNo: RollNo, sFineAmount: $('#txtAmount').val() },
              success: function (data)
              {
                  alert(data.Message);
                  LoadData();
              }, error: function (error)
              {
                  alert('Internal Server Error !');
              }
          });
    }
</script>