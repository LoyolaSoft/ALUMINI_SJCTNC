@model CMS.ViewModel.ViewModel.FeeTransactionViewModel

@{
    Layout = null;
    int count = 0;
}

<div class="col-lg-12 table-responsive">
    @if (Model.liFeeStudentAccount != null && Model.liFeeStudentAccount.Count > 0)
    {
        if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
        {
            <div class="row">
                <div class="col-md-2 pull-left">
                    <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:150px; height:150px" />
                </div>
                <div class="col-md-10 pull-left text-center">
                    <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME </h3>
                    <h4>@Model.liCollegeDetails.FirstOrDefault().PLACE .</h4>
                    <h5>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h5>
                    <h5>
                        @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                        
                    </h5>
                </div>
            </div>
        }
        <table class="table table-hover table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Frequency</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.liFeeStudentAccount)
                {
                    if (item.BALANCE != "0")
                    {
                        <tr>
                            <td>@{count++;} @count</td>
                            <td>@item.FREQUENCY_NAME</td>
                            <td>@item.BALANCE</td>
                            <td>
                                <a @*href="@Url.Action("FeeBalanceList", "Fee")"*@ onclick="loadContent('/Fee/FeeBalanceList')" class="btn btn-success " title="Online Payment"><i class="ion-card"></i> Go To Payment Link</a>
                            </td>
                        </tr>
                     }
                  }
            </tbody>
        </table>
      }
</div>



