@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{ Layout = null; int count = 0;}
<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Amount</th>
                <th>Main Head</th>
                <th>Account Name</th>
                <th>PassBook No</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFeeReport != null)
            {
                foreach (var item in Model.liFeeReport)
                {
                    <tr>
                        <td>
                            @{ count++;}@count
                        </td>
                        <td>@item.TOTAL_AMOUNT</td>
                        <td>@item.MAIN_HEAD</td>
                        <td>@item.ACCOUNT_NAME</td>
                        <td>@item.PASSBOOK_NO</td>
                    </tr>
                                    }
                                    <tr>
                                        <td></td>
                                        <td>@Model.liFeeReport.Sum(O=>Convert.ToDouble(O.TOTAL_AMOUNT))</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
        </tbody>
    </table>
</div>