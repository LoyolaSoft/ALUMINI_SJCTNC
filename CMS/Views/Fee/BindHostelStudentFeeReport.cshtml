@model CMS.ViewModel.ViewModel.FeeReportViewModel
@{
    Layout = null;
    string selectedTab = ViewBag.SelectedTab;
    List<string> headCodes = ViewBag.HeadCodes as List<string> ?? new List<string>();
}

<div class="print-college-header" style="text-align: center; margin-bottom: 18px; border-bottom: 2px solid #1e3a8a; padding-bottom: 10px;">
    <h2 style="margin: 0 0 4px 0; font-size: 20px; font-weight: 800; color: #1e3a8a; text-transform: uppercase;">ST. JOSEPH'S COLLEGE OF ARTS & SCIENCE (AUTONOMOUS)</h2>
    <h4 style="margin: 0 0 6px 0; font-size: 13px; font-weight: 600; color: #334155;">CUDDALORE - 607 001</h4>
    <h3 style="margin: 6px 0 8px 0; font-size: 15px; font-weight: 700; text-decoration: underline; color: #0f172a;">HOSTEL STUDENT FEE REPORT (@(selectedTab == "balance_headwise" ? "HEAD WISE BALANCE REPORT" : (selectedTab == "balance" ? "BALANCE REPORT" : selectedTab.ToUpper())))</h3>
    <div class="print-meta-info" style="display: flex; justify-content: space-between; font-size: 11.5px; font-weight: 600; color: #475569; margin-top: 8px;">
        <span><b>Academic Year:</b> @(Model.liHostelFeeReport != null && Model.liHostelFeeReport.Count > 0 ? Model.liHostelFeeReport.FirstOrDefault().ACADEMIC_YEAR : "")</span>
        <span><b>Printed On:</b> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")</span>
    </div>
</div>

<table id="tblHostelFeeReport" class="table table-striped table-bordered table-hover dt-responsive" width="100%">
    <thead>
        @if (selectedTab == "paidwise")
        {
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Frequency</th>
                <th>Head Code</th>
                <th>Paid Amount</th>
                <th>Payment Date</th>
                <th>Receipt No</th>
                <th>Payment Mode</th>
            </tr>
        }
        else if (selectedTab == "balance")
        {
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Frequency</th>
                <th>Head Code</th>
                <th>Allocated Amount</th>
                <th>Paid Amount</th>
                <th>Balance Due</th>
            </tr>
        }
        else if (selectedTab == "balance_headwise")
        {
            <tr style="background-color: #f8fafc; font-weight: bold;">
                <th style="width: 50px;">S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                @foreach (var head in headCodes)
                {
                    <th class="text-right">@head</th>
                }
                <th class="text-right" style="background-color: #fef2f2; color: #dc2626;">Total Balance</th>
            </tr>
        }
        else if (selectedTab == "freqwise")
        {
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Hostel</th>
                <th>Frequency</th>
                <th>Head Code</th>
                <th>Allocated Amount</th>
                <th>Paid Amount</th>
                <th>Balance Due</th>
                <th>Status</th>
            </tr>
        }
        else if (selectedTab == "freqheadwise")
        {
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Hostel</th>
                <th>Frequency</th>
                <th>Head Code</th>
                <th>Allocated Amount</th>
                <th>Paid Amount</th>
                <th>Balance Due</th>
            </tr>
        }
    </thead>
    <tbody>
        @if (Model.liHostelFeeReport != null && Model.liHostelFeeReport.Count > 0)
        {
            if (selectedTab == "balance_headwise")
            {
                var studentGroups = Model.liHostelFeeReport
                    .GroupBy(x => new { x.STUDENT_ID, x.ROLL_NO, x.FIRST_NAME, x.CLASS_NAME })
                    .OrderBy(g => g.Key.ROLL_NO)
                    .ToList();

                int sno = 1;
                foreach (var student in studentGroups)
                {
                    decimal studentTotal = 0;
                    <tr>
                        <td>@sno</td>
                        <td><b>@student.Key.ROLL_NO</b></td>
                        <td>@student.Key.FIRST_NAME</td>
                        <td>@student.Key.CLASS_NAME</td>
                        @foreach (var head in headCodes)
                        {
                            var headRecord = student.FirstOrDefault(x => string.Equals(x.HEAD_CODE, head, StringComparison.OrdinalIgnoreCase));
                            decimal bal = 0;
                            if (headRecord != null)
                            {
                                decimal.TryParse(headRecord.BALANCE, out bal);
                            }
                            studentTotal += bal;
                            <td class="text-right">
                                @if (bal > 0)
                                {
                                    <span style="color:#dc2626; font-weight:600;">@bal.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        }
                        <td class="text-right" style="background-color: #fff1f2; font-weight: bold; color: #dc2626;">
                            @studentTotal.ToString("N2")
                        </td>
                    </tr>
                    sno++;
                }
            }
            else
            {
                int sno = 1;
                foreach (var item in Model.liHostelFeeReport)
                {
                    if (selectedTab == "paidwise")
                    {
                        <tr>
                            <td>@sno</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.FREQUENCY_NAME</td>
                            <td>@item.HEAD_CODE</td>
                            <td class="text-right">@item.DEBIT</td>
                            <td>@item.PAYMENT_DATE</td>
                            <td>@item.RECEIPT_NO</td>
                            <td>@item.PAYMENT_MODE</td>
                        </tr>
                    }
                    else if (selectedTab == "balance")
                    {
                        <tr>
                            <td>@sno</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.FREQUENCY_NAME</td>
                            <td>@item.HEAD_CODE</td>
                            <td class="text-right">@item.CREDIT</td>
                            <td class="text-right">@item.DEBIT</td>
                            <td class="text-right" style="color:red; font-weight:bold;">@item.BALANCE</td>
                        </tr>
                    }
                    else if (selectedTab == "freqwise")
                    {
                        decimal balance = 0;
                        decimal.TryParse(item.BALANCE, out balance);
                        decimal debit = 0;
                        decimal.TryParse(item.DEBIT, out debit);

                        string statusLabel = "";
                        string badgeClass = "";

                        if (balance <= 0)
                        {
                            statusLabel = "Fully Paid";
                            badgeClass = "label label-success";
                        }
                        else if (debit > 0)
                        {
                            statusLabel = "Partially Paid";
                            badgeClass = "label label-warning";
                        }
                        else
                        {
                            statusLabel = "Unpaid";
                            badgeClass = "label label-danger";
                        }

                        <tr>
                            <td>@sno</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@(string.IsNullOrEmpty(item.HOSTEL_NAME) ? "N/A" : item.HOSTEL_NAME)</td>
                            <td>@item.FREQUENCY_NAME</td>
                            <td>@item.HEAD_CODE</td>
                            <td class="text-right">@item.CREDIT</td>
                            <td class="text-right">@item.DEBIT</td>
                            <td class="text-right" style="font-weight:bold; color:@(balance <= 0 ? "green" : "red")">@item.BALANCE</td>
                            <td class="text-center"><span class="@badgeClass" style="font-size: 11px; padding: 4px 8px;">@statusLabel</span></td>
                        </tr>
                    }
                    else if (selectedTab == "freqheadwise")
                    {
                        <tr>
                            <td>@sno</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@(string.IsNullOrEmpty(item.HOSTEL_NAME) ? "N/A" : item.HOSTEL_NAME)</td>
                            <td>@item.FREQUENCY_NAME</td>
                            <td>@item.HEAD_CODE</td>
                            <td class="text-right">@item.CREDIT</td>
                            <td class="text-right">@item.DEBIT</td>
                            <td class="text-right" style="font-weight:bold;">@item.BALANCE</td>
                        </tr>
                    }
                    sno++;
                }
            }
        }
        else
        {
            <tr>
                <td colspan="30" class="text-center text-muted">No records found matching the criteria.</td>
            </tr>
        }
    </tbody>
    @if (selectedTab == "balance_headwise" && Model.liHostelFeeReport != null && Model.liHostelFeeReport.Count > 0)
    {
        var colTotals = headCodes.ToDictionary(h => h, h => 0m);
        decimal grandTotal = 0;
        foreach (var item in Model.liHostelFeeReport)
        {
            if (!string.IsNullOrEmpty(item.HEAD_CODE))
            {
                var matchKey = colTotals.Keys.FirstOrDefault(k => string.Equals(k, item.HEAD_CODE, StringComparison.OrdinalIgnoreCase));
                if (matchKey != null)
                {
                    decimal b = 0;
                    decimal.TryParse(item.BALANCE, out b);
                    colTotals[matchKey] += b;
                    grandTotal += b;
                }
            }
        }
        <tfoot style="display: table-row-group !important; background-color: #f1f5f9; font-weight: bold;">
            <tr>
                <td colspan="4" class="text-right"><b>Total Due:</b></td>
                @foreach (var head in headCodes)
                {
                    <td class="text-right" style="color: #dc2626; font-weight: bold;">@colTotals[head].ToString("N2")</td>
                }
                <td class="text-right" style="background-color: #fee2e2; color: #b91c1c; font-size: 1.1em; font-weight: bold;">
                    @grandTotal.ToString("N2")
                </td>
            </tr>
        </tfoot>
    }
</table>

<style>
    @@media print {
        @@page {
            size: landscape;
            margin: 8mm 10mm;
        }
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
            color: #000 !important;
            background: #fff !important;
            font-size: 10px !important;
        }
        .print-college-header {
            display: block !important;
            visibility: visible !important;
            text-align: center !important;
            margin-bottom: 12px !important;
            border-bottom: 2px solid #1e3a8a !important;
            padding-bottom: 8px !important;
        }
        .print-college-header h2 {
            margin: 0 0 3px 0 !important;
            font-size: 18px !important;
            font-weight: 800 !important;
            color: #1e3a8a !important;
            text-transform: uppercase !important;
        }
        .print-college-header h4 {
            margin: 0 0 5px 0 !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            color: #334155 !important;
        }
        .print-college-header h3 {
            margin: 4px 0 6px 0 !important;
            font-size: 14px !important;
            font-weight: bold !important;
            text-decoration: underline !important;
            color: #000 !important;
        }
        .print-meta-info {
            display: flex !important;
            justify-content: space-between !important;
            font-size: 10px !important;
            font-weight: 600 !important;
            margin-top: 6px !important;
        }
        table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 9.5px !important;
        }
        tr {
            page-break-inside: avoid !important;
        }
        table, th, td {
            border: 1px solid #475569 !important;
        }
        th, td {
            padding: 4px 5px !important;
        }
        th {
            background-color: #f1f5f9 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            font-weight: bold !important;
            text-align: center !important;
        }
        /* CRITICAL: display: table-row-group ensures Total Due appears ONLY at the end of the last sheet */
        tfoot {
            display: table-row-group !important;
            page-break-inside: avoid !important;
            background-color: #f8fafc !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .text-right {
            text-align: right !important;
        }
        .text-center {
            text-align: center !important;
        }
        .text-muted {
            color: #64748b !important;
        }
    }
</style>


