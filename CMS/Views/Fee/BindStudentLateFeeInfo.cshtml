@model CMS.ViewModel.ViewModel.FeeViewModel

@{ 
    Layout = null;
    int nCount = 0;
}

<div class="col-md-12 form-group table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Staff Code</th>
                <th>Staff Name</th>
                <th>Date</th>
                <th>Fine Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStuLateFee!=null && Model.liStuLateFee.Count>0)
            {
                foreach (var item in Model.liStuLateFee)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.STAFF_CODE</td>
                        <td>@item.STAFF_NAME</td>
                        <td>@item.ENTRY_DATE</td>
                        <td>@item.FINE_AMOUNT</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>