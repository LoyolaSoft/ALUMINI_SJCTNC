@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{int count = 0;}
@{int i = 0;}
@if (Model.liDate != null && Model.liCreditAndDebit != null)
{
    foreach (var list in Model.liDate)
    {
        var SelectedStudentList = Model.liCreditAndDebit.Where(s => s.TRANSACTION_DATE == list.DAY_ORDER_DATE).ToList();
        if (SelectedStudentList.Count > 0)
        {
            <div class="table-responsive">
                <center>
                    <table><tr><th>@list.DAY_ORDER_DATE</th></tr></table>
                </center>
                @{ count = 0;}
                <table class="table table-hover table-bordered" id="DayWiseFeePaidStatus">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Main</th>
                            @if (Model.lstSupHead != null)
                        {
                            foreach (var data in Model.lstSupHead)
                            {
                            <th>@data.HEAD</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liFeeTransaction != null && Model.liFeeTransaction != null)
                        {
                            var TempList = Model.liFeeTransaction.Where(s => s.PAYMENT_DATE == list.DAY_ORDER_DATE).ToList();
                            foreach (var item in SelectedStudentList)
                            {
                                var StudentList = TempList.Where(s => s.STUDENT_ID == item.STUDENT_ID).ToList();
                        <tr>
                            <td>@{ count++;}@count</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.PROGRAMME_NAME</td>
                            @if (Model.lstSupHead != null)
                                {
                                    foreach (var data in Model.lstSupHead)
                                    {
                                        foreach (var listitem in StudentList)
                                        {
                                            if (data.HEAD_ID == listitem.HEAD)
                                            {
                                            { i++;}
                                    <td><i class="fa fa-inr"></i>@listitem.PAID_AMOUNT</td>
                                        }
                                    }
                                    if (i==0)
                                    {
                                        <td></td>
                                    }
                                    { i=0; }
                                }
                            }
                        </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
                                        }
                                    }
                                }

                                @*<table class="table table-hover" id="DayWiseFeePaidStatus">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Shift</th>
                                                @if (Model.liFeeTransaction != null)
                                                {
                                                    foreach (var list in Model.lstSupHead)
                                                    {
                                                        <th>@list.HEAD</th>
                                                    }
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.liFeeTransaction != null && Model.liFeeTransaction != null)
                                            {
                                                foreach (var list in Model.liFeeTransaction)
                                                {
                                                    <tr>
                                                        <td>@{ count++;}@count</td>
                                                        <td>@list.SHIFT</td>
                                                        <td><i class="fa fa-inr"></i> @list.COLLECTED</td>
                                                    </tr>
                                                                }
                                                            }
                                        </tbody>
                                    </table>*@
