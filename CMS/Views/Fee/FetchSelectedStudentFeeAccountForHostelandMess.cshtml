@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{Layout = null; int count = 0;}
@if (Model.liFeeStudentAccount != null && Model.lstStudentPersonalInfo != null)
{
    <table width="100%" id="StudentInfoList">
        <tr>
            <th>Name</th>
            <th>@Model.lstStudentPersonalInfo.FirstOrDefault().FIRST_NAME</th>
            <th>Roll No</th>
            <th>@(string.IsNullOrEmpty(Model.lstStudentPersonalInfo.FirstOrDefault().ROLL_NO) ? Model.lstStudentPersonalInfo.FirstOrDefault().REGISTER_NO : Model.lstStudentPersonalInfo.FirstOrDefault().ROLL_NO)</th>
        </tr>
    </table>
    <br>
}

@if (Model.liFeeStudentAccount != null)
{
    <table class="table table-hover table-bordered" width="100%" id="StudentFeeList">
        <thead>
            <tr>
                <th>#</th>
                <th>Head</th>
                <th>Total Amount</th>
                <th>Balance</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liFeeStudentAccount)
            {
                <tr cms-StudentAccountId="@item.F_STUDENT_AC_ID" cms-balance="@item.BALANCE">
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>@item.HEAD</td>
                    @{ if (item.BALANCE != "0")
                        {
                            <td>
                                <input class="form-control" type="text" id="" name="" value="@item.CREDIT" />
                            </td>
                        }
                        else
                        {
                            <td>
                                <i class="fa fa-inr"></i>@item.CREDIT
                            </td>
                        }
                    }
                    <td>
                        <i class="fa fa-inr"></i>@item.BALANCE
                    </td>
                    <td>
                        @if (item.BALANCE != "0" && (string.IsNullOrEmpty(item.DEBIT) || item.DEBIT == "0"))
                        {
                            <a href="javascript:;" onclick="DeleteHostelFeeAccountItem(@item.F_STUDENT_AC_ID, '@item.HEAD')" class="btn btn-xs btn-danger" title="Delete Unpaid Fee Head"><i class="fa fa-trash"></i> Delete</a>
                        }
                        else if (item.BALANCE != "0" && !string.IsNullOrEmpty(item.DEBIT) && item.DEBIT != "0")
                        {
                            <span class="badge badge-warning" title="Partial Payment Made">Partial Paid</span>
                        }
                        else
                        {
                            <span class="badge badge-success">Paid</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}