@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{ Layout = null; int count = 0;}
<table class="table table-hover table-bordered" id="ClassWiseStudentFeePaidStatusList">
    <thead>
        <tr>
            <th>#</th>
            <th>Register No</th>
            <th>Roll No</th>
            <th>Name</th>
            <th>Class</th>
            <th>Total Amount</th>
            <th>Balance</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.liFeeTransaction != null)
        {
            foreach (var item in Model.liFeeTransaction)
            {
                <tr>                    
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>@item.REGISTER_NO</td>
                    <td>@item.ROLL_NO</td>
                    <td>@item.FIRST_NAME</td>
                    <td>@item.CLASS</td>
                    <td>@item.TOTAL_AMOUNT</td>
                    <td>@item.BALANCE</td>                 
                    @{
                        if ((item.TOTAL_AMOUNT) != "0")
                        {
                            <td>@item.STATUS</td>
                        }
                        else
                        {
                            <td>NO ACCOUNT</td>
                        }

                        if (!string.IsNullOrEmpty(item.RAZOR_PAY_ID))
                        {
                            <td><a href="#ViewFeeStudentAccount-dialog" onclick="GetFeeAccounts('@item.RAZOR_PAY_ID','@item.CLASS_YEAR','@item.PROGRAMME_GROUP_ID')" data-toggle="modal" title="View"><i class="glyphicon glyphicon-eye-open" ></i></a></td>
                        }
                        else
                        {
                            <td></td>
                        }
                    }                           
                </tr>
                                }
                            }                            
    </tbody>
</table>
