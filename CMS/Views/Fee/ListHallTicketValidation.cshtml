<script>
    $('#btnSubmit').on('click', function ()
    {
        SaveRecord();
    });
    SaveRecord = function ()
    {
        var Class = $('#liClassList').val();
        var Student = ($('#StudentList').val()).toString();
        //    var Amount = $('#txtBalanceAmount').val();
        var Reason = $('#txtReason').val();
        var ValidationId = $('#txtValidationId').val();
        var JsonData;
        if (Student != '0' && Student!=null)
        {
                JsonData = '{"HALL_TICKET_VALIDATION_ID":"' + ValidationId + '","CLASS_ID":"' + Class + '","STUDENT_ID":"' + Student + '","REASON":"' + Reason + '"}';
                $.ajax({
                    url: "@Url.Action("SaveOrUpdateHallTicketValidation", "Fee")",
                    method: "POST",
                    data: { sValidation: JsonData },
                    success: function (objResult)
                    {
                         
                        alert(objResult.Message);
                        $('#HallTicket-dialog').modal('hide');
                        $('.modal-backdrop').remove();
                        loadContent('/Fee/ListHallTicketValidation')
                    }, error: function (error)
                    {
                        alert('Record not saved try again ..!');
                    }
            });
        }
        else
        {
             alert('Please Enter Correct Values...!!!');
             return false;
        }
    }

    function UpdateHAllTicket(ValidationId,Reason,StudentId)
    {
        $('#txtValidationId').val(ValidationId);
        $('#txtReason').val(Reason);
        $('#StudentList').val(StudentId);
        $('#StudentList').attr('disabled', true);
        $('.selectpicker').selectpicker('refresh');
    }

    $(function ()
    {
        $('#HallTicket-dialog').on('hidden.bs.modal', function (e)
        {
            $('#txtValidationId').val('');
            $('#txtReason').val('');
            $('#StudentList').val(0);
            $('.selectpicker').selectpicker('refresh');
        });
    });
</script>

