@model CMS.ViewModel.ViewModel.HallTicketValidationViewModel
@{
    ViewBag.Title = "ListHallTicketValidation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/css/style.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }
</style>

<div class="content" id="content">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>

        <li class="active">Hall Ticket Validation </li>
    </ol>
    <h2 class="page-header">Hall Ticket Validation </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Hall Ticket Validation  </h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.liClassList, "Class List", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.liClassList, (Model.liClassList != null) ? Model.liClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.liClassList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <a href="javascript:;" onclick="loadGrid()" id="btnGet" class="btn btn-sm btn-primary">Get</a>
                    </div>

                </div>


            </div>
            <div class="col-lg-12 m-b-5">
                <div class="table-responsive" id="divClassWiseStudentUnPaidStatus">
                    <div class="col-md-12 form-group">
                        <a class="btn btn-success pull-right" style="cursor:pointer" href="#HallTicket-dialog" data-toggle="modal"><i class="fa fa-plus"></i> Add </a>
                    </div>

                    @if (Model.lstHallTicketValidation != null && Model.lstHallTicketValidation.Count > 0)
                    {
                        int count = 0;
                        <table class="table table-hover table-bordered" id="ClassWiseStudentFeeUnPaidStatusList">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Roll No</th>
                                    <th>Register No</th>
                                    <th>Class</th>
                                    <th>Name</th>
                                    <th>Reason</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.lstHallTicketValidation)
                                {
                                    <tr>
                                        <td>
                                            @{ count++;}@count
                                        </td>
                                        <td>@item.ROLL_NO</td>
                                        <td>@item.REGISTER_NO</td>
                                        <td>@item.CLASS_NAME</td>
                                        <td>@item.FIRST_NAME</td>
                                        <td>@item.REASON</td>
                                        <td>
                                            <a href="#HallTicket-dialog" data-toggle="modal" onclick="UpdateHAllTicket(@item.HALL_TICKET_VALIDATION_ID,'@item.REASON',@item.STUDENT_ID);"><i class="fa fa-edit" title="Click To Update"></i></a>
                                            <a href="#" onclick="GetConfirm(@item.HALL_TICKET_VALIDATION_ID);"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div>
                            <h5>No Records Available...!!!</h5>
                        </div>
                    }
                    <div class="modal fade" id="HallTicket-dialog">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                                    <h4 class="modal-title">Hall Ticket Validation</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <div class="form-horizontal">
                                                <div class="col-md-12">
                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                    <div class="form-group">
                                                        @*<label class="control-label col-md-3">Student</label>
                                                            <div class="col-md-9">
                                                                <select id="StudentList" class="selectpicker form-control" data-live-search="true">
                                                                    <option value="">-- Select --</option>
                                                                </select>
                                                            </div>*@
                                                        @Html.LabelFor(model => model.StudentList, "Student List", htmlAttributes: new { @class = "control-label col-md-3" })
                                                        <div class="col-md-9">
                                                            @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", multiple = "multiple" })
                                                            @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="control-label col-md-3"> Reason </label>
                                                        <div class="col-md-9">
                                                            <input type="text" class="form-control input-sm" id="txtReason" placeholder="Enter Reason " maxlength="98" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                                    <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="text" id="txtValidationId" class="hidden" value="" />
                </div>
            </div>
        </div>
    </div>
}
</div>





<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 4
    });
</script>
<script>
    $("#ClassWiseStudentFeeUnPaidStatusList").DataTable();
</script>
