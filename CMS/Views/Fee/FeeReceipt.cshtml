@model CMS.ViewModel.ViewModel.FeeTransactionViewModel

@{
    ViewBag.Title = "FeeReceipt";
    Layout = null;   
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">Admission Fee Receipt</li>
        </ol>
        <h2 class="page-header"> Admission Fee Receipt</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">@Model.liFeeTransaction.FirstOrDefault().FREQUENCY_NAME Receipt</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">

                    <div class="col-md-12 table-responsive">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @if (Model.liFeeReport != null && Model.liFeeTransaction != null)
                        {
                            <div>
                                @foreach (var dataitem in Model.liFeeReport)
                                {
                                    string sQRContent = string.Empty;
                                    var TransactionList = Model.liFeeTransaction.Where(s => s.TRANSACTION_ID == dataitem.TRANSACTION_ID).ToList();
                                    <div style="page-break-after:always !important;page-break-inside:avoid !important;" id="dvprint_@TransactionList.FirstOrDefault().TRANSACTION_ID">
                                        @if (TransactionList != null && TransactionList.Count() > 0)
                                        {   //this to print receipt header
                                            int count = 0;
                                            <div class="col-md-8 col-lg-offset-2">
                                                <div class="pull-left">
                                                    <h6>
                                                        <label>Receipt No:</label>@dataitem.RECEIPT_NO
                                                    </h6>
                                                </div>
                                                <div class="pull-right">
                                                    <label>Date:</label>@dataitem.PAYMENT_DATE
                                                </div>
                                            </div>
                                            <div class="col-md-8 col-lg-offset-2">

                                                <div class="col-md-10">
                                                    @if (Model.liCollegeDetails != null)
                                                    {
                                                        foreach (var item in Model.liCollegeDetails)
                                                        {
                                                            <center>
                                                                <img src="@Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO" width="75px;" class=" ">
                                                                <table>
                                                                    <tr>
                                                                        <td><center><strong>@item.COLLEGE_NAME</strong></center></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td><b> @item.GRADE</b></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td class="text-center">
                                                                            @item.UNIVERSITY
                                                                        </td>
                                                                    </tr>

                                                                </table>
                                                            </center>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-8 col-lg-offset-2">
                                                <table class="table-condensed" cellpadding="5">
                                                    <tr>
                                                        <td width="15%"><b>Name</b></td>
                                                        <td width="35%"><b>@Model.liFeeReport.FirstOrDefault().FIRST_NAME</b></td>
                                                        <td width="25%"><b>Roll No</b></td>
                                                        <td width="25%">@dataitem.ROLL_NO</td>
                                                    </tr>
                                                    <tr>
                                                        <td><b>Payment Type</b></td>
                                                        <td>
                                                            @dataitem.PAYMENT_MODE
                                                        </td>
                                                        <td><b>Programme</b></td>
                                                        <td>@dataitem.PROGRAMME_NAME</td>
                                                    </tr>
                                                </table>
                                                @{sQRContent = string.Concat("Name:", Model.liFeeReport.FirstOrDefault().FIRST_NAME, "|", "Roll.No:", dataitem.ROLL_NO, "|PaymentMode:", dataitem.PAYMENT_MODE
    , "|Main:", @dataitem.PROGRAMME_NAME, "|PaidAmount:", dataitem.COLLECTED, "|ReceiptNo:", dataitem.RECEIPT_NO, "|PaymentDate:", dataitem.PAYMENT_DATE, "|College:", Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME, "|Key:", dataitem.TRANSACTION_ID);
                                                }
                                            </div>
                                            <div class="col-md-8 col-lg-offset-2">
                                                <table class="table-bordered" cellpadding="50" width="100%">
                                                    <tr class="text-center">
                                                        <th width="70px">&nbsp;&nbsp;#</th>
                                                        <th>
                                                            &nbsp;&nbsp;PARTICULARS
                                                        </th>
                                                        <th>
                                                            &nbsp;&nbsp;AMOUNT
                                                        </th>
                                                    </tr>
                                                    @foreach (var item in TransactionList)
                                                    {
                                                        <tr>
                                                            <td width="70px">
                                                                &nbsp;&nbsp;&nbsp;@{ count++;}@count
                                                            </td>
                                                            <td> &nbsp;&nbsp;&nbsp; @item.MAIN_HEAD</td>
                                                            <td class="text-right"><i class="fa fa-inr"></i>@item.DEBIT &nbsp;&nbsp;&nbsp;</td>
                                                        </tr>
                                                                    }

                                                    <tr>
                                                        <td></td>
                                                        <td class="text-right">TOTAL  &nbsp;&nbsp;&nbsp;</td>
                                                        <td class="text-right"><i class="fa fa-inr"></i>@dataitem.COLLECTED  &nbsp;&nbsp;&nbsp;</td>
                                                    </tr>
                                                </table>
                                                <div class="col-md-12">
                                                    <h5>This is a system generated receipt.It doesn't require any signature.</h5>
                                                </div>
                                            </div>
                                            <div class="col-md-8 col-lg-offset-2 ">
                                                <br />
                                                <img src="@CMS.Utility.CommonMethods.GetEncodeQRCodeWithLogo(sQRContent)" width="120px;" class=""><br>

                                            </div>
                                            <hr />
                                            <br />
                                            <div class="col-md-12"><button class="btn bg-green pull-right m-b-5" onclick="printDiv('dvprint_@TransactionList.FirstOrDefault().TRANSACTION_ID');">Print</button></div>
                                                                    }
                                    </div>



                                                                    }
                            </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="alert alert-danger"><p class="text-center">Your account is not created.Please meet Admin..!</p></div>
                                                                    }

                    </div>
                </div>
            </div>
        </div>
    </div>

                                                                    }

<script>

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;      
        loadContent('/Fee/FeeBalanceList');
        
    }
</script>




