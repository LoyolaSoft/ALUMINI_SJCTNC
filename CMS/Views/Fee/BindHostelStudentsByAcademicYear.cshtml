@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{Layout = null; int count = 0;}
<table class="table table-hover table-bordered" width="100%" id="StudentList">
    <thead>
        <tr>
            <th>#</th>
            <th>
                <div class="checkbox checkbox-css">
                    <input type="checkbox" value="" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" />
                    <label for="AllchkID"></label>
                </div>
            </th>
            <th>First Name</th>
            <th>Roll No</th>
            <th>Class</th>
            <th>Hostel</th>
            <th class="text-right">Balance Amount</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.lstHostelStudentInfo != null)
        {
            foreach (var item in Model.lstHostelStudentInfo)
            {
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>
                        <div class="checkbox checkbox-css checkbox-inline">
                            <input type="checkbox" name="myTextEditBox" id="@item.STUDENT_ID" cms-studentid="@item.STUDENT_ID" />
                            <label for="@item.STUDENT_ID"></label>
                        </div>
                    </td>
                    <td>@item.FIRST_NAME</td>
                    
                    <td>
                        @item.ROLL_NO
                    </td>
                    <td>
                        @item.CLASS_NAME
                    </td>
                    <td>@item.HOSTEL_NAME                        
                    </td>
                    <td class="text-right" style="font-weight: 600;">
                        @if (!string.IsNullOrEmpty(item.BALANCE_AMOUNT) && item.BALANCE_AMOUNT != "0" && item.BALANCE_AMOUNT != "0.00")
                        {
                            <span class="text-danger"><i class="fa fa-inr"></i> @item.BALANCE_AMOUNT</span>
                        }
                        else
                        {
                            <span class="text-success"><i class="fa fa-inr"></i> 0.00</span>
                        }
                    </td>
                    <td style="white-space: nowrap;">
                        <a href="#ViewFeeStudentAccount-dialog" onclick="ListSelectedStudentFeeAccount(@item.STUDENT_ID);" data-toggle="modal" class="btn btn-xs btn-info" title="View Fee Account"><i class="glyphicon glyphicon-eye-open"></i></a>
                        <a href="javascript:;" onclick="DeleteStudentUnpaidFeeAccounts(@item.STUDENT_ID, '@item.FIRST_NAME')" class="btn btn-xs btn-danger m-l-5" title="Delete Unpaid Account"><i class="fa fa-trash"></i></a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

