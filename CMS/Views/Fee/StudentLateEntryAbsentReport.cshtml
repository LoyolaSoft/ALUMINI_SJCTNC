@model CMS.ViewModel.ViewModel.FeeViewModel
@{
    ViewBag.Title = "StudentLateEntryAbsentReport";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<style>
    .alignRight {
        display: flex;
        align-items: center;
        justify-content: end;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Student Late Entry Absent Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Late Entry Absent Report</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Filter Student Late Entry Absent Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Academic Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicyearList, (Model.AcademicyearList != null) ? Model.AcademicyearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "AcademicYear", @data_live_search = "true" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Semester Type</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.SemesterTypeList, (Model.SemesterTypeList != null) ? Model.SemesterTypeList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "SemesterType", @data_live_search = "true" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Shift</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "ShiftList", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Programme Level</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.programmeLevel, (Model.programmeLevel != null) ? Model.programmeLevel : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "programmeLevel", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Programme</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "ProgramName", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Class Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassYearList, (Model.ClassYearList != null) ? Model.ClassYearList : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "ClassYearList", @data_live_search = "true", data_actions_box = "true", multiple = "multiple" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Class Name</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "ClassName", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="btnGet" class="btn btn-sm btn-primary">Get</button>
                        </div>
                        <div class="col-md-6 text-right">
                            <button type="button" class="btn btn-sm btn-success btnPrint" onclick="printDiv('dvStudentBind')"> Print </button>
                            <button type="button" class="btn btn-sm btn-primary btnExport" onclick="Export()"> Export </button>
                        </div>
                    </div>
                    
                    <hr />
                    <div class="col-md-12 table-responsive">
                        <div id="dvStudentBind"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        var defaultAcYear = '@ViewBag.ActiveAcademicYear';
        var defaultSemType = '@ViewBag.ActiveSemesterType';

        if (defaultAcYear != '') {
            $('#AcademicYear').val(defaultAcYear);
        }
        if (defaultSemType != '') {
            $('#SemesterType').val(defaultSemType);
        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');

        // Initial default load
        loadGrid();
    });

    function ContentLoad() {
        // dynamic onload
    }

    $("#btnGet").on("click", function () {
        loadGrid();
    });

    $("#ProgramName, #ClassYearList").on("change", function () {
        FetchClass();
    });

    $("#ShiftList, #programmeLevel").on("change", function () {
        fetchProgramme();
        FetchClass();
    });

    function FetchClass() {
        var ProgramName = String($("#ProgramName").val());
        var classyear = String($("#ClassYearList").val());
        var sShift = String($("#ShiftList").val());
        if ($("#ClassYearList").val() && $("#ShiftList").val() && $("#ProgramName").val()) {
            $.ajax({
                url: "@Url.Action("BindDDLClassListbyClassYear", "Fee")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                success: function (data) {
                    $("#ClassName").empty();
                    $("#ClassName").append(data);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (error) {
                    alert('Internal Server Error while fetching classes!');
                }
            });
        }
    }

    function fetchProgramme() {
        var sShift = String($("#ShiftList").val());
        var pLevel = String($("#programmeLevel").val());
        if ($("#ShiftList").val() && $("#programmeLevel").val()) {
            $.ajax({
                url: "@Url.Action("GetProgramByShiftclasslevel", "Fee")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift, programmeLevel: pLevel },
                success: function (data) {
                    $("#ProgramName").empty();
                    $("#ProgramName").append(data);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (error) {
                    alert('Internal Server Error while fetching programmes!');
                }
            });
        }
    }

    function loadGrid() {
        var ClassId = String($('#ClassName').val());
        var acYear = $('#AcademicYear option:selected').text();
        var semType = $('#SemesterType').val();

        if (acYear != null && acYear != "" && semType != null && semType != "") {
            $.ajax({
                url: '@Url.Action("BindStudentLateEntryAbsentReport", "Fee")',
                data: { sAcademicYear: acYear, sSemesterType: semType, sClassId: ClassId },
                success: function (result) {
                    var container = $('#dvStudentBind');
                    container.empty();
                    container.append(result);
                },
                error: function (xhr, textStatus, error) {
                    alert("Error loading report: " + error + "\n");
                }
            });
        }
    }

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Fee/StudentLateEntryAbsentReport');
    }

    function Export() {
        var title = "Student_Late_Entry_Absent_Report";
        let file = new Blob([$('#dvStudentBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
    }
</script>
