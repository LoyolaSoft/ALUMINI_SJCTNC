 @model CMS.ViewModel.ViewModel.FeeViewModel

@{
    Layout = null;
}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Late Fee</a></li>
        <li class="active"> Offline Fee Collection </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Offline Fee Collection <small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> Offline Fee Collection </h4>
        </div>
        <div class="panel-body table-responsive">
            <div class="form-horizontal">
                <div class="col-md-12 form-group">
                    <div class="col-md-5">
                        @Html.Label("Roll No", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <input type="text" class="form-control" id="txtRollNo" onchange="LoadData()" />
                        </div>
                    </div>
                </div>

                <div class="col-md-12 form-group">
                    <div id="dvBindGateFee"></div>
                </div>
                <div class="col-md-12 form-group">
                    <a class="btn btn-primary" id="btnSubmit" onclick="SubmitData()"> Submit </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function LoadData()
    {
        $('#dvBindGateFee').empty();
        if ($('#txtRollNo').val()) 
        {
            $.ajax({
                url:'@Url.Action("BindStudentLateFeeInfo", "Fee")',
                method:'POST',
                datatype:'json',
                data: { sRollNo: $('#txtRollNo').val().replace("*","") },
                success:function (data) 
                {
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }else
                    {
                        $('#dvBindGateFee').append(data);
                    }
                },error:function (error) 
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }

    function SubmitData()
    {

    }

    function FetchFeeStudentInfo(FrequencyId,StudentId)
    {
        $.ajax({
            url: '@Url.Action("BindStudentLateFeeInfo", "Fee")',
            method: 'POST',
            datatype: 'json',
            data: { sStudentId: StudentId,sFrequenctId: FrequencyId },
            success: function (data) {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                } else
                {
                    $('#dvBindGateFee').append(data);
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>