@model CMS.ViewModel.ViewModel.FeeStructureViewModel
@{
    ViewBag.Title = "FeeStudentAccountCreation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
    <style>
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            margin: 0;
        }
    </style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Fee Student Account Creation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Fee Student Account Creation</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Fee Student Account Creation</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.AcademicyearList, "Academic Year", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.AcademicyearList, (Model.AcademicyearList != null) ? Model.AcademicyearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicyearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.FrequencyList, "Frequency List", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.FrequencyList, (Model.FrequencyList != null) ? Model.FrequencyList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.FrequencyList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ClassYearList, "Programme Year", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ClassYearList, (Model.ClassYearList != null) ? Model.ClassYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                       

                    </div>
                    <div class="form-group  col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgrammeGroupList, "Programme List", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ProgrammeGroupList, (Model.ProgrammeGroupList != null) ? Model.ProgrammeGroupList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeGroupList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                </div>
                <div class="col-md-12">
                    <a class="btn bg-green pull-right m-b-5 disabled" id="btnview" title="View Fee Structure" style="cursor:pointer" href="javascript:;" onclick="loadContent('/Fee/AddOrEditFeeStructure')" @*href="@Url.Action("AddOrEditFeeStructure","Fee")"*@>View Fee Structure</a>
                </div>
                @*<div>
                        <div class="col-md-12">
                            <a class="btn btn-success pull-right form-group m-b-5" href="@Url.Action("Assignment","TaskManagement")"><i class="fa fa-plus" title="Add"> Add</i></a>
                        </div>
                    </div>*@
                <div class="col-md-12 table-responsive">
                    <div id="dvStudentBind"></div>
                </div>
                <div class="col-md-12">
                    <a class="btn bg-blue pull-right m-b-5 disabled"  title="Bulk Fee Creation" style="cursor:pointer" id="btnSave" href="#">Bulk Fee Creation</a>
                </div>
            }
        </div>

    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
    <script>
        $('.selectpicker').selectpicker({
            size: 4
        });
    </script>
    <script>
        var table;
        function ContentLoad()
        {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });
            
        }
        //$(document).ready(function () {
            
        //});
        $('#ProgrammeGroupList').on('change', function () {
            loadGird();
        });
        $('#FrequencyList').on('change', function () {
            loadGird();
        });
        $('#ClassYearList').on('change', function () {
            loadGird();
        });
        $('#AcademicyearList').on('change', function () {
            var vAcademicyear = $('#AcademicyearList option:selected').text();
         $('#dvStudentBind').empty();
            $('#btnview').addClass("disabled");
            $('#btnSave').addClass("disabled");
            $.ajax({
                url: '@Url.Action("FetchFrequencyByAcademicYear", "Fee")',
                data: { Academicyear: vAcademicyear },
                success: function (objResult) {
                    $('#FrequencyList').empty();
                    $('#FrequencyList').append('<option value="0">-- select --</option>' + objResult.sResult);
                    $("#ClassList").val($("#ClassList option:first").val());
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        });
        function loadGird() {
            var vProgrammeGroupId = $('#ProgrammeGroupList').val();
            var vClassYearId = $('#ClassYearList').val();
            var vAcademicyear = $('#AcademicyearList option:selected').text();
           // var vFrequency = $('#FrequencyList').val();
            $('#btnview').removeClass("disabled");
            $('#btnSave').removeClass("disabled");
            //vFrequency != 0 &&
            if (vAcademicyear != 0 && vClassYearId != 0 && vProgrammeGroupId != 0) {
                $.ajax({
                    url: '@Url.Action("BindStudentsByAcademicYearAndClassId", "Fee")',
                    //sFrequency: vFrequency,
                    data: { sProgrammeGroupId: vProgrammeGroupId,  sClassYearId: vClassYearId, Academicyear: vAcademicyear},
                    success: function (option) {
                        var dvFeeStructureBind = $('#dvStudentBind');
                        dvFeeStructureBind.empty();
                        dvFeeStructureBind.append(option);
                        table = $("#StudentList").DataTable({ "bPaginate": false });//{ "bPaginate": false }
                        $("#StudentList_filter").addClass("dataTables_filter pull-right");
                        $(".pagination").addClass("pagination pull-right");
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });

            } else {
                $('#dvStudentBind').empty();
                $('#btnview').addClass("disabled");
                $('#btnSave').addClass("disabled");
                $('.selectpicker').selectpicker('refresh');
                return false;
            }
        }
      
        $('#btnSave').on('click', function () {
            var StudentId;
            var JsonData;
                                  
            var vProgrammeGroupId = $('#ProgrammeGroupList').val();
            var vClassYearId = $('#ClassYearList').val();
            var vAcademicyear = $('#AcademicyearList option:selected').text();
            var vFrequency = $('#FrequencyList').val();
            if (!confirm('Are you sure to Create Account for selected student(s) to ' + vAcademicyear + ' Academicyear ?')) {
                return false;
            }
            $('#StudentList tbody tr').each(function () {
                $(this).find('td').each(function () {
                    var chkBox = $(this).find('input[type="checkbox"]');
                    if (chkBox.is(':checked')) {
                        StudentId = '"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '"';
                    }
                });
            });
            if (StudentId == null) {
                alert('Please select the student to create account...!!!');
                return false;
            }
            var Search = $('input[type="search"]').val();
            if (Search == '') {
                if (vFrequency != 0 && vAcademicyear != 0 && vClassYearId != 0 && vProgrammeGroupId != 0) {
                    JsonData = '{"StudentAccountList":[';
                    $('#StudentList tbody tr').each(function () {
                        $(this).find('td').each(function () {
                            var chkBox = $(this).find('input[type="checkbox"]');
                            if (chkBox.is(':checked')) {
                                JsonData += '{"' + "STUDENT_ID" + '":"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '"},';

                            }
                        });
                    });
                    JsonData = JsonData.slice(0, -1);
                    JsonData +=
                    ']}';
                    $.ajax({
                        url: "@Url.Action("SaveOrUpdateFeeStudentAccount", "Fee")",
                        method: "POST",
                        data: { sFeeStructure: JsonData, sProgrammeGroupId: vProgrammeGroupId, sFrequency: vFrequency, sClassYearId: vClassYearId, Academicyear: vAcademicyear },
                        success: function (objResult)
                        {
                            if (objResult.ErrorCode == "200")
                            {
                                myAlert(objResult.Message, 'gritter-success', '');
                            } else
                            {
                                myAlert(objResult.Message, 'gritter-danger', '');
                            }
                            loadGird();
                        }, error: function (error) {
                            alert('Internal Server Error ..!');
                        }
                    });
                }
                else {
                    alert('Please Enter Correct Values...!!!');
                    return false;
                }
            } else {
                alert('Please Clear the Search Box...!!!');
                return false;
            }
        });
        // Handle click on "Select all" control
        //$('#AllchkID').on('click', function () {
        //    // Get all rows with search applied
        //    alert();
        //    var rows = table.rows({ 'search': 'applied' }).nodes();
        //    // Check/uncheck checkboxes for all rows in the table
        //    $('input[type="checkbox"]', rows).prop('checked', this.checked);
        //});

        

        SelectOrUnselect = function () {                   
          if (AllchkID.checked == true) {
              $('#StudentList tbody tr').each(function () {
                  $(this).find('input[type="checkbox"]').each(function () {
                      $('input[type="checkbox"]').attr("checked", true);
                  });
              });
          }
          else {
              $('#StudentList tbody tr').each(function () {
                  $(this).find('input[type="checkbox"]').each(function () {
                      $('input[type="checkbox"]').attr("checked", false);
                  });
              });
          }
        }
        function ListSelectedStudentFeeAccount(StudentId) {
            var vAcademicyear = $('#AcademicyearList option:selected').text();
            var FrequencyId = $('#FrequencyList').val();
            $.ajax({
                url: "@Url.Action("FetchSelectedStudentFeeAccount", "Fee")",
                method: "POST",
                datatype: "html",
                data: { sStudentId: StudentId, Academicyear: vAcademicyear, sFrequencyId: FrequencyId },
                success: function (Option) {
                    var divHtml = $('#SelectedStudentFeeAccount');
                    divHtml.empty();
                    divHtml.html(Option);
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    </script>

<div class="modal fade" id="ViewFeeStudentAccount-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-orange-lighter">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <p class="modal-title f-s-15 f-w-200 text-white">View Student Fee Account</p>
            </div>
            <div class="modal-body">
                <div class="from-group" id="SelectedStudentFeeAccount"></div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>