@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{int count = 0;}
<div class="table-responsive">
    <table class="table table-hover table-bordered" id="tblHostelFeeCollection">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Roll No</th>
                <th>Class</th>                
                <th>Hostel</th>
                <th>PaymentDate</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFeeStudentAccount != null & Model.liFeeTransaction!=null)
            {
                foreach (var item in Model.liFeeStudentAccount)
                {
                    var PayMents = Model.liFeeTransaction.Where(s => s.STUDENT_ID == item.STUDENT_ID ).ToList();
                    <tr>
                        <td>@{ count++;}@count</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.CLASS_CODE</td>
                        <td>@item.HOSTEL_NAME</td>
                        <td>@{ if (PayMents != null && PayMents.Count() > 0)
                            { @PayMents.FirstOrDefault().PAYMENT_DATE;
                            }}</td>                        
                        <td>@item.CREDIT</td>
                        <td>@item.STATUS</td>
                    </tr>
                                }
                            }
        </tbody>
    </table>
</div>