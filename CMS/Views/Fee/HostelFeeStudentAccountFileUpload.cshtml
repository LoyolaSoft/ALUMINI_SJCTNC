<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }

    .dueListDiv {
        border: 2px solid #097272;
        display: flex;
        justify-content: center;
        text-align: center;
        padding-top: 6px;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Fee Due List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Fee Due List</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Fee Due List</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @*<div class="col-md-12">
                        <a class="btn bg-blue pull-right m-b-5" title="Add Fee Due List" style="cursor:pointer" id="btnload" href="#" onclick="loadContent('/Fee/UpdateStudentFeeDueDetails')">Update Due List</a>
                    </div>*@
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-6 dueListDiv ">
                            <div class="col-md-6">

                                <a href="#HeadWiseFeeDueFileUPload" class="btn bg-primary pull-right m-b-5 " data-toggle="modal" title="View"><i class="fa fa-file-excel-o bg-primary"></i>Hostel Fee Due Upload</a>
                            </div>
                            <div class="col-md-4">
                                <a href="~/Content/ExcelTemplate/Hostel_Fee_due_template.xlsx" class="btn bg-warning pull-right m-b-5 " data-toggle="modal" title="View"><i class="fa fa-file-excel-o bg-warning"></i> Excel Template</a>
                            </div>
                        </div>
                        <div class="text-center col-md-3 pull-right">
                            <a href="~/FeeDueFileLog/@currentDate" class="btn bg-danger  m-b-5 " data-toggle="modal" title="View" target="_blank"><i class="fa fa-file-text-o bg-danger"></i> Download Error Log</a>

                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="form-group col-md-12">

                        <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="control-label col-md-5">Academic Year</label>
                        <div class="col-md-7">
                            @Html.DropDownListFor(model => model.liAcademicYear, (Model.liAcademicYear != null) ? Model.liAcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.liAcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>


                </div>
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="col-md-12" id="divbind">

                    </div>
                </div>
                <br />

                <div id="bindAcYearWiseHostelFeeList">
                    <div class="col-md-12 table-responsive" id="mainContent">
                        <table class="table table-hover table-bordered" width="100%" id="StudentList">
                            <thead>
                                <tr>
                                    <th><b>#</b></th>
                                    <th><b>Roll No</b></th>
                                    <th><b>First Name</b></th>
                                    <th><b>Class Name</b></th>
                                    <th><b>Head</b></th>
                                    <th><b>To Pay</b></th>
                                    <th><b>Paid</b></th>
                                    <th><b>Balance</b> </th>
                                    <th><b>Action</b></th>
                                </tr>

                            </thead>
                            <tbody>
                                @if (Model.liFeeDueReport != null)
                                {
                                    foreach (var item in Model.liFeeDueReport)
                                    {
                                        <tr>
                                            <td>
                                                @{ count++;} <b>@count</b>
                                            </td>

                                            <td>
                                                @item.ROLL_NO
                                            </td>
                                            <td>
                                                @item.FIRST_NAME
                                            </td>
                                            <td>
                                                @item.CLASS_NAME
                                            </td>
                                            <td>@item.HEAD_CODE</td>
                                            <td>
                                                @item.CREDIT
                                            </td>
                                          
                                            <td>@item.DEBIT</td>
                                            @if (item.BALANCE == "0")
                                            {
                                                <td><b>Paid</b></td>
                                            }
                                            else
                                            {
                                                <td>
                                                    @item.BALANCE
                                                </td>
                                            }
                                            <td>
                                                <a href="#EditFeeDueDetails" onclick="FetchFeeDueDetailsByID(@item.F_STUDENT_AC_ID);" data-toggle="modal" title="View"><i class="fa fa-edit text-primary"></i></a>

                                                <a onclick="DeletedDueList(@item.F_STUDENT_AC_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="modal" id="EditFeeDueDetails">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <h4 class="modal-title">Edit Fee Due Details</h4>
                    </div>
                    <div class="modal-body" data-parsley-validate="true" id="IQACProject">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="col-md-12 form-horizontal">
                                            <input id="txtF_STUDENT_AC_ID" hidden />
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">Roll No</label>
                                                <div class="col-md-8">
                                                    <input type="text" id="txtROLL_NO" class="form-control" placeholder="Roll No" disabled>
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label"> First Name</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="txtFIRST_NAME" class="form-control" placeholder=" First Name" disabled>
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">To Pay</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="txtCREDIT" oninput="numberOnly(this.id);" class="form-control" placeholder="To Pay">
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">Paid</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="txtDEBIT" oninput="numberOnly(this.id);" class="form-control" placeholder="Paid">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" id="btnSubmit" onclick="UpdateData()" class="btn btn-sm btn-primary">Submit</a>
                        <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
                <input type="hidden" id="AchievementID" value="" />
            </div>
        </div>
        <div class="modal fade" id="HeadWiseFeeDueFileUPload">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-orange-lighter">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <p class="modal-title f-s-15 f-w-200 text-white">Hostel Fee Due Amount Update </p>
                    </div>
                    <div class="modal-body">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group col-md-12">
                            @Html.Label("Status", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" id="PaymentStatus">
                                    <option value="0">--- Select --- </option>
                                    <option value="1">Paid Amount</option>
                                    <option value="2">Pay Amount</option>

                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group col-md-12">
                                @Html.Label("Upload", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="file" class="btn btn-primary" id="HeadExcelUpload" required />
                                    @*<a class="btn btn-primary" onclick="ClickFile()">File</a>*@
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" class="btn btn-sm btn-success" data-dismiss="modal" id="" onclick="SaveHostelFeeFile()">Submit</a>
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


