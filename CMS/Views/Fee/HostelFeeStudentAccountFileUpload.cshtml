        // Reload table when academic year dropdown changes
        $('#liAcademicYear').on('change', function () {
            var selectedText = $(this).find('option:selected').text().trim();
            if (!selectedText || selectedText === '--select--') return;

            var table = $('#StudentList').DataTable();
            table.clear().draw();

            $.ajax({
                url: '/Fee/GetHostelFeeDueByAcYear',
                type: 'POST',
                data: { sAcademicYear: selectedText },
                success: function (res) {
                    if (!res.Success) {
                        alert(res.Message || 'Failed to load data.');
                        return;
                    }
                    var rows = res.Data || [];
                    var count = 0;
                    $.each(rows, function (i, item) {
                        count++;
                        var balance = (item.BALANCE === '0' || item.BALANCE === '0.00')
                            ? '<b>Paid</b>'
                            : (item.BALANCE || '');
                        var actions = '<a href="#EditFeeDueDetails" onclick="FetchFeeDueDetailsByID(\'' + item.F_STUDENT_AC_ID + '\')" data-toggle="modal" title="Edit"><i class="fa fa-edit text-primary"></i></a>' +
                            ' <a onclick="DeletedDueList(\'' + item.F_STUDENT_AC_ID + '\')" title="Delete"><i class="fa fa-trash text-danger"></i></a>';
                        table.row.add([
                            '<b>' + count + '</b>',
                            item.ROLL_NO || '',
                            item.FIRST_NAME || '',
                            item.CLASS_NAME || '',
                            item.HEAD_CODE || '',
                            item.CREDIT || '',
                            item.DEBIT || '',
                            balance,
                            actions
                        ]);
                    });
                    table.draw();
                },
                error: function () {
                    alert('An error occurred while loading the student list.');
                }
            });
        });

</script>
