
@model CMS.ViewModel.ViewModel.FeeViewModel
@{
    ViewBag.Title = "StudentLateEntryReport";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<style>
    .alignRight {
        display: flex;
        align-items: center;
        justify-content: end;
    }
</style>
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken()
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">CITS Report</li>
    </ol>
    <h2 class="page-header">Student Late Entry Report </h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Late Entry Report</h4>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-12">
                    <ul class="nav nav-tabs">
                        <li class="nav-items active">
                            <a href="#bindDateWiseReport" data-toggle="tab" class="nav-link active">
                                <span class="d-sm-none">Date Wise</span>
                                @*<span class="d-sm-block d-none">Report</span>*@
                            </a>
                        </li>
                        <li class="nav-items">
                            <a href="#bindStaffWiseReport" data-toggle="tab" class="nav-link">
                                <span class="d-sm-none">Class Wise</span>
                                @*<span class="d-sm-block d-none">Report</span>*@
                            </a>
                        </li>
                        
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade" id="bindDateWiseReport">
                            <div class="form-horizontal">
                                <div class="col-md-12">
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">From Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="datetimepicker1">
                                                <input class="form-control" id="Datefrom" placeholder="Pick Date" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">To Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="datetimepicker1">
                                                <input class="form-control" id="Dateto" placeholder="Pick Date" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <a href="javascript:;" id="btnGetDateWise" class="btn btn-sm btn-primary m-b-10 pull-right"> Get</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="bindStaffWiseReport">
                            <div class="form-horizontal">
                                <div class="col-md-12">
                                    <div class="form-group col-md-4">
                                        @Html.LabelFor(model => model.ClassList, htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-9">
                                            <div class=" form-group">
                                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker methodologyId", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple", @data_parsley_required = "true" })
                                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    

                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="bindOverAllReportAchor">

                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group col-lg-12">
                <div id="divbindPage">
                    <!--Need to use this fied to bind Student List-->
                </div>
            </div>
        </div>
    </div>
}
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        $('#bindDateWiseReport').addClass("active in");
        $('.nav-items').on("click", function () {

            $('#divbindPage').html('');

        });
        var todayDate = new Date();
        var day = todayDate.getDate();
        var month = todayDate.getMonth() + 1;
        var year = todayDate.getFullYear();
        if (day < 10) {
            day = '0' + day
        }
        if (month < 10) {
            month = '0' + month;
        }
        var formatDate = day + '/' + month + '/' + year;
        document.getElementById('Datefrom').value = formatDate;

    });
    function ContentLoad() {
        $(document).ready(function () {
            handleDatepicker = function () {
                "use strict";
                $("#Datefrom").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
                $("#Dateto").datepicker({
                    todayHighlight: true,
                    autoclose: !0,
                    format: "dd/mm/yyyy",
                    orientation: "right bottom"
                    // 'top': top,
                    // 'left': left
                }
                )
            }
            handleDatepicker();
        });
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>
<script>
    function Validate() {
        $("#Dateto").rules('add', { greaterThan: "#Datefrom" });
    }

    $("#btnGetDateWise").on('click', function () {
            var DateFrom = $("#Datefrom").val();
        var DateTo = $("#Dateto").val();
        if (DateFrom != null && DateFrom != "" && DateTo != null && DateTo != "") {
                $.ajax({
                    url: '@Url.Action("BindStuLateEntryReportDateWise", "Fee")',
                    data: { sdate: DateFrom, edate: DateTo },
                    success: function (option) {
                        var dvDateWiseStudentPaidStatus = $('#divbindPage');
                        dvDateWiseStudentPaidStatus.empty();
                        dvDateWiseStudentPaidStatus.append(option);

                        $("#tbltpmReport").DataTable({
                            dom: "lBfrtip", buttons: [{
                                extend: "copy", className: "btn-sm"
                            }
                            , {
                                extend: "excel", className: "btn-sm"
                            }
                            , {
                                extend: "pdf", className: "btn-sm"
                            }
                            ], responsive: !0, "paging": true, "ordering": true
                        });
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
    });

    $("#").on("change", function ()
{
        var ClassID = String($("#ClassList").val());

    $.ajax({
        url:"@Url.Action("FetchttCourseByClassID", "TimeTable")",
        method: "POST",
        datatype: "html",
        data: { sClassID: ClassID },
        success: function (data)
        {
            var select = $("#CourseList");
            select.empty();
            if (data.sResult != null && data.sResult != '')
            {
                select.append( data.sResult);
            } else {
                myAlert(data.Message, 'gritter-danger', '');
            }
            $('#CourseList').selectpicker('refresh');
        },error:function(error)
        {
            myAlert('Internal Server Error ...!', 'gritter-danger', '');
        }
    });
    });


    $("#ClassList").on('change', function () {
        var ClassID = String($("#ClassList").val());
        
        if (ClassID != null && ClassID != "") {
            $.ajax({
                url: '@Url.Action("BindStuLateEntryReportClassWise", "Fee")',
                data: { ClassId: ClassID },
                success: function (option) {
                    var dvDateWiseStudentPaidStatus = $('#divbindPage');
                    dvDateWiseStudentPaidStatus.empty();
                    dvDateWiseStudentPaidStatus.append(option);

                    $("#tbltpmReport").DataTable({
                        dom: "lBfrtip", buttons: [{
                            extend: "copy", className: "btn-sm"
                        }
                        , {
                            extend: "excel", className: "btn-sm"
                        }
                        , {
                            extend: "pdf", className: "btn-sm"
                        }
                        ], responsive: !0, "paging": true, "ordering": true
                    });
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    });
   

</script>
<script>
   
    function printDiv(divName) {
        var table = $('#tbltpmReport').DataTable();
        table.destroy();
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Fee/StudentLateEntryReport');
    }
    function btnexport(divname) {

        let file = new Blob([$(divname).html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "LateEntryList.xlsx"
        }).appendTo("body").get(0).click();
        e.preventDefault();

    }
</script>








