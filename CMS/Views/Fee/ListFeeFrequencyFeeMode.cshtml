@model CMS.ViewModel.ViewModel.FeeFrequencyFeeModeViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "ListFeeFrequencyFeeMode";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Fee</a></li>
        <li class="active">Fee Frequency Fee Mode List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Fee Frequency Fee Mode List<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Fee Frequency Fee Mode List</h4>
                </div>
                <div class="panel-body">
                    <div class="col-lg-12 m-b-5"><a class="btn btn-success pull-right" title="Add Sup Head" data-toggle="modal" href="#Head-dialog"><i class="fa fa-plus"></i> Add </a></div>
                    <div class="" id="dvLoadFeeheads">
                        <div class="col-lg-12 table-responsive">
                            <table class="table table-hover table-bordered" id="tblHead">
                                <thead>
                                    <tr>
                                        <th>S.No</th>
                                        <th>Frequency</th>
                                        <th>Fee Mode</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int count = 0; }
                                    @if (Model.FeeFrequencyFeeModeList != null)
                                    {
                                        foreach (var item in Model.FeeFrequencyFeeModeList)
                                        {
                                            <tr>
                                                <td>@{count++;}@count</td>
                                                <td>@item.FREQUENCY_NAME</td>
                                                <td>@item.FREQUENCY_TYPE</td>
                                                <td><a onclick="DeleteProgram('@item.FEE_FREQUENCY_FEE_MODE_ID')"><i class="fa fa-trash text-danger"></i></a></td>
                                            </tr>
                                                        }
                                                    }


                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
                                                    }
</div>
<div class="modal" id="Head-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        
                        
                        <div class="form-group">
                            <label class="control-label col-md-3">Fee Mode</label>
                            <div class="col-md-9">
                                @Html.DropDownList("Frequency", (Model.SupFrequency != null) ? new SelectList(Model.SupFrequency, Common.SUP_FEE_FREQUENCY.FREQUENCY_ID, Common.SUP_FEE_FREQUENCY.FREQUENCY_NAME) : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Main Head</label>
                            <div class="col-md-9">
                                @Html.DropDownList("FeeMode", (Model.SupFeeMode != null) ? new SelectList(Model.SupFeeMode, Common.SUP_FREQUENCY_TYPE.FREQUENCY_TYPE_ID, Common.SUP_FREQUENCY_TYPE.FREQUENCY_TYPE) : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true",@multiple="multiple" })
                            </div>
                        </div>
                        <input type="hidden" name="name" id="hdHidden" value="" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSave" class="btn btn-sm btn-primary" data-dismiss="modal">Save</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

    <script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        $("#tblHead").DataTable();
        $('.selectpicker').selectpicker({
            size: 3
        });
        $('#SubHead').selectpicker('refresh');
        function DeleteProgram(id) {
            if (!confirm('Are you sure to delete this record ?')) {
                return false;
            }
            $.ajax({
                url: "@Url.Action("", "Fee")",
                async: false,
                data: { sFeeMainHead: id },
                success: function (objResult)
                {
                    alert(objResult.Message + "\n");
                    loadContent('/Fee/ListFeeFrequencyFeeMode');
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            });
        }
        $('#FeeMode').change(function () {
            if ($("#Frequency").val() == '') {
                alert('Please Select Shift And Programme Mode...!!!');
                $("#Frequency").val($("#FeeMode option:first").val());
            }
            $('.selectpicker').selectpicker('refresh');
        });
        function loadFeeFrequencyFeeModeList()
        {
            $.ajax({
                url: "@Url.Action("LoadFeeMainHead", "Fee")",
                async: false,
                success: function (objResult)
                {
                    $('#dvLoadFeeheads').empty().append(objResult);
                    $("#tblProgrammeHeads").DataTable();
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            });
        }

        $('#btnSave').click(function ()
        {
            var FrequencyId = $('#Frequency').val();
            var HeadIds = String($('#FeeMode').val());
            var subFeeModeArray = HeadIds.split(",");
            if (FrequencyId == '' || HeadIds == '')
            {
                alert('Please provide valid inputs..!');
                return false;
            }
            var nCount = 0;
            var jsonInput = '[';
            for (var i = 0; i < subFeeModeArray.length; i++)
            {
                jsonInput += '{"FREQUENCY_ID":"' + FrequencyId + '","FEE_MODE":"' + subFeeModeArray[i] + '"},';
                nCount++;
            }
            if (nCount != 0)
            {
                jsonInput = jsonInput.slice(0, -1);
                jsonInput = jsonInput + "]";
            } else
            {
                alert('Please provide valid inputs..!');
                return false;
            }
            
            $.ajax({
                url: "@Url.Action("SaveFeeFrequencyMode", "Fee")",
                async: false,
                data: { sJsonFeeFrequencyFeeMode: jsonInput },
                success: function (objResult)
                {
                     alert(objResult.Message);
                        
                     loadContent('/Fee/ListFeeFrequencyFeeMode');
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            });
        });
        $('#Frequency').change(function ()
        {
            $.ajax({
                url: "@Url.Action("LoadFeeMode", "Fee")",
                async: false,
                data: { sFrequencyId: $(this).val() },
                success: function (objResult)
                {
                    $('#FeeMode').empty().append(objResult.sResult).selectpicker('refresh');
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            });

        });

    </script>


