@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{Layout = null; int count = 0;}
<table class="table table-hover table-bordered" width="100%" id="StudentList">
    <thead>
        <tr>
            <th>#</th>
            <th>
                <div class="checkbox checkbox-css">
                    <input type="checkbox" value="" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" />
                    <label for="AllchkID"></label>
                </div>
            </th>
            <th>Shift</th>
            <th>Programme Mode</th>
            <th>Roll No</th>
            <th>Register No</th>
            <th>First Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.lstStudentPersonalInfo != null)
            {
                foreach (var item in Model.lstStudentPersonalInfo)
                {
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>
                        <div class="checkbox checkbox-css checkbox-inline">
                            <input type="checkbox" name="myTextEditBox" id="@item.STUDENT_ID" cms-studentid="@item.STUDENT_ID"/>
                            <label for="@item.STUDENT_ID"></label>
                        </div>
                    </td>
                    <td>@item.SHIFT_NAME</td>
                    <td>@item.PROGRAMME_MODE</td>
                    <td>
                        @item.ROLL_NO
                    </td>
                    <td>
                        @item.REGISTER_NO
                    </td>
                    <td>
                        @item.FIRST_NAME
                    </td>
                    <td>
                        <a href="#ViewFeeStudentAccount-dialog" onclick="ListSelectedStudentFeeAccount(@item.STUDENT_ID);" data-toggle="modal" title="View"><i class="glyphicon glyphicon-eye-open text-primary"></i></a>
                    </td>
                </tr>
                                }
                            }
    </tbody>
</table>
