
@model CMS.ViewModel.ViewModel.FeeTransactionViewModel

@using System.Globalization;

@{
    ViewBag.Title = "BindStudentDueWithPercentageReport";
    Layout = null;
    int count = 0;

}




@if (Model.liFeeDueReport != null && Model.liFeeDueReport.Count > 0)
{
    var liGroupClass = Model.liFeeDueReport.GroupBy(x => x.CLASS_ID).ToList();
    foreach (var ClassItem in liGroupClass)
    {

        <div style="page-break-after:always !important;">
            <table class="table table-hover table-bordered" width="100%" id="StudentList">
                <thead>
                    <tr>
                        <th><b>#</b></th>
                        <th><b>Roll No</b></th>
                        <th><b>First Name</b></th>
                        <th><b>Class Name</b></th>
                        <th><b>Balance</b> </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var GroupClassList = Model.liFeeDueReport.Where(x => x.CLASS_ID == ClassItem.FirstOrDefault().CLASS_ID).ToList();

                        foreach (var item in GroupClassList)
                        {
                            <tr>
                                <td>
                                    @{ count++;} <b>@count</b>
                                </td>
                                <td>
                                    @item.ROLL_NO
                                </td>
                                <td>
                                    @item.FIRST_NAME
                                </td>

                                <td>@item.CLASS_NAME</td>
                                <td>
                                    @if (ViewBag.FeeType == "1")
                                    {
                                        if (@item.EXAMFEE1DUE != "0")
                                        {

                                            @item.EXAMFEE1DUE
                                        }
                                        else
                                        {
                                            <b>paid</b>
                                        }
                                    }
                                    else
                                    {
                                        if (@item.EXAMFEE2DUE != "0")
                                        {

                                            @item.EXAMFEE2DUE
                                        }
                                        else
                                        {
                                            <b>paid</b>
                                        }
                                    }

                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

    }
}