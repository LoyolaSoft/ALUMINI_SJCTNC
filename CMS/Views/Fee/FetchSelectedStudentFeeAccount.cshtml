@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{Layout = null; int count = 0;}
@if (Model.liFeeStudentAccount != null && Model.lstStudentPersonalInfo != null)
{
    <table width="100%" id="StudentInfoList">
            <tr>
                <th>Name</th>
                <th>@Model.lstStudentPersonalInfo.FirstOrDefault().FIRST_NAME</th>
                <th>Roll No</th>
                <th>@Model.lstStudentPersonalInfo.FirstOrDefault().REGISTER_NO</th>
            </tr>
    </table>
    <br>
}

@if (Model.liFeeStudentAccount != null)
{
    <table class="table table-hover table-bordered" width="100%" id="StudentList">
        <thead>
            <tr>
                <th>#</th>
                <th>Head</th>
                <th>Total Amount</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liFeeStudentAccount)
            {
            <tr>
                <td>
                    @{ count++;}@count
                </td>
                <td>@item.HEAD</td>
                <td><i class="fa fa-inr"></i>@item.CREDIT</td>
                <td>
                    <i class="fa fa-inr"></i>@item.BALANCE
                </td>
            </tr>
            }
        </tbody>
    </table>
                        }