@model CMS.ViewModel.ViewModel.FeeReportViewModel

@{ 
    Layout = null;
    int count = 0;
}


<div class="form-group table-responsive" id="dvPrint">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Admission No</th>
                <th>Name</th>
                <th>Payment Date</th>
                <th>Payment Mode</th>
                <th>Collected</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFeeReport != null && Model.liFeeReport.Count > 0)
            {
                foreach (var item in Model.liFeeReport)
                {
                    <tr>
                        <td>@{count++;} @count</td>
                        <td>@item.ADMISSION_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.PAYMENT_DATE</td>
                        <td>@item.PAYMENT_MODE</td>
                        <td><b>₹ @item.COLLECTED</b></td>
                        <td>
                            <a class="fa fa-eye" href="@Url.Action("DaywiseReportByTransactionId","Fee",new {sTransactionId=@item.TRANSACTION_ID } )"></a>
                        </td>
                        
                    </tr>
                 }
             }
             else
             {
                <tr>
                    <td colspan="6"> No Records Available !</td>
                </tr>
             }
        </tbody>
    </table>
</div>

