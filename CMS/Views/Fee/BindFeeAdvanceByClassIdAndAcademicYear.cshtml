@model CMS.ViewModel.ViewModel.FeeAdvancePaymentViewModel
@{Layout = null; int count = 0;}

<div class="">
    <a class="btn bg-green pull-right m-b-5" title="Add Advance Details" data-toggle="modal" style="cursor:pointer" href="#Head-dialog"><i class="fa fa-plus"></i> Add</a>
</div>
<table class="table table-hover table-bordered" id="FeeAdvanceList">
    <thead>
        <tr>
            <th>#</th>
            <th>Roll No</th>
            <th>Name</th>
            <th>Amount Collected</th>
            <th>Debit</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.lstFeeAdvancePayment != null)
            {
                foreach (var item in Model.lstFeeAdvancePayment)
                {
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>
                        @item.ROLL_NO
                    </td>
                    <td>
                        @item.FIRST_NAME
                    </td>
                    <td>
                        @item.COLLECTED
                    </td>
                    <td>
                        @item.DEBIT
                    </td>
                    <td>
                        <a href="javascript:;" onclick="GetConfirm(@item.ADVANCE_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                    </td>
                </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        No Records Available...!!!
                                    </td>
                                </tr>
                            }
    </tbody>
</table>