
@model CMS.ViewModel.Model.TransferCertificate

@{
    ViewBag.Title = "ExamFeeReportForCOE";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<style>
    #examDate{
        background: #1e8b8b;
        padding: 10px;
        color: white;
        font-size: 15px;
    }
</style>
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">Exam Fee Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam Fee Report</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam Fee Report</h4>
        </div>
        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12 form-horizontal">
                <ul class="nav nav-tabs">
                    <li class="nav-items active" id="ExamFeeUpdateDateReport">
                        <a href="#BindExamFeeUpdateDateReport" data-toggle="tab" class="nav-link active">
                            <span class="d-sm-none">Exam Fee Update Date</span>
                        </a>
                    </li>
                    <li class="nav-items" id="FeePaidUnpaidreport">
                        <a href="#BindFeePaidUnpaidreport" data-toggle="tab" class="nav-link">
                            <span class="d-sm-none">Fee Paid unpaid Report</span>
                        </a>
                    </li>
                </ul>
                <div class="tab-content">

                    @* Exam Fee Last Update Date Report *@

                    <div class="tab-pane fade" id="BindExamFeeUpdateDateReport">
                        <div class="form-horizontal text-center">
                            <p id="examDate">The exam fee was last updated on @ViewBag.ExamLastUpdateDate</p>
                        </div>
                        <div class="row pull-right">
                            <div class="col-md-6 btnPrintDiv">
                                <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                            </div>
                            <div class="col-md-6 btnExcelDiv">
                                <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                            </div>
                        </div>
                    </div>

                    @* Exam Fee Paid And Unpaid Report*@

                    <div class="tab-pane fade" id="BindFeePaidUnpaidreport">

                        <div class="form-horizontal">

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="row">
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Academic Year</label>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "EPUAcademicYear" })
                                        @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Shift</label>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "EPUShiftList" })
                                        @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Programme Level</label>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.programmeLevel, (Model.programmeLevel != null) ? Model.programmeLevel : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "EPUprogrammeLevel" })
                                        @Html.ValidationMessageFor(model => model.programmeLevel, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Programme</label>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "EPUProgramName" })
                                        @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Class Year</label>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", data_actions_box = "true", multiple = "multiple", @id = "EPUClassYear" })
                                        @Html.ValidationMessageFor(model => model.ClassYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Class Name</label>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "EPUClassName" })
                                        @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Fee Type</label>
                                    <div class="col-md-8">
                                        <select id="ExamFeeType" class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm">
                                            <option value="0">-- Select --</option>
                                            <option value="1">Exam Fee1</option>
                                            <option value="2">Exam Fee2</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Status</label>
                                    <div class="col-md-8">
                                        <select id="EPUStatus" multiple class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm">
                                            <option value="0">-- Select --</option>
                                            <option value="1">Paid</option>
                                            <option value="2">Not Paid</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row pull-right">
                            <div class="col-md-6 btnPrintDiv">
                                <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                            </div>
                            <div class="col-md-6 btnExcelDiv">
                                <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                            </div>
                        </div>
                    </div>

                    <br />
                </div><br />
                <hr />
                <div class="form-group col-md-12">
                    <div id="divbind"></div>
                </div>
            </div>

        </div>
    </div>
    <!-- end panel -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $('.selectpicker').selectpicker({
        size: 4
    });
    ContentLoad = function () {
        $('#BindExamFeeUpdateDateReport').addClass("active in");

        var sOption = '<option value="">-- Select --</option>';
        $('.selectpicker').selectpicker('refresh');
        $(".btnPrintDiv").hide();
        $(".btnExcelDiv").hide();
        $('.nav-items').on("click", function () {

            $('#divbind').html('');

        });
    }
</script>
<!-- ================== Student Attendace Percentage and Due Report  Script ================== -->

<script>

                            $("#EPUProgramName").on("change", function () {
                                FetchADClass();
                            });
    $("#EPUClassYear").on("change", function () {
                                FetchADClass();
                            });
    function FetchADClass()
                            {
        var ProgramName = String($("#EPUProgramName").val());
        var classyear = String($("#EPUClassYear").val());
        var sShift = String($("#EPUShiftList").val());
        if ($("#EPUClassYear").val() && $("#EPUShiftList").val() && $("#EPUProgramName").val())
                                {
                                    $.ajax({
                                        url: "@Url.Action("BindDDLClassListbyClassYear", "Student")",
                                        method: "POST",
                                        datatype: "json",
                                        data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                                        success: function (data) {
                                            $("#EPUClassName").empty();
                                            $("#EPUClassName").append( data);
                                            $('.selectpicker').selectpicker('refresh');
                                        }, error: function (error) {
                                            alert('Internal Server Error ! ');
                                        }
                                    });
                                }
                            };
    $("#EPUShiftList").on("change", function ()
                            {
                                fetchADProgramme();
                            });
    $("#EPUprogrammeLevel").on("change", function ()
                            {
                                fetchADProgramme();
                            });
    function fetchADProgramme()
                            {
        var sShift = String($("#EPUShiftList").val());
        var pLevel = String($("#EPUprogrammeLevel").val());
        if ($("#EPUShiftList").val() && $("#EPUprogrammeLevel").val())
                                {
                                    $.ajax({
                                        url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                                        method: "POST",
                                        datatype: "json",
                                        data: { sShiftId: sShift, programmeLevel: pLevel },
                                        success: function (data) {
                                            $("#EPUProgramName").empty();
                                            $("#EPUProgramName").append(data);
                                            $('.selectpicker').selectpicker('refresh');
                                        }, error: function (error) {
                                            alert('Internal Server Error ! ');
                                        }
                                    });
                                }
    };

    $("#EPUClassName").on("change", function () {
        LoadExamPaidUnPaidreport();
    });
    $("#EPUAcademicYear").on("change", function () {
        LoadExamPaidUnPaidreport();
    });
    $("#EPUStatus").on("change", function () {
        LoadExamPaidUnPaidreport();
    });
    function LoadExamPaidUnPaidreport()
    {
        var ProgramName = $("#EPUProgramName").val();
        var ClassName = String($("#EPUClassName").val());
        var status = String($("#EPUStatus").val());
        var feeType = $("#ExamFeeType").val();
        var AcademicYear = $('#EPUAcademicYear option:selected').text();
        if ($("#EPUClassName").val() && $('#EPUAcademicYear option:selected').text() && $("#EPUStatus").val())
            {
                if (AcademicYear == '' || AcademicYear == '0') {
                    alert('Please Choose All The Values...!!!');
                    return false;
            }
            $('#loader').show();
                $.ajax({
                    url: "@Url.Action("BindExamFeePaiUnPiadData", "Fee")",
                    method: "POST",
                    datatype: "json",
                    data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear, sStatus: status, feeType: feeType },
                    success: function (data) {
                        $("#divbind").empty();
                        $("#divbind").append(data);
                        $(".btnPrintDiv").show();
                        $(".btnExcelDiv").show();
                        $('#loader').hide();
                    }, error: function (error) {
                        alert('Internal Server Error !');
                        $('#loader').hide();
                    }
                });
            }
    };

    function printDiv() {
        var printContents = document.getElementById('divbind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Fee/ExamFeeReportForCOE');

    }
</script>



<script>

    function Export() {
        var title = "";

        title = "Student_Report";
        let file = new Blob([$('#divbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();

    }

</script>



