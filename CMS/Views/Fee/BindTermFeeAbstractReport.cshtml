@model CMS.ViewModel.ViewModel.FeeTransactionViewModel

@using CMS.ViewModel.Model
@{
    Layout = null;
    string sHeadCount = string.Empty;
    double total = 0;
    double Summainhead = 0;
    int subheadcount = 0;
    double SubmainheadTotal = 0;
}
@{
    <div class="form-group table-responsive" id="dvPrint">
        <table class="table table-bordered table-hover" style="font-family:Cambria; text-align:left;" border="1">
            <thead>
                @if (Model.lstSupMainHead != null && Model.lstSupMainHead.Count > 0)
                {
                    <tr>
                        <th>#</th>
                        <th>Main</th>
                        <th>Count</th>
                        @{
                            var main = Model.lstSupHead.GroupBy(x => x.MAIN_HEAD_ID).ToList();
                            foreach (var item in main)
                            {
                                var suphead = Model.lstSupHead.Where(s => s.MAIN_HEAD_ID == item.FirstOrDefault().MAIN_HEAD_ID).ToList();
                                if (suphead.Count > 1)
                                {
                                    subheadcount = suphead.Count() + 1;
                                }
                                else
                                {
                                    subheadcount = suphead.Count();
                                }
                                <th colspan="@subheadcount">@suphead.FirstOrDefault().MAIN_HEAD</th>
                            }
                        }
                        <th>
                            GrandTotal
                        </th>
                    </tr>
                    <tr>
                        @if (Model.lstSupHead != null && Model.lstSupHead.Count > 0)
                        {
                            <th colspan="3">Sub Head</th>
                            foreach (var item in Model.lstSupMainHead)
                            {
                                var liGroupHeads = Model.lstSupHead.Where(x => x.MAIN_HEAD_ID == item.MAIN_HEAD_ID).ToList();
                                if (liGroupHeads != null && liGroupHeads.Count > 0)
                                {
                                    foreach (var GHitem in liGroupHeads)
                                    {
                                        <th>@GHitem.HEAD</th>

                                    }
                                }
                                else
                                {
                                    <td> - </td>
                                }
                                if (liGroupHeads != null && liGroupHeads.Count > 1)
                                {

                                    <th>Total</th>
                                }
                            }
                            <th> Rs </th>
                        }
                    </tr>
                            }
            </thead>
            <tbody style="border:1px solid black;">
                @if (Model.lstSupMainHead != null && Model.lstSupMainHead.Count > 0 && Model.lstStudentPersonalInfo != null && Model.lstStudentPersonalInfo.Count > 0)
                {
                    var Programmes = Model.liFeeReport.GroupBy(o => o.PROGRAMME_GROUP_ID).ToList();
                    int count = 0;
                    foreach (var Proitem in Programmes)
                    {
                        var ProgrammeStudents = Model.lstStudentPersonalInfo.Where(x => x.PROGRAMME_GROUP_ID == Proitem.FirstOrDefault().PROGRAMME_GROUP_ID).ToList();
                        if (ProgrammeStudents != null && ProgrammeStudents.Count() > 0)
                        {
                            <tr>
                                <td>@{count++;} @count</td>
                                <td>@ProgrammeStudents.FirstOrDefault().PROGRAMME_NAME</td>
                                <td>@ProgrammeStudents.GroupBy(s => s.STUDENT_ID).Count()</td>
                                @foreach (var item in Model.lstSupMainHead)
                                {
                                    var liGroupHeads = Model.lstSupHead.Where(x => x.MAIN_HEAD_ID == item.MAIN_HEAD_ID).ToList();
                                    if (liGroupHeads != null && liGroupHeads.Count > 0)
                                    {
                                        foreach (var GHitem in liGroupHeads)
                                        {
                                            var liFeeDetails = Model.liFeeReport.Where(x => x.MAIN_HEAD_ID == GHitem.MAIN_HEAD_ID && x.HEAD_ID == GHitem.HEAD_ID && x.PROGRAMME_GROUP_ID == Proitem.FirstOrDefault().PROGRAMME_GROUP_ID).ToList();
                                            var MainHeadTotal = Model.liFeeReport.Where(x => x.MAIN_HEAD_ID == GHitem.MAIN_HEAD_ID && x.PROGRAMME_GROUP_ID == Proitem.FirstOrDefault().PROGRAMME_GROUP_ID);
                                            Summainhead = MainHeadTotal.Sum(o => Convert.ToDouble(o.BALANCE));
                                            if (liFeeDetails != null && liFeeDetails.Count > 0)
                                            {
                                                var totals = liFeeDetails.Sum(o => Convert.ToDouble(o.BALANCE));                                              
                                                if (liGroupHeads.Count > 1)
                                                {
                                                    <td>@totals</td>
                                                }
                                                else
                                                {
                                                    <td><b>@totals</b></td>
                                                }
                                            }
                                            else
                                            {
                                                <td> - </td>
                                            }
                                        }
                                        if (liGroupHeads.Count > 1)
                                        {
                                            <td><b>@Summainhead</b></td>
                                        }
                                    }
                                    else
                                    {
                                        <td> - </td>
                                    }
                                }
                                <td>
                                    <b>
                                        @{
                                            var liSum = Model.liFeeReport.Where(x => x.PROGRAMME_GROUP_ID == Proitem.FirstOrDefault().PROGRAMME_GROUP_ID).ToList();
                                        }
                                        @liSum.Sum(o => Convert.ToDouble(o.BALANCE))
                                    </b>

                                </td>

                            </tr>
                                                }
                                            }
                                            <tr>
                                                <td colspan="3"><b>Total</b></td>
                                                @foreach (var item in Model.lstSupMainHead)
                                                {
                                                    var liGroupHeads = Model.lstSupHead.Where(x => x.MAIN_HEAD_ID == item.MAIN_HEAD_ID).ToList();
                                                    if (liGroupHeads != null && liGroupHeads.Count > 0)
                                                    {
                                                        var MainHeadTotal = Model.liFeeReport.Where(x => x.MAIN_HEAD_ID == item.MAIN_HEAD_ID);
                                                        SubmainheadTotal = MainHeadTotal.Sum(o => Convert.ToDouble(o.BALANCE));
                                                        foreach (var GHitem in liGroupHeads)
                                                        {
                                                            var liFeeDetails = Model.liFeeReport.Where(x => x.MAIN_HEAD_ID == GHitem.MAIN_HEAD_ID && x.HEAD_ID == GHitem.HEAD_ID).ToList();
                                                            if (liFeeDetails != null && liFeeDetails.Count > 0)
                                                            {
                                                                total = liFeeDetails.Sum(o => Convert.ToDouble(o.BALANCE));
                                                                <td><b>@total</b></td>
                                                            }
                                                            else
                                                            {
                                                                <td> - </td>
                                                            }
                                                        }
                                                        if (liGroupHeads.Count > 1)
                                                        {
                                                            <td><b>@SubmainheadTotal</b></td>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <td> - </td>
                                                    }
                                                }
                                                <td>
                                                    <b>
                                                        @{
                                                            var liSums = Model.liFeeReport.Sum(x => Convert.ToDouble(x.BALANCE));
                                                        }
                                                        @liSums
                                                    </b>
                                                </td>

                                            </tr>



                                                            }
            </tbody>
        </table>
    </div>
}
