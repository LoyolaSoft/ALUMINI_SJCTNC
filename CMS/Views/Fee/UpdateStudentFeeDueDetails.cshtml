<script>
        var table;
        function ContentLoad()
        {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });

        }
        //$(document).ready(function () {

        //});
        $('#ProgrammeGroupList').on('change', function () {
            loadGird();
        });
        $('#FrequencyList').on('change', function () {
            loadGird();
        });
        $('#ClassYearList').on('change', function () {
            loadGird();
        });
        $('#AcademicyearList').on('change', function () {
            var vAcademicyear = $('#AcademicyearList option:selected').text();
         $('#dvStudentBind').empty();
            $('#btnview').addClass("disabled");
            $('#btnSave').addClass("disabled");
            $.ajax({
                url: '@Url.Action("FetchFrequencyByAcademicYear", "Fee")',
                data: { Academicyear: vAcademicyear },
                success: function (objResult) {
                    $('#FrequencyList').empty();
                    $('#FrequencyList').append('<option value="0">-- select --</option>' + objResult.sResult);
                    $("#ClassList").val($("#ClassList option:first").val());
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        });
        function loadGird() {
            var vProgrammeGroupId = String($('#ProgrammeGroupList').val());
            var vClassYearId = $('#ClassYearList').val();
            var vAcademicyear = $('#AcademicyearList option:selected').text();
           var vFrequency = $('#FrequencyList').val();
            $('#btnview').removeClass("disabled");
            $('#btnSave').removeClass("disabled");
            //vFrequency != 0 &&
            if ($('#ProgrammeGroupList').val() && $('#ClassYearList').val() && $('#AcademicyearList option:selected').text() && $('#FrequencyList').val())
            {
                $.ajax({
                    url: '@Url.Action("BindRebundableStudentsByAcademicYearAndClass", "Fee")',
                    //sFrequency: vFrequency,
                    data: { sProgrammeGroupId: vProgrammeGroupId, sClassYearId: vClassYearId, Academicyear: vAcademicyear, vFrequency: vFrequency },
                    success: function (option) {
                        var dvFeeStructureBind = $('#dvStudentBind');
                        dvFeeStructureBind.empty();
                        dvFeeStructureBind.append(option);
                        table = $("#StudentList").DataTable({ "bPaginate": false });//{ "bPaginate": false }
                        $("#StudentList_filter").addClass("dataTables_filter pull-right");
                        $(".pagination").addClass("pagination pull-right");
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });

            } else {
                $('#dvStudentBind').empty();
                $('#btnview').addClass("disabled");
                $('#btnSave').addClass("disabled");
                $('.selectpicker').selectpicker('refresh');
                return false;
            }
        }


        $('#btnSave').on('click', function () {
            var StudentId;
            var JsonData;

            var vProgrammeGroupId = $('#ProgrammeGroupList').val();
            var vClassYearId = $('#ClassYearList').val();
            var vAcademicyear = $('#AcademicyearList option:selected').text();
            var vFrequency = $('#FrequencyList').val();
            if (!confirm('Are you sure to Refund Amount for selected student(s) to ' + vAcademicyear + ' Academicyear ?')) {
                return false;
            }
            $('#StudentList tbody tr').each(function () {
                $(this).find('td').each(function () {
                    var chkBox = $(this).find('input[type="checkbox"]');
                    if (chkBox.is(':checked')) {
                        StudentId = '"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '"';
                    }
                });
            });
            if (StudentId == null) {
                alert('Please select the student to create account...!!!');
                return false;
            }
            var Search = $('input[type="search"]').val();
            if (Search == '') {
                if (vFrequency != 0 && vAcademicyear != 0 && vClassYearId != 0 && vProgrammeGroupId != 0) {
                    JsonData = '{"StudentAccountList":[';
                    $('#StudentList tbody tr').each(function () {
                        $(this).find('td').each(function () {
                            var chkBox = $(this).find('input[type="checkbox"]');
                            if (chkBox.is(':checked')) {
                                JsonData += '{"' + "STUDENT_ID" + '":"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '","AMOUNT":"' + $(this).find('input[type="checkbox"]').attr("cms-Amount") + '"},';

                            }
                        });
                    });
                    JsonData = JsonData.slice(0, -1);
                    JsonData +=
                    ']}';
                    $.ajax({
                        url: "@Url.Action("SaveOrUpdateFeeStudentRefund", "Fee")",
                        method: "POST",
                        data: { sFeeStructure: JsonData, sProgrammeGroupId: vProgrammeGroupId, sFrequency: vFrequency, sClassYearId: vClassYearId, Academicyear: vAcademicyear },
                        success: function (objResult)
                        {
                            if (objResult.ErrorCode == "200")
                            {
                                myAlert(objResult.Message, 'gritter-success', '');
                            } else
                            {
                                myAlert(objResult.Message, 'gritter-danger', '');
                            }
                            //loadContent('/Fee/FetchFeeRefundDetails');
                            loadGird();
                        }, error: function (error) {
                            alert('Internal Server Error ..!');
                        }
                    });
                }
                else {
                    alert('Please Enter Correct Values...!!!');
                    return false;
                }
            } else {
                alert('Please Clear the Search Box...!!!');
                return false;
            }
        });
        // Handle click on "Select all" control
        //$('#AllchkID').on('click', function () {
        //    // Get all rows with search applied
        //    alert();
        //    var rows = table.rows({ 'search': 'applied' }).nodes();
        //    // Check/uncheck checkboxes for all rows in the table
        //    $('input[type="checkbox"]', rows).prop('checked', this.checked);
        //});



        SelectOrUnselect = function () {
          if (AllchkID.checked == true) {
              $('#StudentList tbody tr').each(function () {
                  $(this).find('input[type="checkbox"]').each(function () {
                      $('input[type="checkbox"]').attr("checked", true);
                  });
              });
          }
          else {
              $('#StudentList tbody tr').each(function () {
                  $(this).find('input[type="checkbox"]').each(function () {
                      $('input[type="checkbox"]').attr("checked", false);
                  });
              });
          }
        }
        function ListSelectedStudentFeeAccount(StudentId) {
            var vAcademicyear = $('#AcademicyearList option:selected').text();
            var FrequencyId = $('#FrequencyList').val();
            $.ajax({
                url: "@Url.Action("FetchSelectedStudentFeeAccount", "Fee")",
                method: "POST",
                datatype: "html",
                data: { sStudentId: StudentId, Academicyear: vAcademicyear, sFrequencyId: FrequencyId },
                success: function (Option) {
                    var divHtml = $('#SelectedStudentFeeAccount');
                    divHtml.empty();
                    divHtml.html(Option);
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }

</script>

