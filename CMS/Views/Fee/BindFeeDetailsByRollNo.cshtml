@model CMS.ViewModel.ViewModel.FeeViewModel

@{ 
    Layout = null;
}
<div class="table-responsive col-md-12 form-group">
    <table>
        <thead>
            <tr>
                <th>#</th>
                @{
                    if (Model.liFeeReport != null && Model.liFeeReport.Count > 0)
                    {
                        foreach (var item in Model.liFeeReport)
                        {
                            if (item.BALANCE != "0")
                            {
                                <th>@item.FREQUENCY_NAME</th>
                            }
                        }
                    }
                }
                <th>Balance</th>
                <th>Action</th>
            </tr> 
        </thead>
        <tbody>
                @{
                    if (Model.liFeeReport != null && Model.liFeeReport.Count > 0)
                    {
                        int nCount = 0;
                        foreach (var item in Model.liFeeReport)
                        {
                            if (item.BALANCE != "0")
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.FREQUENCY_NAME</td>
                                    <td>@item.BALANCE</td>
                                    <td>
                                        <a class="btn btn-success" onclick="FetchFeeStudentInfo('@item.FREQUENCY_ID', '@item.STUDENT_ID')"> Collect </a>
                                    </td>
                                </tr>
                              }
                          }
                      }
                }
        </tbody>
    </table>
</div>