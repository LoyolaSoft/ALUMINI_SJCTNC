
@{
    Layout = null;
    int ncount = 0;
}

<div class="col-md-12 table-responsive">
    <table class="table table-hover table-bordered" width="100%" id="StudentListtbl">
        <thead>
            <tr>
                <th><b>#</b></th>
                <th><b>Roll No</b></th>
                <th><b>First Name</b></th>
                <th><b>Class Name</b></th>
                <th><b>Head</b></th>
                <th><b>To Pay</b></th>
                <th><b>Paid</b></th>
                <th><b>Balance</b> </th>
                <th><b>Action</b></th>
            </tr>

        </thead>
        <tbody>
            @if (Model.liFeeDueReport != null)
            {
                foreach (var item in Model.liFeeDueReport)
                {
                    <tr>
                        <td>
                            @{ ncount++;} <b>@ncount</b>
                        </td>

                        <td>
                            @item.ROLL_NO
                        </td>
                        <td>
                            @item.FIRST_NAME
                        </td>
                        <td>
                            @item.CLASS_NAME
                        </td>
                        <td>@item.HEAD_CODE</td>
                        <td>
                            @item.CREDIT
                        </td>
                        <td>@item.DEBIT</td>
                        @if (item.BALANCE == "0")
                        {
                            <td><b>Paid</b></td>
                        }
                        else
                        {
                            <td>
                                @item.BALANCE
                            </td>
                        }
                        <td>
                            <a href="#EditFeeDueDetails" onclick="FetchFeeDueDetailsByID(@item.F_STUDENT_AC_ID);" data-toggle="modal" title="View"><i class="fa fa-edit text-primary"></i></a>

                            <a onclick="DeletedDueList(@item.F_STUDENT_AC_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>