
@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{
    ViewBag.Title = "BusFeeStudentAccountFileUpload";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    string currentDate = DateTime.Now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    currentDate = currentDate + ".txt";
    int count = 0;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }

    .dueListDiv {
        border: 2px solid #097272;
        display: flex;
        justify-content: center;
        text-align: center;
        padding-top: 6px;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Bus Fee List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Bus Fee List</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Bus Fee List</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "AcademicYearDrop" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-12">

                    <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-6 dueListDiv ">
                            <div class="col-md-6">

                                <a href="#BusFeeDueFileUPload" class="btn bg-primary pull-right m-b-5 " data-toggle="modal" title="View"><i class="fa fa-file-excel-o bg-primary"></i>Bus Fee Due Upload</a>
                            </div>
                            <div class="col-md-4">
                                <a href="~/Content/ExcelTemplate/Bus_Fee_due_template.xlsx" class="btn bg-warning pull-right m-b-5 " data-toggle="modal" title="View"><i class="fa fa-file-excel-o bg-warning"></i> Excel Template</a>
                            </div>
                        </div>
                        <div class="text-center col-md-3 pull-right">
                            <a href="~/FeeDueFileLog/Bus/@currentDate" class="btn bg-danger  m-b-5 " data-toggle="modal" title="View" target="_blank"><i class="fa fa-file-text-o bg-danger"></i> Download Error Log</a>

                        </div>
                    </div>
                </div>
                <hr />

                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="col-md-12" id="divbind">

                    </div>

                </div>
                <br />
                <div id="bindAcYearWiseBusFeeList">
                    <div class="col-md-12 table-responsive">
                        <table class="table table-hover table-bordered" width="100%" id="StudentList">
                            <thead>
                                <tr>
                                    <th><b>#</b></th>
                                    <th><b>Roll No</b></th>
                                    <th><b>First Name</b></th>
                                    <th><b>Class Name</b></th>
                                    <th><b>Term</b></th>
                                    <th><b>To Pay</b></th>
                                    <th><b>Paid</b></th>
                                    <th><b>Balance</b> </th>
                                    <th><b>Action</b></th>
                                </tr>

                            </thead>
                            <tbody>
                                @if (Model.liFeeDueReport != null)
                                {
                                    foreach (var item in Model.liFeeDueReport)
                                    {
                                        <tr>
                                            <td>
                                                @{ count++;} <b>@count</b>
                                            </td>

                                            <td>
                                                @item.ROLL_NO
                                            </td>
                                            <td>
                                                @item.FIRST_NAME
                                            </td>
                                            <td>
                                                @item.CLASS_NAME
                                            </td>
                                            <td>@item.TERM</td>
                                            <td>
                                                @item.CREDIT
                                            </td>
                                            <td>@item.DEBIT</td>
                                            @if (item.BALANCE == "0")
                                            {
                                                <td><b>Paid</b></td>
                                            }
                                            else
                                            {
                                                <td>
                                                    @item.BALANCE
                                                </td>
                                            }
                                            <td>
                                                <a href="#EditFeeDueDetails" onclick="FetchFeeDueDetailsByID(@item.STUDENT_AC_ID);" data-toggle="modal" title="View"><i class="fa fa-edit text-primary"></i></a>

                                                <a onclick="DeletedDueList(@item.STUDENT_AC_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            }
        </div>

        <div class="modal" id="EditFeeDueDetails">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <h4 class="modal-title">Edit Fee Due Details</h4>
                    </div>
                    <div class="modal-body" data-parsley-validate="true" id="IQACProject">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="col-md-12 form-horizontal">
                                            <input id="txtSTUDENT_AC_ID" hidden />
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">Roll No</label>
                                                <div class="col-md-8">
                                                    <input type="text" id="txtROLL_NO" class="form-control" placeholder="Roll No" disabled>
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label"> First Name</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="txtFIRST_NAME" class="form-control" placeholder=" First Name" disabled>
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">To Pay</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="txtCREDIT" oninput="numberOnly(this.id);" class="form-control" placeholder="To Pay">
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">Paid</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="txtDEBIT" oninput="numberOnly(this.id);" class="form-control" placeholder="Paid">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" id="btnSubmit" onclick="UpdateData()" class="btn btn-sm btn-primary">Submit</a>
                        <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="BusFeeDueFileUPload">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-orange-lighter">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <p class="modal-title f-s-15 f-w-200 text-white">Bus Fee Amount Update </p>
                    </div>
                    <div class="modal-body">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group col-md-12">
                            @Html.Label("Status", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" id="PaymentStatus">
                                    <option value="0">--- Select --- </option>
                                    <option value="1">Paid Amount</option>
                                    <option value="2">Pay Amount</option>

                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group col-md-12">
                                @Html.Label("Upload", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="file" class="btn btn-primary" id="HeadExcelUpload" required />
                                    @*<a class="btn btn-primary" onclick="ClickFile()">File</a>*@
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" class="btn btn-sm btn-success" data-dismiss="modal" id="" onclick="SaveBusFeeFile()">Submit</a>
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*ADD*@

<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="AddpBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input id="ADDSTUDENT_AC_ID" hidden />

                                    <div class="col-md-12 form-group">
                                        @Html.Label("Roll No", htmlAttributes: new { @class = "col-md-3 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="text" id="RollNo" required />

                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        @Html.Label("Bus Route", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="text" id="BusRoute" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Bus NO", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="text" id="BusNo" />
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        @Html.Label("Term", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9 ">
                                            <select class="form-control input-sm select-picker" id="Term">
                                                <option value="0">--- Select --- </option>
                                                <option value="1">Term1</option>
                                                <option value="2">Term2</option>

                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("To Pay", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="number" id="ToPay" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Paid", htmlAttributes: new { @class = "col-md-3 control-label " })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="number" id="Paid" />
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="AddbtnSubmit" onclick="SaveBusFeeData()" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" id="AddbtnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>


            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>

    var formData = new FormData();
    function FetchFeeDueDetailsByID(sFeeDueId) {
        //$('#pBody').parsley().destroy();

        if (sFeeDueId != null) {
            $.ajax({

                url: '@Url.Action("FetchBusDetailsById", "Fee")',
                type: "POST",
                datatype: 'json',
                data: { sDueID: sFeeDueId },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    else {
                        if (data.oResult[0] != null) {
                            $('#txtROLL_NO').attr('value', data.oResult[0].ROLL_NO);
                            $('#txtFIRST_NAME').attr('value', data.oResult[0].FIRST_NAME);
                            $('#txtCREDIT').attr('value', data.oResult[0].CREDIT);
                            $('#txtDEBIT').attr('value', data.oResult[0].DEBIT);
                            $('#txtSTUDENT_AC_ID').attr('value', data.oResult[0].STUDENT_AC_ID);

                            $('.selectpicker').selectpicker('refresh');
                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });

        }
    }

    function UpdateData() {
        var formData = new FormData();
        //summernote
        var RollNo = $('#txtROLL_NO').val();
        var stuDueID = $('#txtSTUDENT_AC_ID').val();
        var Creditfee = $('#txtCREDIT').val();
        var DebitPaid = $('#txtDEBIT').val();
        var academicYear = $('#AcademicYearDrop option:selected').text();


        var sJsonData = '{"STUDENT_AC_ID":"' + stuDueID + '",\
                "ROLL_NO": "' + RollNo + '", \
                "CREDIT": "' + Creditfee + '", \
                "DEBIT": "' + DebitPaid + '" \
    } ';
        formData.append('jsonData', sJsonData);
        formData.append("academicYear", academicYear);
        $.ajax({
            url: '@Url.Action("SaveOrUpdateBusFeeStudentAccount", "Fee")',
            method: 'POST',
            contentType: false,
            processData: false,
            data: formData,
            async: false,
            success: function (data) {
                if (data.Message != null && data.Message != "") {
                    if (data.ErrorCode == "200") {
                        $('#btnCancel').click();
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                        loadGird();
                    }
                    else if (data.ErrorCode == "417") {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                    else if (data.ErrorCode == "503") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }
                    else if (data.ErrorCode == "406") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }
                    else {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });

                    }
                }
            },
            error: function (error) {
                alert('Internal Server Error !');
                return false;
            }
        });

    }





    function SaveBusFeeData() {
    var formData = new FormData();
//summernote
            var RollNo = $('#RollNo').val();
            var stuDueID = $('#ADDSTUDENT_AC_ID').val();
            var Creditfee = $('#ToPay').val();
            var DebitPaid = $('#Paid').val();
            var Term = $('#Term').val();
            var academicYear = $('#AcademicYearDrop option:selected').text();


            var sJsonData = '{"ADDSTUDENT_AC_ID":"' + stuDueID + '",\
            "ROLL_NO": "' + RollNo + '", \
            "CREDIT": "' + Creditfee + '", \
            "DEBIT": "' + DebitPaid + '", \
            "TERM": "' + Term + '" \
} ';
     formData.append('jsonData', sJsonData);
    formData.append("academicYear", academicYear);
    $.ajax({
        url: '@Url.Action("SaveBusFeeStudentAccount", "Fee")',
        method: 'POST',
        contentType: false,
        processData: false,
        data: formData,
        async: false,
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                if (data.ErrorCode == "200") {
                    $('#AddbtnCancel').click();
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                    loadGird();
                }
                else if (data.ErrorCode == "417") {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                }
                else if (data.ErrorCode == "503") {
                    swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                }
                else if (data.ErrorCode == "406") {
                    swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                }
                else {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });

                }
            }
        },
        error: function (error) {
            alert('Internal Server Error !');
            return false;
        }
    });




    };

    $('.selectpicker').selectpicker({
        size: 4
    });


</script>

<script>
    function numberOnly(id) {
        var element = document.getElementById(id);
        element.value = element.value.replace(/[^0-9]/gi, "");
    }

        var table;
        function ContentLoad()
        {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });
            table = $("#StudentList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
            $("#StudentList_filter").addClass("dataTables_filter pull-right");
            $(".pagination").addClass("pagination pull-right");
        }

     function loadGird() {
         loadContent("/Fee/BusFeeStudentAccountFileUpload")
             }


         DeletedDueList=function (fID) {
                 swal({
                     title: "Are you sure want to Delete?",
                     text: "",
                     type: "warning",
                     showCancelButton: true,
                     confirmButtonClass: "btn-danger",
                     confirmButtonText: "Yes, I agree!",
                     closeOnConfirm: false
                 },
                     function () {
                         $('.cancel ').click();
                         $.ajax({
                             url: "/Fee/DeleteBusFeeAccount",
                             type: "post",
                             data: { fID: fID },
                             success: function (data) {
                                 if (data.ErrorCode == "200") {
                                     swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });
                                     loadGird();
                                 }
                                 else {
                                     swal({ title: "Fail !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                                 }
                             },
                             error: function (ex) {
                                 swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                             }


                         });
                     });

             }


                       function ClickFile()
                        {
                            $('#ExcelUpload').click();
                        }

    function SaveBusFeeFile()
    {
        var PaymentID = $('#PaymentStatus').val();
        if ( PaymentID != '0') {
            swal({
                title: "Confirmation",
                text: "Are you sure you want to update the due details?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
                function () {
                    var sFlag = false;
                    var formData = new FormData();
                    var sFile = $('#HeadExcelUpload').get(0).files;
                    if (sFile.length != 0) {
                        for (var i = 0; i < sFile.length; i++) {
                            formData.append(sFile[i].name, sFile[i]);
                            sFlag = true;
                        }
                    }
                    else {
                        swal({ title: "", text: "No File Found", showConfirmButton: false, timer: 1500, type: 'error', animation: true });

                    }
                    $('.cancel ').click();
                    formData.append("Status", $('#PaymentStatus').val());


                    $.ajax({
                        url: '@Url.Action("SaveBusFeeDueDetails", "Fee")',
                        method: 'POST',
                        datatype: 'json',
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 3000, type: 'info', animation: true });
                            loadGird();
                        }, error: function (error) {
                            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    });

                });
        }
        else {
            swal({ title: "Info", text: "Please Select All Fields", showConfirmButton: false, timer: 2000, type: 'info', animation: true });

        }
    }
    $('#AcademicYearDrop').on('change', function () {

        $.ajax({

             url: '@Url.Action("BindAcYearWiseBusDueListList", "Fee")',
            type: "POST",
            datatype: 'json',
            data: { sAcYear: $("#AcademicYearDrop option:selected").text() },
            success: function (data) {
                $("#bindAcYearWiseBusFeeList").empty();
                $("#bindAcYearWiseBusFeeList").append(data);
                $("#StudentList").DataTable({
                    dom: "lBfrtip", buttons: [{
                        extend: "copy", className: "btn-sm"
                    }
                        , {
                        extend: "excel", className: "btn-sm"
                    }
                        , {
                        extend: "pdf", className: "btn-sm"
                    }
                    ], responsive: !0, "paging": true, "ordering": true
                });

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    })


    $("#Add").on('click', function () {

        $('#RollNo').attr('value', '');
