@model CMS.ViewModel.ViewModel.FeeViewModel
    
@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Fee</a></li>
        <li class="active">Fee Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Fee Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Fee Report  </h4>
        </div>
        <div class="panel-body table-responsive">
            <div  class="col-md-12 form-group pull-right"> <a href="javascript:;" onclick="Export()" class="btn btn-success pull-right" title="Click To "> Export</a></div>
            <div id="dvIQACBind">
                @{
                    if (Model.lifee_stu != null && Model.lifee_stu.Count >= 0)
                    {
                        var Ligroupfrequncy = Model.lifee_stu.GroupBy(x => x.FREQUENCY_ID).ToList();
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Roll No</th>
                                    <th>Name</th>
                                    <th>Class Code</th>
                                    <th>WorkDays</th>
                                    <th>Percentage %</th>
                                    @{
                                        if (Ligroupfrequncy != null && Ligroupfrequncy.Count >= 0)
                                        {
                                            foreach (var item in Ligroupfrequncy)
                                            {
                                                <th>@item.FirstOrDefault().FREQUENCY_TYPE</th>
                                            }
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int count = 0;
                                    if (Model.listudent != null && Model.listudent.Count > 0)
                                    {
                                        foreach (var item in Model.listudent)
                                        {
                                            var LifeeStudent = Model.lifee_stu.Where(x => x.STUDENT_ID == item.STUDENT_ID).ToList();
                                            if (LifeeStudent != null && LifeeStudent.Count > 0)
                                            {
                                                <tr>
                                                    <td>@{count++;}@count</td>
                                                    <td>@item.ROLL_NO</td>
                                                    <td>@item.FIRST_NAME</td>
                                                    <td>@item.CLASS_CODE</td>
                                                    <td>@item.TEXT2</td>
                                                    <td>@item.TEXT3</td>
                                                    @foreach (var Lifreq in Ligroupfrequncy)
                                                    {
                                                        var Lifee = LifeeStudent.Where(x => x.FREQUENCY_ID == Lifreq.FirstOrDefault().FREQUENCY_ID).ToList();
                                                        if (Lifee != null && Lifee.Count > 0)
                                                        {
                                                            <td>@Lifee.FirstOrDefault().BALANCE</td>
                                                        }
                                                        else
                                                        {
                                                            <td>0</td>
                                                        }
                                                    }
                                                </tr>
                                                                }
                                                            }
                                                        }
                                }
                            </tbody>
                        </table>
                                                        }
                }
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
       // alert("Test");
        $('.table').DataTable({ "bPaginate": false });
    }

    function Export() {
        let file = new Blob([$('#dvIQACBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: "OverAllStudentReport" + ".xls"
        }).appendTo("body").get(0).click();
        //e.preventDefault();
        loadContent('/FEE/FeeOverallReport');
    }
</script>

