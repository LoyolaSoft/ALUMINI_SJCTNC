@model CMS.ViewModel.ViewModel.FeeReportViewModel

@{
    ViewBag.Title = "DaywiseReportByTransactionId";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int count = 0;
}

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Daywise Fee Report</li>
    </ol>
    <h2 class="page-header"> Daywise Fee Report</h2>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                @*<a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>*@
            </div>
            <h4 class="panel-title">Daywise Fee Report</h4>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">

                <div class="form-group col-md-12">
                    <a class="btn btn-success pull-right" id="btnPrint" onclick="printDiv('dvPrint')"> Print </a>
                    <a class="btn btn-default pull-left" id="btnPrint" @*href="@Url.Action("DayWiseFeeReport","Fee")"*@ href="javascript:;" onclick="loadContent('/Fee/DayWiseFeeReport')"> Back </a>
                </div>
                
                <div class="form-group col-md-12 table-responsive" id="dvPrint">
                    <div class="form-group col-md-12" id="Tittle">
                        <h3 class="text-center"><b>DayWise Fee Report</b></h3>
                    </div>
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Payment Date</th>
                                <th>Head</th>
                                <th>Paid</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.liFeeReport != null && Model.liFeeReport.Count > 0)
                            {
                                foreach (var item in Model.liFeeReport)
                                {
                                      <tr>
                                          <td>@{count++;} @count</td>
                                          <td>@item.PAYMENT_DATE</td>
                                          <td>@item.HEAD</td>
                                          <td><b>₹ @item.PAID_AMOUNT</b> </td>
                                      </tr>
                                 }
                                      <tr>
                                          <td colspan="3" style="text-align:right"> <b>Total Collected</b></td>
                                          <td><b>₹ @Model.liFeeReport.FirstOrDefault().COLLECTED</b></td>
                                      </tr>
                             }
                             else
                             {
                                 <tr>
                                     <td colspan="6"> No Records Available !</td>
                                 </tr>
                             }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function ContentLoad() {
        // Document Ready Function .
    }
        function printDiv(divName) {
            //$('#Tittle').removeClass('hidden');
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
        }
</script>    
    
