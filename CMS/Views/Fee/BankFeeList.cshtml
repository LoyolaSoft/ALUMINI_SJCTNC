@model CMS.ViewModel.ViewModel.FeeTransactionViewModel


@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List Fee Bank Copy</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Fee Bank Copy<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Fee Bank Copy</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-6">
                            @Html.Label("Fee Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.FeeRoot, (Model.FeeRoot != null) ? Model.FeeRoot : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.FeeRoot, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            @Html.Label("Frequency", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.liFrequencyType, (Model.liFrequencyType != null) ? Model.liFrequencyType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.liFrequencyType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <a href="javascript:;" id="sPrint" onclick="printDiv('dvFeeBankCopy')" class="btn btn-sm btn-success m-b-10 disabled pull-right"><i class="fa fa-print m-r-5"></i> Print</a>
                        <a href="javascript:;" id="btnExport" onclick="Export()" class="btn btn-sm btn-primary m-b-10 disabled pull-right"> Excel </a>
                    </div>
                </div>

                <div class="row">
                    <div id="dvFeeBankCopy"></div>
                </div>

            }

        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>


<script>
    $('#liFrequencyType').on('change', function ()
    {
        $('#dvFeeBankCopy').empty();
        $.ajax({
            url:'@Url.Action("BindBankFeeList", "Fee")',
            method:'POST',
            datatype: 'json',
            data: { sFeeRootId: $('#FeeRoot').val(), sFrequencyId: $('#liFrequencyType').val() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#dvFeeBankCopy').append(data);
                    $('#sPrint').removeClass('disabled');
                    $('#btnExport').removeClass('disabled');
                    
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });


    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
        //var printContents = document.getElementById(divName).innerHTML;
        //var originalContents = document.body.innerHTML;

        //document.body.innerHTML = printContents;

        //window.print();

        //document.body.innerHTML = originalContents;
        //loadContent('/Examination/ExamFilledApplicationList');
    }

    function Export() {
       
        var title = "";
        var sFrequencyType = $('#liFrequencyType Option:selected').text();
        let file = new Blob([$('#dvFeeBankCopy').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: sFrequencyType + ".xls"
        }).appendTo("body").get(0).click();
        //e.preventDefault();
       // loadContent('/Fee/FeeBankFeeList');
    }
</script>