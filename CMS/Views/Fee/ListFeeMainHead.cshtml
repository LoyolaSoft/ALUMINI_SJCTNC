        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">College HeadList</h4>
                </div>
                <div class="panel-body">
                    <div class="col-lg-12 m-b-5"><a class="btn btn-success pull-right" title="Add Sup Head" data-toggle="modal" onclick="loadContent('/Fee/CollegeFeeMainHead')"><i class="fa fa-plus"></i> Add </a></div>
                    <div class="" id="dvLoadFeeheads">
                        <div class="col-lg-12 table-responsive">
                            <table class="table table-hover table-bordered" id="tblHead">
                                <thead>
                                    <tr>
                                        <th>S.No</th>                                        
                                        <th>Application</th>
                                        <th>Programme Mode</th>
                                        <th>Shift</th>                                       
                                        <th>Frequency</th>
                                        <th>Main Head</th>
                                        <th>SubHead</th>
                                        <th>Fee Category</th>
                                        <th>Bank Account</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @{ int count = 0; }
                                    @if (Model.FeeMainHeadList != null)
                                    {
                                        foreach (var item in Model.FeeMainHeadList)
                                        {
                                            <tr>
                                                <td>@{count++;}@count</td>                                                
                                                <td>@item.APPLICATION_TYPE</td>                                                
                                                <td>@item.PROGRAMME_MODE</td>
                                                <td>@item.SHIFT_NAME</td>
                                                <td>@item.FREQUENCY_NAME</td>
                                                <td>@item.MAIN_HEAD</td>
                                                <td>@item.HEAD</td>
                                                <td>@item.FEE_CATEGORY</td>
                                                <td>@item.PASSBOOK_NO</td>
                                                <td><a onclick="DeleteProgram('@item.FEE_MAIN_HEAD_ID')"><i class="fa fa-trash text-danger"></i></a></td>
                                            </tr>
                                                        }
                                                    }


                                </tbody>
                                @*<tfoot>
                                        <tr>
                                            <th>S.No</th>
                                            <th>Shift</th>
                                            <th>Programme Mode</th>
                                            <th>Frequency</th>
                                            <th>Main Head</th>
                                            <th>subHead</th>
                                            <th>Main Head</th>
                                            <th>subHead</th>
                                            <th>Action</th>
                                        </tr>
                                    </tfoot>*@
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
                                                    }
</div>
