@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{int count = 0;}
<div class="table-responsive">
    <table class="table table-hover table-bordered" id="MessFeeCollection">
        <thead>
            <tr>
                <th>#</th>
                <th>Class</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Head</th>
                <th>PaymentDate</th>
                <th>Amount</th>
                <th>Hostel</th>              
                <th>Status</th>
                <th>Is Left</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFeeStudentAccount != null && Model.liFeeTransaction!=null)
            {
                foreach (var item in Model.liFeeStudentAccount)
                {
                    var PayMents = Model.liFeeTransaction.Where(s => s.STUDENT_ID == item.STUDENT_ID && s.HEAD_ID == item.HEAD_ID).ToList();
                    <tr>
                        <td>@{ count++;}@count</td>
                        <td>@item.CLASS_CODE</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.MAIN_HEAD</td>
                        <td>@{ if (PayMents != null && PayMents.Count() > 0) { @PayMents.FirstOrDefault().PAYMENT_DATE; }}</td>
                        <td>@item.CREDIT</td>
                        <td>@item.HOSTEL_NAME</td>
                        <td>@item.STATUS</td>
                        @if(item.IS_DELETED=="1" || item.IS_LEFT == "1")
                        {
                            <td>Yes</td>
                        }
                        else
                        {
                            <td>No</td>
                        }

                    </tr>
                }
             }
        </tbody>
    </table>
</div>