
@model CMS.ViewModel.Model.TransferCertificate

@{
    ViewBag.Title = "ExamVerifiedAndNotVerifiedList";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li class="active">Exam Verification Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam Verification Report</h1>
    <!-- end page-header -->
    <!-- begin panel -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam Verification Report</h4>
        </div>
        <div class="panel-body">
            <div id="loader" style="display:none; position:fixed; top:70%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
                <img src="~/Content/assets/img/loading-7528_128.gif" alt="Loading..." />
            </div>
            <div class="col-md-12 form-horizontal">

                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Academic Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ADAcademicYear" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Shift</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "ADShiftList" })
                                @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Programme Level</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.programmeLevel, (Model.programmeLevel != null) ? Model.programmeLevel : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "ADprogrammeLevel" })
                                @Html.ValidationMessageFor(model => model.programmeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Programme</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "ADProgramName" })
                                @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Class Year</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", data_actions_box = "true", multiple = "multiple", @id = "ADClassYear" })
                                @Html.ValidationMessageFor(model => model.ClassYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Class Name</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "ADClassName" })
                                @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Exam Setting</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label class="control-label col-md-4">Status</label>
                            <div class="col-md-8">
                                <select class="selectpicker show-menu-arrow show-tick drop-down form-control  input-sm" id="Status" multiple>
                                    <option value="0"> --- Select ---</option>
                                    <option value="1"> Not Verified</option>
                                    <option value="2">Verified</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row pull-right">
                    <div class="col-md-6 btnPrintDiv">
                        <button class="btn btn-success btnPrint" onclick="printDiv()"> Print </button>
                    </div>
                    <div class="col-md-6 btnExcelDiv">
                        <button class="btn btn-primary btnExport" onclick="Export()"> Export </button>
                    </div>
                </div>
            </div>

            <hr />
            <br />
            <div class="form-group col-md-12">
                <div id="divbind"></div>
            </div>
        </div>


    </div>
    <!-- end panel -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>



<script>
    $('.selectpicker').selectpicker({
        size: 4
    });
                            $("#ADProgramName").on("change", function () {
                                FetchADClass();
                            });
    $("#ADClassYear").on("change", function () {
                                FetchADClass();
                            });
    function FetchADClass()
                            {
                                var ProgramName = String($("#ADProgramName").val());
                                var classyear = String($("#ADClassYear").val());
                                var sShift = String($("#ADShiftList").val());
                                if ($("#ADClassYear").val() && $("#ADShiftList").val() && $("#ADProgramName").val())
                                {
                                    $.ajax({
                                        url: "@Url.Action("BindDDLClassListbyClassYear", "Student")",
                                        method: "POST",
                                        datatype: "json",
                                        data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                                        success: function (data) {
                                            $("#ADClassName").empty();
                                            $("#ADClassName").append( data);
                                            $('.selectpicker').selectpicker('refresh');
                                        }, error: function (error) {
                                            alert('Internal Server Error ! ');
                                        }
                                    });
                                }
                            };
    $("#ADShiftList").on("change", function ()
                            {
                                fetchADProgramme();
                            });
    $("#ADprogrammeLevel").on("change", function ()
                            {
                                fetchADProgramme();
                            });
    function fetchADProgramme()
                            {
        var sShift = String($("#ADShiftList").val());
        var pLevel = String($("#ADprogrammeLevel").val());
        if ($("#ADShiftList").val() && $("#ADprogrammeLevel").val())
                                {
                                    $.ajax({
                                        url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                                        method: "POST",
                                        datatype: "json",
                                        data: { sShiftId: sShift, programmeLevel: pLevel },
                                        success: function (data) {
                                            $("#ADProgramName").empty();
                                            $("#ADProgramName").append(data);
                                            $('.selectpicker').selectpicker('refresh');
                                        }, error: function (error) {
                                            alert('Internal Server Error ! ');
                                        }
                                    });
                                }
    };

    $("#ADClassName").on("change", function () {
        LoadExamVerifyReport();
    });
    $("#ADAcademicYear").on("change", function () {
        LoadExamVerifyReport();
        LoadExamSetting();
    });
    $("#Status").on("change", function () {
        LoadExamVerifyReport();
    });
    $("#ExamSetting").on("change", function () {
        LoadExamVerifyReport();
    });
    function LoadExamSetting()
                         {
        var Acyear = $("#ADAcademicYear option:selected").text()

                             {
                                 $.ajax({
                                     url: "@Url.Action("GetExamSettingByACYear", "Examination")",
                                     method: "POST",
                                     datatype: "json",
                                     data: { sAcyear: Acyear},
                                     success: function (data) {
                                         $("#ExamSetting").empty();
                                         $("#ExamSetting").append("<option>--- Select ---</option>"+ data);
                                         $('.selectpicker').selectpicker('refresh');
                                     }, error: function (error) {
                                         alert('Internal Server Error ! ');
                                     }
                                 });
                             }
 };
    function LoadExamVerifyReport()
    {
        var ProgramName = $("#ADProgramName").val();
        var ExamSetting = $("#ExamSetting").val();
        var Status = String($("#Status").val());
        var ClassName = String($("#ADClassName").val());
        var AcademicYear = $('#ADAcademicYear option:selected').text();
        if ($("#ADClassName").val() && $("#ExamSetting").val() && $('#ADAcademicYear option:selected').text() && Status != "0" && Status != "null" && Status != " " && ExamSetting != "--- Select ---")
            {
                if (AcademicYear == '' || AcademicYear == '0') {
                    alert('Please Choose All The Values...!!!');
                    return false;
            }
            $('#loader').show();
                $.ajax({
                    url: "@Url.Action("BindExamVerifyReport", "Examination")",
                    method: "POST",
                    datatype: "json",
                    data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear, sStatus: Status, sExamSetting: ExamSetting },
                    success: function (data) {
                        $("#divbind").empty();
                        $("#divbind").append(data);
                        $(".btnPrintDiv").show();
                        $(".btnExcelDiv").show();
                        table = $("#tblStudentList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
                        $("#tblStudentList_filter").addClass("dataTables_filter pull-right");
                        $(".pagination").addClass("pagination pull-right");
                        $('#loader').hide();
                    }, error: function (error) {
                        alert('Internal Server Error !');
                        $('#loader').hide();
                    }
                });
            }
    };


    UpdateVerifyStatus = function (StudentID, examSetting, VerifyStatus, AcYear) {
     if (!confirm('Are you sure to change The Verification Status?')) {
         return false;
     }
     $.ajax({
         url: "@Url.Action("UpdateExamVerifyStatus","Examination")",
         method: "POST",
         datatype: "html",
         data: { sStudentID: StudentID, sexamSetting: examSetting, sVerifyStatus: VerifyStatus, sAcYear: AcYear },
         success: function (data) {
             debugger;
             if (data.Message != null && data.Message != "") {
                 if (data.ErrorCode == "200") {
                     $('#btnCancel').click();
                     swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                     LoadExamVerifyReport();
                 }
                 else if (data.ErrorCode == "417") {
                     swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                 }
                 else if (data.ErrorCode == "503") {
                     swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                 }
                 else if (data.ErrorCode == "406") {
                     swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                 }
                 else {
                     swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });

                 }
             }

         }, error: function (error) {
             debugger;

             alert('Internal Server Error !');
         }
     });
 }

    function printDiv() {
        var table = $('#tblStudentList').DataTable();
        table.destroy();
        var printContents = document.getElementById('divbind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        LoadExamVerifyReport();
    }
</script>

<script>

    function Export() {
        var title = "ExamVerificationReport";
        var table = $('#tblStudentList').DataTable();
        table.destroy();
        let file = new Blob([$('#divbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        table = $("#tblStudentList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
        $("#tblStudentList_filter").addClass("dataTables_filter pull-right");
        $(".pagination").addClass("pagination pull-right");
    }

</script>



