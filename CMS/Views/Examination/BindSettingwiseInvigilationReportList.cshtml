@if (Model.LiExamInvigilationStaffWise != null && Model.LiExamInvigilationStaffWise.Count > 0)
{


    int sNo = 0; // Reset serial number for each staff member
    <div class="report-container">
        <div class="report-header">
            @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
            {
                var collegeDetails = Model.liCollegeDetails.FirstOrDefault();
                // You can add the college logo here if it's available in the model
                // <img src="@collegeDetails.COLLEGE_LOGO_URL" alt="Logo" class="logo"/>
                <h5 class="text-center"><b>@collegeDetails.COLLEGE_NAME - @collegeDetails.COLLEGE_ADDRESS</b></h5>
                <p class="text-center"><b> (@collegeDetails.UNIVERSITY)</b></p>
                <p class="text-center"><b> INVIGILATION SCHEDULE - @Model.LiExamInvigilationStaffWise.FirstOrDefault().M_EXAM SEMESTER EXAMS</b></p>
            }
            else
            {
                <h6 class="text-center"><b> St.JOSEPH'S COLLEGE OF ARTS & SCIENCE(Autonomous) :: CUDDALORE - 1</b></h6>
                <p class="text-center"><b> (Affiliated to Annamalai University, Annamalai Nagar)</b></p>
                <p class="text-center"><b>INVIGILATION SCHEDULE - NOVEMBER 2025 SEMESTER EXAMS</b></p>
            }
        </div>

        <br />

        <p><b>Dear @Model.LiExamInvigilationStaffWise.FirstOrDefault().FIRST_NAME (@Model.LiExamInvigilationStaffWise.FirstOrDefault().STAFF_CODE)</b></p>
        @*<p><b>Ref. ID: @Model.LiExamInvigilationStaffWise.FirstOrDefault().STAFF_CODE</b></p>*@

        <p>
            I have pleasure in informing you that you are appointed as invigilator for the ensuing Semester Examinations. The schedule of the invigilation is as follows.
        </p>

        <table class="report-table table-bordered">
            <thead>
                <tr>
                    <th style="width: 10%; padding: 5px 30px;">S. No</th>
                    <th style="padding:5px 30px;">Date of Exam and Session</th>
                    <th style="padding:5px 30px;">Name of the Invigilation Hall</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.LiExamInvigilationStaffWise)
                {
                    sNo++;
                    <tr>
                        <td style="padding:5px 30px;">@sNo</td>
                        <td style="padding:5px 30px;">@item.EXAM_DATE - @item.SESSION_NAME</td>
                        <td style="padding:5px 30px;">@item.HALL_NAME</td>
                    </tr>
                }
            </tbody>
        </table>

