<script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');

        $('#Semester').on('change', function () {

        });
    $('#Semester').on('change', function () {
        FetchCourseList();
    });
    $('#AcademicYearList').on('change', function () {
        FetchCourseList();
    });
    $('#ClassList').on('change', function () {
        FetchCourseList();
    });

         function FetchCourseList() {
            var inp = $('#ClassList').val();
            if ($('#ClassList').val() && $('#Semester').val() && $('#AcademicYearList Option:selected').text()) {
                $.ajax({
                    url: "@Url.Action("FetchCourseByClassIdAndAcYearAndSemtypeId", "SupportData")",
                    async: false,
                    data: { sClassId: $('#ClassList').val(), sAcYear: $('#AcademicYearList Option:selected').text(), sSemesterTypeId: $('#Semester').val() },
                    success: function (option) {
                        var select = $('#CourseList');
                        select.empty();
                        select.append(option.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (ex) {
                        alert(ex);
                    }

                });
            }
    };

        function GetCumulative()
        {
            $('#sPrint').addClass('disabled');
            $('#sExcel').addClass('disabled');
            $.ajax({
                url: "@Url.Action("BindCIACumulativeMarkListbyAcYearForCOE", "Examination")",
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sAcYear: $('#AcademicYearList  Option:selected').text(), sSemesterTypeId: $('#Semester').val() },
                success: function (option)
                {
                    var divHtml = $('#dvCIAbind');
                    divHtml.empty();
                    divHtml.html(option);
                    $('#sPrint').removeClass('disabled');
                    $('#sExcel').removeClass('disabled');
                },
                error: function (ex)
                {
                    alert(ex);
                }
            });
        }

        function printDiv(divName) {
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;

            window.print();

            document.body.innerHTML = originalContents;
            loadContent('/Examination/CIAOverAllCumulativeMarksForCOE');
        }
    function Export() {
        var title = "";
        //var sSatff = $('#StaffListByDepartmet option:selected').text();
        title = "CIA Cumulative Mark";
        let file = new Blob([$('#dvCIAbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        //$('#btnGet').click();
        //loadContent('/attendance/AttendancePercentageCommon');
        //e.preventDefault();
        // loadContent('/IQAC/IQACDateWiseReportForIncharge');
    }

</script>




