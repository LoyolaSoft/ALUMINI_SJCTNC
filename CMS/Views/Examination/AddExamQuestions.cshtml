@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "AddExamQuestions";
    Layout = null;
}

<style>
    .note-editable
     {
        height: 180px !important;
    }
</style>

<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li><a @*href="@Url.Action("ListQuiz","Examination")"*@ href="javascript:;" onclick="loadContent('/Examination/ListMatchTheFollowing')">List Quiz</a></li>
        <li class="active">Add  Questions</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Add  Questions </h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Question and Answers</h4>
                </div>
                <div class="panel-body">
                    <div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#MatchTheFollowing-dialog" data-toggle="modal"><i class="fa fa-plus"> Equation </i></a>
                    </div>

                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-3 form-group">
                                    @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Set, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-3 form-group">
                                    @Html.Label("Pattern", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.QuestionPattern, (Model.QuestionPattern != null) ? Model.QuestionPattern : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Section", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Section, (Model.Section != null) ? Model.Section : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Section, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Question Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.QuestionType, (Model.QuestionType != null) ? Model.QuestionType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.QuestionType, "", new { @class = "text-danger" })
                                    </div>
                                </div>       
                                <div class="col-md-3 form-group">
                                    @Html.Label("Options", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @*@Html.Editor("txtOption", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Options You Need" } })*@
                                        <input type="number" id="txtOption" max="10" class="form-control input-sm" min="0" />
                                    </div>
                                </div>
                            </div>  
                            <div class="col-md-12">
                                <a class="btn btn-success pull-right" href="#previewmodal" onclick="QuestionPreview()" data-toggle="modal">Preview</a>
                            </div>    
                            <div class="col-md-8 col-md-offset-3 hidden" id="coundiv">
                                <div class="col-md-4 form-group" id="alloteddiv">
                                    @Html.Label("Alloted Question:", htmlAttributes: new { @class = "control-label col-md-10" })
                                    <div class="col-md-2">
                                        <label class="label label-info" id="allotedquestion"></label>
                                    </div>
                                </div>
                                <div class="col-md-4 form-group " id="questionentereddiv">
                                    @Html.Label("Question Entered:", htmlAttributes: new { @class = "control-label col-md-10" })
                                    <div class="col-md-2">
                                        <label class="label label-info" id="enteredquestion"></label>
                                    </div>
                                </div>

                            </div>                           
                        </div>
                        <br />
                        
                        <div id="dvtextboxes" class="hidden">
                            <div class="table-bordered">
                                <br>
                                <br>
                            <!--Begin Question-->
                            <div class="row hidden" id="Question">

                                <div class="col-md-12 form-group">
                                    <label class="control-label col-md-1 p-t-25">Question</label>                                   
                                    <br />
                                    <div class="col-md-10">
                                        <textarea id="TxtTitle" class="summernote form-control" placeholder="Enter Your Question" @*maxlength="200"*@ @*style="width:115%"*@></textarea>
                                    </div>
                                </div>
                            
                            </div>
                            <!--End Question-->
                            <!--Begin match The Following-->
                            <div class="row hidden" id="dvMathTheFollowing">
                                <div class="col-md-6 form-group">
                                    <div id="dvOptions1"></div>
                                </div>
                                <div class="col-md-6 form-group">
                                    <div id="dvOptions2"></div>
                                </div>
                            </div>
                            <!-- End Match The Following-->
                            <!--Other Type-->
                            <div class="row hidden" id="dvOtherType">
                                <br />
                                <div id="dvOptions3"></div>
                            </div>
                            <!--Either or questions-->
                            <div class="row hidden" id="dvEitherType">
                                
                                <div id="dvOptions4">
                                   
                                </div>
                            </div>
                                <!--Choice based questions-->
                            <div class="row hidden" id="dvChoiceType">

                                    <div id="dvOptions5">

                                    </div>
                                </div>
                            <div class="row">

                                <div class="col-md-4 form-group hidden" id="Answer">
                                    <label class="col-md-3 control-label">Answer</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtAnswer" class="form-control" placeholder="Enter Your Correct Option No" min="0" @*style="width:157%"*@>
                                    </div>
                                </div>

                                <div class="col-md-12 form-group">
                                    <a class="btn btn-primary pull-right hidden" id="btnSubmit">Submit</a>
                                </div>
                            </div>
                            
                            </div>
                        </div>                    

                    </div>


                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<div class="modal" id="previewmodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Question Preview</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-12 form-horizontal" id="privewdiv">
                    
                </div>
               
            </div>
            <div class="modal-footer">
          
                <div class="col-md-12" id="btnprint">
                    <br>
                    <div class="form-group col-md-1 pull-right">

                        <a href="javascript:;" id="sPrint" onclick="printDiv('privewdiv')" class="btn btn-success  m-b-10">Print</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="patternsectionid"/>
<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/js/form-summernote.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function QuestionPreview()
    {
        

        if ($('#ExamSetting').val()!="" && $('#CourseList').val()!="" && $('#Set').val()!="" && $('#ExamSetting').val()!="0" && $('#CourseList').val()!="0" && $('#Set').val()!="0")
        {
            $('#course').text($("#CourseList option:selected").text());
            $('#exam').text($("#ExamSetting option:selected").text());
            $('#set').text($("#Set option:selected").text());

            $.ajax({
                url: "@Url.Action("BindQuestionPreview", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamsettingId: $('#ExamSetting').val(), sCourse: $('#CourseList').val(), sSet: $('#Set').val() },
            success: function (data)
            {
                $('#privewdiv').empty();
                $('#privewdiv').append(data);
                $('#btnprint').removeClass('hidden');
                $('#coursedetailsdiv').removeClass('hidden')
                

            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Choose Course,Exam Setting,Set .....!');
    }
   
    }
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
        //$('.modal-backdrop').remove();
        //$('#previewmodal').modal('toggle');
    }

        function ContentLoad()
        {
            handleSummernote();
            // Document Ready Function .
        }
        handleSummernote = function ()
        {
            $(".summernote").summernote({
                placeholder: "Add Your Option"
            })
        }
        $('.note-editable').css("width", "882");

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

      

        $("#Semester").on("change", function ()
        {
            if ($(this).val())
            {
                $.ajax({
                    url: "@Url.Action("FetchCourseSemester", "Examination")",
                    method: "POST",
                datatype: "json",
                data: { sSemster: $(this).val() },
                success: function (data)
                {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else
        {
            alert('Please Select the Fields ...!')
        }
        });
    $("#QuestionPattern").on("change", function ()
    {
        if ($(this).val())
        {
            $.ajax({
                url: "@Url.Action("FetchExamSectionByQuestionPattern", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sQuestionpatternid: $(this).val() },
            success: function (data)
            {
                $("#Section").empty();
                $("#Section").append('<option value=""> -- Select -- </option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Select the Fields ...!')
    }
    });
    $("#Section").on("change", function ()
    {
        if ($(this).val() && $('#QuestionPattern').val())
        {
            $.ajax({
                url: "@Url.Action("FetchExamQuestiontypeByQuestionPatternandSection", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sQuestionpatternid: $('#QuestionPattern').val(), sSectionId:$(this).val() },
            success: function (data)
            {
                $("#QuestionType").empty();
                $("#QuestionType").append('<option value=""> -- Select -- </option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Select the Fields ...!')
    }
    });

    $("#QuestionType").on("change", function ()
    {
        if ($(this).val() && $('#QuestionPattern').val() && $('#Section').val())
        {
            if ($('#QuestionType').val() == "4" || $('#QuestionType').val()=="5")
            {
                $('#dvtextboxes').removeClass('hidden');
                $('#Question').removeClass('hidden');
                $("#btnSubmit").removeClass('hidden');
            }
            $.ajax({
                url: "@Url.Action("FetchQuestioncountandPatternsectionId", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sQuestionpatternid: $('#QuestionPattern').val(), sSectionId: $('#Section').val(), sQuestiontype: $('#QuestionType').val(), sExamsettingId: $('#ExamSetting').val(), sCourseId: $('#CourseList').val(), sSetId: $('#Set').val() },
            success: function (data)
            {

                $('#allotedquestion').text(data.NO_OF_QUESTIONS);
                $('#enteredquestion').text(data.COUNT);
                $('#patternsectionid').val(data.PATTERN_SECTION_ID);
                $('#coundiv').removeClass('hidden');

            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Select the Fields ...!')
    }
    });

        $("#txtOption").on("change", function ()
        {

            $('#dvtextboxes').removeClass('hidden');
            $("#btnSubmit").removeClass('hidden');
            var value = $("#txtOption").val();
            var Option = '';
            var Option2 = '';
            var Option3 = '';
            if (value > 10)
            {
                alert('Invalid Option .! Maximum Option is 10 .');
                value = 10;
                $("#txtOption").val('10');
            }
            $("#dvOptions1").empty();
            $("#dvOptions2").empty();
            $("#dvOptions3").empty();
            $("#dvOptions4").empty();
            $("#dvOptions5").empty();

            var QuizQuestions = $('#QuestionType').val();

            if (QuizQuestions=="1" || QuizQuestions == "2")
            {
                $('#dvMathTheFollowing').addClass('hidden');
                $('#dvOtherType').removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-1">' + j + ' .)</label>';
                    Option += '<div class="col-md-10">';
                    Option += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
                    Option += '</div>';
                    Option += '</div>';
                }

                $("#dvOptions3").append(Option);
                $('#Answer').removeClass('hidden');
                $("#Question").removeClass('hidden');
                handleSummernote();
            } else if (QuizQuestions=="3")
            {
                $('#dvOtherType').addClass('hidden');
                $("#dvMathTheFollowing").removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
                    Option += '<div class="col-md-9">';
                    Option += '<input type="text" id="Qustions' + i + '" class="summernote form-control" placeholder="Enter Your Questions" maxlength="145" style="width:110%">';
                    Option += '</div>';
                    Option += '</div>';

                    Option2 += '<div class="col-md-12 form-group">';
                    Option2 += '<div class="col-md-9">';
                    Option2 += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145" style="width:110%">';
                    Option2 += '</div>';
                    Option2 += '</div>';
                }

                $("#dvOptions1").append(Option);
                $("#dvOptions2").append(Option2);
               
                $('#Answer').addClass('hidden');
                $("#Question").removeClass('hidden');
                handleSummernote();
            }
            else if (QuizQuestions == "4")
            {
                $('#dvMathTheFollowing').addClass('hidden');
                $('#dvOtherType').addClass('hidden');
                $('#dvEitherType').removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-1">' + j + ' .)</label>';
                    Option += '<div class="col-md-10">';
                    Option += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
                    Option += '</div>';
                    Option += '</div>';
                }
                if (value > 0) {
                    $('#dvOptions4').append('<center><span><b>(Either OR Questions)</b></span></center><br>');
                }
                $("#dvOptions4").append(Option);
                $('#Answer').addClass('hidden');
                $("#Question").removeClass('hidden');
                handleSummernote();
            }
            else if (QuizQuestions == "5")
            {
                $('#dvMathTheFollowing').addClass('hidden');
                $('#dvOtherType').addClass('hidden');
                $('#dvEitherType').addClass('hidden');
                $('#dvChoiceType').removeClass('hidden');

                for (var i = 0; i < value; i++) {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-1">' + j + ' .)</label>';
                    Option += '<div class="col-md-10">';
                    Option += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
                    Option += '</div>';
                    Option += '</div>';
                }
                
                $("#dvOptions5").append(Option);
                $('#Answer').addClass('hidden');
                $("#Question").removeClass('hidden');
                handleSummernote();
            }
         //   DeleteSummerNoteHeader();


        });

        $("#btnSubmit").on("click", function ()
        {            
            var enteredcount = $('#enteredquestion').text();
            var allotedcount = $('#allotedquestion').text();
            if (parseInt(enteredcount) < parseInt(allotedcount)) {
                if (!$("#ExamSetting").val() && !$("#CourseList").val() && !$("#Semester").val() && !$("#Set").val() && !$("#QuestionPattern").val() && !$("#Section").val()) {
                    alert('Please Select All To Continue ! ');
                    return false;
                }

                var QuizQuestions = $('#QuestionType').val();
                var Endvalue = $("#txtOption").val();

                var SummerNote = $("#TxtTitle").summernote('code');

                var str = btoa(unescape(encodeURIComponent(SummerNote)));
                var Question = str;
                var CourseId = $("#CourseList").val();
                var ddlExamsetting = $("#ExamSetting").val();
                var QuestionId = $("#QuestionId").val();
                var SetId = $('#Set').val();
                //var QuestionpatternId = $('#QuestionPattern').val();
                //var SectionId = $('#Section').val();
                //var Questiontypeid = $('#QuestionType').val();
                var Patternsectionid = $('#patternsectionid').val();
                var ArrayOption = '';
                var nCount = 0;
                ArrayOption = '{"liMF_Option":[';
                for (var i = 0; i < Endvalue; i++) {
                    if (QuizQuestions == "1") {
                        // Objective Type Questions ...
                        if ($("#Options" + i).summernote('code')) {
                            var SummerNote2 = $("#Options" + i).summernote('code');
                            var str2 = btoa(unescape(encodeURIComponent(SummerNote2)));

                            ArrayOption += '{"OPTION":"' + str2 + '"},';
                            nCount++;
                        } else {
                            alert('All the Options Must to Fill ..!');
                            return false;
                            break;
                        }
                    }
                    else if (QuizQuestions == "2") {
                        // Fill In The Blanks ...
                        if ($("#Options" + i).summernote('code'))
                        {
                            var SummerNote3 = $("#Options" + i).summernote('code');
                            var str3 = btoa(unescape(encodeURIComponent(SummerNote3)));

                            ArrayOption += '{"OPTION":"' + str3 + '"},';
                            nCount++;
                        } else {
                            alert('All the Options Must to Fill ..!');
                            return false;
                            break;
                        }

                    }
                    else if (QuizQuestions == "3") {

                        // Match The Following ...
                        if ($("#Options" + i).summernote('code') && $("#Qustions" + i).summernote('code')) {
                            var SummerNote4 = $("#Options" + i).summernote('code');
                            var str4 = btoa(unescape(encodeURIComponent(SummerNote4)));

                            var SummerNote5 = $("#Qustions" + i).summernote('code');
                            var str5 = btoa(unescape(encodeURIComponent(SummerNote5)));

                            ArrayOption += '{"OPTION":"' + str5 + '","ANSWER":"' + str4 + '"},';
                            nCount++;
                        } else {
                            alert('All the Options Must to Fill ..!');
                            return false;
                            break;
                        }
                    }
                    else if (QuizQuestions == "4")
                    {
                        // Either Type Questions ...
                        if ($("#Options" + i).summernote('code')) {
                            var SummerNote6 = $("#Options" + i).summernote('code');
                            var str6 = btoa(unescape(encodeURIComponent(SummerNote6)));

                            ArrayOption += '{"OPTION":"' + str6 + '"},';
                            nCount++;
                        } else {
                            alert('All the Options Must to Fill ..!');
                            return false;
                            break;
                        }
                    }
                    else if (QuizQuestions == "5")
                    {
                        //  Type Questions ...
                        if ($("#Options" + i).summernote('code')) {
                            var SummerNote6 = $("#Options" + i).summernote('code');
                            var str6 = btoa(unescape(encodeURIComponent(SummerNote6)));

                            ArrayOption += '{"OPTION":"' + str6 + '"},';
                            nCount++;
                        } else {
                            alert('All the Options Must to Fill ..!');
                            return false;
                            break;
                        }
                    }

                }
                if (nCount != 0) {
                    ArrayOption = ArrayOption.slice(0, -1);
                    ArrayOption += ']}';
                } else {
                    if (QuizQuestions == "4" || QuizQuestions == "5") {
                        ArrayOption = '';
                    }
                    else {
                        alert('Something is went wrong . please check your Input !');
                        return false;
                    }
                }


                var Answer = "";
                if (QuizQuestions == "1" || QuizQuestions == "2") {
                    var str1 = GetOptionCodeForAnswer($("#txtAnswer").val());
                    if (str1 != null && str1 != "" && str1 != "W29iamVjdCBPYmplY3Rd") {
                        Answer = str1;
                    }
                    else {
                        alert('Your Answer Not Valuable ! Please Check You Input !');
                        return false;
                    }
                }
                $('#btnSubmit').addClass('disabled');
                var JsonData;
                JsonData = '{"QUESTION":"' + Question + '","COURSE_ID":"' + CourseId + '","SET_ID":"' + SetId + '","EXAM_SETTING_ID":"' + ddlExamsetting + '","ANSWER_ID":"' + Answer + '","PATTERN_SECTION_ID":"' + $('#patternsectionid').val() + '","QUESTION_TYPE":"' + QuizQuestions + '"}';
                $.ajax({
                    url: "@Url.Action("SaveAlltypeExamQuestions", "Examination")",
                    method: "POST",
                    datatype: "json",
                    data: { QuizQuestion: JsonData, sOptions: ArrayOption },
                    success: function (data) {
                        alert(data.Message);
                        if (data.ErrorCode != null && data.ErrorCode) {
                            var enteredcount = (parseInt($('#enteredquestion').text()) + 1);
                            $('#enteredquestion').text(enteredcount);
                            //$('#dvtextboxes').addClass('hidden');
                            //$('#txtOption').val('');
                            $("#TxtTitle").val('');
                            $('#txtAnswer').val('');
                            $('#btnSubmit').removeClass('disabled');
                            $('.summernote').summernote('code', '');
                            var value = $("#txtOption").val();
                            for (var i = 0; i < value; i++)
                            {
                                $("#Options" + i).summernote('code','')
                            }

                        }

                        //loadContent('/Examination/MatchTheFollowing');
                    }, error: function (error) {
                        $('#btnSubmit').removeClass('disabled');
                        alert('Internal Server Error !');
                    }
                });
            }
            else
            {
                alert('Please Check Alloted Count... !');
            }

        });
</script>

