    //$('#CourseList').on('change', function ()
    //{
    //    GetStudent();
    //});

    function GetStudent()
    {
        if ($('#SettingId').val())
        {
            $.ajax({
                url: "@Url.Action("ListPartialQuizStudentShuffleForAdmin", "Examination")",
                method: "POST",
                datatype: "json",
                data: { SettingId: $('#SettingId').val(), sStaffId: $('#StaffList').val() },
                success: function (data)
                {
                    $('#dvQuizStudentShuffle').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#dvQuizStudentShuffle').append(data);
                        $('#tblQuizStudentShuffle').DataTable({ "bPaginate": false });
                        $('.selectpicker').selectpicker('refresh');
                       // $("#StudentList").append('<option value="0"> -- Select -- </option>' + data.sResult);
                       //// $("#StudentList").val(sStudentId);
                       // $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error .....!');
                }
            });
        } else
        {
            alert('Please Select All Filed To Continue !');
            return false;
        }
    }

    // On Submit Setting ...
    $('#btnSubmit').on('click', function ()
    {
        if ($('#SettingId').val())
        {
         //   var sClassId = $('#ClassList').val();
          //  var sCourseId = $('#CourseList').val();
            var sSetId = '';
            var sStudentId = '';
            var sRollNo = '';
            var sQuizShuffleId = null;
            var nJsonCount = 0;
            var sJsonData = '{"liQuizStudentShuffle":[';
            $('#tblQuizStudentShuffle tbody tr').each(function ()
            {
                sSetId = $(this).find('select Option:selected').val();
                sStudentId = $(this).attr('cms-sStudentId');
                sRollNo = $(this).attr('cms-sRollNo');
                sQuizShuffleId = $(this).attr('cms-QuizShuffleId');


                if (sSetId!='' & sSetId!=null)
                {
                    sJsonData += '{"SETTING_ID":"' + $('#SettingId').val() + '","STUDENT_ID":"' + sStudentId + '","ROLL_NO":"' + sRollNo + '","SET_ID":"' + sSetId + '","QUIZ_SHUFFLE_ID":"' + sQuizShuffleId + '"},';
                    nJsonCount++;
                }
            });
            //var JsonData = null;
            //JsonData = '{"QUIZ_SHUFFLE_ID":"' + $('#hdQuizShuffleId').val() + '",\
            //             "CLASS_ID":"' + $('#ClassList').val() + '",\
            //             "COURSE_ID":"' + $('#CourseList').val() + '",\
            //             "STUDENT_ID":"' + String($('#StudentList').val()) + '",\
            //             "SET_ID":"' + $('#Batch').val() + '"}';

            if (nJsonCount != 0)
            {
                sJsonData = sJsonData.slice(0, -1);
                sJsonData += ']}';
            } else
            {
                alert('Please Choose All Options To Continue !');
                return false;
            }
            $.ajax({
                url:'@Url.Action("SaveQuizStudentShuffleForAdmin", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sSaveQuizStudentShuffle: sJsonData, sSettingId: $('#SettingId').val() },
                success: function (data)
                {
                    alert(data.Message);
                    // loadContent('/Examination/ListQuizStudentShuffle');
                    GetStudent();
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        } else
        {
            alert('Please Fill All Values To Continue !');
        }
    });
</script>

