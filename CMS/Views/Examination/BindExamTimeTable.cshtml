@model CMS.ViewModel.ViewModel.ExaminationViewModel


@{ 
    Layout = null;
    int count = 0;
}

@{
    if (Model.liExamTimeTable != null && Model.liExamTimeTable.Count > 0)
    {
        var liGroupProgrammeYear = Model.liExamTimeTable.GroupBy(x => x.PROGRAMME_YEAR).Select(x =>
                new CMS.ViewModel.Model.EXAM_TIMETABLE() { PROGRAMME_YEAR = x.FirstOrDefault().PROGRAMME_YEAR, PROGRAMME_NAME = x.FirstOrDefault().PROGRAMME_NAME });
        foreach (var item in liGroupProgrammeYear)
        {
            var liGroupByProgrammeYear = Model.liExamTimeTable.Where(x => x.PROGRAMME_YEAR == item.PROGRAMME_YEAR).ToList();
            count = 0;
            <div style="page-break-after:always !important;page-break-inside:avoid !important;">
                <h4 class="text-center"> @item.PROGRAMME_NAME</h4>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered" border="1">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Programme Level</th>
                                <th>Exam Date</th>
                                <th>Exam Session</th>
                                <th>Course Code</th>
                                <th>Title of the Paper</th>
                                <th>Subject Type</th>
                                <td class="clsAction">Action</td>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (liGroupByProgrammeYear != null && liGroupByProgrammeYear.Count > 0)
                                {
                                    foreach (var lstitem in liGroupByProgrammeYear)
                                    {
                            <tr>
                                <td>@{count++; } @count</td>
                                <td>@lstitem.PROGRAMME_LEVEL</td>
                                <td>@lstitem.EXAM_DATE</td>
                                <td>@lstitem.EXAM_SESSION</td>
                                <td>@lstitem.COURSE_CODE</td>
                                <td>@lstitem.COURSE_TITLE</td>
                                <td>@lstitem.SUBJECT_TYPE</td>
                                <td class="clsAction"><a onclick="GetConfrim(@lstitem.TIMETABLE_ID);" href="javascript:;"><i class="fa fa-trash text-danger"></i></a></td>
                            </tr>
                                     }
                                 }
                            }
                        </tbody>
                    </table>
                    <br />
                </div>
            </div>
                                        }
                                    }
                                    else
                                    {
         <div class="alert alert-danger"> No Record(s) Found !</div>
     }
}

