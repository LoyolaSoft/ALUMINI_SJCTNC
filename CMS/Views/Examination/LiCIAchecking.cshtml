

@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List CIA Marks Checking Show</li>
    </ol>
    <h1 class="page-header">List CIA Marks Checking Show</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List CIA Marks</h4>
        </div>
        <div class="panel-body noPadding">
            <br><br>
            <div class="col-md-12">
                <div class="col-md-4 form-group">
                    @Html.Label("Academic Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                    <div class="col-md-9">
                        @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-4 form-group">
                    @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                    </div>
                </div>

                <div class="col-md-4 form-group">
                    @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-12 form-group" id="dvBind">



                </div>
            </div>

            <input type="hidden" id="sStaffId" value="@ViewBag.sStaffId" />


        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad()
    {

    }
    $('.selectpicker').selectpicker('refresh');
    $('#CourseList').on('change', function ()
    {
        if ($('#CourseList').val())
        {
            $.ajax({
                url: "/Examination/BindCIAcheckingStatusForStaff",
                type: "post",
                data: { sAcademicYear: $('#AcademicYearList option:selected').text(), sCourse: $('#CourseList').val() },
                success: function (data)
                {
                    $('#dvBind').html('');
                    $('#dvBind').append(data);


                },
                error: function (ex) {
                    $('#dvBind').html('');
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }
            });
        }
        else
        {
            swal({ title: "Info !", text: "Please try it again", showConfirmButton: false, timer: 1800, type: 'info', animation: true });

        }

    });


    $("#ClassList").on("change", function ()
    {
        var Class = $("#ClassList").val();
        var sAcademicYear = $('#AcademicYearList option:selected').text();
        $("#CourseList").empty();
        $.ajax({
            url: "@Url.Action("FethCourseByClassIdAndAcademicYear", "Examination")",
            method: "POST",
            datatype: "json",
            data: { Class_Id: Class, sAcademicYear: sAcademicYear},
            success: function (data)
            {
                $("#CourseList").empty();
                $("#CourseList").append('<option value=""> -- Select -- </option>' + data);

                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    });


    $("#AcademicYearList").on("change", function ()
    {
        var sAcademicYear = $('#AcademicYearList option:selected').text();
        $.ajax({
            url: "@Url.Action("FethClassByAcademicYearAndStaff", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sAcademicYear: sAcademicYear, sStaffId: $("#sStaffId").val()},
            success: function (data)
            {
                $("#ClassList").empty();
                $("#ClassList").append('<option value=""> -- Select -- </option>' + data);

                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    });


</script>


