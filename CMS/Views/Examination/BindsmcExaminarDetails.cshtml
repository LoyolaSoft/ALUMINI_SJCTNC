
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{int count = 0;}
@if (Model.LiExaminar != null && Model.LiExaminar.Count > 0)
{
    <div class="col-md-12 form-horizontal">
        <div class="table-responsive">
            <br /><br />
            <table class="col-md-12 table table-hover table-bordered" id="tblStudentList">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Programme Name</th>
                        <th>Examinar Name</th>
                        <th>College Name</th>
                        <th>Examinar Code</th>
                        <th>Exam Setting</th>
                        <th>Course Code</th>
                        <th>Course Title</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Examinar</th>
                        <th>Questionsetter</th>
                        <th>Practical</th>
                        <th>Interval</th>
                        <th>From Date</th>
                        <th>Interval From Date</th>
                        <th>To Date</th>
                        <th>Interval To Date</th>
                        <th>Purpose</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.LiExaminar)
                    {
                        <tr>
                            <td>@{ count++;}@count</td>
                            <td>@item.PROGRAMME_NAME</td>
                            <td>@item.EXAMINAR_NAME</td>
                            <td>@item.COLLEGE_NAME</td>
                            <td>@item.EXAMINAR_CODE</td>
                            <td>@item.EXAM_NAME</td>
                            <td>@item.COURSE_CODE</td>
                            <td>@item.COURSE_TITLE</td>
                            <td>@item.EMAIL_ID</td>
                            <td>@item.MOBILE_NO</td>
                            @if (item.IS_EXAMINAR == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            @if (item.IS_QUESTIONSETTER == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            @if (item.IS_PRACTICAL == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            @if (item.IS_INTERVAL == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            <td>@item.FROM_DATE</td>
                            <td>@item.INTERVAL_FROM_DATE</td>
                            <td>@item.TO_DATE</td>
                            <td>@item.INTERVAL_TO_DATE</td>
                            <td>@item.PURPOSE</td>
                            <td>
                                <a href="#ExaminarsDetails-dialog" onclick="FetchExaminarDetails(@item.EXAMINAR_ENTRY_ID)" data-toggle="modal"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                <a onclick="GetConfirm(@item.EXAMINAR_ENTRY_ID)"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
            <br />

        </div>
    </div>
}
else
{
    <table class="table table-hover table-bordered">
        <tr>
            <td colspan="11" align="center" style="background-color:lightcoral;">No Records Found ...!</td>
        </tr>
    </table>
}
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    var rowcounts = $('#totalrows').val();
    $("#tblStudentList").DataTable({
        "paging": false,         // Disable pagination
        "searching": false,      // Disable search filter
        "lengthMenu": [10, 20, 50, 100, 200, 500, rowcounts],
        "columnDefs": [
            { "width": "8%", "targets": [5, 6] }
        ], "scrollX": true

    });
</script>