    $('#CourseList').on("change", function () {
        $('#StudentList').html('');
        $('#StudentList').selectpicker('refresh');
        if ($('#ClassList').val() && $('#CourseList').val()) {
            $.ajax(
                {
                    url: "/Examination/FetchStudentListByCourseAndClass",
                    type: "post",
                    data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                    success: function (data) {
                        if (data.Message != null && data.Message != '') {
                        }
                        else {
                            $('#StudentList').empty();
                            $.each(data, function (id, info) {
                                $('#StudentList').append($('<option>',
                                {
                                    value: info.STUDENT_ID,
                                    text: info.FIRST_NAME
                                }));

                            });
                            $('#StudentList').selectpicker('refresh');
                        }
                    },
                    error: function (ex) {

                    }
                });
        }
    });


    $('#btnGet').click( function () {

        if ($('#ClassList').val() && $('#CourseList').val() && $('#StudentList').val())
        {
            $.ajax({
                  url:"@Url.Action("BindOnlinExamReportByClassandCourseandStudent", "Examination")",
                type: "post",
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sStudentId: String($('#StudentList').val()), sClass: $('#ClassList option:selected').text(), sCourse: $('#CourseList option:selected').text() },
                success:function(data)
                  {
                      if(data.Message!=null && data.Message!='')
                      {
                          alert(data.Message)
                      }
                      else {
                         
                          $('#divBind').html('');
                          $('#divBind').append(data);
                      }
                  },
                  error:function(ex)
                  {

                  }


            });
        }
        else {
            alert("Pleas Select All the fields")
        }
    });

    function printDiv(sDivName) {
        var printContents = document.getElementById(sDivName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/OnlineExamReportByClassAndCourse');
    }


</script>




