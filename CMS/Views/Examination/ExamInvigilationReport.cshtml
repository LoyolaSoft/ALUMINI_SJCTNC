<style>
    /* --- General Report Styles --- */
    .report-container {
        font-family: 'Times New Roman', Times, serif; /* Consistent font stack */
        font-size: 12pt;
        margin: 20px auto;
        padding: 25px;
        border: 1px solid #ccc;
        background: white;
        max-width: 800px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    .report-header {
        text-align: center;
    }

        .report-header h3, .report-header h4, .report-header p {
            margin: 2px 0;
        }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }

        .report-table th, .report-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }

    .instructions-section ol {
        padding-left: 20px;
        text-align: justify;
    }

    .instructions-section li {
        margin-bottom: 8px;
    }

    .signature-section {
        text-align: right;
        margin-top: 40px;
    }

    /* --- Mobile Responsiveness (for viewing on screen) --- */
    @@media (max-width: 768px) {
        .report-container {
            padding: 15px;
            margin: 10px;
            border: none;
            box-shadow: none;
        }

        body {
            font-size: 14px; /* Adjust base font size for mobile */
        }
    }

    /* --- Print-Specific Styles (applied ONLY when printing) --- */
    @@media print {
        /* Hide everything on the page EXCEPT the report containers */
        body > *:not(#bindAcYearWiseBusFeeList) {
            display: none !important;
        }

        #bindAcYearWiseBusFeeList, .report-container {
            display: block !important;
        }

        .report-container {
            max-width: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none;
            box-shadow: none;
            font-size: 12pt; /* Ensure font size is consistent for print */
            font-family: 'Times New Roman', Times, serif; /* Enforce font for printing */
            page-break-after: always; /* Each staff report on a new page */
        }
            /* Ensure the last element doesn't have a page break after it */
            .report-container:last-of-type {
                page-break-after: auto;
            }

        .btn { /* Hide buttons in print view */
            display: none;
        }
    }
</style>
