<script>
    $(document).ready(function () {
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
    });


    $("#AcademicYearDrop").on('change', function () {
        LoadExamSetting();
    });

    function LoadExamSetting() {
        var acYear = $("#AcademicYearDrop" + " option:selected").text();

    if (acYear && acYear !== "--- Select ---") {
        $.ajax({
            url: "@Url.Action("GetExamSettingByACYear", "Examination")",
            method: "POST",
            dataType: "json",
            data: { sAcyear: acYear },
            success: function (data) {
                $("#ExamSettingDrop")
                    .empty()
                    .append('<option>--- Select ---</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function () {
                alert('Internal Server Error!');
            }
        });
    }
}


    $('.selectpicker').selectpicker({
        size: 4
    });


</script>

<script>

    $('#ExamSettingDrop').on('change', function () {

        $.ajax({
            url: '@Url.Action("BindSettingwiseInvigilationReportList", "Examination")',
            type: "POST",
            datatype: 'json',
            data: { sAcYear: $("#AcademicYearDrop option:selected").text(), sSettingId: $("#ExamSettingDrop").val() },
            success: function (data) {
                $("#bindAcYearWiseBusFeeList").empty();
                $("#bindAcYearWiseBusFeeList").append(data);
                $("#StudentList").DataTable({
                    dom: "lBfrtip", buttons: [{
                        extend: "copy", className: "btn-sm"
                    }
                        , {
                        extend: "excel", className: "btn-sm"
                    }
                        , {
                        extend: "pdf", className: "btn-sm"
                    }
                    ], responsive: !0, "paging": true, "ordering": true
                });

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    });
    function printDiv(divName) {
        var table = $('#StudentList').DataTable();
        table.destroy();
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/ExamInvigilationReport');
    }



</script>
