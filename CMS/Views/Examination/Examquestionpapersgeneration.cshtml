@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <!-- begin breadcrumb -->
        <ol class="breadcrumb pull-right">
            <li><a @*href="@Url.Action("Student", "DashBoard")"*@ href="javascript:;">Home</a></li>
            <li class="active">Exam Question Paper  </li>
        </ol>
        <!-- end breadcrumb -->
        <!-- begin page-header -->
        <h1 class="page-header">Exam Question Paper <small></small></h1>
        <!-- end page-header -->

        <div class="panel panel-primary" id="panel">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Exam Question Paper </h4>
            </div>
            <div class="panel-body">

                <div class="col-md-12 form-group">

                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Ac Year</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Exam Setting</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Course</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                </div>

                <div class="col-md-12 form-group">
                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Question Level</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.QUESTION_LEVEL, (Model.QUESTION_LEVEL != null) ? Model.QUESTION_LEVEL : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <div class="col-md-6">
                            <a href="#" class="btn btn-primary" id="btnSubmit">Generate Question Paper</a>
                        </div>
                    </div>

                </div>
               
            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $('.selectpicker').selectpicker({ size: 6 });
    $('.selectpicker').selectpicker('refresh');
    function ContentLoad()
    {
        // Document ready function ...
    }
</script>

@* On Academic Year Change  *@
<script>
    $('#AcademicYearList').on('change', function ()
    {
        if ($('#AcademicYearList').val())
        {
            $.ajax({
                url: '/Examination/FetchExamSettingByAcYear',
                method:'POST',
                datatype: 'json',
                data: { sAcYear: $('#AcademicYearList option:Selected').text() },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        $('#ExamSetting').empty().append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
</script>

@* On Exam Setting Change  *@
<script>
    $('#ExamSetting').on('change', function ()
    {
        if ($('#ExamSetting').val())
        {
            $.ajax({
                url: '/Examination/FetchCourseByExamSetting',
                method:'POST',
                datatype: '',
                data: { sExamSettingId: $('#ExamSetting').val() },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        $('#CourseList').empty().append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
</script>

<script>
  
    $('#btnSubmit').on('click', function ()
    {
        if ($('#ExamSetting').val() && $('#CourseList').val() && $('#QUESTION_LEVEL').val())
        {
            var ExamId=$('#ExamSetting').val();
            var CourseId = $('#CourseList').val();
            var Questionlevel = $('#QUESTION_LEVEL').val();
            $.ajax({
                url: '/Examination/Questionpapersgeneration',
                method: 'POST',
                datatype: 'json',
                data: { sExamSettingId: ExamId, sCourseId: CourseId.toString(), sQuestionLevel: Questionlevel.toString() },
                success: function (data)
                {
                  
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });

 

</script>