@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;

@{
    Layout = null;
    bool bFlag = true;
    string sFile = string.Empty;

    string sFirstAmount = "0";
    if (Model != null && Model.liFetchHallTicket != null && Model.liFetchHallTicket.Count > 0)
    {
        var firstWithAmount = Model.liFetchHallTicket.FirstOrDefault(x => !string.IsNullOrEmpty(x.AMOUNT) && x.AMOUNT != "0");
        if (firstWithAmount != null)
        {
            sFirstAmount = firstWithAmount.AMOUNT;
        }
        else if (Model.liFetchHallTicket.FirstOrDefault() != null)
        {
            sFirstAmount = Model.liFetchHallTicket.FirstOrDefault().AMOUNT ?? "0";
        }
    }
}

<style>
    /* Scoped Mobile Responsive & Clean Styles for Exam Registration Preview */
    .exam-preview-wrapper {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Top Institutional Header Card */
    .exam-header-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .exam-logo-wrapper {
        flex-shrink: 0;
        text-align: center;
    }

    .exam-logo-img {
        width: 120px;
        height: 120px;
        max-width: 100%;
        object-fit: contain;
    }

    .exam-college-info {
        flex: 1;
        text-align: center;
    }

    .exam-college-info h3 {
        margin: 0 0 4px 0;
        font-size: 19px;
        font-weight: 700;
        color: #1e293b;
        letter-spacing: -0.3px;
    }

    .exam-college-info h4 {
        margin: 0 0 3px 0;
        font-size: 14.5px;
        color: #475569;
        font-weight: 600;
    }

    .exam-college-info h5 {
        margin: 0 0 3px 0;
        font-size: 13px;
        color: #64748b;
    }

    .exam-college-info h6 {
        margin: 0 0 8px 0;
        font-size: 12px;
        color: #94a3b8;
    }

    .exam-form-badge {
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        padding: 8px 16px;
        display: inline-block;
        font-size: 13px;
        color: #0f172a;
        margin-top: 6px;
    }

    /* Student Meta Box */
    .student-meta-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .student-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px 24px;
    }

    .info-card {
        display: flex;
        align-items: baseline;
        font-size: 14px;
        padding: 6px 0;
        border-bottom: 1px dashed #f1f5f9;
    }

    .info-title {
        color: #64748b;
        font-weight: 600;
        min-width: 110px;
        flex-shrink: 0;
        font-size: 13px;
    }

    .info-value {
        color: #0f172a;
        font-weight: 600;
        word-break: break-word;
    }

    .badge-status-verified {
        background: #dcfce7;
        color: #15803d;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }

    .badge-status-unverified {
        background: #fee2e2;
        color: #b91c1c;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }



    /* Subjects Table */
    .table-container-responsive {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .table-custom-exam {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
    }

    .table-custom-exam thead th {
        background: #f8fafc;
        color: #334155;
        font-weight: 700;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 12px 14px;
        border-bottom: 2px solid #e2e8f0;
        white-space: nowrap;
    }

    .table-custom-exam tbody td {
        padding: 12px 14px;
        font-size: 13.5px;
        color: #334155;
        border-top: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .table-custom-exam tbody tr:hover {
        background-color: #f8fafc;
    }

    .badge-status-r {
        background: #e0f2fe;
        color: #0369a1;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    .badge-status-a {
        background: #fef3c7;
        color: #b45309;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    /* Exam Fee & Payment Banner */
    .exam-fee-banner {
        background: linear-gradient(135deg, #f0fdf4 0%, #e7fbf0 100%);
        border: 1.5px solid #86efac;
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .exam-fee-left {
        display: flex;
        flex-direction: column;
    }

    .exam-fee-title {
        font-size: 13px;
        font-weight: 700;
        color: #166534;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .exam-fee-val {
        font-size: 30px;
        font-weight: 800;
        color: #15803d;
        line-height: 1.2;
        margin: 4px 0;
    }

    .exam-fee-date {
        font-size: 13px;
        color: #16a34a;
        font-weight: 500;
    }

    .btn-proceed-pay {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        padding: 12px 28px !important;
        border-radius: 10px !important;
        font-weight: 700 !important;
        font-size: 15px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35) !important;
        transition: all 0.25s ease !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        cursor: pointer;
    }

    .btn-proceed-pay:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5) !important;
        color: #ffffff !important;
    }

    /* Notes Box */
    .notes-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #475569;
        line-height: 1.6;
    }

    .notes-card ol {
        margin: 6px 0 0 20px;
        padding: 0;
    }

    .signatures-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 10px 15px 10px;
        font-size: 14px;
        color: #334155;
    }

    /* Actions Bar */
    .actions-bar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    /* Responsive Breakpoints */
    @@media (max-width: 768px) {
        .exam-header-card {
            flex-direction: column;
            text-align: center;
            padding: 16px;
            gap: 12px;
        }

        .exam-logo-img {
            width: 85px;
            height: 85px;
        }

        .exam-college-info h3 {
            font-size: 16px;
        }

        .exam-college-info h4 {
            font-size: 13.5px;
        }

        .exam-college-info h5 {
            font-size: 12px;
        }

        .exam-form-badge {
            font-size: 12px;
            padding: 6px 12px;
            line-height: 1.5;
        }

        .student-info-grid {
            grid-template-columns: 1fr;
            gap: 6px;
        }

        .info-card {
            padding: 8px 0;
        }

        .exam-fee-banner {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            padding: 18px 16px;
        }

        .btn-proceed-pay {
            width: 100% !important;
            padding: 14px 20px !important;
            font-size: 15px !important;
        }

        .actions-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .actions-bar .btn {
            width: 100% !important;
            margin-bottom: 8px;
            padding: 12px 18px !important;
        }

        .signatures-row {
            flex-direction: column !important;
            gap: 30px;
            text-align: center;
            padding: 20px 0;
        }

        .legend-row {
            text-align: center !important;
            font-size: 12px;
        }
    }

    /* Print Styling */
    @@media print {
        body {
            background: white !important;
        }
        #content, .panel, .panel-body {
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
            box-shadow: none !important;
        }
        .hidden-print, .btn, .breadcrumb, .page-header, .panel-heading, #dvSubmit, #dvpay {
            display: none !important;
        }
        .exam-header-card {
            border: none !important;
            padding: 0 !important;
            box-shadow: none !important;
            flex-direction: row !important;
        }
        .exam-logo-img {
            width: 90px !important;
            height: 90px !important;
        }
        .exam-fee-banner {
            border: 1px solid #ccc !important;
            background: none !important;
        }
    }
</style>

<div id="content" class="content exam-preview-wrapper">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right hidden-print">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Exam Registration</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header hidden-print">Exam Registration</h1>
    <!-- end page-header -->

    <div class="form-horizontal">
        <div class="panel panel-primary">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="panel-heading hidden-print">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Exam Registration Preview</h4>
            </div>
            <div class="panel-body">
                @if (Model != null && Model.liFetchHallTicket != null && Model.liFetchHallTicket.Count > 0)
                {
                    if (Model.liFetchHallTicket.FirstOrDefault().IS_VIRIFIED == "1")
                    {
                        bFlag = false;
                    }

                    <div class="col-xs-12 hidden-print" style="margin-bottom: 15px; padding: 0;">
                        <span class="pull-right">
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvLoadSubjectDetails')" class="btn btn-sm btn-success">
                                <i class="fa fa-print m-r-5"></i> Print Application
                            </a>
                        </span>
                    </div>
                    <div class="clearfix"></div>

                    <div id="dvLoadSubjectDetails">
                        <!-- 1. Institutional Header Card -->
                        <div class="exam-header-card">
                            @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
                            {
                                <div class="exam-logo-wrapper">
                                    <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" class="exam-logo-img" alt="College Logo" />
                                </div>
                                <div class="exam-college-info">
                                    <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h3>
                                    <h4>@Model.liCollegeDetails.FirstOrDefault().PLACE</h4>
                                    <h5>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY</h5>
                                    @if (!string.IsNullOrEmpty(Model.liCollegeDetails.FirstOrDefault().GRADE))
                                    {
                                        <h6>@Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>"))</h6>
                                    }
                                    <div class="exam-form-badge">
                                        <strong>EXAMINATION APPLICATION FORM</strong><br />
                                        @{
                                            var defaultSemItem = Model.liFetchHallTicket.FirstOrDefault(x => x.STATUS == "R") ?? Model.liFetchHallTicket.FirstOrDefault();
                                        }
                                        <span>SEMESTER: <b>@(defaultSemItem != null ? defaultSemItem.SEMESTER_ID : "")</b> &nbsp;|&nbsp; MONTH & YEAR: <b>@(defaultSemItem != null ? defaultSemItem.MONTH_YEAR : "")</b></span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 2. Student Info Card -->
                        @if (Model.liExamRegistrationModel != null && Model.liExamRegistrationModel.Count > 0)
                        {
                            var stuInfo = Model.liExamRegistrationModel.FirstOrDefault();
                            <div class="student-meta-box">
                                <div class="student-info-grid">
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-user m-r-5 text-muted"></i> Name:</span>
                                        <span class="info-value">@stuInfo.NAME</span>
                                    </div>
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-id-card-o m-r-5 text-muted"></i> Register No:</span>
                                        <span class="info-value" style="color: #2563eb;">@stuInfo.REGISTER_NO</span>
                                    </div>
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-id-badge m-r-5 text-muted"></i> Roll No:</span>
                                        <span class="info-value">@stuInfo.ROLL_NO</span>
                                    </div>
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-graduation-cap m-r-5 text-muted"></i> Major:</span>
                                        <span class="info-value">@stuInfo.PROGRAMME_NAME</span>
                                    </div>
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-calendar m-r-5 text-muted"></i> Date of Birth:</span>
                                        <span class="info-value">@stuInfo.DATE_OF_BIRTH</span>
                                    </div>
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-shield m-r-5 text-muted"></i> Status:</span>
                                        <span class="info-value">
                                            @if (bFlag)
                                            {
                                                <span class="badge-status-unverified"><i class="fa fa-clock-o m-r-5"></i> Not Verified</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status-verified"><i class="fa fa-check-circle m-r-5"></i> Verified</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="info-card">
                                        <span class="info-title"><i class="fa fa-language m-r-5 text-muted"></i> Name in Tamil:</span>
                                        <span class="info-value" id="tamilname">@stuInfo.NAME_IN_NATIVE</span>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" value="@stuInfo.NAME_IN_NATIVE" id="encodetamilname">
                        }



                        <input type="hidden" name="name" id="hdFrequencyId" />

                        <!-- 4. Registered Subjects Table (Ordered Semester Wise) -->
                        <div class="table-container-responsive">
                            @{
                                int No = 0;
                                Func<string, int> getSemOrder = delegate(string sem) {
                                    if (string.IsNullOrEmpty(sem)) return 999;
                                    int s;
                                    if (int.TryParse(sem.Trim(), out s)) return s;
                                    switch (sem.Trim().ToUpper())
                                    {
                                        case "I": return 1;
                                        case "II": return 2;
                                        case "III": return 3;
                                        case "IV": return 4;
                                        case "V": return 5;
                                        case "VI": return 6;
                                        case "VII": return 7;
                                        case "VIII": return 8;
                                        default: return 999;
                                    }
                                };
                                var sortedHallTicket = Model.liFetchHallTicket != null
                                    ? Model.liFetchHallTicket.OrderBy(x => getSemOrder(x.SEMESTER)).ToList()
                                    : new List<CMS.ViewModel.Model.FetchHallTicket>();
                            }
                            <table class="table table-custom-exam">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">#</th>
                                        <th style="width: 100px; text-align: center;">Semester</th>
                                        <th style="width: 130px;">Course Code</th>
                                        <th>Title of the Paper</th>
                                        <th style="width: 100px; text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in sortedHallTicket)
                                    {
                                        No++;
                                        <tr>
                                            <td style="text-align: center; font-weight: bold; color: #64748b;">@No</td>
                                            <td style="text-align: center;">@item.SEMESTER</td>
                                            <td><strong style="color: #1e3a8a;">@item.COURSE_CODE</strong></td>
                                            <td>@item.COURSE_TITLE</td>
                                            <td style="text-align: center;">
                                                @if (item.STATUS == "R")
                                                {
                                                    <span class="badge-status-r">Regular</span>
                                                }
                                                else if (item.STATUS == "A")
                                                {
                                                    <span class="badge-status-a">Arrear</span>
                                                }
                                                else
                                                {
                                                    <span>@item.STATUS</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- 5. Exam Fee & Payment Flow Card (Taking First/Default Amount) -->
                        <div class="exam-fee-banner">
                            <div class="exam-fee-left">
                                <span class="exam-fee-title"><i class="fa fa-credit-card m-r-5"></i> Total Exam Fee Amount to Pay</span>
                                <div class="exam-fee-val"><i class="fa fa-inr"></i> @sFirstAmount</div>
                                @if (Model.liExamRegistrationModel != null && Model.liExamRegistrationModel.Count > 0)
                                {
                                    <div class="exam-fee-date"><i class="fa fa-calendar m-r-5"></i> Date: @Model.liExamRegistrationModel.FirstOrDefault().DATE</div>
                                }
                            </div>
                            <div class="exam-fee-right" id="dvpay">
                                @if (!bFlag)
                                {
                                    <a href="javascript:;" onclick="loadContent('/Examination/PayExamFee')" class="btn btn-proceed-pay">
                                        <i class="fa fa-credit-card m-r-5"></i> Proceed to Pay (&#8377; @sFirstAmount)
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:;" onclick="SubmitVerified()" class="btn btn-proceed-pay">
                                        <i class="fa fa-check-circle m-r-5"></i> Verify &amp; Proceed (&#8377; @sFirstAmount)
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Legend -->
                        <div class="legend-row text-right" style="color: #64748b; margin-bottom: 20px; font-size: 13px;">
                            <strong>Legend:</strong> &nbsp;&nbsp; R - Regular &nbsp;&nbsp;|&nbsp;&nbsp; A - Arrears &nbsp;&nbsp;|&nbsp;&nbsp; AAA - Absent
                        </div>

                        <!-- Signatures Row -->
                        <div class="signatures-row">
                            <div>
                                <b>Signature of the Class Teacher</b>
                            </div>
                            <div>
                                <b>Signature of the Candidate</b>
                            </div>
                        </div>
                        <hr style="margin: 15px 0 20px 0; border-top: 1px dashed #cbd5e1;" />

                        <!-- Notes Box -->
                        <div class="notes-card">
                            <strong style="color: #1e293b;"><i class="fa fa-info-circle m-r-5 text-primary"></i> Important Instructions:</strong>
                            <ol>
                                <li>Verify your name and personal details as found in your records (SSLC).</li>
                                <li>Verify the paper and subject code carefully.</li>
                                <li>The fees once paid will not be refunded under any circumstances.</li>
                                <li>If there is any issue, please contact your class teacher or the examination cell immediately.</li>
                            </ol>
                        </div>

                        <!-- Actions Bar (Submit verification & Nominal Roll) -->
                        <div class="actions-bar hidden-print" id="dvSubmit">
                            @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0 && Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE == "SJC")
                            {
                                if (bFlag)
                                {
                                    <a href="javascript:;" class="btn btn-primary btn-lg" onclick="SubmitVerified()" style="font-weight: 700; padding: 10px 24px;">
                                        <i class="fa fa-check-circle m-r-5"></i> Verify &amp; Proceed
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:;" class="btn btn-success btn-lg" onclick="loadContent('/Examination/PayExamFee')" style="font-weight: 700; padding: 10px 24px;">
                                        <i class="fa fa-credit-card m-r-5"></i> Proceed to Pay (&#8377; @sFirstAmount)
                                    </a>
                                }
                            }
                            @if (Model.liExamRegistrationModel != null && Model.liExamRegistrationModel.Count > 0)
                            {
                                sFile = "/NominalRoll/" + Model.liExamRegistrationModel.FirstOrDefault().CLASS_ID + ".xlsx";
                                <a href="@sFile" class="btn btn-warning" style="font-weight: 600; padding: 10px 20px;">
                                    <i class="fa fa-file-excel-o m-r-5"></i> Nominal Roll
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center" style="padding: 50px 20px;">
                        <i class="fa fa-folder-open-o" style="font-size: 48px; color: #cbd5e1; margin-bottom: 12px; display: block;"></i>
                        <h4 style="color: #64748b; font-weight: 600;">No Examination Records Found</h4>
                        <p class="text-muted">You are not currently registered for this examination session or records have not been released.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/AdmissionContent/js/jquery.min.js"></script>
<script src="~/AdmissionContent/js/utf.js"></script>
<script src="~/AdmissionContent/js/tamil.js"></script>
<script>
    function ContentLoad() {
        $('#tamilname').text(decodeURI($('#encodetamilname').val()));
    }

    function SubmitVerified() {
        swal({
            title: "Verify & Proceed to Payment",
            text: "Please verify your course code and title of the paper...!\nIf something went wrong please meet exam registration committee..!\nNo modification will be done after registration!",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-success",
            confirmButtonText: "Yes, Verify & Proceed!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: '/Examination/SaveVerified',
                method: 'POST',
                datatype: 'json',
                data: { sTamil: $('#encodetamilname').val() || '' },
                success: function (data) {
                    if (data.ErrorCode == "200") {
                        swal({ title: "Verified Successfully!", text: "Redirecting to payment page...", showConfirmButton: false, timer: 1200, type: 'success', animation: true });
                        setTimeout(function () {
                            loadContent('/Examination/PayExamFee');
                        }, 1200);
                    } else {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: true, type: 'error', animation: true });
                    }
                },
                error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: true, type: 'error', animation: true });
                }
            });
        });
    }

    function printDiv(divName) {
        $('#dvSubmit').addClass('hidden');
        $('#dvpay').addClass('hidden');

        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/ExamRegistrationPriview');
    }
</script>