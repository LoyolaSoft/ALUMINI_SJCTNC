@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "QuizQuestionImportForStaff";
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">QuizExcelUpload</li>
    </ol>
    <h1 class="page-header">Quiz Excel Upload </h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Quiz Excel Upload </h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dClass" })
                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.CourseList, "Course", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dCourse" })
                            @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-4 form-group">
                        @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            <select class="form-control selectpicker show-menu-arrow show-tick" data-live-search="true" id="ddlSetting">
                                <option value="0"> -- Select -- </option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-5">
                        @Html.Label("File", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <input type="file" id="ExcelUpload" />
                            @*<a class="btn btn-primary" onclick="ClickFile()">File</a>*@
                        </div>
                    </div>
                    <div class="col-md-2">
                        <a href="javascript:;" class="btn btn-primary" id="btnGet">Import</a>
                    </div>
                    <div class="col-md-2 pull-right">
                        <a href="~/Content/ExcelTemplate/QuizTemplate.xlsx" download class="btn btn-primary" id="btnGet">Quiz Template</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    ContentLoad = function () {
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }
    function ClickFile() {
        $('#ExcelUpload').click();
    }


    $("#dClass").on("change", function ()
    {
        var Class = $("#dClass").val();
        $.ajax({
            url: "@Url.Action("FethCourseByClassId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { Class_Id: Class },
            success: function (data)
            {
                $("#dCourse").empty();
                $("#dCourse").append('<option value=""> -- Select -- </option>' + data);

                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    });

    $('#btnGet').click( function () {

        if ($('#dClass').val() && $('#dCourse').val()  && $("#ddlSetting").val())
        {
            var sFlag = false;
        var formData = new FormData();
        var sFile = $('#ExcelUpload').get(0).files;
        if (sFile.length != 0) {
            for (var i = 0; i < sFile.length; i++)
            {
                formData.append(sFile[i].name, sFile[i]);
                sFlag = true;
            }
        }
            formData.append("sClassId", $('#dClass').val());
            formData.append("sCourseId", $('#dCourse').val());
            formData.append("sSettingId", $('#ddlSetting').val());
            if ($('#dClass').val() && sFlag)
        {
            $.ajax({
                url: '@Url.Action("SaveQuizQuestionImport", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data)
                {
                    alert(data.Message);
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
        }
        else {
            alert("Pleas Select All the fields")
        }
    });


    $("#dCourse").on("change", function ()
    {
        if ($("#dCourse").val() != 0)
        {
            $.ajax({
                url: "@Url.Action("FetchSettingInfoByClassAndCourseIds", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sClassId: $("#dClass").val(), sCourseId: $("#dCourse").val() },
            success: function (data)
            {
                $("#ddlSetting").empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $("#ddlSetting").append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                alert('Internal Server Error .!');
            }
        });
    }
    });

    function printDiv(sDivName) {
        var printContents = document.getElementById(sDivName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/OnlineExamReportByClassAndCourse');
    }


</script>



