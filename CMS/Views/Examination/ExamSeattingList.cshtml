@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ExamSeattingList";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Seating Allotment</li>
    </ol>
    <h1 class="page-header">Seating Allotment</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Seating Allotment</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamType, "Exam Type", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamType, "", new { @class = "text-danger" })
                            </div>
                        </div>                        
                        <div class="form-group col-md-1">
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvFeeReportBind')" class="btn btn-success hidden m-b-10">PDF</a>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" id="btnExport" class="btn btn-success hidden m-b-10">Export</a>
                        </div>
                        <div class="form-group">
                            <a class="btn btn-success pull-right" title="Click to Add" href="#Room-dialog" data-toggle="modal"><i class="fa fa-plus"></i> Add</a>
                        </div>                        
                    </div>
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="dvFeeReportBind"></div>
                </div>
            }
        </div>
    </div>
</div>
<div class="modal" id="Room-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <input type="hidden" id="hdRoomId" />
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Type</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", id = "ddExamType" })
                                </div>
                            </div>                           
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 4
    });
    //ExamType OnChange
    $('#ExamType').on('change', function () {
        loadGird();
    });
    //This to Load the table
    function loadGird() {
        $('#btnExport').addClass('hidden');
        var vExamType = $('#ExamType').val();
        if (vExamType != 0) {
            $.ajax({
                url: '@Url.Action("BindExamSeattingList", "Examination")',
                data: { sExamType: vExamType },
                success: function (option) {
                    var dvFeeStructureBind = $('#dvFeeReportBind');
                    dvFeeStructureBind.empty();
                    if (option.Message != null && option.Message != '') {
                        alert(option.Message);
                    } else {
                        dvFeeStructureBind.append(option);
                        $('#btnExport').removeClass('hidden');
                        $('#sPrint').removeClass('hidden');
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        } else {
            $('#dvFeeReportBind').empty();
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }
    //Excel Export
    $("#btnExport").click(function (e) {   
        var sClassYear = $('#ExamType Option:selected').text();
        let file = new Blob([$('#dvFeeReportBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: sClassYear + "_SeatingLayout.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/ExamSeattingList');
    }
</script>
<script>
    $('#btnSubmit').on('click', function () {
        var vExamType = $('#ddExamType').val();
        var JsonData = null;
        if (vExamType != 0) {
            $.ajax({
                url: '@Url.Action("SaveExamSeatting", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sExamType: vExamType },
                success: function (data) {
                    alert(data.Message);
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        } else {
            alert('Please Select ExamType!');
            return false;
        }
    });
</script>
