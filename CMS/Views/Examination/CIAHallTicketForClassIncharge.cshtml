@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "CIAHallTicketForClassIncharge";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<style>
    .table-bordered td {
        border: none !important;
        border-right: solid 1px #ccc !important;
    }

    page {
        size: A4;
        margin: 11mm 17mm 17mm 17mm;
        width: 21cm;
        height: 29.7cm;
        position: absolute;
        top: 40px;
        left: 30px;
    }

    .noprint {
        display: none !important;
        height: 0px !important;
    }
</style>


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">CIA Progress Report</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Progress Report</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CIA Progress Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ClassList, "Class List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.StudentList, "Student List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", multiple = "multiple", data_actions_box = "true", data_selected_text_format = "count" })
                                @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamType, "Exam Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSetting, "Exam Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-2">
                            <a class="btn btn-primary disabled" id="btnGetIndvidualCIAMark" title="Click to Get the MarkSheet">Get</a>
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvIndividualCIAMark')" class="btn btn-success m-b-10 pull-right hidden"><i class="fa fa-print m-r-5"></i>Get PDF</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div id="dvIndividualCIAMark"></div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 4
    });

    $("#ClassList").on("change", function () {
        var sClass = $('#ClassList').val();
        if (sClass == '' || sClass == '0' || sClass == null) {
            alert('Please Choose Class...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindStudentByClassId", "Student")",
            method: "POST",
            datatype: "json",
            data: { sClassId: $('#ClassList').val()},
            success: function (data) {
                $("#StudentList").empty();
                $("#StudentList").append(data);
                $('.selectpicker').selectpicker('refresh');
                $('#btnGetIndvidualCIAMark').removeClass("disabled");
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });

    $('#ExamType').on('change', function () {
        var vAcademicYear = @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR].ToString();
        var vExamTyper = $('#ExamType').val();
        if (vExamTyper != "0" && vExamTyper != "2") {
            $.ajax({
                url: '@Url.Action("FetchCIAExamSetting", "Examination")',
                data: { sAcademicYear: vAcademicYear },
                success: function (objResult) {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });

        } else if (vExamTyper != "0" && vExamTyper != "1") {
            $.ajax({
                url: '@Url.Action("FetchExamSetting", "Examination")',
                data: { sAcademicYear: vAcademicYear },
                success: function (objResult) {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    });

    $("#btnGetIndvidualCIAMark").on("click", function () {
        var vStudent = String ($('#StudentList').val());
        var vExamType = $('#ExamType').val();
        var vExamSettingId = $('#ExamSetting').val();
        if (vStudent == null || vStudent == "" && $('#ExamSetting').val() && $('#ExamType').val()) {
            alert('Please Choose All the Fields...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindCIAHallTicketForClassIncharge", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sStudentId: vStudent, sExamType: vExamType, sExamSettingId: vExamSettingId },
            success: function (data) {
                $('#dvIndividualCIAMark').empty();
                $('#dvIndividualCIAMark').append(data);
                $('#sPrint').removeClass("hidden");
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        })
    })
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/CIAHallTicketForClassIncharge');
    }
</script>

