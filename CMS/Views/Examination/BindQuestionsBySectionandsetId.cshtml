<div id="chatdiv">
    <a href="#chatmodal" data-toggle="modal" class="chat" id="btnchat" status="0" onclick="FetchChatMessages()"><i class="glyphicon glyphicon-envelope">Chat</i></a>
</div>
<input type="hidden" id="msgcount">
<script>

    var chat = $('#chat').val();
    if (chat != "1")
    {
        $('#chatdiv').addClass('hidden');
    }
    // On Submit ...
    $('#btnSubmit').on('click', function ()
    {
        var btnValue = $('#btnSubmit').val();
        var courseid = $('#courseid').val();
        var examsettingid = $('#examsettingid').val();
        var setid = $('#setid').val();
        var studentid = $('#userid').val();
        var acyear = $('#acyear').val();
        var sectionid = $("input[name='section']:checked").val();
        var JsonCount = 0;
        var JsonData = '{"liOnlineExamanswer":[';
        var sStatus = null;
        var AnswerId = $('#Questiondiv').attr('answerid');
        var sQuestionType = $('#Questiondiv').attr('questiontype');
        var sQuizId = $('#Questiondiv').attr('questionid');

        if (sQuestionType == "1") {

            var AnswerId = $('input[name="' + sQuizId + '"]:checked').attr('cms-AnswerId');
            var OptionId = $('input[name="' + sQuizId + '"]:checked').attr('cms-OptionId');
            var SetId = $('input[name="' + sQuizId + '"]:checked').attr('cms-SetId');
            if (AnswerId != null && AnswerId != '' && AnswerId != 'undefine') {
                if (AnswerId == OptionId) { sStatus = 1; } else { sStatus = 0; }
                JsonData += '{"QUIZ_ID":"' + sQuizId + '",\
                                              "ANSWER_ID":"' + AnswerId + '","OPTION_ID":"' + OptionId + '", "STATUS":"' + sStatus + '",\
                                              "COURSE_ID":"' + courseid + '","STUDENT_ID":"' + $('#userid').val() + '","QUESTION_TYPE":"' + sQuestionType + '","MINUTES":"' + $('#lblQuizTimeRunner').text() + '"},';
                JsonCount++;
            }

        }
        else if (sQuestionType == "2") {
            var sAnswer = $('#Questiondiv').find('select Option:selected').val();
            var sQuizId = $('#Questiondiv').find('select Option:selected').attr('cms-sQuizId');
            var sAnswerId = $('#Questiondiv').find('select Option:selected').attr('cms-AnswerId');
            var sSetId = $('#Questiondiv').find('select Option:selected').attr('cms-SetId');
            if (sAnswer != 0) {
                if (sAnswer != null && sAnswer != 'undefined') {
                    if (sAnswerId == sAnswer) { sStatus = 1; } else { sStatus = 0; }
                    JsonData += '{"QUIZ_ID":"' + sQuizId + '",\
                                              "ANSWER_ID":"' + AnswerId + '","OPTION_ID":"' + OptionId + '", "STATUS":"' + sStatus + '",\
                                              "COURSE_ID":"' + courseid + '","STUDENT_ID":"' + $('#userid').val() + '","QUESTION_TYPE":"' + sQuestionType + '","MINUTES":"' + $('#lblQuizTimeRunner').text() + '"},';
                    JsonCount++;
                }
            }
        }
        else if (sQuestionType == "3") {

            $('#Questiondiv').find('select').each(function () {

                var sAnswer = $(this).find('option:selected').val();
                var sQuizId = $(this).find('option:selected').attr('cms-sQuizId');
                var sOptionId = $(this).find('option:selected').attr('cms-OptionId');
                if (sAnswer != 0) {
                    if (sAnswer != null && sAnswer != 'undefined') {
                        if (sOptionId == sAnswer)
                        { sStatus = 1; } else { sStatus = 0; }
                        JsonData += '{"QUIZ_ID":"' + sQuizId + '",\
                                              "ANSWER_ID":"' + AnswerId + '","OPTION_ID":"' + OptionId + '", "STATUS":"' + sStatus + '",\
                                              "COURSE_ID":"' + courseid + '","STUDENT_ID":"' + $('#userid').val() + '","QUESTION_TYPE":"' + sQuestionType + '","MINUTES":"' + $('#lblQuizTimeRunner').text() + '"},';
                        JsonCount++;
                    }
                }

            });
        }
        else if (sQuestionType == "4") {
            BindQuestions();
            faceCam();
            return false;
        }
        else if (sQuestionType == "5") {
            BindQuestions();
            faceCam();
            return false;
        }
        if (JsonCount != 0) {
            JsonData = JsonData.slice(0, -1);
            JsonData += ']}';
        }
        else {
            $('#message').text('Please Choose Options to Continue !');
            return false;
        }
        $('#btnSubmit').addClass('disabled');

        $.ajax({
            url: '@Url.Action("SaveStudentExamQuestionandAnswer", "Examination")',
            method: 'POST',
            datatype: 'json',
            data: { sJsonSave: JsonData, sExamsettingId: examsettingid, sCourseId: courseid, sUserId: $('#userid').val(), sAcademicYear: $('#acyear').val(), sTimeSpend: $('#lblQuizTimeRunner').text() },
            success: function (data)
            {

                if (data.ErrorCode == "200")
                {
                    BindQuestions();
                   
                }
                $('#btnSubmit').removeClass('disabled');
            },
            error: function (error)
            {
                alert('Internal Server Error !');
                $('#btnSubmit').removeClass('disabled');
            }
        });

    });
    function BindQuestions()
    {
        var courseid = $('#courseid').val();
        var examsettingid = $('#examsettingid').val();
        var setid = $('#setid').val();
        var studentid = $('#userid').val();
        var acyear = $('#acyear').val();
        var sectionid = $("input[name='section']:checked").val();
        $.ajax({
            url: '@Url.Action("BindQuestionsBySectionandsetId", "Examination")',
            method: 'POST',
            datatype: 'json',
            data: { sCourseId: courseid, sExamsettingid: examsettingid, sSetid: setid, setid, sSectionId: sectionid, sAcademicYear: acyear, sUserId: studentid },
            success: function (data)
            {
                $('#dvOnlineQuiz').empty();
                $('#dvOnlineQuiz').append(data);
            },
            error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }
</script>

<script>
    $("input:checkbox").on('change', function ()
    {
        $('#confirmationmodal').modal('show');
        // in the handler, 'this' refers to the box clicked on
        var $box = $(this);
        if ($box.is(":checked")) {
            // the name of the box is retrieved using the .attr() method
            // as it is assumed and expected to be immutable
            var group = "input:checkbox[name='" + $box.attr("name") + "']";
            // the checked state of the group/box on the other hand will change
            // and the current value is retrieved using .prop() method
            $(group).prop("checked", false);
            $box.prop("checked", true);
        } else {
            $box.prop("checked", false);

        }
        $('#divanswerupdate').removeClass('hidden');
        if (!isMobile()) {
            answerVideo();
        } else {
            $('#btnOpenCamera').removeClass('hidden');
        }
    });
    $('#btnconfirm').on('click', function ()
    {
        var $box = $('input:checkbox');
        if ($box.is(":checked"))
        {
            var group = "input:checkbox[name='" + $box.attr("name") + "']";
            $(group).prop("disabled", true);
            $box.prop("disabled", true);
        }
        else {
            $box.prop("disabled", true);
        }
        $('#confirmationmodal').modal('hide');
    });
    var video = document.querySelector("#video");

    function answerVideo() {
        if (isMobile()) {
            if (window.stream) {
                window.stream.getTracks().forEach(track => {
                    track.stop();
                });
            }
        }

        // Basic settings for the video to get from Webcam
        const constraints =
            {
                audio: false,
                video: {
                    width: 475, height: 475, facingMode: 'environment'
                }
            };

        // This condition will ask permission to user for Webcam access
        if (navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia(constraints)
                .then(function (stream) {
                    window.stream = stream;
                    video.srcObject = stream;
                 //   currentStream = stream;
                })
                .catch(function (err0r) {
                    console.log("Something went wrong in answer webcam");
                });

        }
    }

    function stop(e) {
        var stream = video.srcObject;
        var tracks = stream.getTracks();

        for (var i = 0; i < tracks.length; i++) {
            var track = tracks[i];
            track.stop();
        }
        video.srcObject = null;
    }
    $("#btncaptrue").click(function () {

        var canvas = document.getElementById('canvas');
        var rect = canvas.getBoundingClientRect();
        var context = canvas.getContext('2d');
        // Capture the image into canvas from Webcam streaming Video element
        context.drawImage(video, 0, 0);
        $('#btnSave').removeClass('hidden');
    });
    $("#btnSave").click(function ()
    {
        $('#btnSave').addClass('disabled');
        var questiontypeid = $(this).attr('questiontypeid');
        var courseid = $('#courseid').val();
        var examsettingid = $('#examsettingid').val();
        var setid = $('#setid').val();
        var studentid = $('#userid').val();
        var acyear = $('#acyear').val();
        var sectionid = $("input[name='section']:checked").val();
        var JsonData = null;
        var questiontype = $(this).attr('questiontype');
        if ($('input[name=' + questiontypeid + ']').is(":checked")) {
            JsonData = '{"COURSE_ID" : "' + courseid + '", "STUDENT_ID" : "' + studentid + '","ACADEMIC_YEAR" : "' + acyear + '","EXAM_SETTING_ID" : "' + examsettingid + '","QUIZ_ID" : "' + $('input[name=' + questiontypeid + ']:checked').attr('cms-sQuizId') + '","OPTION_ID" : "' + $('input[name=' + questiontypeid + ']:checked').attr('cms-OptionId') + '","MINUTES":"' + $('#lblQuizTimeRunner').text() + '"}';
            // Below new canvas to generate flip/mirron image from existing canvas
            var destinationCanvas = document.createElement("canvas");
            var destCtx = destinationCanvas.getContext('2d');
            destinationCanvas.height = 500;
            destinationCanvas.width = 500;
            destCtx.translate(video.videoWidth, 0);
            destCtx.scale(-1, 1);
            destCtx.drawImage(document.getElementById("canvas"), 0, 0);
            // Get base64 data to send to server for upload
            var imagebase64data = destinationCanvas.toDataURL("image/png");
            imagebase64data = imagebase64data.replace('data:image/png;base64,', '');
            
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SaveEitherQuestionAnswer", "Examination")',
                data: { sJsonData: JsonData, sImagedata: imagebase64data, sQuestiontype: questiontype },
                dataType: 'json',
                success: function (data) {
                    //
                    if (data != null) {
                        var count = 0;
                        $('#imgtablediv').removeClass('hidden');
                        $('#imgtablediv').empty();
                        var table = '';
                        table += '<table class="table table-bordered">';
                        $.each(data, function (i, item) {
                            count++;
                            table += '<tr id="' + item.QUIZ_SAVE_ID + '">';
                            table += '<td>' + count + '</td><td><img src=' + item.IMAGE_PATH + ' style="height:80px;width:80px"></td><td><a href="#" onclick="DeleteImage(' + item.QUIZ_SAVE_ID + ',' + item.QUESTION_TYPE_ID + ')"> <i class="glyphicon glyphicon-trash"></i></a></td>';
                            table += '</tr>';

                        });
                        table += '</table>';

                        $('#imgtablediv').append(table);

                    }
                    $('#btnSave').removeClass('disabled');
                },
                error: function (error)
                {
                    alert('Internal Server Error !');
                    $('#btnSave').removeClass('disabled');
                }
            });
        }
        else
        {
            $('#message').text('Please select the question...!');
            $('#btnSave').removeClass('disabled');
        }
    });
    function DeleteImage(ID, QT) {

        $.ajax({
            type: 'POST',
            url: '@Url.Action("DeleteUploadImages", "Examination")',
            data: { sQuestionSaveid: ID, sQuestiontype: QT },
            dataType: 'json',
            success: function (data) {
                if (data.ErrorCode = "202") {
                    $('#' + ID).remove();
                }
            },
            error: function (error) {
                alert('Internal Server Error !');
            }
        });

    }
</script>

<script>
   
    $('#sendmsg').on('click', function () {
        var Examinvigilationid = $('#examinvigilationid').val();
        var StaffId = $('#invigilatorid').val();
        var Message = $('#write_msg').val();
        var UserId = $('#userid').val();

        $.ajax({
            url: '@Url.Action("SaveChatMessages", "Examination")',
            method: 'POST',
            datatype: 'json',
            data: { sInvigilationId: Examinvigilationid, sInvigilatorId: StaffId, sSenderId: UserId, sMessage: Message },
            success: function (data) {
                var currentdate = new Date();
                var datetime = "Now: " + currentdate.getDate() + "/"
                            + (currentdate.getMonth() + 1) + "/"
                            + currentdate.getFullYear() + "|"
                            + currentdate.getHours() + ":"
                            + currentdate.getMinutes() + ":"
                            + currentdate.getSeconds();
                var msgdiv = '<div class="outgoing_msg"><div class="sent_msg"><p>' + Message + '</p> <span class="time_date">' + datetime + '</span></div></div>';
                $('.msg_history').append(msgdiv);
                $('#write_msg').val('');
            },
            error: function (error) {
                console.log('Internal Server Error !');
            }
        });
    });
    function FetchChatMessages() {

        var Examinvigilationid = $('#examinvigilationid').val();
        $.ajax({
            url: '@Url.Action("FetchChatMessage", "Examination")',
            method: 'POST',
            datatype: 'json',
            data: { sInvigilationId: Examinvigilationid },
            success: function (data) {

                $('.msg_history').empty();
                var msghistory = '';
                if (data != null && data != "") {
                    if (data.length > parseInt($('#msgcount').val())) {
                        $('#chatmodal').modal({
                            show: 'true'
                        });
                    }
                    $('#msgcount').val(data.length);
                    $.each(data, function (i, item) {
                        if (item.MESSAGE_TYPE == "1") {
                            msghistory += '<div class="outgoing_msg"><div class="sent_msg"><p>' + item.MESSAGE + '</p> <span class="time_date">' + item.DATE + '|' + item.TIME + '</span></div></div>';
                        }
                        else {
                            msghistory += '<div class="incoming_msg"><div class="received_msg"><div class="received_withd_msg"><p>' + item.MESSAGE + '</p><span class="time_date"> ' + item.DATE + '|' + item.TIME + '</span></div></div>';
                        }

                    });
                }

                $('.msg_history').append(msghistory);
            },
            error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }
    if (chat == "1")
    {
        setInterval(function () { FetchChatMessages() }, 60000);
    }


</script>




