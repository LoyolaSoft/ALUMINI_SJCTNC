<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }

    .dueListDiv {
        border: 2px solid #097272;
        display: flex;
        justify-content: center;
        text-align: center;
        padding-top: 6px;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ExamInvigilationStaffWise</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam Invigilation Staff Wise</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam Invigilation Staff Wise</h4>
        </div>
        <div class="panel-body">


            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#EditDetails" onclick="Add()" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div>
                    <div class="form-group col-md-5">
                        @Html.Label("Ac Year", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "AcademicYearDrop" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-5 form-group">
                        @Html.Label("Exam Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ExamSettingDrop" })
                            @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-6 dueListDiv ">
                            <div class="col-md-6">

                                <a href="#ExcelFileUPload" class="btn bg-primary pull-right m-b-5 " data-toggle="modal" title="View"><i class="fa fa-file-excel-o bg-primary"></i>Exam Invigilation Upload</a>
                            </div>
                            <div class="col-md-4">
                                <a href="~/Content/ExcelTemplate/Exam_Invigilation_Staff_Template.xlsx" class="btn bg-warning pull-right m-b-5 " data-toggle="modal" title="View"><i class="fa fa-file-excel-o bg-warning"></i> Excel Template</a>
                            </div>
                        </div>
                        <div class="text-center col-md-3 pull-right">
                            <a href="~/ExamFileLog/ExamInvigilation/@currentDate" class="btn bg-danger  m-b-5 " data-toggle="modal" title="View" target="_blank"><i class="fa fa-file-text-o bg-danger"></i> Download Error Log</a>

                        </div>
                    </div>
                </div>
                <hr />

                <div class="form-horizontal">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="col-md-12" id="divbind">

                    </div>

                </div>
                <br />
                <div id="bindAcYearWiseBusFeeList">
                    <div class="col-md-12 table-responsive">
                        <table class="table table-hover table-bordered" width="100%" id="StudentList">
                            <thead>
                                <tr>
                                    <th><b>#</b></th>
                                    <th><b>Staff Code</b></th>
                                    <th><b>Name</b></th>
                                    <th><b>Exam Date</b></th>
                                    <th><b>Hall Name</b></th>
                                    <th><b>Sesssion</b></th>
                                    <th><b>Exam Name</b></th>
                                    <th><b>Action</b></th>
                                </tr>

                            </thead>
                            <tbody>
                                @if (Model.LiExamInvigilationStaffWise != null)
                                {
                                    foreach (var item in Model.LiExamInvigilationStaffWise)
                                    {
                                        <tr>
                                            <td>
                                                @{ count++;} <b>@count</b>
                                            </td>

                                            <td>
                                                @item.STAFF_CODE
                                            </td>
                                            <td>
                                                @item.FIRST_NAME
                                            </td>
                                            <td>
                                                @item.EXAM_DATE
                                            </td>
                                            <td>@item.HALL_NAME</td>
                                            <td>
                                                @item.SESSION_NAME
                                            </td>
                                            <td>@item.EXAM_NAME</td>

                                            <td>
                                                <a href="#EditDetails" onclick="FetchDetailsByID(@item.EXAM_INVIGILATION_ID);" data-toggle="modal" title="View"><i class="fa fa-edit text-primary"></i></a>

                                                <a onclick="DeletedList(@item.EXAM_INVIGILATION_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            }
        </div>

        <div class="modal" id="EditDetails">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <h4 class="modal-title">Add / Edit Exam Invigilation Details</h4>
                    </div>
                    <div class="modal-body" data-parsley-validate="true" id="IQACProject">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="col-md-12 form-horizontal">
                                            <input id="txtEXAM_INVIGILATION_ID" hidden />


                                            <div class="col-md-12 form-group">
                                                @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                                                <div class="col-md-8">
                                                    @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "EdAcademicYear", @data_parsley_required = "true" })
                                                    @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-md-12 form-group">
                                                @Html.Label("Exam Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                                                <div class="col-md-8">
                                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "EdExamSetting", @data_parsley_required = "true" })
                                                    @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-md-12 form-group">
                                                @Html.Label("Staff List", htmlAttributes: new { @class = "control-label col-md-4" })
                                                <div class="col-md-8">
                                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "EdStaffList", @data_parsley_required = "true" })
                                                    @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-md-12 form-group">
                                                @Html.Label("Exam Session", htmlAttributes: new { @class = "control-label col-md-4" })
                                                <div class="col-md-8">
                                                    @Html.DropDownListFor(model => model.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "EdExamSession", @data_parsley_required = "true", @data_live_search = "true" })
                                                    @Html.ValidationMessageFor(model => model.ExamSession, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="col-md-12 form-group">
                                                @Html.Label("Exam Date", htmlAttributes: new { @class = "control-label col-md-4" })
                                                <div class="col-md-8">
                                                    <input type="text" id="EdExamDate" class="datepicker date form-control" data-parsley-required="true" />
                                                </div>
                                            </div>
                                            <div class="col-md-12 form-group">
                                                <label class="col-md-4 control-label">Hall Name</label>

                                                <div class="col-md-8">
                                                    <input type="text" id="EdHallName" class="form-control" placeholder="Hall Name" data-parsley-required="true">
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" id="btnSubmit" onclick="SaveOrUpdateData()" class="btn btn-sm btn-primary">Submit</a>
                        <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="ExcelFileUPload">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-orange-lighter">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        <p class="modal-title f-s-15 f-w-200 text-white">Upload Invigilation Staff List </p>
                    </div>
                    <div class="modal-body">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group col-md-12">
                            @Html.Label("Academic Year", htmlAttributes: new { @class = "control-label col-md-3" })

                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "AcademicYearExcel" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            @Html.Label("Exam Setting", htmlAttributes: new { @class = "control-label col-md-3" })

                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ExamSettingExcel" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group col-md-12">
                                @Html.Label("Upload", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="file" class="btn btn-primary" id="HeadExcelUpload" required />
                                    @*<a class="btn btn-primary" onclick="ClickFile()">File</a>*@
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="javascript:;" class="btn btn-sm btn-success" data-dismiss="modal" id="" onclick="SaveExcelUpload()">Submit</a>
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    $(document).ready(function () {
        $(".date").datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
    });
    $("#AcademicYearExcel").on('change', function () {
        LoadExamSetting("#AcademicYearExcel", "#ExamSettingExcel");
    });

    $("#EdAcademicYear").on('change', function () {
        LoadExamSetting("#EdAcademicYear", "#EdExamSetting");
    });

    $("#AcademicYearDrop").on('change', function () {
        LoadExamSetting("#AcademicYearDrop", "#ExamSettingDrop");
    });

    function LoadExamSetting(academicYearSelector, examSettingSelector) {
    var acYear = $(academicYearSelector + " option:selected").text();

    if (acYear && acYear !== "--- Select ---") {
        $.ajax({
            url: "@Url.Action("GetExamSettingByACYear", "Examination")",
            method: "POST",
            dataType: "json",
            data: { sAcyear: acYear },
            success: function (data) {
                $(examSettingSelector)
                    .empty()
                    .append('<option>--- Select ---</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function () {
                alert('Internal Server Error!');
            }
        });
    }
}


    var formData = new FormData();
    function FetchDetailsByID(sFeeDueId) {
        //$('#pBody').parsley().destroy();

        if (sFeeDueId != null) {
            $.ajax({

                url: '@Url.Action("FetchExamInvigilationById", "Examination")',
                type: "POST",
                datatype: 'json',
                data: { sDueID: sFeeDueId },
                success: function (data) {
                    if (data.Message != null) {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                    else {
                        if (data.oResult[0] != null) {
                            $('#EdHallName').attr('value', data.oResult[0].HALL_NAME);
                            $('#EdExamDate').attr('value', data.oResult[0].EXAM_DATE);
                            $('#EdStaffList option[value="' + data.oResult[0].EXAM_INVIGILATOR_ID + '"]').attr("selected", "selected");
                            $('#EdExamSession option[value="' + data.oResult[0].SESSION + '"]').attr("selected", "selected");
                            $('#EdExamSetting option[value="' + data.oResult[0].EXAM_SETTING_ID + '"]').attr("selected", "selected");
                            //$('#EdAcademicYear option[text="' + data.oResult[0].ACADEMIC_YEAR + '"]').attr("selected", "selected");
                            $('#txtEXAM_INVIGILATION_ID').attr('value', data.oResult[0].EXAM_INVIGILATION_ID);
                            $('#EdAcademicYear').val(data.oResult[0].ACADEMIC_YEAR);


                            $('.selectpicker').selectpicker('refresh');
                        }
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
    
    $('#EdAcademicYear, #EdExamSetting, #EdStaffList, #EdExamSession').on('change', function () {
        $(this).parsley().validate();
    });


    function SaveOrUpdateData() {
        var isValid = true;

        if ($('#IQACProject').parsley().validate() !== true) isValid = false;
        if (!isValid) {

            swal({ title: "Warning", text: "Something went wrong ! Please check your inputs !", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
            return false;
        }
        var formData = new FormData();
    //summernote
        var ExamDate = $('#EdExamDate').val();
        var academicYear = $('#EdAcademicYear').val();
        var HallName = $('#EdHallName').val();
        var StaffList = $('#EdStaffList').val();
        var ExamSession = $('#EdExamSession').val();
        var invigilationId = $('#txtEXAM_INVIGILATION_ID').val();
        var ExamSetting = $('#EdExamSetting').val();

        var sJsonData = '{"EXAM_INVIGILATION_ID":"' + invigilationId + '",\
                "EXAM_SETTING_ID": "' + ExamSetting + '", \
                "ACADEMIC_YEAR": "' + academicYear + '", \
                "SESSION": "' + ExamSession + '", \
                "EXAM_INVIGILATOR_ID": "' + StaffList + '", \
                "EXAM_DATE": "' + ExamDate + '", \
                "HALL_NAME": "' + HallName + '", \
    } ';
         formData.append('jsonData', sJsonData);
        $.ajax({
            url: '@Url.Action("SaveOrUpdateExamInvigilationList", "Examination")',
            method: 'POST',
            contentType: false,
            processData: false,
            data: formData,
            async: false,
            success: function (data) {
                debugger;
                if (data.Message != null && data.Message != "") {
                    if (data.ErrorCode == "200") {
                        $('#btnCancel').click();
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                        loadGird();
                    }
                    else if (data.ErrorCode == "417") {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                    else if (data.ErrorCode == "503") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }
                    else if (data.ErrorCode == "406") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                    }
                    else {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });

                    }
                }
                else {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                }
            },
            error: function (error) {
                alert('Internal Server Error !');
                return false;
            }
        });
};
    $('.selectpicker').selectpicker({
        size: 4
    });


</script>

<script>
    function numberOnly(id) {
        var element = document.getElementById(id);
        element.value = element.value.replace(/[^0-9]/gi, "");
    }

        var table;
        function ContentLoad()
        {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });
            table = $("#StudentList").DataTable({ "bPaginate": true });//{ "bPaginate": false }
            $("#StudentList_filter").addClass("dataTables_filter pull-right");
            $(".pagination").addClass("pagination pull-right");
        }

     function loadGird() {
         loadContent("/Examination/ExamInvigilationExamUpload")
             }


         DeletedList=function (fID) {
                 swal({
                     title: "Are you sure want to Delete?",
                     text: "",
                     type: "warning",
                     showCancelButton: true,
                     confirmButtonClass: "btn-danger",
                     confirmButtonText: "Yes, I agree!",
                     closeOnConfirm: false
                 },
                     function () {
                         $('.cancel ').click();
                         $.ajax({
                             url: "/Examination/DeleteExamInvigilationList",
                             type: "post",
                             data: { fID: fID },
                             success: function (data) {
                                 if (data.ErrorCode == "200") {
                                     swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });
                                     loadGird();
                                 }
                                 else {
                                     swal({ title: "Fail !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                                 }
                             },
                             error: function (ex) {
                                 swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                             }


                         });
                     });

             }


                       function ClickFile()
                        {
                            $('#ExcelUpload').click();
                        }

    function SaveExcelUpload()
    {
        var academicYear = $('#AcademicYearExcel option:selected').text();
        var ExamSetting = $('#ExamSettingExcel').val();
        if (academicYear != null && ExamSetting != null) {
            swal({
                title: "Confirmation",
                text: "Are you sure you want to update the Exam Invigilator details?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
                function () {
                    var sFlag = false;
                    var formData = new FormData();
                    var sFile = $('#HeadExcelUpload').get(0).files;
                    if (sFile.length != 0) {
                        for (var i = 0; i < sFile.length; i++) {
                            formData.append(sFile[i].name, sFile[i]);
                            sFlag = true;
                        }
                    }
                    else {
                        swal({ title: "", text: "No File Found", showConfirmButton: false, timer: 1500, type: 'error', animation: true });

                    }
                    $('.cancel ').click();
                    formData.append("AcademicYear", $('#AcademicYearExcel option:selected').text());
                    formData.append("ExamSetting", $('#ExamSettingExcel').val());


                    $.ajax({
                        url: '@Url.Action("SaveExamInvigilationfromExcelUpload", "Examination")',
                        method: 'POST',
                        datatype: 'json',
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 3000, type: 'info', animation: true });
                            loadGird();
                        }, error: function (error) {
                            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    });

                });
        }
        else
        {
            swal({ title: "Info", text: "Please Select All Fields", showConfirmButton: false, timer: 2000, type: 'info', animation: true });
        }
    }
    $('#ExamSettingDrop').on('change', function () {

        $.ajax({
            url: '@Url.Action("BindAcYearAndSettingwiseList", "Examination")',
            type: "POST",
            datatype: 'json',
            data: { sAcYear: $("#AcademicYearDrop option:selected").text(), sSettingId: $("#ExamSettingDrop").val() },
            success: function (data) {
                $("#bindAcYearWiseBusFeeList").empty();
                $("#bindAcYearWiseBusFeeList").append(data);
                $("#StudentList").DataTable({
                    dom: "lBfrtip", buttons: [{
                        extend: "copy", className: "btn-sm"
                    }
                        , {
                        extend: "excel", className: "btn-sm"
                    }
                        , {
                        extend: "pdf", className: "btn-sm"
                    }
                    ], responsive: !0, "paging": true, "ordering": true
                });

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    });
    function Add() {

        var ExamSetting = $('#EdExamSetting').val();
        $('#EdExamDate').attr('value', '');
        $('#EdHallName').attr('value', '');
        $('#txtEXAM_INVIGILATION_ID').attr('value', '');
        $('#EdAcademicYear option[value=""]').attr("selected", "selected");
        $('#EdExamSession option[value=""]').attr("selected", "selected");
        $('#EdExamSetting option[value=""]').attr("selected", "selected");
        $('.selectpicker').selectpicker('refresh');
    }
</script>
