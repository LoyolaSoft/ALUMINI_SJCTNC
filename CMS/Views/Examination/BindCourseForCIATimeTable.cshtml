@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
    int nCount = 0;
}
<div class="col-md-12 table-responsive">
    <table class="table table-bordered" id="tblExamTimeTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Faculty</th>
                <th>UGC Type</th>
                <th>Course Code</th>
                <th>Course Tittle</th>
                <th>Exam Session</th>
                <th>Exam Date</th>
            </tr>
        </thead>
        <tbody>
            @{ 
                if (Model.liCoursePattern!=null && Model.liCoursePattern.Count>0)
                {
                    foreach (var item in Model.liCoursePattern)
                    {
                        <tr cms-TimeTableId="@item.TIMETABLE_ID" cms-CourseId="@item.COURSE_ID" cms-CourseCode="@item.COURSE_CODE"> 
                            <td>@{ nCount++;} @nCount</td>
                            <td>@item.FACULTY</td>
                            <td>@item.UGC_COURSE_TYPE</td>
                            <td>@item.COURSE_CODE</td>
                            <td>@item.COURSE_TITLE</td>
                            <td>
                                @Html.DropDownListFor(model => model.ExamSession, (Model.liExamSession != null) ? new SelectList(Model.liExamSession, "SESSION_ID", "SESSION_NAME", item.EXAM_SESSION_ID) : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @*<div class="input-group">
                                    
                                    Html.DropDownListFor(model => model.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>*@
                            </td>
                            <td>
                                <div class="input-group date">
                                    <input type="text" class="form-control datepicker"  placeholder="Select Date" value="@item.EXAM_DATE" />
                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
<script>
    $(".datepicker").datepicker({
        todayHighlight: true,
        autoclose: true,
        startDate: new Date(),
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    })
</script>