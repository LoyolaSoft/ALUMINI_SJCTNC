@model CMS.ViewModel.ViewModel.ExaminationViewModel

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Evaluation Student Entry</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Evaluation Student Entry</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Evaluation Student Entry</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">                       
                        <div class="col-md-12 form-group">
                            <div class="col-md-4 form-group">
                                @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <div class="col-md-4 form-group">
                                @Html.Label("TT Course", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Date", htmlAttributes: new { @class = "control-label col-md-4" })                               
                                    <div class="col-md-8">
                                        <input type="text" id="ddEvaluationDate" placeholder="Select the date"  class="form-control input-sm" />                                      
                                    </div>                          
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Ev Type", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.EvaluationType, (Model.EvaluationType != null) ? Model.EvaluationType : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-2 form-group pull-right">
                                <a class="btn btn-primary" href="javascript:;" onclick="loadShuffleStudents()"> Get </a>
                            </div>
                        </div>
                        <div class="col-md-12" id="BindEvaluationStudentEntry"></div>
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script>
    function ContentLoad() {
        handleDatepicker = function () {
            "use strict";
            $("#ddEvaluationDate").datepicker({
                todayHighlight: !0,
                autoclose: !0,
                format: "dd/mm/yyyy",
                orientation: "right bottom",
            })
        }
        handleDatepicker();
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    $('#AcademicYearList').on('change', function () {
        $('#ExamSetting').empty();
        $.ajax({
            url: '/Examination/FetchOnlineExamSettingByAcYear',
            method: 'POST',
            datatype: 'json',
            data: { sAcYear: $('#AcademicYearList Option:selected').text() },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#ExamSetting').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $('#ExamSetting').on('change', function () {
        $('#CourseList').empty();
        $('#StaffList').empty();
        $.ajax({
            url: '/Examination/FetchCourseByExamSettingId',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $("#ExamSetting option:selected").attr("exam_settingid"), sExamtype: $("#ExamSetting option:selected").attr("exam_type") },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#CourseList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
        $.ajax({
            url: '/Examination/FetchExamEvaluatorByExamSetting',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $('#ExamSetting').val() },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#StaffList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    function loadShuffleStudents() {
        $('#BindEvaluationStudentEntry').empty();
        $.ajax({
            url: '/Examination/BindExamEvaluationEntry',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $('#ExamSetting').val(), sTimetableId: $('#CourseList').val(), sAcademicYear: $('#AcademicYearList Option:selected').text(), sExamEvaluationType: $('#EvaluationType').val(), sExamtype: $("#ExamSetting option:selected").attr("exam_type") },
            success: function (data) {
                $('#BindEvaluationStudentEntry').append(data);
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>