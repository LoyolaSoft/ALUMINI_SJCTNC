@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null; int count = 0;
}

<div class="col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblExtraExamInvigilators">
        <thead>
            <tr>
                <th>#</th>
                <th>ExamDate</th>
                <th>ExamSession</th>
                <th>Room No</th>
                <th>Staff</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liExamSeatingInvigilator != null && Model.liExamSeatingInvigilator.Count > 0)
            {
                foreach (var item in Model.liExamSeatingInvigilator)
                {
                    <tr>
                        <td>@{count++;} @count</td>
                        <td>@item.EXAM_DATE</td>
                        <td>@item.EXAM_SESSION</td>
                        <td>@item.ROOM_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>
                            <a href="#ExamTTGrouping" onclick="FetchItemDetails(@item.SEATING_INVIGILATOR_ID)" data-toggle="modal" data-dismiss="modal" title="Edit" class="text-primary"><i class="fa fa-edit"></i></a>
                            <a href="javascript:;" onclick="GetConfirm(@item.SEATING_INVIGILATOR_ID);" data-dismiss="modal" ><i class="fa fa-trash text-danger" title="Delete"></i></a>
                        </td>
                    </tr>
                                }

                            }
        </tbody>
    </table>
</div>

