@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "BindExamRegistrationDetailsByRevaluationSettingId";
}


<div class="row">
    <!-- begin col-12 -->
    <div class="col-lg-12">
        <!-- begin nav-tabs -->
        <ul class="nav nav-tabs">
            <li class="nav-items">
                <a href="#StudentWise" data-toggle="tab" class="nav-link">
                    <span class="d-sm-none">Student Wise</span>
                    @*<span class="d-sm-block d-none">Report</span>*@
                </a>
            </li>
            <li class="nav-items">
                <a href="#CourseWise" data-toggle="tab" class="nav-link">
                    <span class="d-sm-none">Course Wise</span>
                    @*<span class="d-sm-block d-none">Report</span>*@
                </a>
            </li>
            <li class="nav-items">
                <a href="#BindRevaluation" data-toggle="tab" class="nav-link active show">
                    <span class="d-sm-none">Total Registration</span>
                    @*<span class="d-sm-block d-none">Report</span>*@
                </a>
            </li>
        </ul>
        <!-- end nav-tabs -->
        <!-- begin tab-content -->
        <div class="tab-content">
            <!-- begin tab-pane -->
            <div class="tab-pane fade " id="StudentWise">          
                        <div class="col-lg-12 table-responsive" id="tblStuWiseRegistrationDetails">
                            <table class="table table-hover table-bordered"  border="1" id="tbl1">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Register No</th>
                                        <th>First Name</th>
                                        <th>Programme</th>
                                        <th>Course Title</th>
                                        <th>Course Code</th>
                                        @*<th>Question Type</th>*@
                                        <th>Exam Setting</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.liExamRevaluationRegistrationFieldsByStuWise != null && Model.liExamRevaluationRegistrationFieldsByStuWise.Count > 0)
            {
                //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                var count = 0;
                foreach (var item in Model.liExamRevaluationRegistrationFieldsByStuWise)
                {
                    count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.REGISTER_NO</td>
                                    <td>@item.FIRST_NAME</td>
                                    <td>@item.PROGRAMME_NAME</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.COURSE_CODE</td>

                                    <td>@item.EXAM_SETTING</td>
                                </tr>
                                    }

                                }
                                else
                                {
                                @*<tr><td> No Records Found..! </td></tr>*@
                                }

                                </tbody>
                            </table>
                        </div>

                <div class="form-group col-lg-12 row">
                    <div class="form-group pull-right">
                        <div class="col-md-5">
                            <a name="excel" id="excel" class="btn btn-success" onclick="ExportAsExcel('BindDiv')">Excel</a><br>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end tab-pane -->
            <!-- begin tab-pane -->

          

            <div class="tab-pane fade" id="CourseWise">
               
                   
                        <div class="col-lg-12 table-responsive" id="tblCourseWiseRegistrationDetails">
                            <table class="table table-hover table-bordered"  border="1" id="tbl2">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Register No</th>
                                        <th>First Name</th>
                                        <th>Programme</th>
                                        <th>Course Title</th>
                                        <th>Course Code</th>
                                        @*<th>Question Type</th>*@
                                        <th>Exam Setting</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.liExamRevaluationRegistrationFieldsByCourseWise != null && Model.liExamRevaluationRegistrationFieldsByCourseWise.Count > 0)
            {
                //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                var count = 0;
                foreach (var item in Model.liExamRevaluationRegistrationFieldsByCourseWise)
                {
                    count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.REGISTER_NO</td>
                                    <td>@item.FIRST_NAME</td>
                                    <td>@item.PROGRAMME_NAME</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.COURSE_CODE</td>

                                    <td>@item.EXAM_SETTING</td>
                                </tr>
                                    }

                                }
                                else
                                {
                                @*<tr><td> No Records Found..! </td> </tr>*@
                                }

                                </tbody>
                            </table>
                         </div>
                    <div class="form-group col-lg-12 row">
                        <div class="form-group pull-right">
                            <div class="col-md-5">
                                <a name="excel" id="excel" class="btn btn-success" onclick="ExportAsExcel('BindDiv')">Excel</a><br>
                            </div>
                        </div>
                    </div>
            
            </div>
            <!-- end tab-pane -->
           
                <!-- begin tab-pane -->
                <div class="tab-pane fade" id="BindRevaluation">

                  
                        <div class="col-lg-12 table-responsive" id="tblLiERSetting">
                            <table class="table table-hover table-bordered" border="1" id="tbl3">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Exam Setting</th>
                                        <th>Application Type</th>
                                        <th>Registerd Date</th>
                                        @*<th>Question Type</th>*@
                                        <th>First Name</th>
                                        <th>Roll No</th>
                                        <th>Programme Name</th>
                                        <th>Class Name</th>
                                        <th>Papers</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.liExamRevaluationRegistrationFields != null && Model.liExamRevaluationRegistrationFields.Count > 0)
            {
                //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                var count = 0;
                foreach (var item in Model.liExamRevaluationRegistrationFields)
                {
                    count = count + 1;
                                            <tr>
                                                <td>@count</td>

                                                <td>@item.EXAM_SETTING</td>
                                                <td>@item.APPLICATION_TYPE</td>
                                                <td>@item.REGISTERED_DATE</td>
                                                <td>@item.FIRST_NAME</td>
                                                <td>@item.ROLL_NO</td>
                                                <td>@item.PROGRAMME_NAME</td>
                                                <td>@item.CLASS_NAME</td>
                                                <td><a href='#modal-success' data-toggle='modal' onclick='ViewPapers(@item.EXAM_REVALUATION_REGISTER_ID)' title='View' style='text-decoration:none'><i class='glyphicon glyphicon-eye-open'></i></a></td>

                                                @if (item.DEBIT != "0" && item.DEBIT != "")
                                                {
                                                    @*<td><i class="fa fa-inr f-s-14"> @item.BALANCE</i></td>*@
                                                    // <td><a href="/FEE/RazorPayPaymentGate?sFrequencyTypeId=@item.FREQUENCY_TYPE_ID&sFeeRootId=@item.FEE_ROOT_ID" class="btn btn-success " title="Go for Payment"><i class="ion-card"></i> Proceed to Pay</a></td>


                                                    <td><label class="label label-success f-s-12">Paid</label></td>
                                                }
                                                else
                                                {
                                                    // <td><label class="fa fa-inr f-s-14"> @item.DEBIT</label></td>

                                                    <td><label class="label label-danger f-s-12">Not Paid</label></td>

                                                }


                                            </tr>
                                        }

                                    }
                                    else
                                    {
                                        @*<tr><td> No Records Found..! </td> </tr>*@
                                    }

                                </tbody>
                            </table>
                        </div>
                   
                   

                    <div class="form-group col-lg-12 row">
                        <div class="form-group pull-right">
                            <div class="col-md-5">
                                <a name="excel" id="excel" class="btn btn-success" onclick="ExportAsExcel('BindDiv')">Excel</a><br>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- end tab-pane -->
            
          
        </div>
        <!-- end tab-content -->

    </div>
</div>

 
<div class="modal modal-success fade" id="modal-success">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title"><label id="lblModal" class="form-group">Registered  Courses</label></h4>
            </div>
            <div class="modal-body" id="mBody">

            </div>
            <div class="modal-footer">


            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>



<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        //var tbl = $('#tblLiERSetting').DataTable();
        $('.selectpicker').selectpicker('refresh');
        handleDatepicker = function () {
            "use strict";


            $("#txtStartDate").datepicker({
                todayHighlight: true,
                autoclose: true,
              //  endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#txtEndDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();
        var Count = 0;
        var Status = 0;

        $('#tbl1').DataTable({
            "paging": false
        });


        $('#tbl2').DataTable({
            "paging": false
        });
        $('#tbl3').DataTable({
            "paging": false
        });

   
  
        function ViewPapers(RevaluationRegisterId)
        {
            if (RevaluationRegisterId != null)
            {

                $.ajax({
                    url: "/Examination/FetchRevaluationRegisterCoursePapersByRevaluationRegistrationId",
                    type: "post",
                    data: { sRevaluationRegisterid: RevaluationRegisterId },
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {

                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }
                        else {

                            var Dom = $('#mBody');
                            Dom.html('');
                            var Count = 0;
                            var StartDiv = "<table class='table table-hover table-bordered' id='tblCourse'><thead><tr><td>#</td>" +
                                   "<td>Course</td><td>Course Code</td></tr></thead>";
                            
                            $.each(data.oResult, function (id, info) {
                               
                                Count=Count+1;
                                StartDiv += "<tr>";
                                StartDiv += "<td><p>" + Count + "</p></td>";
                                StartDiv += "<td><p>" + info.COURSE_TITLE + "</p></td>";
                                StartDiv += "<td><p>" + info.COURSE_CODE + "</p></td>";
                                StartDiv += "</tr>";
                            });

                            Dom.append(StartDiv);
                        }

                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }
                });
            }
        }





        function ExportAsExcel(div) {
           // var d = $('#' + div + '').find('#' + findiv + '');
           // alert(div);
            let file = new Blob([$('#' + div + '').html()], { type: "application/vnd.ms-excel" });
          //  let file = new Blob([d.html()], { type: "application/vnd.ms-excel" });
            let url = URL.createObjectURL(file);
            let a = $("<a />", {
                href: url,
                download: "Revaluation" + ".xls"
            }).appendTo("body").get(0).click();
            e.preventDefault();
        }

</script>