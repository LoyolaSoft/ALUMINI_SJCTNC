@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
    
}


<div class="col-md-12 table-responsive">
    <div class="col-md-12 pull-right">
        <a  class="btn btn-success col-md-2 pull-right" target="_blank"  id="btnQuestion">View Question</a>
    </div>
    <br /><br />
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Code</th>
                <th>Download</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liArrearStudentRegistration!=null && Model.liArrearStudentRegistration.Count>0)
            {
                int nCount = 0; string sUrl = "http://exam.sjctnc.in/";
                foreach (var item in Model.liArrearStudentRegistration)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.COURSE_CODE</td>
                        <td>
                            @{sUrl = sUrl + item.ROLL_NO + "/" + item.COURSE_CODE + ".pdf";}
                            <a href="@sUrl" target="_blank">Click Here</a>
                        </td>
                    </tr>
                    sUrl = string.Empty;
                }
            }
        </tbody>
    </table>

</div>