@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "AddOnlineExamQuestions";
    Layout = null;
}

<style>
    .note-editing-area {
        max-height: 65px;
    }
</style>


<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li><a @*href="@Url.Action("ListQuiz","Examination")"*@ href="javascript:;" onclick="loadContent('/Examination/ListonlineExamQuestion')">List Quiz</a></li>
        <li class="active">Add Online Exam Questions</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Add Online Exam Questions </h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Add Online Exam Questions</h4>
                </div>
                <div class="panel-body">
                    <div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#Equvationmodal" data-toggle="modal"><i class="fa fa-plus"> Equation </i></a>
                    </div>

                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-2 form-group">
                                @Html.Label("Year", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-2 form-group">
                                @Html.Label("Semster", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-2 form-group">
                                @Html.Label("Options", htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-6">
                                    @*@Html.Editor("txtOption", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Options You Need" } })*@
                                    <input type="number" id="txtOption" max="10" class="form-control input-sm" min="0" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <input type="hidden" id="partwisestaffid">
                            <div class="col-md-2 form-group">
                                @Html.Label("Part", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Part, (Model.Part != null) ? Model.Part : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Unit", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Unit, (Model.Unit != null) ? Model.Unit : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group hidden" id="alloteddiv">
                                @Html.Label("Alloted Question:", htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-6">
                                    <label class="label label-info" id="allotedquestion"></label>
                                </div>
                            </div>
                            <div class="col-md-3 form-group hidden" id="questionentereddiv">
                                @Html.Label("Question Entered:", htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-6">
                                    <label class="label label-info" id="enteredquestion"></label>
                                </div>
                            </div>

                        </div>
                        <br />
                        <div id="dvtextboxes">
                            <!--Begin Question-->
                            <div class="row hidden" id="Question">

                                <div class="col-md-8 form-group">
                                    <label class="col-md-2 control-label">Question</label>
                                    @*<form action="" method="POST" name="summernote_form" class="table-bordered">

                                        <textarea class="summernote table-bordered" name="content" cols="20" rows ="5" max_length = "612"></textarea>
                                        </form>*@
                                    <div class="col-md-10">
                                        <input type="text" id="TxtTitle" class="summernote form-control" placeholder="Enter Your Question" @*maxlength="200"*@ @*style="width:115%"*@>
                                    </div>
                                </div>

                                @*<div class="col-md-4 form-group" id="Mark">
                                        <label class="col-md-3 control-label">Mark</label>
                                        <div class="col-md-6">
                                            <input type="number" id="txtMark" class="form-control" placeholder="Enter Your Mark" min="0">
                                        </div>
                                    </div>*@

                            </div>
                            <!--End Question-->
                            <!--Begin match The Following-->
                            @*<div class="row hidden" id="dvMathTheFollowing">
                                <div class="col-md-6 form-group">
                                    <div id="dvOptions1"></div>
                                </div>
                                <div class="col-md-6 form-group">
                                    <div id="dvOptions2"></div>
                                </div>
                            </div>*@
                            <!-- End Match The Following-->
                            <!--Other Type-->
                            <div class="row hidden" id="dvOtherType">
                                <div id="dvOptions3"></div>
                            </div>

                            <div class="row">
                                <div class="" id="answerdiv">
                                <div class="col-md-4 form-group hidden" id="Answer">
                                    <label class="col-md-3 control-label">Answer</label>
                                    <div class="col-md-9">
                                       @*<input type="text" id="txtAnswer" class="form-control" placeholder="Enter Your Correct Option "  >*@
                                        <div id="txtAnswer" class="summernote form-control" placeholder="Enter Your Title"></div>
                                    </div>
                                </div>
                                </div>
                                <div class="col-md-2 form-group">
                                    <a class="btn btn-primary pull-right hidden" id="btnSubmit">Submit</a>
                                </div>
                            </div>

                        </div>


                    </div>


                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>


<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>

    function ContentLoad() {
        handleSummernote();
        // Document Ready Function .
    }
    handleSummernote = function () {
        $(".summernote").summernote({
            placeholder: "Add Your Option"
        })
    }
    $('.note-editable').css("width", "882");

    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');

    $('#AcademicYearList').on('change', function () {
        $.ajax({
            url: "@Url.Action("FetchExamSettingByAcYear", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sAcYear: $('#AcademicYearList option:selected').html() },
            success: function (data) {
                $("#ExamSetting").empty();
                $("#ExamSetting").append(data.sResult);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    });
    $("#Semester").on("change", function () {
        var acyear = $("#AcademicYearList option:selected").html();
        var sem = $("#Semester").val();

        if ($("#AcademicYearList").val() && $("#Semester").val()) {
            $.ajax({
                url: "@Url.Action("FethCourseByAcademicyearandSemester", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sAcyear: acyear, sSemster: sem },
                success: function (data) {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Select the Fields ...!')
        }
    });

    $("#txtOption").on("change", function ()
    {
        $('#dvtextboxes').removeClass('hidden');
        $("#btnSubmit").removeClass('hidden');
        var value = $("#txtOption").val();
        var Option = '';
        var Option2 = '';
        var Option3 = '';
        if (value > 10) {
            alert('Invalid Option .! Maximum Option is 10 .');
            value = 10;
            $("#txtOption").val('10');
        }
        $("#dvOptions1").empty();
        $("#dvOptions2").empty();
        $("#dvOptions3").empty();
        //$('#dvMathTheFollowing').addClass('hidden');
        $('#dvOtherType').removeClass('hidden');
        for (var i = 0; i < value; i++) {
            var j = i;
            j++;
            Option += '<div class="col-md-12 form-group">';
            Option += '<label class = "control-label col-md-1">' + j + ' .)</label>';
            Option += '<div class="col-md-10">';
            Option += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
            Option += '</div>';
            Option += '</div>';
        }
        $("#dvOptions3").append(Option);
        $('#Answer').removeClass('hidden');
        $("#Question").removeClass('hidden');
        handleSummernote();

        $("#Question").removeClass('hidden');
        handleSummernote();
        DeleteSummerNoteHeader();
    });

    $("#btnSubmit").on("click", function ()
    {

        if (!$("#AcademicYearList").val() && !$('#Semester').val() && !$('#ExamSetting').val() && !$("#CourseList").val() && !$("#Unit").val() && !$("#Part").val())
        {
            alert('Please Select All To Continue ! ');
            return false;
        }
        var acyear = $("#AcademicYearList option:selected").html();
        var Endvalue = $("#txtOption").val();
        var SummerNote = $("#TxtTitle").summernote('code');
        var str = btoa(unescape(encodeURIComponent(SummerNote)));
        var Question = str;
        var CourseId = $("#CourseList").val();
        var Partwisestaffid = $('#partwisestaffid').val();
        var ArrayOption = '';
        var nCount = 0;
        ArrayOption = '{"liMF_Option":[';
        for (var i = 0; i < Endvalue; i++) {

            // Objective Type Questions ...
            if ($("#Options" + i).summernote('code')) {
                var SummerNote2 = $("#Options" + i).summernote('code');
                var str2 = btoa(unescape(encodeURIComponent(SummerNote2)));

                ArrayOption += '{"OPTION":"' + str2 + '"},';
                nCount++;
            } else {
                alert('All the Options Must to Fill ..!');
                return false;
                break;
            }


        }
        if (nCount != 0) {
            ArrayOption = ArrayOption.slice(0, -1);
            ArrayOption += ']}';
        } else {
            alert('Something is went wrong . please check your Input !');
            return false;
        }
            var Answer = "";
            //var str1 = GetOptionCodeForAnswer($("#txtAnswer").val());
            var str1 = $("#txtAnswer").summernote('code');
            var str1 = btoa(unescape(encodeURIComponent(str1)));
            if (str1 != null && str1 != "" )
            {
                Answer = str1;
            }
            else {
                alert('Your Answer Not Valuable ! Please Check You Input !');
                return false;
            }
        
        var JsonData;
        JsonData = '{"QUESTION":"' + Question + '","COURSE_ID":"' + CourseId + '","PARTWISE_STAFF_ID":"' + Partwisestaffid + '","ANSWER_ID":"' + Answer + '","ACADEMIC_YEAR":"' + acyear + '"}';
       

        if (parseInt($('#allotedquestion').text()) > parseInt($('#enteredquestion').text()))
        {
            $.ajax({
                url: "@Url.Action("SaveOnlineExamObjectiveQuestions", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sQuestion: JsonData, sOPtions: ArrayOption },
                success: function (data)
                {
                    alert(data.Message);
                    if (data.ErrorCode != null && data.ErrorCode && data.ErrorCode == "200")
                    {
                        //$('#dvtextboxes').addClass('hidden');
                        //$('#txtOption').val('');
                        $("#TxtTitle").val('');
                        $('#txtAnswer').val('');
                        $('#enteredquestion').html(parseInt($('#enteredquestion').text()) + 1);

                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
        else
        {
            alert('Please Check Alloted Questions ...!');
        }

    });
</script>

<script>

    function DeleteSummerNoteHeader() {

        $('#dvOptions3').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions1').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions2').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });

        $('#answerdiv').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });

        //$('#Answer').find(".note-toolbar").remove();
        //$('#Answer').find(".note-statusbar").remove();
        //$('#Answer').find(".note-editing-area").css("border", "1px solid");
        //$('#Answer').find(".note-editable").html("");
        //$('#Answer').find(".note-editable").css("height", "50px");

    }

    function GetOptionCodeForAnswer(answer) {

        var AnswerCode;

        if (answer != null && answer != "") {

            AnswerCode = $("#Options" + (parseInt(answer) - 1)).summernote('code');
            AnswerCode = btoa(unescape(encodeURIComponent(AnswerCode)));
        }


        return AnswerCode;
    }
</script>

<div class="modal" id="Equvationmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Math Equations</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    @{
                        Html.RenderPartial("Equation");
                    }
                </div>
                <label id="l"></label>
            </div>
            <div class="modal-footer">

                @*<a href="javascript:;" id="btnCopy" class="btn btn-sm btn-primary" onclick="">Copy</a>*@
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script>
    //Cross-browser function to select content
    function SelectText(element) {
        var doc = document;
        if (doc.body.createTextRange) {
            var range = document.body.createTextRange();
            range.moveToElementText(element);
            range.select();
        } else if (window.getSelection) {
            var selection = window.getSelection();
            var range = document.createRange();
            range.selectNodeContents(element);
            selection.removeAllRanges();
            selection.addRange(range);
        }
    }
    function copyImg(id) {
        alert('#' + id + '');
        //Make the container Div contenteditable
        $('#' + id + '').attr("contenteditable", true);
        //Select the image
        alert($('#' + id + '').get(0));
        SelectText($('#' + id + '').get(0));
        //Execute copy Command
        //Note: This will ONLY work directly inside a click listenner
        document.execCommand('copy');
        //Unselect the content
        window.getSelection().removeAllRanges();
        //Make the container Div uneditable again
        $(this).removeAttr("contenteditable");
        //Success!!
        alert("image copied!");

    }

</script>
<script>
    $("#CourseList").on("change", function ()
    {

        if (!$("#AcademicYearList").val() && !$('#ExamSetting').val() && !$("#CourseList").val())
        {         
            return false;
        }
        var acyear = $("#AcademicYearList option:selected").html();
            $.ajax({
                url: "@Url.Action("FetchPartandUnitByStaff", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sAcyear: acyear, sExamSettingId: $('#ExamSetting').val(), sCourseId: $('#CourseList').val() },
            success: function (data)
            {
                $("#Part").empty();
                $("#Part").append('<option value=""> -- Select -- </option>' + data.PART_ID);

                $("#Unit").empty();
                $("#Unit").append('<option value=""> -- Select -- </option>' + data.UNIT_ID);
                $('.selectpicker').selectpicker('refresh');

            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    
    
    });

    $('#Unit').on('change', function ()
    {
        if ($('#Unit').val() && $('#Part').val())
        {
            var acyear = $("#AcademicYearList option:selected").html();
            $.ajax({
                url: "@Url.Action("FetchQuestionsByPartandUnit", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sPartId: $('#Unit').val(), sUnitId: $('#Part').val(), sExamSettingId: $('#ExamSetting').val(), sCourseId: $('#CourseList').val(), sAcyear: acyear },
                success: function (data)
                {
                    if(data.TOTAL_QUESTIONS!='')
                    {
                        $('#alloteddiv').removeClass('hidden');
                        $('#questionentereddiv').removeClass('hidden');
                        $('#allotedquestion').html(data.TOTAL_QUESTIONS);
                        $('#enteredquestion').html(data.COUNT);
                        $('#partwisestaffid').val(data.PARTWISE_STAFF_ID);


                    }
                    else
                    {
                        $('#alloteddiv').addClass('hidden');
                        $('#questionentereddiv').addClass('hidden');
                        alert('Please define Staff ...!');
                    }

                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    });
</script>
