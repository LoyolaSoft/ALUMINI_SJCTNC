@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "ExaminationSeatingAttendance";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ExamSeating Attendance</li>
    </ol>
    <h1 class="page-header">Exam Seating Attendance</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Exam Seating Attendance</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamType, "Exam Type", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSetting, "Exam", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSession, "Session", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", data_size = "4" })
                                @Html.ValidationMessageFor(model => model.ExamSession, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-1">
                            <a href="#" class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-12">
                    <div class="col-md-12 table-responsive" id="dvSeatingsStudentBind"></div>
                    <a href="#" class="btn btn-primary pull-right hidden" id="btnSubmit">Submit</a>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 4
    });

    $('#ExamType').on("change", function () {
        var vAcademicYear = @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR].ToString();
        var vExamTyper = $('#ExamType').val();
        if (vExamTyper!='null')
        {
            $.ajax({
                url: '@Url.Action("FetchExamSessionByExamType", "Examination")',
                data: { sExamType: vExamTyper },
                success: function (objResult) {
                    $('#ExamSession').empty();
                    $('#ExamSession').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
        if (vExamTyper == "1") {
            $.ajax({
                url: '@Url.Action("FetchCIAExamSetting", "Examination")',
                data: { sAcademicYear: vAcademicYear },
                success: function (objResult) {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
        if (vExamTyper == "2") {
            $.ajax({
                url: '@Url.Action("FetchExamSetting", "Examination")',
                data: { sAcademicYear: vAcademicYear},
                success: function (objResult) {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    });


    function LoadGrid() {
        vExamType=$('#ExamType').val();
        vExamSetting=$('#ExamSetting').val();
        vExamSession=$('#ExamSession').val();
        if (vExamType !='' && (vExamSetting !='' && vExamSetting !='0') && (vExamSession !='' && vExamSession !='0'))
        {
            $.ajax({
                url: '@Url.Action("BindExaminationSeatingAttendance", "Examination")',
                data: { sExamtype: vExamType, sExamSetting: vExamSetting, sExamSession: vExamSession },
                success: function (option) {
                    var BindStudent = $('#dvSeatingsStudentBind');
                    BindStudent.empty();
                    if (option.Message != null && option.Message != '') {
                        swal({ title: "Error..!!", text: option.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else {
                        $('#btnSubmit').removeClass('hidden');
                        BindStudent.append(option);
                    }
                },
                error: function (xhr, textStatus, error) {
                    swal({ title: "Error..!!", text:"Internal Server Error..!!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            })
        }else{
            swal({ title: "Warning..!!", text: "Choose the mandatroy fields..!!", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
    };
    $('#btnGet').on('click',function () {
        LoadGrid();
    });



    $('#btnSubmit').on('click', function () {        
        $('#tblExamAttendance tbody tr').each(function () {
            $(this).find('td').each(function () {
                var chkBox = $(this).find('input[type="checkbox"]');
                if (chkBox.is(':checked')) {
                    StudentId = '"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '"';
                }
            });
        });
        if (StudentId == null) {
            swal({ title: "Error..!!", text: "Please select the Students.!!", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        swal({
            title: "Are you sure to Submit the Absentees. ?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-success",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },function () {
            var jsonObject;
            if (jsonObject == null) {
                jsonObject = '{"JSON_EXAM_SEATING_ATTENDANCE":[';
                $('#tblExamAttendance tbody tr').each(function () {                 
                    $(this).find('td').each(function () {
                        var chkBox = $(this).find('input[type="checkbox"]');
                        if (chkBox.is(':checked')) {
                            jsonObject += '{"EXAM_ATTENDANCE_ID":"' + $(this).find('input[type="checkbox"]').attr("cms-examAttid") + '","STUDENT_ID":"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '","COURSE_ID":"' +  $(this).find('input[type="checkbox"]').attr("cms-courseid") + '","EXAM_TYPE":"' + ($('#ExamType').val()) + '","EXAM_SESSION_ID":"' + ($('#ExamSession').val())  + '","EXAM_SETTING_ID":"' + ($('#ExamSetting').val())  + '","IS_CHECKED":"1"},';
                        }
                        if (chkBox.is(':not(:checked)')) {
                            jsonObject += '{"EXAM_ATTENDANCE_ID":"' + $(this).find('input[type="checkbox"]').attr("cms-examAttid") + '","STUDENT_ID":"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '","COURSE_ID":"' +  $(this).find('input[type="checkbox"]').attr("cms-courseid") + '","EXAM_TYPE":"' + ($('#ExamType').val()) + '","EXAM_SESSION_ID":"' + ($('#ExamSession').val())  + '","EXAM_SETTING_ID":"' + ($('#ExamSetting').val())  + '","IS_CHECKED":"0"},';
                        }                       
                    });
                });
                jsonObject = jsonObject.slice(0, -1);
                jsonObject += ']}';
            }
            $.ajax({
                url: "@Url.Action("SaveExaminationSeatingAttendance", "Examination")",
                method: "post",
                content: "application/json; charset=utf-8",
                data: { sJsonExamSeatingAttandance: jsonObject },
                success: function (data) {
                    if (data.ErrorCode!=null && data.ErrorCode=="402") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }else{
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    }
                                        
                }, error: function (e) {
                    swal({ title: "Error..!!", text:"Internal Server Errror..!!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            })    
        });
        
    });
</script>