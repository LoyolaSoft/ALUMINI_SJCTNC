@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int licount = 0;
    int imgcount = 0;

}
<style>
    .carousel-control.right 
    {
        background-image:none !important;
    }
     .carousel-control.left 
    {
          background-image:none !important;
    }
</style>
@if (Model.Liexamquesions != null && Model.Liexamquesions.Count > 0)
{
    <div id="AnswerSheet" class="carousel slide" data-ride="carousel">
        <!-- Indicators -->
        <ol class="carousel-indicators">
            @foreach (var item in Model.Liexamquesions)
            {
                licount++;
                if (licount == 1)
                {
                    <li data-target="#AnswerSheet" data-slide-to="@licount" class="active"></li>
                }
                else
                {

                <li data-target="#AnswerSheet" data-slide-to="@licount"></li>         
                }
            }
        </ol>

        <!-- Wrapper for slides -->
        <div class="carousel-inner">
            @foreach (var item in Model.Liexamquesions)
            {
                imgcount++;
                if (imgcount == 1)
                {
                <div class="item active">
                    <img src="@item.IMAGE_PATH" alt="Image" style="width:100%;transform: rotateY(180deg) !important; ">
                    <p class="text-break"><b>   @(new HtmlString(Model.GetStrigFromBase64String(item.QUESTION)))</b></p>
                    <center><button class="btn btn-primary" onclick="AssignPreviewForStudent(@item.QUIZ_SAVE_ID,@item.QUESTION_TYPE_ID,@item.EXAM_INVIGILATION_ID)">Ask to Retake</button></center>
                </div>
                }
                else
                {
                    <div class="item ">
                        <img src="@item.IMAGE_PATH" alt="Image" style="width:100%;transform: rotateY(180deg) !important;">
                        <p class="text-break"><b>   @(new HtmlString(Model.GetStrigFromBase64String(item.QUESTION)))</b></p>
                        <center><button class="btn btn-primary" onclick="AssignPreviewForStudent(@item.QUIZ_SAVE_ID,@item.QUESTION_TYPE_ID,@item.EXAM_INVIGILATION_ID)">Ask to Retake</button></center>
                    </div>
                }
            }
        </div>

        <!-- Left and right controls -->
        <a class="left carousel-control" href="#AnswerSheet" data-slide="prev">
            <span class="glyphicon glyphicon-chevron-left"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#AnswerSheet" data-slide="next">
            <span class="glyphicon glyphicon-chevron-right"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
}
else
{
    <pre>There is no answer sheet found...!</pre>
}
