<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li><a @*href="@Url.Action("ListQuiz","Examination")"*@ href="javascript:;" onclick="loadContent('/Examination/ListMatchTheFollowingForAdmin')">List Quiz</a></li>
        <li class="active">Add Quiz Questions</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Add Quiz Questions </h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Question and Answers</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            @*<div class="col-md-3 form-group">
                                @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>*@

                            @*<div class="col-md-3 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>*@

                            <div class="col-md-4 form-group">
                                @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4 form-group">
                                @Html.Label("Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.QuizQuestionType, (Model.QuizQuestionType != null) ? Model.QuizQuestionType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4 form-group">
                                @Html.Label("Options", htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-6">
                                    @*@Html.Editor("txtOption", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Options You Need" } })*@
                                    <input type="number" id="txtOption" max="10" class="form-control input-sm" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div id="dvtextboxes">
                            <!--Begin Question-->
                            <div class="row hidden" id="Question">

                                <div class="col-md-8 form-group">
                                    <label class="col-md-2 control-label">Question</label>
                                    <div class="col-md-10">
                                        <input type="text" id="TxtTitle" class="form-control" placeholder="Enter Your Question" @*maxlength="200"*@ @*style="width:115%"*@>
                                    </div>
                                </div>

                                <div class="col-md-4 form-group" id="Mark">
                                    <label class="col-md-3 control-label">Mark</label>
                                    <div class="col-md-6">
                                        <input type="number" id="txtMark" class="form-control" placeholder="Enter Your Mark">
                                    </div>
                                </div>

                            </div>
                            <!--End Question-->
                            <!--Begin match The Following-->
                            <div class="row hidden" id="dvMathTheFollowing">
                                <div class="col-md-6 form-group">
                                    <div id="dvOptions1"></div>
                                </div>
                                <div class="col-md-6 form-group">
                                    <div id="dvOptions2"></div>
                                </div>
                            </div>
                            <!-- End Match The Following-->
                            <!--Other Type-->
                            <div class="row hidden" id="dvOtherType">
                                <div id="dvOptions3"></div>
                            </div>

                            <div class="row">

                                <div class="col-md-8 form-group hidden" id="Answer">
                                    <label class="col-md-2 control-label">Answer</label>
                                    <div class="col-md-10">
                                        <input type="text" id="txtAnswer" class="form-control" placeholder="Enter Your Answer" maxlength="145" @*style="width:157%"*@>
                                    </div>
                                </div>

                                <div class="col-md-2 form-group">
                                    <a class="btn btn-primary pull-right hidden" id="btnSubmit">Submit</a>
                                </div>
                            </div>

                        </div>
                        @*<div id="Question">
                                <br />
                                <div class="form-group">
                                    @Html.Label("Question", htmlAttributes: new { @class = "control-label col-md-1" })
                                    <div class="col-md-6">
                                        @Html.TextAreaFor(model => model.ObjQuizQuestion.QUESTION, 5, 20, new { @class = "form-control ", placeholder = " Your Question", id = "Questions" })
                                        @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div id="dvOptions"></div>
                            </div>*@

                    </div>

                    <input type="hidden" value="@Model.SettingId" id="sSettingId" />
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
        @*$("#ClassList").on("change", function ()
        {
            var Class = $("#ClassList").val();
            $.ajax({
                url:"@Url.Action("FethCourseByClassIdAndStaffId", "Examination")",
                method: "POST",
                datatype: "json",
                data: { Class_Id: Class, Staff_Id: $('#StaffId').val() },
                success: function (data)
                {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error)
                {
                    alert('Internal Server Error .....!');
                }
            });
        })*@
        $("#txtOption").on("change", function ()
        {
            $('#dvtextboxes').removeClass('hidden');
            $("#btnSubmit").removeClass('hidden');
            var value = $("#txtOption").val();
            var Option = '';
            var Option2 = '';
            var Option3 = '';
            if (value > 10)
            {
                alert('Invalid Option .! Maximum Option is 10 .');
                value = 10;
                $("#txtOption").val('10');
            }
            $("#dvOptions1").empty();
            $("#dvOptions2").empty();
            $("#dvOptions3").empty();

            var QuizQuestions = $('#QuizQuestionType').val();
            if (QuizQuestions=="1" || QuizQuestions == "2")
            {
                $('#dvMathTheFollowing').addClass('hidden');
                $('#dvOtherType').removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-1">' + j + ' .)</label>';
                    Option += '<div class="col-md-10">';
                    Option += '<input type="text" id="Options' + i + '" class="form-control" placeholder="Enter Your Options" maxlength="145">';
                    Option += '</div>';
                    Option += '</div>';

                    //Option2 += '<div class="form-group">';
                    //Option2 += '<div class="col-md-9">';
                    //Option2 += '<input type="number" id="Mark' + i + '" class="form-control" placeholder="Enter Your Mark">';
                    //Option2 += '</div>';
                    //Option2 += '</div>';
                }
                //$("#dvOptions1").append(Option);
                //$("#dvOptions2").append(Option2);
                $("#dvOptions3").append(Option);
                $('#Answer').removeClass('hidden');
                $("#Question").removeClass('hidden');
            } else if (QuizQuestions=="3")
            {
                $('#dvOtherType').addClass('hidden');
                $("#dvMathTheFollowing").removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
                    Option += '<div class="col-md-9">';
                    Option += '<input type="text" id="Qustions' + i + '" class="form-control" placeholder="Enter Your Questions" maxlength="145" style="width:110%">';
                    Option += '</div>';
                    Option += '</div>';

                    Option2 += '<div class="col-md-12 form-group">';
                    Option2 += '<div class="col-md-9">';
                    Option2 += '<input type="text" id="Option' + i + '" class="form-control" placeholder="Enter Your Options" maxlength="145" style="width:110%">';
                    Option2 += '</div>';
                    Option2 += '</div>';
                }

                $("#dvOptions1").append(Option);
                $("#dvOptions2").append(Option2);
                $('#Mark').removeClass('hidden');
                $('#Answer').addClass('hidden');
                $("#Question").removeClass('hidden');
            }


        });

        $("#btnSubmit").on("click", function ()
        {
           // alert('Class :' + $("#ClassList").val() + 'Course :' + $("#CourseList").val() + 'Batch :' + $("#Batch").val());
            if ( !$("#Batch").val())
            {
                alert('Please Select All To Continue ! ');
                return false;
            }

            //for staffId
          //  var staffId = $('#StaffId').val();
            var QuizQuestions = $('#QuizQuestionType').val();
            var Endvalue = $("#txtOption").val();
            var Question = $("#TxtTitle").val();
          //  var CourseId = $("#CourseList").val();
           // var ddlAnswer = $("#Answer option:selected").text();
          //  var ddlClass = $("#ClassList").val();
            var QuestionId = $("#QuestionId").val();
            var SetId = $('#Batch').val();
            var ArrayOption = '';
            var nCount = 0;
            var SettingId = $('#sSettingId').val();
            ArrayOption = '{"liMF_Option":[';
            for (var i = 0; i < Endvalue; i++)
            {
                if (QuizQuestions == "1")
                {
                    // Objective Type Questions ...
                    if ($("#Options" + i).val())
                    {
                        ArrayOption += '{"OPTION":"' + $("#Options" + i).val() + '"},';
                        nCount++;
                    } else
                    {
                        alert('All the Options Must to Fill ..!');
                        return false;
                        break;
                    }
                } else if (QuizQuestions=="2")
                {
                    // Fill In The Blanks ...
                    if ($("#Options" + i).val())
                    {
                        ArrayOption += '{"OPTION":"' + $("#Options" + i).val() + '"},';
                        nCount++;
                    } else {
                        alert('All the Options Must to Fill ..!');
                        return false;
                        break;
                    }

                } else if (QuizQuestions == "3")
                {
                    // Match The Following ...
                    if ($("#Option" + i).val() && $("#Qustions" + i).val())
                    {
                        ArrayOption += '{"QUESTION":"' + $("#Qustions" + i).val() + '","ANSWER":"' + $("#Option" + i).val() + '"},';
                        nCount++;
                    } else
                    {
                        alert('All the Options Must to Fill ..!');
                        return false;
                        break;
                    }
                }
            }
            if (nCount != 0)
            {
                ArrayOption = ArrayOption.slice(0, -1);
                ArrayOption += ']}';
            } else
            {
                alert('Something is went wrong . please check your Input !');
                return false;
            }

            var JsonData;
            JsonData = '{"QUESTION":"' + Question + '","SET_ID":"' + SetId + '","ANSWER_ID":"' + $('#txtAnswer').val() + '","QUESTION_TYPE":"' + QuizQuestions + '","MARK":"' + $('#txtMark').val() + '"}';
            if (!$('#txtMark').val() || $('#txtMark').val()=='0')
            {
                alert('Please Enter Mark To Continue !');
                return false;
            }
            $.ajax({
                url:"@Url.Action("SaveMatchTheFollowingForAdmin", "Examination")",
                method: "POST",
                datatype: "json",
                data: { QuizQuestion: JsonData, sSaveMatchTheFollowing: ArrayOption, sSettingId: SettingId },
                success: function (data)
                {
                    alert(data.Message);
                    if (data.ErrorCode != null && data.ErrorCode)
                    {
                        $('#dvtextboxes').addClass('hidden');
                        $('#txtOption').val('');
                        $("#TxtTitle").val('');
                        $('#txtAnswer').val('');
                        $('#txtMark').val('');
                    }

                    //loadContent('/Examination/MatchTheFollowing');
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });

        });
</script>

