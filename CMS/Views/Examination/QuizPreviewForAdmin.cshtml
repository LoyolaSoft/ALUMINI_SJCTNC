<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">QuizPreviewForAdmin</li>
    </ol>
    <h1 class="page-header"> Quiz Preview ForAdmin </h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Quiz Preview ForAdmin</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">

            <div class="form-group col-md-12">
                <div class="col-md-3 form-group">
                    @Html.Label("Class List", htmlAttributes: new { @class = "col-md-5 control-label " })
                    <div class="col-md-7">
                        @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-3 form-group">
                    @Html.Label("Course List", htmlAttributes: new { @class = "col-md-5 control-label " })
                    <div class="col-md-7">
                        @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-3 form-group">
                    @Html.Label("Staff List", htmlAttributes: new { @class = "col-md-5 control-label " })
                    <div class="col-md-7">
                        @Html.DropDownListFor(m => m.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.StaffList, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3 form-group">
                    @Html.Label("Setting", htmlAttributes: new { @class = "col-md-5 control-label " })
                    <div class="col-md-7">
                        @Html.DropDownListFor(m => m.QuizSetting, (Model.QuizSetting != null) ? Model.QuizSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.QuizSetting, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-3">
                    @Html.LabelFor(model => model.Batch, "Set", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dSet" })
                        @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="form-group col-md-1">
                    <a class="btn btn-primary" id="btnGet">Get</a>
                </div>*@
            </div>
            @*<div class="form-group col-md-12" id="DataDiv">

            </div>*@
            <div class="form-group col-md-12" id="divBind">

            </div>

        </div>
    </div>
</div>
