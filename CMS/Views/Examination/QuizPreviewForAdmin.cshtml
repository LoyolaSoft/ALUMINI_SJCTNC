<script>

                ContentLoad = function () {
                  $('.selectpicker').selectpicker({
                      size: 5
                  });
                   $('.selectpicker').selectpicker('refresh');
                }

                //fetching course
                $('#ClassList').change(function () {

                    if ($('#ClassList').val()) {
                        $.ajax({

                            url: "/Examination/FetchCourseByClassId",
                            type: "post",
                            data: { sClassId: $('#ClassList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message);
                                    ListQuizStudentShuffle();
                                }
                                else {
                                    $('#CourseList').empty();
                                    $('#CourseList').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                    ListQuizStudentShuffle();

                                }
                            },
                            error: function () {

                                alert("Internal server error........!");
                            }

                        });
                    }
                });


                //Fetching staffList in the quiz setting 

                $('#CourseList').change(function () {

                    if ($('#ClassList').val() && $('#CourseList').val()) {
                        $.ajax({

                            url: "/Examination/FetchQuizStaffByClassandCourse",
                            type: "post",
                            data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message);
                                    ListQuizStudentShuffle();
                                }
                                else {
                                    $('#StaffList').empty();
                                    $('#StaffList').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                    ListQuizStudentShuffle();


                                }
                            },
                            error: function () {

                                alert("Internal server error........!");
                            }

                        });
                    }

                });



                //Fetch Quiz Setting by staff

                //for fetching setting based on staff

                $('#StaffList').change(function () {


                    if ($('#StaffList').val()) {
                        $.ajax({
                            url: "/Examination/FetchQuizSettingByStaff",
                            type: "post",
                            //contentType: false,
                            //processData: true,
                            data: { sStaffId: $('#StaffList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message);
                                    ListQuizStudentShuffle();
                                }
                                else {
                                    $('#QuizSetting').empty();
                                    $('#QuizSetting').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                    ListQuizStudentShuffle();
                                }
                            },
                            error: function () {

                            }
                        });
                    }
                });

                function ListQuizStudentShuffle() {

                    if ($('#ClassList').val() && $('#CourseList').val() && $('#StaffList').val() && $('#QuizSetting').val() && $('#dSet').val())
                    {
                        $.ajax({
                            url:"@Url.Action("BindOnlineQuizPreviewForAdmin", "Examination")",
                            type: "post",
                        data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sSetId: $('#dSet').val(), sSettingId: $("#QuizSetting").val(), sStaffId: $('#StaffList').val() },
                        success:function(data)
                        {
                            if(data.Message!=null && data.Message!='')
                            {
                                alert(data.Message)
                            }
                            else {

                                $('#divBind').empty();
                                $('#divBind').append(data);
                                $('.selectpicker').selectpicker('refresh');
                            }
                        },
                        error:function(ex)
                        {
                            alert('Internal Server Error !');
                        }
                    });
                }
                else {
                        $('#divBind').empty();
                }
                }




                $('#dSet').on("change", function () {

                    ListQuizStudentShuffle();
                });




