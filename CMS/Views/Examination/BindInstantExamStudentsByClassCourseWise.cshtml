@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
    int nCount = 0;
}


<div class="col-md-12 form-group table-responsive">
    <div class="col-md-12">
        <h4 class="text-center">
            <b>
                @if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
                {
                    <span>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME - @Model.liCollegeDetails.FirstOrDefault().COLLEGE_ADDRESS </span>
                }
        </b>
    </h4>
    <h4 class="text-center"> CIA Instant Student List For <span><b id="lblClass"></b></span></h4>
</div>
<table class="table table-bordered table-hover" border="1">
    <thead>
        <tr>
            <th>#</th>
            <th>Roll No</th>
            <th>Register No</th>
            <th>Name</th>
            <th>Course Code</th>
            <th>Course Title</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.liCIA_Total != null && Model.liCIA_Total.Count > 0)
            {
                var gropuedcourse = Model.liCIA_Total.GroupBy(o => new { o.STUDENT_ID });
                foreach (var item in gropuedcourse)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.FirstOrDefault().ADMISSION_NO</td>
                        <td>@item.FirstOrDefault().REGISTER_NO</td>
                        <td>@item.FirstOrDefault().NAME</td>
                        <td>@item.FirstOrDefault().COURSE_CODE</td>
                        <td>@item.FirstOrDefault().COURSE_TITLE</td>
                        <td>@item.FirstOrDefault().TOTAL</td>
                    </tr>
                }
            }
        }
    </tbody>
</table>
</div>