@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;

@{ 
    Layout = null;
  
}
@if (Model.sessionFlag)
{
    if (Model.liFetchHallTicket != null && Model.liFetchHallTicket.Count > 0 && Model.liRegistration != null)
    {
        if (string.IsNullOrEmpty(Model.sErrorMessage))
        {
            if (Model.liHallTicketValidation == null)
            {
                var blockgroup = Model.liFetchHallTicket.GroupBy(x => x.BLOCK_CODE).Select(x => new CMS.ViewModel.Model.FetchHallTicket() { BLOCK_CODE = x.FirstOrDefault().BLOCK_CODE, BLOCK_NAME = x.FirstOrDefault().BLOCK_NAME }).ToList();
                
                <div class="form-horizontal" id="dvHallticket">
                        <div class="form-group col-md-12">
                            <div class="col-xs-2">
                                <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:150px; height:150px" />
                            </div>

                            <div class="form-group col-xs-8 text-center">
                                <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h4>
                                <h5>@Model.liCollegeDetails.FirstOrDefault().PLACE .</h5>
                                <h5>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY</h5>
                                <h6>
                                    @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                                </h6>                                   
                                <h5>SEMESTER EXAMINATION HALL TICKET - @Model.Month_Year</h5>
                            </div>

                            <div class="form-group col-xs-2 pull-left">
                                @{
                                    if (Session[Common.SESSION_VARIABLES.PHOTO] != null && !string.IsNullOrEmpty(Session[Common.SESSION_VARIABLES.PHOTO].ToString()))
                                    {
                                        <img src="@Url.Content(Session[Common.SESSION_VARIABLES.PHOTO].ToString())" alt="Photo" style="width:150px; height:150px" />
                                    }
                                    else
                                    {
                                        <div src="" style="border:2px solid gray;width:100px; height:130px;"><p style="text-align:center;">AFFIX HERE YOUR PASSPORT SIZE PHOTOGRAPH TAKEN WITHIN A PERIOD OF THREE MONTHS</p></div>
                                    }
                                }
                            </div>

                        </div>

                        <hr />

                        <div class="form-group col-md-12">
                            <div class="form-group col-xs-4">
                                <label> Name : @Model.liRegistration.FirstOrDefault().FIRST_NAME</label>
                            </div>
                            <div class="form-group col-xs-4">
                                <label> Roll No : @Model.liRegistration.FirstOrDefault().ROLL_NO</label>
                            </div>
                            <div class="form-group col-xs-4">
                                <label> Register No : @Model.liRegistration.FirstOrDefault().REGISTER_NO</label>
                            </div>
                        </div>

                        <div class="form-group col-md-12">
                            <div class="form-group col-xs-8">
                                <label> Major : @Model.liRegistration.FirstOrDefault().DEPARTMENT</label>
                            </div>
                            <div class="form-group col-xs-4">
                                <label>Date of Birth : @Model.liRegistration.FirstOrDefault().DATE_OF_BIRTH</label>
                            </div>                           
                        </div>

                        <div class="form-group col-xs-12 table-responsive">
                            <table align="left" style="width:100%; border:1px solid; table-layout:fixed;">
                                <thead>
                                    <tr>                                       
                                        <th width="8% !important" style="border:1px solid; padding:8px;" align="left">Sem</th>
                                        <th width="16% !important" style="border:1px solid; padding:8px;" align="left">Date</th>
                                        <th width="27% !important" style="border:1px solid; padding:8px;" align="left">Time</th>
                                        <th width="32% !important" style="border:1px solid; padding:8px;" align="left">Course Tittle</th>
                                        <th width="20% !important" style="border:1px solid; padding:8px;" align="left">Course Code</th>
                                        <th width="18% !important" style="border:1px solid; padding:8px;" align="left">Seat</th>
                                        <th width="5% !important" style="border:1px solid; padding:8px;" align="left">S</th>
                                        <th width="10% !important" style="border:1px solid; padding:8px;" align="left">
                                          Sign
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.liFetchHallTicket != null && Model.liFetchHallTicket.Count>0)
                                    {
                                        foreach (var item in Model.liFetchHallTicket)
                                        {
                                            <tr>
                                                
                                                <td class="semi-bold" width="8% !important" style="border:1px solid; padding:8px;" align="left" >@Html.DisplayFor(modelItem => item.SEMESTER_ID)</td>
                                                <td class="semi-bold" width="16% !important" style="border:1px solid; padding:8px;" align="left" >@Html.DisplayFor(modelItem => item.EXAM_DATE)</td>
                                                <td class="semi-bold" width="27% !important" style="border:1px solid; padding:8px;" align="left">@Html.DisplayFor(modelItem => item.EXAM_TIME)</td>
                                                <td class="semi-bold" width="32% !important" style="border:1px solid; padding:8px;" align="left">@Html.DisplayFor(modelItem => item.COURSE_TITLE)</td>
                                                <td class="semi-bold" width="20% !important" style="border:1px solid; padding:8px;" align="left">@Html.DisplayFor(modelItem => item.COURSE_CODE)</td>
                                                <td class="semi-bold" width="18% !important" style="border:1px solid; padding:8px;" align="left">@Html.DisplayFor(modelItem => item.SEAT_CODE)</td>
                                                <td class="semi-bold" width="5% !important" style="border:1px solid; padding:8px;" align="left">@Html.DisplayFor(modelItem => item.STATUS)</td>
                                               
                                                <td width="10% !important" style="border:1px solid; padding:10px;" align="left"></td>
                                            </tr>
                                                        }
                                       }
                                                    
                                </tbody>
                            </table>
                        </div>

                        <div class="form-group col-xs-12">
                            <div class="col-xs-6 pull-left">
                                <p>
                                    <b>SeatDescription</b> : &nbsp;
                                    BlockCode - RoomNo - Position
                                </p>
                             </div>
                               <div class="col-xs-6 pull-right"> 
                                <label>R - Regular &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;  A - Arrear </label>
                               </div>
                           
                        </div>

                        <br />
                </div>

                <div class="form-group">
                    @if (blockgroup != null && blockgroup.Count > 0)
                    {
                        int nCount = 0;
                        foreach (var item in blockgroup)
                        {
                            if (item.BLOCK_CODE != "")
                            {
                                <div class="col-xs-4">
                                    <label>@{nCount++;} @nCount . @item.BLOCK_CODE  : @item.BLOCK_NAME</label>
                                </div>
                                                }
                                            }
                                        }
                </div>

                <div class="form-group col-xs-12">
                    <div class="col-xs-4"></div>
                    @if (Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE == "SJC")
                    {
                        <div class="col-xs-4"><img src="~/Content/hcc_img/sign/SJC_PRINCIPAL_SIGN.jpg" width="150px" /></div>

                        <div class="col-xs-4"><img src="~/Content/hcc_img/sign/SJC_COE_SIGN1.jpg" width="150px" /></div>
                    }
                    else
                    {
                        <div class="col-xs-4"><img src="~/Content/hcc_img/sign/Principal_Sign.jpg" width="150px" /></div>

                        <div class="col-xs-4"><img src="~/Content/hcc_img/sign/Controller_Sign.jpg" width="150px" /></div>
                    }
                    
                </div>

                <div class="form-group col-xs-12" style="margin-top:-22px">
                    <div class="col-xs-4">Student Sign</div>
                    <div class="col-xs-4">Principal</div>
                   
                    <div class="col-xs-4">Controller Of Examination</div>
                </div>

                <div class="form-group col-xs-12" style="margin-top:-22px">
                    @if (Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE == "SJC")
                    {
                        <br />
                        <label class="col-xs-12"> Issued Date : @System.DateTime.Now.ToString("dd/MM/yyyy")</label> <br />
                        <label class="col-xs-12"> Issued Time : @System.DateTime.Now.ToString("h:m:s")</label>
                        
                    }
                </div>
               }
             else
             {
                 <div class="alert alert-danger text-center "><b>@Model.liHallTicketValidation.FirstOrDefault().REASON !. Please Meet ERP Admin  .!</b></div>
             }
         }
         else
         {
             <div class="alert alert-danger text-center"> Please Clear Your @Model.sErrorMessage Dues !</div>
             if (Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE == "SJC")
             {
                    @Html.Action("FeeBalanceListForSJC", "Fee")
             }
             else
             {
                 @Html.Action("FeeBalanceList", "Fee")
             }
         }
     }
     else
     {
          <div class="alert alert-danger text-center "><b> Sorry Your Not Yet Registered ...!</b></div>
     }
  }
  else
  {
      <div class="alert alert-danger text-center "><b> Session out,Please Login again ...!</b></div>
  }


