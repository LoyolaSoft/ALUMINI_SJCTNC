@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int Count = 0;
}

<br />
<br />

<input type="hidden" id="hdErrorMessage" value="@if (!string.IsNullOrEmpty(Model.sErrorMessage)) { @Model.sErrorMessage }" />
<div class="form-group col-md-12 table-responsive pull-right">
    <table class="table table-bordered table-hover pull-right" id="tblquestions">
        <thead>
            <tr>
                <th>#</th>
                <th>Course</th>
                <th>Question Type</th>
                <th>Question</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.Liexamquesions != null && Model.Liexamquesions.Count > 0)
                {
                    foreach (var item in Model.Liexamquesions)
                    {
                        <tr>
                            <td>@{Count++;} @Count</td>

                            <td>@item.COURSE_ID</td>
                            <td>@item.QUESTION_TYPE</td>
                            <td>@(new HtmlString(Model.GetStrigFromBase64String(item.QUESTION)))</td>

                            <td>
                                <a href="#Edit-dialog" id="qi_@item.QUIZ_ID" cms-question="@item.QUESTION" onclick="FetchQuestionsById('@item.QUIZ_ID',this,'@item.QUESTION_TYPE_ID')" data-toggle="modal"><i class="fa fa-edit"></i></a>
                                <a href="javasript:;" onclick="GetConfirm('@item.QUIZ_ID','@item.QUESTION_TYPE_ID');"><i class="fa fa-trash text-danger"></i></a>
                            </td>
                        </tr>
                                    }
                                }
            }
        </tbody>
    </table>
</div>





