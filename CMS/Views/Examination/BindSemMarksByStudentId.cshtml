@model CMS.ViewModel.ViewModel.ExaminationViewModel


@{
    
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
    string sClass = string.Empty;
    string sResult = string.Empty;
}


  <div class="col-md-12 form-horizontal table-responsive">
      @{
          if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
          {
              <table class="table table-bordered">
                  <thead>
                      <tr>
                          <th>#</th>
                          <th>Semester</th>
                          <th>Code</th>
                          <th>Course</th>
                          <th>Internal</th>
                          <th>External</th>
                          <th>Total</th>
                          @*<th>Credit</th>
                              <th>Grade</th>
                              <th>Grade Point</th>*@
                          <th>Month/Year</th>
                          <th>Result</th>
                      </tr>
                  </thead>
                  <tbody>
                        @{
                            if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                            {
                                foreach (var item in Model.liSemesterList)
                                {
                                    if (item.RESULT != "P" && item.RESULT != "M")
                                    {
                                        sClass = "text-danger";
                                    }
                                    else
                                    {
                                        sClass = string.Empty;
                                    }

                                    if (item.RESULT == "W")
                                    {
                                        item.EXTERNAL_MARK = " -- ";
                                        item.TOTAL = " -- ";
                                    }
                                  <tr class="@sClass">
                                      <td>@{nCount++;} @nCount</td>
                                      <td>@item.SEMESTER</td>
                                      <td>@item.COURSE_CODE</td>
                                      <td>@item.COURSE_TITLE</td>
                                      <td>@item.INTERNAL_MARK</td>
                                      <td>@item.EXTERNAL_MARK</td>
                                      <td>@item.TOTAL</td>
                                      @*<td>@item.CREDIT</td>
                                          <td>@item.GRADE</td>
                                          <td>@item.GRADE_POINT</td>*@
                                      <td>@item.M_PASS</td>
                                      <td class="@sClass">@if (item.RESULT == "F") { sResult = "FAIL"; } else if (item.RESULT == "W") { sResult = "With Held"; } else if (item.RESULT == "A") { sResult = "Absend"; } else { sResult = "PASS"; } @sResult</td>
                                  </tr>
                              }
                          }
                      }
                  </tbody>
              </table>
          }
      }
  </div>

        