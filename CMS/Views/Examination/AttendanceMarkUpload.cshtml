@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<style>
    .upload-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 20px;
        margin-bottom: 20px;
    }
    .badge-mark {
        font-size: 13px;
        padding: 4px 10px;
        font-weight: 600;
        border-radius: 4px;
        background-color: #2a80b9;
        color: #fff;
    }
    .notice-box {
        background-color: #fff8e1;
        border-left: 4px solid #ffb300;
        padding: 12px 15px;
        border-radius: 4px;
        margin-bottom: 15px;
        color: #6d4c41;
        font-size: 13px;
    }
    .notice-box i {
        margin-right: 6px;
        color: #ff8f00;
    }
</style>

<div id="content" class="content">
    <!-- Breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Attendance Mark Upload</li>
    </ol>
    <!-- Page Header -->
    <h1 class="page-header">Attendance Mark Upload & CIA Push <small>Excel Upload and CIA Sync</small></h1>

    <div class="panel panel-inverse" id="mainPanel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload" onclick="reloadPage()"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
            </div>
            <h4 class="panel-title"><i class="fa fa-upload m-r-5"></i> Attendance Mark Management</h4>
        </div>
        <div class="panel-body">
            <!-- Action Bar -->
            <div class="row m-b-15">
                <div class="col-md-12 text-right">
                    <a href="@Url.Action("DownloadAttendanceMarkTemplate", "Examination")" class="btn btn-warning m-r-5" target="_blank">
                        <i class="fa fa-download m-r-5"></i> Download Excel Template
                    </a>
                    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modalPushCIA" onclick="initPushModal()">
                        <i class="fa fa-paper-plane m-r-5"></i> Push to CIA Mark
                    </button>
                </div>
            </div>

            <!-- Upload Card -->
            <div class="upload-card">
                <h4 class="m-t-0 m-b-15 text-primary"><i class="fa fa-file-excel-o m-r-5"></i> Upload Attendance Marks Excel</h4>
                <form id="formAttendanceUpload" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label"><b>Academic Year <span class="text-danger">*</span></b></label>
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select Academic Year --", new { @class = "form-control selectpicker show-tick", @id = "uploadAcYear", @data_live_search = "true" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label"><b>Semester Type <span class="text-danger">*</span></b></label>
                                <select class="form-control selectpicker" id="uploadSemesterType">
                                    <option value="">-- Select Semester Type --</option>
                                    <option value="1">Odd Semester (1, 3, 5)</option>
                                    <option value="2">Even Semester (2, 4, 6)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label"><b>Excel File (.xlsx / .xls) <span class="text-danger">*</span></b></label>
                                <input type="file" id="excelFileInput" class="form-control" accept=".xlsx,.xls" />
                                <small class="text-muted">Columns required: <code>ROLL_NO</code> and <code>MARK</code></small>
                            </div>
                        </div>
                        <div class="col-md-2" style="padding-top: 25px;">
                            <button type="button" class="btn btn-primary btn-block" id="btnUploadExcel" onclick="uploadExcel()">
                                <i class="fa fa-cloud-upload m-r-5"></i> Upload
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Upload Results Alert Area -->
                <div id="uploadResultAlert" style="display: none; margin-top: 15px;"></div>
            </div>

            <hr />

            <!-- Filter & Grid Card -->
            <div class="row m-b-10">
                <div class="col-md-4">
                    <h4 class="m-t-5 text-inverse"><i class="fa fa-list m-r-5"></i> Uploaded Attendance Marks Preview</h4>
                </div>
                <div class="col-md-8 text-right">
                    <button type="button" class="btn btn-info btn-sm" onclick="loadGridData()">
                        <i class="fa fa-refresh m-r-5"></i> Refresh List
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblAttendanceMarks" style="width:100%;">
                    <thead>
                        <tr class="bg-silver-lighter">
                            <th style="width: 50px;">#</th>
                            <th>Roll No</th>
                            <th>Student Name</th>
                            <th>Class</th>
                            <th style="width: 130px;" class="text-center">Attendance Mark</th>
                            <th>Academic Year</th>
                            <th>Semester Type</th>
                            <th>Uploaded Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Loaded dynamically via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Push to CIA Mark -->
<div class="modal fade" id="modalPushCIA" tabindex="-1" role="dialog" aria-labelledby="modalPushCIALabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <button type="button" class="close text-white" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title" id="modalPushCIALabel" style="color:white;"><i class="fa fa-paper-plane m-r-5"></i> Push Attendance Marks to CIA</h4>
            </div>
            <div class="modal-body">
                <div class="notice-box">
                    <i class="fa fa-info-circle fa-lg"></i>
                    <b>Important Rule:</b> Marks will be pushed <u>only to courses that have an Attendance component</u>. If CIA mark already exists for the course, it will be <b>UPDATED</b>; otherwise, a new record will be <b>INSERTED</b>.
                </div>

                <div class="form-group m-b-15">
                    <label class="control-label"><b>1. Academic Year <span class="text-danger">*</span></b></label>
                    <select class="form-control" id="pushAcYear" onchange="loadExamSettingsForPush()">
                        <option value="">-- Select Academic Year --</option>
                        @if (Model.AcademicYearList != null)
                        {
                            foreach (var item in Model.AcademicYearList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group m-b-15">
                    <label class="control-label"><b>2. Exam Setting <span class="text-danger">*</span></b></label>
                    <select class="form-control" id="pushExamSetting">
                        <option value="">-- First Select Academic Year --</option>
                    </select>
                    <span id="pushExamSettingHint" class="help-block text-muted" style="display:none;"></span>
                </div>

                <div id="pushProgressDiv" style="display:none; text-align:center; padding: 20px;">
                    <i class="fa fa-spinner fa-spin fa-3x text-success"></i>
                    <h4 class="text-success m-t-10">Processing Attendance Marks to CIA... Please wait.</h4>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnCancelPush">Cancel</button>
                <button type="button" class="btn btn-success" id="btnSubmitPush" onclick="confirmPushCIA()">
                    <i class="fa fa-check m-r-5"></i> Process & Push
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script type="text/javascript">
    var dataTableInstance = null;
    var isInitialized = false;

    function ContentLoad() {
        if ($.fn.selectpicker) {
            $('.selectpicker').selectpicker({ size: 8 });
            $('.selectpicker').selectpicker('refresh');
        }

        // When Academic Year or Semester Type changes in upload, refresh grid
        $('#uploadAcYear, #uploadSemesterType').off('change.att').on('change.att', function () {
            loadGridData();
        });

        loadGridData();
        isInitialized = true;
    }

    $(document).ready(function () {
        if (!isInitialized) {
            ContentLoad();
        }
    });

    function reloadPage() {
        loadGridData();
    }

    function initDataTable(dataSet) {
        if (!$.fn.DataTable) {
            return;
        }

        if ($.fn.DataTable.isDataTable('#tblAttendanceMarks')) {
            $('#tblAttendanceMarks').DataTable().clear().destroy();
        }

        dataTableInstance = $('#tblAttendanceMarks').DataTable({
            data: dataSet,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    data: null,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                { data: 'ROLL_NO' },
                { data: 'STUDENT_NAME' },
                { data: 'CLASS_NAME' },
                {
                    data: 'ATTENDANCE_MARK',
                    className: 'text-center',
                    render: function (data) {
                        return '<span class="badge-mark">' + Number(data).toFixed(2) + '</span>';
                    }
                },
                { data: 'ACADEMIC_YEAR' },
                {
                    data: 'SEMESTER_TYPE',
                    render: function (data) {
                        if (data === "1" || data === "ODD" || data === "Odd") return "Odd Semester";
                        if (data === "2" || data === "EVEN" || data === "Even") return "Even Semester";
                        return data;
                    }
                },
                { data: 'CREATED_DATE_DISPLAY' }
            ],
            language: {
                emptyTable: "No attendance marks uploaded yet for the selected criteria."
            }
        });
    }

    function loadGridData() {
        var acYear = $('#uploadAcYear').val();
        var semType = $('#uploadSemesterType').val();

        $.ajax({
            url: '@Url.Action("FetchUploadedAttendanceMarks", "Examination")',
            type: 'POST',
            data: { academicYear: acYear, semesterType: semType },
            success: function (res) {
                if (res && res.success) {
                    initDataTable(res.data);
                } else {
                    initDataTable([]);
                }
            },
            error: function () {
                initDataTable([]);
            }
        });
    }

    function uploadExcel() {
        var acYear = $('#uploadAcYear').val();
        var semType = $('#uploadSemesterType').val();
        var fileInput = document.getElementById('excelFileInput');

        if (!acYear) {
            swal("Validation Error", "Please select Academic Year.", "warning");
            return;
        }

        if (!semType) {
            swal("Validation Error", "Please select Semester Type.", "warning");
            return;
        }

        if (!fileInput.files || fileInput.files.length === 0) {
            swal("Validation Error", "Please choose an Excel file to upload.", "warning");
            return;
        }

        var formData = new FormData();
        formData.append("excelFile", fileInput.files[0]);
        formData.append("academicYear", acYear);
        formData.append("semesterType", semType);

        var btn = $('#btnUploadExcel');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Uploading...');

        $.ajax({
            url: '@Url.Action("UploadAttendanceMarkExcel", "Examination")',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                btn.prop('disabled', false).html('<i class="fa fa-cloud-upload m-r-5"></i> Upload');

                if (res && res.success) {
                    var alertHtml = '<div class="alert alert-success fade in m-b-0">' +
                        '<button type="button" class="close" data-dismiss="alert">×</button>' +
                        '<i class="fa fa-check-circle fa-lg m-r-5"></i> ' + res.message;

                    if (res.notFoundCount > 0 && res.notFoundRollNos && res.notFoundRollNos.length > 0) {
                        alertHtml += '<div class="m-t-10"><b>Unmatched Roll Numbers (' + res.notFoundCount + '):</b><br/>' +
                            '<span class="text-danger">' + res.notFoundRollNos.join(', ') + '</span></div>';
                    }
                    alertHtml += '</div>';

                    $('#uploadResultAlert').html(alertHtml).show();

                    swal("Success!", res.message, "success");

                    // Clear file input and refresh grid
                    $('#excelFileInput').val('');
                    loadGridData();
                } else {
                    swal("Upload Failed", res.message || "An error occurred during upload.", "error");
                }
            },
            error: function (xhr, status, error) {
                btn.prop('disabled', false).html('<i class="fa fa-cloud-upload m-r-5"></i> Upload');
                swal("Error", "Server error while uploading: " + error, "error");
            }
        });
    }

    function initPushModal() {
        var currentAcYear = $('#uploadAcYear').val();
        if (currentAcYear) {
            $('#pushAcYear').val(currentAcYear);
            loadExamSettingsForPush();
        } else {
            $('#pushAcYear').val('');
            $('#pushExamSetting').html('<option value="">-- First Select Academic Year --</option>');
        }
        $('#pushProgressDiv').hide();
        $('#btnSubmitPush, #btnCancelPush').prop('disabled', false);
    }

    function loadExamSettingsForPush() {
        var acYear = $('#pushAcYear').val();
        var ddl = $('#pushExamSetting');
        ddl.empty();

        if (!acYear) {
            ddl.html('<option value="">-- First Select Academic Year --</option>');
            return;
        }

        ddl.html('<option value="">Loading Exam Settings...</option>');

        $.ajax({
            url: '@Url.Action("GetExamSettingsByAcYear", "Examination")',
            type: 'POST',
            data: { academicYear: acYear },
            success: function (res) {
                ddl.empty();
                if (res && res.success && res.data && res.data.length > 0) {
                    ddl.append('<option value="">-- Select Exam Setting --</option>');
                    $.each(res.data, function (i, item) {
                        var semText = (item.SEMESTER_TYPE === "1") ? "Odd" : (item.SEMESTER_TYPE === "2") ? "Even" : "All";
                        var activeText = (item.IS_ACTIVE === 1) ? " [Active]" : "";
                        ddl.append($('<option>', {
                            value: item.EXAM_SETTING_ID,
                            text: item.EXAM_NAME + ' (' + semText + ' Sem)' + activeText
                        }));
                    });
                } else {
                    ddl.append('<option value="">No exam settings found for ' + acYear + '</option>');
                }
            },
            error: function () {
                ddl.html('<option value="">Error loading exam settings</option>');
            }
        });
    }

    function confirmPushCIA() {
        var acYear = $('#pushAcYear').val();
        var examSettingId = $('#pushExamSetting').val();
        var examSettingText = $('#pushExamSetting option:selected').text();

        if (!acYear) {
            swal("Validation Error", "Please select Academic Year.", "warning");
            return;
        }

        if (!examSettingId) {
            swal("Validation Error", "Please select Exam Setting.", "warning");
            return;
        }

        // Confirmation Alert Message
        swal({
            title: "Confirm Push to CIA?",
            text: "Are you sure you want to push attendance marks to CIA for:\n\n" +
                  examSettingText + " (" + acYear + ")\n\n" +
                  "Only courses containing an Attendance component will be processed. Existing marks will be updated, and missing marks will be inserted.",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#00acac",
            confirmButtonText: "Yes, Push Marks!",
            cancelButtonText: "Cancel",
            closeOnConfirm: false
        }, function (isConfirm) {
            if (isConfirm) {
                executePushCIA(acYear, examSettingId);
            }
        });
    }

    function executePushCIA(acYear, examSettingId) {
        $('#pushProgressDiv').show();
        $('#btnSubmitPush, #btnCancelPush').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("PushAttendanceMarksToCIA", "Examination")',
            type: 'POST',
            data: { academicYear: acYear, examSettingId: examSettingId },
            success: function (res) {
                $('#pushProgressDiv').hide();
                $('#btnSubmitPush, #btnCancelPush').prop('disabled', false);

                if (res && res.success) {
                    $('#modalPushCIA').modal('hide');
                    swal({
                        title: "Push Successful!",
                        text: res.message,
                        type: "success"
                    });
                } else {
                    swal("Push Failed", res.message || "An error occurred.", "error");
                }
            },
            error: function (xhr, status, error) {
                $('#pushProgressDiv').hide();
                $('#btnSubmitPush, #btnCancelPush').prop('disabled', false);
                swal("Error", "Server error while pushing marks: " + error, "error");
            }
        });
    }
</script>
