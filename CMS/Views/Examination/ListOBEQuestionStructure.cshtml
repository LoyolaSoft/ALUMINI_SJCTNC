@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListOBEQuestionStructure";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Question Structure </li>
    </ol>
    <h1 class="page-header">List Question Structure </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Question Structure</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#questionstructure" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblquestructure">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Application Type</th>
                            <th>Section</th>
                            <th>Question No</th>
                            <th>Mark Per Question</th>                          
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.LiOBEQuestionStructure != null && Model.LiOBEQuestionStructure.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.LiOBEQuestionStructure)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td>@item.APPLICATION_TYPE</td>
                                    <td>@item.SECTION</td>
                                    <td>@item.QUESTION_NO</td>
                                    <td>@item.MARK_PER_QUESTION</td>

                                   

                                    <td>
                                        <a href="#questionstructure" onclick="FetchOBEQuestionStructure(@item.QUESTION_STRUCTURE_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.QUESTION_STRUCTURE_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="questionstructure">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                          
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Application Type", htmlAttributes: new { @class = "col-md-4 control-label " })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ddlapptype" })
                                            @Html.ValidationMessageFor(m => m.ApplicationType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>                     
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Section Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtsection" class="form-control" placeholder="Section" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Number of Question</label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtnoquestion" class="form-control" placeholder="Question Number" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Mark Per Question</label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtmark" class="form-control" placeholder="Mark" data-parsley-required="true">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

        var tbl = $('#tblquestructure').DataTable();
        $('#tblquestructure').DataTable();

        function FetchOBEQuestionStructure(ID)
        {

            if (ID != null)
            {
                $.ajax({
                    url: "@Url.Action("FetchOBEQuestionStructureById", "Examination")",
                    type:"post",
                    data: { sStructureId: ID },
                    success:function(data)
                    {
                       
                            if (data != null)
                            {
                                $('#ddlapptype').val(data.APPLICATION_TYPE_ID);
                                $('#txtsection').attr('value', data.SECTION);
                                $('#txtnoquestion').attr('value', data.QUESTION_NO);
                                $('#txtmark').attr('value', data.MARK_PER_QUESTION);
                                $('.selectpicker').selectpicker('refresh');
                            }                       
                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }
        $('#btnSubmit').click(function ()
        {
            var isValid = true;
            var JsonData = null;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid)
            {

                return false;
            }                 
            JsonData = '{"SECTION":"' + $('#txtsection').val() + '","QUESTION_NO":"' + $('#txtnoquestion').val() + '","APPLICATION_TYPE_ID":"' + $('#ddlapptype').val() + '","MARK_PER_QUESTION":"' + $('#txtmark').val() + '"}';
              var req=  $.ajax({
                  url: "@Url.Action("SaveorUpdateOBEQuestionStructure", "Examination")",
                    type: "post",
                    data: { sJsonData: JsonData },
                    success: function (data)
                    {
                      
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/Examination/ListOBEQuestionStructure');
                           
                    },
                    error: function (ex)
                    {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
              });
        });
  
    GetConfirm = function (ID)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteOBEQuestionStructure", "Examination")",
        type: "post",
        data: { sStructureId: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "")
            {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Examination/ListOBEQuestionStructure');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }

</script>



