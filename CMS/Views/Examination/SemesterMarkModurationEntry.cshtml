@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <!-- begin breadcrumb -->
        <ol class="breadcrumb pull-right">
            <li><a @*href="@Url.Action("Student", "DashBoard")"*@ href="javascript:;">Home</a></li>
            <li class="active">Exam Moduration Mark Entry</li>
        </ol>
        <!-- end breadcrumb -->
        <!-- begin page-header -->
        <h1 class="page-header">Exam Moduration Mark Entry<small></small></h1>
        <!-- end page-header -->

        <div class="panel panel-primary" id="panel">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Exam Moduration Mark Entry</h4>
            </div>
            <div class="panel-body">
                <div class="form-group col-md-4">
                    <label class="control-label col-md-3">Exam Setting</label>
                    <div class="col-md-9">
                        @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                    </div>
                </div>

                <div class="form-group col-md-4">
                    <label class="control-label col-md-3">Program Level</label>
                    <div class="col-md-9">
                        @Html.DropDownListFor(m => m.Program, (Model.Program != null) ? Model.Program : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                    </div>
                </div>

                <div class="form-group col-md-4">
                    <label class="control-label col-md-3">Department</label>
                    <div class="col-md-9">
                        @Html.DropDownListFor(m => m.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                    </div>
                </div>

            </div>
        </div>
    }
</div>


<div class="modal" id="modal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Course Wise Count </h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group" id="dvValidate" data-parsley-validate="true">
                        <div class="col-md-12">
                          
                            <div id="dvBind"></div>
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-toggle="modal" data-dismiss="modal" >Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdDeptQuestionSettingId" />

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    $('.selectpicker').selectpicker({ size: 6 });
    $('.selectpicker').selectpicker('refresh');
    function ContentLoad()
    {
        // Document ready function ...
    }
</script>

@* Bind Course Wise Count *@
<script>
    $('#DepartmentList').on('change', function ()
    {
        $.ajax({
            url: '/Examination/FetchExamDeptQuestionSettingById',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId:$('#ExamSetting').val(), sDeptId: $('#DepartmentList').val() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                } else
                {
                    $('#dvBind').empty().append(data);
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    })
</script>
