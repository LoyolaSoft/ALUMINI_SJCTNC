@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null; 
    int nCount = 0;
}

<div class="col-md-12 form-group table-responsive">
    <div class="col-md-12">
        <h4 class="text-center"><b> ST.JOSEPH'S COLLEGE OF ARTS & SCIENCE (AUTONOMOUS) CUDDALORE - 607001</b> </h4>
        <h4 class="text-center text-primary"><b> CIA Instant Student List (Bulk Report)</b></h4>
    </div>
    
    <table id="dtFullStudentList" class="table table-striped table-bordered table-hover">
        <thead>
            <tr class="info">
                <th class="text-center">#</th>
                <th class="text-center">Roll No</th>
                <th class="text-center">Register No</th>
                <th class="text-center">Name</th>
                <th class="text-center">Class Name</th>
                <th class="text-center">Course Code</th>
                <th class="text-center">Course Title</th>
                <th class="text-center">Total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.liCIA_Total != null && Model.liCIA_Total.Any())
            {
                var groupedStudents = Model.liCIA_Total.GroupBy(o => new { o.STUDENT_ID, o.COURSE_ID });
                foreach (var item in groupedStudents)
                {
                    var studentCourse = item.FirstOrDefault();
                    <tr>
                        <td class="text-center">@{nCount++;} @nCount</td>
                        <td>@studentCourse.ADMISSION_NO</td>
                        <td>@studentCourse.REGISTER_NO</td>
                        <td>@studentCourse.NAME</td>
                        <td>@studentCourse.CLASS_NAME</td>
                        <td>@studentCourse.COURSE_CODE</td>
                        <td>@studentCourse.COURSE_TITLE</td>
                        <td class="text-center">
                            <span class="badge badge-success">@studentCourse.TOTAL</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#dtFullStudentList')) {
            $('#dtFullStudentList').DataTable().destroy();
        }

        $('#dtFullStudentList').DataTable({
            "bPaginate": true,
            "bFilter": true,
            "bInfo": true,
            "autoWidth": false,
            "dom": '<"row"<"col-sm-4"l><"col-sm-4 text-center"B><"col-sm-4"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>',
            "buttons": [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa fa-file-excel-o"></i> Export to Excel',
                    className: 'btn btn-success btn-sm m-b-10',
                    title: 'Instant Exam Student List'
                }
            ]
        });
    });
</script>
