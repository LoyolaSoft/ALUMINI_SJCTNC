@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{

    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">
            Exam Dummy No Report
        </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">
        Exam Dummy No Report
    </h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">
                Exam Dummy No Report
            </h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12">

                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ApplicationType, "Application Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeLevel, (Model.ProgrammeLevel != null) ? Model.ProgrammeLevel : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm" })
                                @Html.ValidationMessageFor(model => model.ProgrammeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSetting, "Exam Name", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.Label("Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <select class="selectpicker form-control  input-sm" id="status">
                                    <option value="0">--Select--</option>
                                    <option value="1">Date</option>
                                    <option value="2">Code</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12">

                        <div class="form-group col-md-4 hidden" id="examdates">
                            @Html.LabelFor(model => model.ExamDate, "Exam Date", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamDate, (Model.ExamDate != null) ? Model.ExamDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.ExamDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4 hidden" id="examsession">
                            @Html.Label("Session", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <select class="selectpicker form-control  input-sm" id="ExamSession">
                                    <option value="0">--Select--</option>
                                    <option value="1">FN</option>
                                    <option value="2">AN</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 hidden" id="examcourses">
                            @Html.LabelFor(model => model.CourseList, "Course", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-4 practicalcourse hidden" id="practicalcourse">
                            @Html.LabelFor(model => model.CourseList, "Course", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @id = "ddlpractical" })
                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4  practicalcourse hidden" id="practicalcourse">
                            @Html.LabelFor(model => model.CourseList, "Date", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <input type="text" id="datesession" placeholder="Date & Session" class="form-control">
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Batch, "Batch", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" id="btnget" class="btn btn-primary">Get</a>
                        </div>
                    </div>

                    <div class="row col-md-12">
                        <div id="dvBind">

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script>
    $('.selectpicker').selectpicker({
        size: 4
    });

    $("#ExamSetting").on("change", function ()
    {
        var ExamId = $("#ExamSetting").val();
        $.ajax({
            url: "@Url.Action("FetchExamDate", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sExamId: ExamId },
            success: function (data)
            {
                $("#ExamDate").empty();
                $("#ExamDate").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });


    });

    $("#examsession").on("change", function ()
    {
        var ExamId = $("#ExamSetting").val();
        var sApplicationId = $('#ProgrammeLevel').val();
        var vexamdate = $("#ExamDate option:selected").map(function () {
            var vDate = "'" + $(this).val() + "'";
            return vDate;
        }).get().join(',');
        var ExamSession = $('#ExamSession').val();
        $.ajax({
            url: "@Url.Action("FetchExamCoursebyExamDate", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sExamId: ExamId, sApplicationtypeId: sApplicationId.toString(), sExamDate: vexamdate.toString(), sExamSession: ExamSession },
            success: function (data)
            {
                $("#CourseList").empty();
                $("#CourseList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });


    });

     $("#ExamSetting").on("change", function ()
    {
         var ExamId = $("#ExamSetting").val();
        $.ajax({
            url: "@Url.Action("FetchExamCourse", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sExamId: ExamId },
            success: function (data)
            {
                $("#CourseList").empty();
                $("#CourseList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });

    });

     $("#ExamSetting").on("change", function ()
    {
         var ExamId = $("#ExamSetting").val();
        $.ajax({
            url: "@Url.Action("FetchExamPracticalCourse", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sExamId: ExamId },
            success: function (data)
            {
                $("#ddlpractical").empty();
                $("#ddlpractical").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });

    });
    $("#CourseList").on("change", function () {
        var Programme = $("#ProgrammeList").val();
        var CourseId = $("#CourseList option:selected").map(function () {
            return $(this).val();
        }).get().join(',');
        var Examsetting = $("#ExamSetting").val();
        $.ajax({
            url: "@Url.Action("BindBatchBySettingId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sProgrammeId: Programme, sCourseId: CourseId.toString(), sExamSettingId:Examsetting},
            success: function (data) {
                $("#Batch").empty();
                $("#Batch").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });
    $("#status").on("change", function ()
    {
        if ($("#status").val() == "1")
        {
            $('.practicalcourse').addClass('hidden');
            $('#examdates').removeClass('hidden');
            $('#examsession').removeClass('hidden');
            $('#examcourses').removeClass('hidden');
        }
        if ($("#status").val() == "2") {
            $('.practicalcourse').addClass('hidden');
            $('#examdates').addClass('hidden');
            $('#examcourses').removeClass('hidden');
        }
        if ($("#status").val() == "3")
        {
            $('#examdates').addClass('hidden');
            $('#examcourses').addClass('hidden');
            $('.practicalcourse').removeClass('hidden');
        }


    });

    $('#btnget').on('click', function ()
    {
        binddatas();
     });

    function binddatas() {
        var sExamId = $('#ExamSetting').val();
     var sApplicationId = $('#ProgrammeLevel').val();
     var vBatch = $('#Batch option:selected').map(function ()
     {
         return $(this).val();
     }).get().join(',');
     var vCourse = $('#CourseList').val();
     if (vCourse == null) { vCourse = "0"; }
     var vPracticalCourse = $('#ddlpractical').val();
     if (vPracticalCourse == null) { vPracticalCourse = "0"; }
     var vexamdate = $("#ExamDate option:selected").map(function ()
     {
         var vDate = "'"+$(this).val()+"'";
         return vDate;
     }).get().join(',');
     var vtype = $('#status').val();
     var ischecked = 0;
     if ($('input[type="checkbox"]').is(":checked")) {
         ischecked = 1;
     }

         $.ajax({
             url: "@Url.Action("Bindaddevaluationstaff", "Examination")",
             method: "POST",
             datatype: "json",
             data: { sExamSettingId: sExamId, sApplicationtypeId: sApplicationId.toString(), sBatch: vBatch.toString(), sExamDate: vexamdate.toString(), sCourse: vCourse.toString(), sPracticalCourse: vPracticalCourse.toString(), sType: vtype.toString(), sDatesession: $('#datesession').val()},
             success: function (data)
             {
                 $('#dvBind').empty();
                 $('#dvBind').append(data);
                 const elements2 = document.querySelectorAll('.isforsticker');
                 elements2.forEach(element => {
                     element.style.display = 'none';
                 });

             }, error: function (error)
             {
                 alert('Internal Server Error !');
             }
         })
    };

</script>






