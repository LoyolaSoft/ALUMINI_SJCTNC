
@{
    ViewBag.Title = "Equation";
}

<link href="~/Content/mathurl/style1.css" rel="stylesheet" />

<style type="text/css" media="only screen and (device-width: 768px)">
    body {
        font-size: 130%;
    }

    #latexinput textarea {
        height: 400px;
    }

    h1 {
        font-size: 120%;
    }

    #tagline {
        font-size: 80%;
    }

    #content {
        padding-bottom: 1em;
    }

    #sidead {
        display: none;
    }
</style>
