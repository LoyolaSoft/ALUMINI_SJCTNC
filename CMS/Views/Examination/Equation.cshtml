    <div id="content">
       

        <div id="loader"><img src="~/Content/mathurl/images/loader.gif" alt="" /></div>
        <div id="copyable">

            <img id="image" src="" style="border: 0; padding: 1ex 2ex 1ex 2ex" alt="" />
