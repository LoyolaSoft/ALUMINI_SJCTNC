                                    <option value="math" selected="selected">equation</option>
                                    <option value="inline">inline equation</option>
                                    <option value="text">paragraph</option>
                                </select>
                            </div>
                            <input type="button" id="clear" value="clear input" style="float:right" />
                        </div>

                    </div>

