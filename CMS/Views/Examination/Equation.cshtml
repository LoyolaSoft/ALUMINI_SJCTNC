            <form action="http://mathurl.com/" method="post">
                <div id="latexcontainer">
                    <div id="latexinput">
                        <textarea name="latex" id="latex" rows="16" spellcheck="false" cols="80" accesskey="t"></textarea><br />
                        <div id="controls">
                            <div style="float:left">
                                <input type="submit" id="preview" name="preview" value="preview" accesskey="p" style="display:none" />
