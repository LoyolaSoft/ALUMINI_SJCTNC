@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}

<div class="form-group col-md-12 pull-right">
    <a href="#ExamRegistration-dialog" class="btn btn-success pull-right" id="btnAdd" data-toggle="modal"><i class="fa fa-plus"></i> Add</a>
</div>
<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Course Code</th>
                <th>Course Title</th>
                <th>Semester</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{ 
                if (Model.liExamRegistrationList!=null && Model.liExamRegistrationList.Count>0)
                {
                    int nCount = 0;
                    foreach (var item in Model.liExamRegistrationList)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.COURSE_CODE</td>
                            <td>@item.COURSE_TITLE</td>
                            <td>@item.SEMESTER_ID</td>
                            <td>@item.STATUS</td>
                            <td>
                                <a href="javascript:;" class="text-danger" onclick="DeleteExamRegistration('@item.REGISTRATION_ID','@item.COURSE_ROOT_ID','@item.STUDENT_ID')"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>


<!-- Begin Honour Modal -->
<div class="modal" id="ExamRegistration-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title"> Add/Edit Exam Registration </h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal row">
                    <div class="col-md-12" id="dvExamRegistration">
                        <div class="form-group">
                            @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @*@Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })*@
                                <select class="form-control  selectpicker" data-live-search="true" id="CourseList">
                                    @if (!string.IsNullOrEmpty(Model.Course))
                                    {
                                        @Html.Raw(Model.Course);
                                    }
                                    
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a id="btnSubmit" class="btn btn-sm btn-primary" onclick="SubmitData()" data-dismiss="modal">Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdExamRegistrationId" />
<!-- End Subject Association Modal -->