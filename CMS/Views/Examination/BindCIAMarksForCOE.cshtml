@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
    int count = 0;
}

@using CMS.Utility;

<br /><br /><br />
<div class="invoice" style="background-color:#F6F6F6 !important;">
    <div class="invoice-company" id="dvHead">
        @Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME ,<small>
            INTERNAL ASSESSMENT (CIA) - MARK SHEET(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } })
        </small>
    </div>

    <div class="col-md-12 table-responsive">
        @{ 
            if (Model.liCIA_Total != null && Model.liCIA_Total.Count > 0)
            {
                foreach (var item in Model.liCoursePattern)
                {
                    <div @*style="page-break-after:avoid !important;page-break-inside:avoid !important;"*@>
                        @*<table cellpadding="10" cellspacing="10">
                            <tr>
                                <td><b>Course Name &nbsp;&nbsp;&nbsp; : </b></td>
                                <td class="semi-bold"> @item.COURSE_TITLE &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>
                                <td></td>
                                <td></td>
                                <td><b>Staff Name(s) &nbsp;&nbsp;&nbsp; : </b></td>
                                <td class="semi-bold">@item.NAME </td>
                            </tr>
                            <tr>
                                <td><b>Course Code &nbsp;&nbsp;&nbsp;&nbsp; : </b></td>
                                <td class="semi-bold">@item.COURSE_CODE &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>
                                <td></td>
                                <td></td>
                                <td><b>Semester &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; : </b></td>
                                <td class="semi-bold" id="sSemester">@item.SEMESTER_NAME</td>
                            </tr>
                            <tr>
                                <td><b>Department &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: </b></td>
                                <td class="semi-bold">@item.DEPARTMENT &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>
                                <td></td>
                                <td></td>
                                <td><b>Class Name &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: </b></td>
                                <td class="semi-bold">@item.CLASS_NAME</td>
                            </tr>
                        </table>*@


                        <br />
                        @{ var liGroupByCourse = Model.liCIA_Total.Where(x => x.COURSE_ID == item.COURSE_ID && x.PROGRAMME_GROUP_ID==item.PROGRAMME_GROUP_ID).ToList(); count = 0;}
                        @if (liGroupByCourse != null && liGroupByCourse.Count > 0)
                        {
                             <table class="table table-bordered table-hover" id="tblCIAMarks">
                                 <thead>
                                     <tr>
                                         <th>#</th>
                                         <th>Roll No</th>
                                         @*<th>Register No</th>*@
                                         <th>Course Code</th>
                                         <th>Course Title</th>
                                         <th>Name</th>
                                         <th>Total (@item.INTERNAL)</th>
                                     </tr>
                                 </thead>
                                 <tbody>
                                     @foreach (var CIAitem in liGroupByCourse)
                                     {
                                         <tr>
                                             <td>@{count++;} @count</td>
                                             <td>@CIAitem.ROLL_NO</td>
                                             @*<td>@CIAitem.REGISTER_NO</td>*@
                                             <td>@item.COURSE_CODE</td>
                                             <td>@item.COURSE_TITLE</td>
                                             <td>@CIAitem.NAME</td>
                                             <td>@CIAitem.TOTAL</td>
                                         </tr>
                                     }
                                 </tbody>
                             </table>
                        }
                        
                    </div>
                 }
             }
             else
             {
                 <div class="alert alert-danger">No Record(s) Found !</div>
             }
        }
    </div>
</div>