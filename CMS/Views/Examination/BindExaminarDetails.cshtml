
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{int count = 0;}
@if (Model.LiExaminar != null && Model.LiExaminar.Count > 0)
{
    <div class="col-md-12 form-horizontal">
        <div class="table-responsive">
            <br /><br />
            <table class="col-md-12 table table-hover table-bordered" id="tblStudentList">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Programme_Name</th>
                        <th>Examinar_Name</th>
                        <th>Examinar_Code</th>
                        <th>Mobile_No</th>
                        <th>Email_Id</th>
                        <th>College_Name</th>
                        <th>Place</th>
                        <th>Purpose</th>
                        <th>Experience_UG</th>
                        <th>Experience_PG</th>
                        <th>Experience_MPHIL</th>
                        <th>SUBJECT1</th>
                        <th>SUBJECT2</th>
                        <th>SUBJECT3</th>
                        <th>SUBJECT4</th>
                        <th>Designation</th>
                        <th>Qualification</th>
                        <th>Examinar</th>
                        <th>Questionsetter</th>
                        <th>Practical</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.LiExaminar)
                    {
                        <tr>
                            <td>@{ count++;}@count</td>
                            <td>@item.PROGRAMME_NAME</td>
                            <td>@item.EXAMINAR_NAME</td>
                            <td>@item.EXAMINAR_CODE</td>
                            <td>@item.MOBILE_NO</td>
                            <td>@item.EMAIL_ID</td>
                            <td>@item.COLLEGE_NAME</td>
                            <td>@item.PLACE</td>
                            <td>@item.PURPOSE</td>
                            <td>@item.EXPERIENCE_UG</td>
                            <td>@item.EXPERIENCE_PG</td>
                            <td>@item.EXPERIENCE_MPHIL</td>
                            <td>@item.SUBJECT1</td>
                            <td>@item.SUBJECT2</td>
                            <td>@item.SUBJECT3</td>
                            <td>@item.SUBJECT4</td>
                            <td>@item.DESIGNATION</td>
                            <td>@item.QUALIFICATION</td>
                            @if (item.IS_EXAMINAR == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            @if (item.IS_QUESTIONSETTER == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            @if (item.IS_PRACTICAL == "1")
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            <td>
                                <a href="#ExaminarsDetails-dialog" onclick="FetchExaminarDetails(@item.EXAMINAR_ID)" data-toggle="modal"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                <a onclick="GetConfirm(@item.EXAMINAR_ID)"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
            <br />

        </div>
    </div>
}
else
{
    <table class="table table-hover table-bordered">
        <tr>
            <td colspan="11" align="center" style="background-color:lightcoral;">No Records Found ...!</td>
        </tr>
    </table>
}
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    var rowcounts = $('#totalrows').val();
    $("#tblStudentList").DataTable({
        "lengthMenu": [10, 20, 50, 100, 200, 500, rowcounts],
        "columnDefs": [
            { "width": "8%", "targets": [5, 6] }
        ], "scrollX": true

    });
</script>