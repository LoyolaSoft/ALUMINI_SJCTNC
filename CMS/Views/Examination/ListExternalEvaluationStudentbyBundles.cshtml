@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}
<div class="col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblBundlesStuentAssign">
        <thead>
            <tr>
                <th>#</th>
                <th>Bundle No</th>
                <th>Pocket No</th>
                <th>Pocket Category</th>
                <th>Staff Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liEXAM_EVALUATION_STUDENT_MARK != null & Model.liEXAM_EVALUATION_STUDENT_MARK.Count > 0)
            {
                int count = 0;
                foreach (var item in Model.liEXAM_EVALUATION_STUDENT_MARK)
                {
                    <tr>
                        <td>@{count++;}@count</td>
                        <td>@item.EXAM_BUNDLE_NO</td>
                        <td>@item.POCKET_NO</td>
                        <td>@item.POCKET_CATEGORY</td>
                        <td>@item.NAME</td>
                        <td>
                            <a href="javascrip:;" class="text-primary"><i class="fa fa-edit" title="Click to Edit"></i></a>
                            <a href="javascrip:;" onclick="GetConfirm(@item.EXAM_BUNDLE_ID)" class="text-danger" title="Click to Delete"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                                }

                            }
        </tbody>
    </table>
</div>
