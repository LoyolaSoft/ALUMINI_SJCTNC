@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List Exam Registration</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Exam Registration<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Exam Registration</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">

                        <div class="col-md-4">
                            @Html.Label("Setting", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("App.Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ApplicationType, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("Shift", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.Shift, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <a href="javascript:;" id="sPrint" onclick="printDiv('dvExamRegistrationbind')" class="btn btn-sm btn-success m-b-10 disabled pull-right"><i class="fa fa-print m-r-5"></i> Print</a>
                    </div>
                </div>

                <div class="row">
                    <div id="dvExamRegistrationbind"></div>
                </div>

            }

        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>


<script>
    $('#ExamSetting').on('change', function ()
    {
        FetchApplication();
    });

    $('#ApplicationType').on('change', function ()
    {
        FetchApplication();
    });

    $('#Shift').on('change', function ()
    {
        FetchApplication();
    });


    function FetchApplication()
    {
        if ($('#ExamSetting').val() && $('#ApplicationType').val() && $('#Shift').val())
        {
            $('#dvExamRegistrationbind').empty();
            $.ajax({
                url: '@Url.Action("BindExamApplicationList", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sShift: $('#Shift').val(), sApplicationType: $('#ApplicationType').val(), sExamSettingId: $('#ExamSetting').val() },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else
                    {
                        $('#dvExamRegistrationbind').append(data);
                        $('#sPrint').removeClass('disabled');
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        } 
    }
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
    }
</script>