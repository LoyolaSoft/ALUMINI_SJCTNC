@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "DisplaySemesterMarksForStudent";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
    string sClass = string.Empty;
    string sResult = string.Empty;
}



<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Exam Mark Details</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam Mark Details<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> Exam Mark Details</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="col-md-12 form-horizontal">
                    @{
                        if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                        {
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Semester</th>
                                        <th>Code</th>
                                        <th>Course</th>
                                        <th>Internal</th>
                                        <th>External</th>
                                        <th>Total</th>
                                        @*<th>Credit</th>
                                            <th>Grade</th>
                                            <th>Grade Point</th>*@
                                        <th>Month/Year</th>
                                        <th>Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        @*if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                                            {
                                                foreach (var item in Model.liExamRegistrationList)
                                                {
                                                    var liSemeserMarks = Model.liSemesterList.Where(x => x.COURSE_ROOT_ID == item.COURSE_ID).ToList();
                                                    if (liSemeserMarks != null && liSemeserMarks.Count > 0)
                                                    {
                                                        foreach (var Marksitem in liSemeserMarks)
                                                        {
                                                            if (Marksitem.RESULT == "F")
                                                            {
                                                                sClass = "text-danger";
                                                            }
                                                            else
                                                            {
                                                                sClass = string.Empty;
                                                            }
                                                            <tr class="@sClass">
                                                                <td>@{nCount++;} @nCount</td>
                                                                <td>@item.SEMESTER_ID</td>
                                                                <td>@item.COURSE_CODE</td>
                                                                <td>@item.COURSE_TITLE</td>
                                                                <td>@Marksitem.INTERNAL_MARK</td>
                                                                <td>@Marksitem.EXTERNAL_MARK</td>
                                                                <td>@Marksitem.TOTAL</td>
                                                                <td>@Marksitem.CREDIT</td>
                                                                <td>@Marksitem.GRADE</td>
                                                                <td>@Marksitem.GRADE_POINT</td>
                                                                <td>@Marksitem.M_PASS</td>
                                                                <td>@if (Marksitem.RESULT == "F") { sResult = "FAIL"; } else { sResult = "PASS"; } @sResult</td>
                                                            </tr>
                                                         }
                                                     }
                                                 }
                                             }
                                             else
                                             {
                                                 foreach (var item in Model.liExamRegistrationList)
                                                 {
                                                     <tr class="@sClass">
                                                         <td>@{nCount++;} @nCount</td>
                                                         <td>@item.SEMESTER_ID</td>
                                                         <td>@item.COURSE_CODE</td>
                                                         <td>@item.COURSE_TITLE</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                         <td>0</td>
                                                     </tr>
                                                 }
                                             }*@

                                        if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                                        {
                                            foreach (var item in Model.liSemesterList)
                                            {
                                                if (item.RESULT == "F" && item.RESULT == "W")
                                                {
                                                    sClass = "text-danger";
                                                }
                                                else
                                                {
                                                    sClass = string.Empty;
                                                }
                                                <tr class="@sClass">
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.SEMESTER</td>
                                                    <td>@item.COURSE_CODE</td>
                                                    <td>@item.COURSE_TITLE</td>
                                                    <td>@item.INTERNAL_MARK</td>
                                                    <td>@item.EXTERNAL_MARK</td>
                                                    <td>@item.TOTAL</td>
                                                    @*<td>@item.CREDIT</td>
                                                        <td>@item.GRADE</td>
                                                        <td>@item.GRADE_POINT</td>*@
                                                    <td>@item.M_PASS</td>
                                                    <td>@if (item.RESULT == "F") { sResult = "FAIL"; } else if (item.RESULT == "W") { sResult = "With Held"; } else if (item.RESULT == "A") { sResult = "Absent"; } else { sResult = "PASS"; } @sResult</td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>
<!-- end #content -->
