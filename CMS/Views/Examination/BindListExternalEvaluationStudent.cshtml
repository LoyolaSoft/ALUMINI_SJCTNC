@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{Layout = null; int count = 0; }
@if (Model.liEXAM_EVALUATION_STUDENT_MARK != null && Model.liEXAM_EVALUATION_STUDENT_MARK.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover" id="tblEvalStudentlist">
            <thead>
                <tr>
                    <td>#</td>
                    <td>Register No</td>
                    <td>Action</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.liEXAM_EVALUATION_STUDENT_MARK)
                {
                    <tr>
                        <td>@{count++;}@count</td>
                        <td>@item.REGISTER_NO</td>
                        <td><a href="javascrip:;" onclick="GetConfirm(@item.EXAM_EV_STU_MARK_ID)" class="text-danger"><i class="fa fa-trash"></i></a></td>
                    </tr>
                            }                
            </tbody>
        </table>
    </div>
}