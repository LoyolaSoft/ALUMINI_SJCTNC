
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility
@{
    ViewBag.Title = "ListPhotoCopySetting";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListExamPhotoCopy</li>
    </ol>
    <h1 class="page-header">List Exam Photocopy Setting</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Exam Photocopy Setting</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#EPSetting-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblLiEPSetting">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Exam Setting</th>
                            <th>Application Type</th>
                            <th>Maximum Paper</th>
                            @*<th>Question Type</th>*@
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Active/Deactive</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liExamPhotoCopySetting != null && Model.liExamPhotoCopySetting.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liExamPhotoCopySetting)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.EXAM_SETTING</td>
                                    <td>@item.APPLICATION_TYPE</td>
                                    <td>@item.MAX_PAPER</td>
                                    @*<td>@item.QUESTION_TYPE</td>*@
                                    <td>@item.START_DATE</td>
                                    <td>@item.END_DATE</td>
                                    <td>
                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascrip:;" onclick="SetActive(@item.EXAM_PHOTOCOPY_SETTING_ID,0)" class="text-success"><i class="fa fa-check"></i></a>             }
                                        else
                                        {
                                            <a href="javascrip:;" onclick="SetActive(@item.EXAM_PHOTOCOPY_SETTING_ID,1)" class="text-danger"><i class="fa fa-times"></i></a>
                                        }
                                    </td>

                                    <td>
                                        <a href="#EPSetting-dialog" onclick="FetchLiEPSettingById(@item.EXAM_PHOTOCOPY_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.EXAM_PHOTOCOPY_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="EPSetting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Exam Photo Copy Settings</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">


                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Exam Setting</label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.ExamList, (Model.ExamList != null) ? Model.ExamList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Application Type</label>

                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                        </div>

                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Maximum Papers</label>
                                        <div class="col-md-8">
                                            <input type="number" id="txtMaxPaper" class="form-control" placeholder="Maximum Papers" data-parsley-required="true">
                                        </div>

                                    </div>

                                    @*<div class="col-md-12 form-group">
                                            @Html.Label("Question Type", htmlAttributes: new { @class = "col-md-4 control-label " })
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(m => m.QuestionTypeList, (Model.QuestionTypeList != null) ? Model.QuestionTypeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                                @Html.ValidationMessageFor(m => m.QuestionTypeList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>*@
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Start Date</label>

                                        <div class="col-md-8">
                                            <div class="input-group date" id="StartDate">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtStartDate" class="form-control input-sm" placeholder="Select  Date" id="txtStartDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">End Date</label>

                                        <div class="col-md-8">
                                            <div class="input-group date" id="EndDate">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtEndDate" class="form-control input-sm" placeholder="Select  Date" id="txtEndDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="EPSettingId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        var tbl = $('#tblLiEPSetting').DataTable();

        handleDatepicker = function () {
            "use strict";


            $("#txtStartDate").datepicker({
                todayHighlight: true,
                autoclose: true,
              //  endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#txtEndDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();




        function FetchLiEPSettingById(ExamPhotocopyId)
        {
            $('#pBody').parsley().destroy();

            if (ExamPhotocopyId != null)
            {
                $.ajax({
                    url: "/Examination/FetchLiExamPhotoCopySettingById",
                    type:"post",
                    data: { sExamPhotocopySettingId: ExamPhotocopyId },
                    success:function(data)
                    {
                        if(data.Message!=null)
                        {
                            alert(data.Message);
                        }
                        else {
                            if (data.oResult[0] != null)
                            {
                                $('#EPSettingId').attr('value', data.oResult[0].EXAM_PHOTOCOPY_SETTING_ID);
                                $('#ExamList option[value="' + data.oResult[0].EXAM_SETTING_ID + '"]').attr("selected", "selected");
                                $('#ApplicationType option[value="' + data.oResult[0].APPLICATION_TYPE_ID + '"]').attr("selected", "selected");
                                $('#txtMaxPaper').attr('value', data.oResult[0].MAX_PAPER);
                                $('#txtStartDate').attr('value', data.oResult[0].START_DATE);
                                $('#txtEndDate').attr('value', data.oResult[0].END_DATE);

                                $('#ExamList').prop("disabled", "disabled");
                                $('#ApplicationType').prop("disabled", "disabled");
                                $('.selectpicker').selectpicker('refresh');
                            }


                        }

                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }

        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var PhotocopySetting = $('#EPSettingId').val();
            var ExamSettingId = $('#ExamList').val();
            var ApplicationType = $('#ApplicationType').val();
            var MaximumPapers = $('#txtMaxPaper').val();
            var DateFrom = $('#txtStartDate').val();
            var DateTo = $('#txtEndDate').val();
            //var AutoReneval;
            //if ($('#AutoReneval').is(":checked"))
            //{
            //     AutoReneval = 1;
            //}
            //else
            //{
            //    AutoReneval = 0;
            //}
            //var ExtraBook = $('#txtExtraBooks').val();


            var jsonData = '{"EXAM_PHOTOCOPY_SETTING_ID":"' + PhotocopySetting + '","EXAM_SETTING_ID":"' + ExamSettingId + '","APPLICATION_TYPE_ID":"' + ApplicationType + '","MAX_PAPER":"' + MaximumPapers + '","START_DATE":"' + DateFrom + '","END_DATE":"' + DateTo + '"}';


              var req=  $.ajax({
                  url: "/Examination/SaveorUpdateExaminationPhotoCopySetting",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "" && data.ErrorCode != "" && data.ErrorCode!=null)
                        {

                                if (data.ErrorCode=="201")
                                {
                                    swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                                }
                                if (data.ErrorCode == "200") {
                                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                    loadContent('/Examination/ListPhotoCopySetting');
                                }
                                if (data.ErrorCode == "304") {
                                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                                }
                        }
                        else {
                            swal({ title: "Info", text: "Something went wrong so please try again!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

              });
              @*req.done(function (response) {
                  var item = @Html.Raw(Json.Encode(Model.liRules));
                  alert(item[0].MAX_BOOKS);
                  tbl.rows().remove().draw();
                  for(var i=0;i<item.length;i++)
                  {

                         //alert(item[i].MAX_BOOKS);
                         var result=[];
                         result.push(i);
                         result.push(item[i].CATEGORY_NAME);
                         result.push(item[i].MAX_BOOKS);
                         result.push(item[i].LOAN_PERIOD);
                         result.push(item[i].FINE_AMOUNT);
                         result.push(item[i].DEPOSIT);
                         result.push(item[i].AUTORENEVAL);
                         result.push(item[i].EXTRA_BOOKS);
                         result.push(item[i].EXTRA_BOOKS);

                  }
                  tbl.rows.add(result);
                  tbl.draw();
              });*@


        });


    function SetActive(ExamPhotocopySettingId, Mode)
    {
        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "/Examination/ActivateorDeactivateExamPhotoCopySettingBySettingId",
                type: "post",
                data: { sExamPhotocopySettingId: ExamPhotocopySettingId, sMode: Mode },
                success: function (data) {
                    if (data.Message != null && data.Message != "") {

                        if (data.ErrorCode == "201") {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadContent('/Examination/ListPhotoCopySetting');
                        }
                        if (data.ErrorCode == "304") {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }

                     
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }

            });
        });

    }


    GetConfirm = function (ExamPhotocopySettingId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            var req = $.ajax({
                url: "/Examination/DeleteLiExamPhotoCopySettingById",
                type: "post",
                data: { sExaMPhotocopySettingId: ExamPhotocopySettingId },
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Examination/ListPhotoCopySetting');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

        req.done(function (response) {
            tbl.rows().remove().draw();
            tbl.rows.add(response).draw();
        });
        }

        $('#Add').click(function () {


            $('#ExamList').prop("disabled",false);
            $('#ApplicationType').prop("disabled",false);
            $('#pBody').parsley().destroy();
            $('#ExamList option[value=""]').attr("selected", "selected");
            $('#ApplicationType option[value=""]').attr("selected", "selected");
            $('#txtMaxPaper').attr('value', '');
            $('#txtStartDate').attr('value','');
            $('#txtEndDate').attr('value', '');

            $('#ERSettingId').attr('value', '');

            $('.selectpicker').selectpicker('refresh');
        });




        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
        }
</script>






