@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{Layout = null; int count = 0;}

@if (Model.liEXAM_EVALUATION_STUDENT_MARK != null && Model.liEXAM_EVALUATION_STUDENT_MARK.Count > 0)
{
    if (Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().PROGRAMME_LEVEL_ID == "1" || (Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().PROGRAMME_LEVEL_ID == "2" && Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().IS_EXTERNAL_INTERNAL == "0"))
    {
        <table class="table table-hover table-bordered" id="tblEvStudentMark">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Register No</th>
                    <th>Evaluation Mark</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.liEXAM_EVALUATION_STUDENT_MARK)
                {
                    <tr cms-evmarkid="@item.EXAM_EV_STU_MARK_ID" cms-studentId="@item.STUDENT_ID" cms-IsExternal="@item.IS_EXTERNAL_INTERNAL" cms-programmeLevel="@item.PROGRAMME_LEVEL_ID">
                        <td>
                            @{ count++;}@count
                        </td>
                        <td>@item.REGISTER_NO</td>
                        <td>
                            <input type="text" class="form-control input-sm" style="width:75px !important;" value="@item.EVALUATION_1" cms-max="@item.MAX_MARK" maxlength="3" onfocusout="Validate()" cms-studentsId="@item.STUDENT_ID" onkeypress="NumberValidate(this)" />
                        </td>
                    </tr>
                                }
            </tbody>
        </table>
                                }
                                else
                                {
                                    <table class="table table-hover table-bordered" id="tblEvStudentMark">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Register No</th>
                                                <th>Evaluation Mark</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.liEXAM_EVALUATION_STUDENT_MARK)
                                            {
                                                <tr cms-evmarkid="@item.EXAM_EV_STU_MARK_ID" cms-studentId="@item.STUDENT_ID" cms-IsExternal="@item.IS_EXTERNAL_INTERNAL" cms-programmeLevel="@item.PROGRAMME_LEVEL_ID">
                                                    <td>
                                                        @{ count++;}@count
                                                    </td>
                                                    <td>@item.REGISTER_NO</td>
                                                    <td>
                                                        <input type="text" class="form-control input-sm" style="width:75px !important;" value="@item.EVALUATION_2" maxlength="3" cms-max="@item.MAX_MARK" onfocusout="Validate()" cms-studentsId="@item.STUDENT_ID" onkeypress="NumberValidate(this)" />
                                                    </td>
                                                </tr>
                                                            }
                                        </tbody>
                                    </table>
                                                                }

                                                            }
                                                            else
                                                            {
                                                                <div class="alert alert-info">
                                                                    <strong>Info!</strong> Date is not valid to enter Mark...!
                                                                </div>
                                                            }

<script>
    $('#tblEvStudentMark').keydown(function (e) {
        var $table = $(this);
        var $active = $('input:focus,select:focus', $table);
        var $next = null;
        var focusableQuery = 'input:visible,select:visible,textarea:visible';
        var position = parseInt($active.closest('td').index()) + 1;
        console.log('position :', position);
        switch (e.keyCode) {
            case 37: // <Left>
                $next = $active.parent('td').prev().find(focusableQuery);
                break;
            case 38: // <Up>
                $next = $active
                    .closest('tr')
                    .prev()
                    .find('td:nth-child(' + position + ')')
                    .find(focusableQuery)
                ;

                break;
            case 39: // <Right>
                $next = $active.closest('td').next().find(focusableQuery);
                break;
            case 40: // <Down>
                $next = $active
                    .closest('tr')
                    .next()
                    .find('td:nth-child(' + position + ')')
                    .find(focusableQuery)
                ;
            case 13: // <Down>
                $next = $active
                    .closest('tr')
                    .next()
                    .find('td:nth-child(' + position + ')')
                    .find(focusableQuery)
                ;
                break;
        }
        if ($next && $next.length) {
            $next.focus();
        }
    });
</script>