@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ListExamTimeTable";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}



    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Exam TimeTable</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam TimeTable<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam TimeTable</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        
                        <div class="col-md-6">
                            @Html.Label("Programme List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(),"-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="col-md-2">
                            <a class="pull-right btn btn-success" href="javascript:;" onclick="loadContent('/Examination/ExamTimeTable')"><i class="fa fa-plus"></i> Add/Edit</a>
                        </div>

                        <div class="col-md-2">
                            <a class="pull-right btn btn-success hidden" href="javascript:;" id="btnPrint"><i class="fa fa-plus"></i> PDF</a>
                        </div>
                        <div class="col-md-2">
                            <a class="pull-right btn btn-success hidden" href="javascript:;" id="btnExport" ><i class="fa fa-plus"></i> Export</a>
                        </div>

                    </div>

                    <div class="form-group col-md-12" id="dvCIAbind"></div>
                </div>
                
            }
            
        </div>

    </div>
</div>
<!-- end #content -->


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');


        $('#ProgrammeList').on('change', function ()
        {
            LoadTimeTable();
        });


        function LoadTimeTable()
        {
            var inp = $('#ProgrammeList').val();
            $.ajax({
                url: "@Url.Action("BindExamTimeTable", "Examination")",
                async: false,
                data: { sProgrammeGroupId: inp },
                success: function (data)
                {
                    $('#dvCIAbind').empty();
                    
                    if (data.Message!=null && data.Message!='')
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    } else
                    {
                        $('#btnExport').removeClass('hidden');
                        $('#btnPrint').removeClass('hidden');
                        
                        $('#dvCIAbind').append(data);
                        $("#ciaMarkList").DataTable({ "bPaginate": false });
                        $("#ciaMarkList_filter").addClass("dataTables_filter pull-right");
                        $(".pagination").addClass("pagination pull-right");
                    }
                },
                error: function (xhr, textStatus, error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }

            });
        }

        $('#btnExport').live('click', function () {
            var sProgramme = $('#ProgrammeList Option:selected').text();
            let file = new Blob([$('#dvCIAbind').html()], { type: "application/vnd.ms-excel" });
            let url = URL.createObjectURL(file);
            let a = $("<a />", {
                href: url,
                download: sProgramme + "_ExamTimetable.xls"
            }).appendTo("body").get(0).click();
            e.preventDefault();
        });


        $('#btnPrint').on('click', function ()
        {
            $('.clsAction').addClass('hidden');
            var printContents = document.getElementById('dvCIAbind').innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;

            window.print();

            document.body.innerHTML = originalContents;
            loadContent('/Examination/ListExamTimeTable');
        });

        function GetConfrim(sTimeTableId)
        {
            
            swal({
                title: "Are you sure to delete ?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-success",
                confirmButtonText: "Yes, I Agree!",
                closeOnConfirm: false
            },
            function () {
                $.ajax({
                    url: "@Url.Action("DeleteExamTimeTable", "Examination")",
                    async: false,
                    data: { sExamTimeTableId: sTimeTableId },
                    success: function (data) {
                        if (data.ErrorCode == '200') {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                            LoadTimeTable();
                        } else {
                            swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                        }
                    },
                    error: function (xhr, textStatus, error) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            });
        }
    </script>



