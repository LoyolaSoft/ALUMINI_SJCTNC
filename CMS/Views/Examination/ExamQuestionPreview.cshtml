@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ExamQuestionPreview";
    Layout = null;
}

<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<style>
    .table-bordered 
    {
       
        padding: 32px !important;
    }
</style>
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Question Preview</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Question Preview</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Question Preview</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-3 form-group">
                                    @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Set, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                               
                            </div>
                            <br><br><br><br>
                            @*<div class="col-md-12">
                               
                             
                                <div class="col-md-1 form-group pull-right">
                                    <a class="btn btn-primary" id="btnGet"> Get </a>
                                </div>
                            </div>*@
                            
                            <div class="" id="printdiv">
                               
                                <div class="col-md-12 hidden" id="coursedetailsdiv">
                                                                       
                                            <div class="form-group col-md-4">
                                                <label> Exam :<span id="exam"></span></label>
                                            </div>
                                            <div class="form-group col-md-4">
                                                <label> Course : <span id="course"></span></label>
                                            </div>
                                            <div class="form-group col-md-4">
                                                <label> Set : <span id="set"></span></label>
                                            </div>
                                                                       
                                </div>
                            <div class="col-md-12" id="bindexamquestionspreview">
                            </div>
                           
                        </div>
                           
                            <div class="col-md-12 hidden" id="btnprint"> 
                                <br>
                                <div class="form-group col-md-1 pull-right">
                                                               
                                    <a href="javascript:;" id="sPrint" onclick="printDiv('printdiv')" class="btn btn-success  m-b-10">Print</a>
                                </div>
                            </div>

                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>




<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');

    $("#Semester").on("change", function ()
    {
        if ($(this).val())
        {
            $.ajax({
                url: "@Url.Action("FetchCourseSemester", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sSemster: $(this).val() },
            success: function (data)
            {
                $("#CourseList").empty();
                $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Select the Fields ...!')
    }
    });

    $('#Set').on('change', function ()
    {

        if ($('#ExamSetting').val() && $('#CourseList').val() && $('#Set').val())
        {
            $('#course').text($("#CourseList option:selected").text());
            $('#exam').text($("#ExamSetting option:selected").text());
            $('#set').text($("#Set option:selected").text());

            $.ajax({
                url: "@Url.Action("BindQuestionPreview", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamsettingId: $('#ExamSetting').val(), sCourse: $('#CourseList').val(), sSet: $('#Set').val() },
            success: function (data)
            {
                $('#bindexamquestionspreview').empty();
                $('#bindexamquestionspreview').append(data);
                $('#btnprint').removeClass('hidden');
                $('#coursedetailsdiv').removeClass('hidden')
                

            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Choose All Fields .....!');
    }
    });
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
       
    }
</script>