@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ 
    Layout = null;
    int count = 0;
}

<div class="col-md-12">
 
        <table class="table table-bordered" id="tblevaluationmark">
            <thead>
                <tr>
                <th>#</th>
                    <th>Name</th>
                    <th>Roll No</th>
                    <th>Register No</th>
                    <th>Course</th>
                    <th>Secured</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
               @if (Model.LiExamEvaluationMark != null && Model.LiExamEvaluationMark.Count > 0)
               {
                   foreach (var item in Model.LiExamEvaluationMark)
                   {
                       count++;
                   <tr>
                       <td>@count</td>
                       <td>@item.FIRST_NAME</td>
                       <td>@item.ROLL_NO</td>
                       <td>@item.REGISTER_NO</td>
                       <td>@item.COURSE_CODE</td>
                       <td>@item.SECURED_MARK</td>
                       <td>@item.TOTAL_MARK</td>


                   </tr>
                   }
               }
            </tbody>
        </table>
  
</div>