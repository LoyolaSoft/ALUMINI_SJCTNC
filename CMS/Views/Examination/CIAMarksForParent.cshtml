@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">CIA Mark Details</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Mark Details<small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title"> CIA Mark Details </h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-group table-responsive">
                @if (Model.liCIA_Marks_Info != null && Model.liCIA_Marks_Info.Count > 0)
                {
                    if (Model.liStudentList != null && Model.liStudentList.Count > 0)
                    {
                        int Count = 0;
                        foreach (var stuitem in Model.liStudentList)
                        {
                            var liGroupSemester = Model.liCIA_Marks_Info.Where(x => x.STUDENT_ID == stuitem.STUDENT_ID).GroupBy(x => x.SEMESTER_ID).ToList();
                            <div class="form-group panel-group" id="accordion">
                                <div class="panel panel-info overflow-hidden">
                                    <div class="panel-heading">
                                        <h3 class="panel-title">
                                            <a class="accordion-toggle accordion-toggle-styled collapsed" data-toggle="collapse" data-parent="#accordion" href="#@stuitem.STUDENT_ID" aria-expanded="true">
                                                <i class="fa fa-plus-circle pull-right"></i>
                                                @{Count++;} @Count . @stuitem.FIRST_NAME ( @stuitem.ROLL_NO )
                                            </a>
                                        </h3>
                                    </div>
                                    <div id="@stuitem.STUDENT_ID" class="panel-collapse collapse form-group">
                                        <div class="panel-body">
                                            <div class="form-group">
                                                <div class="col-md-3">
                                                    Roll No : <b> @stuitem.ROLL_NO </b>
                                                </div>
                                                <div class="col-md-3">
                                                    Register No : <b> @stuitem.REGISTER_NO </b>
                                                </div>
                                                <div class="col-md-3">
                                                    Name : <b> @stuitem.FIRST_NAME </b>
                                                </div>
                                                <div class="col-md-3">
                                                    Class : <b> @stuitem.CLASS_NAME </b>
                                                </div>
                                            </div> <br /><br />
                                            @{
                                                foreach (var GroupSemesteritem in liGroupSemester)
                                                {
                                                    var liCourse = Model.liExamRegistrationList.Where(x => x.STUDENT_ID == stuitem.STUDENT_ID && x.SEMESTER_ID == GroupSemesteritem.FirstOrDefault().SEMESTER_ID).ToList();
                                                    var liGroupComponent = Model.liCIA_Marks_Info.Where(x => x.STUDENT_ID == stuitem.STUDENT_ID && x.SEMESTER_ID == GroupSemesteritem.FirstOrDefault().SEMESTER_ID).GroupBy(x => x.COURSE_GROUP_ID).ToList();
                                                    <h4 class="text-center">CIA Exam Result For Sem - @GroupSemesteritem.FirstOrDefault().SEMESTER_ID</h4>
                                                    <table class="table table-bordered table-hover">
                                                        <thead>
                                                            <tr>
                                                                <th></th>
                                                                @if (liCourse != null && liCourse.Count > 0)
                                                                {
                                                                    foreach (var item in liCourse)
                                                                    {
                                                                        <th>@item.COURSE_CODE</th>
                                                                    }
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Model.liExamRegistrationList != null && Model.liExamRegistrationList.Count > 0)
                                                            {
                                                                foreach (var item in liGroupComponent)
                                                                {
                                                                    <tr>
                                                                        <td>@item.FirstOrDefault().COMPONENT</td>
                                                                        @{
                                                                            foreach (var Examitem in liCourse)
                                                                            {
                                                                                var liCIAMarks = Model.liCIA_Marks_Info.Where(x => x.COURSE_ID == Examitem.COURSE_ID && x.COMPONENT_ID == item.FirstOrDefault().COMPONENT_ID && x.STUDENT_ID == stuitem.STUDENT_ID).ToList();
                                                                                if (liCIAMarks != null && liCIAMarks.Count > 0)
                                                                                {
                                                                                    if (liCIAMarks.FirstOrDefault().COURSE_GROUP_MARK == "-1")
                                                                                    {
                                                                                        liCIAMarks.FirstOrDefault().COURSE_GROUP_MARK = "A";
                                                                                    }
                                                                                    <td>@liCIAMarks.FirstOrDefault().COURSE_GROUP_MARK</td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td> - </td>
                                                                                }
                                                                            }
                                                                        }
                                                                    </tr>
                                                                            }
                                                                            <tr>
                                                                                <td><b>Total</b></td>
                                                                                @if (Model.liCIA_Total != null && Model.liCIA_Total.Count > 0)
                                                                                {
                                                                                    foreach (var Examitem in liCourse)
                                                                                    {
                                                                                        var liCIAMarks = Model.liCIA_Total.Where(x => x.COURSE_ID == Examitem.COURSE_ID && x.STUDENT_ID == stuitem.STUDENT_ID).ToList();
                                                                                        if (liCIAMarks != null && liCIAMarks.Count > 0)
                                                                                        {
                                                                                            if (liCIAMarks.FirstOrDefault().TOTAL == "-1")
                                                                                            {
                                                                                                <td><b>A</b></td>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <td><b>@liCIAMarks.FirstOrDefault().TOTAL</b></td>
                                                                                            }
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <td></td>
                                                                                        }
                                                                                    }
                                                                                }
                                                                            </tr>
                                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            }
                        }
                    }
            </div>
        </div>
    </div>
</div>




