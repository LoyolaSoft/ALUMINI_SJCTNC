
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "QuizStudentMarkListForStaff";
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">QuizStudentMarkListForStaff</li>
    </ol>
    <h1 class="page-header">Quiz Student Mark </h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Quiz Student Mark</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group col-md-3">
                        @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dClass" })
                            @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.CourseList, "Course", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(model => model.CourseList, (Model.Shift != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dCourse" })
                            @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-3">
                        @Html.LabelFor(model => model.QuizSetting, "Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownListFor(model => model.QuizSetting, (Model.Batch != null) ? Model.QuizSetting : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dSetting" })
                            @Html.ValidationMessageFor(model => model.QuizSetting, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-1">
                        <div class="col-md-12">
                            <a class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                       
                    </div>
                    <div class="form-group col-md-1">
                        <div class="col-md-12">
                            <a class="btn btn-success hidden" id="btnPrint" onclick="printDiv('divBind')">Print</a>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="form-group col-md-12" id="divBind">

            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    ContentLoad = function () {
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }
    $("#dClass").on("change", function () {
        var Class = $("#dClass").val();
        $.ajax({
            url: "@Url.Action("FethCourseByClassId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { Class_Id: Class },
            success: function (data) {
                $("#dCourse").empty();
                $("#dCourse").append('<option value=""> -- Select -- </option>' + data);

                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    });

    $("#dCourse").on("change", function () {
        if ($('#dClass').val() && $('#dCourse').val())
        {
            $.ajax({
                url: "@Url.Action("FethSettingByClassandCourse", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sClassId: $('#dClass').val(), sCourseId: $('#dCourse').val() },
            success: function (data) {
                $("#dSetting").empty();
                $("#dSetting").append('<option value=""> -- Select -- </option>' + data);

                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
        }
        
    });


    $('#btnGet').click( function () {

        if ($('#dClass').val() && $('#dCourse').val() && $('#dSetting').val())
        {
            $.ajax({
                  url:"@Url.Action("BindQuizStudentMarkListForStaff", "Examination")",
                type: "post",
                data: { sClassId: $('#dClass').val(), sCourseId: $('#dCourse').val(), sSettingId: $('#dSetting').val() },
                success:function(data)
                  {
                      if(data.Message!=null && data.Message!='')
                      {
                          alert(data.Message)
                      }
                      else {

                          $('#divBind').html('');
                          $('#divBind').append(data);
                          $('#btnPrint').removeClass("hidden");
                          $('#lblSettingName').text($('#dSetting option:selected').text());
                      }
                  },
                  error:function(ex)
                  {

                  }


            });
        }
        else {
            alert("Pleas Select All the fields")
       //     $('#btnPrint').addClass("hidden");
        }
    });



    function printDiv(sDivName) {
        var table = $('#tblQuizMarkList').DataTable();
        table.destroy(); 
        var printContents = document.getElementById(sDivName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        $('#tblQuizMarkList').DataTable({
            "paging": false
        });
        loadContent('/Examination/QuizStudentMarkListForStaff');
    }


</script>









