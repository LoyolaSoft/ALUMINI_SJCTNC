@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;

@{
    Layout = null;
}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List Course Approval</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Course Approval<small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">List Course Approval </h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-group table-responsive">
                <div class="col-md-12 pull-right">
                    <a href="javascript:;"  class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
                </div>
                <br /><br />
                <table class="table table-bordered table-hover" id="tblCourseApproval">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Select</th>
                            <th>Course Code</th>
                            <th>Course Title</th>
                            <th>Part</th>
                            <th>Program Level</th>
                            <th>Derpartment </th>
                            <th>Semester</th>
                            <th>Subject Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liCourseApproval != null && Model.liCourseApproval.Count > 0)
                        {
                            int nCount = 0; string sDisabled=string.Empty;
                            foreach (var item in Model.liCourseApproval)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>
                                        <div class="checkbox checkbox-css">
                                            <input type="checkbox" id="chCourse_@nCount" name="chCourse_@nCount" cms-ApprovalId="@item.COURSE_APPROVAL_ID" @if (item.IS_APPROVED == "1") { sDisabled = "disabled"; } else { sDisabled = string.Empty; } @sDisabled/>
                                            <label for="chCourse_@nCount"></label>
                                        </div>
                                    </td>
                                    <td>@item.COURSE_CODE</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.PART</td>
                                    <td>@item.PROGRAMME_LEVEL</td>
                                    <td>@item.DEPARTMENT</td>
                                    <td>@item.SEMESTER_ID</td>
                                    <td>@item.SUBJECT_TYPE</td>
                                    <td>
                                        <a href="#modal-dialog" data-toggle="modal" class="text-primary" onclick="FetchRecordById(@item.COURSE_APPROVAL_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfrim(@item.COURSE_APPROVAL_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>

                @if (Model.liCourseApproval != null && Model.liCourseApproval.Count > 0)
                {
                    <div class="col-md-12 pull-right">
                        <a href="javascript:;" class="btn btn-primary pull-right" id="btnSubmit" onclick="SubmitData()"><i class="fa fa-plus"></i> Submit</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<input type="hidden" id="hdCourseApprovalId" />


<script>

    
    function ContentLoad()
    {
        // Document. Ready Function ...,
    }
   

    function GetConfrim(Id)
    {
        if (!confrim('Are you sure to delete ?'))
        {
            return false;
        }
        $.ajax({
            url: '/Examination/DeleteCourseApproval',
            method: 'POST',
            datatype: 'json',
            data: { sCourseApprovalId: Id },
            success: function (data)
            {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/Examination/CourseApprovalList');
                } else {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script> 


<script>
    function SubmitData()
    {
        var nCount = 0;
        var sCourseApprovalIds = '';
        $('#tblCourseApproval tbody tr').each(function ()
        {
            $(this).find('td').each(function ()
            {
                var chkBox = $(this).find('input[type="checkbox"]');
                if (chkBox.is(':checked'))
                {
                    nCount = nCount + 1;
                    sCourseApprovalIds += chkBox.attr('cms-ApprovalId') + ',';
                }
            });
        });

        if (nCount == 0)
        {
            swal({ title: "Warning !", text: "No Course Selected For Approval !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
        } else
        {
            sCourseApprovalIds = sCourseApprovalIds.slice(0, -1);
            $.ajax({
                url: '/Examination/MoveToCourseRoot',
                method:'POST',
                datatype:'json',
                data: { sCourseApprovalId: sCourseApprovalIds },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadContent('/Examination/CourseApprovalList');
                    } else
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            })
        }
    }
</script>