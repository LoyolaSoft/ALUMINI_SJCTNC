
@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ODFormForExaminars";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />

<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">Examinar OD Form</li>
        </ol>
        <h2 class="page-header">Examinar OD Form</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Examinar OD Form</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Programme, "Major", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Programme, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ResultMonth, "Result Month", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ResultMonth, (Model.ResultMonth != null) ? Model.ResultMonth : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ResultMonth, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.Label("Role", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <select class="selectpicker form-control" id="ddlexaminartype">
                                    <option value="0"> -- Select -- </option>
                                    <option value="1">Question Setter</option>
                                    <option value="2">Examinar</option>
                                    <option value="3">Practical</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-3">
                            @Html.Label("Search By", htmlAttributes: new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                <select class="selectpicker form-control" id="ddlexaminarIdorDate">
                                    <option value="0"> -- Select -- </option>
                                    <option value="1">Date</option>
                                    <option value="2">Examinar</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 hidden" id="fdate">
                            <label class="col-md-4 control-label">Date</label>
                            <div class="col-md-8">
                                <div class="input-group date hidden" id="FromDate">
                                    <input type="text" name="Date" class="form-control input-sm" placeholder="Select  Date" id="txtFromDate" data-parsley-required="true" />
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-4 hidden" id="tdate">
                            <label class="col-md-4 control-label">Date</label>
                            <div class="col-md-8">
                                <div class="input-group date hidden" id="ToDate">
                                    <input type="text" name="Date" class="form-control input-sm" placeholder="Select  Date" id="txtToDate" data-parsley-required="true" />
                                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group hidden col-md-4" id="liExaminarr">
                            @Html.LabelFor(model => model.liExaminar, "Examinar", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.liExaminar, (Model.liExaminar != null) ? Model.liExaminar : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.liExaminar, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-2">
                            <a href="#" id="BtnGet" class="btn btn-primary m-b-20 pull-right">Get</a>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.LiExaminars, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.LiExaminars, (Model.LiExaminars != null) ? Model.LiExaminars : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", data_actions_box = "true" })
                                @Html.ValidationMessageFor(model => model.LiExaminars, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-2">
                            <a href="#" id="btnGet" class="btn btn-primary  m-b-20 ">Get</a>
                        </div>
                        <div class="form-group col-md-2">
                            <a href="#" id="btnPrint" onclick="printDiv('divBindExaminar')" class="btn btn-success m-b-20">Print</a>
                        </div>
                    </div>
                    <div class="col-md-12 m-b-5">
                        <div id="divBindExaminar" class="table-responsive">
                            <!--Need to use this field to bind Course Structure-->
                        </div>
                    </div>

                </div>

            </div>
        </div>
    }
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>

<script>
        function ContentLoad() {
            // Document Ready Function .
            handleDatepicker();
    }

    handleDatepicker();
        $('.selectpicker').selectpicker({
            size: 4
        });

    $('.selectpicker').selectpicker('refresh');
    function handleDatepicker() {
        "use strict";
        // $("#datepicker-autoClose").datepicker({todayHighlight:!0,autoclose:!0})}
        $("#txtFromDate,#txtToDate").datepicker({
            todayHighlight: !0,
            autoclose: !0,
           // endDate: new Date,
            format: "yyyy-mm-dd",
            orientation: "left"
            // 'top': top,
            // 'left': left
        });
    }
    $('#ddlexaminartype').on('change', function () {
        var roles = $('#ddlexaminartype').val();
        if (roles != "" && roles != null && $('#Programme').val() != "" && $('#Programme').val() != null) {
            $.ajax({
                url: "@Url.Action("FetchsmcExaminarByprogrammeandRole", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sRoles: roles, sProgramme: $('#Programme').val(), sExamsetting: $('#ResultMonth').val()},
                success: function (data) {
                    $("#liExaminar").empty();
                    $("#liExaminar").append('<option value="">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    });

    $('#ddlexaminarIdorDate').on('change', function () {
        var roles = $('#ddlexaminarIdorDate').val();
        if (roles == "1") {
            $('#FromDate').removeClass('hidden');
            $('#fdate').removeClass('hidden');
            $('#tdate').removeClass('hidden');
            $('#ToDate').removeClass('hidden');
            $('#liExaminarr').addClass('hidden');
        }
        else {
            $('#FromDate').addClass('hidden');
            $('#fdate').addClass('hidden');
            $('#tdate').addClass('hidden');
            $('#ToDate').addClass('hidden');
            $('#liExaminarr').removeClass('hidden');
        }
    });
    $('#btnGet').on('click', function () {
        BindExaminarDetails();
    });
    $('#BtnGet').on('click', function () {
        BindExaminar();
    });
    function BindExaminar(){
        var fromdate = $('#txtFromDate').val();
        var todate = $('#txtToDate').val();
       var  Programme= $('#Programme').val();
        var ResultMonth = $('#ResultMonth').val();
        var Roles = $('#ddlexaminartype').val();
        var Fetchtype = $('#ddlexaminarIdorDate').val();
        var liExaminar = $('#liExaminar').val();
        var Role = "";
        if (Roles == "1"){
            Role = 1;
        }
        else if (Roles == "2") {
            Role = 2
        }
        else {
            Role = 3
        }
        if (Role != "") {
            if ($('#Programme').val()) {
                $.ajax({
                    url: "@Url.Action("FetchExaminarODForm", "Examination")",
                    method: "POST",
                    datatype: "json",
                    data: { sProgramme: Programme, sFromDate: fromdate, sToDate: todate, sRole: Role, sResultMonth: ResultMonth, sExaminarId: liExaminar, Fetchtype: Fetchtype},
                    success: function (data) {
                        $("#LiExaminars").empty();
                        $("#LiExaminars").append('<option value="">-- select --</option>' + data);
                        $('.selectpicker').selectpicker('refresh');
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }
            else {
                alert("Select Examinar Type");
            }
        }
    }
    function BindExaminarDetails()
    {
        if ($('#Programme').val()) {
            $.ajax({
                url: "@Url.Action("BindExaminarODForm", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sExaminarId: $('#LiExaminars').val()},
                success: function (data) {
                    $("#divBindExaminar").empty();
                    $("#divBindExaminar").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    }

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        window.close();
        loadContent('/Examination/ODFormForExaminars');
    }
</script>
