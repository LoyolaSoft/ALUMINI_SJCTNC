@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ Layout = null;
    int counts = Model.liEXAM_EVALUATION_STUDENT_MARK.Count() / 5;
    int tempcounts = 0;
}

<div>
    @if (Model.liEXAM_EVALUATION_STUDENT_MARK != null && Model.liEXAM_EVALUATION_STUDENT_MARK.Count > 0)
    {    <table>
        @for (int i = 0; i < counts; i++)
        {
            tempcounts = i;
            <tr>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="4%" height="100">
                    @Model.liEXAM_EVALUATION_STUDENT_MARK.ElementAt(tempcounts).REGISTER_NO
                    @{ tempcounts = tempcounts + counts;}
                </td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"></td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="4%" height="100">
                    @Model.liEXAM_EVALUATION_STUDENT_MARK.ElementAt(tempcounts).REGISTER_NO
                    @{ tempcounts = tempcounts + counts;}
                </td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"></td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="4%" height="100">
                    @Model.liEXAM_EVALUATION_STUDENT_MARK.ElementAt(tempcounts).REGISTER_NO
                    @{ tempcounts = tempcounts + counts;}
                </td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"></td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="4%" height="100">
                    @Model.liEXAM_EVALUATION_STUDENT_MARK.ElementAt(tempcounts).REGISTER_NO
                    @{ tempcounts = tempcounts + counts;}
                </td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"></td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="4%" height="100">
                    @Model.liEXAM_EVALUATION_STUDENT_MARK.ElementAt(tempcounts).REGISTER_NO
                </td>
                <td style="border:1px solid ;padding-left:5px;" align="center" width="2%" height="100"></td>

            </tr>
                        }



    </table>
                        }
</div>