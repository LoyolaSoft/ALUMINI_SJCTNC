<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List Exam Setting</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Exam Setting<small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">List Exam Setting </h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 pull-right">
                <a href="#modal-dialog" data-toggle="modal" id="Add" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
            </div>
            <br /><br />
            <div class="col-md-12 form-group table-responsive">

                <table class="table table-bordered table-hover" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Exam Name</th>
                            <th>Pass Month</th>
                            <th>Exam Type</th>
                            <th>Semester Type</th>
                            <th>Year</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Last Date For Payment</th>
                            <th>Hall Ticket Publication Date</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liExamSetting != null && Model.liExamSetting.Count > 0)
                        {
                            int nCount = 0;
                            foreach (var item in Model.liExamSetting)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.EXAM_NAME</td>
                                    <td>@item.M_PASS</td>
                                    <td>@item.EXAM_TYPE</td>
                                    <td>@item.SEMESTER_TYPE</td>
                                    <td>@item.ACADEMIC_YEAR</td>
                                    <td>@item.START_DATE</td>
                                    <td>@item.END_DATE</td>
                                    <td>@item.LAST_DATE_FOR_EXAM_FEE</td>
                                    <td>@item.HALL_TICKET_PUBLICATION_DATE</td>
                                    <td>
                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a class="text-success" onclick="UpdateActiveExamSetting('@item.EXAM_SETTING_ID','0')"><i class="fa fa-check"></i></a>
                                        }
                                        else
                                        {
                                            <a class="text-danger" onclick="UpdateActiveExamSetting('@item.EXAM_SETTING_ID','1')"><i class="fa fa-times"></i></a>
                                        }
                                    </td>
                                    <td>
                                        <a href="#modal-dialog" data-toggle="modal" class="text-primary" onclick="FetchExamSettingById(@item.EXAM_SETTING_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfirm(@item.EXAM_SETTING_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<div class="modal" id="modal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="exam">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <input type="hidden" id="hdRoomId" />
                            <div class="form-group">
                                <label class="control-label col-md-3">Ac Year</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })

                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Name</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtExamSetting" class="form-control" />
                                </div>
                            </div>


                            <div class="form-group">
                                <label class="control-label col-md-3">Pass Month</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtPassMonth" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Semester Type</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.SessionType, (Model.SessionType != null) ? Model.SessionType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", id = "ddlSemesterType", @data_parsley_required = "true" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Type</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Start Date</label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        <input type="text" name="name" id="txtStartDate" class="form-control date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">End Date</label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        <input type="text" name="name" id="txtEndDate" class="form-control date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Last Date For Exam Fee</label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        <input type="text" name="name" id="txtLastDateForExamFee" class="form-control date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Hall Ticket Publication Date</label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        <input type="text" name="name" id="txtHallTicketPublicationDate" class="form-control date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                <div class="col-md-8">
                                    <input type="checkbox" id="chIsActive" /> &nbsp; &nbsp; IsActive
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" onclick="SaveExamSetting()" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>




