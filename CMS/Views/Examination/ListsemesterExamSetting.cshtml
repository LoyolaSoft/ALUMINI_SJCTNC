    <script>

        $(document).ready(function () {
            // ✅ Initialize DataTable
            $('#tblcer').DataTable({});
            //add
        });

    function ContentLoad() {
        // Document. Ready Function ...,
    }

    handleDatepicker = function () {
        "use strict";
        // $("#datepicker-autoClose").datepicker({todayHighlight:!0,autoclose:!0})}
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
          //  endDate: new Date,
            format: "dd/mm/yyyy",
            //format: "yyyy/mm/dd",
            orientation: "left"
            // 'top': top,
            // 'left': left
        });
    }
    handleDatepicker();

    $('.selectpicker').selectpicker({ size: 6 });
    $('.selectpicker').selectpicker('refresh');

    function FetchExamSettingById(Id) {
        $.ajax({
            url: '/Examination/FetchExamInfoById',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: Id },
            success: function (data) {
                $('#hdExamSettingId').val(data[0].EXAM_SETTING_ID);
                //$('#AcademicYearList').val(data[0].ACADEMIC_YEAR);
                $('#AcademicYearList option[value="' + data[0].ACADEMIC_YEAR + '"]').attr("selected", "selected");

                $('#txtExamSetting').val(data[0].EXAM_NAME);

                $('#txtPassMonth').val(data[0].M_PASS);
                //$('#ddlSemesterType').val(data[0].SEMESTER_TYPE);
                $('#ddlSemesterType option[value="' + data[0].SEMESTER_TYPE + '"]').attr("selected", "selected");

                //$('#ExamType').val(data[0].EXAM_TYPE);
                $('#ExamType option[value="' + data[0].EXAM_TYPE + '"]').attr("selected", "selected");

                $('#txtStartDate').val(data[0].START_DATE);
                $('#txtEndDate').val(data[0].END_DATE);
                $('#txtLastDateForExamFee').val(data[0].LAST_DATE_FOR_EXAM_FEE);
                $('#txtHallTicketPublicationDate').val(data[0].HALL_TICKET_PUBLICATION_DATE);
                $('.selectpicker').selectpicker('refresh');
                if (data[0].IS_ACTIVE == 1) {
                    $("#chIsActive").prop("checked", true);
                } else {
                    $("#chIsActive").prop("checked", false);
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }

    function GetConfirm(ID)
    {
   swal({
       title: "Are you sure want to Delete..?",
       type: "warning",
       showCancelButton: true,
       confirmButtonClass: "btn-danger",
       confirmButtonText: "Yes, I agree!",
       closeOnConfirm: false
   }, function () {
       $.ajax({
           url: "@Url.Action("DeleteExamSetting", "Examination")",
           type: "post",
           data: { sExamSettingId: ID },
           success: function (data) {
               if (data.ErrorCode != null && data.ErrorCode == "402") {
                   swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
               } else {
                   swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
               }
               loadContent('/Examination/ListsemesterExamSetting');
           },
           error: function () {
               swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
           }
       });
   });
 }

    function UpdateActiveExamSetting(Id, IsActive)
    {
        $.ajax({
            url: '/Examination/UpdateActiveExamSetting',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: Id, sActive: IsActive },
            success: function (data)
            {
                alert(data.Message);
                loadContent('/Examination/ListsemesterExamSetting');
            },
            error: function (error)
            {
                alert('Internal Server Error !');
            }
        });

    }

    function SaveExamSetting()
    {
     

        //var isValid = $('#exam').parsley().validate();
        var isValid = true;
        if ($('#exam').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            // gritter-info, danger, success, warning, default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        
        // Continue with save logic here...

        var sJsonData = '{"EXAM_SETTING_ID":"' + $('#hdExamSettingId').val() + '",\
                          "ACADEMIC_YEAR":"' + $('#AcademicYearList').val() + '",\
                          "EXAM_NAME":"' + $('#txtExamSetting').val() + '",\
                          "M_EXAM":"' + $('#txtExamMonth').val() + '",\
                          "M_PASS":"' + $('#txtPassMonth').val() + '",\
                          "SEMESTER_TYPE":"' + $('#ddlSemesterType').val() + '",\
                          "EXAM_TYPE":"' + $('#ExamType').val() + '",\
                          "START_DATE":"' + $('#txtStartDate').val() + '",\
                          "END_DATE":"' + $('#txtEndDate').val() + '",\
                          "LAST_DATE_FOR_EXAM_FEE":"' + $('#txtLastDateForExamFee').val() + '",\
                          "HALL_TICKET_PUBLICATION_DATE":"' + $('#txtHallTicketPublicationDate').val() + '",\
                          "IS_ACTIVE":"' + IsActive + '"}';

        $.ajax({
            url: '/Examination/SaveExamSetting',
            method: 'POST',
            dataType: 'json',   // correct casing
            data: { sJsonData: sJsonData },
            success: function (data) {
                if (data.ErrorCode != null && data.ErrorCode == "402") {
                    swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                } else {
                    swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                }
                // Either call your custom function
                loadContent('/Examination/ListsemesterExamSetting');

                // Or if you just want to refresh a div with new content:
                // $("#contentDiv").load('/Examination/ListsemesterExamSetting');
            },
            error: function () {
                alert('Internal Server Error!');
            }
        });

    }
    $("#Add").on('click', function () {

        $('#AcademicYearList option[value=""]').attr("selected", "selected");
        $('#txtExamSetting').attr('value', '');

        $('#txtPassMonth').attr('value', '');
        $('#ddlSemesterType option[value=""]').attr("selected", "selected");
        $('#ExamType option[value=""]').attr("selected", "selected");
        $('#txtStartDate').attr('value', '');
        $('#txtEndDate').attr('value', '');
        $('#txtLastDateForExamFee').attr('value', '');
        $('#txtHallTicketPublicationDate').attr('value', '');

        $("#IsActive").prop("checked", false);
        $('.selectpicker').selectpicker('refresh');
    })
    </script>
