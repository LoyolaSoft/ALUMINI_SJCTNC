@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}

<!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL CSS STYLE ================== -->
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List External Staff</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List External Staff<small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">List External Staff </h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-group table-responsive">
                <div class="col-md-12 pull-right">
                    <a href="#modal-dialog" data-toggle="modal" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
                </div>
                <br /><br />
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Staff Code</th>
                            <th>Name</th>
                            <th>DOB</th>
                            <th>Mobile No</th>
                            <th>E - Mail Id </th>
                            <th>College</th>
                            <th>Designation</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liExamExternalUser != null && Model.liExamExternalUser.Count > 0)
                        {
                            int nCount = 0;
                            foreach (var item in Model.liExamExternalUser)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.EXTERNAL_USER_CODE</td>
                                    <td>@item.FIRST_NAME</td>
                                    <td>@item.DOB</td>
                                    <td>@item.MOBILE_NO</td>
                                    <td>@item.MAIL_ID</td>
                                    <td>@item.COLLEGE_NAME</td>
                                    <td>@item.DESIGNATION</td>
                                    
                                    <td>
                                        <a href="#modal-dialog" data-toggle="modal" class="text-primary" onclick="FetchRecordById(@item.EXTERNAL_USER_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfrim(@item.EXTERNAL_USER_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<div class="modal" id="modal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit </h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group" id="dvValidate" data-parsley-validate="true">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Staff Code</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtExternalStaffCode" placeholder="Enter Staff Code" class="form-control" data-parsley-required="true" data-parsley-maxlength="40"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">First Name </label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtFirstName" class="form-control" placeholder="Enter First Name" data-parsley-required="true" data-parsley-maxlength="45"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Last Name</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtLastName" class="form-control" placeholder="Enter Last Name" data-parsley-required="true" data-parsley-maxlength="45"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Date Of Birth</label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        <input type="text" name="name" id="txtDOB" class="form-control date" data-parsley-required="true"  placeholder="Select Date"/>
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Mobile No</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtMobileNo" class="form-control" data-parsley-required="true" data-parsley-maxlength="10"  placeholder="Enter Mobile No"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">E Mail Id</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtMailId" class="form-control"data-parsley-required="true" data-parsley-maxlength="40"  placeholder="Enter E - Mail Id"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">College Name</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="txtClgName" class="form-control" data-parsley-required="true" data-parsley-maxlength="100"  placeholder="Enter College Name"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Designation</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(m => m.Designation, (Model.Designation != null) ? Model.Designation : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" , data_parsley_required = "true" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-toggle="modal" onclick="SaveExternalStaff()">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdExternalStaffId" />
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {
        // Document. Ready Function ...,
    }

    handleDatepicker = function () {
        "use strict";
        // $("#datepicker-autoClose").datepicker({todayHighlight:!0,autoclose:!0})}
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            endDate: new Date,
            format: "dd/mm/yyyy",
            orientation: "left"
            // 'top': top,
            // 'left': left
        });
    }
    handleDatepicker();

    $('.selectpicker').selectpicker({ size: 6 });
    $('.selectpicker').selectpicker('refresh');
    function FetchRecordById(Id)
    {
        $.ajax({
            url: '/Examination/FetchExternalStaffById',
            method: 'POST',
            datatype: 'json',
            data: { sExternalStaffId: Id },
            success: function (data)
            {
                $('#hdExternalStaffId').val(data[0].EXTERNAL_USER_ID);
                $('#txtExternalStaffCode').val(data[0].EXTERNAL_USER_CODE);
                $('#txtFirstName').val(data[0].FIRST_NAME);
                $('#txtLastName').val(data[0].LAST_NAME);
                $('#txtDOB').val(data[0].DOB);
                $('#txtMobileNo').val(data[0].MOBILE_NO);
                $('#txtMailId').val(data[0].MAIL_ID);
                $('#txtClgName').val(data[0].COLLEGE_NAME);
                $('#Designation').val(data[0].DESIGNATION);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function GetConfrim(Id)
    {
        if (!confrim('Are you sure to delete ?'))
        {
            return false;
        }
        $.ajax({
            url: '/Examination/DeleteExternalStaff',
            method: 'POST',
            datatype: 'json',
            data: { sExternalStaffId: Id },
            success: function (data) {
                alert(data.Message);
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

<script>
    function SaveExternalStaff()
    {
        // Validation Check ,...
        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }

        var sJsonData = '{\
                            "EXTERNAL_USER_ID":"' + $('#hdExternalStaffId').val() + '",\
                            "EXTERNAL_USER_CODE":"' + $('#txtExternalStaffCode').val() + '",\
                            "FIRST_NAME":"' + $('#txtFirstName').val() + '",\
                            "LAST_NAME":"' + $('#txtLastName').val() + '",\
                            "DOB":"' + $('#txtDOB').val() + '",\
                            "MOBILE_NO":"' + $('#txtMobileNo').val() + '",\
                            "MAIL_ID":"' + $('#txtMailId').val() + '",\
                            "COLLEGE_NAME":"' + $('#txtClgName').val() + '",\
                            "DESIGNATION":"' + $('#Designation').val() + '",\
                         }';
        $.ajax({
            url: '/Examination/SaveExternalStaffInfo',
            method: 'POST',
            datatype: 'json',
            data: { sJson: sJsonData },
            successs: function (data)
            {
                alert(data.Message);
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>