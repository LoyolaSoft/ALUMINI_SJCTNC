@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ExamRegisteredStudentListToPush";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Exam Registered Student </li>
    </ol>
    <h1 class="page-header">Exam Registered Student</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Exam Registered Student </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="">
                <a class="btn btn-success pull-right form-group m-b-5" onclick="PushExamRegistration()"><i class="fa fa-plus" title="Push"> Push</i></a>
            </div>
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.ExamList, "Exam Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.ExamList, (Model.ExamList != null) ? Model.ExamList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                    @Html.ValidationMessageFor(model => model.ExamList, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-lg-12">
                <div id="divExamRegistation">
                    <!--Need to use this fied to bind Student List-->
                </div>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
        //$("#ClassList").select2();
    </script>
    <script>
        $('#ExamRegisteredList').DataTable();
    </script>
    <script>
        function GetConfirm(ID) {
            if (!confirm('Are you sure to delete ?')) {
                return false;
            } else {
                $.ajax({
                    url: "@Url.Action("DeleteExamRegistration", "Examination")",
                    method: "POST",
                    datatype: "json",
                    data: { RegistrationId: ID },
                    success: function (data) {
                        alert(data.Message);
                        loadGird();
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
        $('#ExamList').on('change', function () {
            //loadGird();
        });
        function loadGird() {
            var sExamSettingId = $('#ExamList').val();
            if (sExamSettingId != 0) {
                $.ajax({
                    url: '@Url.Action("PushExamRegistration", "Examination")',
                    data: { ExamSettingId: sExamSettingId },
                    success: function (option) {
                        var dvExamRegistation = $('#divExamRegistation');
                        dvExamRegistation.empty();
                        dvExamRegistation.append(option);
                    },
                    error: function (xhr, textStatus, error) {
                        alert('Internal Server Error !');
                    }
                });

            } else {
                alert('Please Select Exam Setting...!!!');
            }
        }
        PushExamRegistration = function () {
            var sExamSettingId = $('#ExamList').val();
            if (sExamSettingId != 0) {
                $.ajax({
                    url: "@Url.Action("PushExamRegistration", "Examination")",
                    method: "POST",
                    datatype: "json",
                    data: { ExamSettingId: sExamSettingId },
                    success: function (data) {
                        alert(data);
                    }, error: function (xhr, textStatus, error) {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Please Select Exam Setting To Push...!!!');
            }
        }
    </script>

