@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "AddOrEditExamHeads";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active"> Add/Edit Exam Heads </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Add/Edit Exam Heads <small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Add/Edit Exam Heads </h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal col-lg-12">
                        <div class="row">

                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Frequency</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.FrequencyList, (Model.FrequencyList != null) ? Model.FrequencyList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>

                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Ex.Setting</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ExamList, (Model.ExamList != null) ? Model.ExamList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Prog.Type</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>

                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Prog.Mode</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Programmode, (Model.Programmode != null) ? Model.Programmode : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>

                        </div>
                        <div class="row">

                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Shift</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Prog.Year</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ProgrammeYear, (Model.ProgrammeYear != null) ? Model.ProgrammeYear : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="control-label col-md-4">Heads</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Heads, (Model.Heads != null) ? Model.Heads : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", multiple = "multiple" })
                                </div>
                            </div>

                            <div class="col-md-3 form-group">
                                <a class="btn btn-primary" href="javascript:;" id="btnGet">Get</a>
                            </div>
                        </div>

                        <div class="row">
                            <div id="dvMainHeads"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad()
    {
        // Document Ready Function ,...
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
    }

    // On Frequency Change ,..
    $('#FrequencyList').on('change', function ()
    {
        FetchMainHeads();
    });

    // On Programme Type Change ,..
    $('#ApplicationType').on('change', function ()
    {
        FetchMainHeads();
    });

    // On Programme Mode Change ,..
    $('#Programmode').on('change', function ()
    {
        FetchMainHeads();
    });

    // On Shift Change ,..
    $('#Shift').on('change', function ()
    {
        FetchMainHeads();
    });

    // On Programme year Change ,..
    $('#ProgrammeYear').on('change', function () {
        FetchMainHeads();
    });
    
    function FetchMainHeads()
    {
        if ($('#FrequencyList').val() && $('#ApplicationType').val() && $('#Programmode').val() && $('#Shift').val() && $('#ProgrammeYear').val())
        {
            $.ajax({
                url:'@Url.Action("FethMainHeads", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sFrequencyId: $('#FrequencyList').val(), sProgrammeType: $('#ApplicationType').val(), sProgrammeMode: $('#Programmode').val(), sShift: $('#Shift').val(), sProgrammeYear: $('#ProgrammeYear').val() },
                success: function (data)
                {
                    $('#Heads').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    } else
                    {
                        $('#Heads').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    swal({ title: "Failed !", text: 'Please provide valid inputs !', showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                }
            });
        }
    }

    // On Get Click ,...
    $('#btnGet').on('click', function ()
    {                
        if ($('#Heads').val() != null)
        {
            $.ajax({
                url:'@Url.Action("BindExamHeads", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sFeeMainHeadIds: String($('#Heads').val()), sFrequencyId: $('#FrequencyList').val(), sProgrammeYear: $('#ProgrammeYear').val()},
                success: function (data)
                {
                    $('#dvMainHeads').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    } else
                    {
                        $('#dvMainHeads').append(data);
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        } else {
            swal({ title: "Failed !", text: 'Please provide valid inputs !', showConfirmButton: false, timer: 2000, type: 'info', animation: true });
        }
    });
</script>


