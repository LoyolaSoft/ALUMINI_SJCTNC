@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "ListExamMalpracticeStudents";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Exam MalpracticeStudents</li>
    </ol>
    <h1 class="page-header">Exam MalpracticeStudents</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam MalpracticeStudents</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#AddMalpracticeStduents" data-toggle="modal"><i class="fa fa-plus" title="Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblMalPracticeStudent">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Exam Type</th>                       
                            <th>Name</th>
                            <th>Register NO</th>
                            <th>Programme</th>
                            <th>Malpracice Date</th>
                            <th>Description</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LiExamMalpracticeStudents != null && Model.LiExamMalpracticeStudents.Count > 0)
                        {
                            int count = 0;
                            foreach (var item in Model.LiExamMalpracticeStudents)
                            {
                                <tr>
                                    <td>@{count++;} @count</td>
                                    <td>@item.EXAM_TYPE_NAME</td>                                
                                    <td>@item.FIRST_NAME</td>
                                    <td>@item.REGISTER_NO</td>
                                    <td>@item.PROGRAMME_NAME</td>
                                    <td>@item.MALPRACTICE_DATE</td>
                                    <td>@item.DESCRIPTION</td>
                                    <td>
                                        <a href="#EditMalpracticeStduents" onclick="FetchItemDetails(@item.EXM_MALPRACTICE_STU_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.EXM_MALPRACTICE_STU_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                            }

                                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="AddMalpracticeStduents">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group col-lg-12">
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.Batch, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.Batch, (Model.Batch != null) ? Model.Batch : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.ApplicationType, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-lg-12">
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.ExamType, "Exam Type", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.ExamType, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.ExamSetting, "Exam", htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-lg-12">
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.ProgrammeList, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.StudentList, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true"})
                                            @Html.ValidationMessageFor(model => model.StudentList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-lg-12">
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.Semester, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true",id="txtSemester" })
                                            @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label class="control-label col-md-4">Interval</label>
                                        <div class="col-md-8">
                                            <input type="number" name="name" value="" class="form-control" placeholder="Enter the Interval" id="txtIntervalSemester"  min="1" max="8" />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-lg-12">
                                    <div class="form-group col-md-6">
                                        <label class="control-label col-md-4">Malpractice Date</label>
                                        <div class="col-md-8">
                                            <div class="input-group">
                                                <input type="text" name="name" id="txtMalpracticedate" class="form-control date" placeholder="Select the date" />
                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label class="control-label col-md-4">Description</label>
                                        <div class="col-md-8">
                                            <div class="input-group">
                                                @Html.TextArea("Description",null, 3, 35, new { @class = "form-control input-sm" , placeholder = "Enter the Description",id= "txtDescription" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitAdd" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="EditMalpracticeStduents">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <input type="text" id="txtprimaryId" class="hidden">
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">Student</label>
                                    <div class="col-md-8">
                                        <input type="text" name="name" value="" id="txtEStudentid" class="form-control" disabled />
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    @Html.LabelFor(model => model.Semester, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true",id="txtESemester" })
                                        @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">Interval</label>
                                    <div class="col-md-8">
                                        <input type="number" name="name" value="" class="form-control" id="txtEIntervalSemester" placeholder="Enter the Interval" min="1" max="8"/>
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">Malpractice Date</label>
                                    <div class="col-md-8">
                                        <div class="input-group">
                                            <input type="text" name="name" id="txtEMalpracticedate" class="form-control date" placeholder="Select the date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <label class="control-label col-md-4">Description</label>
                                    <div class="col-md-8">
                                        <div class="input-group">
                                            @Html.TextArea("Description", null, 3, 50, new { @class = "form-control input-sm", placeholder = "Enter the Description",id="txtEDescription", maxlength ="250" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitEdit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('#tblMalPracticeStudent').DataTable({});
    function handleDatepicker() {
        "use strict";
        $(".date").datepicker({
            todayHighlight: !0,
            autoclose: !0,
            endDate: new Date,
            format: "dd/mm/yyyy",
            orientation: "left"
        });
    };
    handleDatepicker();
    $('#ExamType').on("change", function () {
        var vAcademicYear = @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR].ToString();
        var vExamTyper = $('#ExamType').val();
        if (vExamTyper == "1") {
            $.ajax({
                url: '@Url.Action("FetchCIAExamSetting", "Examination")',
                data: { sAcademicYear: vAcademicYear },
                success: function (objResult) {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
        if (vExamTyper == "2") {
            $.ajax({
                url: '@Url.Action("FetchExamSetting", "Examination")',
                data: { sAcademicYear: vAcademicYear},
                success: function (objResult) {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }
    });

    $("#ApplicationType").on("change", function () {
        var sApplictionTypeId = $("#ApplicationType").val();
        $.ajax({
            url: "@Url.Action("FetchProgrammeByAppType", "Student")",
            method: "POST",
            datatype: "json",
            data: { sApplictionId: sApplictionTypeId },
            success: function (data) {
                $("#ProgrammeList").empty();
                $("#ProgrammeList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });

    $("#ProgrammeList").on("change", function () {
        var vProgram = $("#ProgrammeList").val();
        var vBatch = $("#Batch").val();
        $.ajax({
            url: "@Url.Action("FetchStudentByProgrammeGroupBatch", "Student")",
            method: "POST",
            datatype: "json",
            data: { sBatch: vBatch, sProgrammeGroupId: vProgram, },
            success: function (data) {
                $("#StudentList").empty();
                $("#StudentList").append('<option value="">-- select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });

    function FetchItemDetails(ID) {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchExamMalpracticeStudentsById", "Examination")",
                type: "post",
                data: { sExamMalpracticeStudentId: ID },
                success: function (data) {
                    if (data != null) {
                        $('#txtprimaryId').val(data.EXM_MALPRACTICE_STU_ID);
                        if (data.REGISTER_NO!=null) {
                            $('#txtEStudentid').val(data.REGISTER_NO);
                        }else{
                            $('#txtEStudentid').val(data.ROLL_NO);
                        }
                      //  $('#txtEStudentid').val(data.STUDENT_ID);
                        $('#txtESemester').val(data.CURRENT_SEMESTER);
                        $('#txtEIntervalSemester').val(data.INTERVAL_SEMESTER);
                        $('#txtEMalpracticedate').val(data.MALPRACTICE_DATE);
                        $('#txtEDescription').val(data.DESCRIPTION);                        
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }


    $('#btnSubmitAdd').click(function (){
        var isValid = true;
        var JsonData = null;
       // if ($('#pBody').parsley().validate() !== true) isValid = false;
       // if (!isValid) {
           // return false;
        //}
        JsonData = '{"STUDENT_ID":"' + $('#StudentList').val() + '","EXAM_TYPE":"' + $('#ExamType').val() + '","EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '","BATCH":"' + $('#Batch').val() + '","PROGRAMME_GROUP_ID":"' + $('#ProgrammeList').val() + '","MALPRACTICE_DATE":"' + $('#txtMalpracticedate').val() + '","DESCRIPTION":"' + $('#txtDescription').val() + '","CURRENT_SEMESTER":"' + $('#txtSemester').val() + '","INTERVAL_SEMESTER":"' + $('#txtIntervalSemester').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveUpdateExamMalpracticeStudents", "Examination")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {
                if (data.ErrorCode != null && data.ErrorCode == "406") {
                    swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    loadContent('/Examination/ListExamMalpracticeStudents');
                } else {
                    swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    loadContent('/Examination/ListExamMalpracticeStudents');
                }
            },
            error: function (ex) {
                swal({ title: "Error..!!", text:"Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });
    });
    
    $('#btnSubmitEdit').click(function (){
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
        JsonData = '{"EXM_MALPRACTICE_STU_ID":"' + $('#txtprimaryId').val() + '","MALPRACTICE_DATE":"' + $('#txtEMalpracticedate').val() + '","DESCRIPTION":"' + $('#txtEDescription').val() + '","CURRENT_SEMESTER":"' + $('#txtESemester').val() + '","INTERVAL_SEMESTER":"' + $('#txtEIntervalSemester').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveUpdateExamMalpracticeStudents", "Examination")",
            type: "post",
        data: { sJsonData: JsonData },
        success: function (data) {
            if (data.ErrorCode != null && data.ErrorCode == "402") {
                swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                loadContent('/Examination/ListExamMalpracticeStudents');
            } else {
                swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Examination/ListExamMalpracticeStudents');
            }
        },
        error: function (ex) {
            swal({ title: "Error..!!", text:"Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
        }
    });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },function () {
            $.ajax({
                url: "@Url.Action("DeleteExamMalpracticeStudent", "Examination")",
                type: "post",
                data: { sExamMalpracticeStudentId: ID },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode == "402") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        loadContent('/Examination/ListExamMalpracticeStudents');
                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Examination/ListExamMalpracticeStudents');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error..!!", text:"Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

    }


</script>
