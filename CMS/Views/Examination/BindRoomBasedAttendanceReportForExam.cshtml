@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ Layout = null;}

    @if (Model.LiExamSeatingAllotment != null && Model.LiExamSeatingAllotment.Count() > 0)
    {
        var Rooms = Model.LiExamSeatingAllotment.GroupBy(o => o.ROOM_ID).ToList();
        foreach (var Roomitems in Rooms)
        {
            var CourseAttendance = Model.LiExamSeatingAllotment.Where(o => o.ROOM_ID == Roomitems.FirstOrDefault().ROOM_ID).ToList();
            //var Classes = CourseAttendance.GroupBy(o => o.CLASS_ID).ToList();
            //foreach (var classitem in Classes)
            //{
               // var ClassStudents = Model.LiExamSeatingAllotment.Where(o => o.ROOM_ID == Roomitems.FirstOrDefault().ROOM_ID && o.CLASS_ID == classitem.FirstOrDefault().CLASS_ID).ToList();
                <div class="form-group table-responsive" id="dvCourseWiseReport" style="page-break-after:always !important;page-break-inside:avoid !important;">
                    <div class="col-md-12">
                        <table>
                            <tr>
                                <td style="width:50%"><b>Block</b> : &nbsp;@CourseAttendance.FirstOrDefault().BLOCK_NAME</td>
                                <td style="width:20%" align="left"><b>ExamDate</b> : &nbsp;@CourseAttendance.FirstOrDefault().EXAM_DATE</td>
                            </tr>
                            <tr>
                                <td style="width:50%"><b>Room</b> : &nbsp;@CourseAttendance.FirstOrDefault().ROOM_NO</td>
                                @if (CourseAttendance.FirstOrDefault().EXAM_SESSION.Equals("9.30 to 12.30"))
                                {
                                    <td style="width:20%" align="left"><b>ExamSession</b> : &nbsp;FN</td>
                                }
                                else
                                {
                                    <td style="width:20%" align="left"><b>ExamSession</b> : &nbsp;AN</td>
                                }                                
                            </tr>
                            @*<tr>
                                <td style="width:50%"><b>Course</b> : &nbsp;@CourseAttendance.FirstOrDefault().COURSE_TITLE</td>
                            </tr>*@
                        </table>
                    </div>
                    <table align="left" style="width:100%; border:1px solid; table-layout:fixed;">
                        <thead>
                            <tr>
                                <th width="5% !important" style="border:1px solid; padding:4px;">#</th>
                                <th width="14% !important" style="border:1px solid; padding:4px;">RegisterNo</th>
                                @*<th width="25% !important" style="border:1px solid; padding:10px;">Name</th>*@
                                <th width="17% !important" style="border:1px solid; padding:4px;">CourseCode</th>
                                <th width="15% !important" style="border:1px solid; padding:4px;">SeatCode</th>
                                <th width="34% !important" style="border:1px solid; padding:4px;">Signature</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int count = 0; }
                            @foreach (var item in CourseAttendance)
                        {
                                <tr>
                                    <td width="5% !important" style="border:1px solid; padding:4px;">@{count++;}@count</td>
                                    <td width="14% !important" style="border:1px solid; padding:4px;">@item.REGISTER_NO</td>
                                    @*<td width="25% !important" style="border:1px solid; padding:10px;">@item.FIRST_NAME</td>*@
                                    <td width="17% !important" style="border:1px solid; padding:4px;">@item.COURSE_CODE</td>
                                    <td width="15% !important" style="border:1px solid; padding:4px;">@item.SEAT_CODE</td>
                                    <td width="34% !important" style="border:1px solid; padding:4px;"></td>
                                </tr>
                                        }

                        </tbody>
                    </table>                                     
                    <div class="col-md-12">                                          
                        <table> 
                            <tr>
                                <td style="width:50%">&nbsp;&nbsp;&nbsp;</td>
                                <td style="width:30%" align="left">&nbsp;&nbsp;&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="width:50%">&nbsp;&nbsp;&nbsp;</td>
                                <td style="width:30%" align="left">&nbsp;&nbsp;&nbsp;</td>
                            </tr>                                                    
                            <tr>
                                <td style="width:50%"><b>NAME OF THE HALL SUPERINTENDENT</b></td>
                                <td style="width:30%" align="left"><b>SIGN OF THE HALL SUPERINTENDENT</b></td>
                            </tr>                            
                        </table>
                    </div>
                </div>
                                                }
                                          //  }

                                        }

