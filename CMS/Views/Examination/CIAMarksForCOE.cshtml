@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "CIAMarksForCOE";
  //  Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Internal Assessment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CIA Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-3">
                            @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            @Html.Label("Class Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null)? Model.ClassList:Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            @Html.Label("Programme List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker", @data_live_search = "true",multiple="multiple",data_actions_box="true" })
                                @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-1">
                            <a class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                        <div class="col-md-1">
                            <a class="btn btn-success hidden" id="btnExport" @*onclick="ExportToExcel('dvCIAbind');"*@>Export</a>
                        </div>
                        <div class="col-md-1">
                            <a class="btn btn-success hidden" id="btnPrint" onclick="printDiv('dvCIAbind');">Print</a>
                        </div>

                    </div>
                </div>
                <div id="dvCIAbind"></div>
            }
        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    ContentLoad = function () {
        //Ready Function()
    }
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');

    $('#ClassList').on('change', function ()
    {
        var inp = $('#ClassList').val();
        $.ajax({
            url: "@Url.Action("FetchProgrammeByClassYear", "Examination")",
            async: false,
            data: { sClassYear: inp },
            success: function (option)
            {
                if (option.Message!=null && option.Message!='')
                {
                    alert(option.Message);
                } else
                {
                    $('#ProgrammeList').empty();
                    $('#ProgrammeList').append(option.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            },error: function (xhr, textStatus, error)
            {
                alert("Internal Server Error! ");
            }
        });
    });

    $('#btnGet').on('click', function ()
    {
        var ClassYear = $('#ClassList').val();
        var Programme = String($('#ProgrammeList').val());
        var AcademicYear = $('#AcademicYearList Option:selected').text();
        $('#dvCIAbind').empty();
        if (ClassYear!='' && Programme != '')
        {
            $.ajax({
                url: "@Url.Action("BindCIAMarksForCOE", "Examination")",
                async: false,
                data: { sClassYear: ClassYear, sProgrammeGroupId: Programme, sAcYear: AcademicYear },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else {
                        $('#dvCIAbind').append(data);
                        $('.btn').removeClass('hidden');
                        // $('#tblCIAMarks').DataTable();
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        } else {
            alert('Please Select All Values !');
        }
    });

    function printDiv(divName)
    {
        $('#dvHead').addClass('hidden');
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
        loadContent('/Examination/CIAMarksForCOE');
    }

    $("#btnExport").click(function (e)
    {
        var sClass = $('#ClassList Option:selected').text();
        let file = new Blob([$('#dvCIAbind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: sClass + "_Year.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
</script>
