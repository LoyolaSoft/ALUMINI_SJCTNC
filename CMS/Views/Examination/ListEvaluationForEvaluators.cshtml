@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int count = 0;
}
<div class="col-md-12">
    <table class="table table-bordered">
        <thead>
            <tr>
                <td>#</td>
                <td>Course Code</td>
                <td>Date</td>
                <td>Dummy No</td>
                <td>Register No</td>
                <td>Is Evaluated</td>
                <td>Action</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.liexamevaluation != null && Model.liexamevaluation.Count > 0)
            {
                foreach (var item in Model.liexamevaluation)
                {
                    count++;

                    <tr>
                        <td>@count</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.EVALUATION_DATE</td>
                        <td>@item.DUMMY_NO</td>
                      
                        @if (string.IsNullOrEmpty(item.REGISTER_NO))
                        {
                            <td>@item.ROLL_NO</td>
                        }
                        else
                        {
                            <td>@item.REGISTER_NO</td>
                        }                                               
                        @if (item.IS_COMPLETED == "1")
                        {
                            <td><label class="text-success"><i title="Completed" onclick="ChangeEvaluationStatus(@item.EXAM_EVALUATION_ID,0)"  class="fa fa-check-circle"></i></label></td>
                        }
                        else
                        {
                            <td><label class="text-danger"><i title="In Completed" onclick="ChangeEvaluationStatus(@item.EXAM_EVALUATION_ID,1)" class="fa fa-times-circle-o"></i></label></td>
                        }
                        @if (item.IS_COMPLETED == "1")
                        {
                            <td><label class="text-success"><i title="Completed" class="fa fa-check-circle"></i></label></td>
                        }
                        else
                        {
                            <td><a href="javascript:;" onclick="loadContent('/Examination/BindSectionsByInvigilationId?sInvigilationId=@item.INVIGILATION_ID&sEvaluationId=@item.EXAM_EVALUATION_ID&sEvaluationtype=@item.EVALUATION_TYPE')" dis><i class="fa fa-pencil-square-o" style="font-size:20px"></i></a></td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">No Records Found...!</td>
                </tr>
            }
        </tbody>
    </table>
</div>









