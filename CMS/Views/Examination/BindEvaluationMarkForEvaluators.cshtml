@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}
<style type="text/css" media="print">

    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }
</style>
<div class="col-md-12 table-responsive">
    <table class="table table-bordered" id="tblStudent">
        <thead>
            <tr>
                <th>#</th>
                <th>DummyNo</th>
                <th>Register No</th>
                <th>CourseCode</th>
                <th>Mark</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LiExamEvaluationMark != null && Model.LiExamEvaluationMark.Count > 0)
            {
                int nCount = 0;
                foreach (var item in Model.LiExamEvaluationMark)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.DUMMY_NO</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.COURSE_CODE</td>
                        <td> @item.SECURED_MARK/@item.TOTAL_MARK</td>
                        <td><a href="#"  data-toggle="modal" data-target="#staticBackdrop" onclick="bindMarks(@item.EVALUATION_ID)" ><i class="fa fa-edit"></i> </a> </td>

                    </tr>
                }
            }

        </tbody>
    </table>
</div>



