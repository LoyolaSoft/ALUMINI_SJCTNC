<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Quiz Setting</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Quiz Setting<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">List Quiz Setting</h4>
                </div>
                <div class="panel-body">
                    <div class="col-md-12 form-horizontal">
                        <div class="table-responsive">
                            <div class="col-md-12">
                                <a href="#QuizSetting-dialog" class="btn btn-success pull-right" data-toggle="modal"><i class="fa fa-plus"> Add</i></a>  
                            </div>
                            <br /><br />
                            @{int No = 0;}
                            <table class="table table-hover table-bordered" id="tblQuizSetting">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Setting Name</th>
                                        <th>No Of Questions</th>
                                        <th>Mark Per Question</th>
                                        <th>Total</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Active</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.liQuizSetting != null)
                                    {
                                        foreach (var item in Model.liQuizSetting)
                                        {
                                            <tr>
                                                <td>@{No++; } @No</td>
                                                <td>@item.SETTING_NAME</td>
                                                <td>@item.NO_OF_QUESTIONS</td>
                                                <td>@item.EACH_QUESTION_MARKS</td>
                                                <td>@item.TOTAL_MARK</td>
                                                <td>@item.START_DATE</td>
                                                <td>@item.END_DATE</td>
                                                <td>
                                                    @if (item.IS_ACTIVE=="1")
	                                                {
		                                                 <a href="javascrip:;" onclick="SetDeActive(@item.SETTING_ID)" class="text-success"><i class="fa fa-check"></i></a>             }
                                                    else
                                                    {
                                                        <a href="javascrip:;" onclick="SetActive(@item.SETTING_ID)" class="text-danger"><i class="fa fa-times"></i></a>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="#QuizSetting-dialog" onclick="FetchSettingInfo(@item.SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                                    @if (item.IS_ACTIVE == "0")
                                                    {
                                                        <a href="javascrip:;" onclick="GetConfirm(@item.SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                                    }
                                                    
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>No Record(s) Found ...!</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<!-- Begin Modal -->

<div class="modal" id="QuizSetting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Quiz Setting</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12">

                                <!-- Setting Name-->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Setting Name</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtSettingName" class="form-control" placeholder="Enter Setting Name">
                                    </div>
                                </div>

                                <!-- No Of Questions -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label"> No Of Questions</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtNoOfQuestions" class="form-control" placeholder="Enter No Of Questions">
                                    </div>
                                </div>

                                <!-- Mark Per Question -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Mark Per Question</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtMarkPerQuestion" class="form-control" placeholder="Enter Mark Per Question">
                                    </div>
                                </div>

                                <!-- Total Mark -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Total Mark</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtTotalMark" class="form-control" disabled placeholder="Total Mark">
                                    </div>
                                </div>

                                <!-- Start Date -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Start Date</label>
                                    <div class="col-md-9">
                                        <div class="input-group date" id="datetimepicker1">
                                            <input type="text" id="txtStartDate" class="form-control input-sm" placeholder="Select Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- End Date -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">End Date</label>
                                    <div class="col-md-9">
                                        <div class="input-group date" id="datetimepicker2">
                                            <input type="text" id="txtEndDate" class="form-control input-sm" placeholder="Select Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<!-- End Modal -->



