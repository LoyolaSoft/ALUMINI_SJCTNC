@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "CourseWiseCumulativeMarklist";
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
@*<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />*@
<link href="~/Content/assets/printout1.css" media="print" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Internal Assessment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Marks<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CIA Marks</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-6 " data-step="1" data-intro="Choose Class">
                            @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  select2", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6" data-step="2" data-intro="Choose Course">
                            @Html.Label("Semester Type", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  select2", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.Semester, "", new { @class = "text-danger" })
                            </div>
                        </div>


                    </div>

                    <div class="form-group col-md-12">

                        <div class="col-md-6" data-step="2" data-intro="Choose Course">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "CourseList" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>


                        <div class="col-md-6 " data-step="1" data-intro="Choose Class">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple", @id = "ClassList" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>


                    </div>
                </div>
                <div class="col-lg-12" style="z-index:1">
                    <div class="pull-right">
                        <span class="hidden-print">
                            <a href="javascript:;" title="Click to Get" id="sExport" onclick="GetCumulative()" class="btn btn-sm btn-primary m-b-10">Get</a>
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvCIAbind')" class="btn btn-sm btn-success m-b-10 disabled"><i class="fa fa-print m-r-5"></i> Print</a>
                            <a href="javascript:;" id="sExcel" onclick="Export()" class="btn btn-sm btn-success m-b-10 disabled"><i class="fa fa-print m-r-5"></i> Excel</a>
                        </span>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="col-lg-12 landScape" id="dvCIAbind"></div>
                </div>
            }
        </div>

    </div>
</div>
<!-- end #content -->
<!-- Hidden -->
<input type="hidden" id="hdStaffId" value="@Model.StaffId" />
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
