<script>
            function ContentLoad() {
    // Document Ready Function
}

$('.selectpicker').selectpicker({
    size: 6
});
$('.selectpicker').selectpicker('refresh');

// Event bindings
    $('#Semester').on('change', FetchCourseList);
    $('#AcademicYearList').on('change', FetchCourseList);
    $('#CourseList').on('change', FetchClassList);

function FetchCourseList() {

    let semesterId = $('#Semester').val();
    let acYear = $('#AcademicYearList option:selected').text();

    // Validate required fields
    if (semesterId && acYear) {

        $.ajax({
            url: "@Url.Action("FetchCourseByAcYearAndSemtypeId", "SupportData")",
            async: false,
            data: {

                sAcYear: acYear,
                sSemesterTypeId: semesterId
            },
            success: function (response) {
                var select = $('#CourseList');
                select.empty();
                select.append(response.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (ex) {
                alert(ex);
            }
        });
    }
}




    function FetchClassList() {
    let semesterId = $('#Semester').val();
    let acYear = $('#AcademicYearList option:selected').text();
    let course = $('#CourseList').val();
    // Validate required fields
        if (semesterId && acYear && course) {

        $.ajax({
            url: "@Url.Action("FetchClassByAcYearAndSemtypeId", "SupportData")",
            async: false,
            data: {

                sAcYear: acYear,
                sSemesterTypeId: semesterId,
                sCourse: course
            },
            success: function (response) {
                var select = $('#ClassList');
                select.empty();
                select.append(response.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (ex) {
                alert(ex);
            }
        });
    }
}


            function GetCumulative()
            {
                $('#sPrint').addClass('disabled');
                $('#sExcel').addClass('disabled');
                $.ajax({
                    url: "@Url.Action("BindCoursewisecumulativemarklist", "Examination")",
                    data: {
                        sClassId: String($('#ClassList').val()),
                        sCourseId: $('#CourseList').val(),
                        sAcYear: $('#AcademicYearList  Option:selected').text(),
                        sSemesterTypeId: $('#Semester').val()
                    },
                    success: function (option)
                    {
                        var divHtml = $('#dvCIAbind');
                        divHtml.empty();
                        divHtml.html(option);
                        $('#sPrint').removeClass('disabled');
                        $('#sExcel').removeClass('disabled');
                    },
                    error: function (ex)
                    {
                        alert(ex);
                    }
                });
            }

            function printDiv(divName) {
                var printContents = document.getElementById(divName).innerHTML;
                var originalContents = document.body.innerHTML;

                document.body.innerHTML = printContents;

                window.print();

                document.body.innerHTML = originalContents;
                loadContent('/Examination/CIAOverAllCumulativeMarksForCOE');
            }
        function Export() {
            var title = "";
            //var sSatff = $('#StaffListByDepartmet option:selected').text();
            title = "CIA Cumulative Mark";
            let file = new Blob([$('#dvCIAbind').html()], { type: "application/vnd.ms-excel" });
            let url = URL.createObjectURL(file);
            let a = $("<a />", {
                href: url,
                download: title + ".xls"
            }).appendTo("body").get(0).click();
            //$('#btnGet').click();
            //loadContent('/attendance/AttendancePercentageCommon');
            //e.preventDefault();
            // loadContent('/IQAC/IQACDateWiseReportForIncharge');
        }

</script>



