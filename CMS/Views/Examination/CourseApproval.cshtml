@model CMS.ViewModel.Model.CourseRootModel

@{
    //ViewBag.Title = "EditCourseRootInfo";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a href="javascript:;" onclick="loadContent('/Examination/ListCourseApproval')" @*href="@Url.Action("ListCourseInfo","Academics")"*@>List Course</a></li>
            <li class="active">Edit Course</li>
        </ol>
        <h2 class="page-header">Course Details</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Edit Course</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    <div class="col-md-6">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(model => model.COURSE_CODE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.COURSE_CODE, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtCoursecode", placeholder = "Enter Course Code", @data_parsley_required = "true", @data_parsley_length = "[2,45]" } })
                                @Html.ValidationMessageFor(model => model.COURSE_CODE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.COURSE_TITLE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.COURSE_TITLE, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtCoursetitle", placeholder = "Enter Course Title", @data_parsley_required = "true", @data_parsley_length = "[3,250]" } })
                                @Html.ValidationMessageFor(model => model.COURSE_TITLE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        

                        <div class="form-group">
                            @Html.LabelFor(model => model.DEPARTMENT, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.DEPARTMENT, (Model.DEPARTMENT != null) ? Model.DEPARTMENT : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlDepartment", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.DEPARTMENT, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            @Html.Label("Program Level", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.sProgrammeLevel, (Model.sProgrammeLevel != null) ? Model.sProgrammeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlProgrammeLevel", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.sProgrammeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PART, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.PART, (Model.PART != null) ? Model.PART : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlPart" })
                                @Html.ValidationMessageFor(model => model.PART, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.COURSE_TYPE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.COURSE_TYPE, (Model.COURSE_TYPE != null) ? Model.COURSE_TYPE : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlCoursetype", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.COURSE_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.HRS_PER_WEEK, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.HRS_PER_WEEK, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtHrsperweek", placeholder = "Enter Hrs Per Week", data_parsley_type = "number" } })
                                @Html.ValidationMessageFor(model => model.HRS_PER_WEEK, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.CREDITS, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.CREDITS, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtCredits", placeholder = "Enter Credits", @data_parsley_required = "true", data_parsley_type = "number" } })
                                @Html.ValidationMessageFor(model => model.CREDITS, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.SEMESTER, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.SEMESTER, (Model.SEMESTER != null) ? Model.SEMESTER : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlSemester", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.SEMESTER, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.COURSE_ORDER, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.COURSE_ORDER, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtCourseorder", placeholder = "Enter Course Order", data_parsley_type = "number" } })
                                @Html.ValidationMessageFor(model => model.COURSE_ORDER, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.UGC_COURSE_TYPE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.UGC_COURSE_TYPE, (Model.UGC_COURSE_TYPE != null) ? Model.UGC_COURSE_TYPE : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlUGCCoursetype", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.UGC_COURSE_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PAPER_TYPE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.PAPER_TYPE, (Model.PAPER_TYPE != null) ? Model.PAPER_TYPE : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlPaperType", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.PAPER_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.SUBJECT_TYPE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.SUBJECT_TYPE, (Model.SUBJECT_TYPE != null) ? Model.SUBJECT_TYPE : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlSubjectType", @data_parsley_required = "true", })
                                @Html.ValidationMessageFor(model => model.SUBJECT_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.INTERNAL, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.INTERNAL, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtInternal", placeholder = "Enter Internal", data_parsley_type = "number" } })
                                @Html.ValidationMessageFor(model => model.INTERNAL, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.EXTERNAL, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.EXTERNAL, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtExternal", placeholder = "Enter External", data_parsley_type = "number" } })
                                @Html.ValidationMessageFor(model => model.EXTERNAL, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.TOTAL, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.TOTAL, new { htmlAttributes = new { @class = "form-control input-sm", id = "txtTotal", placeholder = "Enter Total", data_parsley_type = "number" } })
                                @Html.ValidationMessageFor(model => model.TOTAL, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-12">
                            <div class="checkbox checkbox-css col-md-offset-3">
                                <input type="checkbox" id="IS_NME_SUBJECT" />
                                <label for="IS_NME_SUBJECT">Is NME</label>
                            </div>
                            <div class="checkbox checkbox-css col-md-offset-3">
                                <input type="checkbox" id="IS_ALLIED_SUBJECT" />
                                <label for="IS_ALLIED_SUBJECT">Is Allied</label>
                            </div>
                            <div class="checkbox checkbox-css col-md-offset-3">
                                <input type="checkbox" id="IS_COMPULSORY_SUBJECT" />
                                <label for="IS_COMPULSORY_SUBJECT">Is Compulsory Subject</label>
                            </div>
                            
                        </div>

                        <div class="form-group pull-right">
                            <div class="col-md-12 pull-right">

                                <a id="btnSubmit" value="Submit" class="btn btn-primary">Submit</a>
                                <a id="btnCancel" value="Submit" class="btn btn-danger" href="javascript:;" onclick="loadContent('/Academics/ListCourseApproval')" @*href="@Url.Action("ListCourseInfo","Academics")"*@>Cancel</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

<input type="hidden" id="hdCourseApprovalId" value="@Model.sCourseApprovalId" />


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
        function ContentLoad()
        {
            // Document Ready Function .
            EditCourseApproval();
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
        
        function EditCourseApproval() 
        {
            if ($('#hdCourseApprovalId').val())
            {
                var ID=null;
                $.ajax({
                    url:"@Url.Action("FetchCourseApprovalById", "Examination")",
                    method:"POST",
                    datatype:"json",
                    data: { sCourseApprovalId: $('#hdCourseApprovalId').val() },
                    success: function (data)
                    {
                        if (data.ErrorCode !=null && data.ErrorCode!='')
                        {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        } else
                        {
                            $("#ddlDepartment").val(data[0].DEPARTMENT_ID);
                            $("#ddlPart").val(data[0].PART);
                            $("#ddlCoursetype").val(data[0].COURSE_TYPE);
                            $("#txtHrsperweek").val(data[0].HRS_PER_WEEK);
                            $("#txtCredits").val(data[0].CREDITS);
                            $("#txtCoursetitle").val(data[0].COURSE_TITLE);
                            $("#txtCoursecode").val(data[0].COURSE_CODE);
                            $("#ddlSemester").val(data[0].SEMESTER_ID);
                            $("#IS_NME_SUBJECT").val(data[0].IS_NME_SUBJECT);
                            $("#IS_ALLIED_SUBJECT").val(data[0].IS_ALLIED_SUBJECT);
                            $("#txtCourseorder").val(data[0].COURSE_ORDER);
                            $("#IS_COMPULSORY_SUBJECT").val(data[0].IS_COMPULSORY_SUBJECT);
                            $("#ddlUGCCoursetype").val(data[0].UGC_COURSE_TYPE);
                            $("#ddlPaperType").val(data[0].PAPER_TYPE);
                            $("#ddlSubjectType").val(data[0].SUBJECT_TYPE);
                            $("#txtInternal").val(data[0].INTERNAL);
                            $("#txtExternal").val(data[0].EXTERNAL);
                            $("#txtTotal").val(data[0].TOTAL);
                            if ($("#IS_NME_SUBJECT").val() == 1) {
                                $("#IS_NME_SUBJECT").prop("checked", true);
                            }
                            else {
                                $("#IS_NME_SUBJECT").prop("checked", false);
                            }
                            if ($("#IS_ALLIED_SUBJECT").val() == 1) {
                                $("#IS_ALLIED_SUBJECT").prop("checked", true);
                            }
                            else {
                                $("#IS_ALLIED_SUBJECT").prop("checked", false);
                            }
                            if ($("#IS_COMPULSORY_SUBJECT").val() == 1) {
                                $("#IS_COMPULSORY_SUBJECT").prop("checked", true);
                            }
                            else {
                                $("#IS_COMPULSORY_SUBJECT").prop("checked", false);
                            }
                            $('.selectpicker').selectpicker('refresh');

                        }
                   }, error: function (error)
                    {
                       swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            }
        }
           
</script>

<script>
        $("#btnSubmit").on("click" , function(){
            var Department = $("#ddlDepartment").val();
            var Part = $("#ddlPart").val();
            var CourseType = $("#ddlCoursetype").val();
            var HrsPerWeek = $("#txtHrsperweek").val();
            var Credits = $("#txtCredits").val();
            var CourseTitle = $("#txtCoursetitle").val();
            var CourseCode = $("#txtCoursecode").val();
            var Semester = $("#ddlSemester").val();
            var IsNME = $("#IS_NME_SUBJECT").val();
            var IsAllied = $("#IS_ALLIED_SUBJECT").val();
            var CourseOrder = $("#txtCourseorder").val();
            var IsCompulsory = $("#IS_COMPULSORY_SUBJECT").val();
            var UGCCourseType = $("#ddlUGCCoursetype").val();
            var PaperType = $("#ddlPaperType").val();
            var SubjectType = $("#ddlSubjectType").val();
            var Internal = $("#txtInternal").val();
            var External = $("#txtExternal").val();
            var Total = $("#txtTotal").val();
            var ProgramLevel=$('#ddlProgrammeLevel').val();
            //var NMEchecked;
            //var Alliedchecked;
            //var Compulsorychecked;

            var JsonData;
            if ($('#IS_NME_SUBJECT').is(":checked")) {
                IsNME = 1;
            }
            else {
                IsNME = 0;
            }
            if ($('#IS_ALLIED_SUBJECT').is(":checked")) {
                IsAllied = 1;
            }
            else {
                IsAllied = 0;
            }
            if ($('#IS_COMPULSORY_SUBJECT').is(":checked")) {
                IsCompulsory = 1;
            }
            else {
                IsCompulsory = 0;
            }
            if (JsonData == null) {

                JsonData = '{"COURSE_APPROVAL_ID":"' + $('#hdCourseApprovalId').val() + '",\
                             "DEPARTMENT_ID":"' + Department + '",\
                             "PROGRAMME_LEVEL_ID":"' + ProgramLevel + '",\
                             "PART":"' + Part + '",\
                             "COURSE_TYPE":"' + CourseType + '",\
                             "HRS_PER_WEEK":"' + HrsPerWeek + '",\
                             "CREDITS":"' + Credits + '",\
                             "COURSE_TITLE":"' + CourseTitle + '",\
                             "COURSE_CODE":"' + CourseCode + '",\
                             "SEMESTER":"' + Semester + '",\
                             "IS_NME_SUBJECT":"' + IsNME + '",\
                             "IS_ALLIED_SUBJECT":"' + IsAllied + '",\
                             "COURSE_ORDER":"' + CourseOrder + '",\
                             "IS_COMPULSORY_SUBJECT":"' + IsCompulsory + '",\
                             "UGC_COURSE_TYPE":"' + UGCCourseType + '",\
                             "PAPER_TYPE":"' + PaperType + '",\
                             "SUBJECT_TYPE":"' + SubjectType + '",\
                             "INTERNAL":"' + Internal + '",\
                             "EXTERNAL":"' + External + '",\
                             "TOTAL":"' + Total + '"\
                            }';
            }


            $.ajax({
                url: "@Url.Action("SaveCourseApproval", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sJson: JsonData },
                success: function (objResult)
                {
                    if (data.ErrorCode == "200") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        //loadContent('/Examination/CourseApprovalList');
                    } else {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        });
</script>

