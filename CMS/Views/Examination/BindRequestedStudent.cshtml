@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ 
    Layout = null;
}
<div class="col-md-12">
    <br><br>
<table class="table table-hover table-bordered" id="tblMarkSheetRequested">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Class</th>
                <th>Register No</th>
                <th>Semster</th>
                <th>Requested Date</th>
                <th>Description</th>
                <th>Exam Setting</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liMarksheetdistribution != null && Model.liMarksheetdistribution.Count > 0)
            {
                int count = 0;
                foreach (var item in Model.liMarksheetdistribution)
                {
                    <tr marksheetdisid="@item.MARKSHEET_DISTRIBUTION_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.SEMESTER_NAME</td>
                        <td>@item.REQUEST_DATE</td>
                        <td>@item.REASON</td>

                        <td style="width:15%">
                            <select class="selectpicker form-control examsetting" data-live-search="true" data-parsley-required="true">
                                <option value="">--Select--</option>
                                @foreach (SelectListItem option in Model.ExamSetting)
                                {

                                    <option value="@option.Value" examsettingid="@item.EXAM_SETTING_ID" @(option.Value == item.EXAM_SETTING_ID ? "selected='selected'" : "")>@option.Text</option>

                                }

                            </select>
                        </td>
                        <td style="width:15%">
                            <select class="selectpicker form-control status" data-live-search="true" data-parsley-required="true">
                                <option value="">--Select--</option>
                                @foreach (SelectListItem option in Model.Status)
                                {
                                    <option value="@option.Value" examsettingid="@item.STATUS" @(option.Value == item.STATUS ? "selected='selected'" : "")>@option.Text</option>

                                }
                            </select>
                        </td>
                    </tr>
                                }

                            }

        </tbody>
    </table>
</div>