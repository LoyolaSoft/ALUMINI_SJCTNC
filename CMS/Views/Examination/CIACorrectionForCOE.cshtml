@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Internal Assessment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Internal Assessment<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Internal Assessment</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-6">
                            @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            @Html.Label("Semester", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <select class="selectpicker form-control" id="ddlSemester">
                                    <option value="0"> -- Select -- </option>
                                    <option value="1">Odd Semester</option>
                                    <option value="2">Even Semester</option>
                                    <option value="3">Non Semester</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="col-md-6">
                            @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="col-md-6">
                            @Html.Label("Type", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                <select id="ddtype" class="form-control  selectpicker">
                                    <option value="0"> -- Select --</option>
                                    <option value="1">CIA Entry</option>
                                    <option value="2">CIA Cumulative</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvCIAExamMarks')" class="btn btn-sm btn-success m-b-10  pull-right"><i class="fa fa-print m-r-5"></i> Print</a>
                        </div>
                </div>

                <div class="form-group col-md-12">
                    <div id="dvCIAExamMarks"></div>
                </div>

                <div class="form-group col-md-12">
                    <a href="javascript:;" id="btnSubmit" class="btn btn-primary hidden pull-right"> Submit </a>
                </div>
            }

        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>


<script>
    $('#ClassList').on('change', function ()
    {
        $('#dvCIAExamMarks').empty();
        $.ajax({
            url: '@Url.Action("FetchCourseByClassIdAndSemTypeId", "Examination")',
            method:'POST',
            datatype: 'json',
            data: { sClassId: $('#ClassList').val(), sSemesterTypeId: $('#ddlSemester').val(), sAcYear: $('#AcademicYearList Option:selected').text() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#CourseList').empty();
                    $('#CourseList').append(data.sResult); // cms-sSemesterId
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#ddtype').on('change', function ()
    {
        BindData();
    });

    $('#CourseList').on('change', function ()
    {
        BindData();
    });

    $('#ClassList').on('change', function ()
    {
        BindData();
    });

    
    function BindData()
    {
        if ($('#CourseList').val() != '0' && $('#ClassList').val() && $('#ddtype').val() != '0')
        {
            var url = null;
            if ($('#ddtype').val() == '1')
            {
                $('#btnSubmit').removeClass('hidden');
                url = "/Examination/BindCIAExamMarkForCOE";
            }
            else if ($('#ddtype').val() == '2')
            {
                $('#btnSubmit').addClass('hidden');
                url = "/Examination/BindCIAComponentMarkList";
            }
            $('#dvCIAExamMarks').empty();
            $.ajax({
                url: url,
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sAcYear: $('#AcademicYearList Option:selected').text() },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else {
                        $('#dvCIAExamMarks').append(data);
                        /*$("#ciaMarkList").DataTable({ "bPaginate": false });*/
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        } 
    }






    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=1300,height=1000');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();

        //var printContents = document.getElementById(divName).innerHTML;
        //var originalContents = document.body.innerHTML;

        //document.body.innerHTML = printContents;

        //window.print();

        //document.body.innerHTML = originalContents;
        //loadContent('/Examination/CIACorrectionForCOE');
       
    }
</script>

<script>
    function Validate()
    {
        var validate = 0;
        $('#ciaMarkList  tbody tr td').each(function ()
        {
            if ($(this).find('input[type="number"]').attr("cms-studentid"))
            {
                if (parseInt($(this).find('input[type="number"]').val()) > parseInt($(this).find('input[type="number"]').attr("max")))
                {
                    $(this).find('input[type="number"]').css('color', 'red');
                    validate = 1;
                } else
                {
                    $(this).find('input[type="number"]').css('color', 'black');
                }
            }
        });
        return validate;
    }

    $('#btnSubmit').on('click', function ()
    {
        var count = 0;
        if (Validate())
        {
            swal({ title: "Warning !", text: "Mark should be less than or equal to Maximum mark !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        //var Search = $('input[type="search"]').val();
        //if (Search != '')
        //{
        //    swal({ title: "Warning !", text: "Please Clear the Search Box !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
        //    return false;
        //}
        addLoadingPanel();
        var sClassId = $('#ClassList').val();
        var sCourseId = $('#CourseList').val();
        var sSemesterId = $('#CourseList Option:selected').attr('cms-sSemesterId');
        var sStudentId;
        var sCourseRootId;
        var sMarkId;
        var sJson;
        if (sJson == null)
        {
            sJson = '{"SAVE_CIA_MARKS":[';
            $('#ciaMarkList tbody tr').each(function ()
            {
                sStudentId = $(this).attr("cms-rstudentid");
                sCourseRootId = sCourseId;
                $(this).find('td').each(function ()
                {
                    if ($(this).find('input[type="number"]').attr("cms-studentid"))
                    {
                        if ($(this).find('input[type="number"]').val() != $(this).find('input[type="number"]').attr("cms-cmark"))
                        {
                            sJson += '{"CLASS_ID":"' + sClassId + '","COURSE_ROOT_ID":"' + sCourseRootId + '","SEMESTER_ID":"' + sSemesterId + '","STUDENT_ID":"' + sStudentId + '","COURSE_ID":"' + sCourseId + '",';
                            sJson += '"CIA_GROUP_MARK_ID":"' + $(this).find('input[type="number"]').attr("cms-ciagroupmarkid") + '","COURSE_GROUP_ID":"' + $(this).find('input[type="number"]').attr("cms-coursegroupid") + '","COURSE_GROUP_MARK":"' + $(this).find('input[type="number"]').val() + '"},';
                            count++;
                        }
                    }
                });
            });

            if (count > 0)
            {
                sJson = sJson.slice(0, -1);
                sJson += ']}';
            } else
            {
                swal({ title: "Warning !", text: "No Changes Made !", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
                return false;
            }
        }

        $.ajax({
            url: '@Url.Action("SaveCIAMarksFromCOE", "Examination")',
            async: false,
            method: "POST",
            content: "application/json; charset=utf-8",
            data: { jsonCIA_MARKS: sJson, sCourseId: sCourseId, sClassId: sClassId },
            success: function (data)
            {
                alert(data); BindData();
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
</script>