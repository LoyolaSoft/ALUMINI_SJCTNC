@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "CIAHallTicket";
    Layout = null;
}
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">CIA Hall Ticket</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Hall Ticket<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">CIA HALL TICKET</h4>
                </div>
                <div class="panel-body">
                    <div class="row form-horizontal">
                        <div class="col-lg-12" style="z-index:1">
                            <span class="pull-right hidden-print">
                                <a href="javascript:;" id="sPrint" onclick="printDiv('dvCIAHallTicket')" class="btn btn-sm btn-success m-b-10"><i class="fa fa-print m-r-5"></i> Print</a>
                            </span>
                        </div><br /><br /><br />

                        <div id="dvCIAHallTicket" >
                           
                                @{
                                    if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
                                    {
                                        <div class="form-group col-xs-12">
                                            <div class="form-group col-xs-2">
                                                <img src="@Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO" style="width:150px; height:150px" />
                                            </div>
                                            <div class="form-group col-xs-8 text-center ">
                                                <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME </h4>
                                                <h5>@Model.liCollegeDetails.FirstOrDefault().PLACE .</h5>
                                                <h6>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h6>
                                                <h6>
                                                    @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                                                    CIA EXAMINATION HALL TICKET<br />
                                                    SEMESTER &nbsp;<b>@Model.liExamRegistrationModel.FirstOrDefault().SEMESTER_NAME</b> &nbsp;&nbsp; MONTH & YEAR &nbsp;&nbsp;FEB-2020<b></b>
                                                </h6>
                                            </div>

                                            <div class="form-group col-xs-2 pull-left">
                                                @{
                                                    if (Session[Common.SESSION_VARIABLES.PHOTO] != null && !string.IsNullOrEmpty(Session[Common.SESSION_VARIABLES.PHOTO].ToString()))
                                                    {
                                                        <img src="@Url.Content(Session[Common.SESSION_VARIABLES.PHOTO].ToString())" alt="Photo" style="width:150px; height:150px" />
                                                    }
                                                    else
                                                    {
                                                        @*<img src="" style="width:180px; height:100px ;border:2px solid gray;" alt="AFFIX YOUR PASSPORT PHOTO HERE" />*@               <div src="" style="border:2px solid gray;width:100px; height:130px;"><p style="text-align:center;">AFFIX HERE YOUR PASSPORT SIZE PHOTOGRAPH TAKEN WITHIN A PERIOD OF THREE MONTHS</p></div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                                    }
                                }

                                @{
                                    if (Model.liExamRegistrationModel != null && Model.liExamRegistrationModel.Count > 0)
                                    {
                                        <div class="col-md-12">
                                            <div class="form-group col-xs-4">
                                                <label> Name : @Model.liExamRegistrationModel.FirstOrDefault().NAME</label>
                                            </div>
                                            <div class="form-group col-xs-4">
                                                <label> Roll No : @Model.liExamRegistrationModel.FirstOrDefault().ROLL_NO</label>
                                            </div>
                                            <div class="form-group col-xs-4">
                                                <label> Semester : @Model.liExamRegistrationModel.FirstOrDefault().SEMESTER_NAME</label>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group col-xs-4">
                                                <label> Major : @Model.liExamRegistrationModel.FirstOrDefault().DEPARTMENT</label>
                                            </div>
                                            <div class="form-group col-xs-4">
                                                <label> Register No : @Model.liExamRegistrationModel.FirstOrDefault().REGISTER_NO</label>
                                            </div>
                                            <div class="form-group col-xs-4">
                                                <label> Date of Birth : @Model.liExamRegistrationModel.FirstOrDefault().DATE_OF_BIRTH</label>
                                            </div>
                                        </div>
                                        @*<table class="table" border="0" cellpadding="30" cellspacing="30">
                                            <tr>
                                                <td><b>Name : </b>&nbsp;@Model.liExamRegistrationModel.FirstOrDefault().NAME</td>
                                                <td><b>Date Of Birth : </b> &nbsp; @Model.liExamRegistrationModel.FirstOrDefault().DATE_OF_BIRTH</td>
                                                <td><b>Roll No : </b> &nbsp; @Model.liExamRegistrationModel.FirstOrDefault().ROLL_NO</td>
                                            </tr>
                                            <tr>
                                                <td><b>Main :</b> &nbsp;@Model.liExamRegistrationModel.FirstOrDefault().DEPARTMENT </td>
                                                <td><b>Semester : </b> &nbsp;@Model.liExamRegistrationModel.FirstOrDefault().SEMESTER_NAME </td>
                                                <td><b>Register No : </b> &nbsp;@Model.liExamRegistrationModel.FirstOrDefault().REGISTER_NO </td>
                                            </tr>
                                        </table>*@
                                    }

                                    if (Model.liFetchHallTicket != null && Model.liFetchHallTicket.Count > 0)
                                    {
                                        var liGroupBy = Model.liFetchHallTicket.GroupBy(x => x.BLOCK_CODE).Select(x => new CMS.ViewModel.Model.FetchHallTicket() { BLOCK_CODE = x.FirstOrDefault().BLOCK_CODE, BLOCK_NAME = x.FirstOrDefault().BLOCK_NAME }).ToList();
                                        <table  align="left" style="width:100%; border:1px solid; table-layout:fixed;">
                                            <thead>
                                                <tr>
                                                    <th width="15% !important" style="border:1px solid; padding:10px;" align="left">CODE</th>
                                                    <th width="30% !important" style="border:1px solid; padding:10px;" align="left">TITLE</th>
                                                    <th width="13% !important" style="border:1px solid; padding:10px;" align="left">DATE</th>
                                                    <th width="17% !important" style="border:1px solid; padding:10px;" align="left">TIME</th>
                                                    <th width="15% !important" style="border:1px solid; padding:10px;" align="left">SEAT</th>
                                                    <th width="10% !important" style="border:1px solid; padding:10px;" align="left">STAFF</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.liFetchHallTicket)
                                                {
                                                    <tr>
                                                        <td width="15% !important" style="border:1px solid; padding:10px;" align="left">@item.COURSE_CODE</td>
                                                        <td width="30% !important" style="border:1px solid; padding:10px;" align="left">@item.COURSE_TITLE</td>
                                                        <td width="13% !important" style="border:1px solid; padding:10px;" align="left">@item.EXAM_DATE</td>
                                                        <td width="17% !important" style="border:1px solid; padding:10px;" align="left">@item.EXAM_TIME</td>
                                                        <td width="15% !important" style="border:1px solid; padding:10px;" align="left">@item.SEAT_CODE</td>
                                                        <td width="10% !important" style="border:1px solid; padding:10px;" align="left"></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <div class="form-group col-xs-12">
                                            <p>
                                                <b>SeatDescription</b> : &nbsp;
                                                BlockCode - RoomNo - Position
                                            </p>
                                        </div>
                                        <div class="form-group">
                                            @if (liGroupBy!=null && liGroupBy.Count>0)
                                            { int nCount = 0;
                                                foreach (var item in liGroupBy)
                                                {
                                                    <div class="col-xs-4">
                                                        <label>@{nCount++;} @nCount . @item.BLOCK_CODE  : @item.BLOCK_NAME</label>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                }
                          
                           
                        </div>
                    </div>
                  
                </div>


            </div>
        </div>
                                }
</div>

<script>
    function ContentLoad() {
        // Document Ready Function ,..
    }

    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
        loadContent('/Examination/CIAHallTicket');

    }
</script>