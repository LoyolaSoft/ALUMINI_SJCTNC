@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}
<div class="col-md-12 table-responsive">
    <table class="table table-bordered" id="tblStudent">
        <thead>
            <tr>
                <th>#</th>
                <th>DummyNo</th>
                <th>RegisterNo</th>
                <th>CourseCode </th>
                <th>Evaluator</th>
               <th>ExamDate</th>               
            </tr>
        </thead>
        <tbody>
            @if (Model.LiExamEvaluation != null && Model.LiExamEvaluation.Count > 0)
            {
                int nCount = 0;
                foreach (var item in Model.LiExamEvaluation)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.DUMMY_NO</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.STAFF_CODE</td>
                        <td>@item.EXAM_DATE</td>
                    </tr>
                                }
                            }

        </tbody>
    </table>
</div>