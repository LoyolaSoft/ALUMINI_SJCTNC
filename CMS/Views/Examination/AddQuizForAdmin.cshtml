<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">MatchTheFollowingForAdmin</li>
    </ol>
    <h1 class="page-header"> Add Quiz </h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Add Quiz</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">

            <div class="col-md-12 form-horizontal">
                <div class="col-md-5 form-group">
                    @Html.Label("Staff List", htmlAttributes: new { @class = "col-md-4 control-label " })
                    <div class="col-md-8">
                        @Html.DropDownListFor(m => m.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "ddlStaffList" })
                        @Html.ValidationMessageFor(m => m.StaffList, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-5 form-group">
                    @Html.Label("Setting", htmlAttributes: new { @class = "col-md-4 control-label " })
                    <div class="col-md-8">
                        @Html.DropDownListFor(m => m.QuizSetting, (Model.QuizSetting != null) ? Model.QuizSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.QuizSetting, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="form-group col-lg-12" id="DataDiv">

            </div>


        </div>
    </div>
</div>
@*<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>*@
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
@*<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>*@

<script>

                ContentLoad = function () {
                  $('.selectpicker').selectpicker({
                      size: 5
                  });
                   $('.selectpicker').selectpicker('refresh');
                }

    //for fetching setting based on staff

                $('#ddlStaffList').change(function () {
                    

                    if($('#ddlStaffList').val())
                    {
                        $.ajax({
                            url: "/Examination/FetchQuizSettingByStaff",
                            type: "post",
                            //contentType: false,
                            //processData: true,
                            data: { sStaffId: $('#ddlStaffList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message)
                                }
                                else {
                                    $('#QuizSetting').empty();
                                    $('#QuizSetting').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                }
                            },
                            error: function () {

                            }
                        });
                    }
                });



                $('#QuizSetting').on("change", function () {
                    var formData = new FormData();
                    var SettingId = $('#QuizSetting').val();

                  //  formData.append('staffId',sStaffId);
                    $.ajax({
                        url: "/Examination/ListMatchTheFollowingForAdmin",
                        type: "post",
                        //contentType: false,
                        //processData: true,
                        data: { sSettingId: SettingId },
                        success:function(data){
                            if(data.Message!=null)
                            {
                                alert(data.Message)
                            }
                            else {
                                $('#DataDiv').html('');
                                $('#DataDiv').append(data);
                            }
                        },
                        error: function () {

                        }
                    });
                });



</script>

