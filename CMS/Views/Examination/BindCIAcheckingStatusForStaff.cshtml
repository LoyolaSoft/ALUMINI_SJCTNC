
@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    /**/

    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


@if (Model.liCiaGroupMarkChecking != null && Model.liCiaGroupMarkChecking.Count > 0)
{
    <br />
    <div class="col-md-12 form-group table-responsive">

        <div class="form-group  col-md-6">

            <lable>Class Name : <b id="txtClassName"></b></lable>
        </div>

        <div class="form-group  col-md-6">

            <lable>Course Name : <b id="txtCourseName"></b></lable>
        </div>


        <table class="table table-bordered" id="tblCIACumulative">
            <thead>
                <tr>
                    <th>#</th>
                    <th>First Name</th>
                    <th>Roll No</th>
                    <th>Class Name</th>
                    @*<th>Max Mark</th>*@
                    <th>Course Title</th>
                    <th>Semester </th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.liCiaGroupMarkChecking != null && Model.liCiaGroupMarkChecking.Count > 0)
                {
                    int nCount = 0;
                    foreach (var item in Model.liCiaGroupMarkChecking)
                    {

                        <tr cms-cid="@item.CIA_GROUP_MARK_CHECKING_ID">
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.FIRST_NAME</td>
                            <td>@item.ROLL_NO</td>
                            <td>@item.CLASS_NAME</td>

                            <td>@item.COURSE_TITLE</td>
                            <td>@item.SEMESTER</td>

                            @if (item.STATUS == "1")
                            {
                                <td>Confirmed</td>
                            }
                            else
                            {
                                <td>Not Confirmed</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="col-md-1 pull-right">
            <button class="btn btn-primary pull-right" onclick="printDiv()" id="btnPrint"> Print </button>
        </div>


    </div>
}


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad() {


    }



    $('#txtClassName').text($('#ClassList option:selected').text());
    $('#txtCourseName').text($('#CourseList option:selected').text());
    function printDiv() {

         $('#btnPrint').addClass("hidden");
        //$('#btnExport').addClass("hidden");
        var printContents = document.getElementById('dvBind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        $('#btnPrint').removeClass("hidden");
    }



</script>
