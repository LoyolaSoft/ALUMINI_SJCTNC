@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "Chief Examiner Order Copy";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<style>
    #HallTicket {
        width: 1050px;
        padding: 5px;
        border: 2px solid gray;
        margin: 0;
        height: auto;
    }

    #Result {
        width: 150px;
        padding: 5px;
        border: 2px solid gray;
        margin: 0;
        height: 150px;
    }
</style>


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active"> Chief Examiner Order Copy</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Chief Examiner Order Copy<small></small></h1>
    <!-- end page-header -->
    @*@using (Html.BeginForm())
        {
            @Html.AntiForgeryToken();*@
    <div class="form-horizontal">
        <div class="panel panel-primary">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Chief Examiner Order Copy</h4>
            </div>
            <div class="panel-body">
                <div class="col-lg-12" style="z-index:1">
                    <span class="pull-right hidden-print">
                        <a href="javascript:;" id="sPrint" onclick="printDiv('dvLoadSubjectDetails')" class="btn btn-sm btn-success m-b-10"><i class="fa fa-print m-r-5"></i> Print</a>
                        @*<a href="javascript:;" id="sPdf" onclick="getPDF()" class="btn btn-sm btn-success m-b-10"><i class="fa fa-print m-r-5"></i> Download</a>*@
                    </span>
                </div><br /><br /><br />
                <div id="dvLoadSubjectDetails">
                    @if (Model.liChiefExaminerOrder != null && Model.liChiefExaminerOrder.Count > 0)
                    {
                        <div class="form-group col-md-12">
                            <div class="col-xs-3">
                                <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:115px; height:110px" />
                            </div>

                            <div class="form-group col-xs-9 text-center">
                                <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h4>
                                <h6 style="margin-top:-10px">
                                    @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                                </h6>
                                <h5 style="margin-top:-10px">@Model.liCollegeDetails.FirstOrDefault().PLACE .</h5>
                                <h5 style="margin-top:-10px">@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY</h5>
                            </div>
                        </div>
                        <br />
                        <br /><br />
                        <div class="col-md-12" style="border-bottom:dashed;margin-top:35px;">

                        </div>
                        <div class="col-md-12" style="font-size:16px;font-family:'Bookman Old Style';text-align:justify;padding:5px;">
                            <div class="col-md-6">
                                <p>
                                    E-Mail: coe@auxiliumcollege.edu.in<br />
                                    Ref: AC/COE/SE Val/@DateTime.Now.ToString("MMMM") @DateTime.Now.ToString("yyyy")/<span>0</span>@Model.liChiefExaminerOrder.FirstOrDefault().STAFF_ALLOTED_ID
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p class="pull-right">@Model.liChiefExaminerOrder.FirstOrDefault().ORDER_DATE</p>
                            </div>
                            <div class="col-md-12">
                                <p class="pull-left">Dear &nbsp;@Model.liChiefExaminerOrder.FirstOrDefault().FIRST_NAME ,</p>
                                <br /><br />
                                <p style='text-align:center;text-indent:71.25pt;line-height:30px;'>Sub: Appointment as the Chief Examiner for SE @Model.liChiefExaminerOrder.FirstOrDefault().EXAM_NAME &ndash; Reg.</p>
                                <p style='line-height:30px;'><span style='font-family:"Bookman Old Style","serif";'>&nbsp;</span></p>
                                <p style='line-height:30px;'>This is to inform you that you are appointed as the Chief Examiner in <strong>@Model.liChiefExaminerOrder.FirstOrDefault().DEPARTMENT</strong>for the valuation of the answer scripts of the Semester Examinations, @Model.liChiefExaminerOrder.FirstOrDefault().EXAM_NAME</p>
                                <br />
                                <p style='line-height:30px;'>
                                    You are requested to convene the meeting of the Board of Examiners before commencing
                                    the valuation work. The Valuation can begin on @Model.liChiefExaminerOrder.FirstOrDefault().DUE_DATE.
                                </p>
                                <br />
                                <p style='line-height:30px;'>
                                    The duties of the Examiners are to be carried out with great responsibility and
                                    accountability. Kindly let me know if any external staff members are to be called for the
                                    valuation.
                                </p>
                                <br />
                                <p style='line-height:30px;'>
                                    <strong>
                                        If you have any of your relatives studying the subject you are handling, kindly
                                        inform the Controller of Examinations.
                                    </strong>
                                </p>
                                <br />
                                <p style='line-height:30px;'>
                                    Your kind cooperation is requested for the smooth and efficient conduct of
                                    the Valuation.
                                </p>

                            </div>
                            <div class="col-md-12">
                                <div class="col-md-6"></div>
                                <div class="col-md-6"></div>
                            </div>
                            <br /><br />
                            <div class="col-md-12">
                                <div class="col-md-4">
                                    <div class="row"><span class="pull-left">Date : @Model.liChiefExaminerOrder.FirstOrDefault().ORDER_DATE</span></div>
                                    <div class="row"></div>
                                    <div class="row"><span class="pull-left">Place : Vellore</span></div>
                                </div>
                                <div class="col-md-4">
                                    <div class="row"></div>
                                    <div class="row"></div>
                                    <div class="row"></div>
                                </div>
                                <div class="col-md-4 pull-right" style="text-align:center;">
                                    <div class="row">Yours sincerely,</div>
                                    <div class="row"><img src="~/Content/hcc_img/COE2024.png" width="100px" /></div>
                                    <div class="row">
                                        <b>
                                            @if (Model.liSignatories.Count > 0 && Model.liSignatories.Count > 0)
                                            {
                                                var coe = Model.liSignatories.Where(o => o.ROLE_ID == "12").ToList();
                                                @coe.FirstOrDefault().SIGNATORIES_NAME
                                            }
                                            else
                                            {

                                            }
                                        </b>
                                    </div>
                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="bg-danger" style="text-align:center;">No Records Found...!</div>
                    }

                </div>
            </div>

        </div>
    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.3.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js"></script>
@*<script src="https://html2canvas.hertzen.com/dist/html2canvas.js"></script>*@
@*<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>*@
<script>


    function printDiv(divName) {
        $('#dvSubmit').addClass('hidden');
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
        loadContent('/Examination/ExaminerOrderCopyForStaff');

    };

    function getPDF() {
        var options = {
        };
        var pdf = new jsPDF('p', 'pt', 'a4');
        pdf.addHTML($("#dvLoadSubjectDetails"), 15, 15, options, function () {
            pdf.save('Hall Ticket.pdf');
            //swal({ title: "Success !", text: 'PDF Downloaded Successfully.. !', showConfirmButton: false, timer: 1500, type: 'Success', animation: true });
        });
        //swal({ title: "Success !", text: 'PDF Downloaded Successfully.. !', showConfirmButton: false, timer: 1500, type: 'Success', animation: true });
        alert('PDF Downloaded Successfully.. !');
    };
</script>



