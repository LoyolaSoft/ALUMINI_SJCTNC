@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListEvaluvationCourseSetting";   
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Evaluation Courses </li>
    </ol>
    <h1 class="page-header">List Evaluation Courses </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Evaluation Courses</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#course_setting" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblcoursesetting">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Exam Name</th>
                            <th>Date</th>
                            <th>Course Code</th>
                            <th>Course Title</th> 
                            <th>Evaluation Type</th>                       
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liEvaluationcoursesetting != null && Model.liEvaluationcoursesetting.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liEvaluationcoursesetting)
                            {
                                count = count + 1;

                                <tr>
                                    <td>@count</td>

                                    <td>@item.EXAM_NAME</td>
                                    <td>@item.EVALUATION_DATE</td>
                                    <td>@item.COURSE_CODE</td>
                                    <td>@item.COURSE_TITLE</td>
                                    <td>@item.IS_EXTERNAL_INTERNAL</td>
                                    <td>
                                        <a href="#update_course_setting" onclick="FetchEvaluationCourseInfoById(@item.EVALUATION_COURSE_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.EVALUATION_COURSE_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="course_setting">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body pBody" data-parsley-validate="true" id="pBody" >
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <div class="col-md-12 form-group">
                                            <label class="col-md-4 control-label">Exam Setting</label>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                            </div>
                                     </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Courses</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true", @multiple = "multiple", @data_selected_text_format="count" })
                                        </div>
                                    </div>
                                    
                                
                                        <div class="col-md-12 form-group">
                                            <label class="col-md-4 control-label">Evaluation Date</label>
                                            <div class="col-md-8">
                                                <input type="text" id="date"  class="form-control input-sm" />
                                            </div>
                                        </div>
                                
                                    <div class="col-md-12 col-md-offset-4">

                                        <div class="form-group col-md-4">
                                            <div class="radio radio-inline radio-css">
                                                <input type="radio" name="Radio" id="Radio1"  value="1" />
                                                <label for="Radio1">
                                                    External
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group col-md-offset-2 col-md-4">
                                            <div class="radio radio-inline radio-css">
                                                <input type="radio" name="Radio" id="Radio2" value="2" />
                                                <label for="Radio2">
                                                    Internal
                                                </label>
                                            </div>
                                        </div>
                                    </div>                             
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;"  class="btn btn-sm btn-primary btnSubmit" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<div class="modal" id="update_course_setting">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body " data-parsley-validate="true" id="pBody1">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Exam Setting</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true",@id="examsetting" })
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Courses</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true",@id="courselist" })
                                        </div>
                                    </div>

                                 
                                        <div class="col-md-12 form-group">
                                            <label class="col-md-4 control-label">Evaluation Date</label>
                                            <div class="col-md-8">
                                                <input type="text" id="date1" class="form-control input-sm" />
                                            </div>
                                        </div>
                                 
                                    <div class="col-md-12 col-md-offset-4">

                                        <div class="form-group col-md-4">
                                            <div class="radio radio-inline radio-css">
                                                <input type="radio" name="Radio" id="cssRadio1" value="1" />
                                                <label for="cssRadio1">
                                                    External
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group col-md-offset-2 col-md-4">
                                            <div class="radio radio-inline radio-css">
                                                <input type="radio" name="Radio" id="cssRadio2" value="2" />
                                                <label for="cssRadio2">
                                                    Internal
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @Html.Hidden("coursesettingid");
            <div class="modal-footer">
                <a href="javascript:;"  class="btn btn-sm btn-primary btnUpdate" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }

        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

        
        $('#tblcoursesetting').DataTable();

        handleDatepicker = function ()
        {
            "use strict";

            $("#date").datepicker({
                todayHighlight: true,
                autoclose: true,
              //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#date1").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();
    
        function FetchEvaluationCourseInfoById(ID)
        {
           
            if (ID != null)
            {
                $.ajax({
                    url: "@Url.Action("FetchEvaluvationCourseSettingById", "Examination")",
                    type:"post",
                    data: { EvaluationCoursesettingId: ID },
                success:function(data)
                {
                    if(data.MESSAGE!=null)
                    {
                        alert(data.MESSAGE);
                    }
                    else
                    {
                        if (data != null)
                        {
                            $('#courselist').val(data.COURSE_ID);
                            $('#examsetting').val(data.EXAM_SETTING_ID);
                            $('#date1').val(data.EVALUATION_DATE);
                            $('#coursesettingid').val(data.EVALUATION_COURSE_SETTING_ID);
                            if (data.IS_EXTERNAL_INTERNAL == "1") {

                                $('#cssRadio1').prop('checked', true);
                            }
                            else if (data.ROLE == "2") {
                                $('#cssRadio2').prop('checked', true);
                            }
                            $('.selectpicker').selectpicker('refresh');
                        }


                    }

                },
                error:function(ex)
                {
                    alert(ex.Message);
                }
            });
        }
        }
    GetConfirm = function (ID)
    {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteEvaluationCourse", "Examination")",
        type: "post",
        data: { EvaluationCoursesettingId: ID },
    success: function (data) {
        if (data.Message != null && data.Message != "")
        {
            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
            loadContent('/Examination/ListEvaluvationCourseSetting');
        }
    },
    error: function (ex) {
        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

    }


});
    });

    }
    $('.btnSubmit').click(function ()
    {
        var JsonData=null;    
        var Is_external_internal=null;
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) 
        {
            return false;
        }            
        if (Radio1.checked == true) 
        {
            Is_external_internal=1;
        }
        if(Radio2.checked == true)
        {
            Is_external_internal=2;    
        }
        if (cssRadio1.checked == true) {
            Is_external_internal = 1;
        }
        if (cssRadio2.checked == true) {
            Is_external_internal = 2;
        }
        JsonData = '{"EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '","COURSE_ID":"' + $('#CourseList').val() + '","EVALUATION_DATE":"' + $('#date').val() + '","IS_EXTERNAL_INTERNAL":"' + Is_external_internal + '"}';
        var req=  $.ajax({
            url: "@Url.Action("SaveorUpdateEvaluavationCourse", "Examination")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {
            if (data.Message != null && data.Message != "")
            {
                if (data.ErrorCode == "200")
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    loadContent('/Examination/ListEvaluvationCourseSetting');
                }
                if (data.ErrorCode == "417") {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
                if (data.ErrorCode == "503") {
                    swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                }


            }
        },
        error: function (ex) {
            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
        }

    });          
    });
    $('.btnUpdate').click(function ()
    {
        var JsonData=null;    
        var Is_external_internal=null;
        var isValid = true;
        if ($('#pBody1').parsley().validate() !== true) isValid = false;
        if (!isValid) 
        {
            return false;
        }            
        if (Radio1.checked == true) 
        {
            Is_external_internal=1;
        }
        if(Radio2.checked == true)
        {
            Is_external_internal=2;    
        }
        if (cssRadio1.checked == true) {
            Is_external_internal = 1;
        }
        if (cssRadio2.checked == true) {
            Is_external_internal = 2;
        }
        JsonData = '{"EXAM_SETTING_ID":"' + $('#examsetting').val() + '","COURSE_ID":"' + $('#courselist').val() + '","EVALUATION_DATE":"' + $('#date1').val() + '","IS_EXTERNAL_INTERNAL":"' + Is_external_internal + '","EVALUATION_COURSE_SETTING_ID":"' + $('#coursesettingid').val() + '"}';
        var req=  $.ajax({
            url: "@Url.Action("SaveorUpdateEvaluavationCourse", "Examination")",
            type: "post",
            data: { sJsonData: JsonData },
        success: function (data) {
            if (data.Message != null && data.Message != "")
            {
                if (data.ErrorCode == "200")
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    loadContent('/Examination/ListEvaluvationCourseSetting');
                }
                if (data.ErrorCode == "417") {
                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
                if (data.ErrorCode == "503") {
                    swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                }


            }
        },
        error: function (ex) {
            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
        }

    });          
    });
</script>

