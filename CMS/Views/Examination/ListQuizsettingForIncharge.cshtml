@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Quiz Setting</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Quiz Setting</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Quiz Setting</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">

                        <div class="col-md-12 form-group">
                            <div class="col-md-4 form-group">
                                @Html.Label("Quiz Type", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Quiztype, (Model.Quiztype != null) ? Model.Quiztype : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Quiztype, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Date", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                   <input type="text" id="date" class="form-control" placeholder="Select Date"/>
                                </div>
                            </div>
                            <div class="col-md-2 form-group">
                                <button class="btn btn-primary" id="btnget">Get</button>
                            </div>
                                            
                        </div>
                        <div class="col-md-12" id="BindQuizSetting">

                        </div>
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<!-- Begin Modal -->

<div class="modal" id="QuizSetting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Quiz Setting</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <input type="hidden" id="hdSettingId"/>
                            <div class="col-md-12" id="dvValidate" data-parsley-validate="true">
                                <!-- Exam Type -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Exam Type</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(m => m.Quiztype, (Model.Quiztype != null) ? Model.Quiztype : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true",@id="ddlquiztype" })
                                        @Html.ValidationMessageFor(m => m.Quiztype, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <!-- Setting Name-->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Setting Name</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtSettingName" class="form-control" placeholder="Enter Setting Name" data-parsley-required="true">
                                    </div>
                                </div>

                                <!-- No Of Questions -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label"> No Of Questions</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtNoOfQuestions" class="form-control" placeholder="Enter No Of Questions" data-parsley-required="true">
                                    </div>
                                </div>

                                <!-- Mark Per Question -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Mark Per Question</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtMarkPerQuestion" class="form-control" placeholder="Enter Mark Per Question" data-parsley-required="true">
                                    </div>
                                </div>

                                <!-- Total Mark -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Total Mark</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtTotalMark" class="form-control" disabled placeholder="Total Mark">
                                    </div>
                                </div>

                                <!-- Time -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Time (Minutes)</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtTime" class="form-control" placeholder="Enter Time" data-parsley-required="true">
                                    </div>
                                </div>

                                <!-- Start Date -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Start Date</label>
                                    <div class="col-md-9">
                                        <div class="input-group date" id="datetimepicker1">
                                            <input type="text" id="txtStartDate" class="form-control input-sm" placeholder="Select Date" data-parsley-required="true" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 col-form-label">After The Attempt</label>
                                    <div class="col-md-9">

                                        <div class="checkbox checkbox-css">
                                            <input type="checkbox" id="chCorrect" value="" />
                                            <label for="chCorrect">Evaluate Questions</label>
                                        </div>
                                        <div class="checkbox checkbox-css">
                                            <input type="checkbox" id="chMarks" value="" />
                                            <label for="chMarks">Show Marks</label>
                                        </div>
                                        <div class="checkbox checkbox-css">
                                            <input type="checkbox" id="chRightAnswer" value="" />
                                            <label for="chRightAnswer">Show Correct Answers</label>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->

<!-- Begin Modal -->

<div class="modal" id="QuizSetting-preview">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Questions</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <input type="hidden" id="courseid">
                        <input type="hidden" id="classid">
                        <input type="hidden" id="staffid">
                        <input type="hidden" id="settingid">
                        <div class="form-horizontal" >
                            <div class="col-md-4 form-group">
                                @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Set, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12" id="bindquestions">

                            </div>
                        </div>
                    </div>
                </div>

            </div>
          
        </div>
    </div>
</div>
<!-- End Modal -->





<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>
    
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    $("#txtEndDate,#txtStartDate").datepicker({
        todayHighlight: true,
        autoclose: true,      
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });
    $("#date").datepicker({
        todayHighlight: true,
        autoclose: true,
        format: "dd/mm/yyyy",
        orientation: "right bottom"
    });

    $('#btnget').on('click', function ()
    {
        var quiztype = $('#Quiztype').val();
        var date = $('#date').val();
        $.ajax({
            url: '/Examination/FetchQuizSettingByQuiztype',
            method: 'POST',
            datatype: 'json',
            data: { sQuiztype: quiztype, sDate: date },
            success: function (data)
            {

                $('#BindQuizSetting').empty();
                $('#BindQuizSetting').append(data);
              
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });


    function Successcall()
    {
        var quiztype = $('#Quiztype').val();
        var date = $('#date').val();
        $.ajax({
            url: '/Examination/FetchQuizSettingByQuiztype',
            method: 'POST',
            datatype: 'json',
            data: { sQuiztype: quiztype, sDate: date },
            success: function (data) {

                $('#BindQuizSetting').empty();
                $('#BindQuizSetting').append(data);

            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

</script>

<script>
      $('#txtMarkPerQuestion').on('focusout', function ()
    {

        var vTotalmark = $('#txtNoOfQuestions').val() * $('#txtMarkPerQuestion').val();
        $('#txtTotalMark').val(vTotalmark)
    });

    // On Submit Setting ...
    $('#btnSubmit').on('click', function ()
    {
        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }
        var IsCorrect = 0;
        var IsRightAnswer = 0;
        var IsMarkShow = 0;
        if ($('#chCorrect').is(':checked'))
        {
            IsCorrect = 1;
        }

        if ($('#chMarks').is(':checked')) {
            IsMarkShow = 1;
        }

        if ($('#chRightAnswer').is(':checked')) {
            IsRightAnswer = 1;
        }


            var JsonData = null;
            JsonData = '{"SETTING_ID":"' + $('#hdSettingId').val() + '",\
                         "SETTING_NAME":"' + $('#txtSettingName').val() + '",\
                         "QUIZ_TYPE_ID":"' + $('#ddlquiztype').val() + '",\
                         "NO_OF_QUESTIONS":"' + $('#txtNoOfQuestions').val() + '",\
                         "EACH_QUESTION_MARKS":"' + $('#txtMarkPerQuestion').val() + '",\
                         "TOTAL_MARK":"' + $('#txtTotalMark').val() + '",\
                         "START_DATE":"' + $('#txtStartDate').val() + '",\
                         "TIME":"' + $('#txtTime').val() + '",\                         "IS_CORRECT":"' + IsCorrect + '",\
                         "IS_SHOW_MARKS":"' + IsMarkShow + '",\
                         "IS_SHOW_RIGHT_ANSWER":"' + IsRightAnswer + '"\}';
            $.ajax({
                url:'@Url.Action("SaveOverallQuizSetting", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sSaveQuizSetting:JsonData },
                success: function (data)
                {
                    alert(data.Message);
                    //loadContent('/Examination/QuizSetting');
                    //$('#btnGet').click();
                    $('#QuizSetting-dialog').modal('hide');
                    Successcall();
                   
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });

    });
</script>
<script>
    // Activate Setting ...
    function SetActive(ID)
    {
        if (!confirm('Are you sure to Activate ?'))
        {
            return false;
        } else {
            $.ajax({
                url:"@Url.Action("UpdateActiveQuizSetting", "Examination")",
                method: "POST",
                datatype:"json",
                data: { sQuizSettingId: ID, sActive: '1', sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                success:function(data)
                {
                    alert(data.Message);
                  
                    Successcall();
                    
                },error:function(error)
                {
                    alert('Internal Server Error ! ');
                }
            });
        }

    }

    // De - Activate Setting ...
    function SetDeActive(ID)
    {
        if (!confirm('Are you sure to De - Activate ?'))
        {
            return false;
        }
        $.ajax({
            url:"@Url.Action("UpdateActiveQuizSetting", "Examination")",
            method: "POST",
            datatype:"json",
            data: { sQuizSettingId: ID, sActive: '0', sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
            success:function(data)
            {
                alert(data.Message);
                
                Successcall();
            },error:function(error)
            {
                alert('Internal Server Error ! ');
            }
        });
    }

    // Delete Setting ...
    function GetConfirm(ID)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        }
        else
        {
            $.ajax({
                url:"@Url.Action("DeleteQuizSetting", "Examination")",
                method: "POST",
                datatype:"json",
                data: { sSettingId: ID },
                success:function(data)
                {
                    alert(data.Message);              
                    Successcall();
                },error:function(error)
                {
                    alert('Internal Server Error ! ');
                }
            });
        }
    }

    // Fetch Settin Info ...
    function FetchSettingInfo(ID)
    {
        $.ajax({
            url:"@Url.Action("FetchQuizSetting", "Examination")",
            method: "POST",
            datatype:"json",
            data: { sSettingId: ID },
            success:function(data)
            {
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#txtSettingName').val(data[0].SETTING_NAME);
                    $('#txtNoOfQuestions').val(data[0].NO_OF_QUESTIONS);
                    $('#txtMarkPerQuestion').val(data[0].EACH_QUESTION_MARKS);
                    $('#txtTotalMark').val(data[0].TOTAL_MARK);
                    $('#txtStartDate').val(data[0].START_DATE);
                    $('#txtEndDate').val(data[0].END_DATE);
                    $('#txtTime').val(data[0].TIME);
                    $('#hdSettingId').val(data[0].SETTING_ID);
                    $('#ddlquiztype').val(data[0].QUIZ_TYPE_ID);

                    if (data[0].IS_CORRECT=="1")
                    {
                        $('#chCorrect').click();
                    }

                    if (data[0].IS_SHOW_MARKS=="1")
                    {
                        $('#chMarks').click();
                    }

                    if (data[0].IS_SHOW_RIGHT_ANSWER=="1")
                    {
                        $('#chRightAnswer').click();
                    }
                    $('.selectpicker').selectpicker('refresh');
                }
            },error:function(error)
            {
                alert('Internal Server Error ! ');
            }
        });
    }
    $("#QuizSetting-dialog").on("hidden.bs.modal", function () {
        $('#txtSettingName').val('');
        $('#txtNoOfQuestions').val('');
        $('#txtMarkPerQuestion').val('');
        $('#txtTotalMark').val('');
        $('#txtTime').val('');
        $('#txtStartDate').val('');
        $('#hdSettingId').val('');
        if ($('#chCorrect').is(':checked')) {
            $('#chCorrect').click();
        }

        if ($('#chMarks').is(':checked')) {
            $('#chMarks').click();
        }

        if ($('#chRightAnswer').is(':checked')) {
            $('#chRightAnswer').click();
        }
    });
    function FetchSettingQuestionpreview(CID,CLASSID,SETTINGID,STAFFID)
    {
        
        $('#courseid').val(CID);
        $('#classid').val(CLASSID);
        $('#settingid').val(SETTINGID);
        $('#staffid').val(STAFFID);

    }

    $('#Set').on('change', function ()
    {
        var courseids = $('#courseid').val();
        var classid = $('#classid').val();
        var settingid = $('#settingid').val();
        var staffid = $('#staffid').val();
        var setid = $(this).val();
        $.ajax({
            url: '/Examination/BindOverallOnlineQuizPreview',
            method: 'POST',
            datatype: 'json',
            data: { sClassId: classid, sCourseId: courseids, sSetId: setid, sSettingId: settingid, sUserId: staffid },
            success: function (data)
            {

                $('#bindquestions').empty();
                $('#bindquestions').append(data);
                $('.selectpicker').selectpicker('refresh');

            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
</script>
