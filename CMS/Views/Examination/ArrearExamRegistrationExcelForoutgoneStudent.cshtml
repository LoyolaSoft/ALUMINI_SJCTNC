@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Arrear Outgone Student Registration</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Arrear Outgone Student Registration<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Arrear Outgone Student Registration</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

            <div class="form-horizontal">

                <div class="form-group  col-md-12">

                    <div class="col-md-4">
                        @Html.Label("File", htmlAttributes: new { @class = "col-md-3 control-label " })
                        <div class="col-md-9">
                            <input type="file" class="hidden" id="ExcelUpload" />
                            <a class="btn  btn-sm btn-info" onclick="ClickFile()">File</a>
                            <span id="fileName" class="ml-2 text-primary"></span>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <a href="javascript:;" class="btn  btn-sm btn-primary" id="btnGet">Submit</a>
                    </div>
                    <div class="col-md-2">
                        <a href="~/Content/ExcelTemplate/Exam_registration_Template.xls" id="btndownloadTemplate" download class="btn btn-sm btn-danger m-b-10 pull-right"><i class="fa fa-print m-r-5"></i> Download Template</a>

                    </div>
                </div>
              

                <div class="row">
                    <a href="#" id="btndownload" download class="btn btn-sm btn-success m-b-10 pull-right"><i class="fa fa-print m-r-5"></i> Download Log</a>
                </div>

            </div>

                <div id="dvSemHallTicket"></div>

            }

        </div>

    </div>
</div>

<div class="modal" id="LogModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" onclick="CloseModal()" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Missing Student and Course List</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12" id="binddiv">
                           
                        </div>
                    </div>
                </div>
            </div>
          
        </div>
       
    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>


<script>

    function ClickFile()
    {
        $('#ExcelUpload').click();
    }
	function CloseModal()
	{
	 $('#LogModal').hide();
	}

    $('#ExcelUpload').on('change', function () {
        var fileName = $(this).val().split('\\').pop(); // get filename only
        $('#fileName').text(fileName); // show it in span
    });
    $('#btnGet').on('click', function ()
    {
        var sFlag = false;
        var formData = new FormData();
        var sFile = $('#ExcelUpload').get(0).files;
        if (sFile.length != 0) {
            for (var i = 0; i < sFile.length; i++)
            {
                formData.append(sFile[i].name, sFile[i]);
                sFlag = true;
            }
        }
        if (sFlag)
        {
            $.ajax({
                url: '@Url.Action("BindArrearExamRegistrationForoutgoneStudent", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data)
                {
                    alert(data.Message);
					
					if(data.sResult!="")
					{
						$('#btndownload').attr('href',data.sResult);
					}
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
        loadContent('/Examination/ArrearExamRegistrationExcelForoutgoneStudent');
    }
</script>
