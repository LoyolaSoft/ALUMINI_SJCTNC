@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Overall CIA Marks</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Overall CIA Marks<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" onclick="location.reload();" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CIA Exam Results</h4>
        </div>
        <div class="panel-body">
            @if (Model.liCIA_Marks_Info != null && Model.liCIA_Marks_Info.Count > 0)
            {
                var liGroupSemester = Model.liCIA_Marks_Info.GroupBy(x => x.SEMESTER_ID).OrderByDescending(x => x.Key).ToList();

                foreach (var GroupSemesteritem in liGroupSemester)
                {
                    var currentSemesterId = GroupSemesteritem.Key;
                    var liCourse = Model.liExamRegistrationList.Where(x => x.SEMESTER_ID == currentSemesterId).ToList();
                    var liGroupComponent = Model.liCIA_Marks_Info.Where(x => x.SEMESTER_ID == currentSemesterId).GroupBy(x => x.COURSE_GROUP_ID).ToList();

                    <div class="m-b-20">
                        <div class="alert alert-info fade in m-b-10">
                            <strong>Semester @currentSemesterId - CIA Marks</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-striped">
                                <thead>
                                    <tr class="info">
                                        <th style="min-width: 150px;">Component</th>
                                        @if (liCourse != null && liCourse.Count > 0)
                                        {
                                            foreach (var item in liCourse)
                                            {
                                                <th class="text-center">@item.COURSE_CODE <br /><small>@item.COURSE_TITLE</small></th>
                                            }
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in liGroupComponent)
                                    {
                                        <tr>
                                            <td class="f-w-600">@item.FirstOrDefault().COMPONENT</td>
                                            @foreach (var Examitem in liCourse)
                                            {
                                                var liCIAMarks = Model.liCIA_Marks_Info.Where(x => x.COURSE_ID == Examitem.COURSE_ID && x.COMPONENT_ID == item.FirstOrDefault().COMPONENT_ID && x.SEMESTER_ID == currentSemesterId).ToList();
                                                if (liCIAMarks != null && liCIAMarks.Count > 0)
                                                {
                                                    var mark = liCIAMarks.FirstOrDefault().COURSE_GROUP_MARK;
                                                    if (mark == "-1") { mark = "A"; }
                                                    <td class="text-center">@mark</td>
                                                }
                                                else
                                                {
                                                    <td class="text-center"> - </td>
                                                }
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="active">
                                        <td class="f-w-700">Total Marks</td>
                                        @if (Model.liCIA_Total != null && Model.liCIA_Total.Count > 0)
                                        {
                                            foreach (var Examitem in liCourse)
                                            {
                                                var liCIAMarks = Model.liCIA_Total.Where(x => x.COURSE_ID == Examitem.COURSE_ID && x.SEMESTER_ID == currentSemesterId).ToList();
                                                if (liCIAMarks != null && liCIAMarks.Count > 0)
                                                {
                                                    var total = liCIAMarks.FirstOrDefault().TOTAL;
                                                    if (total == "-1") { total = "A"; }
                                                    <td class="text-center f-w-700">@total</td>
                                                }
                                                else
                                                {
                                                    <td class="text-center"> - </td>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            foreach (var Examitem in liCourse)
                                            {
                                                <td class="text-center"> - </td>
                                            }
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <hr class="bg-silver-lighter" />
                }
            }
            else
            {
                <div class="alert alert-warning">
                    <p>No CIA marks found for the current academic session.</p>
                </div>
            }
        </div>
    </div>
</div>


