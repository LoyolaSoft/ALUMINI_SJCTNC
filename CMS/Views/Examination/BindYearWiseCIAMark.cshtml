
@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}


@if (Model.liCIA_Total != null && Model.liCIA_Total.Count > 0)
{
    <div class="col-md-12">
        <table class="table table-bordered" id="tblCIACumulative" border="1">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Roll No</th>
                    <th>Course Code</th>
                    <th>Mark</th>
                </tr>
            </thead>
            <tbody>
                @{
                    //int nCount = 0;
                    var liStudentList = Model.liCIA_Total.GroupBy(x => x.STUDENT_ID).OrderBy(x => x.FirstOrDefault().ROLL_NO).ToList();
                    if (liStudentList != null && liStudentList.Count > 0)
                    {
                        int nCount = 0;
                        foreach (var item in liStudentList)
                        {

                            var liCIAMark = Model.liCIA_Total.Where(x => x.STUDENT_ID == item.FirstOrDefault().STUDENT_ID).ToList();
                            foreach (var mark in liCIAMark)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.FirstOrDefault().ROLL_NO</td>
                                    <td>@mark.COURSE_CODE</td>

                                    @if (mark.TOTAL == "-1")
                                    {
                                        <td>A</td>
                                    }
                                    else
                                    {
                                        <td>@mark.TOTAL</td>
                                    }

                                </tr>
                            }

                        }
                    }
                }
            </tbody>
        </table>
    </div>
}
