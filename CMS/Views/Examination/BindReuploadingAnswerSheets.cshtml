@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = "~/Views/Shared/_OnlineExamLayout.cshtml";
    int count = 0;
}



<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Reuploading Answer Sheet</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Reuploading Answer Sheet</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
       
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12  table-responsive">
                         
                                    <table class="table table-bordered" id="studentlist">
                                        <thead>
                                            <tr>
                                                <td>#</td>
                                                <td>Question</td>
                                                <td>Image</td>
                                                <td>Action</td>                                              
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Liexamquesions != null && Model.Liexamquesions.Count > 0)
                                            {
                                                foreach (var item in Model.Liexamquesions)
                                                {

                                                    count++;
                                                    <tr>
                                                        <td>@count</td>
                                                        <td>@(new HtmlString(Model.GetStrigFromBase64String(item.QUESTION)))</td>
                                                        <td><a href="#imagemodal" data-target="#imagemodal" data-toggle="modal"  imagepath="@item.IMAGE_PATH" id="@count"   onclick="DisplayImage(@count)"><img src="@item.IMAGE_PATH" style="width:100px;height:100px"></a></td>
                                                                                                            
                                                        <td><a class="btn btn-primary" href="@Url.Action("ReuploadingAnswerSheet","Examination", new { sExaminvigilationId = item.EXAM_INVIGILATION_ID, sQuizSaveId =item.QUIZ_SAVE_ID,sQuestiontypeId=item.QUESTION_TYPE_ID})">Reupload</a></td>                                                  
                                                    </tr>

                                                }

                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="8">No Records Found...!</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                        </div>

                    </div>
             
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<!-- Begin Modal -->
<div class="modal" id="imagemodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Answer Sheet</h4>
            </div>
            <div class="modal-body">
                <img src="" id="bindimage" style="width:100%;height:500px">
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="newcount" value="0">
<!-- End Modal -->

<script>
   
    function DisplayImage(ID)
    {
       
        var src = $('#' + ID).attr('imagepath');
        if (src != "")
        {
            $('#bindimage').attr('src', src);
        }
    }
</script>




