@{
    Layout = null;
}

<style>


    .container-custom {
        width: 100%;
    }

    /* Profile Header */
    .profile-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        margin-bottom: 40px;
    }

    .profile-avatar {
        width: 50px;
        height: 50px;
        background-color: #e2e8f0;
        color: #1a202c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
        margin-right: 20px;
    }

    .profile-info {
        flex-grow: 1;
    }

    .profile-name {
        font-size: 20px;
        font-weight: 600;
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .profile-status {
        background-color: #2f855a;
        color: #c6f6d5;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .profile-details {
        color: var(--text-secondary);
        font-size: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin: 0;
    }

        .profile-details span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

    /* Section Titles */
    h2.section-title {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #242a30;
        margin-bottom: 15px;
        margin-top: 30px;
        font-weight: bold;
    }

    /* Registered Empty State */
    .empty-state {
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        color: var(--text-secondary);
        font-size: 14px;
        margin-bottom: 30px;
    }

    /* Course Grid */
    .scrollable-box {
        max-height: 450px;
        overflow-y: auto;
        padding-right: 8px;
        margin-bottom: 20px;
    }

        /* Scrollbar styling for a modern look */
        .scrollable-box::-webkit-scrollbar {
            width: 6px;
        }

        .scrollable-box::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .scrollable-box::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
        }

            .scrollable-box::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }

    .course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 210px);
        gap: 15px;
        padding-bottom: 10px; /* Extra padding at the bottom for scrolling */
        justify-content: flex-start;
    }

    .course-card {
        background-color: var(--bg-card);
        border: 1px solid #b6c2c9;
        border-radius: 8px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        cursor: pointer;
    }

        .course-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
            border-color: #b6c2c9;
        }

        .course-card.selected {
            border: 2px solid #28a745;
            background-color: #f0fff4;
            box-shadow: 0 2px 8px rgba(40, 167, 69, 0.2);
        }

        .course-card.selected-cancel {
            border: 2px solid #ff5b57;
            background-color: #fff5f5;
            box-shadow: 0 2px 8px rgba(255, 91, 87, 0.2);
        }

    .course-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .course-code {
        color: var(--text-secondary);
        font-size: 13px;
        font-weight: 600;
    }

    .course-credits {
        background-color: var(--accent-blue);
        color: var(--accent-blue-text);
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 8px;
        border: 1px solid #c8d9ea;
    }

    .course-title {
        font-size: 12px;
        font-weight: 600;
        margin: 0 0 10px 0;
        color: var(--text-primary);
        line-height: 1.4;
    }

    .course-desc {
        color: var(--text-secondary);
        font-size: 13px;
        line-height: 1.5;
        margin: 0 0 15px 0;
        flex-grow: 1;
    }

    .course-meta {
        color: var(--text-secondary);
        font-size: 13px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

        .course-meta div {
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* Buttons */
    .btn-custom {
        background-color: #e8f5e9;
        color: #28a745;
        border: 1px solid #28a745;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        width: 100%;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-custom:hover {
            background-color: #d4edda;
            border-color: #218838;
            color: #218838;
        }

    .btn-custom-cancel {
        border-color: #ff5b57;
        color: #ff5b57;
        background-color: #ffeeee;
    }

        .btn-custom-cancel:hover {
            background-color: #ffd6d6;
            border-color: #e5524e;
        }

    .btn-batch {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: bold;
        margin-bottom: 12px;
        cursor: pointer;
        display: none;
    }

        .btn-batch:hover {
            background-color: #218838;
        }

    .btn-batch-cancel {
        background-color: #ff5b57;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: bold;
        margin-bottom: 12px;
        cursor: pointer;
        display: none;
    }

        .btn-batch-cancel:hover {
            background-color: #e5524e;
        }

    /* Test Input */
    .test-input {
        margin-bottom: 20px;
        padding: 15px;
        background: var(--bg-card);
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

        .test-input input {
            padding: 8px;
            background: #ffffff;
            border: 1px solid #ccd0d4;
            color: #333;
            border-radius: 4px;
        }

        .test-input button {
            padding: 8px 15px;
            background: #00acac;
            border: none;
            color: white;
            border-radius: 4px;
            cursor: pointer;
        }

        /* Notice Banner */
        .notice-banner {
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            border: 1px solid #90caf9;
            border-radius: 8px;
            color: #0d47a1;
            padding: 15px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            box-shadow: 0 4px 6px rgba(0, 123, 255, 0.05);
        }

        .notice-content {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }

        .notice-icon {
            color: #1565c0;
            flex-shrink: 0;
        }

        .notice-text {
            font-size: 14px;
            font-weight: 500;
            line-height: 1.5;
        }

        .notice-btn {
            background: #1565c0;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-weight: 600;
            text-decoration: none;
            color: white !important;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.2s, transform 0.2s;
            box-shadow: 0 2px 4px rgba(21, 101, 192, 0.2);
            white-space: nowrap;
        }

        .notice-btn:hover {
            background: #0d47a1;
            transform: translateY(-1px);
        }

        @@media (max-width: 768px) {
            .notice-banner {
                flex-direction: column;
                align-items: stretch;
                text-align: left;
                gap: 12px;
            }
            .notice-content {
                align-items: flex-start;
            }
            .notice-btn {
                justify-content: center;
                width: 100%;
            }
            .course-grid {
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)) !important;
            }
            .course-card {
                min-height: auto !important;
            }
        }
        @@media (max-width: 480px) {
            .course-grid {
                grid-template-columns: 1fr !important;
            }
        }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Arrear Registration</li>
    </ol>
    <h1 class="page-header">Arrear Registration </h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Arrear Registration</h4>
        </div>
        <div class="panel-body">
            <div class="container-custom">
                <!-- Optional Test input to simulate different students -->
                <div class="test-input" style="display: none;" id="testPanel">
                    <label>Student ID </label>
                    <input type="text" id="txtStudentId" value="@ViewBag.StudentId" />
                    <input type="hidden" id="txtProgrammeGroupId" value="@ViewBag.ProgrammeGroupId" />
                    <input type="hidden" id="txtFrequencyId" value="@ViewBag.FrequencyId" />
                    <button onclick="loadCourses()">Load Data</button>
                </div>

                <div class="profile-card">
                    <div class="profile-avatar" id="avatarInitials">@(string.IsNullOrEmpty(ViewBag.StudentName) ? "ST" : (((string)ViewBag.StudentName).Length >= 2 ? ((string)ViewBag.StudentName).Substring(0, 2).ToUpper() : ((string)ViewBag.StudentName).ToUpper()))</div>
                    <div class="profile-info">
                        <h1 class="profile-name">
                            @ViewBag.StudentName
                            @*<span class="profile-status">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    Active
                                </span>*@
                        </h1>
                        <p class="profile-details">
                            <span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                <span id="lblRegNo">Roll No: @ViewBag.RegisterNumber</span>
                            </span>
                            <span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                @ViewBag.ClassName
                            </span>
                        </p>
                    </div>
                </div>

                <div class="notice-banner">
                    <div class="notice-content">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="notice-icon"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        <span class="notice-text">
                            For further details, you are requested to check the college website regularly.
                        </span>
                    </div>
                    <a href="https://sjctnc.edu.in/" target="_blank" class="notice-btn">
                        <span>Visit Website</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>

                <h2 class="section-title">Registered Courses</h2>
                <button id="btnCancelSelected" class="btn-batch-cancel" onclick="cancelSelected()">Cancel Selected (0)</button>
                <div id="registeredContainer">
                    <div id="registeredSummary" style="display:none; margin-bottom: 15px; padding: 15px; background: #f8f9fa; border: 1px solid #e2e8f0; border-radius: 6px; font-weight: 500; font-size: 14px; color: #333;"></div>
                    <div class="empty-state" id="emptyRegistered">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        No courses registered yet  click "Register" on any course below.
                    </div>
                    <div class="course-grid scrollable-box" id="gridRegistered" style="display: none;"></div>
                </div>

                <h2 class="section-title">Available Courses</h2>
                <button id="btnRegisterSelected" class="btn-batch" onclick="registerSelected()">Register Selected (0)</button>
                <div class="course-grid scrollable-box" id="gridAvailable">
                    <div class="empty-state" style="grid-column: 1 / -1; display: none;" id="emptyAvailable">
                        No available arrear courses found.
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        // Un-comment to show test panel
        // $('#testPanel').show();

        // Initial load
        loadCourses();
    });

    function loadCourses() {
        var studentId = $('#txtStudentId').val() || ''; // Will fallback to Session ID on server if empty

        $.ajax({
            url: '/Examination/GetStudentArrearCourses',
            type: 'POST',
            data: { StudentId: studentId },
            success: function (res) {
                if (res.sResult === "True") {
                    window.arrearFeeAmount = parseFloat(res.sResultS || "0");
                    window.totalRegisteredAmount = parseFloat(res.Message || "0");
                    renderCourses(res.oResult);
                } else {
                    swal({ title: "Error!", text: res.Message, showConfirmButton: true, type: 'error' });
                }
            },
            error: function (err) {
                swal({ title: "Error!", text: "Failed to fetch courses.", showConfirmButton: true, type: 'error' });
            }
        });
    }

    function renderCourses(courses) {
        var $gridAvailable = $('#gridAvailable');
        var $gridRegistered = $('#gridRegistered');

        $gridAvailable.empty();
        $gridRegistered.empty();

        // Clear selections on refresh
        selectedCourses = [];
        selectedCancelCourses = [];
        updateBatchButton();
        updateBatchCancelButton();

        var hasAvailable = false;
        var hasRegistered = false;
        var registeredCourseNames = [];
        var hasLockedUnpaid = false;

        courses.forEach(function (c) {
            // If it's cancelled, it treats it as available, unless IS_ACTIVE is 0 which isn't fetched anyway
            var isReg = (c.IS_REGISTERED === "1" || c.IS_REGISTERED === "True");
            var isCancel = (c.IS_CANCEL === "1" || c.IS_CANCEL === "True");
            var isPaid = (c.IS_PAID === "1" || c.IS_PAID === "True");
            var isLocked = (c.IS_LOCKED === "1" || c.IS_LOCKED === "True");

            // If both are true (edge case), cancel usually overrides.
            // Let's rely strictly on IS_REGISTERED. If they cancelled, IS_REGISTERED should be 0.
            if (isReg) {
                $gridRegistered.append(createCourseCard(c, true));
                registeredCourseNames.push(c.COURSE_TITLE);
                hasRegistered = true;
                if (isLocked && !isPaid) {
                    hasLockedUnpaid = true;
                }
            } else {
                $gridAvailable.append(createCourseCard(c, false));
                hasAvailable = true;
            }
        });

        if (hasRegistered) {
            var totalRegisteredFee = window.totalRegisteredAmount;
            
            var summaryText = "";
            if (hasLockedUnpaid) {
                summaryText = "<div style='display: flex; flex-direction: column; gap: 8px;'>" +
                    "<div style='display: flex; justify-content: space-between; align-items: center;'>" +
                    "<strong style='font-size: 16px; color:#ff5b57;'>Total Amount: Rs." + totalRegisteredFee + "</strong>" +
                    "<button class='btn-custom' style='margin: 0; padding: 8px 16px; width: auto; background-color: #a0aec0; color: white; cursor: not-allowed; border-color:#a0aec0;' disabled>Proceed to Pay</button>" +
                    "</div>" +
                    "<div style='font-size: 13px; color: #ff5b57; font-weight: bold; margin-top: 5px; text-align: left;'>" +
                    "<i class='fa fa-exclamation-triangle'></i> Payment is locked because the registration window for one or more registered courses has closed. Please contact the administrator." +
                    "</div>" +
                    "</div>";
            } else {
                summaryText = "<div style='display: flex; justify-content: space-between; align-items: center;'>" +
                    "<strong style='font-size: 16px; color:#28a745;'>Total Amount: Rs." + totalRegisteredFee + "</strong>" +
                    "<button class='btn-custom' style='margin: 0; padding: 8px 16px; width: auto; background-color: #007bff; color: white; border-color:#007bff;' onclick='proceedToPay()'>Proceed to Pay</button>" +
                    "</div>";
            }
            $('#registeredSummary').html(summaryText).show();

            $('#emptyRegistered').hide();
            $gridRegistered.show();
        } else {
            $('#registeredSummary').hide();
            $('#emptyRegistered').show();
            $gridRegistered.hide();
        }

        if (!hasAvailable) {
            $('#emptyAvailable').show();
        } else {
            $('#emptyAvailable').hide();
        }
    }

    function createCourseCard(course, isRegistered) {
        var actionStr = isRegistered ? 'CANCEL' : 'REGISTER';
        var btnClass = isRegistered ? 'btn-custom btn-custom-cancel' : 'btn-custom';
        var btnIcon = isRegistered ? '' : '+';
        var btnText = isRegistered ? 'Cancel registration' : 'Register';
        var isPaid = (course.IS_PAID === "1" || course.IS_PAID === "True");
        var isLocked = (course.IS_LOCKED === "1" || course.IS_LOCKED === "True");

        var badgeHtml = '';
        if (course.EXAM_SETTING_ID === '1' || course.EXAM_SETTING_ID === 1) {
            badgeHtml = '<span class="course-credits" style="font-size: 10px; padding: 2px 6px; white-space: nowrap;">Semester Exam</span>';
        } else if (course.EXAM_SETTING_ID === '2' || course.EXAM_SETTING_ID === 2) {
            badgeHtml = '<span class="course-credits" style="font-size: 10px; padding: 2px 6px; white-space: nowrap;">CIA</span>';
        } else if (course.EXAM_SETTING_ID === '3' || course.EXAM_SETTING_ID === 3) {
            badgeHtml = '<span class="course-credits" style="font-size: 10px; padding: 2px 6px; white-space: nowrap;">Sem/CIA</span>';
        }

        var startStr = course.START_DATE ? course.START_DATE : 'Open';
        var endStr = course.END_DATE ? course.END_DATE : 'Open';
        var dateRangeHtml = `
            <div class="course-date" style="font-size: 11px; color: #4a5568; background-color: #f7fafc; border: 1px solid #e2e8f0; padding: 4px 8px; border-radius: 6px; margin-bottom: 12px; display: flex; align-items: center; gap: 5px; justify-content: center; font-weight: 500;">
                <i class="fa fa-calendar" style="color: #4a5568;"></i>
                <span>${startStr} to ${endStr}</span>
            </div>
        `;

        var actionHtml = '';
        if (isPaid) {
            actionHtml = `<div style="margin-top:auto;text-align:center;color:#28a745;font-weight:bold;padding:6px 0;background-color:#e8f5e9;border-radius:6px;border:1px solid #28a745;"><i class="fa fa-check-circle"></i> Registered & Paid</div>`;
        } else if (isLocked) {
            actionHtml = `<div style="margin-top:auto;text-align:center;color:#ff5b57;font-weight:bold;padding:6px 0;background-color:#ffeeee;border-radius:6px;border:1px solid #ff5b57;"><i class="fa fa-lock"></i> Locked / Closed</div>`;
        } else {
            actionHtml = `<button class="${btnClass}" onclick="event.stopPropagation(); toggleRegistration('${course.REGISTRATION_ID}', '${actionStr}')" style="margin-top: auto;">
                            ${btnIcon} ${btnText}
                        </button>`;
        }

        var onclickAttr = (isPaid || isLocked) ? '' : `onclick="toggleCardSelection(this, '${course.REGISTRATION_ID}', ${isRegistered})"`;
        var cardStyle = (isLocked && !isPaid) ? 'opacity: 0.8; border-color: #cbd5e0; background-color: #f7fafc;' : '';

        var html = `
                <div class="course-card" id="card_${course.REGISTRATION_ID}" ${onclickAttr} style="${cardStyle} min-height: 195px; display: flex; flex-direction: column;">
                    <div class="course-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; width: 100%;">
                        <span class="course-code" style="font-size: 11px; font-weight: 600; color: #718096;">${course.COURSE_CODE}</span>
                        ${badgeHtml}
                    </div>
                    <h3 class="course-title" style="margin: 0 0 10px 0; font-size: 12px; font-weight: 600; line-height: 1.4; color: #2d3748; flex-grow: 1;">${course.COURSE_TITLE}</h3>
                    ${dateRangeHtml}
                    ${actionHtml}
                </div>
            `;
        return html;
    }

    var selectedCourses = [];
    var selectedCancelCourses = [];

    function toggleCardSelection(element, regId, isRegistered) {
        if (isRegistered) {
            $(element).toggleClass('selected-cancel');

            if ($(element).hasClass('selected-cancel')) {
                if (!selectedCancelCourses.includes(regId)) selectedCancelCourses.push(regId);
            } else {
                selectedCancelCourses = selectedCancelCourses.filter(id => id !== regId);
            }

            updateBatchCancelButton();
        } else {
            $(element).toggleClass('selected');

            if ($(element).hasClass('selected')) {
                if (!selectedCourses.includes(regId)) selectedCourses.push(regId);
            } else {
                selectedCourses = selectedCourses.filter(id => id !== regId);
            }

            updateBatchButton();
        }
    }

    function updateBatchCancelButton() {
        var btn = $('#btnCancelSelected');
        if (selectedCancelCourses.length > 0) {
            btn.text('Cancel Selected (' + selectedCancelCourses.length + ')');
            btn.show();
        } else {
            btn.hide();
        }
    }

    function updateBatchButton() {
        var btn = $('#btnRegisterSelected');
        if (selectedCourses.length > 0) {
            var totalFee = selectedCourses.length * window.arrearFeeAmount;
            btn.text('Register Selected (' + selectedCourses.length + ') - Total Fee: \u20B9' + totalFee);
            btn.show();
        } else {
            btn.hide();
        }
    }

    function registerSelected() {
        if (selectedCourses.length === 0) return;

        swal({
            title: "Are you sure?",
            text: "Register " + selectedCourses.length + " selected courses?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#28a745",
            confirmButtonText: "Yes, Register",
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) return;

            var btn = $('#btnRegisterSelected');
            btn.text('Registering...');
            btn.prop('disabled', true);

            var completed = 0;
            var hasError = false;

            // Register sequentially to avoid overwhelming server
            function registerNext() {
                if (completed >= selectedCourses.length) {
                    selectedCourses = []; // clear selection
                    updateBatchButton();
                    btn.prop('disabled', false);

                    if (hasError) {
                        swal({ title: "Warning", text: "Some courses failed to register.", type: 'warning', showConfirmButton: true });
                    } else {
                        swal({ title: "Success!", text: "Registration completed successfully.", type: 'success', showConfirmButton: false, timer: 1500 });
                    }

                    loadCourses();
                    return;
                }

                var regId = selectedCourses[completed];
                $.ajax({
                    url: '/Examination/ToggleArrearCourseRegistration',
                    type: 'POST',
                    data: { RegistrationId: regId, Action: 'REGISTER' },
                    success: function (res) {
                        if (res.sResult !== "True") hasError = true;
                    },
                    error: function () {
                        hasError = true;
                    },
                    complete: function () {
                        completed++;
                        registerNext();
                    }
                });
            }

            registerNext();
        });
    }

    function proceedToPay() {
        var studentId = $('#txtStudentId').val() || '';
        var programmeGroupId = $('#txtProgrammeGroupId').val() || '';
        var frequencyId = $('#txtFrequencyId').val() || '';
        var frequencyTypeId = '12';
        var feeRootId = '1';

        // Use the actual registered total balance from fee_student_account
        var amount = window.totalRegisteredAmount || 0;

        if (amount <= 0) {
            swal({ title: "Warning", text: "No courses registered or total amount is 0.", type: 'warning' });
            return;
        }

        window.location.href = '/PaymentGateway/PaymentModeforarrearStudent?sFrequencyTypeId=' + encodeURIComponent(frequencyTypeId) +
            '&sFrequencyId=' + encodeURIComponent(frequencyId) +
            '&sFeeRootId=' + encodeURIComponent(feeRootId) +
            '&sStudentId=' + encodeURIComponent(studentId) +
            '&sAmount=' + amount +
            '&sProgrammeGroupId=' + encodeURIComponent(programmeGroupId);
    }

    function cancelSelected() {
        if (selectedCancelCourses.length === 0) return;

        swal({
            title: "Are you sure?",
            text: "Cancel registration for " + selectedCancelCourses.length + " selected courses?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ff5b57",
            confirmButtonText: "Yes, Cancel",
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) return;

            var btn = $('#btnCancelSelected');
            btn.text('Canceling...');
            btn.prop('disabled', true);

            var completed = 0;
            var hasError = false;

            function cancelNext() {
                if (completed >= selectedCancelCourses.length) {
                    selectedCancelCourses = [];
                    updateBatchCancelButton();
                    btn.prop('disabled', false);

                    if (hasError) {
                        swal({ title: "Warning", text: "Some courses failed to cancel.", type: 'warning', showConfirmButton: true });
                    } else {
                        swal({ title: "Success!", text: "Cancellation completed successfully.", type: 'success', showConfirmButton: false, timer: 1500 });
                    }

                    loadCourses();
                    return;
                }

                var regId = selectedCancelCourses[completed];
                $.ajax({
                    url: '/Examination/ToggleArrearCourseRegistration',
                    type: 'POST',
                    data: { RegistrationId: regId, Action: 'CANCEL' },
                    success: function (res) {
                        if (res.sResult !== "True") hasError = true;
                    },
                    error: function () {
                        hasError = true;
                    },
                    complete: function () {
                        completed++;
                        cancelNext();
                    }
                });
            }

            cancelNext();
        });
    }

    function toggleRegistration(regId, action) {
        var actionText = action === 'CANCEL' ? 'cancel registration for' : 'register';
        var actionColor = action === 'CANCEL' ? '#ff5b57' : '#28a745';
        var btnAction = action === 'CANCEL' ? 'Cancel' : 'Register';

        swal({
            title: "Are you sure?",
            text: "Do you want to " + actionText + " this course?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: actionColor,
            confirmButtonText: "Yes, " + btnAction,
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) return;

            $.ajax({
                url: '/Examination/ToggleArrearCourseRegistration',
                type: 'POST',
                data: { RegistrationId: regId, Action: action },
                success: function (res) {
                    if (res.sResult === "True") {
                        swal({ title: "Success!", text: btnAction + " completed successfully.", type: 'success', showConfirmButton: false, timer: 1500 });
                        loadCourses();
                    } else {
                        swal({ title: "Error!", text: res.Message, type: 'error' });
                    }
                },
                error: function () {
                    swal({ title: "Error!", text: "Failed to update registration status.", type: 'error' });
                }
            });
        });
    }
</script>

@if (TempData["ErrorMessage"] != null)
{
    <script>
        $(document).ready(function () {
            swal({ title: "Locked!", text: "@Html.Raw(TempData["ErrorMessage"])", type: 'error', showConfirmButton: true });
        });
    </script>
}
