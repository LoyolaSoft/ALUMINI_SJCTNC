@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}

<table class="table table-hover table-bordered" id="tblBundlesForStaff">
    <thead>
        <tr>
            <th>#</th>
            <th>
                <div class="checkbox checkbox-css">
                    <input type="checkbox" value="" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" />
                    <label for="AllchkID"></label>
                </div>
            </th>
            <th>Bundle No</th>
            <th>Pocket No</th>
            <th>Pocket Category</th>
            <th>Staff Name</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.liEXAM_EVALUATION_STUDENT_MARK != null && Model.liEXAM_EVALUATION_STUDENT_MARK.Count > 0)
            {
                int count = 0;
                foreach (var item in Model.liEXAM_EVALUATION_STUDENT_MARK)
                {
                <tr>
                    <td>@{count++;}@count</td>
                    <td>
                        <div class="checkbox checkbox-css checkbox-inline">
                            <input type="checkbox" name="myTextEditBox" id="@item.EXAM_BUNDLE_ID" cms-bundleid="@item.EXAM_BUNDLE_ID" cms-evaluationcourseid="@item.COURSE_ID" />
                            <label for="@item.EXAM_BUNDLE_ID"></label>
                        </div>
                    </td>
                    <td>@item.EXAM_BUNDLE_NO</td>
                    <td>@item.POCKET_NO</td>
                    <td>@item.POCKET_CATEGORY</td>
                    <td>@item.NAME</td>
                </tr>
                            }

                        }
    </tbody>
</table>
