@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}
<br /><br />
<div class="form-group col-md-12 table-responsive">
    @if (Model.LiExamEvaluation != null && Model.LiExamEvaluation.Count > 0)
    {
        var studentlist = Model.LiExamEvaluation.OrderBy(o => o.SECTION_ID);
        int nCount = 0;
        if (Model.liStudentList != null && Model.liStudentList.Count > 0)
        {
            nCount = Convert.ToInt32(Model.liStudentList.FirstOrDefault().STUDENT_ID);
        }

        <!-- Hidden Fileds-->
        <input type="hidden" id="sExamDate" value="@Model.LiExamEvaluation.FirstOrDefault().EXAM_DATE" />
        <input type="hidden" id="sStartTime" value="@Model.LiExamEvaluation.FirstOrDefault().START_TIME" />
        <input type="hidden" id="sEndTime" value="@Model.LiExamEvaluation.FirstOrDefault().END_TIME" />
        <input type="hidden" id="sTimeTableId" value="@Model.LiExamEvaluation.FirstOrDefault().TIMETABLE_ID" />
        <input type="hidden" id="sTotalHours" value="@Model.LiExamEvaluation.FirstOrDefault().TOTAL_HOURS" />

        <table class="table table-bordered" id="tblShuffleStudent">
            <tbody>
                @if (Model.liCourseRoot != null && Model.liCourseRoot.Count > 0)
                {
                   
                    <tr>
                        <td>Course Code  </td>
                        <td>@Model.liCourseRoot.FirstOrDefault().COURSE_CODE</td>
                        <td>Course Title  </td>
                        <td>@Model.liCourseRoot.FirstOrDefault().COURSE_TITLE</td>
                        <td>Department  </td>
                        <td>@Model.liCourseRoot.FirstOrDefault().DEPARTMENT</td>
                    </tr>
                }

                <tr>
                    <td>Exam Date </td>
                    <td>@Model.LiExamEvaluation.FirstOrDefault().EXAM_DATE</td>
                    <td>Start Time   </td>
                    <td>@Model.LiExamEvaluation.FirstOrDefault().START_TIME</td>
                    <td>End Time  </td>
                    <td>@Model.LiExamEvaluation.FirstOrDefault().END_TIME</td>
                </tr>
                <tr>
                    <td>Total Count  </td>
                    <td>@{var Count = nCount + Model.LiExamEvaluation.Count;} @Count</td>
                    <td>Alloted Count  </td>
                    <td>@nCount</td>
                    <td>Balance Count  </td>
                    <td>@Model.LiExamEvaluation.Count</td>
                </tr>
            </tbody>
        </table>

        <table class="table table-bordered" id="tblStudent">
            <thead>
                <tr>
                    <th><input type="checkbox" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" /> Select All  <b id="lblCount"></b></th>
                    <th>RegisterNo</th>
                    <th>Roll No</th>
                    <th>Class</th>
                    @*<th>CourseCode</th>*@
                    <th>ExamDate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in studentlist)
                {
                <tr>
                    <td>
                        <input type="checkbox" name="myTextEditBox" id="chkID" onclick="ClickCount()" cms-invigilator="@item.INVIGILATION_ID" cms-studentid="@item.TIMETABLE_ID" />
                    </td>
                    <td>@item.REGISTER_NO</td>
                    <td>@item.ROLL_NO</td>
                    <td>@item.SECTION_ID</td>

                    @*<td>@item.COURSE_CODE</td>*@
                    <td>@item.EXAM_DATE</td>
                </tr>
                }
            </tbody>
        </table>

        <div class="form-group col-md-12">
            <a class="btn btn-primary pull-right" id="btnSubmit" href="javascript:;" onclick="SubmitData()"> Submit </a>
        </div>
                        }

</div>


<script>
        SelectOrUnselect = function ()
        {
            if (AllchkID.checked == true)
            {
                $('#tblStudent tbody tr').each(function ()
                {
                    $(this).find('input[type="checkbox"]').each(function ()
                    {
                        $('input[type="checkbox"]').attr("checked", true);
                    });
                });
            }
            else
            {
                $('#tblStudent tbody tr').each(function ()
                {
                    $(this).find('input[type="checkbox"]').each(function ()
                    {
                        $('input[type="checkbox"]').attr("checked", false);
                    });
                });
            }

            ClickCount();
        }
</script>

<script>
    function SubmitData()
    {
        $('#btnSubmit').addClass('disabled');
        var nJsonCount = 0; var sJson = '{"liJsonExamEvaluation" :[';
        $('#tblStudent tbody tr').each(function ()
        {
            $(this).find('input[type="checkbox"]').each(function ()
            {
                if ($(this).is(':checked'))
                {
                    sJson += '{"INVIGILATION_ID":"' + $(this).attr('cms-invigilator') + '",\
                               "EVALUATOR_ID":"' + $('#StaffList').val() + '",\
                               "EVALUATION_TYPE":"' + $('#EvaluationType').val() + '",\
                               "EVALUATION_DATE":"' + $('#ddEvaluationDate').val() + '",\
                               "ACADEMIC_YEAR":"' + $('#AcademicYearList Option:selected').text() + '"},';
                    nJsonCount++;
                }
                //$('input[type="checkbox"]').attr("checked", true);
            });
        });
        if (nJsonCount != 0)
        {
            sJson = sJson.slice(0, -1);
            sJson += ']}';
        } else
        {
            swal({ title: "Oops !", text: 'Please select students to continue !', showConfirmButton: false, timer: 2000, type: 'warning', animation: true });
            return false;
        }


        // Post values using ajax

        swal({
            title: "Are you sure?",
            text: "Your sure to assign ( " + nJsonCount + " ) students for this staff !",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function ()
        {
            $.ajax({
                url: '@Url.Action("SaveExamEvaluationEntry", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sJson: sJson, sExamSettingId: $('#ExamSetting').val() },
                success: function (data)
                {
                    if (data.ErrorCode == '200')
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadShuffleStudents();
                        $('#btnSubmit').removeClass('disabled');
                    }
                    else
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        });
    }
</script>

<script>
    var nCount = 0;
    function ClickCount()
    {
        nCount = 0;
        $('#tblStudent tbody tr').each(function ()
        {
            $(this).find('input[type="checkbox"]').each(function ()
            {
                if ($(this).is(':checked'))
                {
                    nCount++;
                }
            });
        });
        $('#lblCount').text(' ( ' + nCount + ' )');
    }
</script>
