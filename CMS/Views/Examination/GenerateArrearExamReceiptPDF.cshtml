@model CMS.ViewModel.ViewModel.FeeTransactionViewModel
@{
    Layout = null;
    var transaction = Model.liFeeTransaction != null ? Model.liFeeTransaction.FirstOrDefault() : null;
    var student = Model.lstStudentPersonalInfo != null ? Model.lstStudentPersonalInfo.FirstOrDefault() : null;
    var college = Model.liCollegeDetails != null ? Model.liCollegeDetails.FirstOrDefault() : null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Arrear Exam Fee Receipt</title>
    <style>
        body {
            font-family: 'Outfit', 'Helvetica Neue', Arial, sans-serif;
            color: #1e293b;
            padding: 30px;
            background-color: #ffffff;
            margin: 0;
        }

        .receipt-container {
            max-width: 800px;
            margin: 0 auto;
            border: 1px solid #cbd5e1;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        /* Header Styling */
        .header-section {
            text-align: center;
            margin-bottom: 30px;
        }

        .college-logo {
            height: 90px;
            margin-bottom: 12px;
            object-fit: contain;
        }

        .college-name {
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 4px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .college-subtitle {
            font-size: 13px;
            font-weight: 600;
            color: #475569;
            margin: 0 0 2px 0;
        }

        .college-affiliation {
            font-size: 12px;
            font-weight: 500;
            color: #64748b;
            margin: 0;
        }

        /* Title */
        .receipt-title {
            text-align: center;
            font-size: 19px;
            font-weight: 700;
            text-decoration: underline;
            margin-top: 25px;
            margin-bottom: 25px;
            color: #0f172a;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Meta Section (Receipt No & Date) */
        .meta-section {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 12px;
            padding: 0 5px;
            color: #0f172a;
        }

        .meta-item {
            font-size: 14px;
        }

        /* Student Details Box */
        .student-box {
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 18px;
            margin-bottom: 25px;
            background-color: #fafafa;
        }

        .student-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .student-row:last-child {
            margin-bottom: 0;
        }

        .student-col {
            width: 48%;
            font-size: 14px;
            line-height: 1.6;
        }

        .student-label {
            font-weight: 600;
            color: #475569;
            display: inline-block;
            width: 120px;
        }

        .student-val {
            font-weight: 700;
            color: #0f172a;
        }

        .transaction-row {
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
            border-top: 1px dashed #cbd5e1;
            margin-top: 12px;
            padding-top: 10px;
        }

        /* Particulars Table */
        .particulars-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .particulars-table th, 
        .particulars-table td {
            border: 1px solid #000000;
            padding: 12px;
            color: #0f172a;
        }

        .particulars-table th {
            font-weight: 700;
            background-color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        /* Footer Section */
        .footer-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 40px;
            padding: 0 5px;
        }

        .qr-code-box {
            text-align: center;
            font-size: 11px;
            font-weight: 600;
            color: #475569;
        }

        .qr-code-img {
            width: 110px;
            height: 110px;
            margin-bottom: 6px;
            border: 1px solid #cbd5e1;
            padding: 4px;
            border-radius: 4px;
            background: #ffffff;
        }

        .signatory-box {
            text-align: center;
            width: 220px;
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
        }

        .sign-line {
            border-bottom: 1.5px solid #000000;
            margin-bottom: 8px;
            width: 100%;
            height: 30px;
        }

        .computer-generated-note {
            text-align: center;
            font-size: 11px;
            font-style: italic;
            color: #64748b;
            margin-top: 40px;
            border-top: 1px solid #f1f5f9;
            padding-top: 15px;
        }
    </style>
</head>
<body>

<div class="receipt-container">
    <!-- Header Section -->
    <div class="header-section">
        <img class="college-logo" src="/Content/assets/img/hcc-img/SJCLOGO.png" alt="St. Joseph's College Logo" />
        <h1 class="college-name">St. Joseph's College of Arts & Science</h1>
        <h2 class="college-subtitle">(Autonomous)</h2>
        <p class="college-subtitle">Re-Accredited by NAAC with 'A' Grade (4th Cycle)</p>
        <p class="college-affiliation">Affiliated to Annamalai University</p>
    </div>

    <hr style="border: 0; border-top: 1.5px solid #000000; margin: 0 0 15px 0;" />

    <!-- Receipt No & Date -->
    <div class="meta-section">
        <div class="meta-item">
            Receipt No: <span style="font-weight: 700;">@(transaction != null ? transaction.RECEIPT_NO : "")</span>
        </div>
        <div class="meta-item">
            Date: <span style="font-weight: 700;">@(transaction != null ? transaction.PAYMENT_DATE : "")</span>
        </div>
    </div>

    <!-- Student Info Box -->
    <div class="student-box">
        <div class="student-row">
            <div class="student-col">
                <span class="student-label">Name</span>
                <span class="student-val">: @(student != null ? student.FIRST_NAME : "")</span>
            </div>
            <div class="student-col">
                <span class="student-label">Reg. No / Roll No</span>
                <span class="student-val">: @(student != null ? (!string.IsNullOrEmpty(student.REGISTER_NO) ? student.REGISTER_NO : student.ROLL_NO) : "")</span>
            </div>
        </div>
        <div class="student-row">
            <div class="student-col">
                <span class="student-label">Payment Type</span>
                <span class="student-val">: @(transaction != null ? transaction.PAYMENT_MODE : "")</span>
            </div>
            <div class="student-col">
                <span class="student-label">Programme</span>
                <span class="student-val">: @(student != null ? student.CLASS_NAME : "")</span>
            </div>
        </div>
        <div class="transaction-row">
            Transaction No: @(transaction != null ? transaction.TRANSACTION_ID : "")
        </div>
    </div>

    <!-- Title -->
    <div class="receipt-title">
        Arrear Exam Fee Receipt
    </div>

    <!-- Particulars Table -->
    <table class="particulars-table">
        <thead>
            <tr>
                <th class="text-center" style="width: 80px;">#</th>
                <th>Particulars</th>
                <th class="text-right" style="width: 200px;">Amount (&#8377;)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-center">1</td>
                <td>Arrear Fee</td>
                <td class="text-right" style="font-weight: 700;">@(transaction != null ? transaction.COLLECTED : "")</td>
            </tr>
            <tr>
                <td></td>
                <td class="text-right" style="font-weight: 700; text-transform: uppercase;">Total</td>
                <td class="text-right" style="font-weight: 700; font-size: 15px;">&#8377; @(transaction != null ? transaction.COLLECTED : "")</td>
            </tr>
        </tbody>
    </table>

    <!-- Footer Section -->
    <div class="footer-section">
        <!-- Dynamic QR Code -->
        <div class="qr-code-box">
            @{
                string qrData = transaction != null ? ("ReceiptNo:" + transaction.RECEIPT_NO + "|Student:" + (student != null ? student.REGISTER_NO : "") + "|Amount:" + transaction.COLLECTED) : "SJCReceipt";
                string qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=" + HttpUtility.UrlEncode(qrData);
            }
            <img class="qr-code-img" src="@qrUrl" alt="Verification QR Code" /><br />
            Scan to Verify
        </div>

        <!-- Authorized Signatory -->
        <div class="signatory-box">
            <div class="sign-line"></div>
            Authorized Signatory
        </div>
    </div>

    <!-- Disclaimer Note -->
    <div class="computer-generated-note">
        This is a computer-generated receipt and does not require a physical signature.
    </div>
</div>

</body>
</html>
