@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListExamQuestions";
    Layout = null;
}


<style>
    .note-editing-area {
        max-height: 65px;
    }
</style>
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">List  Questions</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> List  Questions</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title"> List  Questions</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                            <div class="col-md-3 form-group">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                    @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Set, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-3 form-group">
                                    @Html.Label("Pattern", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.QuestionPattern, (Model.QuestionPattern != null) ? Model.QuestionPattern : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                <div class="col-md-3 form-group">
                                    @Html.Label("Section", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Section, (Model.Section != null) ? Model.Section : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Section, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @*<div class="col-md-4 form-group">
                                    @Html.Label("Question Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.QuestionType, (Model.QuestionType != null) ? Model.QuestionType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.QuestionType, "", new { @class = "text-danger" })
                                    </div>
                                </div>*@
                                <div class="col-md-1 form-group">
                                    <a class="btn btn-primary" id="btnGet" onclick="GetQuestions()"> Get </a>
                                </div>
                                <div class="col-md-2 form-group">
                                    <a class="btn btn-success pull-right" href="#previewmodal" onclick="QuestionPreview()" data-toggle="modal">Preview</a>
                                </div>
                            </div>   
                            <div class="col-md-12 pull-right">
                                <a class="btn btn-success pull-right" href="javascript:;" onclick="loadContent('/Examination/AddExamQuestions')"><i class="fa fa-plus"> Add </i></a>
                            </div>
                            <div class="col-md-12" id="bindexamquestions">
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>


<!-- Begin Modal -->

<div class="modal" id="Edit-dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Edit QUestions</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12 form-group">
                               
                                @*<div class="col-md-2 form-group">
                                    <a href="javascript:;" onclick="AddTextBox();" class="btn btn-success"><i class="fa fa-plus"> Add </i></a>
                                </div>*@
                                <div class="col-md-2 pull-right form-group">
                                    <a class="btn btn-success" href="#equation-dialog" data-toggle="modal"><i class="fa fa-plus"> Equation </i></a>
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                <div id="Question">
                                    <label class="col-md-2 control-label">Title</label>
                                    <div class="col-md-10" id="divQuestion">
                                        <div id="TxtTitle" class="summernote form-control" placeholder="Enter Your Title"></div>
                                        @*<input type="text" id="TxtTitle" class="summernote form-control" placeholder="Enter Your Title" maxlength="200">*@
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 form-group hidden" id="dvMathTheFollowing">
                                <div class="col-md-6">
                                    <div id="dvOptions1"></div>
                                </div>
                                <div class="col-md-6">
                                    <div id="dvOptions2"></div>
                                </div>
                            </div>

                            <div class="col-md-12 form-group" id="dvOtherType">
                                <div id="dvOptions3"></div>
                            </div>
                            <!--Either or questions-->
                            <div class="row hidden" id="dvEitherType">

                                <div id="dvOptions4">

                                </div>
                            </div>
                            <!--Choice Based questions-->
                            <div class="row hidden" id="dvChoiceType">

                                <div id="dvOptions5">

                                </div>
                            </div>

                            <div class="form-group col-md-12">
                                <div class="col-md-8 form-group hidden" id="Answer">
                                    <label class="col-md-3 control-label">Answer</label>
                                    <div class="col-md-9" id="divAnswer">
                                        <input type="text" id="txtAnswer" class="form-control" placeholder="Enter Your Correct Option No" style="width:140%" min="0">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <label id="l"></label>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->
