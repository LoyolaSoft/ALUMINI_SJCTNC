    function GetQuestions()
    {
        if ($('#Section').val() && $('#ExamSetting').val() && $('#CourseList').val() && $('#Set').val())
        {
            $.ajax({
                url: "@Url.Action("BindAllExamQuestions", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamsettingId: $('#ExamSetting').val(), sCourse: $('#CourseList').val(), sSet: $('#Set').val(), sQuestionpattern: $('#QuestionPattern').val(), sSection: $('#Section').val() },
            success: function (data)
            {
                $('#bindexamquestions').empty();
                $('#bindexamquestions').append(data);
                $('#tblquestions').DataTable({});

            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Choose All Fields .....!');
    }
    }
