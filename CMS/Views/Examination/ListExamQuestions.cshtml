<script>
    function QuestionPreview()
    {


        if ($('#ExamSetting').val()!="" && $('#CourseList').val()!="" && $('#Set').val()!="" && $('#ExamSetting').val()!="0" && $('#CourseList').val()!="0" && $('#Set').val()!="0")
        {
            $('#course').text($("#CourseList option:selected").text());
            $('#exam').text($("#ExamSetting option:selected").text());
            $('#set').text($("#Set option:selected").text());

            $.ajax({
                url: "@Url.Action("BindQuestionPreview", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamsettingId: $('#ExamSetting').val(), sCourse: $('#CourseList').val(), sSet: $('#Set').val() },
            success: function (data)
            {
                $('#privewdiv').empty();
                $('#privewdiv').append(data);
                $('#btnprint').removeClass('hidden');
                $('#coursedetailsdiv').removeClass('hidden')


            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }
    else
    {
            alert('Please Choose Course,Exam Setting,Set .....!');
    }

    }
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
        //$('.modal-backdrop').remove();
        //$('#previewmodal').modal('toggle');
    }
</script>