@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{Layout = null; int count = 0;}
<table class="table table-hover table-bordered" id="tblEvStudentList">
    <thead>
        <tr>
            <th>#</th>
            <th>
                <div class="checkbox checkbox-css">
                    <input type="checkbox" value="" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" />
                    <label for="AllchkID"></label>
                </div>
            </th>
            <th>Register No</th>
           
            
        </tr>
    </thead>
    <tbody>
        @if (Model.liEXAM_EVALUATION_STUDENT_MARK != null)
            {
                foreach (var item in Model.liEXAM_EVALUATION_STUDENT_MARK)
                {
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>
                        <div class="checkbox checkbox-css checkbox-inline">
                            <input type="checkbox" name="myTextEditBox" id="@item.STUDENT_ID" cms-studentid="@item.STUDENT_ID" cms-EVALUATION_COURSE_SETTING_ID="@item.EVALUATION_COURSE_SETTING_ID" cms-EXAM_EV_STU_MARK_ID="@item.EXAM_EV_STU_MARK_ID"  />
                            <label for="@item.STUDENT_ID"></label>
                        </div>
                    </td>
                    <td>@item.REGISTER_NO</td>                
                   
                </tr>
                                }
                            }
    </tbody>
</table>