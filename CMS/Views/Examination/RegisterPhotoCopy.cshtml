
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.ViewModel.Model;
@using CMS.Utility
@{
    ViewBag.Title = "RegisterPhotoCopy";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">RegisterPhotoCopy</li>
    </ol>
    <h1 class="page-header">Photo Copy Registration</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Photo Copy Registration</h4>
        </div>
        <div class="panel-body">
            @*<div class="form-group col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#ERRegistration-dialog" data-toggle="modal" id="btnAdd"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>*@

            <div class="col-lg-12 table-responsive">
                <table class="table table-hover table-bordered" id='tblCourse'>
                    <thead>
                        <tr>
                            <td>#</td>
                            <td>Paper</td>
                            <td>Internal</td>
                            <td>External</td>
                            <td>Total</td>
                            <td>Result</td>
                            <td>Select</td>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.LiSemesterMarks != null && Model.LiSemesterMarks.Count > 0)
                    {
                        //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                        //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                        var count = 0;
                        foreach (var item in Model.LiSemesterMarks)
                        {
                            count = count + 1;
                    <tr>
                        <td>@count</td>

                        <td>@item.COURSE_TITLE</td>
                        <td>@item.INTERNAL_MARK</td>
                        <td>@item.EXTERNAL_MARK</td>
                        <td>@item.TOTAL</td>
                        <td>@item.RESULT</td>
                        <td>
                            <div class='checkbox checkbox-css checkbox-success'>
                                <input type='checkbox' id='cbx"@item.COURSE_ID"' value='@item.COURSE_ID' cms-checked='false'>
                                <label for='cbx"@item.COURSE_ID"'>
                                </label>
                            </div>
                        </td>


                    </tr>
                        }

                    }
                    else
                    {
                    <tr><td> No Records Found..! </td> </tr>
                    }

                    </tbody>
                </table>
                </div>

                <div class="col-md-12 form-group">
                    <label class="col-md-8 control-label">Amount</label>
                    <div class="col-md-4">
                        <input type="number" id="txtAmount" class="form-control" placeholder="Amount" data-parsley-required="true" readonly>
                    </div>

                </div>

                <div class="form-group col-lg-12 row">
                    <div class="form-group pull-right">
                        <div class="col-md-5">
                            <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                        </div>
                        <div class="col-md-5">
                            <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal" id="btnCancel">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
    </div>
</div>

<input type="hidden" id="ERRegisterId" value="" />
<input type="hidden" id="ERAmount" value="@Model.objFeeStructure.AMOUNT" />
<input type="hidden" id="ERHead" value="@Model.objFeeStructure.HEAD" />
<input type="hidden" id="ERFeeMainHead" value="@Model.objFeeStructure.FEE_MAIN_HEAD_ID" />
<input type="hidden" id="ERFrequency" value="@Model.objFeeStructure.FREQUENCY" />
<input type="hidden" id="ERMaxPaper" value="@Model.liExamPhotoCopySetting.FirstOrDefault().MAX_PAPER" />
<input type="hidden" id="ERSetting" value="@Model.liExamPhotoCopySetting.FirstOrDefault().EXAM_PHOTOCOPY_SETTING_ID" />

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        //var tbl = $('#tblLiERSetting').DataTable();
        $('.selectpicker').selectpicker('refresh');
        handleDatepicker = function () {
            "use strict";


            $("#txtStartDate").datepicker({
                todayHighlight: true,
                autoclose: true,
              //  endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#txtEndDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();
        var Count = 0;
        var Status = 0;

       
    
        function CheckBoxClick()
        {

            //get maximum paper
            var MaxPaper = $('#ERMaxPaper').val();

            if (MaxPaper != null && MaxPaper != "") {

                $('#tblCourse tbody tr').each(function () {



                    if ($(this).find("input[type = 'checkbox']").prop('checked') == true && $(this).find("input[type = 'checkbox']").attr("cms-checked") == "false") {

                        // it will check the maximum limit
                        if (parseInt(Count) > parseInt(MaxPaper) - 1) {


                            swal({ title: "Info", text: "Sorry Maximum Paper is " + MaxPaper + "!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });

                            //uncheck the current check box
                            $(this).find("input[type = 'checkbox']").prop('checked', false);

                            //disable the all the other check boxes
                            HideCheckBoxes();
                            return false;
                        }

                        //next to proceed
                        Count = Count + 1;

                        CirculateAmount("0");

                        //mark as it is evaluated
                        $(this).find("input[type = 'checkbox']").attr("cms-checked", "true");
                    }
                    if ($(this).find("input[type = 'checkbox']").prop('checked') == false && $(this).find("input[type = 'checkbox']").attr("cms-checked") == "true") {

                        $(this).find("input[type = 'checkbox']").attr("cms-checked", "false");
                        Count = Count - 1;
                        CirculateAmount("1");

                        // enable the checkboxes
                        ShowCheckBoxes();

                    }

                });
            }
        }



        $('#tblCourse').find("input[type = 'checkbox']").live("click", function () {

            CheckBoxClick();

        });

        function CirculateAmount(status)
        {

            var amount = $('#ERAmount').val() != "" ? $('#ERAmount').val() : 0;
            amount = parseInt(amount) * 1;
            var ActualAmount = $('#txtAmount').val() != "" ? $('#txtAmount').val() : 0;
            if (status=="0")
            {

                ActualAmount = parseInt(ActualAmount) + amount;
            }
            else {
                ActualAmount = parseInt(ActualAmount) - amount;
            }

            $('#txtAmount').val(ActualAmount);

        }

        function HideCheckBoxes()
        {

            $('#tblCourse tbody tr').each(function () {

                if ($(this).find("input[type = 'checkbox']").attr("cms-checked") == "false") {
                    $(this).find("input[type = 'checkbox']").attr("disabled", true);

                }
            });
        }

        function ShowCheckBoxes()
        {
            $('#tblCourse tbody tr').each(function () {

                if ($(this).find("input[type = 'checkbox']").attr("cms-checked") == "false") {
                    $(this).find("input[type = 'checkbox']").attr("disabled", false);
                }
            });
        }



        $('#btnSubmit').click(function () {

           // var isValid = true;
            var sCount=0;
            //if ($('#pBody').parsley().validate() !== true) isValid = false;
            //if (!isValid) {
            //    //gritter-info,danger,success,warning,default
            //    //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            //    return false;
            //}


            var Papers = [];


            $('#tblCourse tbody tr').each(function () {

                $(this).find("input[type = 'checkbox']").each(function () {

                    if ($(this).prop('checked') == true) {

                        Papers.push($(this).val());
                        sCount++;

                    }
                });

            });

            if (sCount>0)
            {
                var Amount = $('#txtAmount').val();
                var ExamPhotocopyRegistrationId = $('#ERRegisterId').val();
                var ExamPhotocopySettingId = $('#ERSetting').val();
                var jsonData = '{"EXAM_PHOTOCOPY_REGISTER_ID":"' + ExamPhotocopyRegistrationId + '","EXAM_PHOTOCOPY_SETTING_ID":"' + ExamPhotocopySettingId + '","STUDENT_ID":"","PAPERS":"' + Papers + '","AMOUNT":"' + Amount + '","REGISTERED_DATE":""}';


                $.ajax({
                    url: "/Examination/SaveorUpdateExaminationPhotoCopyRegistration",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "" && data.ErrorCode != "" && data.ErrorCode!=null)
                        {

                            if (data.ErrorCode=="201")
                            {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }
                            if (data.ErrorCode == "200") {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/Examination/ListPhotoCopyRegistration');
                            }
                            if (data.ErrorCode == "304") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                        }
                        else {
                            swal({ title: "Info", text: "Something went wrong so please try again!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                });
            }
            else
            {
                swal({ title: "Info!", text: "Please select any paper to continue!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
            }
        });





    GetConfirm = function (ExamRevaluationRegisterId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            var req = $.ajax({
                url: "/Examination/DeleteLiExamRevaluationRegistration",
                type: "post",
                data: { sExamRevaluationRegisterId: ExamRevaluationRegisterId },
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Examination/ListRevaluationRegistration');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

        req.done(function (response) {
            tbl.rows().remove().draw();
            tbl.rows.add(response).draw();
        });
        }


    $('#btnCancel').click(function () {

        loadContent('/Examination/ListPhotoCopyRegistration');
    });

</script>







