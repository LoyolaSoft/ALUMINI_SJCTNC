@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />




<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Exam Registration</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam Registration<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam Registration</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">

                        <div class="col-md-4" data-step="1" data-intro="Choose Class">
                            @Html.Label("Programme", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                   @Html.DropDownListFor(m => m.ProgrammeList, (Model.ProgrammeList != null)? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                   @Html.ValidationMessageFor(m => m.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3" data-step="2" data-intro="Choose Course">
                            @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3" data-step="2" data-intro="Choose Course">
                            @Html.Label("Setting", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-1 form-group">
                            <a href="javascript:;" class="btn btn-primary" id="btnRegistration" onclick="SaveExamRegistration()">Sync Exam</a>
                        </div>
                    </div>
                </div>


                <div id="dvExamRegistrationbind"></div>
            }
            @*<div class="col-lg-12">
                <a href="#" class="btn-success btn" id="btnSubmit">Submit</a>
            </div>*@
        </div>

    </div>
</div>
<!-- end #content -->
@*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>*@
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
   function ContentLoad()
   {
       // Document Ready Function .
      
   }
   //$(document).ready(function ()
   //{

   //});
   $('.selectpicker').selectpicker({
       size: 6
   });
   $('.selectpicker').selectpicker('refresh');
</script>


<script>
    $('#ProgrammeList').on('change', function ()
    {
        $.ajax({
            url: '@Url.Action("FetchClassAndExamSettingByProgrammeGroupId", "Examination")',
            method: 'POST',
            datatype: 'json',
            data: { sProgrammeGroupId: $('#ProgrammeList').val() },
            success: function (data)
            {
                if (data.Message!=null && data.Message!='')
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#ClassList').empty();
                    $('#ClassList').append(data.sResult);
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append(data.ErrorCode);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    function SaveExamRegistration()
    {
        if ($('#ExamSetting').val() && $('#ClassList').val() && $('#ProgrammeList').val())
        {
            $.ajax({
                url:'@Url.Action("SaveExamRegistrationForSJC", "Examination")',
                method:'POST',
                datatype: 'json',
                data: { sProgrammeGroupId: $('#ProgrammeList').val(), sClassId: $('#ClassList').val(), sExamSettingId: $('#ExamSetting').val() },
                success: function (data)
                {
                    alert(data.Message);
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
</script>