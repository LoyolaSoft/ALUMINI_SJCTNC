@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{Layout = null; int count = 0;}
@if (Model.liCIA_Staff_Info != null && Model.liCIA_Staff_Info != null)
{
    <table width="100%" id="StudentInfoList">
        <tr>
            <th>Department</th>
            <th>@Model.liCIA_Staff_Info.FirstOrDefault().DEPARTMENT</th>
            <th></th>
            <th></th>
        </tr>
    </table>
    <br>
}

@if (Model.liCIA_Staff_Info != null)
{
    <table class="table table-hover table-bordered" width="100%" id="StudentFeeList">
        <thead>
            <tr>
                <th>#</th>
                <th>Staff Code</th>
                <th>Name</th>
                <th>Action</th>


            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liCIA_Staff_Info)
            {
                <tr cms-staffAllotedId="@item.STAFF_ALLOTED_ID">
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>@item.STAFF_CODE</td>
                    <td>@item.FIRST_NAME</td>
                    <td><a href="javascript:;" class="text-danger" onclick="GetConfirm(@item.STAFF_ALLOTED_ID)"><i class="fa fa-trash"></i></a></td>

                </tr>
            }
        </tbody>
    </table>
}

