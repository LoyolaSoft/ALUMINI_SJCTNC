@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "CIAComponentMarksReportForRescapes";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />



<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Internal Assessment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Component Mark<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CIA Component Mark</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">

                        <div class="col-md-4" data-step="1" data-intro="Choose Year">
                            @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4" data-step="2" data-intro="Choose Class">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4" data-step="3" data-intro="Choose Course">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                    </div>
                    <div class="col-lg-12 form-group pull-right">
                        <a href="javascript:;" onclick="printDiv('dvCIAbind');"  class="btn-success btn hidden" id="btnPrint">Print</a>
                    </div>
                </div>


                <div id="dvCIAbind"></div>
            }
            
        </div>

    </div>
</div>
<!-- end #content -->

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>
    $('#AcademicYearList').on('change', function myfunction()
    {
        $.ajax({
            url: "@Url.Action("FetchClassByAcYear", "Examination")",
            async: false,
            data: { sAcYear: $('#AcademicYearList option:Selected').text() },
            success: function (data)
            {
                if (data.Message!=null && data.Message!='')
                {
                    alert(data.Message);
                } else
                {
                    $('#ClassList').empty();
                    $('#ClassList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            },
            error: function (xhr, textStatus, error)
            {
                alert(error + "\n");
            }

        });
    });

        var flag = true;
        $('#ClassList').on('change', function ()
        {
            var inp = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("FetchAllCourseByClassId", "Examination")",
                async: false,
                data: { sClassId: inp },
                success: function (data)
                {
                    if (data.Message!=null && data.Message!='')
                    {
                        alert(data.Message);
                    } else
                    {
                        var select = $('#CourseList');
                        select.empty();
                        select.append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }

            });
        });

    var FetchCIAMarks = function ()
    {
        $('#btnPrint').removeClass('hidden');
            var inp1 = $('#ClassList').val();
            var inp2 = $('#CourseList').val();
            $.ajax({
                url: "@Url.Action("BindStudentsForRescaprsCIAComponentMarks", "Examination")",
                async: false,
                data: { sClassId: inp1, sCourseId: inp2, sAcademicYear: $('#AcademicYearList option:Selected').text() },
                success: function (option) {
                    var divHtml = $('#dvCIAbind');
                    divHtml.empty();
                    divHtml.html(option);
                    $("#ciaMarkList").DataTable({ "bPaginate": false });
                    $("#ciaMarkList_filter").addClass("dataTables_filter pull-right");
                    $(".pagination").addClass("pagination pull-right");
                    $('#txtClassName').text($('#ClassList option:selected').text());
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        }

        $('#CourseList').on('change', function ()
        {
            if ($(this).val() != 0) {
                FetchCIAMarks();
            } else {

                var divHtml = $('#dvCIAbind');
                divHtml.empty();
            }
            $('.selectpicker').selectpicker('refresh');
        });

        function printDiv(divName) {
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;

            window.print();

            document.body.innerHTML = originalContents;
            loadContent('/Examination/CIAComponentMarksReportForRescapes');
        }

</script>




