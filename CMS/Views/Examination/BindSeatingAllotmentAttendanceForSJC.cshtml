@model CMS.ViewModel.ViewModel.ExaminationViewModel


@{
    Layout = null;
}

@functions{
    public string EmptyRows()
    {
        string sRows = "<td></td> <td></td> <td></td> <td></td><td></td>";
        return sRows;
    }
}

@if (Model.liExamAllotementReport != null && Model.liExamAllotementReport.Count > 0)
{
    var liRooms = Model.liExamAllotementReport.GroupBy(x => x.ROOM_ID).ToList();
    if (liRooms != null && liRooms.Count > 0)
    {
        foreach (var item in liRooms)
        {
            var liExamSeating = Model.liExamAllotementReport.Where(x => x.ROOM_ID == item.FirstOrDefault().ROOM_ID).ToList();
            if (liExamSeating != null && liExamSeating.Count > 0)
            {
                <div class="form-horizontal" style="page-break-after:always !important;page-break-inside:avoid !important;">
                    <div class="col-md-12">
                        <center> <b> ST.JOSEPH'S COLLEGE OF ARTS & SCIENCE (AUTONOMOUS),CUDDALORE-1</b> </center>

                        <center>SEATING ARRANGEMENT ,ODD SEMESTER EXAMINATION - NOVEMBER  2019.</center>
                        <hr />
                        <table cellpadding="5" cellspacing="5">
                            <tr>
                                <th width="15%">Block : @item.FirstOrDefault().BLOCK_NAME</th>
                                <th width="25%"></th>
                                <th width="25%">Name Of The Invigilator : @item.FirstOrDefault().INVIGILATOR</th>
                            </tr>
                        </table>
                    </div>

                    <hr />
                    <div class="col-md-12">
                        <table cellpadding="5" cellspacing="5">
                            <tr>
                                <th width="15%"> Room No : @item.FirstOrDefault().ROOM_NO</th>
                                <th width="25%"></th>
                                <th width="25%"> Date : @item.FirstOrDefault().EXAM_DATE</th>
                                <th width="15%"></th>
                                <th width="20%"> Session : @item.FirstOrDefault().SESSION_NAME</th>
                            </tr>
                        </table>
                    </div>

                    <hr />

                    <div class="col-md-12 table-responsive">
                        <table  cellpadding="8" cellspacing="8" style="width:100%; height:100%" border="1">
                            <thead>
                                <tr style="width:5%;">
                                    <th style="width:2% !important;">#</th>
                                    <th style="width:6% !important;">Reg No</th>
                                    <th style="width:9% !important;">Name</th>
                                    <th style="width:6% !important;">Sub</th>
                                    <th style="width:10% !important;">Book No/Sign</th>
                                    <th style="width:2% !important;">#</th>
                                    <th style="width:6% !important;">Reg No</th>
                                    <th style="width:9% !important;">Name</th>
                                    <th style="width:6% !important;">Sub</th>
                                    <th style="width:10% !important; ">Book No/Sign</th>
                                    <th style="width:2% !important;">#</th>
                                    <th style="width:6% !important;">Reg No</th>
                                    <th style="width:9% !important;">Name</th>
                                    <th style="width:6% !important;">Sub</th>
                                    <th style="width:10% !important;">Book No/Sign</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var liASeries = liExamSeating.Where(x => x.SEAT_CODE_ID == "A").ToList();
                                    var liBSeries = liExamSeating.Where(x => x.SEAT_CODE_ID == "B").ToList();
                                    var liCSeries = liExamSeating.Where(x => x.SEAT_CODE_ID == "C").ToList();
                                    int nCount = Convert.ToInt32(item.FirstOrDefault().ROW);
                                    string sEmpty = string.Empty;
                                    for (int i = 1; i <= nCount; i++)
                                    {
                                        <tr style="width:5%;">
                                            @{

                                                if (liASeries != null && liASeries.Count > 0)
                                                {
                                                    var liA = liASeries.Where(x => x.SEAT_CODE == "A" + i.ToString()).ToList();
                                                    if (liA != null && liA.Count > 0)
                                                    {
                                                        <td style="width:2% !important; ">@liASeries.FirstOrDefault().SEAT_CODE</td>
                                                        <td style="width:6% !important; ">@liASeries.FirstOrDefault().ROLL_NO</td>
                                                        <td style="width:9% !important; ">@liASeries.FirstOrDefault().FIRST_NAME (@liASeries.FirstOrDefault().DATE_OF_BIRTH)</td>
                                                        <td style="width:6% !important; ">@liASeries.FirstOrDefault().COURSE_CODE</td>
                                                        <td style="width:10% !important;"></td>
                                                        liASeries.RemoveAt(0);
                                                    }
                                                    else
                                                    {
                                                        sEmpty = EmptyRows();
                                                        @Html.Raw(sEmpty);
                                                    }
                                                }
                                                else
                                                {
                                                    sEmpty = EmptyRows();
                                                    @Html.Raw(sEmpty);
                                                }

                                                if (liBSeries != null && liBSeries.Count > 0)
                                                {
                                                    var liB = liBSeries.Where(x => x.SEAT_CODE == "B" + i.ToString()).ToList();
                                                    if (liB != null && liB.Count > 0)
                                                    {
                                                        <td style="width:2% !important; ">@liBSeries.FirstOrDefault().SEAT_CODE</td>
                                                        <td style="width:6% !important; ">@liBSeries.FirstOrDefault().ROLL_NO</td>
                                                        <td style="width:9% !important; ">@liBSeries.FirstOrDefault().FIRST_NAME (@liBSeries.FirstOrDefault().DATE_OF_BIRTH)</td>
                                                        <td style="width:6% !important; ">@liBSeries.FirstOrDefault().COURSE_CODE</td>
                                                        <td style="width:10% !important;"></td>
                                                        liBSeries.RemoveAt(0);
                                                    }
                                                    else
                                                    {
                                                        sEmpty = EmptyRows();
                                                        @Html.Raw(sEmpty);
                                                    }
                                                }
                                                else
                                                {
                                                    sEmpty = EmptyRows();
                                                    @Html.Raw(sEmpty);
                                                }

                                                if (liCSeries != null && liCSeries.Count > 0)
                                                {
                                                    var liC = liCSeries.Where(x => x.SEAT_CODE == "C" + i.ToString()).ToList();
                                                    if (liC != null && liC.Count > 0)
                                                    {
                                                        <td style="width:2% !important; ">@liCSeries.FirstOrDefault().SEAT_CODE</td>
                                                        <td style="width:6% !important; ">@liCSeries.FirstOrDefault().ROLL_NO</td>
                                                        <td style="width:9% !important; ">@liCSeries.FirstOrDefault().FIRST_NAME (@liCSeries.FirstOrDefault().DATE_OF_BIRTH)</td>
                                                        <td style="width:6% !important; ">@liCSeries.FirstOrDefault().COURSE_CODE</td>
                                                        <td style="width:10% !important; "></td>
                                                        liCSeries.RemoveAt(0);
                                                    }
                                                    else
                                                    {
                                                        sEmpty = EmptyRows();
                                                        @Html.Raw(sEmpty);
                                                    }
                                                }
                                                else
                                                {
                                                    sEmpty = EmptyRows();
                                                    @Html.Raw(sEmpty);
                                                }
                                            }
                                        </tr>
                                                }
                                }
                            </tbody>
                        </table>
                    </div>


                    <div class="col-md-12">
                        <table cellpadding="5" cellspacing="5">
                            <tr>
                                <th width="15%"> No Of Present : </th>
                                <th width="25%"></th>
                                <th width="25%"> No Of Absent : </th>
                                <th width="15%"></th>
                                <th width="20%"> Signature Of The Invigilator : </th>
                            </tr>
                        </table>
                    </div>
                </div>
                                                            }
                                                        }
                                                    }
                                                }