<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        //var tbl = $('#tblLiERSetting').DataTable();
        $('.selectpicker').selectpicker('refresh');
        handleDatepicker = function () {
            "use strict";


            $("#txtStartDate").datepicker({
                todayHighlight: true,
                autoclose: true,
              //  endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#txtEndDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();
        var Count = 0;
        var Status = 0;

         



        $('#ExamRevaluationList').change(function () {

            if($('#ExamRevaluationList').val())
            {

                $.ajax({
                    url: "/Examination/FetchRegularandFailedCoursesForRevaluation",
                    type: "post",
                    data: { sExamRevaluationSettingId: $('#ExamRevaluationList').val() },
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {

                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }
                        else {
                            $('#bindCourse').html('');

                            var StartDiv = "<table class='table table-hover table-bordered' id='tblCourse'><thead><tr><td>Paper</td>"+
                                "<td>Internal</td><td>External</td><td>Total</td><td>Result</td><td>Select</td></tr></thead>";
                            $.each(data.oResult, function (id, info)
                            {
                                StartDiv += "<tr>";
                                StartDiv += "<td><p>" + info.COURSE_TITLE + "</p></td>";
                                StartDiv += "<td><p>" + info.INTERNAL_MARK + "</p></td>";
                                StartDiv += "<td><p>" + info.EXTERNAL_MARK + "</p></td>";
                                StartDiv += "<td><p>" + info.TOTAL + "</p></td>";
                                StartDiv += "<td><p>" + info.RESULT + "</p></td>";
                                StartDiv += "<td><div class='checkbox checkbox-css checkbox-success'>" +
                                            "<input type='checkbox' id='cbx" + info.COURSE_ID + "' value='" + info.COURSE_ID + "' cms-checked='false'>" +
                                            "<label for='cbx" + info.COURSE_ID + "'>" +
                                            "</label>" +
                                        "</div></td></tr>";
                            });
                                StartDiv += "</table>";
                                $('#bindCourse').append(StartDiv);
                                $('.selectpicker').selectpicker('refresh');

                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }

                });
            }
        });






        function FetchLiERRegistrationById(ExamRevaluationRegisterId) {
            $('#pBody').parsley().destroy();

            if (ExamRevaluationRegisterId != null) {
                $.ajax({
                    url: "/Examination/FetchLiExamRevaluationRegistrationById",
                    type: "post",
                    data: { sExamRevaluationRegisterId: ExamRevaluationRegisterId },
                    success: function (data) {
                        if (data.Message != null) {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        else {
                            if (data.liRevaluationRegistration[0] != null) {

                                $('#ExamRevaluationList option[value="' + data.liRevaluationRegistration[0].EXAM_REVALUATION_SETTING_ID + '"]').attr("selected", "selected");
                                $('#txtAmount').attr('value', data.liRevaluationRegistration[0].AMOUNT);
                                $('#ERRegisterId').attr('value', data.liRevaluationRegistration[0].EXAM_REVALUATION_REGISTER_ID);


                                //

                                var CourseId=data.liRevaluationRegistration[0].PAPERS;
                                var liCourses = CourseId.split(",");

                                var status = 0;
                                $('#bindCourse').html('');

                                var StartDiv = "<table class='table table-hover table-bordered' id='tblCourse'><thead><tr><td>Paper</td>" +
                                    "<td>Internal</td><td>External</td><td>Total</td><td>Result</td><td>Select</td></tr></thead>";
                                $.each(data.liSemesterMarks, function (id, info) {
                                    StartDiv += "<tr>";
                                    StartDiv += "<td><p>" + info.COURSE_TITLE + "</p></td>";
                                    StartDiv += "<td><p>" + info.INTERNAL_MARK + "</p></td>";
                                    StartDiv += "<td><p>" + info.EXTERNAL_MARK + "</p></td>";
                                    StartDiv += "<td><p>" + info.TOTAL + "</p></td>";
                                    StartDiv += "<td><p>" + info.RESULT + "</p></td>";


                                    $.each(liCourses, function (id, licourse) {

                                        if (info.COURSE_ID == licourse)
                                        {
                                            StartDiv += "<td><div class='checkbox checkbox-css checkbox-success'>" +
                                            "<input type='checkbox' id='cbx" + info.COURSE_ID + "' value='" + info.COURSE_ID + "' cms-checked='true' checked>" +
                                            "<label for='cbx" + info.COURSE_ID + "'>" +
                                            "</label>" +
                                            "</div></td>";
                                            status = 1;
                                            Count = Count + 1;
                                            // fire the click event
                                            HideCheckBoxes();

                                        }
                                    });

                                    if(status=="0")
                                    {
                                        StartDiv += "<td><div class='checkbox checkbox-css checkbox-success'>" +
                                           "<input type='checkbox' id='cbx" + info.COURSE_ID + "' value='" + info.COURSE_ID + "' cms-checked='false'>" +
                                           "<label for='cbx" + info.COURSE_ID + "'>" +
                                           "</label>" +
                                           "</div></td>";
                                    }
                                    StartDiv += "</tr>";
                                    status = 0;

                                });
                                StartDiv += "</table>";
                                $('#bindCourse').append(StartDiv);
                                $('.selectpicker').selectpicker('refresh');

                            }
                        }

                    },
                    error: function (ex) {
                        alert(ex.Message);
                    }
                });
            }
        }








        function CheckBoxClick()
        {

            //get maximum paper
            var MaxPaper = $('#ExamRevaluationList option:selected').attr("cms-max-paper");

            if (MaxPaper != null && MaxPaper != "") {

                $('#tblCourse tbody tr').each(function () {



                    if ($(this).find("input[type = 'checkbox']").prop('checked') == true && $(this).find("input[type = 'checkbox']").attr("cms-checked") == "false") {

                        // it will check the maximum limit
                        if (parseInt(Count) > parseInt(MaxPaper) - 1) {


                            swal({ title: "Info", text: "Sorry Maximum Paper is " + MaxPaper + "!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });

                            //uncheck the current check box
                            $(this).find("input[type = 'checkbox']").prop('checked', false);

                            //disable the all the other check boxes
                            HideCheckBoxes();
                            return false;
                        }

                        //next to proceed
                        Count = Count + 1;

                        CirculateAmount("0");

                        //mark as it is evaluated
                        $(this).find("input[type = 'checkbox']").attr("cms-checked", "true");
                    }
                    if ($(this).find("input[type = 'checkbox']").prop('checked') == false && $(this).find("input[type = 'checkbox']").attr("cms-checked") == "true") {

                        $(this).find("input[type = 'checkbox']").attr("cms-checked", "false");
                        Count = Count - 1;
                        CirculateAmount("1");

                        // enable the checkboxes
                        ShowCheckBoxes();

                    }

                });
            }
        }






        $('#tblCourse').find("input[type = 'checkbox']").live("click", function () {

            CheckBoxClick();

        });

        function CirculateAmount(status)
        {

            var amount = $('#ERAmount').val() != "" ? $('#ERAmount').val() : 0;
            amount = parseInt(amount) * 1;
            var ActualAmount = $('#txtAmount').val() != "" ? $('#txtAmount').val() : 0;
            if (status=="0")
            {

                ActualAmount = parseInt(ActualAmount) + amount;
            }
            else {
                ActualAmount = parseInt(ActualAmount) - amount;
            }

            $('#txtAmount').val(ActualAmount);

        }

        function HideCheckBoxes()
        {

            $('#tblCourse tbody tr').each(function () {

                if ($(this).find("input[type = 'checkbox']").attr("cms-checked") == "false") {
                    $(this).find("input[type = 'checkbox']").attr("disabled", true);

                }
            });
        }

        function ShowCheckBoxes()
        {
            $('#tblCourse tbody tr').each(function () {

                if ($(this).find("input[type = 'checkbox']").attr("cms-checked") == "false") {
                    $(this).find("input[type = 'checkbox']").attr("disabled", false);
                }
            });
        }







        $('#btnSubmit').click(function () {

            var isValid = true;
            var sCount=0;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var RevaluationSetting = $('#ExamRevaluationList').val();
            var Papers = [];


            $('#tblCourse tbody tr').each(function () {

                $(this).find("input[type = 'checkbox']").each(function () {

                    if ($(this).prop('checked') == true) {

                        Papers.push($(this).val());
                        sCount++;

                    }
                });

            });

            var Amount = $('#txtAmount').val();
            var ExamRevaluationRegistrationId = $('#ERRegisterId').val();
            var ExamRevaluationSettingId = $('#ExamRevaluationList').val();
            var jsonData = '{"EXAM_REVALUATION_REGISTER_ID":"' + ExamRevaluationRegistrationId + '","EXAM_REVALUATION_SETTING_ID":"' + ExamRevaluationSettingId + '","STUDENT_ID":"","PAPERS":"' + Papers + '","AMOUNT":"' + Amount + '","REGISTERED_DATE":""}';


              var req=  $.ajax({
                  url: "/Examination/SaveorUpdateExaminationRevaluationRegistration",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "" && data.ErrorCode != "" && data.ErrorCode!=null)
                        {

                                if (data.ErrorCode=="201")
                                {
                                    swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                                }
                                if (data.ErrorCode == "200") {
                                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                    loadContent('/Examination/ListRevaluationRegistration');
                                }
                                if (data.ErrorCode == "304") {
                                    swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                                }
                        }
                        else {
                            swal({ title: "Info", text: "Something went wrong so please try again!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

              });
              @*req.done(function (response) {
                  var item = @Html.Raw(Json.Encode(Model.liRules));
                  alert(item[0].MAX_BOOKS);
                  tbl.rows().remove().draw();
                  for(var i=0;i<item.length;i++)
                  {

                         //alert(item[i].MAX_BOOKS);
                         var result=[];
                         result.push(i);
                         result.push(item[i].CATEGORY_NAME);
                         result.push(item[i].MAX_BOOKS);
                         result.push(item[i].LOAN_PERIOD);
                         result.push(item[i].FINE_AMOUNT);
                         result.push(item[i].DEPOSIT);
                         result.push(item[i].AUTORENEVAL);
                         result.push(item[i].EXTRA_BOOKS);
                         result.push(item[i].EXTRA_BOOKS);

                  }
                  tbl.rows.add(result);
                  tbl.draw();
              });*@


        });





    GetConfirm = function (ExamRevaluationRegisterId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            var req = $.ajax({
                url: "/Examination/DeleteLiExamRevaluationRegistration",
                type: "post",
                data: { sExamRevaluationRegisterId: ExamRevaluationRegisterId },
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Examination/ListRevaluationRegistration');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

        req.done(function (response) {
            tbl.rows().remove().draw();
            tbl.rows.add(response).draw();
        });
        }

    $('#btnAdd').click(function () {

        $('#pBody').parsley().destroy();
        Count = 0;
            $('#ExamRevaluationList option[value=""]').attr("selected", "selected");
            $('#txtAmount').val('');
            $('#bindCourse').html('');
            $('#ERRegisterId').attr('value', '');
            $('.selectpicker').selectpicker('refresh');
        });






        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
        }



        function RegisterExamRevaluation(RevaluationSettingId)
        {
            if(RevaluationSettingId!=null)
            {

                $.ajax({
                    url: "/Examination/RegisterRevaluation",
                    type: "post",
                    data: { sExamRevaluationSettingId: RevaluationSettingId },
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {

                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }
                });
            }
        }




</script>




