<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListPhotoCopyRegistration</li>
    </ol>
    <h1 class="page-header">List Photo Copy Registration</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Photo Copy Registration</h4>
        </div>
        <div class="panel-body table-responsive">
            @*<div class="form-group col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#ERRegistration-dialog" data-toggle="modal" id="btnAdd"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>*@


            <table class="table table-hover table-bordered" id="tblLiEPRegistratoin">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Exam Setting</th>
                        <th>Maximum Paper</th>
                        <th>Start Date</th>
                        @*<th>Question Type</th>*@
                        <th>End Date</th>
                        <th>Action</th>
                        <th>Status</th>
                        <th>View</th>
                    </tr>
                </thead>
                <tbody>

                    @if (Model.liExamPhotoCopySetting != null && Model.liExamPhotoCopySetting.Count > 0)
                    {
                        //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                        //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                        var count = 0;
                        foreach (var item in Model.liExamPhotoCopySetting)
                        {
                            count = count + 1;
                            <tr>
                                <td>@count</td>

                                <td>@item.EXAM_SETTING</td>
                                <td>@item.MAX_PAPER</td>
                                <td>@item.START_DATE</td>
                                <td>@item.END_DATE</td>
                                @*<td>@item.QUESTION_TYPE</td>*@
                                @*<td>
                                        <select class="form-control    selectpicker show-menu-arrow show-tick" data-live-search="true" id="CourseList" name="CourseList" style="display: none;" multiple="multiple">
                                            <option value=""></option>
                                            @foreach (var item1 in Model.liExamRevaluationRegistration)
                                            {

                                                <option value="@item1.COURSE_ID" selected="selected">@item1.COURSE_TITLE</option>
                                            }
                                        </select>
                                    </td>*@
                                @if (item.STATUS != "1")
                                {
                                    @*<td><i class="fa fa-inr f-s-14"> @item.BALANCE</i></td>*@
                                    // <td><a href="/FEE/RazorPayPaymentGate?sFrequencyTypeId=@item.FREQUENCY_TYPE_ID&sFeeRootId=@item.FEE_ROOT_ID" class="btn btn-success " title="Go for Payment"><i class="ion-card"></i> Proceed to Pay</a></td>
                                    <td><a href="javascript:;" onclick="loadContent('/Examination/RegisterPhotoCopy?sExamPhotocopySettingId=@item.EXAM_PHOTOCOPY_SETTING_ID')" class="btn btn-success" title="Go for Register"><i class="ion-card"></i>Proceed to Register</a></td>
                                        <td><label class="label label-danger f-s-12">Not Registered</label></td>
                                }
                                else
                                {
                                    // <td><label class="fa fa-inr f-s-14"> @item.DEBIT</label></td>
                                    if (item.DEBIT != "0" && item.DEBIT != "")
                                    {
                                        <td><i class="ion-ios-checkmark-outline fa-2x text-success"></i></td>
                                        <td><label class="label label-success f-s-12">Registered</label></td>
                                    }
                                    else
                                    {
                                        <td><a href="javascrip:;" onclick="loadContent('/FEE/FEEBALANCELIST')" class="btn btn-success" title="Go for Payment"><i class="ion-card"></i>Proceed to Pay</a></td>
                                        <td><label class="label label-success f-s-12">Pending</label></td>
                                    }

                                   
                                }
                                @if (item.STATUS != "1")
                                {
                                    <td><a href="javascript:;" data-toggle="" onclick="" title="" style="text-decoration:none"><i class="glyphicon glyphicon-eye-close"></i></a></td>
                                }
                                else
                                {
                                   

                                    <td><a href="javascript:;" data-toggle="modal" onclick="loadContent('/Examination/ViewPhotoCopyForStudents?sExamPhotoCopyRegistrationId=@item.EXAM_PHOTOCOPY_REGISTER_ID')" title="View" style="text-decoration:none"><i class="glyphicon glyphicon-eye-open"></i></a></td>
                                }

                            </tr>
                        }

                    }
                    else
                    {
                        <tr><td> No Records Found..! </td> </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
