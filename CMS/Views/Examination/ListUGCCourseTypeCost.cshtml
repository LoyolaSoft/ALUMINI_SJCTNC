@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ListUGCCourseTypeCost";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
}
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">UGC Type Cost List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">UGC Type Cost List<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">UGC Type Cost List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12 table-responsive">
                            <div class="form-group">
                                <a class="btn btn-success pull-right" href="#ModalContent-dialog" data-toggle="modal"><i class="fa fa-plus"></i> ADD</a>
                            </div>
                            <br />
                            <table class="table table-bordered table-hover" id="tblListUGCType">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Title</th>
                                        <th>Exam Setting</th>
                                        <th>UGC Type</th>
                                        <th>Programme Type</th>
                                        <th>Last Date</th>
                                        <th>Cost</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.liUGCTypeCostList != null && Model.liUGCTypeCostList.Count > 0)
                                    {
                                        foreach (var item in Model.liUGCTypeCostList)
                                        {
                                            <tr>
                                                <td>@{nCount++;} @nCount</td>
                                                <td>@item.TITLE</td>
                                                <td>@item.EXAM_NAME</td>
                                                <td>@item.SUBJECT_TYPE</td>
                                                <td>@item.APPLICATION_TYPE</td>
                                                <td>@item.LAST_DATE_FOR_EXAM_FEE</td>
                                                <td>@item.COST</td>
                                                <td>
                                                    <a href="#ModalContent-dialog" data-toggle="modal" onclick="GetUGCCourseTypeCostById(@item.UGC_TYPE_COST_ID);"><i class="fa fa-edit text-primary"></i></a>
                                                    <a href="javascript:;" onclick="GetConfrim(@item.UGC_TYPE_COST_ID);"><i class="fa fa-trash text-danger"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<!-- Begin Modal -->
<div class="modal" id="ModalContent-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit UGC Type Cost</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">

                            <!-- Title -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Title", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="txtTitle" class="form-control" />
                                </div>
                            </div>

                            <!-- Exam Setting -->
                            <div class="col-md-12 form-group ">
                                @Html.Label("Exam Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamList, (Model.ExamList != null) ? Model.ExamList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <!-- Programme Type -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Programme Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <!-- UGC Type -->
                            <div class="col-md-12 form-group">
                                @Html.Label("UGC Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.UgcType, (Model.UgcType != null) ? Model.UgcType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>



                            <!-- Cost -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Cost", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="number" id="txtCost" class="form-control" />
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->
<!-- Hidden Value -->
<input type="hidden" id="hdUGCCostId" />
<!-- Hidden Value -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        ContentLoad = function ()
        {
            //Ready Function()
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
        $('#tblListUGCType').DataTable();

        // Get UGC Cost Info By Id ,...
        function GetUGCCourseTypeCostById(ID)
        {
            $.ajax({
                url: '@Url.Action("FetchUGCCourseTypeCostById", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sUGCTypeId: ID },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                             swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    } else
                    {
                        $('#hdUGCCostId').val(data[0].UGC_TYPE_COST_ID);
                        $('#txtTitle').val(data[0].TITLE);
                        $('#UgcType').val(data[0].UGC_COURSE_TYPE_ID);
                        $('#ApplicationType').val(data[0].PROGRAMME_TYPE_ID);
                        $('#ExamList').val(data[0].EXAM_SETTING_ID);
                        $('#txtCost').val(data[0].COST);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }

        // Delete UGC Cost Info By Id ,..
        function GetConfrim(ID)
        {
            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
                function () {
                    $.ajax({
                    url: '@Url.Action("DeleteUGCCourseTypeCost", "Examination")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sUGCTypeId: ID },
                    success: function (data)
                    {
                        loadContent("/Examination/ListUGCCourseTypeCost");
                        if (data.ErrorCode == '200') {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        }
                        else {
                            swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                        }

                    }, error: function (error)
                    {
                        swal({ title: "Internal Server Error!",text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });

                });
        }

        // On Submit Details
        $('#btnSubmit').on('click', function ()
        {
            var sJsonData = null;
            sJsonData = '{"UGC_TYPE_COST_ID":"' + $('#hdUGCCostId').val() + '","TITLE":"' + $('#txtTitle').val() + '","UGC_COURSE_TYPE_ID":"' + $('#UgcType').val() + '","PROGRAMME_TYPE_ID":"' + $('#ApplicationType').val() + '","EXAM_SETTING_ID":"' + $('#ExamList').val() + '","COST":"' + $('#txtCost').val() + '"}';
            $.ajax({
                url: '@Url.Action("SaveUGCCourseTypeCost", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sSaveJsonData: sJsonData },
                success: function (data)
                {
                    //alert(data.Message);

                    loadContent("/Examination/ListUGCCourseTypeCost");
                    if (data.ErrorCode == '200') {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    }
                    else {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                }
            });
        });
</script>







