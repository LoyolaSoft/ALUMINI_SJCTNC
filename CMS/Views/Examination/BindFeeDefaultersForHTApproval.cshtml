

@model CMS.ViewModel.ViewModel.FeeTransactionViewModel


<div class="form-group table-responsive">
    @{ int count = 0;}
    <table class="table table-hover table-bordered" id="tblStudentList">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Due Amount</th>
                <th>Approval Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFeeDueReport != null)
            {
                foreach (var item in Model.liFeeDueReport)
                {
                    <tr id="@item.STUDENT_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.TOTAL_DUE_AMOUNT</td>
                        <td>
                            @if (item.IS_APPROVED == "1")
                            {
                                <i class="fa fa-check text-success" onclick="ApproveToHallTickt(@item.STUDENT_ID,'0');"></i>

                            }
                            else
                            {
                                <i class="fa fa-close text-danger" onclick="ApproveToHallTickt(@item.STUDENT_ID,'1');"></i>

                            }
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>

