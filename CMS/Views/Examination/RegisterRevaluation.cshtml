            </div>

            <div class="col-md-12 form-group">
                <label class="col-md-8 control-label">Amount</label>
                <div class="col-md-4">
                    <input type="number" id="txtAmount" class="form-control" placeholder="Amount" data-parsley-required="true" readonly>
                </div>

            </div>

            <div class="form-group col-lg-12 row">
                <div class="form-group pull-right">
                    <div class="col-md-5">
                        <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                    </div>
                    <div class="col-md-5">
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal" id="btnCancel">Cancel</a>
                    </div>
                </div>
            </div>





        </div>
    </div>
</div>
