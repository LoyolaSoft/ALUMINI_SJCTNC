@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{int count = 0;}
@if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count>0)
{
    foreach (var item in Model.liCollegeDetails)
    {
        <center>
            <table>
                <tr>
                    <td><center><strong>@item.COLLEGE_NAME</strong></center></td>
                </tr>
                <tr>
                    <td><b> @item.GRADE</b></td>
                </tr>
                <tr>
                    <td class="text-center">
                        @item.UNIVERSITY
                    </td>
                </tr>
            </table>
        </center>
    }
}

<br /> <br />
@if (Model.liExamRegisteredList != null)
{

    <div class="form-group">
        <center> <strong> Regular Student List </strong></center>
    </div>
    <br />
        <table class="table table-hover table-bordered" id="RegularExamRegisteredStudentList">
        <thead>
            <tr>
                <th>#</th>
                <th>Class</th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>Name</th>
                <th>Course Code</th>
                <th>Course Title</th>
            </tr>
        </thead>
        <tbody>
       
                @foreach (var item in Model.liExamRegisteredList)
                {
                    <tr>
                        <td>@{ count++;}@count</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.COURSE_TITLE</td>
                    </tr>
                }
                        
        </tbody>
    </table>

 }
