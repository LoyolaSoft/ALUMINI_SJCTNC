@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "SemesterMarkUpdation";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Semester Mark Updation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Semester Mark Updation</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">SemesterMarkUpdation</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.AcademicYearList, "Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ResultMonth, "Result Month", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ResultMonth, (Model.ResultMonth != null) ? Model.ResultMonth : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ResultMonth, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ApplicationType, "Application Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ProgrammeList, "Programme List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.CourseList, "Course List", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <div class="col-md-1 col-md-offset-2 pull-right">
                                @*<a class="btn btn-primary" id="btnGetIndvidualSemeterMark" title="Click to Get the MarkSheet">Get</a>*@
                            </div>
                            <div class="col-md-1 col-md-offset-2 pull-right">
                                <a class="btn btn-primary" id="btnGetIndvidualSemeterMark" title="Click to Get the MarkSheet">Get</a>
                            </div>
                        </div>
                    </div>
                    <div class="row col-md-12">
                        <div id="dvIndvidualSemesterMark"></div>
                    </div>
                    <div class="row col-md-12">
                        <a class="btn btn-success" id="btnUpdateSemesterMark" title="Click to Update the Mark">Submit</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 4
    });

    $("#AcademicYearList").on("change", function () {
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        if (vAcademicYear == '' || vAcademicYear == '0') {
            alert('Please Choose AcademicYear...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindMonthByAcademicYear", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sAcademicYear: vAcademicYear },
            success: function (data) {
                $("#ResultMonth").empty();
                $("#ResultMonth").append('<option value="">-- select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });
    $("#ApplicationType").on("change", function () {

        var sApplictionTypeId = $("#ApplicationType").val();
        $.ajax({
            url: "@Url.Action("FetchProgrammeByAppType", "Student")",
            method: "POST",
            datatype: "json",
            data: { sApplictionId: sApplictionTypeId },
            success: function (data) {
                $("#ProgrammeList").empty();
                $("#ProgrammeList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error ! ');
            }
        });
    });
    $('#btnGetIndvidualSemeterMark').on("click", function () {
        var vResultMonth = $('#ResultMonth').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vCourse = String($('#CourseList').val());
        if (vResultMonth == '' || vResultMonth == '0' && vAcademicYear == '' || vAcademicYear == '0' && $('#CourseList').val()) {
            alert('Please Choose All the Fields...!!!');
            return false;
        }
        $.ajax({
            url: "@Url.Action("BindSemesterMarkUpdate", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sCourseId: vCourse, sExamSettingId: vResultMonth, sAcademicYear: vAcademicYear, sProgrammeGroupId: $("#ProgrammeList").val() },
            success: function (data) {
                $('#dvIndvidualSemesterMark').empty();
                $('#dvIndvidualSemesterMark').append(data);
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });



    $('#btnUpdateSemesterMark').on("click", function () {
        if (Validate()) {          
            alert('Mark should be less than or equal to Maximum mark...');
            return false;
        }
        var jsonObject;
        if (jsonObject == null) {
            jsonObject = '{"JSON_LISEMESTER_MARKS":[';
            $('#tblSemestermark tbody tr').each(function () {                          
                jsonObject += '{"SEMESTER_MARK_ID":"' + $(this).attr("cms-semarkid") + '","COURSE_ID":"' + $(this).attr("cms-courseId") + '","ACADEMIC_YEAR":"' + $('#AcademicYearList option:selected').text() + '","INTERNAL_MARK":"' + ($(this).find('td:eq(3) input[type="text"]').val()) + '","EXTERNAL_MARK":"' + ($(this).find('td:eq(4) input[type="text"]').val()) + '","TOTAL":"' + ($(this).find('td:eq(5) input[type="text"]').val()) + '","RESULT":"' + ($(this).find('td:eq(6) input[type="text"]').val()) + '"},';
            });
            jsonObject = jsonObject.slice(0, -1);
            jsonObject += ']}';
        }
        $.ajax({
            url: "@Url.Action("UpdateSemesterMark", "Examination")",
            method: "post",
            content: "application/json; charset=utf-8",
            data: { JsonUpdateSemesterMark: jsonObject },
            success: function (data) {
                alert(data.Message);
                $('#btnGetIndvidualSemeterMark').click();
            }, error: function (e) {
                alert('Internal Server Error !');
            }
        });
    });

    function Validate() {




        var validate = 0;
        var Total = 0;
        $('#tblSemestermark  tbody tr td').each(function () {
            if ($(this).find('input[type="text"]').attr("cms-studentId")) {
                alert($(this).find('td:eq(3) input[type="text"]').val());
                if (($(this).find('td:eq(3) input[type="text"]').val() != "A") && ($(this).find('td:eq(4) input[type="text"]').val() != "A")) {
                    Total = parseInt($(this).find('td:eq(3) input[type="text"]').val()) * (parseInt($(this).find('td:eq(4) input[type="text"]').val()))
                    alert(Total);
                    $(this).find('td:eq(5) input[type="text"]').val(Total);
                }                
                if (parseInt($(this).find('input[type="text"]').val()) > parseInt($(this).find('input[type="text"]').attr("max"))) {
                    $(this).find('input[type="text"]').css('color', 'red');
                    validate = 1;
                } else {
                    $(this).find('input[type="text"]').css('color', 'black');
                }
            }
        });
        return validate;
    }
</script>




