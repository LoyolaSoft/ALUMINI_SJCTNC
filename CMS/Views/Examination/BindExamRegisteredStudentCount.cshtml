@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{int count = 0;}
@if (Model.liCollegeDetails != null)
{
    foreach (var item in Model.liCollegeDetails)
    {
        <center>
            <table>
                <tr>
                    <td><center><strong>@item.COLLEGE_NAME</strong></center></td>
                </tr>
                <tr>
                    <td><b> @item.GRADE</b></td>
                </tr>
                <tr>
                    <td class="text-center">
                        @item.UNIVERSITY
                    </td>
                </tr>
            </table>
        </center>
    }
}
<table class="table table-hover table-bordered" id="ExamRegisteredStudentList">
    <thead>
        <tr>
            <th>#</th>
            <th>Exam Name</th>
            <th>Course Code</th>
            <th>Course Title</th>
            <th>Total Student</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.liExamRegisteredList != null && Model.liExamRegisteredList.Count>0)
        {
            foreach (var item in Model.liExamRegisteredList)
            {
                <tr>
                    <td>@{ count++;}@count</td>
                    <td>@item.EXAM_NAME</td>
                    <td>@item.COURSE_CODE</td>
                    <td>@item.COURSE_TITLE</td>
                    <td>@item.TOTAL_COUNT</td>
                </tr>
            }
        }
    </tbody>
</table>

