@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Add/Edit Course Wise Cost List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Add/Edit Course Wise Cost List <small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Add/Edit Course Wise Cost List </h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12">
                           
                            <div class="col-md-6">
                                <label class="control-label col-md-3">UGC Type</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.UgcType, (Model.UgcType != null) ? Model.UgcType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="control-label col-md-3">Programme Year</label>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ProgrammeYear, (Model.ProgrammeYear != null) ? Model.ProgrammeYear : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>


                        </div>

                        <div class="col-md-12">
                            <div id="dvBindCourseWiseCost"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
    }

    $('#UgcType').on('change', function () {
        FetchCourseWiseCostList();
    });

    $('#ProgrammeYear').on('change', function ()
    {
        FetchCourseWiseCostList();
    });


    function FetchCourseWiseCostList()
    {
        if ($('#UgcType').val() && $('#ProgrammeYear').val())
        {
            $.ajax({
                url: '@Url.Action("BindAddOrEditExamCourseWiseCost", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sUgcCourseTypeId: $('#UgcType').val(), sProgrammeYear: $('#ProgrammeYear').val() },
                success: function (data)
                {
                    $('#dvBindCourseWiseCost').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#dvBindCourseWiseCost').append(data);
                        $('.table').DataTable({ "bPaginate": false });
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    }
</script>