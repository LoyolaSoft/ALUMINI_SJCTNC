@*<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>*@
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    var Count = 0;
    var sQuestionType = '';
    function ContentLoad()
    {
        // Document Ready Function .
        $('#tblMatchTheFollowing').DataTable();
        var liMessage = $('#hdErrorMessage').val();
        if (liMessage != null && liMessage != '')
        {
            alert(liMessage);
        }
    }

    function FetchMathTheFollowingById(QUIZ_ID, Question,QuestionTypeId,sMark)
    {
        var Option = '';
        var Option2 = '';
        sQuestionType = QuestionTypeId;
        $('#hdQuizId').val(QUIZ_ID);
        $.ajax({
            url: "@Url.Action("FetchMatchTheFollowingByQuizId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sQuizId: QUIZ_ID, sQuestionTypeId: QuestionTypeId },
            success: function (data) {
                if (data.sErrorMessage != null && data.sErroeMessage != '')
                {
                    alert(data.sErroeMessage);
                } else
                {
                    //$('#Mark').addClass('hidden');
                    $("#dvOptions1").empty();
                    $("#dvOptions2").empty();
                    $("#dvOptions3").empty();
                    $('#txtMark').val(sMark);
                    if (QuestionTypeId == "3")
                    {
                        $('#dvMathTheFollowing').removeClass('hidden');
                        $('#dvOtherType').addClass('hidden');

                       // $('#Mark').removeClass('hidden');
                        // Match The Following ...
                        $.each(data, function (i, Quiz)
                        {
                            //alert(data[i].QUESTION);
                            var j = i;
                            j++;
                            Option += '<div class="form-group" id="Qustion_' + i + '">';
                            Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
                            Option += '<div class="col-md-9">';
                            Option += '<input type="text" value="' + data[i].QUESTION + '" cms-OptionId="' + Quiz.OPTION_ID + '" id="Qustions' + i + '" class="form-control" placeholder="Enter Your Questions" maxlength="145">';
                            Option += '</div>';
                            Option += '</div>';
                            Option2 += '<div class="form-group" id="Option_' + i + '">';
                            Option2 += '<div class="col-md-12">';
                            Option2 += '<input type="text" value="' + data[i].ANSWER + '" id="Option' + i + '" class="form-control" placeholder="Enter Your Options" maxlength="145">';
                            Option2 += '</div>';
                            Option2 += '</div>';
                            Count = i;
                        });
                        $("#dvOptions1").append(Option);
                        $("#dvOptions2").append(Option2);
                    } else
                    {
                        $('#dvMathTheFollowing').addClass('hidden');
                        $('#dvOtherType').removeClass('hidden');
                        // Objective Type && Fill In The Blank Quiz ...
                        $.each(data, function (i, Quiz)
                        {
                            if (Quiz.ANSWER != null && Quiz.ANSWER != '')
                            {
                                //alert(Quiz.ANSWER);
                                $('#txtAnswer').val(Quiz.ANSWER);
                            }
                            var j = i;
                            j++;
                            Option += '<div class="form-group" id="Qustion_' + i + '">';
                            Option += '<label class ="col-md-2 control-label">' + j + ' .)</label>';
                            Option += '<div class="col-md-10">';
                            Option += '<input type="text" value="' + data[i].OPTION + '" cms-OptionId="' + Quiz.OPTION_ID + '" id="Option' + i + '" class="form-control" placeholder="Enter Your Options" maxlength="145">';
                            Option += '</div>';
                            Option += '</div>';
                            //Option2 += '<div class="form-group" id="Option_' + i + '">';
                            //Option2 += '<div class="col-md-9">';
                            //Option2 += '<input type="number" value="' + Quiz.MARK + '" id="Mark' + i + '" class="form-control" placeholder="Enter Your Mark">';
                            //Option2 += '</div>';
                            //Option2 += '</div>';
                            Count = i;

                        });
                        $('#Answer').removeClass('hidden');
                        $("#dvOptions3").append(Option);
                    }
                    $("#TxtTitle").val(Question);
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }

    function AddTextBox()
    {
        Count++;
        var i = Count;
        var j = Count + 1;
        if (j > 10)
        {
            alert('Invalid Option .! Maximum Option is 10 .');
            Count--;
            return false;
        }
       // alert(sQuestionType);

        if (sQuestionType == "3")
        {
            // Bind Match The Following Type Empty Text Box ....
            var Option = '';
            Option += '<div class="form-group" id="Qustion_' + i + '">';
            Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
            Option += '<div class="col-md-9">';
            Option += '<input type="text" value="" id="Qustions' + i + '" cms-OptionId="" class="form-control" placeholder="Enter Your Questions"  maxlength="145">';
            Option += '</div>';
            Option += '</div>';
            $('#dvOptions1').append(Option);

            var Option2 = '';
            Option2 += '<div class="form-group" id="Option_' + i + '">';
            Option2 += '<div class="col-md-12">';
            Option2 += '<input type="text" value="" id="Option' + i + '" class="form-control" placeholder="Enter Your Options"  maxlength="145">';
            Option2 += '</div>';
            Option2 += '</div>';
            $('#dvOptions2').append(Option2);
        } else
        {
            // Bind Objective Type && Fill In The Blank Empty Text Box ...
            var Option = '';
            Option += '<div class="form-group" id="Qustion_' + i + '">';
            Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
            Option += '<div class="col-md-12">';
            Option += '<input type="text" value="" id="Option' + i + '" cms-OptionId="" class="form-control" placeholder="Enter Your Options"  maxlength="145">';
            Option += '</div>';
            Option += '</div>';
            $('#dvOptions3').append(Option);

            //var Option2 = '';
            //Option2 += '<div class="form-group" id="Option_' + i + '">';
            //Option2 += '<div class="col-md-9">';
            //Option2 += '<input type="number" value="" id="Mark' + i + '" class="form-control" placeholder="Enter Your Marks">';
            //Option2 += '</div>';
            //Option2 += '</div>';
            //$('#dvOptions2').append(Option2);
        }
    }


    $("#btnSubmit").on("click", function ()
    {
        // alert('Class :' + $("#ClassList").val() + 'Course :' + $("#CourseList").val() + 'Batch :' + $("#Batch").val());

        var Endvalue = Count;
        var Question = $("#TxtTitle").val();
        var QuizId=$('#hdQuizId').val();
        var ClassId = $("#ClassList").val();
        var CourseId = $("#CourseList").val();
        var QuestionId = $("#QuestionId").val();
        var SetId = $('#Batch').val();
        var Answer = $('#txtAnswer').val();
        var ArrayOption = '';
        var nCount = 0;
        ArrayOption = '{"liMF_Option":[';
        for (var i = 0; i <= Endvalue; i++)
        {
            if (sQuestionType == "3")
            {
                if ($("#Option" + i).val() && $("#Qustions" + i).val())
                {
                    ArrayOption += '{"QUESTION":"' + $("#Qustions" + i).val() + '","ANSWER":"' + $("#Option" + i).val() + '","OPTION_ID":"' + $("#Qustions" + i).attr('cms-OptionId') + '"},';
                    nCount++;
                } else
                {
                    alert('All the Options Must to Fill ..!');
                    return false;
                    break;
                }
            } else
            {
                if ($("#Option" + i).val())
                {
                    ArrayOption += '{"OPTION_ID":"' + $("#Option" + i).attr('cms-OptionId') + '","OPTION":"' + $("#Option" + i).val() + '"},';
                    nCount++;
                } else
                {
                    alert('All the Options Must to Fill ..!');
                    return false;
                    break;
                }
            }

        }
        if (nCount != 0)
        {
            ArrayOption = ArrayOption.slice(0, -1);
            ArrayOption += ']}';
        } else
        {
            alert('Something is went wrong . please check your code !');
            return false;
        }

        var JsonData;
        JsonData = '{"QUESTION":"' + Question + '","QUIZ_ID":"' + QuizId + '","QUESTION_TYPE":"' + sQuestionType + '","ANSWER_ID":"' + Answer + '","MARK":"' + $('#txtMark').val() + '"}';
        if (!$('#txtMark').val() || $('#txtMark').val() == '0')
        {
            alert('Please Enter Mark To Continue !');
            return false;
        }

        $.ajax({
            url:"@Url.Action("UpdateMathTheFollowingQuiz", "Examination")",
            method: "POST",
            datatype: "json",
            data: { QuizQuestion: JsonData, sSaveMatchTheFollowing: ArrayOption },
            success: function (data)
            {
                alert(data.Message);
                loadContent('/Examination/AddQuizForAdmin');
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    });



    function GetConfirm(QuizId,QuestionType)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        }
        else
            {
                $.ajax({
                    url:"@Url.Action("DeleteMatchTheFollowing", "Examination")",
                    method: "POST",
                    datatype:"json",
                    data: { sQuizId: QuizId, sQuestionType: QuestionType },
                    success:function(data)
                    {
                        alert(data.Message);
                        loadContent('/Examination/AddQuizForAdmin');
                    },error:function(error)
                    {
                        alert('Internal Server Error ! ');
                    }
                });
            }
    }

    $('#btnAdd').click(function () {

        var formData = new FormData();
        formData.append('sSettingId', $('#QuizSettingId').val());

        $.ajax({
            url: "/Examination/MatchTheFollowingForAdmin",
            type: "post",
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.Message != null) {
                    alert(data.Message)
                }
                else
                {
                    loadContent('/Examination/MatchTheFollowingForAdmin');
                }
            },
            error: function () {

            }
        });

    });
    @*$("#btnGet").on("click", function ()
    {
        var ClassId = $('#ClassList').val();
        var CourseId = $('#CourseList').val();
        if ($('#ClassList').val() && $('#CourseList').val())
        {
            $.ajax({
                url: "@Url.Action("BindMathTheFollowing", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sClassId: ClassId, sCourseId: CourseId },
                success: function (data)
                {

                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        } else
        {
            alert('Please Select All The Filed To Continue !');
            return false;
        }
    });


    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');
    $("#ClassList").on("change", function () {
        var Class = $("#ClassList").val();
        $.ajax({
            url: "@Url.Action("FethCourseByClassId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { Class_Id: Class },
            success: function (data) {
                $("#CourseList").empty();
                $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });*@
</script>


