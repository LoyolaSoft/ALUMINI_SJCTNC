<!-- Begin Modal -->

<div class="modal" id="MatchTheFollowing-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Quiz</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="form-group col-md-12">

                                <div class="col-md-8 form-group" id="Question">
                                    <label class="col-md-2 control-label">Title</label>
                                    <div class="col-md-10">
                                        <input type="text" id="TxtTitle" class="form-control" placeholder="Enter Your Title" maxlength="200">
                                    </div>
                                </div>

                                <div class="col-md-4 form-group">
                                    @*<div class="hidden" id="Mark">*@
                                    <label class="col-md-3 control-label">Mark</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtMark" class="form-control" placeholder="Enter Your Mark">
                                    </div>
                                    @*</div>*@

                                    <div class="col-md-1 form-group">
                                        <a href="javascript:;" onclick="AddTextBox();" class="btn btn-success"><i class="fa fa-plus"> Add </i></a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12 form-group hidden" id="dvMathTheFollowing">
                                <div class="col-md-6">
                                    <div id="dvOptions1"></div>
                                </div>
                                <div class="col-md-6">
                                    <div id="dvOptions2"></div>
                                </div>
                            </div>

                            <div class="col-md-12 form-group" id="dvOtherType">
                                <div id="dvOptions3"></div>
                            </div>

                            <div class="form-group col-md-12">
                                <div class="col-md-10 form-group hidden" id="Answer">
                                    <label class="col-md-2 control-label">Answer</label>
                                    <div class="col-md-10">
                                        <input type="text" id="txtAnswer" class="form-control" placeholder="Enter Your Answer" style="width:140%">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
