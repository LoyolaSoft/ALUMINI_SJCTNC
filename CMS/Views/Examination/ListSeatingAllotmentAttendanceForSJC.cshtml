@model CMS.ViewModel.ViewModel.ExaminationViewModel



@{
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List Exam Attendance</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Exam Attendance<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Exam Attendance</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">

                        <div class="col-md-4">
                            @Html.Label("Setting", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("Date", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ExamDate, (Model.ExamDate != null) ? Model.ExamDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ExamDate, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("Session", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ExamSession, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <a href="javascript:;" id="sPrint" onclick="printDiv('dvExamSeatingAllotment')" class="btn btn-sm btn-success m-b-10 disabled pull-right"><i class="fa fa-print m-r-5"></i> Print</a>
                    </div>
                </div>

                <div class="row">
                    <div id="dvExamSeatingAllotment"></div>
                </div>

            }

        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>


<script>

    $('#ExamSetting').on('change', function ()
    {
        var vExamseatingId = $('#ExamSetting').val();

        $.ajax({
            url: '@Url.Action("BindExamTimetableDatesByExamSetting", "Examination")',
            data: { sExamType: "2", sExamsettingId: vExamseatingId },
            success: function (objResult)
            {
                $('#ExamDate').empty();
                $('#ExamDate').append('<option value="0">-- select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#ExamDate').on('change', function ()
    {
        var vExamseatingId = $('#ExamSetting').val();
        var vExamDate = $('#ExamDate option:selected').text();
        $.ajax({
            url: '@Url.Action("BindExamTimetableSessionByExamDate", "Examination")',
            data: { sExamType: '2', sExamsettingId: vExamseatingId, sExamDate: vExamDate },
            success: function (objResult)
            {
                $('#ExamSession').empty();
                $('#ExamSession').append('<option value="">-- select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
     });

    $('#ExamSession').on('change', function ()
    {
        $('#dvExamSeatingAllotment').empty();
        $.ajax({
            url:'@Url.Action("BindSeatingAllotmentAttendanceForSJC", "Examination")',
            method:'POST',
            datatype: 'json',
            data: { sExamDate: $('#ExamDate option:selected').text(), sExamSession: $('#ExamSession').val(), sExamSettingId: $('#ExamSetting').val() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#dvExamSeatingAllotment').append(data);
                    $('#sPrint').removeClass('disabled');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });


    function printDiv(divName)
    {
        //var printContents = document.getElementById(divName).innerHTML;
        //myWindow = window.open('', '', 'width=200,height=100');
        //myWindow.document.write(printContents);
        //myWindow.document.close(); //missing code
        //myWindow.focus();
        //myWindow.print();
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        //window.reload();
        loadContent('/EXAMINATION/ListSeatingAllotmentAttendanceForSJC')
    }
</script>