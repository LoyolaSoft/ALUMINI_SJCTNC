

@model CMS.ViewModel.ViewModel.ExaminationViewModel


<div class="form-group table-responsive">
    @{ int count = 0;}
    <table class="table table-hover table-bordered" id="tblMalpracticeList">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Course Code</th>
                <th>Course Title</th>
                <th>Component</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liCIAMalpractice != null)
            {
                foreach (var item in Model.liCIAMalpractice)
                {
                    <tr id="@item.STUDENT_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.COURSE_TITLE</td>
                        <td>@item.COMPONENT</td>
                        <td>
                            <a href="#malpratice-dialog" data-toggle="modal" onclick="FetchMalpracticeById(@item.CIA_MALPRACTICE_ID);"><i class="fa fa-edit" title="Click To Update"></i></a>
                            <a href="#" onclick="GetConfirm(@item.CIA_MALPRACTICE_ID);"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>

