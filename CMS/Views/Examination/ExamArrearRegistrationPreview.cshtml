@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;

@{
    Layout = null;
}


<br />
<div class="form-horizontal ">
   
    <br />
    <div class="row">
        <div class="text-center">
            <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:150px; height:150px" />
        </div>
        <div class="text-center">
            <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME </h3>
            <h4>@Model.liCollegeDetails.FirstOrDefault().PLACE .</h4>
            <h5>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h5>
            <h5>
                @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                
            </h5>
        </div>
    </div>
</div>

<br />

<div class="row ">
    <div class="form-horizontal">
        <br /> <br />
@if (Model.liExamRegistrationModel != null && Model.liExamRegistrationModel.Count > 0)
{
        <div class="col-md-12">
            <div class="form-group col-xs-4">
                <label> Name : @Model.liExamRegistrationModel.FirstOrDefault().NAME</label>
            </div>
            <div class="form-group col-xs-4">
                <label> Roll No : @Model.liExamRegistrationModel.FirstOrDefault().ROLL_NO</label>
            </div>
            <div class="form-group col-xs-4">
                <label> Date : @DateTime.Now.ToString()</label>
            </div>

        </div>
        <div class="col-md-12">
            <div class="form-group col-xs-4">
                <label> Major : @Model.liExamRegistrationModel.FirstOrDefault().DEPARTMENT</label>
            </div>
            <div class="form-group col-xs-4">
                <label> Register No : @Model.liExamRegistrationModel.FirstOrDefault().REGISTER_NO</label>
            </div>
            <div class="form-group col-xs-4">
                <label> Date of Birth : @Model.liExamRegistrationModel.FirstOrDefault().DATE_OF_BIRTH</label>
            </div>


        </div>
}

        @{
            @*if (Model.feeTransactions != null && Model.feeTransactions.Count > 0)
            {
                <div class="col-md-12">
                    <div class="form-group col-xs-4">
                        <label> Total Amount : <i class="fa fa-inr"> </i> @Model.feeTransactions.FirstOrDefault().BALANCE</label>
                    </div>
                    <div class="form-group col-xs-4">
                        <label>
                            @{ string status = string.Empty;
                                if (Model.feeTransactions.FirstOrDefault().BALANCE.Equals("0"))
                                {
                                    status = "Paid";
                                }
                                else
                                {
                                    status = "Not Paid";
                                }} Status :   @status
                            </label>
                        </div>
                      
                    </div>
                               }*@
        }

       
    </div>
</div>
<input type="hidden" name="name" id="hdFrequencyId" value="@Model.feeTransactions.FirstOrDefault().FREQUENCY_ID" />
<br /> <br />
<div class="table-responsive">
    @{int No = 0;}
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Semester</th>
                <th>Course Code</th>
                <th>Title of the Paper</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liFetchHallTicket != null)
            {
                foreach (var item in Model.liFetchHallTicket)
                {
                    <tr>
                        <td>
                            @{No++; } @No
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SEMESTER)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.COURSE_CODE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.STATUS)
                        </td>
                    </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>No Data Found ...!</td>
                                    </tr>
                                }
        </tbody>
    </table>
    <br />
</div>

<div class="form-horizontal" id="Footer">
    <label><b>Date: </b>&nbsp;&nbsp; @Model.liExamRegistrationModel.FirstOrDefault().DATE</label>
    <div class="form-group pull-right">
        <label class="col-md-12 pull-right">
            R - Regular &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;  A - Arrears  &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp; AAA - Absent
        </label>
    </div>
    <br /><br /><br />
    <lable><b>Signature of the Class Teacher</b></lable>
    <div class="form-group pull-right">
        <label class="col-md-12 pull-right"><b>Signature of the Candidate</b></label>
    </div>
    <hr />
    <label>
        <b>Note : </b> &nbsp;&nbsp;&nbsp;
        1. Verify your name as found in your records (HigherSec.) <br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; 2. Verify the paper and subject code.<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; 3. The fees once paid will NOT be refunded.<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; 4. Is there any issue contact your class teacher.<br />
    </label>
   

</div>
