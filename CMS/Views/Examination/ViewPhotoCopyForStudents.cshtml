
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.ViewModel.Model;
@using CMS.Utility
@{
    ViewBag.Title = "ViewPhotoCopyForStudents";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<style>
    .fileinput-button input {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        opacity: 0;
        -ms-filter: 'alpha(opacity=0)';
        font-size: 200px !important;
        direction: ltr;
        cursor: pointer;
    }

    button, input, optgroup, select, textarea {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
    }

    .btn {
        font-weight: 600;
        line-height: 20px;
        padding: 6px 12px;
        transition: all .1s ease-in-out;
        box-shadow: none !important;
    }

        .btn:not(:disabled):not(.disabled) {
            cursor: pointer;
        }

    .fileinput-button {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .btn, .input-group-addon:focus {
        outline: 0 !important;
    }
</style>
<style>
    .table-of-contents {
        float: left;
        /*width: 250px;*/
        border: 1px solid #eee;
        /*margin: 0 0 15px 15px;*/
        /*z-index: 1;*/
        /*position: relative;*/
        color: #555d66;
        background-color: #fff;
        box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
        border-radius: 3px;
    }
</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ViewPhotoCopyForStudents</li>
    </ol>
    <h1 class="page-header">View PhotoCopy </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">View PhotoCopy</h4>
        </div>
        <div class="panel-body">
            @*<div class="form-group col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#ERRegistration-dialog" data-toggle="modal" id="btnAdd"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>*@

            <div class="col-lg-12 table-responsive">
                <table class="table table-hover table-bordered" id='tblCourse'>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Paper</th>
                            <th width="50%">PREVIEW</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liExamPhotoCopyFields != null && Model.liExamPhotoCopyFields.Count > 0)
                    {
                        //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                        //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                        var count = 0;
                        foreach (var item in Model.liExamPhotoCopyFields)
                        {
                            count = count + 1;
                    <tr>
                        <td>@count</td>

                        <td>@item.COURSE_TITLE</td>
                        @if (item.PHOTOCOPY != null && item.PHOTOCOPY != "")
                                {
                                <td>
                                    @*<span class="preview" id='files_@item.COURSE_ROOT_ID'>*@
                                    <div class='table-of-contents' style='padding:4px;'>
                                        <img src="@item.PHOTOCOPY" width="70" height="50" />
                                    </div>

                                    @*</span>*@
                                </td>



                                <td>
                                    <div class="document-name">
                                        <a href="@item.PHOTOCOPY" download="" title="hcclogo_4.jpg">Download</a>
                                    </div>
                                </td>
                                }
                                else
                                {
                                <td><span class="preview" id='files_@item.COURSE_ROOT_ID'>No file</span></td>
                                <td>No download</td>
                                }
                    </tr>
                        }

                    }
                    else
                    {
                    <tr><td> No Records Found..! </td> </tr>
                    }

                    </tbody>
                </table>
            </div>

            <div class="form-group col-lg-12 row">

                <div class="form-group pull-right">
                    @*<div class="col-md-5">
                        <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                    </div>*@

                    <div class="col-md-5">
                        <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal" id="btnCancel">Cancel</a>
                    </div>
                </div>

            </div>
            </div>
    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

    //var tbl = $('#tblLiERSetting').DataTable();


        $('#btnCancel').click(function () {

            loadContent('/Examination/ListPhotoCopyRegistration');
        });
      
       
</script>











