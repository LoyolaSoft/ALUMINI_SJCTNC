@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ExamTimeTable";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
   // string sChecked = string.Empty;

}


  
    <!-- ================== BEGIN PAGE LEVEL CSS STYLE ================== -->
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
   @*<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />*@
    <!-- ================== END PAGE LEVEL CSS STYLE ================== -->


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;" onclick="loadContent('/Examination/ListExamTimeTable')">List Exam TimeTable</a></li>
        <li class="active">Exam TimeTable</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Exam TimeTable<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam TimeTable</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12">
                       <div class="form-group col-md-3">
                           @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                           <div class="col-md-9">
                               @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                           </div>
                       </div>

                        <div class="form-group col-md-3">
                            @Html.Label("Prog", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ProgrammeList, (Model.ProgrammeList != null) ? Model.ProgrammeList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>

                        <div class="form-group col-md-3">
                            @Html.Label("Year", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ClassYear, (Model.ClassYear != null) ? Model.ClassYear : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>

                        <div class="form-group col-md-3">
                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            </div>
                        </div>

                        @*<div class="col-md-1 form-group">
                            <a class="btn btn-primary" href="javascript:;" id="btnGet"> Get</a>
                        </div>*@

                    </div>

                    <div class="form-group col-md-12">
                        <div id="dvExamTimeTable"></div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary hidden pull-right" id="btnSubmit">Submit</button>
                        </div>
                        
                    </div>
                </div>
            }

        </div>

    </div>
</div>


    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>  
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        function ContentLoad()
        {
            // Document Ready Function .
            handleDatepicker();
            $('#tblExamTimeTable').DataTable({ "bPaginate": false });
            $("#tblExamTimeTable_filter").addClass("dataTables_filter pull-right");
        }

        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
        
        
        handleDatepicker = function ()
        {
            "use strict";
            $(".datepicker").datepicker({
                todayHighlight: true,
                autoclose: true,
                startDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            })
        }

        $('#AcademicYearList').on('change', function ()
        {
            LoadCourses();
        });

        $('#ProgrammeList').on('change', function ()
        {
            LoadCourses();
        });

        $('#ClassYear').on('change', function ()
        {
            LoadCourses();
        });
        $('#ExamSetting').on('change', function ()
        {
            LoadCourses();
        });
        function LoadCourses()
        {
            if ($('#AcademicYearList').val() && $('#ProgrammeList').val() && $('#ClassYear').val() && $('#ExamSetting').val())
            {
                $.ajax({
                    url: '@Url.Action("BindCourseForCIATimeTable", "Examination")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sAcYear: $('#AcademicYearList Option:selected').text(), sProgrammeGroupId: $('#ProgrammeList').val(), sClassYear: $('#ClassYear').val(), sExamSettingId: $('#ExamSetting').val() },
                    success: function (data) {
                        if (data.Message != null && data.Message != '')
                        {
                            swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                        } else {
                            $('#btnSubmit').removeClass('hidden');
                            $('#dvExamTimeTable').empty();
                            $('#dvExamTimeTable').append(data);
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            }
            //else {
            //    swal({ title: "Failed !", text: 'Please Select All Course To Continue', showConfirmButton: false, timer: 2000, type: 'info', animation: true });
            //}
        }
        


        $('#btnSubmit').on('click', function ()
        {
            var nJsonCount = 0;
            var sJsonData = null;
            sJsonData = '{"liTimeTable":[';
            $('#tblExamTimeTable tbody tr').each(function ()
            {
                if ($(this).find('select Option:selected').val() && $(this).find('.datepicker').val())
                {
                    sJsonData += '{"TIMETABLE_ID":"' + $(this).attr('cms-TimeTableId') + '","COURSE_ID":"' + $(this).attr('cms-CourseId') + '","COURSE_CODE":"' + $(this).attr('cms-CourseCode') + '","EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '","ACADEMIC_YEAR":"' + $('#AcademicYearList Option:selected').text() + '","EXAM_SESSION_ID":"' + $(this).find('select Option:selected').val() + '","EXAM_DATE":"' + $(this).find('.datepicker').val() + '"},';
                    nJsonCount++;
                }
                
            });
            if (nJsonCount != 0)
            {
                sJsonData = sJsonData.slice(0, -1);
                sJsonData = sJsonData + "]}";
            } else
            {
                swal({ title: "Failed !", text: 'No Changes Made !', showConfirmButton: false, timer: 2000, type: 'info', animation: true });
                return false;
            }
            

            $.ajax({
                url:'@Url.Action("SaveExamTimeTable", "Examination")',
                method:'POST',
                datatype: 'json',
                data: { sSaveExamTimeTable: sJsonData },
                success: function (data)
                {
                    if (data.ErrorCode == '200')
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        LoadCourses();
                    }
                    else
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        });
    </script>







