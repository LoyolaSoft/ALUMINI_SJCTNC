@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;  
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Evaluation Mark List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Evaluation Mark List</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Evaluation Mark List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12 form-group">
                            <div class="col-md-5 form-group">
                                @Html.Label("Ev.Date", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.EvaluationDate, (Model.EvaluationDate != null) ? Model.EvaluationDate : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.EvaluationDate, "", new { @class = "text-danger" })
                                </div>
                            </div>                          
                        </div>
                        <div class="col-md-12" id="BindEvaluationStudentEntry"></div>
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad() {
        //
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    $('#EvaluationDate').on('change', function ()
    {
        $('#BindEvaluationStudentEntry').empty();
        $.ajax({
            url: '/Examination/ListEvaluationForEvaluators',
            method: 'POST',
            datatype: 'json',
            data: { sEvaluationDate: $('#EvaluationDate Option:selected').text()},
            success: function (data) {
                $('#BindEvaluationStudentEntry').append(data);
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    function Successcall()
    {
        $('#BindEvaluationStudentEntry').empty();
        $.ajax({
            url: '/Examination/ListEvaluationForEvaluators',
            method: 'POST',
            datatype: 'json',
            data: { sEvaluationDate: $('#EvaluationDate Option:selected').text() },
            success: function (data) {
                $('#BindEvaluationStudentEntry').append(data);
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>
<script>

    function ChangeEvaluationStatus(EvaluationId, IsActive)
    {

      
        var sbtnColor = "btn-success";
        if (IsActive == "0")
        {
          
            sbtnColor = "btn-danger";
        }
            swal({
                title: "Are you sure?",
                text: "Your sure to change the status !",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: sbtnColor,
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
            function ()
            {
                $.ajax({
                    url: '@Url.Action("ActivateOrDeActivateEvaluationstatus", "Examination")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sEvaluationId: EvaluationId,  sIsActive: IsActive },
                    success: function (data)
                    {
                        if (data.ErrorCode == '200')
                        {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                            Successcall();
                        }
                        else {
                            swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                        }
                    }, error: function (error) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            });
        }

</script>
