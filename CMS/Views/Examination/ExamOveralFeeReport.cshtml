@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ExamOveralFeeReport";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ExamOveralFeeReport</li>
    </ol>
    <h1 class="page-header">Exam Overall Fee Report</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Exam Overall Fee Report</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ExamSetting, "Exam Setting", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dExamSetting" })
                            @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Shift, "Shift", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dShift" })
                            @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Programmode, "Programme Mode", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Programmode, (Model.Programmode != null) ? Model.Programmode : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dProgrammeMode" })
                            @Html.ValidationMessageFor(model => model.Programmode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Program, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Program, (Model.Program != null) ? Model.Program : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @multiple = "multiple", @data_actions_box = "true", @data_live_search = "true", @id = "dProgramme" })
                            @Html.ValidationMessageFor(model => model.Program, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.FrequencyList, "Frequency", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.FrequencyList, (Model.FrequencyList != null) ? Model.FrequencyList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dFrequency" })
                            @Html.ValidationMessageFor(model => model.FrequencyList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <a class="btn btn-primary" id="btnGet">Get</a>
                        
                            <button name="excel" id="excel" class="btn btn-success">Excel</button><br>
                           
                        
                    </div>
                </div>
            </div>
            <div class="form-group col-md-12" id="divBind">

            </div>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    ContentLoad = function () {
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }

    $('#dProgrammeMode').on("change", function () {
        $('#dProgramme').html('');
        $('#dProgramme').selectpicker('refresh');
        if ($('#dShift').val() && $('#dProgrammeMode').val()) {
            $.ajax({

                url: "/Academics/FetchProgrammeByProgrammeModeandShift",
                type: "post",
                data: { sShift: String($('#dShift').val()), sProgrammeMode: String($('#dProgrammeMode').val()) },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                    }
                    else {
                        $('#dProgramme').empty();
                      
                        $.each(data, function (id, info) {
                            $('#dProgramme').append($('<option>',
                            {
                                value: info.PROGRAMME_GROUP_ID,
                                text: info.PROGRAMME_NAME
                            }));

                        });
                        $('#dProgramme').selectpicker('refresh');
                    }
                },
                error: function (ex) {

                }
            });
        }
    });
    $('#btnGet').click( function () {

        if ($('#dExamSetting').val() && $('#dShift').val() && $('#dProgrammeMode').val() && $('#dProgramme').val() && $('#dFrequency').val())
        {
            $.ajax({
                url:"@Url.Action("BindOverllFeeReport", "Examination")",
                type: "post",
                data: { sExamSetting: $('#dExamSetting').val(), sProgramGroupId: String($('#dProgramme').val()), sFrequencyId: $('#dFrequency').val(), ProgramGroupId: $('#dProgramme').val() },
            success:function(data)
            {
                if(data.Message!=null && data.Message!='')
                {
                    alert(data.Message)
                }
                else {
                         
                    $('#divBind').html('');
                    $('#divBind').append(data);
                 
                }
            },
            error:function(ex)
            {

            }
        });
    }
    else {
            alert("Pleas Select All the fields")
    }
    });

    $('#excel').live('click', function () {
        var sFrequency = $('#dFrequency Option:selected').text();
        let file = new Blob([$('#divBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: sFrequency + "_Year.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });








 </script>