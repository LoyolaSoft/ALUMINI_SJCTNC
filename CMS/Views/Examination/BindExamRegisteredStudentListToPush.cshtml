@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ int count = 0;}
@if (Model.liExamRegisteredList != null)
            {
    <table class="table table-bordered table-hover" id="ExamRegisteredList">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    Student Name
                </th>
                <th>
                    Course Title
                </th>
                <th>
                    Status
                </th>
                <th>
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liExamRegisteredList)
                {
                <tr>
                    <td>
                        @{ count++;}
                        @count
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FIRST_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.STATUS)
                    </td>
                    <td>
                        <a href="@Url.Action("EditNMESettings","NME",new { id=@item.REGISTRATION_ID})"><i class="fa fa-edit text-primary" title="Update"></i></a>
                        <a onclick="GetConfirm(@item.REGISTRATION_ID)"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                    </td>
                </tr>
                            }
        </tbody>
    </table>
                            }