@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ListExamTTLeave";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}



<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List ExamTTLeave</li>
    </ol>
    <h1 class="page-header">List ExamTTLeave</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List ExamTTLeave</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#ExamTTLeave" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Click to Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblExamTTLeave">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Setting</th>
                            <th>LeaveDate</th>
                            <th>LeaveReason</th>                         
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.LiExamttLeaveSetting!= null && Model.LiExamttLeaveSetting.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.LiExamttLeaveSetting)
                            {
                                <tr>
                                    <td>@{count++;}@count</td>
                                    <td>@item.EXAM_NAME</td>
                                    <td>@item.LEAVE_DATE</td>
                                    <td>@item.LEAVE_REASON</td>                            
                                    <td>
                                        <a href="#ExamTTLeave" onclick="FetchItemDetails(@item.EXAM_LEAVE_ID)" data-toggle="modal" title="Click to Add/Edit" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.EXAM_LEAVE_ID)" class="text-danger" title="Click to Delete"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                            }

                                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="ExamTTLeave">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <input type="text" id="itemid" class="hidden">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Setting</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Leave Date</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamDate, (Model.ExamDate != null) ? Model.ExamDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>                           
                            <div class="form-group">
                                <label class="control-label col-md-3">Leave Reason</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control" id="txtLeaveReason" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('#tblExamTTLeave').DataTable();
    function FetchItemDetails(ID) {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchExamTTLeave", "Examination")",
                type: "post",
                data: { sExamttLeaveId: ID },
                success: function (data) {
                    if (data != null) {
                        $('#ExamSetting').val(data.EXAM_SETTING_ID);
                        $('#ExamDate').text(data.LEAVE_DATE);
                        $('#txtLeaveReason').val(data.LEAVE_REASON);
                        $('#itemid').val(data.EXAM_LEAVE_ID);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function () {
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
        JsonData = '{"EXAM_LEAVE_ID":"' + $('#itemid').val() + '","EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '","LEAVE_DATE":"' + $('#ExamDate option:selected').text() + '","LEAVE_REASON":"' + $('#txtLeaveReason').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateExamTTLeave", "Examination")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Examination/ListExamTTLeave');
            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteExamTTLeave", "Examination")",
        type: "post",
        data: { sExamttLeaveId: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Examination/ListExamTTLeave');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }
    });
});

    }


</script>
