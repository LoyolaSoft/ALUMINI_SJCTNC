
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int count = 0;
}
<div class="">
    <table class="table table-bordered">
        <thead>
            <tr>
                <td>#</td>
                <td>IP</td>
                <td>Device</td>
                <td>Browser</td>
              
                <td>Image</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.liexamstudentloginfo != null && Model.liexamstudentloginfo.Count > 0)
            {
                foreach (var item in Model.liexamstudentloginfo)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.PUBLIC_IP</td>
                        <td>@item.DEVICE</td>
                        <td>@item.BROWSER</td>
                     
                        @if (@item.IMAGE_PATH != "")
                        {
                            <td><a href="@item.IMAGE_PATH"><img src="@item.IMAGE_PATH" width="50" height="50"></a></td>
                        }
                        else
                        {
                            <td>No Image</td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">No Records Found...!</td>
                </tr>
            }
        </tbody>
    </table>
</div>

