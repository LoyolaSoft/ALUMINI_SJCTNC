@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ 
    Layout = null;
}
<table class="table table-bordered tblevalutor" id="tblevalutor" style="color:black">
    <thead>
        <tr><th>Name</th><th>Phone Number</th></tr>
    </thead>
    <tbody>
    @if(Model.LiStaffInfo!=null && Model.LiStaffInfo.Count>0)
    {
        foreach (var item in Model.LiStaffInfo)
        {
              <tr>
                  <td><input type="text" value="@item.FIRST_NAME" class="form-control name" disabled></td>
                  <td><input type="text" value="@item.PHONE" class="form-control phone" data-parsley-required="true" data-parsley-type="number" ></td>
              </tr>
        }
    }
    @*else
    {
        <tr><td>No Records Found...!</td></tr>
    }*@
    </tbody>
</table>