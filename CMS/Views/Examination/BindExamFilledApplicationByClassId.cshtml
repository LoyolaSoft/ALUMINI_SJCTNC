@if (Model.liExamRegistrationModel != null && Model.liExamRegistrationModel.Count > 0 && Model.liFetchHallTicket!=null && Model.liFetchHallTicket.Count>0)
{
    foreach (var item in Model.liExamRegistrationModel)
    {
        string status = string.Empty;
        <div style="page-break-after: always!important; page-break-before: avoid!important;">

            <div class="form-horizontal ">
                <div class="row">
                    @*<div class="text-center">
                        <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
                    </div>*@
                    <div class="text-center" style="text-align:center;">
                        <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME , CUDDALORE - 1</h4>
                        @*<h4>@Model.liCollegeDetails.FirstOrDefault().PLACE .</h4>
                        <h5>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h5>*@
                        <h5>
                            @*@Model.liCollegeDetails.FirstOrDefault().GRADE <br />*@
                           <b>@Model.liFetchHallTicket.FirstOrDefault().SEMESTER_ID</b> &nbsp; SEMESTER  &nbsp;EXAM APPLICATION FORM  &nbsp; - &nbsp; @Model.liFetchHallTicket.FirstOrDefault().MONTH_YEAR
                        </h5>
                    </div>
                </div>
            </div>

            <div class="row ">
                <div class="form-horizontal">
                    <br /> <br />
                    <div class="col-md-12">
                        <div class="form-group col-xs-4">
                            <label> Name : @item.NAME</label>
                        </div>
                        <div class="form-group col-xs-4" style="text-align:center;">
                            <label>  &nbsp; &nbsp; &nbsp;  Roll No : @item.ROLL_NO</label>
                        </div>
                        <div class="form-group col-xs-4" style="text-align:right;">
                            <label> Register No : @item.REGISTER_NO</label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-xs-4">
                            <label> Name In Tamil : @item.NAME_IN_NATIVE</label>
                        </div>
                        <div class="form-group col-xs-4" style="text-align:center;">
                            <label>  &nbsp; &nbsp; &nbsp; Major : @item.DEPARTMENT</label>
                        </div>
                        <div class="form-group col-xs-4" style="text-align:right;">
                            <label> Date of Birth : @item.DATE_OF_BIRTH</label>
                        </div>
                    </div>

                    @*@{
                    if (Model.feeTransactions != null && Model.feeTransactions.Count > 0)
                    {
                        var liFeeTransaction = Model.feeTransactions.Where(x => x.STUDENT_ID == item.STUDENT_ID).ToList();
                        if (liFeeTransaction != null && liFeeTransaction.Count > 0)
                        {
                <div class="col-md-12">
                    <div class="form-group col-xs-4">
                        <label> Total Amount : <i class="fa fa-inr"> </i> @liFeeTransaction.FirstOrDefault().BALANCE</label>
                    </div>
                    <div class="form-group col-xs-4">
                        <label>
                            @{
                                            if (liFeeTransaction.FirstOrDefault().BALANCE.Equals("0"))
                                            {
                                                status = "Paid";
                                            }
                                            else
                                            {
                                                status = "Not Paid";
                                            }} Status :   @status
                                        </label>
                                    </div>
                                </div>
                            }
                        }
                    }*@
                </div>
            </div>          

            <div class="table-responsive">
                @{int No = 0;}
                <table width="1000" class="table table-hover table-bordered" border="1" cellpadding="2" cellspacing="2">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Semester</th>
                            <th>Course Code</th>
                            <th>Title of the Paper</th>
                            @*<th>Amount</th>*@
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                      @if (Model.liFetchHallTicket != null && Model.liFetchHallTicket.Count > 0)
                      {
                          var liCourses = Model.liFetchHallTicket.Where(x => x.STUDENT_ID == item.STUDENT_ID).ToList();
                          if (liCourses != null && liCourses.Count > 0)
                          {
                              var liRegulerCourse = liCourses.Where(x => x.STATUS == "R").ToList();
                              foreach (var Courseitem in liRegulerCourse)
                              {
                                  //var liCourseAmount = Model.liExamRegistrationList.Where(x => x.COURSE_ID == Courseitem.COURSE_ID).ToList();
                                    <tr>
                                        <td>@{No++; } @No</td>
                                        <td>@Courseitem.SEMESTER</td>
                                        <td>@Courseitem.COURSE_CODE</td>
                                        <td>@Courseitem.COURSE_TITLE </td>
                                        @*<td>
                                            @if (liCourseAmount != null && liCourseAmount.Count > 0)
                                            {
                                              <i class="fa fa-inr"></i>  @liCourseAmount.FirstOrDefault().COST
                                            }
                                        </td>*@
                                        <td>@Courseitem.STATUS</td>
                                    </tr>
                                 }
                                 var liArrearCourse = liCourses.Where(x => x.STATUS == "A").OrderBy(x => x.SEMESTER_ID).ToList();
                                 if (liArrearCourse!=null && liArrearCourse.Count>0)
                                 {
                                     foreach (var Courseitem in liArrearCourse)
                                     {
                                         //var liCourseAmount = Model.liExamRegistrationList.Where(x => x.COURSE_ID == Courseitem.COURSE_ID).ToList();
                                        <tr>
                                            <td>@{No++; } @No</td>
                                            <td>@Courseitem.SEMESTER</td>
                                            <td>@Courseitem.COURSE_CODE</td>
                                            <td>@Courseitem.COURSE_TITLE</td>
                                            @*<td>
                                                @if (liCourseAmount != null && liCourseAmount.Count > 0)
                                                {
                                                    <i class="fa fa-inr"></i>  @liCourseAmount.FirstOrDefault().COST
                                                }
                                            </td>*@
                                            <td>@Courseitem.STATUS</td>
                                        </tr>
                                     }
                                 }
                             }
                         }
                    </tbody>
                </table>
                <br />
            </div>

            @if (Model.feeTransactions != null && Model.feeTransactions.Count > 0)
            {
                int nCount = 0;
                var liFeeDetails = Model.feeTransactions.Where(x => x.STUDENT_ID == item.STUDENT_ID).ToList();
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" width="1000" border="1" cellpadding="3" cellspacing="3">
                        <thead>
                            <tr>
                                <td>#</td>
                                <td>Particulars</td>
                                <td>Amount</td>
                            </tr>
                        </thead>
                        <tbody>
                            @if (liFeeDetails!=null && liFeeDetails.Count>0)
                            {
                                foreach (var Feeitem in liFeeDetails)
                                {
                                    <tr>
                                        <td>@{nCount++;} @nCount</td>
                                        <td>@Feeitem.HEAD</td>
                                        <td><i class="fa fa-inr"></i> @Feeitem.CREDIT</td>
                                    </tr>
                                }
                                <tr>
                                    <td></td>
                                    <td class="pull-right"> Total : </td>
                                    <td><i class="fa fa-inr"></i> @liFeeDetails.Sum(x => Convert.ToDouble(x.CREDIT))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="form-horizontal" id="Footer">

                <label><b>Date: </b>&nbsp;&nbsp; @System.DateTime.Today.ToShortDateString()</label>
                <label>&nbsp;&nbsp;&nbsp; Amount : <b>@Model.liFetchHallTicket.FirstOrDefault().AMOUNT</b></label>

                <div class="form-group pull-right" style="text-align:right;">
                    <label class="col-md-12 pull-right" style="text-align:right;">
                        R - Regular &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;  A - Arrears  &nbsp;&nbsp;&nbsp; @*Mobile No : @item.MOBILE_NO*@
                    </label>
                </div>
                <br /><br /><br />
                <lable><b>Signature of the Class Teacher</b></lable>
                <div class="form-group pull-right"  style="text-align:right;">
                    <label class="col-md-12 pull-right" style="text-align:right;"><b>Signature of the Candidate</b></label>
                </div>
                <hr />
                @*<label>
                    <b>Note : </b> &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;
                    1. Verify your name as found in your records (Higher Sec.) <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; 2. Verify the paper and subject code.<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; 3. The fees once paid will NOT be refunded.<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; 4. If there is any issue contact your class teacher.<br />
                </label>*@
                @*@if (status.ToLower() != "paid" )
                    {
                        <a href="#" class="btn btn-success" id="btnFeeSummary" onclick="loadFeeSummary()"><i class="ion-ios-list-outline"></i>Fee Details</a>
                        <a href="@Url.Action("PayExamFee","Fee")" class="btn btn-success " id="btnPay" title="Online Payment"><i class="ion-card"></i> Online Payment</a>
                    }*@
            </div>
        </div>
    }
}
