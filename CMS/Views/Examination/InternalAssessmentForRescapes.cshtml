@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "InternalAssessmentForRescapes";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}



<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />



<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Internal Assessment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Rescapes Mark Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Rescapes Mark Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-4" data-step="1" data-intro="Choose Year">
                            @Html.Label("Ac Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4" data-step="2" data-intro="Choose Class">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                 @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null)? Model.ClassList:Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                 @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4" data-step="3" data-intro="Choose Course">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                    </div>
                </div>


                <div id="dvCIAbind"></div>
            }
            <div class="col-lg-12">
                <a href="javascript:;" class="btn-success btn hidden" id="btnSubmit">Submit</a>
            </div>
        </div>

    </div>
</div>
<!-- end #content -->
@*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>*@
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
            $(document).on("wheel", "input[type=number]", function (e) {
                $(this).blur();
            });
        }
        //$(document).ready(function ()
        //{

        //});
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');
</script>

<script>
    $('#AcademicYearList').on('change', function myfunction()
    {
        $.ajax({
            url: "@Url.Action("FetchClassByAcYear", "Examination")",
            async: false,
            data: { sAcYear: $('#AcademicYearList option:Selected').text() },
            success: function (data)
            {
                if (data.Message!=null && data.Message!='')
                {
                    alert(data.Message);
                } else
                {
                    $('#ClassList').empty();
                    $('#ClassList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            },
            error: function (xhr, textStatus, error)
            {
                alert(error + "\n");
            }

        });
    });


        var flag = true;
        $('#ClassList').on('change', function ()
        {
            var inp = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("FetchAllCourseByClassId", "Examination")",
                async: false,
                data: { sClassId: inp },
                success: function (data)
                {
                    if (data.Message!=null && data.Message!='')
                    {
                        alert(data.Message);
                    } else
                    {
                        var select = $('#CourseList');
                        select.empty();
                        select.append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }

            });
        });

    var FetchCIAMarks = function ()
    {
        $('#btnSubmit').removeClass('hidden');
            var inp1 = $('#ClassList').val();
            var inp2 = $('#CourseList').val();
            $.ajax({
                url: "@Url.Action("BindStudentForRescapesMarkEntry", "Examination")",
                async: false,
                data: { sClassId: inp1, sCourseId: inp2, sAcademicYear: $('#AcademicYearList option:Selected').text() },
                success: function (option) {
                    var divHtml = $('#dvCIAbind');
                    divHtml.empty();
                    divHtml.html(option);
                    $("#ciaMarkList").DataTable({ "bPaginate": false });
                    $("#ciaMarkList_filter").addClass("dataTables_filter pull-right");
                    $(".pagination").addClass("pagination pull-right");

                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                    //console.log(xhr.statusText);
                    // console.log(textStatus);
                    //  console.log(error);
                }
            });
        }

        $('#CourseList').on('change', function ()
        {
            if ($(this).val() != 0) {
                FetchCIAMarks();
            } else {

                var divHtml = $('#dvCIAbind');
                divHtml.empty();
            }
            $('.selectpicker').selectpicker('refresh');
        });


        function Validate() {
            var validate = 0;
            $('#ciaMarkList  tbody tr td').each(function () {
                if ($(this).find('input[type="text"]').attr("cms-studentid")) {

                    if (parseInt($(this).find('input[type="text"]').val()) > parseInt($(this).find('input[type="text"]').attr("max"))) {
                        $(this).find('input[type="text"]').css('color', 'red');
                        validate = 1;
                    } else {
                        $(this).find('input[type="text"]').css('color', 'black');
                    }
                }
            });
            return validate;
        }




        //----------------------------------------------------------------------------
        $('#btnSubmit').on('click', function () {
            var count=0;
            if (parseInt($('#CourseList').val()) != 0) {
                if (Validate()) {
                    alert('Mark should be less than or equal to Maximum mark...');
                    return false;
                }
                var Search = $('input[type="search"]').val();
                if (Search != '') {
                    alert('Please Clear the Search Box !...');
                    return false;
                }
                
                var sClassId = $('#hdClassId').val();
                var sCourseId = $('#hdCourseId').val();
                var sSemesterId = $('#sSemester').text();
                var sStudentId;
                var sCourseRootId;
                var sMarkId;
                var sJson;
                if (sJson == null) {
                    sJson = '{"SAVE_CIA_MARKS":[';
                    $('#ciaMarkList tbody tr').each(function ()
                    {
                        sStudentId = $(this).attr("cms-rstudentid");
                        sCourseRootId = sCourseId;
                        // sMarkId = $(this).attr("cms-markid");
                        // sClassId = $(this).attr("cms-rclassid");
                        $(this).find('td').each(function ()
                        {
                            if ($(this).find('input[type="text"]').attr("cms-studentid"))
                            {
                                if ($(this).find('input[type="text"]').val() != $(this).find('input[type="text"]').attr("cms-cmark"))
                                {
                                    //alert("Entered Mark : " + $(this).find('input[type="text"]').val() + " " + $(this).find('input[type="text"]').attr("cms-cmark"));
                                    sJson += '{"CLASS_ID":"' + sClassId + '","COURSE_ROOT_ID":"' + sCourseRootId + '","SEMESTER_ID":"' + sSemesterId + '","STUDENT_ID":"' + sStudentId + '","COURSE_ID":"' + sCourseId + '",';
                                    sJson += '"CIA_GROUP_MARK_ID":"' + $(this).find('input[type="text"]').attr("cms-ciagroupmarkid") + '","COURSE_GROUP_ID":"' + $(this).find('input[type="text"]').attr("cms-coursegroupid") + '","COURSE_GROUP_MARK":"' + $(this).find('input[type="text"]').val() + '"},';
                                    count++;
                                }
                            }
                        });
                    });
                    if (count > 0)
                    {
                        sJson = sJson.slice(0, -1);
                        sJson += ']}';
                    } else {
                        alert('No Changes Made !');
                        return false;
                    }
                    // alert(sJson);
                }
                addLoadingPanel();
                $.ajax({
                    url: "@Url.Action("SaveRescapesCIAEntry", "Examination")",
                    async: false,
                    method: "POST",
                    content: "application/json; charset=utf-8",
                    data: { jsonCIA_MARKS: sJson, sCourseId: sCourseId, sClassId: sClassId, sAcademicYear: $('#AcademicYearList option:Selected').text() },
                    success: function (sResult)
                    {
                        alert(sResult);
                        //var divHtml = $('#dvCIAbind');
                        //divHtml.empty();
                        FetchCIAMarks();
                        removeload();
                    }, error: function (e)
                    {
                        removeload();
                        alert(e);
                    }
                });
            } else
            {
                alert('Please select course...!');
            }
        });



</script>



