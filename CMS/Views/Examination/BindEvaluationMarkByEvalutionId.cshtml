@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
}
<div class="col-md-12 table-responsive">
    <table class="table table-bordered" id="tblMarks">
        <thead>
            <tr>
                <th>#</th>
                <th>Section</th>
                <th>Quesion</th>
                <th>Secured Mark</th>
                <th>Total</th>
                
            </tr>
        </thead>
        <tbody>
            @if (Model.LiExamEvaluationMark != null && Model.LiExamEvaluationMark.Count > 0)
            {
                int nCount = 0;
                foreach (var item in Model.LiExamEvaluationMark)
                {
                    <tr cms-exam-mark-id="@item.EXAM_EVALUATION_MARK_ID" >
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.SECTION_NAME</td>
                        <td>@(new HtmlString(Model.GetStrigFromBase64String(@item.QUESTION)))</td>
                        <td><input type="number" name="" min="0" value="@item.SECURED_MARK" /></td>
                        <td> @item.TOTAL_MARK</td>
                        

                    </tr>
                }
            }

        </tbody>
    </table>
</div>