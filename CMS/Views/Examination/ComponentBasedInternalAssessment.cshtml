@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
    string sIcon = string.Empty;
    string sClass = string.Empty;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Internal Assessment</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">CIA Entry<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">CIA Entry</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-4" data-step="1" data-intro="Choose Class">
                            @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">
                                <select class="form-control  selectpicker" id="ClassList" data-live-search="true">
                                    <option value=""> -- Select -- </option>
                                    @if (Model.liClassList != null && Model.liClassList.Count > 0)
                                    {
                                        foreach (var item in Model.liClassList)
                                        {
                                            sIcon = string.Empty;
                                            sClass = string.Empty;
                                            <option value="@item.CLASS_ID" @item.CIA_DISABLE @if (!string.IsNullOrEmpty(item.CIA_DISABLE)) { sIcon = "fa fa-ban"; sClass = "text-danger"; } data-icon="@sIcon" class="@sClass">
                                                @item.CLASS_NAME
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4" data-step="2" data-intro="Choose Course">
                            @Html.Label("Course", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4" data-step="2" data-intro="Choose Component">
                            @Html.Label("Component", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ComponentList, (Model.ComponentList != null) ? Model.ComponentList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ComponentList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                    </div>
                </div>


                <div id="dvCIAbind"></div>
            }
            <div class="col-lg-12">
                <a href="#" class="btn-success btn" id="btnSubmit">Submit</a>
            </div>
        </div>

    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
    $('#CourseList').on('change', function ()
    {
        if ($('#CourseList').val())
        {
            $.ajax({
                url: '/Examination/BindComponentByCourseId',
                method:'POST',
                datatype:'json',
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                success: function (data)
                {
                    if (data.sResult != null && data.sResult != '')
                    {
                        $('#ComponentList').empty().append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error)
                {
                    swal({ title: "Error !", text: 'Internal Server Error !...', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                }
            });
        }
    });
</script>


<script>
    $('#ClassList').on('change', function () {
            var inp = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("GetCourseListByClassIdAndStaffId", "Examination")",
                async: false,
                data: { sClassId: inp },
                success: function (option)
                {
                    if (option == '204')
                    {
                        alert('Session Is Expired Please Login Again !!!');
                    } else
                    {
                        var select = $('#CourseList');
                        select.empty();
                        select.append('<option value="" >---Select---</option>' + option);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (xhr, textStatus, error)
                {
                    swal({ title: "Error !", text: 'Internal Server Error !...', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                }

            });
    });

    $('#ComponentList').on('change', function ()
    {
        FetchCIAMarks();
    });

    function FetchCIAMarks()
    {
        $('#dvCIAbind').empty();
        if ($('#ComponentList').val() != "0")
        {
            $.ajax({
                url: '/Examination/BindStudentComponentBasedEntry',
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sComponentId: $('#ComponentList').val() },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#dvCIAbind').append(data);
                        $(".table").DataTable({ "bPaginate": false });
                        $("#ciaMarkList_filter").addClass("dataTables_filter pull-right");
                        $(".pagination").addClass("pagination pull-right");
                    }
                }, error: function (error)
                {
                    swal({ title: "Error !", text: 'Internal Server Error !...', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                }
            });
        }
    }
</script>


<script>
    function Validate()
    {
        var validate = 0;
        $('#ciaMarkList  tbody tr td').each(function ()
        {
            if ($(this).find('input[type="text"]').attr("cms-studentid"))
            {
                if (parseInt($(this).find('input[type="text"]').val()) > parseInt($(this).find('input[type="text"]').attr("max")))
                {
                    $(this).find('input[type="text"]').css('color', 'red');
                    validate = 1;
                } else
                {
                    $(this).find('input[type="text"]').css('color', 'black');
                }
            }
        });
        return validate;
    }



    //----------------------------------------------------------------------------
    $('#btnSubmit').on('click', function ()
    {
        var count=0;
        if (parseInt($('#CourseList').val()) != 0)
        {
            // Validation Check ,...
            var isValid = true;
            if ($('#dvValidate').parsley().validate() !== true) isValid = false;
            if (!isValid)
            {
                //gritter-info,danger,success,warning,default
                swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
                return false;
            }
            if (Validate())
            {
                swal({ title: "Warning !", text: 'Mark should be less than or equal to Maximum mark...', showConfirmButton: false, timer: 2500, type: 'warning', animation: true });
                return false;
            }
            var Search = $('input[type="search"]').val();
            if (Search != '')
            {
                swal({ title: "Warning !", text: 'Please Clear the Search Box !...', showConfirmButton: false, timer: 2500, type: 'warning', animation: true });
                return false;
            }
            addLoadingPanel();
            var sClassId = $('#hdClassId').val();
            var sCourseId = $('#hdCourseId').val();
            var sSemesterId = $('#sSemester').text();
            var sStudentId;
            var sCourseRootId;
            var sMarkId;
            var sJson;
            if (sJson == null)
            {
                sJson = '{"SAVE_CIA_MARKS":[';
                $('#ciaMarkList tbody tr').each(function ()
                {
                    sStudentId = $(this).attr("cms-rstudentid");
                    sCourseRootId = sCourseId;
                    $(this).find('td').each(function ()
                    {
                        if ($(this).find('input[type="text"]').attr("cms-studentid"))
                        {
                            if ($(this).find('input[type="text"]').val() != $(this).find('input[type="text"]').attr("cms-cmark"))
                            {
                                sJson += '{"CLASS_ID":"' + sClassId + '",\
                                           "COURSE_ROOT_ID":"' + sCourseRootId + '",\
                                           "SEMESTER_ID":"' + sSemesterId + '",\
                                           "STUDENT_ID":"' + sStudentId + '",\
                                           "COURSE_ID":"' + sCourseId + '",\
                                           "CIA_GROUP_MARK_ID":"' + $(this).find('input[type="text"]').attr("cms-ciagroupmarkid") + '",\
                                           "COURSE_GROUP_ID":"' + $(this).find('input[type="text"]').attr("cms-coursegroupid") + '",\
                                           "COURSE_GROUP_MARK":"' + $(this).find('input[type="text"]').val() + '"},';
                                count++;
                            }
                        }
                    });
                }); if (count > 0)
                {
                    sJson = sJson.slice(0, -1);
                }
                sJson += ']}';
            }

            $.ajax({
                url: "@Url.Action("SaveCIAMarks", "Examination")",
                async: false,
                method: "POST",
                content: "application/json; charset=utf-8",
                data: { jsonCIA_MARKS: sJson, sCourseId: sCourseId, sClassId: sClassId },
                success: function (sResult)
                {
                    alert(sResult);
                    FetchCIAMarks();
                    removeload();
                }, error: function (e)
                {
                    removeload();
                    //alert(e);
                    swal({ title: "Error !", text: 'Internal Server Error !...', showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                }
            });
        } else
        {
            swal({ title: "Warning !", text: 'Please select course...!', showConfirmButton: false, timer: 2500, type: 'warning', animation: true });
        }
    });
</script>