        function rotate(divid) {
            degrees += 90;
            //$('.img').addClass('rotated'); // for one time rotation

            $('#' + divid).find('img').css({
                'transform': 'rotate(' + degrees + 'deg) scaley(-1)',
                '-ms-transform': 'rotate(' + degrees + 'deg) scaley(-1)',
                '-moz-transform': 'rotate(' + degrees + 'deg) scaley(-1)',
                '-webkit-transform': 'rotate(' + degrees + 'deg) scaley(-1)',
                '-o-transform': 'rotate(' + degrees + 'deg) scaley(-1)'
            });
        }

        //});
        var currentZoom = 1.0;
        function zoomin() {
            currentZoom = currentZoom + 0.03;
            var scaleString = "scale(" + currentZoom + ")";
            $('.item').css("transform", scaleString);

        }
        function zoomout() {
            currentZoom = currentZoom - 0.03;
            var scaleString = "scale(" + currentZoom + ")";
            $('.item').css("transform", scaleString);

        }

