@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{
    Layout = null;
    int qcount = 0;
    int licount = 0;
    int imgcount = 0;
}
<div class="col-md-12">

    @if (Model.Liexamquesions != null && Model.Liexamquesions.Count > 0)
    {
        <input type="hidden" id="">
        var predefinedmarksquestiontype = Model.Liexamquesions.Where(o => o.QUESTION_TYPE == Common.Question_Type.ObjectiveType || o.QUESTION_TYPE == Common.Question_Type.FillInTheBlank || o.QUESTION_TYPE == Common.Question_Type.MatchTheFollowing).ToList();
        var evaluatormarkseitherquestiontype = Model.Liexamquesions.Where(o => o.QUESTION_TYPE == Common.Question_Type.EitherQuestions).ToList();
        var evaluatormarkschoicequestiontype = Model.Liexamquesions.Where(o => o.QUESTION_TYPE == Common.Question_Type.ChooseBasedQuestions).ToList();
        if (predefinedmarksquestiontype != null && predefinedmarksquestiontype.Count > 0)
        {
            var evaluatoedcount = predefinedmarksquestiontype.Where(o => o.SECURED_MARK != null && o.SECURED_MARK != "");

            double secmark = 0;
            <div id="predefindmarksdiv" class="table-responsive">
                <input type="hidden" id="actualeval" class="actualeval" value="@(evaluatoedcount != null ? evaluatoedcount.Count().ToString() : "0")">
                <input type="hidden" id="totaleval" class="totaleval" value="@predefinedmarksquestiontype.FirstOrDefault().TO_BE_ATTEND">
                <br><br>
                <table class="table table-bordered table-responsive" id="tblpredefined">
                    <thead>
                        <tr>
                            <th>Questions</th>
                            <th>Answer</th>
                            <th>Status</th>
                            <th>Mark</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in predefinedmarksquestiontype)
                        {

                            if (item.QUESTION_TYPE.ToString() == Common.Question_Type.ObjectiveType || item.QUESTION_TYPE.ToString() == Common.Question_Type.FillInTheBlank)
                            {
                                if (item.STATUS == Common.IsActiveFalg.IsActive)
                                {
                                    secmark += Convert.ToDouble((string.IsNullOrEmpty(item.MARK_FOR_EACH_QUESTION)) ? "0" : item.MARK_FOR_EACH_QUESTION);
                                }
                                <tr questiontype="@item.QUESTION_TYPE" questioinid="@item.QUIZ_ID" status="@item.STATUS" examsettingid="@item.EXAM_SETTING_ID" totalmark="@item.MARK_FOR_EACH_QUESTION">
                                    <td>@(new HtmlString(Model.GetStrigFromBase64String(item.QUESTION)))</td>
                                    @if (item.OPTION != null && item.OPTION != "")
                                    {
                                        if (item.STATUS == Common.IsActiveFalg.IsActive)
                                        {
                                            <td>
                                                @(new HtmlString(Model.GetStrigFromBase64String(item.OPTION)))
                                            </td>
                                            <td>
                                                <label class="text-success"><i class="fa fa-check-circle" style="font-size:16px"></i></label>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control sec_mark" min="0" value="1" style="width:100px" required />
                                            </td>

                                        }
                                        else
                                        {
                                            <td>
                                                @(new HtmlString(Model.GetStrigFromBase64String(item.OPTION)))
                                            </td>
                                            <td>
                                                <label class="text-danger"><i class="fa fa-close" style="font-size:16px"></i></label>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control sec_mark" value="0" min="0" style="width:100px" required />
                                            </td>
                                        }
                                    }
                                    else
                                    {
                                        <td>
                                            -
                                        </td>
                                        <td>
                                            -
                                        </td>
                                        <td>
                                            <input type="number" class="form-control sec_mark" value="0" min="0" style="width:100px" required />
                                        </td>
                                    }
                                </tr>
                            }
                        }

                        @*<tr class="markrow">
                                <td colspan="2">
                                    Total Secured
                                </td>
                                <td>
                                    @secmark/@predefinedmarksquestiontype.FirstOrDefault().TOTAL_MARK_FOR_EACH_SECTION
                                </td>
                            </tr>*@
                    </tbody>
                </table>
                <br><br>



                <div class="col-md-12">
                    <button class="btn btn-primary pull-right" id="btnsave">Submit</button>
                </div>
            </div>
