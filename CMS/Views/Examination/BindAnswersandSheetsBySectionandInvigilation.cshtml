                                                                    <li class="" id="keyanswer"><a href="#nav_@qcount-@qcount" data-toggle="tab">Key Answers</a></li>

                                                                </ul>
                                                            </div>
                                                            <div class="tab-content">
                                                                <div class="tab-pane fade in active " id="nav_@qcount">
                                                                    @if (answersheets != null && answersheets.Count > 0)
                                                                    {
                                                                            <div id = "answer_@qcount" class="carousel slide" data-ride="carousel">
                                                                            <!-- Indicators -->
