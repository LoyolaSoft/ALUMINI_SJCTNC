                            <button class="btn btn-primary btnsubmit" id="btnsubmit" onclick="SaveEvaluationMark(@Common.Question_Type.EitherQuestions,'questioncount_@qcount',@question.FirstOrDefault().MARK_FOR_EACH_QUESTION)">Submit</button>
