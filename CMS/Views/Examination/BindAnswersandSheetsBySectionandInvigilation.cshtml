    <input type="hidden" id="questioncount" value="1">
    <script>

        function SaveEvaluationMark(questiontypeid, divid, maxmark)
        {
            if ($('#' + divid).find('.btnsubmit').hasClass('disabled')) {
                swal({ title: "Error", text: "You have already enterd mark for this Question ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                return false;
            }
            if (parseFloat($('#' + divid).find('input[type=number]').val()) <= parseFloat(maxmark)) {
                if ($('#' + divid).find('input[type=number]').val() != null && $('#' + divid).find('input[type=number]').val() != '') {

                    var optionid = '';
                    var questionid = null;
                    var questiontype = null;
                    var totalmark = null;
                    var examsettingid = null;
                    var securedmark = null;

                    var invigilationid = $('#invigilationid').val();
                    var evaluationid = $('#evaluationid').val();
                    var evalutiontype = $('#evaluationtype').val();
                    var JsonData = '{"liEvaluationmark":[';
                    if (questiontypeid == "4") {
                        var total = $('#questiontype_@Common.Question_Type.EitherQuestions').find('.totaleval').val();
                        var actual = $('#questiontype_@Common.Question_Type.EitherQuestions').find('.actualeval').val();
                        if (parseFloat(actual) < parseFloat(total)) {
                            if ($('#' + divid).find('input[type=radio]:checked').attr('questionid') != '' && $('#' + divid).find('input[type=radio]:checked').attr('questionid') != null) {
                                questionid = $('#' + divid).find('input[type=radio]:checked').attr('questionid');
                                questiontype = $('#' + divid).find('input[type=radio]:checked').attr('questiontypeid');
                                totalmark = $('#' + divid).find('input[type=radio]:checked').attr('totalmark');
                                examsettingid = $('#' + divid).find('input[type=radio]:checked').attr('examsettingid');
                                securedmark = $('#' + divid).find('input[type=number]').val();
                            }
                            else {
                                swal({ title: "Error", text: "Please select the questions ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                                return false;
                            }
                        }
                        else {
                            swal({ title: "Error", text: "You have already enterd mark for maximum Question ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            return false;
                        }
                    }
                    else if (questiontypeid == "5") {

                        var total = $('#questiontype_@Common.Question_Type.ChooseBasedQuestions').find('.totaleval').val();
                        var actual = $('#questiontype_@Common.Question_Type.ChooseBasedQuestions').find('.actualeval').val();
                        if (parseFloat(actual) < parseFloat(total)) {

                            questionid = $('#' + divid).find('input[type=number]').attr('questionid');
                            questiontype = $('#' + divid).find('input[type=number]').attr('questiontypeid');
                            totalmark = $('#' + divid).find('input[type=number]').attr('totalmark');
                            examsettingid = $('#' + divid).find('input[type=number]').attr('examsettingid');
                            securedmark = $('#' + divid).find('input[type=number]').val();
                        }
                        else {
                            swal({ title: "Error", text: "You have already enterd mark for maximum Question ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            return false;
                        }
                    }

                    if ($('#' + divid).find('input[type=radio]:checked').attr('optionid') != null && $('#' + divid).find('input[type=radio]:checked').attr('optionid') != '') {
                        optionid = $('#' + divid).find('input[type=radio]:checked').attr('optionid');
                    }
                    JsonData += '{"QUESTION_ID":"' + questionid + '","QUESTION_TYPE":"' + questiontype + '","TOTAL_MARK":"' + totalmark + '", "SECURED_MARK":"' + securedmark + '","EXAM_SETTING_ID":"' + examsettingid + '","OPTION_ID":"' + optionid + '"},';
                    JsonData = JsonData.slice(0, -1);
                    JsonData += ']}';
                    $('#' + divid).find('.btnsubmit').addClass('disabled'); 44
                    $.ajax({
                        url: '@Url.Action("SaveEvaluationMarks", "Examination")',
                        method: 'POST',
                        datatype: 'json',
                        data: { sJsonData: JsonData, Evaluationtype: evalutiontype, sEvaluationId: evaluationid, sInvigilationId: invigilationid },
                        success: function (data) {
                            if (data.ErrorCode == "200")
                            {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                                //$('#' + divid).find('input[type=number]').attr('disabled', 'disabled');
                                if (questiontypeid == "4") {

                                    $('#questiontype_@Common.Question_Type.EitherQuestions').find('.actualeval').val(parseInt($('#questiontype_@Common.Question_Type.EitherQuestions').find('.actualeval').val()) + 1);

                                }
                                else if (questiontypeid == "5")
                                {
                                    $('#questiontype_@Common.Question_Type.ChooseBasedQuestions').find('.actualeval').val(parseInt($('#questiontype_@Common.Question_Type.ChooseBasedQuestions').find('.actualeval').val()) + 1);
                                }

                            }
                            else
                            {
                                swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                        },
                        error: function (error) {
                            swal({ title: "Error", text: "Internal Server Error!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    });
                }
                else {
                    swal({ title: "Error", text: "Please enter the mark ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }
            else {
                swal({ title: "Error", text: "Mark should be  less-than or equal to maximum mark  ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }

        }
        $('#questioncount_' + $('#questioncount').val()).removeClass('hidden');

        $('.carousel').carousel({
            interval: false,
            wrap: false
        });

        $('.btnnext').on('click', function () {
            var totalcount = $(this).attr('total');
            var qcount = $('#questioncount').val();
            if ($('#questioncount_' + qcount).find('input[type=number]').val() != null && $('#questioncount_' + qcount).find('input[type=number]').val() != '') {
                if (totalcount > qcount) {
                    var count = parseInt(qcount) + 1;
                    $('#questioncount').val(count);
                    $('#questioncount_' + count).removeClass('hidden');
                    $('#questioncount_' + qcount).addClass('hidden');
                }
                else {
                    swal({ title: "Message", text: "There is no more question and answers", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                }
            }
            else {
                swal({ title: "Error", text: "Please enter the mark ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }

        });

        $('.btnback').on('click', function () {
            var qcount = $('#questioncount').val();
            if ($('#questioncount_' + qcount).find('input[type=number]').val() != null && $('#questioncount_' + qcount).find('input[type=number]').val() != '') {

                if (qcount != 1) {
                    var count = parseInt(qcount) - 1;
                    $('#questioncount').val(count);
                    $('#questioncount_' + count).removeClass('hidden');
                    $('#questioncount_' + qcount).addClass('hidden');
                }
                else {
                    swal({ title: "Message", text: "There is no more question and answers", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                }
            }
            else {
                swal({ title: "Error", text: "Please enter the mark ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });


        $('#btnsave').on('click', function () {
            var total = $('#predefindmarksdiv').find('.totaleval').val();
            var actual = $('#predefindmarksdiv').find('.actualeval').val();
            if (parseInt(actual) < parseInt(total)) {

                $('#btnsave').addClass('disabled');
                var invigilationid = $('#invigilationid').val();
                var evaluationid = $('#evaluationid').val();
                var evalutiontype = $('#evaluationtype').val();
                var JsonData = '{"liEvaluationmark":[';
                $('#tblpredefined > tbody  > tr').each(function () {
                    var questionid = $(this).attr('questioinid');
                    var questiontype = $(this).attr('questiontype');
                    var totalmark = $(this).attr('totalmark');
                    var examsettingid = $(this).attr('examsettingid');
                    var status = $(this).attr('status');
                    var securedmark = $(this).find('.sec_mark').val();
                    //if (parseInt(securedmark) < parseInt(totalmark))
                    //{
                    if (questionid != null && questionid != '') {
                        JsonData += '{"QUESTION_ID":"' + questionid + '","QUESTION_TYPE":"' + questiontype + '","TOTAL_MARK":"' + totalmark + '", "SECURED_MARK":"' + securedmark + '","EXAM_SETTING_ID":"' + examsettingid + '","OPTION_ID":""},';
                    }
                    //}
                    //else
                    //{
                    //    swal({ title: "Error", text: "Mark should be  less-than or equal to maximum mark  ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    //    return false;
                    //}
                });
                JsonData = JsonData.slice(0, -1);
                JsonData += ']}';

                $.ajax({
                    url: '@Url.Action("SaveEvaluationMarks", "Examination")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sJsonData: JsonData, Evaluationtype: evalutiontype, sEvaluationId: evaluationid, sInvigilationId: invigilationid },
                    success: function (data) {
                        $('#btnsave').removeClass('disabled');
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                            $('#btnsave').attr('disabled', 'disabled');
                        }
                        else {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    },
                    error: function (error) {
                        $('#btnsave').removeClass('disabled');
                        swal({ title: "Error", text: "Internal Server Error!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                });
            }
            else {
                swal({ title: "Error", text: "You have already enterd mark for maximum Question ..!", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                return false;
            }
        });
        var degrees = 0;
