<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
@*<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>*@

<script>

                ContentLoad = function () {
                  $('.selectpicker').selectpicker({
                      size: 5
                  });
                   $('.selectpicker').selectpicker('refresh');
                }


                //fetching course
                $('#ClassList').change(function () {

                    if ($('#ClassList').val()) {
                        $.ajax({

                            url: "/Examination/FetchCourseByClassId",
                            type: "post",
                            data: { sClassId: $('#ClassList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message);
                                    $('#CourseList').empty();
                                    $('.selectpicker').selectpicker('refresh');
                                    QuizResult();
                                }
                                else {
                                    $('#CourseList').empty();
                                    $('#CourseList').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                    QuizResult();

                                }
                            },
                            error: function () {

                                alert("Internal server error........!");
                            }

                        });
                    }
                });


                //Fetching staffList in the quiz setting 

                $('#CourseList').change(function () {

                    if ($('#ClassList').val() && $('#CourseList').val()) {
                        $.ajax({

                            url: "/Examination/FetchQuizStaffByClassandCourse",
                            type: "post",
                            data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message);
                                    $('#StaffList').empty();


                                    $('#StaffList').trigger('change');
                                    $('.selectpicker').selectpicker('refresh');
                                    QuizResult();
                                }
                                else {
                                    $('#StaffList').empty();
                                    $('#StaffList').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                    QuizResult();


                                }
                            },
                            error: function () {

                                alert("Internal server error........!");
                            }

                        });
                    }

                });



                //Fetch Quiz Setting by staff

                //for fetching setting based on staff

                $('#StaffList').change(function () {


                    if ($('#StaffList').val()) {
                        $.ajax({
                            url: "/Examination/FetchQuizSettingByStaff",
                            type: "post",
                            //contentType: false,
                            //processData: true,
                            data: { sStaffId: $('#StaffList').val() },
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message);
                                    $('#QuizSetting').empty();
                                    $('.selectpicker').selectpicker('refresh');
                                    QuizResult();
                                }
                                else {
                                    $('#QuizSetting').empty();
                                    $('#QuizSetting').append(data.sResult);
                                    $('.selectpicker').selectpicker('refresh');
                                    QuizResult();
                                }
                            },
                            error: function () {

                            }
                        });
                    }
                    else
                    {
                        $('#QuizSetting').empty();
                        $('.selectpicker').selectpicker('refresh');
                    }
                });


                function QuizResult()
                {
                    var formData = new FormData();
                    var StaffId = $('#QuizSetting').val();

                    if ($('#ClassList').val() && $('#CourseList').val() && $('#StaffList').val() && $('#QuizSetting').val()) {
                        //  formData.append('staffId', StaffId);
                        $.ajax({
                            url: "/Examination/BindOnlineQuizMatchTheFollowingResultForAdmin",
                            type: "post",
                            data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sSettingId: $('#QuizSetting').val(), sStaffId: $('#StaffList').val() },
                            //contentType: false,
                            //processData: false,
                            success: function (data) {
                                if (data.Message != null) {
                                    alert(data.Message)
                                }
                                else {
                                    $('#DataDiv').html('');
                                    $('#DataDiv').append(data);
                                }
                            },
                            error: function () {

                            }
                        });
                    }
                    else {
                        $('#DataDiv').html('');
                    }
                }

             

                $('#QuizSetting').on("change", function () {
                    QuizResult();
                });

</script>







