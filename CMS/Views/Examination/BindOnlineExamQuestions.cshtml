@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
    int nCount = 0;
}


<div class="col-md-12 form-group table-responsive">

    <table class="table table-bordered table-hover" border="1">
        <thead>
            <tr>
                <th>#</th>
                <th>Class</th>
                <th>Course</th>
                <th>Question</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.liOnlineExaminationList != null && Model.liOnlineExaminationList.Count > 0)
                {
                    foreach (var item in Model.liOnlineExaminationList)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.COURSE_TITLE - ( @item.COURSE_CODE )</td>
                            <td>@item.QUESTIONS</td>
                            <td>
                                <a href="#OnlineExamQuestions-dialog" onclick="GetExaminationInfoById(@item.EXAM_QUESTIONS_ID);" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                <a href="javascript:;" onclick="GetConfrim(@item.EXAM_QUESTIONS_ID);" class="text-danger"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                                    }
                                }

            }
        </tbody>
    </table>
</div>


<!-- Hidden Filed -->
<input type="hidden" value="@Model.SettingId" id="hdSettingId" />
<!-- Hidden Filed-->

<script>

</script>