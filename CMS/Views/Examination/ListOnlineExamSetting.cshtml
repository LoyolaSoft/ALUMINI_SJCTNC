 @model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ListOnlineExamSetting";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    
}



<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Online Exam Setting List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Online Exam Setting List<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Online Exam Setting List</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12 form-horizontal">
                <div class="table-responsive">
                    <div class="form-group col-md-12">
                        <a href="#OnlineExamSetting-dialog" class="btn btn-success pull-right" data-toggle="modal"><i class="fa fa-plus"> Add</i></a>
                    </div>
                    <br /><br />
                    @{int No = 0;}
                    <table class="col-md-12 table table-hover table-bordered" id="tblOnlineExamSettingList">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Class</th>
                                <th>Course</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>No Of Questions</th>
                                <th>Total Marks</th>
                                <th>Session</th>
                                <th>Is Active</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.liOnlineExamSetting != null)
                            {
                                foreach (var item in Model.liOnlineExamSetting)
                                {
                                    <tr>
                                        <td>@{No++; } @No</td>
                                        <td>@item.CLASS_NAME</td>
                                        <td>@item.COURSE_TITLE - ( @item.COURSE_CODE )</td>
                                        <td>@item.EXAM_DATE</td>
                                        <td>@item.TIME Hrs</td>
                                        <td>@item.NO_OF_QUESTIONS</td>
                                        <td>@item.TOTAL_MARK</td>
                                        <td>@item.SESSION_NAME</td>
                                        <td>
                                            @if (item.IS_ACTIVE == "1")
                                            {
                                                <a href="javascrip:;" onclick="SetDeActive(@item.EXAM_SETTING_ID)" class="text-success"><i class="fa fa-check"></i></a>             }
                                            else
                                            {
                                                <a href="javascrip:;" onclick="SetActive(@item.EXAM_SETTING_ID)" class="text-danger"><i class="fa fa-times"></i></a>
                                            }
                                        </td>
                                        <td>
                                            <a href="#OnlineExamSetting-dialog" onclick="FetchSettingInfo(@item.EXAM_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                            <a href="#OnlineExamSettingList-dialog" onclick="FetchStudentList(@item.EXAM_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-eye"></i></a>
                                            @if (item.IS_ACTIVE == "0")
                                            {
                                                <a href="javascrip:;" onclick="GetConfirm(@item.EXAM_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                            }

                                        </td>
                                    </tr>
                                                }
                                            }

                        </tbody>
                    </table>
                    <br />
                </div>
            </div>
        </div>

    </div>
</div>



<!-- Add/ Edit Begin Modal -->
<div class="modal" id="OnlineExamSetting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Online Exam Setting</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            
                                <!-- Class -->
                                <div class="col-md-12 form-group ">
                                    @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <!-- Course -->
                                <div class="col-md-12 form-group">
                                    @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>

                                <!-- Student -->
                                <div class="col-md-12 form-group">
                                    @Html.Label("Student", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true",data_actions_box="true",multiple="multiple" })
                                    </div>
                                </div>

                                <!-- No Of Questions -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label"> No Of Questions</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtNoOfQuestions" class="form-control" placeholder="Enter No Of Questions">
                                    </div>
                                </div>

                                <!-- No Of Questions -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label"> To Atten</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtQuestionsToAtten" class="form-control" placeholder="Enter No Of Questions To Atten">
                                    </div>
                                </div>

                                <!-- Mark Per Question -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Mark Per Question</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtMarkPerQuestion" class="form-control" placeholder="Enter Mark Per Question">
                                    </div>
                                </div>

                                <!-- Total Mark -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Total Mark</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtTotalMark" class="form-control" disabled placeholder="Total Mark">
                                    </div>
                                </div>

                                <!-- Start Date -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Exam Date</label>
                                    <div class="col-md-9">
                                        <div class="input-group date" id="datetimepicker1">
                                            <input type="text" id="txtExamDate" class="form-control input-sm" placeholder="Select Date" />
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Time -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Time (Hrs)</label>
                                    <div class="col-md-9">
                                        <input type="number" id="txtTime" class="form-control" placeholder="Enter Time">
                                    </div>
                                </div>

                                <!-- Session -->
                                <div class="col-md-12 form-group">
                                    @Html.Label("Session", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.SessionType, (Model.SessionType != null) ? Model.SessionType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    </div>
                                </div>
                                
                            <div class="col-md-12 form-group">
                                @Html.Label("Active", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9 checkbox checkbox-css">
                                    <input type="checkbox" id="IsActive"/>
                                    <label for="IsActive"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->


<!-- ONline Exam Student List Begin Modal -->
<div class="modal" id="OnlineExamSettingList-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Online Exam Student List </h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="table-responsive" id="dvStudentList">
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->


<!-- Hidden Filed -->
<input type="text" id="hdSettingId" class="hidden" />
<!-- Hidden Filed -->


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');

    function ContentLoad()
    {
        // Document Ready Function .
    }

        // Document Ready Function .
        handleDatepicker = function ()
        {
            "use strict";
            $("#txtExamDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                startDate:new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
        }
        handleDatepicker();

     // On Class List Change ,...
     $('#ClassList').on('change',function () 
     {
         FetchCourseByClassId(0,0);
     });

     //var CourseId = '';
    function FetchCourseByClassId(sCourseId,sStudentId)
    {
        if ($('#ClassList').val())
        {
            $.ajax({
                url: '@Url.Action("FetchCourseByClassId", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ClassList').val() },
                success: function (data) {
                    $('#CourseList').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        //CourseId = sCourseId;
                        
                        $('#CourseList').append(data.sResult);
                        $('#CourseList').val(sCourseId);
                        if (sCourseId!=0)
                        {
                            FetchStudentByClassId(sStudentId);
                        }
                        
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    }


    // On Course List Change ,...
    $('#CourseList').on('change', function ()
    {
        FetchStudentByClassId(0);
    });

    function FetchStudentByClassId(StudentIds)
    {
        
        //alert("Class : " + $('#ClassList').val() + " Course : " + $('#CourseList').val());
            var sCourseId = $('#CourseList').val();
            //if (CourseId != null && CourseId!='')
            //{
            //    sCourseId = CourseId;
            //}

            //alert("sCourseId" + sCourseId + "CourseId" + CourseId);
            $.ajax({
                url: '@Url.Action("FetchStudentByClassAndCourseId", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ClassList').val(), sCourseId: sCourseId, sStudentId: StudentIds },
                success: function (data) {
                    $('#StudentList').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        alert(data.Message);
                    } else
                    {
                        $('#StudentList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        
    }


    


    $('#tblOnlineExamSettingList').DataTable();


    $('#txtMarkPerQuestion').on('focusout', function ()
    {
        var vTotalmark = $('#txtQuestionsToAtten').val() * $('#txtMarkPerQuestion').val();
        $('#txtTotalMark').val(vTotalmark)
    });

    // On Submit Setting ...
    $('#btnSubmit').on('click', function ()
    {
        if ($('#txtTime').val() && $('#SessionType').val() && $('#txtNoOfQuestions').val() && $('#txtQuestionsToAtten').val() && $('#txtMarkPerQuestion').val() && $('#txtTotalMark').val() && $('#StudentList').val() != 0)
        {
            var IsActive = 0;
            if ($('#IsActive').is(':checked'))
            {
                IsActive = 1;
            }
            var sSemesterId = $('#CourseList Option:selected').attr('cms-sSemesterId');
            var sStudentId = String($('#StudentList').val());
            var JsonData = null;
            JsonData = '{"EXAM_SETTING_ID":"' + $('#hdSettingId').val() + '",\
                         "CLASS_ID":"' + $('#ClassList').val() + '",\
                         "COURSE_ID":"' + $('#CourseList').val() + '",\
                         "STUDENT_ID":"'+"0," + sStudentId + '",\
                         "EXAM_DATE":"' + $('#txtExamDate').val() + '",\
                         "TIME":"' + $('#txtTime').val() + '",\
                         "SESSION_ID":"' + $('#SessionType').val() + '",\
                         "NO_OF_QUESTIONS":"' + $('#txtNoOfQuestions').val() + '",\
                         "QUESTIONS_TO_ATTEN":"' + $('#txtQuestionsToAtten').val() + '",\
                         "EACH_QUESTION_MARKS":"' + $('#txtMarkPerQuestion').val() + '",\
                         "TOTAL_MARK":"' + $('#txtTotalMark').val() + '",\
                         "IS_ACTIVE":"' + IsActive + '",\
                         "SEMESTER_ID":"' + sSemesterId + '"\}';
            
            $.ajax({
                url:'@Url.Action("SaveOnlineExamSetting", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sJsonData: JsonData },
                success: function (data)
                {
                    alert(data.Message);
                    loadContent('/Examination/ListOnlineExamSetting');
                    //$('#btnGet').click();
                    //GetQuizSettingList();
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        } else
        {
            alert('Please Fill All Values To Continue !');
        }
    });
</script>

<script>
    // Activate Setting ...
    function SetActive(ID)
    {
        if (!confirm('Are you sure to Activate ?'))
        {
            return false;
        } else {
            $.ajax({
                url:"@Url.Action("UpdateActiveOnlineExamSetting", "Examination")",
                method: "POST",
                datatype:"json",
                data: { sExamSettingId: ID, sActive: '1', sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                success:function(data)
                {
                    alert(data.Message);
                    loadContent('/Examination/ListOnlineExamSetting');
                    //$('#btnGet').click();
                    //GetQuizSettingList();
                },error:function(error)
                {
                    alert('Internal Server Error ! ');
                }
            });
        }

    }

    // De - Activate Setting ...
    function SetDeActive(ID)
    {
      
        if (!confirm('Are you sure to De - Activate ?'))
        {
            return false;
        }
        $.ajax({
            url:"@Url.Action("UpdateActiveOnlineExamSetting", "Examination")",
            method: "POST",
            datatype:"json",
            data: { sExamSettingId: ID, sActive: '0', sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
            success:function(data)
            {
                alert(data.Message);
                loadContent('/Examination/ListOnlineExamSetting');
                //$('#btnGet').click();
                //GetQuizSettingList();
            },error:function(error)
            {
                alert('Internal Server Error ! ');
            }
        });
    }

    // Delete Setting ...
    function GetConfirm(ID)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        }
        else
        {
            $.ajax({
                url:"@Url.Action("DeleteOnlineExamSetting", "Examination")",
                method: "POST",
                datatype:"json",
                data: { sExamSettingId: ID },
                success:function(data)
                {
                    alert(data.Message);
                    loadContent('/Examination/ListOnlineExamSetting');
                    //$('#btnGet').click();
                    //GetQuizSettingList();
                },error:function(error)
                {
                    alert('Internal Server Error ! ');
                }
            });
        }
    }

    // Fetch Settin Info ...
    function FetchSettingInfo(ID)
    {
        $.ajax({
            url:"@Url.Action("FetchOnlineExamInfoById", "Examination")",
            method: "POST",
            datatype:"json",
            data: { sExamSettingId: ID },
            success:function(data)
            {
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $('#ClassList').val(data[0].CLASS_ID);
                    //$('.selectpicker').selectpicker('refresh');
                    FetchCourseByClassId(data[0].COURSE_ID,data[0].STUDENT_ID);
                    //$('.selectpicker').selectpicker('refresh');
                    $('#txtNoOfQuestions').val(data[0].NO_OF_QUESTIONS);
                    $('#txtQuestionsToAtten').val(data[0].QUESTIONS_TO_ATTEN);
                    $('#txtMarkPerQuestion').val(data[0].EACH_QUESTION_MARKS);
                    $('#txtTotalMark').val(data[0].TOTAL_MARK);
                    $('#txtExamDate').val(data[0].EXAM_DATE);
                    $('#SessionType').val(data[0].SESSION_ID);
                    $('#txtTime').val(data[0].TIME);
                    $('#hdSettingId').val(data[0].EXAM_SETTING_ID);
                    if (data[0].IS_ACTIVE=="1")
                    {
                        $('#IsActive').click();
                    }
                    
                    $('.selectpicker').selectpicker('refresh');
                }
            },error:function(error)
            {
                alert('Internal Server Error ! ');
            }
        });
    }

    // Delete Student List ..
    function GenConfrimStudentList(ID,sStudentId)
    {
        if (ID != null && sStudentId != null)
        {
            $.ajax({
                url: '@Url.Action("DeleteStudentInOnlineExamSetting", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sExamSettingId: ID, sStudentId: sStudentId },
                success: function (data)
                {
                    alert(data.Message);
                    FetchStudentList(ID);
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    }

    function FetchStudentList(sExamSettingId)
    {
        $.ajax({
            url:'@Url.Action("FetchStudentListBySettingId", "Examination")',
            method: 'POST',
            datatype:'json',
            data: { sExamSettingId: sExamSettingId },
            success: function (data)
            {
                $('#dvStudentList').empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    var JsonDom = null;
                    JsonDom = '<table class="table table-hover table-bordered" id="tblLoadStudentList">\
                                <thead>\
                                    <tr>\
                                        <th>#</th>\
                                        <th>Roll_No</th>\
                                        <th>Name</th>\
                                        <th>Date</th>\
                                        <th>Session</th>\
                                        <th>Action</th>\
                                    </tr>\
                                </thead>\
                                <tbody>';
                    var nCount=0;
                    $.each(data, function (i, element)
                    {
                        nCount++;
                        JsonDom += "<tr>\
                                        <td>"+nCount+"</td>\
                                        <td>"+element.ROLL_NO+"</td>\
                                        <td>"+element.FIRST_NAME+"</td>\
                                        <td>"+element.EXAM_DATE+"</td>\
                                        <td>"+element.SESSION_NAME+"</td>\
                                        <td>\
                                            <a href='javascrip:;' onclick='GenConfrimStudentList("+element.EXAM_SETTING_ID+","+element.STUDENT_ID+")' class='text-danger'><i class='fa fa-trash'></i></a>\
                                        </td>\
                                   </tr>";
                    });

                    JsonDom += "</tbody> </table>";
                    $('#dvStudentList').append(JsonDom);
                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }


    // On Modal Close ,...
    $('#OnlineExamSetting-dialog').on('hidden.bs.modal', function ()
    {
        $('#ClassList').val(' ');
        $('#CourseList').val(' ');
        $('#StudentList').val(' ');
        $('#hdSettingId').val(' ');
        $('#txtTotalMark').val(' ');
        $('#txtNoOfQuestions').val(' ');
        $('#txtQuestionsToAtten').val(' ');
        $('#txtMarkPerQuestion').val(' ');
        $('#txtExamDate').val(' ');
        $('#SessionType').val(' ');
        $('#txtTime').val(' ');
        if ($('#IsActive').is(':checked'))
        {
            $('#IsActive').click();
        }
        $('.selectpicker').selectpicker('refresh');

    });
</script>

