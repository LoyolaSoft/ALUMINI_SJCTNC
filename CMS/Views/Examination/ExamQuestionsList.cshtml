@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <!-- begin breadcrumb -->
        <ol class="breadcrumb pull-right">
            <li><a @*href="@Url.Action("Student", "DashBoard")"*@ href="javascript:;">Home</a></li>
            <li class="active">Exam Questions </li>
        </ol>
        <!-- end breadcrumb -->
        <!-- begin page-header -->
        <h1 class="page-header">Exam Questions<small></small></h1>
        <!-- end page-header -->

        <div class="panel panel-primary" id="panel">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Exam Questions</h4>
            </div>
            <div class="panel-body">

                <div class="col-md-12 form-group">

                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Department</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Semester Type</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label class="control-label col-md-3">Course</label>
                        <div class="col-md-9">
                            @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true", data_parsley_required = "true" })
                        </div>
                    </div>

                </div>

                <div class="form-group col-md-12">
                    <div id="dvBindQuestions"></div>
                </div>
            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    $('.selectpicker').selectpicker({ size: 6 });
    $('.selectpicker').selectpicker('refresh');
    function ContentLoad()
    {
        // Document ready function ...
    }
</script>

@* Fetch Course By Department & SemesterId*@
<script>
    $('#DepartmentList').on('change', function ()
    {
        FetchCourse();
    });

    $('#Semester').on('change', function ()
    {
        FetchCourse();
    });


    function FetchCourse()
    {
        if ($('#DepartmentList').val() && $('#Semester').val())
        {
            $.ajax({
                url: '/Examination/FetchCourseByDepartmentAndSemesterTypeId',
                method: 'POST',
                datatype: 'json',
                data: { sDepartmentId: $('#DepartmentList').val(), sSemesterTypeId: $('#Semester').val() },
                success: function (data)
                {
                    $('#CourseList').empty();
                    if (data.ErrorCode == "200")
                    {
                        $('#CourseList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
</script>

@* Fetch Questions By Course *@
<script>
    $('#CourseList').on('change', function ()
    {
        if ($('#CourseList').val())
        {
            $.ajax({
                url: '/Examination/BindExamQuestions',
                method:'POST',
                datatype:'json',
                data: { sCourseId: $('#CourseList').val() },
                success: function (data)
                {
                    $('#dvBindQuestions').empty();
                    if (data.Message!=null && data.Message!='')
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else
                    {
                        $('#dvBindQuestions').append(data); 
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
</script>