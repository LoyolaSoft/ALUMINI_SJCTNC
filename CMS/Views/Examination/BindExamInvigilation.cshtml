@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}


<div class="col-md-12 table-responsive">
    <table class="table table-bordered" id="tblStudent">
        <thead>
            <tr>
                <th>#</th>
                <th>Exam Date</th>
                <th>Exam Time</th>
                <th>Course </th>
                <th>Class </th>
                <th>Name</th>
                <th>Invigilator</th>
                <th>Set</th>
            </tr>
        </thead>
        <tbody>
           @if (Model.liexaminvigilation!=null && Model.liexaminvigilation.Count>0)
           {
               int nCount = 0;
               foreach (var item in Model.liexaminvigilation)
               {
                   <tr>
                       <td>@{nCount++;} @nCount</td>
                       <td>@item.EXAM_DATE</td>
                       <td>@item.EXAM_TIME</td>
                       <td>@item.COURSE_CODE</td>
                       <td>@item.CLASS_NAME</td>
                       <td>@item.REGISTER_NO</td>
                       <td>@item.STAFF_CODE</td>
                       <td>@item.SET_NAME</td>
                   </tr>
                 }
             }
             
        </tbody>
    </table>
</div>