@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}

<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Roll No</th>
                <th>Register No</th>
                <th>Name</th>
                <th>Course Count</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liStudentList!=null && Model.liStudentList.Count>0)
            {
                int nCount = 0;
                foreach (var item in Model.liStudentList)
                {
                    <tr>
                        <td>@{nCount++;} @nCount</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.REGISTER_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.COURSE</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>