@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int count = 0;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<style>
    .inbox_msg {
        border: 1px solid #c4c4c4;
        clear: both;
        overflow: hidden;
    }

    .top_spac {
        margin: 20px 0 0;
    }


    .recent_heading {
        float: left;
        width: 40%;
    }

    .srch_bar {
        display: inline-block;
        text-align: right;
        width: 60%;
        padding:;
    }

    .headind_srch {
        padding: 10px 29px 10px 20px;
        overflow: hidden;
        border-bottom: 1px solid #c4c4c4;
    }

    .recent_heading h4 {
        color: #05728f;
        font-size: 21px;
        margin: auto;
    }

    .srch_bar input {
        border: 1px solid #cdcdcd;
        border-width: 0 0 1px 0;
        width: 80%;
        padding: 2px 0 4px 6px;
        background: none;
    }

    .srch_bar .input-group-addon button {
        background: rgba(0, 0, 0, 0) none repeat scroll 0 0;
        border: medium none;
        padding: 0;
        color: #707070;
        font-size: 18px;
    }

    .srch_bar .input-group-addon {
        margin: 0 0 0 -27px;
    }

    .chat_ib h5 {
        font-size: 15px;
        color: #464646;
        margin: 0 0 8px 0;
    }

        .chat_ib h5 span {
            font-size: 13px;
            float: right;
        }

    .chat_ib p {
        font-size: 14px;
        color: #989898;
        margin: auto;
    }

    .chat_img {
        float: left;
        width: 11%;
    }

    .chat_ib {
        float: left;
        padding: 0 0 0 15px;
        width: 88%;
    }

    .chat_people {
        overflow: hidden;
        clear: both;
    }

    .chat_list {
        border-bottom: 1px solid #c4c4c4;
        margin: 0;
        padding: 18px 16px 10px;
    }

    .inbox_chat {
        height: 550px;
        overflow-y: scroll;
    }

    .active_chat {
        background: #ebebeb;
    }

    .incoming_msg_img {
        display: inline-block;
        width: 6%;
    }

    .received_msg {
        display: inline-block;
        padding: 0 0 0 10px;
        vertical-align: top;
        width: 92%;
    }

    .received_withd_msg p {
        background: #ebebeb none repeat scroll 0 0;
        border-radius: 3px;
        color: #646464;
        font-size: 14px;
        margin: 0;
        padding: 5px 10px 5px 12px;
        width: 100%;
    }

    .time_date {
        color: #747474;
        display: block;
        font-size: 12px;
        margin: 8px 0 0;
    }

    .received_withd_msg {
        width: 57%;
    }

    .mesgs {
        /*float: right;*/
        /*padding: 30px 15px 0 25px;*/
    }

    .sent_msg p {
        background: #05728f none repeat scroll 0 0;
        border-radius: 3px;
        font-size: 14px;
        margin: 0;
        color: #fff;
        padding: 5px 10px 5px 12px;
        width: 100%;
    }

    .outgoing_msg {
        overflow: hidden;
        margin: 26px 0 26px;
    }

    .sent_msg {
        float: right;
        width: 46%;
    }

    .input_msg_write input {
        background: rgba(0, 0, 0, 0) none repeat scroll 0 0;
        border: medium none;
        color: #4c4c4c;
        font-size: 15px;
        min-height: 48px;
        width: 100%;
    }

    .type_msg {
        border-top: 1px solid #c4c4c4;
        position: relative;
    }

    .msg_send_btn {
        background: #05728f none repeat scroll 0 0;
        border: medium none;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        font-size: 17px;
        height: 33px;
        position: absolute;
        right: 0;
        top: 11px;
        width: 33px;
    }

    .messaging {
        padding: 0 0 50px 0;
    }

    .msg_history {
        height: 250px;
        overflow-y: auto;
    }
</style>

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student List</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Student List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12 table-bordered table-responsive">
                                    <br>
                                    @if (Model.liexaminvigilation != null && Model.liexaminvigilation.Count > 0)
                                    {
                                        <div class="col-md-12">
                                            <br><br>
                                            <div class="col-md-offset-2 col-md-6">
                                                Course:@Model.liexaminvigilation.FirstOrDefault().COURSE_TITLE
                                            </div>
                                            <div class="col-md-4">
                                                Time:@Model.liexaminvigilation.FirstOrDefault().START_TIME
                                            </div>
                                            <br>
                                            <br>
                                        </div>
                                    }

                                    <table class="table table-bordered" id="studentlist">
                                        <thead>
                                            <tr>
                                                <td>#</td>
                                                <td>Roll No</td>
                                                <td>Name</td>
                                                <td>Mobile No</td>
                                                <td>Course</td>
                                                <td>Violation</td>
                                                <td>Logs</td>
                                                <td>Moniter</td>
                                                <td>Answer Sheets</td>
                                                <td>Is Suspended</td>
                                                <td>Is Complete</td>
                                                <td>Chat</td>
                                                <td>Reupload</td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.liexaminvigilation != null && Model.liexaminvigilation.Count > 0)
                                            {
                                                foreach (var item in Model.liexaminvigilation)
                                                {

                                                    count++;
                                                    <tr invigilation="@item.EXAM_INVIGILATION_ID" msgcount="@item.MSGCOUNT" id="msgc_@item.EXAM_INVIGILATION_ID">
                                                        <td>@count</td>
                                                        @if (string.IsNullOrEmpty(item.REGISTER_NO))
                                                        {
                                                            <td>@item.ROLL_NO</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.REGISTER_NO</td>
                                                        }                                                       
                                                        <td>@item.FIRST_NAME</td>
                                                        <td>@item.MOBILE_NO</td>
                                                        <td>@item.COURSE_TITLE</td>
                                                        <td>@item.VIOLATION_COUNT</td>
                                                        <td><a href="#violationmodal" data-target="#violationmodal" data-toggle="modal" onclick="FetchExamStudentLogs(@item.EXAM_INVIGILATION_ID)"><i class="fa fa-eye"></i></a></td>
                                                        <td><a href="#moniternmodal" data-target="#moniternmodal" data-toggle="modal" onclick="FetchExamMoniterLogs(@item.EXAM_INVIGILATION_ID)"><i class="fa fa-eye"></i></a></td>
                                                        <td><a href="#answersheetmodal" data-target="#answersheetmodal" data-toggle="modal" onclick="FetchAnswerSheets(@item.EXAM_INVIGILATION_ID,@item.STUDENT_ID)"><i class="fa fa-eye"></i></a></td>
                                                        @if (@item.SUSPECTIONS == "1")
                                                        {
                                                            <td> <a href="#" onclick="SuspectStatus(@item.EXAM_INVIGILATION_ID,'0');" title="REMOVE SUSPECTIONS"><i class="fa fa-check text-success"></i></a></td>
                                                        }
                                                        else
                                                        {
                                                            <td> <a href="#" onclick="SuspectStatus(@item.EXAM_INVIGILATION_ID,'1');" title="UNDER SUSPECTIONS"><i class="fa fa-close text-danger"></i></a></td>
                                                        }
                                                        @if (@item.COMPLETE == "1")
                                                        {
                                                            <td> <a href="#" onclick="CompleteStatus(@item.EXAM_INVIGILATION_ID,'0');" title="IN COMPLETE"><i class="fa fa-check text-success"></i></a></td>

                                                        }
                                                        else
                                                        {
                                                            <td><a href="#" onclick="CompleteStatus(@item.EXAM_INVIGILATION_ID,'1');" title="COMPLETE"><i class="fa fa-close text-danger"></i></a></td>
                                                        }
                                                        <td>
                                                            <a href="#chatmodal" data-target="#chatmodal" data-toggle="modal" onclick="FetchChatMessageforStaff(@item.EXAM_INVIGILATION_ID,@item.STUDENT_ID)"><i class="fa fa-paper-plane"></i><label class="label label-success  hidden" id="newmsg_@item.EXAM_INVIGILATION_ID">New</label></a>
                                                        </td>
                                                        <td><a href="#reuploadanswermodal" data-target="#reuploadanswermodal" data-toggle="modal" onclick="FetchReuploadingAnswerSheet(@item.EXAM_INVIGILATION_ID,@item.STUDENT_ID)"><i class="fa fa-eye"></i></a></td>

                                                    </tr>

                                                }

                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="8">No Records Found...!</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-12" id="bindstudentforinvigilation">

                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<input type="hidden" id="invigilationid" />
<input type="hidden" id="studentid" />
<input type="hidden" id="staffid" value="@Model.liexaminvigilation.FirstOrDefault().EXAM_INVIGILATOR_ID" />
@if (Model.Listonlineexamsetting != null && Model.Listonlineexamsetting.Count > 0)
{
    <input type="hidden" id="camera" value="@Model.Listonlineexamsetting.FirstOrDefault().IS_NEED_CAMERA">
    <input type="hidden" id="chat" value="@Model.Listonlineexamsetting.FirstOrDefault().IS_NEED_CHAT">
    <input type="hidden" id="log" value="@Model.Listonlineexamsetting.FirstOrDefault().IS_NEED_LOG">
    <input type="hidden" id="autostart" value="@Model.Listonlineexamsetting.FirstOrDefault().IS_AUTO_START">
}
else
{
    <input type="hidden" id="camera" value="0">
    <input type="hidden" id="chat" value="0">
    <input type="hidden" id="log" value="0">
    <input type="hidden" id="autostart" value="0">
}


<!-- Chat Modal -->
<div class="modal" id="chatmodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Messages</h4>
            </div>
            <div class="modal-body">

                <div class="mesgs">
                    <div class="msg_history">

                    </div>
                    <div class="type_msg">
                        <div class="input_msg_write">
                            <input type="text" id="write_msg" class="write_msg" placeholder="Type a message" />
                            <button class="msg_send_btn" type="button" id="sendmsg"><i class="glyphicon glyphicon-send" aria-hidden="true"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>

<!-- Begin Modal -->
<div class="modal" id="violationmodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Violation Details</h4>
            </div>
            <div class="modal-body">
                <div class="" id="bindstudentviolation">

                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>


<!-- Begin Modal -->
<div class="modal" id="moniternmodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Moniter Details</h4>
            </div>
            <div class="modal-body">
                <div class="" id="bindstudentmoniter">

                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>

<!-- Begin Modal -->
<div class="modal" id="answersheetmodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Answer Sheets</h4>
            </div>
            <div class="modal-body">
                <div class="" id="bindanswersheets">

                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Begin Modal -->
<div class="modal" id="reuploadanswermodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Answer Sheets</h4>
            </div>
            <div class="modal-body">
                <div class="" id="bindreuploadanswersheets">

                </div>
            </div>

        </div>
    </div>
</div>


<input type="hidden" id="newcount" value="0">
<!-- End Modal -->
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function AcceptReuploadAnswerSheet(QUIZSAVEID, QUESTIONTYPEID, STUDENTID)
    {
        if (QUIZSAVEID != "" && QUESTIONTYPEID != "" && STUDENTID != "")
        {
            $.ajax({
                url: "@Url.Action("UpdatePreviewStatus", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sQuizsaveId: QUIZSAVEID, sQuestiontypeId: QUESTIONTYPEID,sStudentId:STUDENTID },
            success: function (data)
            {
                alert(data.Message);

            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    }
    function FetchReuploadingAnswerSheet(ID, STUDENTID)
    {
        if (ID != "" && STUDENTID != "")
        {
            $.ajax({
                url: "@Url.Action("FetchReuploadAnswerSheets", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamInvigilationid: ID, sStudentId: STUDENTID },
            success: function (data)
            {
                $('#bindreuploadanswersheets').empty();
                $('#bindreuploadanswersheets').append(data);

            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }
    }
    function AssignPreviewForStudent(QUIZSAVEID,QUESTIONTYPEID,STUDENTID)
    {
        if (QUIZSAVEID != "" && QUESTIONTYPEID != "" && STUDENTID != "")
        {
            $.ajax({
                url: "@Url.Action("AssignPreviewForStudent", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sQuizsaveId: QUIZSAVEID, sQuestiontypeId: QUESTIONTYPEID,sStudentId:STUDENTID },
            success: function (data)
            {
                alert(data.Message);

            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    }
    function FetchExamStudentLogs(ID) {
        if (ID != "") {
            $.ajax({
                url: "@Url.Action("FetchStudentLogInfo", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sExamInvigilationid: ID },
                success: function (data) {
                    $('#bindstudentviolation').empty();
                    $('#bindstudentviolation').append(data);

                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
    }
    function FetchExamMoniterLogs(ID)
    {
        if (ID != "")
        {
            $.ajax({
                url: "@Url.Action("FetchStudentMoniterLogs", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamInvigilationid: ID },
            success: function (data) {
                $('#bindstudentmoniter').empty();
                $('#bindstudentmoniter').append(data);

            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    }
    function SuspectStatus(INVIGILATION_ID, VALUE) {
        swal({
            title: "Are you sure want to Suspect/Remove Suspect..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("UpdateSuspectedStatus", "Examination")",
                type: "post",
                data: { sExamInvigilationid: INVIGILATION_ID, sValue: VALUE },
                success: function (data) {
                    if (data.ErrorCode == "406") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        GetStudentList($('#examsettingid').val(), $('#courseid').val(), $('#staffid').val());
                    }
                },
                error: function (ex) {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

    }

    function CompleteStatus(INVIGILATION_ID, VALUE) {
        swal({
            title: "Are you sure want to complete status..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("UpdateCompleteStatus", "Examination")",
                type: "post",
                data: { sExamInvigilationid: INVIGILATION_ID, sValue: VALUE },
                success: function (data) {
                    if (data.ErrorCode == "406") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        GetStudentList($('#examsettingid').val(), $('#courseid').val(), $('#staffid').val());
                    }
                },
                error: function (ex) {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

    }
    function FetchAnswerSheets(ID,STUDENTID)
    {
        if (ID != "" && STUDENTID != "")
        {
            $.ajax({
                url: "@Url.Action("FetchAnswerSheets", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamInvigilationid: ID, sStudentId: STUDENTID },
            success: function (data)
            {
                $('#bindanswersheets').empty();
                $('#bindanswersheets').append(data);

            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    }
    }
</script>
<script>
    var chat = $('#chat').val();

    $('#sendmsg').on('click', function ()
    {
        if (chat == "1") {
            var Examinvigilationid = $('#invigilationid').val();
            var StaffId = $('#staffid').val();
            var Message = $('#write_msg').val();
            var UserId = $('#studentid').val();

            $.ajax({
                url: '@Url.Action("SaveChatMessagesFromStaff", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sInvigilationId: Examinvigilationid, sInvigilatorId: StaffId, sReceiver: UserId, sMessage: Message },
                success: function (data) {
                    var currentdate = new Date();
                    var datetime = "Now: " + currentdate.getDate() + "/"
                                + (currentdate.getMonth() + 1) + "/"
                                + currentdate.getFullYear() + "|"
                                + currentdate.getHours() + ":"
                                + currentdate.getMinutes() + ":"
                                + currentdate.getSeconds();
                    var msgdiv = '<div class="outgoing_msg"><div class="sent_msg"><p>' + Message + '</p> <span class="time_date">' + datetime + '</span></div></div>';
                    $('.msg_history').append(msgdiv);
                    $('#write_msg').val('');
                },
                error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
        else
        {
            swal({ title: "Error..!!", text: "Please check Online Exam Setting ...!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }
    });

    function FetchChatMessageforStaff(ID, STUDENTID)
    {
        if (chat == "1") {
            $('#invigilationid').val(ID);
            $('#studentid').val(STUDENTID);

            $.ajax({
                url: '@Url.Action("FetchChatMessage", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sInvigilationId: ID },
                success: function (data) {
                    $('.msg_history').empty();
                    var msghistory = '';
                    if (data != null && data != "") {
                        $('#msgc_' + ID).attr('msgcount', data.length);
                        $.each(data, function (i, item) {

                            if (item.MESSAGE_TYPE == "0") {
                                msghistory += '<div class="outgoing_msg"><div class="sent_msg"><p>' + item.MESSAGE + '</p> <span class="time_date">' + item.DATE + '|' + item.TIME + '</span></div></div>';
                            }
                            else {
                                msghistory += '<div class="incoming_msg"><div class="received_msg"><div class="received_withd_msg"><p>' + item.MESSAGE + '</p><span class="time_date"> ' + item.DATE + '|' + item.TIME + '</span></div></div>';
                            }

                        });

                    }

                    $('.msg_history').append(msghistory);
                },
                error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
        else
        {
            swal({ title: "Error..!!", text: "Please check Online Exam Setting ...!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
        }


    }

    function LoopStudents() {
        $('#studentlist > tbody  > tr').each(function ()
        {
            var invigilationid = $(this).attr('invigilation');
            var msgcount = $(this).attr('msgcount');
            $.ajax({
                url: '@Url.Action("FetchChatMessage", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sInvigilationId: invigilationid },
                success: function (data) {

                    if (data != null && data != "" && data.length != 0)
                    {
                        if (parseInt(msgcount) < parseInt(data.length))
                        {
                            
                            $('#newmsg_' + invigilationid).removeClass('hidden');

                          
                        }
                        else {
                            $('#newmsg_' + invigilationid).addClass('hidden');
                        }
                    }
                },
                error: function (error) {
                    alert('Internal Server Error !');
                }
            });


        });
    }
    if (chat == "1") {
        setInterval(function () { LoopStudents() }, 30000);
    }
</script>

