@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "InstantStudentForSubjectStaff";
    Layout = null;
    string sIcon = string.Empty;
    string sClass = string.Empty;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />
<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        margin: 0;
    }
</style>


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Instant Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Instant Student List<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Instant Student List</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-4" data-step="1" data-intro="Choose Class">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-8">

                                <select class="form-control  selectpicker" id="ClassList" data-live-search="true">
                                    <option value=""> -- Select -- </option>
                                    @if (Model.liClassList != null && Model.liClassList.Count > 0)
                                    {
                                        foreach (var item in Model.liClassList)
                                        {
                                            sIcon = string.Empty;
                                            sClass = string.Empty;
                                            <option value="@item.CLASS_ID" @item.CIA_DISABLE @if (!string.IsNullOrEmpty(item.CIA_DISABLE)) { sIcon = "fa fa-ban"; sClass = "text-danger"; } data-icon="@sIcon" class="@sClass">

                                                @item.CLASS_NAME
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4" data-step="2" data-intro="Choose Course">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>

                        </div>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvCIAbind')"> Print </button>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                    </div>
                </div>


                <div id="dvCIAbind"></div>
            }

        </div>

    </div>
</div>
<!-- end #content -->
@*<script src="~/Content/assets/plugins/intro-js/intro.js"></script>*@
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/js/xlsx-package.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .
        $(document).on("wheel", "input[type=number]", function (e) {
            $(this).blur();
        });
    }
    //$(document).ready(function ()
    //{

    //});
    $('.selectpicker').selectpicker({
        size: 8
    });
    $('.selectpicker').selectpicker('refresh');
</script>

<script>



        var flag = true;
        $('#ClassList').on('change', function () {
            var inp = $('#ClassList').val();
            $.ajax({
                url: "@Url.Action("GetCourseByClassIdAndStaffId", "Examination")",
                async: false,
                data: { sClassId: inp },
                success: function (option)
                {
                    if (option == '204')
                    {
                        alert('Session Is Expired Please Login Again !!!');
                    } else
                    {
                        var select = $('#CourseList');
                        select.empty();
                        select.append('<option value="" >---Select---</option>' + option);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }

            });
        });

        $('#CourseList').on('change', function ()
        {
            if ($(this).val() != 0) {
                BindData();
            } else {

                var divHtml = $('#dvCIAbind');
                divHtml.empty();
            }
            $('.selectpicker').selectpicker('refresh');
        });



    function BindData()
{
        $('#dvCIAbind').empty();
        var courseID = $('#CourseList').val();
    $.ajax({
        url: '@Url.Action("BindInstantExamStudentsByClassCourseWise", "Examination")',
        method: 'POST',
        datatype: 'json',
        data: { sClassId: $('#ClassList').val(), sCoursId: courseID },
        success: function (data)
        {
            if (data.Message != null && data.Message != '')
            {
                swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            } else
            {
                $('#dvCIAbind').append(data);
                $("#ciaMarkList").DataTable({ "bPaginate": false });
                $('.btnPrint').removeClass('hidden');
                $('.btnExport').removeClass('hidden');
                $('#lblClass').text($('#ClassList Option:selected').text());
            }
        }, error: function (error)
        {
            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
        }
    });
}


    function printDiv(divName) {
        
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;

        loadContent('/Examination/InstantStudentForSubjectStaff');
    }
    
    function Export() {
    var title = "Instant Student List";

    const table = document.getElementById('dvCIAbind').querySelector('table');
    const workbook = XLSX.utils.table_to_book(table);

    XLSX.writeFile(workbook, title + '.xlsx');

        loadContent('/Examination/InstantStudentForSubjectStaff');
}
</script>

