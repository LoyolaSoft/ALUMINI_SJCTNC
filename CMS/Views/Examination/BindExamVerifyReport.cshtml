

@model CMS.ViewModel.ViewModel.FeeTransactionViewModel


<div class="form-group table-responsive">
    @{ int count = 0;}
    <table class="table table-hover table-bordered" id="tblStudentList">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Status Update</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liExamRegistration != null)
            {
                foreach (var item in Model.liExamRegistration)
                {
                    <tr id="@item.STUDENT_ID">
                        <td>@{count++;} @count</td>
                        <td>@item.ROLL_NO</td>
                        <td>@item.FIRST_NAME</td>
                        <td>@item.CLASS_NAME</td>
                        <td>
                            @if (item.IS_VIRIFIED == "1")
                            {
                                <i class="fa fa-check text-success" onclick="UpdateVerifyStatus(@item.STUDENT_ID,@item.EXAM_SETTING_ID,'0',@item.ACADEMIC_YEAR);"></i>

                            }
                            else
                            {
                                <i class="fa fa-close text-danger" onclick="UpdateVerifyStatus(@item.STUDENT_ID,@item.EXAM_SETTING_ID,'1',@item.ACADEMIC_YEAR);"></i>

                            }
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>

