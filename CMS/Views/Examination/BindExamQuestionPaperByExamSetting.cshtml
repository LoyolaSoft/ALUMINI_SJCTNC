@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int count = 0;
    int maxcount = 0;
    int remaincount = 0;
}
<div class="col-md-12" id="dvValidate" data-parsley-validate="true">
    @if (Model.liExamDeptQuestionSetting != null && Model.liExamDeptQuestionSetting.Count > 0)
    {
        if (Model.liExamQuestionPaper != null && Model.liExamQuestionPaper.Count > 0)
        {
            maxcount = Model.liExamQuestionPaper.Count();
            foreach (var item in Model.liExamQuestionPaper)
            {
                count++;
            <div class="form-group">
                <label class="control-label col-md-1">@count.</label>
                <div class="col-md-11">
                    <select class="selectpicker form-control questions" data-live-search="true" data-parsley-required ="true">
                        @foreach (SelectListItem option in Model.Questions)
                        {
                            <option value="@option.Value"  questionpaperid="@item.QUESTION_PAPER_ID" @(option.Value ==item.QUESTION_ID? "selected='selected'" : "")>@option.Text</option>

                        }
                    </select>

                </div>
            </div>

            }
            remaincount = maxcount - (Convert.ToInt32(Model.liExamDeptQuestionSetting.FirstOrDefault().MAX_QUESTION.ToString()));
            for (int i = maxcount; i < remaincount; i++)
            {
                <div class="form-group">
                    <label class="control-label col-md-1">@i.</label>
                    <div class="col-md-11">
                        @Html.DropDownListFor(m => m.Questions, (Model.Questions != null) ? Model.Questions : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm questions", @questionpaperid="", @data_live_search = "true", @data_parsley_required = "true" })
                        @Html.ValidationMessageFor(m => m.Questions, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
        }
        else
        {
            for (int i = 1; i <= (Convert.ToInt32(Model.liExamDeptQuestionSetting.FirstOrDefault().MAX_QUESTION)); i++)
            {
                <div class="form-group">
                    <label class="control-label col-md-1">@i.</label>
                    <div class="col-md-11">
                        @Html.DropDownListFor(m => m.Questions, (Model.Questions != null) ? Model.Questions : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm questions", @questionpaperid = "", @data_live_search = "true", @data_parsley_required = "true" })
                        @Html.ValidationMessageFor(m => m.Questions, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
        }
    }
</div>