@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ExternalEvaluationStudentbyBundles";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ExternalEvaluationStudent</li>
    </ol>
    <h1 class="page-header">ExternalEvaluationStudent</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">ExternalEvaluationStudent</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSetting, "Exam", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Evaluation, "Evaluation", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Evaluation, (Model.Evaluation != null) ? Model.Evaluation : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Evaluation, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.EvaluationDate, "Date", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.EvaluationDate, (Model.EvaluationDate != null) ? Model.EvaluationDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.EvaluationDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.EvaluationCourse, "Course", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.EvaluationCourse, (Model.EvaluationCourse != null) ? Model.EvaluationCourse : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.EvaluationCourse, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Evaluators, "Evalauators", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Evaluators, (Model.Evaluators != null) ? Model.Evaluators : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Evaluators, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                    </div>                  
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="dvEvalationStudentBind"></div>
                    <a href="#" class="btn btn-primary pull-right hidden" id="btnSubmit">Submit</a>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 4
    });
    //ExamType OnChange
    $('#EvaluationDate').on('change', function () {
        var vEvaluationDate = $('#EvaluationDate option:selected').text();
        var vEvaluation = $('#Evaluation').val();
        if ((vEvaluationDate != '-- Select --') && (vEvaluation != 'null')) {
            $.ajax({
                url: '@Url.Action("BindEvaluationCourseByEvaluationDateAndEvaluation", "Examination")',
                data: { sEvaluationDate: vEvaluationDate, sEvaluation: vEvaluation },
                success: function (objResult) {
                    $('#EvaluationCourse').empty();
                    $('#EvaluationCourse').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            })
        }       
    });

    $('#ExamSetting').on('change', function () {
        BindDate();
    });
    $('#Evaluation').on('change', function () {
        BindDate();
    });
    function BindDate() {
        var vExamSetting = $('#ExamSetting').val();
        var vEvaluation = $('#Evaluation').val();
        if (vExamSetting != 'null' && vEvaluation != 'null')
        {
            $.ajax({
                url: '@Url.Action("BindEvaluationDateByExamSettingAndEvaluation", "Examination")',
                data: { sExamSetting: vExamSetting, sEvaluation: vEvaluation },
                success: function (objResult) {
                    $('#EvaluationDate').empty();
                    $('#EvaluationDate').append('<option value="0">-- Select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            })
        }        
    };

    SelectOrUnselect = function () {
        if (AllchkID.checked == true) {
            $('#tblBundlesForStaff tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", true);
                });
            });
        }
        else {
            $('#tblBundlesForStaff tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", false);
                });
            });
        }
    }
    //This to Load the table
    function loadGird() {
        var vEvaluationCourse = $('#EvaluationCourse').val();
        var vEvaluation = $('#Evaluation').val();
        var vExamSetting = $('#ExamSetting').val();
        if (vEvaluationCourse != 0) {
            @*$.ajax({
                url: '@Url.Action("ListExternalEvaluationStudentbyBundles", "Examination")',
                data: { sCourseId: vEvaluationCourse },
                success: function (option) {
                    var BindEvalationStudent = $('#dvEvalationStudentBind');
                    BindEvalationStudent.empty();
                    if (option.Message != null && option.Message != '') {
                        alert(option.Message);
                    } else {
                        BindEvalationStudent.append(option);
                        $('#tblBundlesStuentAssign').DataTable({});
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });*@

            $.ajax({
                url: '@Url.Action("BindExternalEvaluationStudentbyBundles", "Examination")',
                data: { sCourseId: vEvaluationCourse, sEvaluation: vEvaluation, sExamSettingId: vExamSetting },
                success: function (option) {
                    var BindEvalationStudent = $('#dvEvalationStudentBind');
                    BindEvalationStudent.empty();
                    if (option.Message != null && option.Message != '') {
                        swal({ title: "Error", text: option.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else {
                        $('#btnSubmit').removeClass('hidden');
                        BindEvalationStudent.append(option);
                        $('#tblBundlesForStaff').DataTable({
                            "paging": false,
                            "ordering": false,
                        });
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        } else {
            $('#dvEvalationStudentBind').empty();
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    };


    $('#btnGet').on('click', function () {
        loadGird();
    });
    $('#btnSubmit').on('click', function () {
        var StudentId;
        var JsonData;
        var vEvaluators = $('#Evaluators').val();
        var vEvaluationCourse = $('#EvaluationCourse').val();
        var Search = $('input[type="search"]').val();
        if (Search != '') {
            swal({ title: "Warning !", text: 'Please Clear the Search Box !...', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        $('#tblBundlesForStaff tbody tr').each(function () {
            $(this).find('td').each(function () {
                var chkBox = $(this).find('input[type="checkbox"]');
                if (chkBox.is(':checked')) {
                    StudentId = '"' + $(this).find('input[type="checkbox"]').attr("cms-studentid") + '"';
                }
            });
        });
        if (StudentId == null) {
            swal({ title: "Error", text: "Please select the Bundles to Assign..!!", showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        swal({
            title: "Are you sure to Assign this course ?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-success",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            JsonData = '{"JSON_EVSTUDENTMARK":[';
            $('#tblBundlesForStaff tbody tr').each(function () {
                $(this).find('td').each(function () {
                    var chkBox = $(this).find('input[type="checkbox"]');
                    if (chkBox.is(':checked')) {
                        JsonData += '{"' + "EVALUATION_COURSE_SETTING_ID" + '":"' + $('#EvaluationCourse').find('option:selected').attr("cms-evCourseSettingId") + '","EXAM_BUNDLE_ID":"' + $(this).find('input[type="checkbox"]').attr("cms-bundleid") + '","EXAM_EVALUATOR_STAFF_ID":"' + $('#Evaluators').val() + '","COURSE_ID":"' + $('#EvaluationCourse').val() + '","EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '","EVALUATION":"' + $('#Evaluation').val() + '"},';
                    }
                });
            });
            JsonData = JsonData.slice(0, -1);
            JsonData +=
            ']}';
            $.ajax({
                url: "@Url.Action("SaveBundlesForEvaluators", "Examination")",
                method: "POST",
                dataType: "JSON",
                content: "application/json; charset=utf-8",
                data: { sJsonEvalauationStudent: JsonData },
                success: function (objResult) {
                    if (objResult.ErrorCode == "202") {
                        swal({ title: "Success !", text: objResult.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadGird();
                    } else {
                        swal({ title: "Error", text: objResult.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    loadGird();
                }, error: function (error) {
                    swal({ title: "Error", text: error, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }

        );
    });



    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
function () {
    $.ajax({
        url: "@Url.Action("DeletesExamBundleForStaffAssign", "Examination")",
        type: "post",
        data: { sExamBundleId: ID },
        success: function (data) {
            if (data.ErrorCode != null && data.ErrorCode == "202") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
            } else {
                if (data.Message != null && data.Message != "") {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
        }
    });
});
    };



</script>
