@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ListExternalEvaluationStudent";
    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListExternalEvaluationStudent</li>
    </ol>
    <h1 class="page-header">ListExternalEvaluationStudent</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">ListExternalEvaluationStudent</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamType, "Date", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.EvaluationDate, (Model.EvaluationDate != null) ? Model.EvaluationDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.EvaluationDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamType, "Course", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.EvaluationCourse, (Model.EvaluationCourse != null) ? Model.EvaluationCourse : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.EvaluationCourse, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Evaluators, "Evalauators", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Evaluators, (Model.Evaluators != null) ? Model.Evaluators : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Evaluators, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-12">                       
                        <div class="form-group col-md-1">
                            <a href="#" class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                        <div class="form-group col-md-2">
                            <a href="#" class="btn btn-primary pull-right" id="btnForPrint">Print Preview</a>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" class="btn btn-success pull-right disabled" id="btnPrint" onclick="printDiv('dvEvalationStudentBind')">Print</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="dvEvalationStudentBind"></div>                
                </div>
            }
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 4
    });
    $('#tblEvalStudentlist').DataTable();
    //ExamType OnChange
    $('#EvaluationDate').on('change', function () {
        var vEvaluationDate = $('#EvaluationDate option:selected').text();
        $.ajax({
            url: '@Url.Action("BindEvaluationCourseByEvaluationDate", "Examination")',
            data: { sEvalationDate: vEvaluationDate },
            success: function (objResult) {
                $('#EvaluationCourse').empty();
                $('#EvaluationCourse').append('<option value="0">-- Select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    });


    SelectOrUnselect = function () {
        if (AllchkID.checked == true) {
            $('#tblEvStudentList tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", true);
                });
            });
        }
        else {
            $('#tblEvStudentList tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", false);
                });
            });
        }
    }


    //This to Load the table
    function loadGird() {
        var vEvaluationDate = $('#EvaluationDate option:selected').text();
        var vEvaluationCourse = $('#EvaluationCourse').val();
        var vEvaluators = $('#Evaluators').val();    
        if (vEvaluationCourse != 0) {
            $.ajax({
                url: '@Url.Action("BindListExternalEvaluationStudent", "Examination")',
                data: { sEvaluationDate: vEvaluationDate, sCourseId: vEvaluationCourse, sEvaluatorId: vEvaluators },
                success: function (option) {
                    var BindEvalationStudent = $('#dvEvalationStudentBind');
                    BindEvalationStudent.empty();
                    if (option.Message != null && option.Message != '') {
                        alert(option.Message);
                    } else {
                        BindEvalationStudent.append(option);
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        } else {
            $('#dvEvalationStudentBind').empty();
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }
    function loadForPrint() {
        $('#btnPrint').removeClass('disabled');
        var vEvaluationDate = $('#EvaluationDate option:selected').text();
        var vEvaluationCourse = $('#EvaluationCourse').val();
        var vEvaluators = $('#Evaluators').val();
        if (vEvaluationCourse != 0) {
            $.ajax({
                url: '@Url.Action("PrintListExternalEvaluationStudent", "Examination")',
                data: { sEvaluationDate: vEvaluationDate, sCourseId: vEvaluationCourse, sEvaluatorId: vEvaluators },
                success: function (option) {
                    var BindEvalationStudent = $('#dvEvalationStudentBind');
                    BindEvalationStudent.empty();
                    if (option.Message != null && option.Message != '') {
                        alert(option.Message);
                    } else {
                        BindEvalationStudent.append(option);
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        } else {
            $('#dvEvalationStudentBind').empty();
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }


    $('#btnGet').on('click', function () {
        loadGird();
    });

    $('#btnForPrint').on('click', function ()
    {
        loadForPrint();
    })
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/ListExternalEvaluationStudent');
    }
    

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
function () {
    $.ajax({
        url: "@Url.Action("DeleteExternalEvaluationStudentForStaff", "Examination")",
        type: "post",
        data: { EvaluationStuMarkId: ID },
    success: function (data) {
        if (data.Message != null && data.Message != "") {
            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
            loadGird();
        }
    },
    error: function (ex) {
        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
    }
});
    });
    }
</script>
