
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{
    ViewBag.Title = "ExamSeatingInvigilator";
    Layout = null; ;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ExamSeatingInvigilator</li>
    </ol>
    <h1 class="page-header">Exam Seating Invigilator</h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Exam Seating Invigilator</h3>
        </div>
        <div class="panel-body">
            <div class="form-horizontal">
                <div class="form-group col-lg-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.AcademicYearList, "Academic Year", htmlAttributes: new { @class = "control-label col-md-5" })
                        <div class="col-md-7">
                            @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ExamType, "Exam Type", htmlAttributes: new { @class = "control-label col-md-5" })
                        <div class="col-md-7">
                            @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.ExamType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ExamSetting, "Exam Setting", htmlAttributes: new { @class = "control-label col-md-5" })
                        <div class="col-md-7">
                            @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ExamDate, "Exam Date", htmlAttributes: new { @class = "control-label col-md-5" })
                        <div class="col-md-7">
                            @Html.DropDownListFor(model => model.ExamDate, (Model.ExamDate != null) ? Model.ExamDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.ExamDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ExamSession, "Exam Session", htmlAttributes: new { @class = "control-label col-md-5" })
                        <div class="col-md-7">
                            @Html.DropDownListFor(model => model.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", })
                            @Html.ValidationMessageFor(model => model.ExamSession, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <a href="#" class="btn btn-primary" id="btnGet">Get</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-12" id="dvBindInvigilator">

            </div>           
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        Bindtable();
    }
    //FetchExamSettingAccordingExamType
    $('#ExamType').on('change', function () {
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        var vExamTyper = $('#ExamType').val();
        if (vExamTyper != "0" && vExamTyper != "2")
        {
            $.ajax({
                url: '@Url.Action("FetchCIAExamSetting", "Examination")',
                data: { sAcYear: vAcademicYear },
                success: function (objResult)
                {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            }); 

        } else if (vExamTyper != "0" && vExamTyper != "1")
        {
            $.ajax({
                url: '@Url.Action("FetchExamSettingByAcYear", "Examination")',
                data: { sAcYear: vAcademicYear },
                success: function (objResult)
                {
                    $('#ExamSetting').empty();
                    $('#ExamSetting').append('<option value="0">-- select --</option>' + objResult.sResult);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            });
        }
    });


    //ExamSetting OnChange
    $('#ExamSetting').on('change', function () {
        var vExamseatingId = $('#ExamSetting').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        $.ajax({
            url: '@Url.Action("BindExamTimetableDatesByExamSetting", "Examination")',
            data: { sAcademicYear: vAcademicYear, sExamType: vExamType, sExamsettingId: vExamseatingId },
            success: function (objResult) {
                $('#ExamDate').empty();
                $('#ExamDate').append('<option value="0">-- select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    });
    //ExamDate OnChange
    $('#ExamDate').on('change', function () {
        var vExamseatingId = $('#ExamSetting').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        var vExamDate = $('#ExamDate option:selected').text();
        $.ajax({
            url: '@Url.Action("BindExamTimetableSessionByExamDate", "Examination")',
            data: { sExamType: vExamType, sExamsettingId: vExamseatingId, sExamDate: vExamDate },
            success: function (objResult) {
                $('#ExamSession').empty();
                $('#ExamSession').append('<option value="0">-- select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    });

    //Get Clicked
    $('#btnGet').on('click', function () {
        Bindtable();
    });


    function Bindtable() {
        var vExamseatingId = $('#ExamSetting').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        var vExamDate = $('#ExamDate option:selected').text();
        var vExamSession = $('#ExamSession').val();
        $.ajax({
            url: '@Url.Action("BindExamSeatingInvigilatorByExamDateandExamSessionandExamSetting", "Examination")',
            data: { AcademicYear: vAcademicYear, sExamType: vExamType, sExamSetting: vExamseatingId, sExamDate: vExamDate, sExamSession: vExamSession },
            success: function (data) {
                var dv = $('#dvBindInvigilator');
                dv.empty();
                dv.append(data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    }

    $('#btnSubmit').click(function () {
        var vExamSetting = $('#ExamSetting').val()
        var vExamType = $('#ExamType').val();
        var vExamDate = $('#ExamDate option:selected').text();
        var vExamSession = $('#ExamSession').val();
        var vExamRoom = $('.edits').attr('cms-roomid');
        var vSTaffId = $('#ddlStaff').val();
        JsonData = '{"SEATING_INVIGILATOR_ID":"' + $('#itemid').val() + '","ROOM_ID":"' + vExamRoom + '","STAFF_ID":"' + vSTaffId + '","EXAM_DATE":"' + vExamDate + '","EXAM_SESSION_ID":"' + vExamSession + '","EXAM_SETTING_ID":"' + vExamSetting + '","EXAM_TYPE":"' + vExamType + '"}';
        $.ajax({
            url: "@Url.Action("SaveUpdateExamSeatingInvigilator", "Examination")",
            type: "POST",
            data: { sJsonData: JsonData },
            success: function (data) {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                Bindtable();

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
function () {
    $.ajax({
        url: "@Url.Action("DeleteExamSeatingInvigilator", "Examination")",
        type: "POST",
        data: { sSeatingInvigilatorId: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                Bindtable();
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }
    });
});

    }

    function FetchExtraExamInvigilators(ID) {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("BindExtraExamSeatingInvigilator", "Examination")",
                type: "post",
                data: { sSeatingInvigilatorId: ID },
                success: function (data) {
                    if (data != null) {
                        $('#dvExamExtraCourseInviglations').empty();
                        $('#dvExamExtraCourseInviglations').append(data);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }


    function FetchItemDetails(ID) {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchExamSeatingInvigilator", "Examination")",
                type: "post",
                data: { sSeatingInvigilatorId: ID },
                success: function (data) {
                    if (data != null) {
                        var sOption = '<option value="">--Select--</option>';
                        $('#txtExamDate').val(data.EXAM_DATE);
                        $('#txtExamSession').val(data.EXAM_SESSION_ID);
                        $('#txtExamRoom').val(data.ROOM_NO);
                        $('#ddlStaff').empty();
                        $('#ddlStaff').append(sOption + data.STAFF_CODE);
                        $('#ddlStaff').val(data.STAFF_ID);
                        $('#itemid').val(data.SEATING_INVIGILATOR_ID);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }




    $("table.table td.AddStaff").live("click", function () {
        $('#txtadExamDate').val($('#ExamDate option:selected').text());
        $('#txtadExamSession').val($('#ExamSession option:selected').text());
        $('#txtadExamRoom').val($(this).attr('cms-roomno'));
        $('#txtadroom').val($(this).attr('cms-roomid'));
        $('#AddExamInvigilators').modal('show');

    })

    $('#btnadSubmit').click(function () {
        var vExamSetting = $('#ExamSetting').val()
        var vExamType = $('#ExamType').val();
        var vExamDate = $('#ExamDate option:selected').text();
        var vExamSession = $('#ExamSession').val();
        var vExamRoom = $('#txtadroom').val();
        var vSTaffId = String($('#StaffList').val());
        JsonData = '{"ROOM_ID":"' + vExamRoom + '","STAFF_ID":"' + vSTaffId + '","EXAM_DATE":"' + vExamDate + '","EXAM_SESSION_ID":"' + vExamSession + '","EXAM_SETTING_ID":"' + vExamSetting + '","EXAM_TYPE":"' + vExamType + '"}';
        $.ajax({
            url: "@Url.Action("SaveUpdateExamSeatingInvigilator", "Examination")",
            type: "POST",
        data: { sJsonData: JsonData },
        success: function (data) {
            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
            Bindtable();
        },
        error: function (ex) {
            swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
        }
    });
    });



</script>






<div class="modal" id="ViewExamInvigilator">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Exam Invigilator's List</h4>
            </div>
            <div class="modal-body">
                <div id="dvExamExtraCourseInviglations"></div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="ExamTTGrouping">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Edit</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <input type="text" id="itemid" class="hidden">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Date</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" disabled id="txtExamDate" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Session</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" disabled id="txtExamSession" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Room No</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" disabled id="txtExamRoom" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Staff</label>
                                <div class="col-md-9">
                                    <select id="ddlStaff" class="selectpicker form-control input-sm" data-live-search="true">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>

<div class="modal" id="AddExamInvigilators">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body" >
                <div class="form-horizontal">
                    <div class="form-group">                    
                        <input type="text" id="txtadroom" class="hidden">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Date</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" disabled id="txtadExamDate" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Session</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" disabled id="txtadExamSession" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Room No</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" disabled id="txtadExamRoom" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Staff</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true"})
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnadSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>