@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ExamSeatingCourseWiseReport";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ExamSeating CourseWiseReport</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">ExamSeating CourseWiseReport</h1>
    <!-- end page-header -->

    <div class="panel panel-primary" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ExamSeating CourseWiseReport</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">                   
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.AcademicYearList, "Academic Year", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamType, "Exam Type", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSetting, "Exam Setting", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-lg-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamDate, "Exam Date", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamDate, (Model.ExamDate != null) ? Model.ExamDate : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ExamDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ExamSession, "Exam Session", htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-7">
                                @Html.DropDownListFor(model => model.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", })
                                @Html.ValidationMessageFor(model => model.ExamSession, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" id="btnGet" class="btn btn-primary">Get</a>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvFeeReportBind')" class="btn btn-success m-b-10">PDF</a>
                        </div>
                        <div class="form-group col-md-1">
                            <a href="#" id="btnExport" class="btn btn-success">Export</a>
                        </div>
                    </div>                   
                </div>
                <div class="col-md-12 table-responsive">
                    <div id="dvFeeReportBind"></div>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad() {
    }
    $('.selectpicker').selectpicker({
        size: 4
    });
   $('#btnGet').on('click', function () {
        loadGird();
   });
    //ExamType on Change
   function printDiv(divName) {
       var printContents = document.getElementById(divName).innerHTML;
       var originalContents = document.body.innerHTML;
       document.body.innerHTML = printContents;
       window.print();
       document.body.innerHTML = originalContents;
       loadContent('/Examination/ExamSeatingCourseWiseReport');
   }

   $('#ExamType').on('change', function () {
       var vAcademicYear = $('#AcademicYearList option:selected').text();
       var vExamType = $('#ExamType').val();
       var vExamTyper = $('#ExamType').val();
       if (vExamTyper != "0" && vExamTyper != "2") {
           $.ajax({
               url: '@Url.Action("FetchCIAExamSetting", "Examination")',
               data: { sAcademicYear: vAcademicYear },
               success: function (objResult) {
                   $('#ExamSetting').empty();
                   $('#ExamSetting').append('<option value="0">-- select --</option>' + objResult.sResult);
                   $('.selectpicker').selectpicker('refresh');
               },
               error: function (xhr, textStatus, error) {
                   alert(error + "\n");
               }
           });
       } else if (vExamTyper != "0" && vExamTyper != "1") {
           $.ajax({
               url: '@Url.Action("FetchExamSetting", "Examination")',
               data: { sAcademicYear: vAcademicYear },
               success: function (objResult) {
                   $('#ExamSetting').empty();
                   $('#ExamSetting').append('<option value="0">-- select --</option>' + objResult.sResult);
                   $('.selectpicker').selectpicker('refresh');
               },
               error: function (xhr, textStatus, error) {
                   alert(error + "\n");
               }
           });
       }
   });
    //ExamSetting On Change

     $('#ExamSetting').on('change', function () {
        var vExamseatingId = $('#ExamSetting').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        $.ajax({
            url: '@Url.Action("BindExamTimetableDatesByExamSetting", "Examination")',
            data: { sAcademicYear: vAcademicYear, sExamType: vExamType, sExamsettingId: vExamseatingId },
            success: function (objResult) {
                $('#ExamDate').empty();
                $('#ExamDate').append('<option value="0">-- select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
     });

    //ExamDate On Change
    $('#ExamDate').on('change', function () {
        var vExamseatingId = $('#ExamSetting').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        var vExamDate = $('#ExamDate option:selected').text();
        $.ajax({
            url: '@Url.Action("BindExamTimetableSessionByExamDate", "Examination")',
            data: { sExamType: vExamType, sExamsettingId: vExamseatingId, sExamDate: vExamDate },
            success: function (objResult) {
                $('#ExamSession').empty();
                $('#ExamSession').append('<option value="0">-- select --</option>' + objResult.sResult);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    });
    function loadGird() {
        $('#btnExport').addClass('hidden');
        var vExamseatingId = $('#ExamSetting').val();
        var vExamDate = $('#ExamDate option:selected').text();
        var vExamSession = $('#ExamSession').val();
        var vAcademicYear = $('#AcademicYearList option:selected').text();
        var vExamType = $('#ExamType').val();
        if (vExamseatingId != 0 && vExamDate != 0 && vExamseatingId != 0) {
            $.ajax({
                url: '@Url.Action("BindExamSeatingCourseWiseReport", "Examination")',
                data: { sAcademicYear: vAcademicYear, sExamType: vExamType, sExamsettingId: vExamseatingId, sExamDate: vExamDate, sExamSessionId: vExamSession },
                success: function (option) {
                    var dvFeeStructureBind = $('#dvFeeReportBind');
                    dvFeeStructureBind.empty();
                    if (option.Message != null && option.Message != '') {
                        alert(option.Message);
                    } else {
                        dvFeeStructureBind.append(option);
                        $('#btnExport').removeClass('hidden');
                        $('#sPrint').removeClass('hidden');
                    }
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        } else {
            $('#dvFeeReportBind').empty();
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
    }

    $("#btnExport").click(function (e) {
        var vExamDate = $('#ExamDate option:selected').text();
        var vExamSession = $('#ExamSession').val();
        let file = new Blob([$('#dvFeeReportBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download:vExamDate+"_"+vExamSession+"_"+"CourseWiseStudentCount.xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });
</script>





