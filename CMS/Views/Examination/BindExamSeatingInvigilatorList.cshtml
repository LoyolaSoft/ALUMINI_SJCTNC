@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ Layout = null; int Count = 0;}

<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>S.No</th>    
                <th>Room No</th> 
                <th>Capacity</th> 
                <th>Block</th>
                <th>Staff</th>
                <th>Department</th>                         
            </tr>
        </thead>
        <tbody>
            @if (Model.liExamSeatingInvigilator != null && Model.liExamSeatingInvigilator.Count > 0)
            {
                foreach (var item in Model.liExamSeatingInvigilator)
                {
                    <tr>
                        <td>@{Count++;}@Count</td>                        
                        <td>@item.ROOM_NO</td>
                        <td>@item.EXAM_CAPACITY</td>
                        <td>@item.BLOCK_NAME</td>
                        <td>@item.FIRST_NAME - @item.STAFF_CODE</td>
                        <td>@item.DEPARTMENT - @item.SHIFT</td>                     
                    </tr>
                }

            }
        </tbody>
    </table>
</div>
