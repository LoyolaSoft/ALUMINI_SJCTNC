@model CMS.ViewModel.ViewModel.ExaminationViewModel
@if (Model.liExaminerOrder != null && Model.liExaminerOrder.Count > 0)
{
    foreach (var item in Model.liExaminerOrder)
    {
        <div style="page-break-after:always !important;page-break-inside:avoid !important;">
            <div class="form-group col-md-12">
                <div class="col-xs-3">
                    <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:115px; height:110px" />
                </div>

                <div class="form-group col-xs-9 text-center">
                    <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h4>
                    <h6 style="margin-top:-10px">
                        @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                    </h6>
                    <h5 style="margin-top:-10px">@Model.liCollegeDetails.FirstOrDefault().PLACE .</h5>
                    <h5 style="margin-top:-10px">@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY</h5>
                </div>
            </div>
            <br />
            <br /><br />
            <div class="col-md-12" style="border-bottom:dashed;margin-top:35px;">

            </div>
            <div class="col-md-12" style="font-size:16px;font-family:'Bookman Old Style';text-align:justify;padding:5px;">
                <div class="col-md-6">
                    <p>
                        E-Mail: coe@auxiliumcollege.edu.in<br />
                        Ref: AC/COE/SE Val/@DateTime.Now.ToString("MMMM") @DateTime.Now.ToString("yyyy")/@item.STAFF_ALLOTED_ID
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="pull-right">@Model.UDF1</p>
                </div>
                <div class="col-md-12">
                    <p class="pull-left">Dear &nbsp;@item.FIRST_NAME ,</p>
                    <br /><br />
                    <p style='text-align:center;text-indent:71.25pt;line-height:30px;'>Sub: Appointment as Examiner for SE @item.EXAM_NAME &ndash; Reg.</p>
                    <p style='line-height:30px;'><span style='font-family:"Bookman Old Style","serif";'>&nbsp;</span></p>
                    <p style='line-height:30px;'>This is to inform you that you are appointed as an Examiner in <strong>@item.DEPARTMENT</strong>for the valuation of the answer scripts of the Semester Examinations, @item.EXAM_NAME</p>
                    <br />
                    <p style='line-height:30px;'>You are requested to attend the meeting of the Board of Examiners convened by the Chief Examiner. Kindly contact her for the schedule.</p>
                    <br />
                    <p style='line-height:30px;'>The duties of the Examiners are to be carried out with great responsibility and accountability and consider all matters related to the valuation as confidential. Your kind cooperation is requested for the smooth and efficient conduct of the Valuation.</p>
                    <br />
                    <p style='line-height:30px;'><strong>If you have any of your relatives studying the subject you are handling, kindly inform the Controller of Examinations.</strong></p>
                    <br />
                    <p style='line-height:30px;'>If you are unable to accept the examination duty, you are requested to give the same in writing to the Controller of Examinations on or before @Model.UDF2.</p>

                </div>
                <div class="col-md-12">
                    <div class="col-md-6"></div>
                    <div class="col-md-6"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-4"><span class="pull-left">Date : @Model.UDF1</span></div>
                    <div class="col-md-4"></div>
                    <div style="text-align:end" class="col-md-4">Yours sincerely,</div>

                    <div class="col-md-4"></div>
                    <div class="col-md-4"></div>
                    <div style="text-align:end" class="col-md-4"><img src="~/Content/hcc_img/COE2024.png" width="100px" /></div>

                    <div class="col-md-4"><span class="pull-left">Place : Cuddalore</span></div>
                    <div class="col-md-4"></div>
                    <div style="text-align: end; margin-left: -38px;" class="col-md-4">
                        <b>
                            @if (Model.liSignatories.Count > 0 && Model.liSignatories.Count > 0)
                            {
                                var coe = Model.liSignatories.Where(o => o.ROLE_ID == "12").ToList();
                                @coe.FirstOrDefault().SIGNATORIES_NAME
                            }
                            else
                            {

                            }
                        </b>
                    </div>
                </div>

            </div>
        </div>
    }

}
else
{
    <div class="bg-danger" style="text-align:center;"> No Record Found..!</div>
}
