<script>
    var Count = 0;
    var sQuestionType = '';
    var sOptionCode = [];

    function ContentLoad() {
        // Document Ready Function .
        $('#tblMatchTheFollowing').DataTable();
        var liMessage = $('#hdErrorMessage').val();
        if (liMessage != null && liMessage != '') {
            alert(liMessage);
        }        
        handleSummernote();
        $('#TxtTitle').summernote({
            height: 400,                 // set editor height
            minHeight: 400,             // set minimum height of editor
            maxHeight: 400,          // set maximum height of editor
            focus: true                  // set focus to editable area after initializing summernote
        });
    }

    handleSummernote = function () {
        $(".summernote").summernote({
            placeholder: "Add Your Option"           
        })        
    }
   // $('.note-editable').css("height", "882");

    function DeleteSummerNoteHeader() {

        $('#dvOptions3').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions2').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions1').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });


        //$('#divQuestion').find(".note-toolbar").remove();
        //$('#divQuestion').find(".note-editing-area").css("border", "1px solid");
    }



    function FetchMathTheFollowingById(QUIZ_ID, e, QuestionTypeId, sMark) {
        sOptionCode = [];
        var Option = '';
        var Option2 = '';
        var Question = $(e).attr("cms-question");
        sQuestionType = QuestionTypeId;
        $('#hdQuizId').val(QUIZ_ID);
        $.ajax({
            url: "@Url.Action("FetchMatchTheFollowingByQuizId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sQuizId: QUIZ_ID, sQuestionTypeId: QuestionTypeId },
            success: function (data) {
                if (data.sErrorMessage != null && data.sErroeMessage != '') {
                    alert(data.sErroeMessage);
                } else {
                    //$('#Mark').addClass('hidden');
                    $("#dvOptions1").empty();
                    $("#dvOptions2").empty();
                    $("#dvOptions3").empty();
                    $('#txtMark').val(sMark);
                    var sSummerObject =
                    [{
                        summerval: "",
                        elementid: ""
                    }];

                    var sAnswerCode = "";

                    if (QuestionTypeId == "3") {
                        $('#dvMathTheFollowing').removeClass('hidden');
                        $('#dvOtherType').addClass('hidden');

                        // $('#Mark').removeClass('hidden');
                        // Match The Following ...
                        $.each(data, function (i, Quiz) {
                            //alert(data[i].QUESTION);
                            var j = i;
                            j++;
                            Option += '<div class="form-group" id="Qustion_' + i + '">';
                            Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
                            Option += '<div class="col-md-9">';

                            //decodeURIComponent(escape(window.atob(data[i].QUESTION)))
                            Option += '<input type="text" value="" cms-OptionId="' + Quiz.OPTION_ID + '" id="Qustions' + i + '" class="summernote form-control" placeholder="Enter Your Questions" maxlength="145">';
                            sSummerObject.push({ summerval: decodeURIComponent(escape(window.atob(data[i].QUESTION))), elementid: "Qustions" + i });
                            Option += '</div>';
                            Option += '</div>';
                            Option2 += '<div class="form-group" id="Option_' + i + '">';
                            Option2 += '<div class="col-md-12">';
                            //decodeURIComponent(escape(window.atob(data[i].ANSWER)))
                            Option2 += '<input type="text" value="" id="Option' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
                            sSummerObject.push({ summerval: decodeURIComponent(escape(window.atob(data[i].ANSWER))), elementid: "Option" + i });
                            Option2 += '</div>';
                            Option2 += '</div>';
                            Count = i;
                        });
                        $("#dvOptions1").append(Option);
                        $("#dvOptions2").append(Option2);
                        $('#Answer').addClass('hidden');
                    } else {
                        $('#dvMathTheFollowing').addClass('hidden');
                        $('#dvOtherType').removeClass('hidden');

                        // Objective Type && Fill In The Blank Quiz ...
                        $.each(data, function (i, Quiz) {

                            sOptionCode.push(Quiz.OPTION);

                            if (Quiz.ANSWER != null && Quiz.ANSWER != '') {
                                //$('#divAnswer').find(".note-toolbar").remove();
                                //$('#divAnswer').find(".note-editing-area").css("border", "1px solid");
                                //$('#divAnswer').find(".note-statusbar").remove();
                                //$('#divAnswer').find(".note-editable").html("");
                                //$('#divAnswer').find(".note-editable").css("height", "50px");

                                //alert(Quiz.ANSWER);
                                // var sHtmlStr = decodeURIComponent(escape(window.atob(Quiz.ANSWER)));
                                var AnswerOption = "";
                                if (Quiz.ANSWER == Quiz.OPTION) {
                                    sAnswerCode = Quiz.OPTION;
                                }


                            }
                            var j = i;
                            j++;
                            Option += '<div class="form-group" id="Qustion_' + i + '">';
                            Option += '<label class ="col-md-2 control-label">' + j + ' .)</label>';
                            Option += '<div class="col-md-10">';
                            //decodeURIComponent(escape(window.atob(data[i].OPTION)))
                            Option += '<input type="text" value="" cms-OptionId="' + Quiz.OPTION_ID + '" id="Option' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';

                            sSummerObject.push({ summerval: decodeURIComponent(escape(window.atob(data[i].OPTION))), elementid: "Option" + i });

                            //  sSummerObject[0].elementid = "Option" + i;


                            Option += '</div>';
                            Option += '</div>';
                            //Option2 += '<div class="form-group" id="Option_' + i + '">';
                            //Option2 += '<div class="col-md-9">';
                            //Option2 += '<input type="number" value="' + Quiz.MARK + '" id="Mark' + i + '" class="form-control" placeholder="Enter Your Mark">';
                            //Option2 += '</div>';
                            //Option2 += '</div>';
                            Count = i;

                        });
                        $('#Answer').removeClass('hidden');
                        $("#dvOptions3").append(Option);
                    }
                    $("#TxtTitle").summernote('code', decodeURIComponent(escape(window.atob(Question))));
                    handleSummernote();
                    DeleteSummerNoteHeader();

                    AddSummerNoteValues(sSummerObject);


                    $('#txtAnswer').val(GetOptionIndexFromOption(sAnswerCode));

                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }

    function GetOptionIndexFromOption(sAnswerCode) {

        var optionIndex;
        if (sAnswerCode != "" && sAnswerCode != null) {

            for (var i = 0; i < sOptionCode.length; i++) {

                if (sOptionCode[i] == sAnswerCode) {

                    optionIndex = parseInt(i) + 1;
                }
            }
        }

        return optionIndex;
    }

    function AddSummerNoteValues(sSummerObject) {


        for (var i = 1; i < sSummerObject.length; i++) {

            $("#" + sSummerObject[i].elementid + "").summernote('code', sSummerObject[i].summerval);
        }
    }




    function AddTextBox() {
        Count++;
        var i = Count;
        var j = Count + 1;
        if (j > 10) {
            alert('Invalid Option .! Maximum Option is 10 .');
            Count--;
            return false;
        }
        // alert(sQuestionType);

        if (sQuestionType == "3") {
            // Bind Match The Following Type Empty Text Box ....
            var Option = '';
            Option += '<div class="form-group" id="Qustion_' + i + '">';
            Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
            Option += '<div class="col-md-9">';
            Option += '<input type="text" value="" id="Qustions' + i + '" cms-OptionId="" class="summernote form-control" placeholder="Enter Your Questions"  maxlength="145">';
            Option += '</div>';
            Option += '</div>';
            $('#dvOptions1').append(Option);

            var Option2 = '';
            Option2 += '<div class="form-group" id="Option_' + i + '">';
            Option2 += '<div class="col-md-12">';
            Option2 += '<input type="text" value="" id="Option' + i + '" class="summernote form-control" placeholder="Enter Your Options"  maxlength="145">';
            Option2 += '</div>';
            Option2 += '</div>';
            $('#dvOptions2').append(Option2);
        } else {
            // Bind Objective Type && Fill In The Blank Empty Text Box ...
            var Option = '';
            Option += '<div class="form-group" id="Qustion_' + i + '">';
            Option += '<label class = "control-label col-md-2">' + j + ' .)</label>';
            Option += '<div class="col-md-10">';
            Option += '<input type="text" value="" id="Option' + i + '" cms-OptionId="" class="summernote form-control" placeholder="Enter Your Options"  maxlength="145">';
            Option += '</div>';
            Option += '</div>';
            $('#dvOptions3').append(Option);

            //var Option2 = '';
            //Option2 += '<div class="form-group" id="Option_' + i + '">';
            //Option2 += '<div class="col-md-9">';
            //Option2 += '<input type="number" value="" id="Mark' + i + '" class="form-control" placeholder="Enter Your Marks">';
            //Option2 += '</div>';
            //Option2 += '</div>';
            //$('#dvOptions2').append(Option2);
        }

        handleSummernote();
        DeleteSummerNoteHeader();

    }


    $("#btnSubmit").on("click", function () {
        // alert('Class :' + $("#ClassList").val() + 'Course :' + $("#CourseList").val() + 'Batch :' + $("#Batch").val());

        var Endvalue = Count;


        var SummerNote1 = $("#TxtTitle").summernote('code');
        var str1 = btoa(unescape(encodeURIComponent(SummerNote1)));
        var Question = str1;



        var QuizId = $('#hdQuizId').val();
        var ClassId = $("#ClassList").val();
        var CourseId = $("#CourseList").val();
        var QuestionId = $("#QuestionId").val();
        var SetId = $('#Batch').val();

        //var SummerNote2 = $("#txtAnswer").summernote('code');
        //var str2 = btoa(unescape(encodeURIComponent(SummerNote2)));
        //var Answer = str2;




        var ArrayOption = '';
        var nCount = 0;
        ArrayOption = '{"liMF_Option":[';
        for (var i = 0; i <= Endvalue; i++) {
            if (sQuestionType == "3") {
                if ($("#Option" + i).summernote('code') && $("#Qustions" + i).summernote('code')) {
                    var SummerNote3 = $("#Option" + i).summernote('code');
                    var str3 = btoa(unescape(encodeURIComponent(SummerNote3)));

                    var SummerNote4 = $("#Qustions" + i).summernote('code');
                    var str4 = btoa(unescape(encodeURIComponent(SummerNote4)));


                    ArrayOption += '{"QUESTION":"' + str4 + '","ANSWER":"' + str3 + '","OPTION_ID":"' + $("#Qustions" + i).attr('cms-OptionId') + '"},';
                    nCount++;
                } else {
                    alert('All the Options Must to Fill ..!');
                    return false;
                    break;
                }
            } else {
                if ($("#Option" + i).summernote('code')) {
                    var SummerNote5 = $("#Option" + i).summernote('code');
                    var str5 = btoa(unescape(encodeURIComponent(SummerNote5)));

                    ArrayOption += '{"OPTION_ID":"' + $("#Option" + i).attr('cms-OptionId') + '","OPTION":"' + str5 + '"},';
                    nCount++;
                } else {
                    alert('All the Options Must to Fill ..!');
                    return false;
                    break;
                }
            }

        }
        if (nCount != 0) {
            ArrayOption = ArrayOption.slice(0, -1);
            ArrayOption += ']}';
        } else {
            alert('Something is went wrong . please check your code !');
            return false;
        }

        var Answer = "";
        if (sQuestionType == "1" || sQuestionType == "2") {
            var Answercode = GetOptionCodeForAnswer($("#txtAnswer").val());
            if (Answercode != null && Answercode != "" && Answercode != "W29iamVjdCBPYmplY3Rd") {
                Answer = Answercode;
            }
            else {
                alert('Your Answer Not Valuable ! Please Check You Input !');
                return false;
            }
        }


        var JsonData;
        JsonData = '{"QUESTION":"' + Question + '","QUIZ_ID":"' + QuizId + '","QUESTION_TYPE":"' + sQuestionType + '","ANSWER_ID":"' + Answer + '","MARK":"' + $('#txtMark').val() + '"}';
        if (!$('#txtMark').val() || $('#txtMark').val() == '0') {
            alert('Please Enter Mark To Continue !');
            return false;
        }

        $.ajax({
            url: "@Url.Action("UpdateMathTheFollowingQuiz", "Examination")",
            method: "POST",
            datatype: "json",
            data: { QuizQuestion: JsonData, sSaveMatchTheFollowing: ArrayOption },
            success: function (data) {
                alert(data.Message);
                loadContent('/Examination/ListMatchTheFollowing');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    });



    function GetConfirm(QuizId, QuestionType) {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        }
        else {
            $.ajax({
                url: "@Url.Action("DeleteMatchTheFollowing", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sQuizId: QuizId, sQuestionType: QuestionType },
                success: function (data) {
                    alert(data.Message);
                    loadContent('/Examination/ListMatchTheFollowing');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    }
