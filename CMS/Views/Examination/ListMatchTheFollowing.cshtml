                                                                    <td>@(new HtmlString(Model.GetStrigFromBase64String(item.QUESTION)))</td>
                                                                    <td>@item.SET_ID</td>
                                                                    <td>@item.SEMESTER_NAME</td>
                                                                    <td>
                                                                        <a href="#MatchTheFollowing-dialog" id="qi_@item.QUIZ_ID" cms-question="@item.QUESTION" onclick="FetchMathTheFollowingById('@item.QUIZ_ID',this,'@item.QUESTION_TYPE_ID','@item.MARK')" data-toggle="modal"><i class="fa fa-edit"></i></a>
