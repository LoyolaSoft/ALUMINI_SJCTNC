@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{Layout = null; }
@if (Model.liEXAM_EVALUATION_STUDENT_MARK != null && Model.liEXAM_EVALUATION_STUDENT_MARK.Count > 0)
{
    int counts = Model.liEXAM_EVALUATION_STUDENT_MARK.Count();
    int OuterTableCount = (counts / 40) + ((counts % 40) != 0 ? 1 : 0);
    int runningcount = 0;
    <div id="dvCourseWiseReport" style="page-break-after:always !important;">
        <div class="col-md-12">
            <center>
                <h4>HOLY CROSS COLLEGE (AUTONOMOUS)</h4>
                <h6><i>Affliated to Bharathidasan University</i></h6>
                <h6>TIRUCHIRAPPALLI - 620 002</h6>
            </center>
        </div>
        <div class="col-md-12">
            <table align="center" style="width:100%;">
                <tr>
                    <td style="width:60%"><b>Exam</b> : &nbsp;</td>
                    <td style="width:40%" align="left"><b>Exam Month</b> : &nbsp;@Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().M_EXAM</td>
                </tr>
                <tr>
                    <td style="width:60%"><b>CourseCode</b> : &nbsp;@Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().COURSE_CODE</td>
                    <td style="width:40%" align="left"><b>Semester</b> : &nbsp;</td>
                </tr>
                <tr>
                    <td style="width:60%"><b>Title</b>: &nbsp;@Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().COURSE_TITLE </td>
                    <td style="width:40%" align="left"><b>Max.Mark</b> : &nbsp;@Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().EXAM_MARK</td>
                </tr>
                <tr>
                    <td style="width:60%"><b>Name of the Examiner</b>: &nbsp;@Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().NAME </td>
                    <td style="width:40%" align="left"><b> Examiner Phone</b> : &nbsp;@Model.liEXAM_EVALUATION_STUDENT_MARK.FirstOrDefault().PHONE </td>
                </tr>
            </table>
        </div>
        <table>
            @for (int i = 0; i < OuterTableCount; i++)
            {
                if (runningcount <= counts)
                {
                    <tr>
                        <td>
                            @if (runningcount <= counts)
                            {
                                <table align="left" style="width:95%; table-layout:fixed;" border="1">
                                    <tr>
                                        <th width="50% !important" style="padding:7px;">Register No</th>
                                        <th width="35% !important" style="padding:7px;">Mark</th>
                                    </tr>
                                    @{
                                        var list1 = Model.liEXAM_EVALUATION_STUDENT_MARK.Skip(runningcount).Take(20).ToList();
                                    }
                                    @foreach (var item in list1)
                                    {
                                        <tr>
                                            <td width="50% !important" style="padding:7px;">@item.REGISTER_NO</td>
                                            <td width="35% !important" style="padding:7px;">&nbsp;</td>
                                        </tr>

                                    }
                                    @{runningcount += 20;}
                                </table>
                                        }

                        </td>
                        <td>
                            @if (runningcount <= counts)
                            {
                                <table align="left" style="width:95%; table-layout:fixed;" border="1">
                                    <tr>
                                        <th width="50% !important" style="padding:7px;">Register No</th>
                                        <th width="35% !important" style="padding:7px;">Mark</th>
                                    </tr>
                                    @{
                                        var list2 = Model.liEXAM_EVALUATION_STUDENT_MARK.Skip(runningcount).Take(20).ToList();
                                    }
                                    @foreach (var item in list2)
                                    {
                                        <tr>
                                            <td width="50% !important" style="padding:7px;">@item.REGISTER_NO</td>
                                            <td width="35% !important" style="padding:7px;">&nbsp;</td>
                                        </tr>

                                    }
                                    @{runningcount += 20;}
                                </table>
                                        }

                        </td>
                    </tr>
                                            }

                                        }
        </table>
        <div class="col-md-12">
            <table>
                <tr>
                    <td style="width:50%">&nbsp;&nbsp;&nbsp;</td>
                    <td style="width:30%" align="left">&nbsp;&nbsp;&nbsp;</td>
                </tr>
                <tr>
                    <td style="width:50%">&nbsp;&nbsp;&nbsp;</td>
                    <td style="width:30%" align="left">&nbsp;&nbsp;&nbsp;</td>
                </tr>
                <tr>
                    <td style="width:50%"><b>Signature of the Chairman</b></td>
                    <td style="width:30%" align="left"><b><i>signature of Examiner with Date</i></b></td>
                </tr>
            </table>
        </div>

    </div>
                                        }