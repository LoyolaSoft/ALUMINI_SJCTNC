@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}

 
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Arrear Exam Answer Sheet</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Arrear Exam Answer Sheet<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Arrear Exam Answer Sheet</h4>
                </div>
                <div class="panel-body">
                    <div class="col-md-12 form-horizontal">
                        <div class="col-md-5 form-group">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                       <div id="dvBind"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad()
    {
        // Document Ready Function ...
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }

    $("#CourseList").on("change", function ()
    {
        if ($("#CourseList").val() != 0)
        {
            $.ajax({
                url: "@Url.Action("BindArrearExamAnswerDownload", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sCourseId: $("#CourseList").val() },
                success: function (data)
                {
                    $('#dvBind').empty().append(data);
                    $('#btnQuestion').attr("href", "http://erp.sjctnc.in/Content/Questions/" + $("#CourseList Option:selected").text() + ".pdf");
                }, error: function (error)
                {
                    alert('Internal Server Error .!');
                }
            });
    }
    });
</script>
