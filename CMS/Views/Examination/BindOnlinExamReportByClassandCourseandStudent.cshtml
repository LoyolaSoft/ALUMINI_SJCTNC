@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility
@{    
    Layout = null;
}
<style>
    .hr {
        border-top: 1px solid red;
    }
</style>
<div class="invoice" style="">
    @if (Model.liOnlinExamReportFields != null && Model.liStudentPersonalInfo != null)
    {

        @*<div class="col-md-1 pull-right">
                <button class="btn btn-success" onclick="printDiv('divBind')" id="btnPrint"> Print </button>
            </div>*@

        foreach (var item in Model.liStudentPersonalInfo)
        {

            var count = 0;
            var liItem = Model.liOnlinExamReportFields.Where(x => x.STUDENT_ID == item.STUDENT_ID).ToList();
            if (liItem != null && liItem.Count > 0)
            {

            <div class="form-group col-md-12">
                <div class="col-xs-2">
                    <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:150px; height:150px" />
                </div>

                <div class="form-group col-xs-8 text-center">
                    <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME </h4>
                    <h5>
                        @Model.liCollegeDetails.FirstOrDefault().UNIVERSITY <br />
                        @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                        College with Potential for Excellence<br />
                        @Model.liCollegeDetails.FirstOrDefault().PLACE.<br />
                        ONLINE EXAM REPORT FOR  (@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                            { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } })
                    </h5>
                </div>

                    <div class="form-group col-xs-2 pull-left">
                        @{
                            if (item.PHOTO != null && !string.IsNullOrEmpty(item.PHOTO))
                            {
                                <img src="@item.PHOTO" alt="Photo" style="width:150px; height:150px" />
                            }
                            else
                            {
                                <div src="" style="border:2px solid gray;width:100px; height:130px;"><p style="text-align:center;">AFFIX HERE YOUR PASSPORT SIZE PHOTOGRAPH TAKEN WITHIN A PERIOD OF THREE MONTHS</p></div>
                            }
                        }
                    </div>

                </div>
                <div class="col-md-12">
                    <div class="form-group col-xs-4">
                        <label> Name :@Html.Label(item.FIRST_NAME, new { @class = "", @id = "dName" })</label>
                    </div>
                    <div class="form-group col-xs-4">
                        <label> Roll No : @Html.Label(item.ROLL_NO, new { @class = "", @id = "dRollno" })</label>
                    </div>
                    <div class="form-group col-xs-4">
                        @*<img src="@item.PHOTO" alt="Photo" style="width:150px; height:150px" />*@
                        <label> Register No : @Html.Label(item.REGISTER_NO, new { @class = "", @id = "dRollno" })</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-xs-4">

                    </div>
                    <div class="form-group col-xs-4">
                        <label> Class : @Model.Class</label>
                    </div>
                    <div class="form-group col-xs-4">
                        <label> Course : @Model.Course</label>
                    </div>
                </div>
                @*<div class="col-lg-12 form-group row">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <img src="@item.PHOTO" width="100"  alt="student image" id="imgStudent" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Roll No:</span></strong><br />
                                        </div>
                                    </div>
                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Reg No:</span></strong><br />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Name:</span> </strong><br />
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Class:</span></strong> <br /><label></label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Course:</span></strong><br /><label></label>

                                        </div>
                                    </div>

                    </div>*@
                foreach (var subitem in liItem)
                {
                    count += 1;
                    <div class="col-md-12">

                        <div class="form-group">
                            <div class="">
                                <p><strong style="color:black;">@count.@subitem.QUESTION</strong></p>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="table-responsive col-md-12">

                                @(new HtmlString(subitem.ANSWER))

                            </div>
                        </div>
                    </div>
                    <hr>
                }
            }
        }
    }

    else
    {
        <div class="alert alert-danger">No Record(s) Found !</div>

    }


</div>