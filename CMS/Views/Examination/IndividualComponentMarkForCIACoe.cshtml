                                        @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null)? Model.ClassList:Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                                    }*@
                                <select class="form-control  selectpicker" id="ClassList" data-live-search="true">
                                    <option value=""> -- Select -- </option>
                                    @if (Model.liClassList != null && Model.liClassList.Count > 0)
                                    {
                                        foreach (var item in Model.liClassList)
                                        {
                                            <option value="@item.CLASS_ID">
                                                @*@if (!string.IsNullOrEmpty(item.CIA_DISABLE)){@item.CLASS_NAME <i class="fa fa-ban pull-right"></i>}
                                                    else { @item.CLASS_NAME}*@
                                                @item.CLASS_NAME
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3" data-step="2" data-intro="Choose Course">
                            @Html.Label("Course", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        @*<div class="col-md-4" data-step="2" data-intro="Choose Course">
                            @Html.Label("Component", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ComponentList, (Model.ComponentList != null) ? Model.ComponentList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control  selectpicker", @data_live_search = "true", @data_actions_box = "true", @multiple = "multiple" })
                                @Html.ValidationMessageFor(m => m.ComponentList, "", new { @class = "text-danger" })
                            </div>
                        </div>*@
                        <div class="col-md-1 pull-right">
                            <a class="btn btn-primary pull-right" onclick="GetMarks()">Get</a>
                        </div>
                        <div class="col-md-1 pull-right">
                            <a class="btn btn-success pull-right hidden" id="btnPrint" onclick="printDiv('dvCIAbind')">Print</a>
                        </div>
                    </div>
                </div>


                <div id="dvCIAbind"></div>
            }

        </div>

    </div>
</div>
<!-- end #content -->
