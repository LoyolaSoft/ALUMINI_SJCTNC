    function GetMarks()
    {
        if ($('#ClassList').val() && $('#CourseList').val())
        {
            $.ajax({
                url: "@Url.Action("BindIndividualComponentMarkForCIACoe", "Examination")",
                async: false,
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val() },
                success: function (option)
                {
                    if (option.Message != null && option.Message!='')
                    {
                        alert('Session Is Expired Please Login Again !!!');
                    } else
                    {
                        $('#dvCIAbind').empty();
                        $('#dvCIAbind').append(option);
                        $('#thComponent').text($('#ComponentList Option:selected').text());
                        $('#btnPrint').removeClass('hidden');
                    }
                },
                error: function (xhr, textStatus, error)
                {
                    alert(error + "\n");
                }
            });
        } else
        {
            alert('Please Select All To Continue !');
        }
    }


    function printDiv(Divname)
    {
        //var printContents = document.getElementById(Divname).innerHTML;
        //var originalContents = document.body.innerHTML;
        //document.body.innerHTML = printContents;
        //window.print();
        //document.body.innerHTML = originalContents;
        //loadContent('/Examination/IndividualComponentMarkForCIA');

        var printContents = document.getElementById(Divname).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
    }
</script>