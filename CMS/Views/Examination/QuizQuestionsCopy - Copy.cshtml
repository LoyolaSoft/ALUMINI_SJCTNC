
@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "QuizQuestionsCopy";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />


<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Copy Quiz Questions</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Copy Quiz Questions</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Copy Quiz Questions</h4>
                </div>
                <div class="panel-body">
                    @*<div class="form-group col-md-12 pull-right">
                        <a class="btn btn-success pull-right" href="#MatchTheFollowing-dialog" data-toggle="modal"><i class="fa fa-plus"> Equation </i></a>
                    </div>*@
                    
                    <div class="form-horizontal">
                        <p><strong>From</strong></p>
                        <div class="row">   
                            <div class="col-md-3 form-group">
                                @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>

                            <div class="col-md-3 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-3 form-group">
                                @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Quiz Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.QuizSetting, (Model.QuizSetting != null) ? Model.QuizSetting : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.QuizSetting, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <br />
                    </div>

                    <div class="form-horizontal">
                        <p><strong>To</strong></p>
                        <div class="row">
                            <div class="col-md-3 form-group">
                                @Html.Label("Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" ,@id="sClassList"})
                                </div>
                            </div>

                            <div class="col-md-3 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true",@id="sCourseList" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-3 form-group">
                                @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" ,@id="sStaffList"})
                                    @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <br />
                    </div>
                    <div class="col-md-2 form-group">
                        <a class="btn btn-primary pull-right hidden" id="btnMove">Move</a>
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>


<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>

<script>

        function ContentLoad()
        {
            handleSummernote();
            // Document Ready Function .
        }
        handleSummernote = function () {
            $(".summernote").summernote({
                placeholder: "Add a Description"
            })
        }
        $('.note-editable').css("width", "882");

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

        $("#ClassList").on("change", function () {
            var Class = $("#ClassList").val();
            $.ajax({
                url: "@Url.Action("FetchCourseByClass", "TaskManagement")",
                method: "POST",
                datatype: "json",
                data: { sClassId: Class },
                success: function (data) {
                    $("#CourseList").empty();
                    $("#CourseList").append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    swal("Error", "Internal Server Error .....!", "error");
                }
            });
        });

    $("#CourseList").on("change", function () {
        var Course = $("#CourseList").val();
        var Class = $("#ClassList").val();
            $.ajax({
                url: "@Url.Action("FetchStaffByClassAndCourse", "TaskManagement")",
                method: "POST",
                datatype: "json",
                data: { sClassId: Class, sCourseId: Course },
                success: function (data) {
                $("#StaffList").empty();
                $("#StaffList").append(data.sResult);
                $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                swal("Error", "Internal Server Error .....!", "error");
                }
            });
        });


    $("#StaffList").on("change", function () {
        var StaffId = $("#StaffList").val();
        var Course = $("#CourseList").val();
        var Class = $("#ClassList").val();
        $.ajax({
            url: "@Url.Action("FetchQuizSettingByStaffid", "Examination")",
            method: "POST",
        datatype: "json",
        data: { sStaffId: StaffId, sClassId: Class, sCourseId: Course },
        success: function (data) {
            $("#QuizSetting").empty();
            $("#QuizSetting").append(data.sResult);
            $('.selectpicker').selectpicker('refresh');
        }, error: function (error) {
            swal("Error", "Internal Server Error .....!", "error");
        }
    });
    });

    $("#sClassList").on("change", function () {
        var Class = $("#sClassList").val();
        $.ajax({
            url: "@Url.Action("FetchCourseByClass", "TaskManagement")",
            method: "POST",
        datatype: "json",
        data: { sClassId: Class },
        success: function (data) {
            $("#sCourseList").empty();
            $("#sCourseList").append(data.sResult);
            $('.selectpicker').selectpicker('refresh');
        }, error: function (error) {
            swal("Error", "Internal Server Error .....!", "error");
        }
    });
    });

    $("#sCourseList").on("change", function () {
        var Course = $("#sCourseList").val();
        var Class = $("#sClassList").val();
        $.ajax({
            url: "@Url.Action("FetchStaffByClassAndCourse", "TaskManagement")",
            method: "POST",
        datatype: "json",
        data: { sClassId: Class, sCourseId: Course },
        success: function (data) {
            $("#sStaffList").empty();
            $("#sStaffList").append(data.sResult);
            $('.selectpicker').selectpicker('refresh');
        }, error: function (error) {
            swal("Error", "Internal Server Error .....!", "error");
        }
    });
    });

    $("#sStaffList").on("change", function () {
       
        if($("#sStaffList").val())
        {
            $('#btnMove').removeClass("hidden");
        }
        else {
            $('#btnMove').addClass("hidden");
        }
    });

   
    $('#btnMove').on("click", function () {
        var $btn = $(this);
        var originalHtml = $btn.html();

        if ($("#sCourseList").val() && $("#sClassList").val() && $("#sStaffList").val() && $("#QuizSetting").val())
        {
            $btn.html('<i class="fa fa-spinner fa-spin"></i> Moving...').addClass('disabled').css('pointer-events', 'none');
            $.ajax({
                url: "@Url.Action("CopyQuizQuestion", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sQuizSettingId: $("#QuizSetting").val(), sCourseId: $("#sCourseList").val(), sClassId: $("#sClassList").val(), sStaffId: $("#sStaffList").val() },
                success: function (data)
                {
                    $btn.html(originalHtml).removeClass('disabled').css('pointer-events', 'auto');
                    if (data.Message != null && data.Message != "") {
                        swal("Info", data.Message, "info");
                    }
                    else {
                        if (data.oResult != "" && data.oResult != null) {
                            swal("Success", data.oResult + " Questions were moved successfully!", "success");
                        }
                    }
                }, error: function (error)
                {
                    $btn.html(originalHtml).removeClass('disabled').css('pointer-events', 'auto');
                    swal("Error", "Internal Server Error .....!", "error");
                }
            });
        }
        else
        {
            swal("Warning", "Select all fields!", "warning");
        }
    });
</script>


    

</script>



