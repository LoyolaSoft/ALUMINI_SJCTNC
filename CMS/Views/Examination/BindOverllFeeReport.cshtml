                                                var groupFee = Model.liExamOveralFeeReport.Where(x => x.PROGRAMME_GROUP_ID == programmeId).ToList();


                                                var levelsGroup = groupFee.GroupBy(x => x.PROGRAMME_LEVEL_ID).Select(x => x.FirstOrDefault());
                                                if (levelsGroup != null)
                                                {
                                                    foreach (var level in levelsGroup)
                                                    {
                                                        if (level.PROGRAMME_LEVEL_ID != "")
                                                        {
                                                            var TotalCourseCost = Model.liExamCourseFeeReport.Where(x => x.PROGRAMME_GROUP_ID == programmeId && x.PROGRAMME_LEVEL_ID == level.PROGRAMME_LEVEL_ID).Sum(x => (x.COST != "" ? Convert.ToDouble(x.COST) : 0));
