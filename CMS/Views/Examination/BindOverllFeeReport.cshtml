                                                                var levelByOrder = groupFee.Where(x => x.PROGRAMME_LEVEL_ID == level.PROGRAMME_LEVEL_ID || x.PROGRAMME_LEVEL_ID == "").ToList();
                                                                if (levelByOrder != null)
                                                                {
                                                                    <div class="col-lg-12 table-responsive">
                                                                        <table class="table table-bordered table-hover" border="1">
                                                                            <tbody>
                                                                                @foreach (var programms in levelByOrder)
                                                                                {


                                                                                    <tr>
                                                                                        @if (!string.IsNullOrEmpty(programms.PROGRAMME_LEVEL_ID))
                                                                                        {
                                                                                            <td>@programms.MAIN_HEAD</td>
                                                                                            <td><i class="fa fa-rupee"></i> @programms.COST</td>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            if (@programms.HEAD.Contains("Examination Fees"))
                                                                                            {
                                                                                                <td>@programms.MAIN_HEAD</td>
                                                                                                <td><i class="fa fa-rupee"></i> @TotalCourseCost</td>
                                                                                            }
                                                                                        }
                                                                                    </tr>



                                                                                }
                                                                                <tr>
                                                                                    <td><b>Total</b></td>
                                                                                    <td>@{double total = levelByOrder.Sum(x => (x.COST != "" ? Convert.ToDouble(x.COST) : 0)) + TotalCourseCost;}<b><i class="fa fa-rupee"></i> @total</b></td>
                                                                                </tr>
                                                                            </tbody>

                                                                        </table>
                                                                    </div>
                                                                }

                                                             }


                                                         }
                                                       }
