@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Invigilation Process </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> Invigilation Process</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title"> Invigilation Process </h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="tab-overflow" data-parsley-validate="true" name="form-wizard">
                                <ul class="nav nav-tabs">
                                    <li class="active" id="individual"><a href="#nav_1" data-toggle="tab">Individual </a></li>
                                    <li class="" id="keyanswer"><a href="#nav_2" data-toggle="tab">Class Wise</a></li>

                                </ul>
                            </div>
                            <div class="tab-content">
                                <div class="tab-pane fade in active" id="nav_1">
                                    <div class="col-md-12">
                                        <div class="col-md-4 form-group">
                                            @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 ">
                                        <div class="col-md-4 form-group">
                                            @Html.Label("TT Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                                @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-md-2 form-group">
                                            <a class="btn btn-primary pull-right" href="javascript:;" onclick="loadShuffleStudents()"> Get </a>
                                        </div>
                                    </div>

                                    <div class="col-md-12" id="BindShuffleStudents">

                                    </div>
                                </div>
                                <div class="tab-pane fade" id="nav_2">
                                    <div class="col-md-12">
                                        <div class="col-md-4 form-group">
                                            @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true",@id="ddlacyear" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Set", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "ddlset" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "ddlsetting" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 ">
                                        <div class="col-md-4 form-group">
                                            @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "ddlcourse" })
                                                @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "ddlstaff" })
                                                @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-md-4 form-group">
                                            @Html.Label("Assign Class", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control  selectpicker show-menu-arrow show-tick", @data_live_search = "true", @id = "ddlclass", @multiple = "multiple", @data_action_box = "true" })
                                                @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <button class="btn btn-success pull-right" id="btnassgin">Assign</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<!-- Hidden Fileds-->
<input type="hidden" id="ExamDate"/>
<input type="hidden" id="StartTime"/>
<input type="hidden" id="EndTime"/>
<input type="hidden" id="TimeTableId"/>
<input type="hidden" id="TotalHours" />

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {
        // Document .Ready Function
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    $('#AcademicYearList').on('change', function () {
        $('#ExamSetting').empty();
        $.ajax({
            url: '/Examination/FetchOnlineExamSettingByAcYear',
            method: 'POST',
            datatype: 'json',
            data: { sAcYear: $('#AcademicYearList Option:selected').text() },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#ExamSetting').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#ddlacyear').on('change', function ()
    {
        $('#ddlsetting').empty();
        $.ajax({
            url: '/Examination/FetchOnlineExamSettingByAcYear',
            method: 'POST',
            datatype: 'json',
            data: { sAcYear: $('#ddlacyear Option:selected').text() },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#ddlsetting').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $('#ExamSetting').on('change', function ()
    {
       
        $('#CourseList').empty();
        $.ajax({
            url: '/Examination/FetchCourseByExamSettingId',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $("#ExamSetting option:selected").attr("exam_settingid"), sExamtype: $("#ExamSetting option:selected").attr("exam_type") },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#CourseList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $('#ddlsetting').on('change', function () {
        $('#ddlcourse').empty();
        $.ajax({
            url: '/Examination/FetchCourseByExamSettingId',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $("#ddlsetting option:selected").attr("exam_settingid"), sExamtype: $("#ddlsetting option:selected").attr("exam_type") },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    $('#ddlcourse').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
   
    $('#ddlcourse').on('change', function ()
    {
        $.ajax({
            url: '/Examination/FetchClassandTimetableInfo',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $("#ddlsetting option:selected").attr("exam_settingid"), sTimetableId: $('#ddlcourse').val(), sAcademicYear: $('#ddlacyear Option:selected').text(), sExamtype: $("#ddlsetting option:selected").attr("exam_type") },
            success: function (data)
            {
                $('#ddlclass').empty();
                $('#ddlclass').append(data.CLASS_ID);
                $('#ExamDate').append(data.EXAM_DATE);
                $('#StartTime').append(data.START_TIME);
                $('#EndTime').append(data.END_TIME);
                $('#TimeTableId').append(data.TIMETABLE_ID);
                $('#TotalHours').append(data.TOTAL_HOURS);


                $('.selectpicker').selectpicker('refresh');
              
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    function loadShuffleStudents() {
        $('#BindShuffleStudents').empty();
        $.ajax({
            url: '/Examination/BindShuffleStudentInvigilation',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $("#ExamSetting option:selected").attr("exam_settingid"), sTimetableId: $('#CourseList').val(), sAcademicYear: $('#AcademicYearList Option:selected').text(), sExamtype: $("#ExamSetting option:selected").attr("exam_type"), sOnlineExamsettingId: $('#ExamSetting').val() },
            success: function (data) {
                $('#BindShuffleStudents').append(data);
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
    $('#btnassgin').on('click', function ()
    {
        var classids=$('#ddlclass').val();
        $.ajax({
            url: '/Examination/SaveClasswiseShuffleStudentInvigilation',
            method: 'POST',
            datatype: 'json',
            data: { sExamSettingId: $('#ddlsetting').val() , sTimetableId: $('#ddlcourse').val(), sAcademicYear: $('#ddlacyear Option:selected').text(), sClass: classids.toString(), sSet: $('#ddlset').val(), sStaffId: $('#ddlstaff').val(), sExamtype: $("#ddlsetting option:selected").attr("exam_type") },
            success: function (data)
            {
                if (data.ErrorCode == "200")
                {
                    swal({ title: "Message", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                }
                else
                {
                    swal({ title: "Message", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });

                }


            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    });
</script>