@model CMS.ViewModel.ViewModel.ExaminationViewModel
@if (Model.LiExaminar != null && Model.LiExaminar.Count > 0)
{
    <div class="col-md-12 form-horizontal">
        <br /><br />
        <table id="tblStudentList" width="100%">
            <thead>
                <tr>
                    <td rowspan="6">&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO " width="200px" height="200px" /> </td>
                    <td width="70%" style="font-size:25px;font-family:'Times New Roman';"><b>ST.MARY'S COLLEGE (Autonomous)</b></td>
                </tr>
                <tr><td style="font-size:15px;font-family:'Times New Roman';padding-left:60px;">(Re-accredited with A Grade by NAAC)</td></tr>
                <tr><td style="font-size:15px;font-family:'Times New Roman';padding-left:100px;"><b>THOOTHUKUDI - 628 001</b></td></tr>
                <tr><td></td></tr>
                <tr style="height:100px;"><td><table border="1"><thead><tr><th style="font-size: 20px; font-family: 'Times New Roman'; padding-left: 80px; padding-right: 80px;"><b>ON DUTY CERTIFICATE</b></th></tr></thead></table></td></tr>
            </thead>
        </table>
        <table width="100%">
            <thead><tr><th style="padding-left: 150px; font-family:Papyrus;font-size:20px; height: 80px; "><b>Certified that the following staff member was on duty in this institution as specified below :</b></th></tr></thead>
        </table>
        <table width="100%">
            <thead>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 20px;"><p></p></th></tr>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 60px;">Name</th><th width="5%">:</th><th style="font-family:Arial;font-size:18px;">@Model.LiExaminar.FirstOrDefault().EXAMINAR</th></tr>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 60px;">Designation</th><th width="5%">:</th><th style="font-family: Arial; font-size: 18px;">@Model.LiExaminar.FirstOrDefault().DESIGNATION</th></tr>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 60px;">College</th><th width="5%">:</th><th style="font-family: Arial; font-size: 18px;">@Model.LiExaminar.FirstOrDefault().COLLEGE_NAME</th></tr>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 60px;">Programme</th><th width="5%">:</th><th style="font-family: Arial; font-size: 18px;">@Model.LiExaminar.FirstOrDefault().PROGRAMME_NAME</th></tr>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 60px;">Date</th><th width="5%">:</th><th style="font-family: Arial; font-size: 18px;">@Model.LiExaminar.FirstOrDefault().FROM_DATE</th></tr>
                <tr><th style="padding-left:150px;font-family:Papyrus;font-size:20px; width:300px;height: 60px;">Purpose</th><th width="5%">:</th><th style="font-family: Arial; font-size: 18px;">@Model.LiExaminar.FirstOrDefault().PURPOSE</th></tr>
            </thead>
        </table><table>
            <thead width="100%"><tr><th style="padding-left: 100px; font-family: Papyrus; font-size: 20px; width: 30%; padding-top: 200px;">Date</th><th style="padding-left: 200px; padding-top:200px; font-family: Papyrus; font-size: 20px; width:70%; height: 20px;">Controller of Examinations</th></tr></thead>
        </table>
    </div>
}
else
{
    <table class="table table-hover table-bordered">
        <tr>
            <td colspan="11" align="center" style="background-color:lightcoral;">No Records Found ...!</td>
        </tr>
    </table>
}