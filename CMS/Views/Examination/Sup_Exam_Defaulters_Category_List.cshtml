@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "Sup_Exam_Defaulters_Category_List";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">SupExamDefaultersCategoryList</li>
    </ol>
    <h1 class="page-header">Sup Exam Defaulters Category List </h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Sup Exam Defaulters Category List </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">

                <a class="btn btn-success pull-right form-group m-b-5" href="#Rules-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th> Category Name</th>
                            <th>Active</th>
                            <th>Action</th>

                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liSupExamDefaultersCategoryList != null && Model.liSupExamDefaultersCategoryList.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liSupExamDefaultersCategoryList)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.DEFAULT_CATEGORY_NAME</td>

                                    <td>

                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>
                                  

                                    <td>
                                        <a href="#Rules-dialog" onclick="FetchSupExamDefaultersListById(@item.DEFAULT_CATEGORY_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.DEFAULT_CATEGORY_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal" id="Rules-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                    <input type="hidden" id="DEFAULTCATEGORYID" value="" />
                                    <div class="col-md-12 form-group">
                                        @Html.Label("Category Name", htmlAttributes: new { @class = "col-md-3 control-label ", @data_parsley_required = "true" })
                                        <div class="col-md-9">
                                            <input class="form-control input-sm" type="text" id="CategoryName" required />

                                        </div>
                                    </div>
                                   
                                    <div class="col-md-4 form-group">
                                        <div class="col-md-8">
                                            <input type="checkbox" id="chIsActive" /> &nbsp; &nbsp; IsActive
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>


            </div>
        </div>

    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

<script>



    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
        //add
    });

    $('#btnSubmit').on('click', function () {
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;

        if (!isValid) {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }
                var IsActive = 0;
                if ($('#chIsActive').is(':checked')) {
                    IsActive = 1;
                }
        var sJsonData = '{"DEFAULT_CATEGORY_ID":"' + $("#DEFAULTCATEGORYID").val() + '","DEFAULT_CATEGORY_NAME":"' + $('#CategoryName').val() + '","IS_ACTIVE":"' + IsActive + '"}';
                $.ajax({
                    url: '@Url.Action("SaveSupExamDefaultersList", "Examination")',
                    method: 'POST',
                    data: { Defaulters: sJsonData },
                    success: function (data) {
                        if (data.ErrorCode != null && data.ErrorCode == "402") {
                            swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        } else {
                            swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        }

                        loadContent('/Examination/Sup_Exam_Defaulters_Category_List');
                    },
                    error: function () {
                    }
                });
            });


            //edit
    function FetchSupExamDefaultersListById(RuleId) {
                $('#pBody').parsley().destroy();

                $('#pBody').parsley().destroy();


                if (RuleId != null) {
                    $.ajax({
                        url: "/Examination/FetchSupExamDefaultersListById",
                        type: "post",
                        data: { DefaultersID: RuleId },
                        success: function (data) {
                            if (data.Message != null) {
                                alert(data.Message);
                            }
                            else {
                                if (data.oResult[0] != null) {

                                    $('#DEFAULTCATEGORYID').attr('value', data.oResult[0].DEFAULT_CATEGORY_ID);
                                    $('#CategoryName').attr('value', data.oResult[0].DEFAULT_CATEGORY_NAME);
                                    $('#chIsActive').attr('value', data.oResult[0].IS_ACTIVE);
                                    if (data.oResult[0].IS_ACTIVE == "1") {
                                        $("#chIsActive").prop("checked", true);
                                    }
                                }


                            }

                        },
                        error: function (ex) {
                            alert(ex.Message);
                        }
                    });
                }
            }


            //delete

            function GetConfirm(ID) {
                swal({
                    title: "Are you sure want to Delete..?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "btn-danger",
                    confirmButtonText: "Yes, I agree!",
                    closeOnConfirm: false
                }, function () {
                    $.ajax({
                        url: "@Url.Action("DeleteSupExamDefaultersListById", "Examination")",
                        type: "post",
                        data: { DefaultersID: ID },
                        success: function (data) {
                            if (data.ErrorCode != null && data.ErrorCode == "402") {
                                swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                            } else {
                                swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            }
                            loadContent('/Examination/Sup_Exam_Defaulters_Category_List');
                        },
                        error: function () {
                            swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        }
                    });
                });
            }


            $("#Add").on('click', function () {

                $('#DEFAULTCATEGORYID').attr('value', '');
                $('#CategoryName').attr('value', '');
                $("#chIsActive").prop("checked", false);
            })


