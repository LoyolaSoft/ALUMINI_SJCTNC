@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListSemesterMarks";
    Layout = null;// "~/Views/Shared/_AdminLayoutPage.cshtml";
}

    <link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />


<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="#">Home</a></li>
        <li><a href="#)">Semester Marks</a></li>
        <li class="active">List Semester Marks</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Semester Marks</h1>
    <!-- end page-header -->
    <div class="panel panel-primary" data-sortable-id="ui-general-1">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Semester Marks</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row m-t-5">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.AcademicYearList, "Academic Year", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.Shift, "Shift", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row m-t-5">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.Program, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Program, (Model.Program != null) ? Model.Program : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Program, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <a class="btn bg-green pull-right" title="Import File" data-toggle="modal" style="cursor:pointer" href="#ImportModal-dialog"><i class="fa fa-plus"></i> Add</a>
                    </div>
                    <div class="form-horizontal">
                        <div class="col-md-12">
                            <div id="dvBindSemesterMarks"></div>
                        </div>

                    </div>

                </div>
            }
        </div>
    </div>

</div>


    <script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script>
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('refresh');


        function ContentLoad()
        {
            // document.ready function
        }
    </script>
    <script>
        $("#AcademicYearList").on("change", function () {
            $("#Shift").val($("#Shift option:first").val());
            $("#Program").val($("#Program option:first").val());
            $("#ClassList").val($("#ClassList option:first").val());
        });
        $("#Shift").on("change", function () {
            var sShift = $("#Shift").val();
            $.ajax({
                url: "@Url.Action("GetProgramByShift", "Student")",
                method: "POST",
                datatype: "json",
                data: { sShiftId: sShift },
                success: function (data) {
                    $("#Program").empty();
                    $("#Program").append('<option value="0">-- Select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });
        $("#Program").on("change", function () {
            var ProgramName = $("#Program").val();
            var sShift = $("#Shift").val();
            var sAcademicYear = $('#AcademicYearList option:selected').text();
            $.ajax({
                url: "@Url.Action("BindDDLClass", "Student")",
                method: "POST",
                datatype: "json",
                data: { sProgramId: ProgramName, sShiftId: sShift, AcademicYear: sAcademicYear },
                success: function (data) {
                    $("#ClassList").empty();
                    $("#ClassList").append('<option value="">-- select --</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });
        $("#ClassList").on("change", function () {
            var ProgramName = $("#Program").val();
            var ClassName = $("#ClassList").val();
            var AcademicYear = $('#AcademicYearList option:selected').text();
            if (AcademicYear == '--select--' || AcademicYear == '0') {
                alert('Please Choose All The Values...!!!');
                return false;
            }
            $.ajax({
                url: "@Url.Action("BindSemesterMarks", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sClassId: ClassName, sProgramId: ProgramName, sAcademicYear: AcademicYear },
                success: function (option) {
                    var divBindSemesterMarks = $('#dvBindSemesterMarks');
                    divBindSemesterMarks.empty();
                    divBindSemesterMarks.append(option);
                    $("#SemesterMarksList").DataTable();
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        });
    </script>

<div class="modal" id="ImportModal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add User Account</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("SaveSemesterMarks", "Examination", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="form-horizontal">
                        <input type="file" name="excelfile"/>
                        <input type="submit" value="Import" />
                    </div>
                }
            </div>
            <div class="modal-footer">
                <span class="text-warning pull-left" id="txtStatic"></span>
                <button type="submit" id="btnSubmit" class="btn btn-default">Submit</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
