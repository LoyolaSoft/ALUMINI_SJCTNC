    $('#btnget').on('click', function ()
    {
        if ($('#ExamSetting').val() && $('#CourseList').val() && $('#QUESTION_LEVEL').val() && $('#Section').val())
        {
            $.ajax({
                url: '/Examination/BindExamQuestionPaperByExamSetting',
                method: 'POST',
                datatype: 'json',
                data: { sExamSettingId: $('#ExamSetting').val(), sCourseId: $('#CourseList').val(), sQuestionLevel: $('#QUESTION_LEVEL').val(), sSectionId: $('#Section').val() },
                success: function (data) {
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else
                    {
                        $('#dvBindQuestions').empty().append(data);
                        $('#btnSubmit').removeClass('hidden');
                        $('.selectpicker').selectpicker({ size: 6 });
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
   
    $('#btnSubmit').on('click', function ()
    {
        sExamSettingId=$('#ExamSetting').val();
        sCourseId= $('#CourseList').val();
        sQuestionLevel = $('#QUESTION_LEVEL').val();
        sSectionId = $('#Section').val();
        // Validation Check ,...
        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'warning', animation: true });
            return false;
        }
        var JsonData = '';
        JsonData += '{"ExamQuestionpaper":[';
        $('#dvValidate').find(".questions").each(function ()
        {
            if ($(this).val() != '')
            {
                JsonData += '{"QUESTION_PAPER_ID":"' + $(this).attr('questionpaperid') + '","COURSE_ID":"' + sCourseId + '","QUESTION_LEVEL_ID":"' + sQuestionLevel + '","QUESTION_ID":"' + $(this).val() + '","EXAM_SETTING_ID":"' + sExamSettingId + '"},';
            }
        });
        JsonData = JsonData.slice(0, -1);
        JsonData += ']}';
       
            $.ajax({
                url: '/Examination/SaveExamQuestionPaper',
                method: 'POST',
                datatype: 'json',
                data: { sJsonData: JsonData },
                success: function (data)
                {
                  
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        
    });
 
</script>