@model CMS.ViewModel.ViewModel.ExaminationViewModel
  @using CMS.Utility;
@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Online Exam Setting</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Online Exam Setting</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Online Exam Setting</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal table-responsive">
                        <div class="form-group col-md-12">
                            <a class="btn btn-success pull-right form-group m-b-5" href="#Setting-dialog" data-toggle="modal"><i class="fa fa-plus" title="Add">Add</i></a>
                        </div>
                        <table class="table table-hover table-bordered" id="tblonlinesettingid">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Setting Name</th>
                                    <th>Exam</th>
                                    <th>Exam Type</th>
                                    <th>Camera</th>
                                    <th>Chat</th>
                                    <th>Log</th>
                                    <th>Auto Start</th>
                                    <th>Auto Evaluate</th>
                                    <th>Active</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Listonlineexamsetting != null && Model.Listonlineexamsetting.Count > 0)
                                {
                                    int count = 0;
                                    foreach (var item in Model.Listonlineexamsetting)
                                    {
                                        <tr>
                                            <td>@{count++;} @count</td>
                                            <td>@item.SETTING_NAME</td>
                                            <td>@item.EXAM_NAME</td>
                                            <td>@item.EXAM_TYPE</td>
                                            @if (@item.IS_NEED_CAMERA == "1")
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_NEED_CAMERA','0');" title=""><i class="fa fa-check text-success"></i></a></td>
                                            }
                                            else
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_NEED_CAMERA','1');" title=""><i class="fa fa-close text-danger"></i></a></td>
                                            }
                                            @if (@item.IS_NEED_CHAT == "1")
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_NEED_CHAT','0');" title=""><i class="fa fa-check text-success"></i></a></td>

                                            }
                                            else
                                            {
                                                <td><a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_NEED_CHAT','1');" title=""><i class="fa fa-close text-danger"></i></a></td>
                                            }
                                            @if (@item.IS_NEED_LOG == "1")
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_NEED_LOG','0');" title=""><i class="fa fa-check text-success"></i></a></td>

                                            }
                                            else
                                            {
                                                <td><a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_NEED_LOG','1');" title=""><i class="fa fa-close text-danger"></i></a></td>
                                            }
                                            @if (@item.IS_AUTO_START == "1")
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_AUTO_START','0');" title=""><i class="fa fa-check text-success"></i></a></td>

                                            }
                                            else
                                            {
                                                <td><a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_AUTO_START','1');" title=""><i class="fa fa-close text-danger"></i></a></td>
                                            }
                                            
                                            @if (@item.IS_AUTO_EVALUATION == "1")
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_AUTO_EVALUATION','0');" title=""><i class="fa fa-check text-success"></i></a></td>

                                            }
                                            else
                                            {
                                                <td><a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_AUTO_EVALUATION','1');" title=""><i class="fa fa-close text-danger"></i></a></td>
                                            }
                                            @if (@item.IS_ACTIVE == "1")
                                            {
                                                <td> <a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_ACTIVE','0');" title=""><i class="fa fa-check text-success"></i></a></td>

                                            }
                                            else
                                            {
                                                <td><a href="#" onclick="ActivateOrDeActivate(@item.ONLINE_EXAM_SETTING_ID,'@Common.EXAM_ONLINE_EXAM_SETTING.IS_ACTIVE','1');" title=""><i class="fa fa-close text-danger"></i></a></td>
                                            }
                                            <td>
                                              
                                                    <a href="#Setting-dialog" onclick="FetchOnlineExamSettingInfo(@item.ONLINE_EXAM_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                                    <a href="javascrip:;" onclick="GetConfirm(@item.ONLINE_EXAM_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                                
                                                
                                            </td>
                                        </tr>
                                                    }

                                                }

                            </tbody>
                        </table>
                        
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>

<!-- Begin Modal -->

<div class="modal" id="Setting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit  Setting</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <input type="hidden" id="hdSettingId" />
                            <div class="col-md-12" id="dvValidate" data-parsley-validate="true">
                               
                                <!-- Setting Name-->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Setting Name</label>
                                    <div class="col-md-9">
                                        <input type="text" id="txtSettingName" class="form-control" placeholder="Enter Setting Name" data-parsley-required="true">
                                    </div>
                                </div>
                                <!-- Exam Setting -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Exam Setting</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                        @Html.ValidationMessageFor(m => m.ExamSetting, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <!-- Exam Type -->
                                <div class="col-md-12 form-group">
                                    <label class="col-md-3 control-label">Exam Setting</label>
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(m => m.ExamType, (Model.ExamType != null) ? Model.ExamType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                        @Html.ValidationMessageFor(m => m.ExamType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                               

                                                          

                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->


<input type="hidden" id="onlinexamsettingid">
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>

<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>


<script>
  
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
    $('#tblonlinesettingid').DataTable({});
    // On Submit Setting ...
    $('#btnSubmit').on('click', function ()
    {
        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            
      
            swal({ title: "Message !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            return false;
        }
        var JsonData = {};
        JsonData.ONLINE_EXAM_SETTING_ID = $('#onlinexamsettingid').val();;
        JsonData.SETTING_NAME = $('#txtSettingName').val();
        JsonData.EXAM_SETTING_ID = $('#ExamSetting').val();
        JsonData.EXAM_TYPE = $('#ExamType').val();
            $.ajax({
                url:'@Url.Action("SaveorUpdateOnlineExamSettings", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sJsonData: JSON.stringify(JsonData) },
                success: function (data)
                {
                    $('.modal-backdrop').remove();
                    if (data.ErrorCode == "202")
                    {
                       
                       swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadContent('/Examination/OnlineExamSetting');
                    }
                    else
                    {
                       
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                   
                  
                
                   
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });

    });
</script>
<script>
    // Activate and Deactive ...
    function ActivateOrDeActivate(ID,FIELD,VALUE)
    {
        swal({
            title: "Confirmation",
            text: "Are you sure Active/Deactive ?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () 
        {
            $.ajax({
                url:"@Url.Action("ActivateOrDeActivateOnlineexamSettings", "Examination")",
                method: "POST",
                datatype:"json",
                data: { sSettingid: ID, sFieldname: FIELD, sValue: VALUE },
                success:function(data)
                {
                   
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadContent('/Examination/OnlineExamSetting');
                    }
                    else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    

                },error:function(error)
                {
                    alert('Internal Server Error ! ');
                }
            });
        
        });
        

        }

    // Delete Setting ...
    function GetConfirm(ID)
    {
        swal({
            title: "Confirmation",
            text: "Are you sure Delete ?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
         function () {
             $.ajax({
                 url: "@Url.Action("DeleteExamOnlineExamSetting", "Examination")",
                 method: "POST",
                 datatype: "json",
                 data: { sSettingId: ID },
                 success: function (data) {
                     if (data.ErrorCode == "202") {
                         swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                         loadContent('/Examination/OnlineExamSetting');
                     }
                     else {
                         swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                     }
                 }, error: function (error) {
                     alert('Internal Server Error ! ');
                 }
             });
         });
    }

    // Fetch Settin Info ...
    function FetchOnlineExamSettingInfo(ID)
    {
        $.ajax({
            url:"@Url.Action("FetchOnlineExamSettingById", "Examination")",
            method: "POST",
            datatype:"json",
            data: { sSettingId: ID },
            success:function(data)
            {
                
                $('#onlinexamsettingid').val(data[0].ONLINE_EXAM_SETTING_ID);
                $('#ExamSetting').val(data[0].EXAM_SETTING_ID);
                $('#ExamType').val(data[0].EXAM_TYPE);
                $('#txtSettingName').val(data[0].SETTING_NAME);

                 $('.selectpicker').selectpicker('refresh');
                
            },error:function(error)
            {
                alert('Internal Server Error ! ');
            }
        });
    }
    //$("#Setting-dialog").on("hidden.bs.modal", function ()
    //{
    //    $('#txtSettingName').val('');
    //    $('#onlinexamsettingid').val('');
    //    $('#txtSettingName').val('');
       
    //});
    

    
</script>
