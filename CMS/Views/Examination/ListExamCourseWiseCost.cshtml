@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "ListExamCourseWiseCost";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
    int nCount = 0;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Course Wise Cost List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Course Wise Cost List<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Course Wise Cost List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        
                        <div class="col-md-12">
                            <div class="form-group col-md-12 table-responsive">
                                <div class="form-group col-md-12 pull-right">
                                    <a class="btn btn-success pull-right" onclick="loadContent('/Examination/AddOrEditExamCourseWiseCost')" title="Add Course Wise Cost"><i class="fa fa-plus"></i> Add</a>
                                </div>
                                <br />
                                <br />
                                <table class="table table-bordered table-hover" id="tblCourseWiseCost">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Course Code</th>
                                            <th>Course Title</th>
                                            <th>UGC Course Type</th>
                                            <th>Programme Level</th>
                                            @*<th>Exam Type</th>*@
                                            <th>Cost</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.liExamCourseWiseCost != null && Model.liExamCourseWiseCost.Count > 0)
                                        {
                                            foreach (var item in Model.liExamCourseWiseCost)
                                            {
                                                <tr>
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.COURSE_CODE</td>
                                                    <td>@item.COURSE_TITLE</td>
                                                    <td>@item.SUBJECT_TYPE</td>
                                                    <td>@item.APPLICATION_TYPE</td>
                                                    @*<td>@item.EXAM_TYPE</td>*@
                                                    <td>@item.TITLE</td>
                                                    <td>
                                                        <a href="javascript:;" onclick="loadContent('/Examination/AddOrEditExamCourseWiseCost')"><i class="fa fa-edit text-primary"></i></a>
                                                        <a href="javascript:;" onclick="GetConfirm(@item.COURSE_WISE_COST_ID);"><i class="fa fa-trash text-danger"></i></a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad()
    {
        $('#tblCourseWiseCost').DataTable();
    }

    $('#UgcType').on('change', function ()
    {
        //loadContent('/Examination/BindExmaCourseWiseCost?sProgrammeTypeId=' + $('#UgcType').val());
        GetExamCourseWiseCostList();
    });

    function GetExamCourseWiseCostList()
    {
        if ($('#UgcType').val())
        {
            $.ajax({
                url: '@Url.Action("BindExmaCourseWiseCost", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sProgrammeTypeId: $('#UgcType').val() },
                success: function (data) {
                    $('#dvBindCourseWiseCost').empty();
                    if (data.Message != null && data.Message != '') {
                        alert(data.Message);
                    } else {
                        $('#dvBindCourseWiseCost').append(data);
                        $('.table').DataTable();

                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }
    }

    function GetConfirm(Id)
    {
        if (!confirm('Are you sure to delete ?'))
        {
            return false;
        } else
        {
            $.ajax({
                url:'@Url.Action("DeleteExamCourseWiseCost", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sCourseWiseCostId: Id },
                success: function (data)
                {
                    alert(data.Message);
                    // loadContent('');
                    GetExamCourseWiseCostList();
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    }



</script>
