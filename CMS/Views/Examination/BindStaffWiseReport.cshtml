@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ 
    Layout = null;
    int count = 0;
}
<div class="col-md-12">
    <center><h4>Component Mark Yet Enter</h4></center>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Class Name</th>
                <th>Course Title</th>
                <th>Course Code</th>
                <th>Component Name</th>      
                <th>Status</th>       
            </tr>
        </thead>
        <tbody>
            @if (Model.liCIA_Marks_Info != null && Model.liCIA_Marks_Info.Count > 0)
            {
                foreach (var item in Model.liCIA_Marks_Info)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.COURSE_TITLE</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.COMPONENT</td>
                        @if(@item.CIA_GROUP_MARK_ID!="")
                        {
                            <td><i class="fa fa-check text-success" title="Mark Entered"></i></td>
                        }
                        else
                        {
                            <td><i class="fa fa-close text-danger" title="Not Entered"></i></td>
                        }
                    </tr>
                }
            }          
        </tbody>
    </table>
</div>