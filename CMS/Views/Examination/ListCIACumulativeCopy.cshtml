@model CMS.ViewModel.ViewModel.ExaminationViewModel


@{
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active"> CIA Cumulative List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> CIA Cumulative List <small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title"> CIA Cumulative List </h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">
                        <div class="col-md-3">
                            @Html.Label("Year", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            @Html.Label("Semester", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                               
                                <select class="form-control  selectpicker" id="ddlSemester" data-live-search = "true" >
                                    <option value=""> -- Select -- </option>
                                    <option value="1"> Odd Semester </option>
                                    <option value="2"> Even Semester </option>
                                    <option value="3"> Non Semester </option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group col-md-2">
                            <a href="javascript:;" id="sPrint" onclick="printDiv('dvCIAExamMarks')" class="btn btn-sm btn-success pull-right"><i class="fa fa-print m-r-5"></i> Print</a>
                            <a href="javascript:;" id="sExcel" onclick="Export()" class="btn btn-sm btn-primary pull-right"><i class="fa fa-print m-r-5"></i> Excel</a>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-12 table-responsive">
                    <div id="dvCIAExamMarks"></div>
                </div>

                <div class="form-group col-md-12 table-responsive">
                    <div id="dvCIAExamMarksExcel"></div>
                </div>
            }

        </div>

    </div>
</div>




<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>


<script>
    $('#AcademicYearList').on('change', function ()
    {
        BindData();
    });

    $('#ClassList').on('change', function ()
    {
        //chrome.downloads.showDefaultFolder();
        //var myObject, newfolder;
        //myObject = new ActiveXObject("Scripting.FileSystemObject");
        //newfolder = myObject.CreateFolder("C:\Users\SJCERP04\Downloads\New folder\\" + $('#ClassList option:Selected').text());
        BindData();
    });

    $('#ddlSemester').on('change', function ()
    {
        BindData();
    });


    function BindData()
    {
        $('#dvCIAExamMarks').empty();
        if ($('#AcademicYearList').val() && $('#ClassList').val() && $('#ddlSemester').val())
        {
            $.ajax({
                url: '@Url.Action("BindCIACumulativeForSJC", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sAcYear: $('#AcademicYearList option:Selected').text(), sClassId: $('#ClassList').val(), sSemesterTypeId: $('#ddlSemester').val() },
                success: function (data)
                {
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else
                    {
                        $('#dvCIAExamMarks').append(data);
                        $("#ciaMarkList").DataTable({ "bPaginate": false });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }






    function printDiv(divName)
    {
        //var printContents = document.getElementById(divName).innerHTML;
        //myWindow = window.open('', '', 'width=200,height=100');
        //myWindow.document.write(printContents);
        //myWindow.document.close(); //missing code
        //myWindow.focus();
        //myWindow.print();

        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/ListCIACumulativeCopy');
    }

    function Export()
    {
        $('.dataTables_filter').addClass('hidden');
        var nCount = 0;
        var sColumn = '"columnDefs": [';
        var sCourse = $('#txtCourse').val().split(',');
        var nCourseCount = 1; var sFalg=true;
        $.each(sCourse, function (i, e)
        {
            var title = e;
            let file = new Blob([$('#dv_'+e).html()], { type: "application/vnd.ms-excel" });
            let url = URL.createObjectURL(file);
            
            let a = $("<a />", {
                href: url,
                download: title + ".xls"
            }).appendTo("body").get(0).click();
                //e.preventDefault();
        });
           
    }

   
</script>
