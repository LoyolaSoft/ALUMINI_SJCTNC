@model CMS.ViewModel.ViewModel.ExaminationViewModel

<div class="form-group table-responsive col-md-12">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Component</th>
                <th>Mark</th>
            </tr>
        </thead>
        <tbody>
            
                @if (Model.liCIA_Marks_Info != null && Model.liCIA_Marks_Info.Count > 0)
                {
                    int nCount = 0;
                    foreach (var item in Model.liCIA_Marks_Info)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.COMPONENT</td>
                            <td>@item.COURSE_GROUP_MARK / @item.MAX_MARK</td>
                        </tr>
                    }
                }
            
        </tbody>
    </table>
</div>