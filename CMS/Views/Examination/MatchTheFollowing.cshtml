                                    @Html.DropDownListFor(model => model.QuizQuestionType, (Model.QuizQuestionType != null) ? Model.QuizQuestionType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Batch, "", new { @class = "text-danger" })
                                </div>
                            </div>

