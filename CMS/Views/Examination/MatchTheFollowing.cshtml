<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
       
        function ContentLoad()
        {
            handleSummernote();
            // Document Ready Function .
        }
        handleSummernote = function () {
            $(".summernote").summernote({
                placeholder: ""
            })
        }
        $('.note-editable').css("width", "882");
        
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

       

        $("#ClassList").on("change", function ()
        {
            var Class = $("#ClassList").val();
            $.ajax({
                url:"@Url.Action("FethCourseByClassId", "Examination")",
                method: "POST",
                datatype: "json",
                data: { Class_Id: Class },
                success: function (data)
                {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error)
                {
                    alert('Internal Server Error .....!');
                }
            });
        })
        $("#txtOption").on("change", function ()
        {
            
            $('#TxtTitle').summernote('reset');

            $('#dvtextboxes').removeClass('hidden');
            $("#btnSubmit").removeClass('hidden');
            var value = $("#txtOption").val();
            var Option = '';
            var Option2 = '';
            var Option3 = '';
            if (value > 10)
            {
                alert('Invalid Option .! Maximum Option is 10 .');
                value = 10;
                $("#txtOption").val('10');
            }
            $("#dvOptions1").empty();
            $("#dvOptions2").empty();
            $("#dvOptions3").empty();
            
            var QuizQuestions = $('#QuizQuestionType').val();
            if (QuizQuestions=="1" || QuizQuestions == "2")
            {
                $('#dvMathTheFollowing').addClass('hidden');
                $('#dvOtherType').removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-1">' + j + ' .)</label>';
                    Option += '<div class="col-md-10">';
                    Option += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
                    Option += '</div>';
                    Option += '</div>';
                    
                    //Option2 += '<div class="form-group">';
                    //Option2 += '<div class="col-md-9">';
                    //Option2 += '<input type="number" id="Mark' + i + '" class="form-control" placeholder="Enter Your Mark">';
                    //Option2 += '</div>';
                    //Option2 += '</div>';

                }
                //$("#dvOptions1").append(Option);
                //$("#dvOptions2").append(Option2);
                $("#dvOptions3").append(Option);
                $('#Answer').removeClass('hidden');
                $("#Question").removeClass('hidden');
                handleSummernote();



            } else if (QuizQuestions=="3")
            {
                $('#dvOtherType').addClass('hidden');
                $("#dvMathTheFollowing").removeClass('hidden');
                for (var i = 0; i < value; i++)
                {
                    var j = i;
                    j++;
                    Option += '<div class="col-md-12 form-group">';
                    Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
                    Option += '<div class="col-md-9">';
                    Option += '<input type="text" id="Qustions' + i + '" class="summernote form-control" placeholder="Enter Your Questions" maxlength="145" style="width:110%">';
                    Option += '</div>';
                    Option += '</div>';
                    
                    Option2 += '<div class="col-md-12 form-group">';
                    Option2 += '<div class="col-md-9">';
                    Option2 += '<input type="text" id="Options' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145" style="width:110%">';
                    Option2 += '</div>';
                    Option2 += '</div>';
                }
               
                $("#dvOptions1").append(Option);
                $("#dvOptions2").append(Option2);
                $('#Mark').removeClass('hidden');
                $('#Answer').addClass('hidden');
                $("#Question").removeClass('hidden');
                handleSummernote();
            }
          //  DeleteSummerNoteHeader();
            
            
        });

        $("#btnSubmit").on("click", function ()
        {
            //var str = $("#TxtTitle").summernote('code');
            //var b64 = window.btoa(unescape(encodeURIComponent(str)))
            //alert(b64);

            //var str2 = decodeURIComponent(escape(window.atob(b64)));
            //alert(str2);
            //$('#l').html(str2);

           // alert('Class :' + $("#ClassList").val() + 'Course :' + $("#CourseList").val() + 'Batch :' + $("#Batch").val());
            if (!$("#ClassList").val() && !$("#CourseList").val() && !$("#Batch").val())
            {
                alert('Please Select All To Continue ! ');
                return false;
            }

            var QuizQuestions = $('#QuizQuestionType').val();
            var Endvalue = $("#txtOption").val();

            var SummerNote = $("#TxtTitle").summernote('code');
            
            var str = btoa(unescape(encodeURIComponent(SummerNote)));
            var Question = str;

            var CourseId = $("#CourseList").val();

            //var SummerNote1 = $("#txtAnswer").summernote('code');
           
            //var str1 = btoa(unescape(encodeURIComponent(SummerNote1)));
           
           
         
           
           // var ddlAnswer = $("#Answer option:selected").text();
            var ddlClass = $("#ClassList").val();
            var QuestionId = $("#QuestionId").val();
            var SetId = $('#Batch').val();
            var ArrayOption = '';
            var nCount = 0;
            ArrayOption = '{"liMF_Option":[';
            for (var i = 0; i < Endvalue; i++)
            {
                if (QuizQuestions == "1")
                {
                    // Objective Type Questions ...
                    if ($("#Options" + i).summernote('code'))
                    {
                        var SummerNote2 = $("#Options" + i).summernote('code');
                        var str2 = btoa(unescape(encodeURIComponent(SummerNote2)));
                        
                        ArrayOption += '{"OPTION":"' + str2 + '"},';
                        nCount++;
                    } else
                    {
                        alert('All the Options Must to Fill ..!');
                        return false;
                        break;
                    }
                } else if (QuizQuestions=="2")
                {
                    // Fill In The Blanks ...
                    if ($("#Options" + i).summernote('code'))
                    {
                        var SummerNote3 = $("#Options" + i).summernote('code');
                        var str3 = btoa(unescape(encodeURIComponent(SummerNote3)));
                       
                        ArrayOption += '{"OPTION":"' + str3 + '"},';
                        nCount++;
                    } else {
                        alert('All the Options Must to Fill ..!');
                        return false;
                        break;
                    }

                } else if (QuizQuestions == "3")
                {
                   
                    // Match The Following ...
                    if ($("#Options" + i).summernote('code') && $("#Qustions" + i).summernote('code'))
                    {
                        var SummerNote4 = $("#Options" + i).summernote('code');
                        var str4 = btoa(unescape(encodeURIComponent(SummerNote4)));

                        var SummerNote5 = $("#Qustions" + i).summernote('code');
                        var str5 = btoa(unescape(encodeURIComponent(SummerNote5)));
                       
                        ArrayOption += '{"QUESTION":"' + str5 + '","ANSWER":"' + str4 + '"},';
                        nCount++;
                    } else
                    {
                        alert('All the Options Must to Fill ..!');
                        return false;
                        break;
                    }
                }
            }
            if (nCount != 0)
            {
                ArrayOption = ArrayOption.slice(0, -1);
                ArrayOption += ']}';
            } else
            {
                alert('Something is went wrong . please check your Input !');
                return false;
            }
            

            var Answer = "";
            if (QuizQuestions == "1" || QuizQuestions == "2") {
                var str1 = GetOptionCodeForAnswer($("#txtAnswer").val());
                if (str1 != null && str1 != "" && str1 != "W29iamVjdCBPYmplY3Rd") {
                    Answer = str1;
                }
                else {
                    alert('Your Answer Not Valuable ! Please Check You Input !');
                    return false;
                }
            }



            var JsonData;
            JsonData = '{"QUESTION":"' + Question + '","COURSE_ID":"' + CourseId + '","SET_ID":"' + SetId + '","CLASS_ID":"' + ddlClass + '","ANSWER_ID":"' + Answer + '","QUESTION_TYPE":"' + QuizQuestions + '","MARK":"' + $('#txtMark').val() + '"}';
            if (!$('#txtMark').val() || $('#txtMark').val()=='0')
            {
                alert('Please Enter Mark To Continue !');
                return false;
            }
            $.ajax({
                url:"@Url.Action("SaveMatchTheFollowing", "Examination")",
                method: "POST",
                datatype: "json",
                data: { QuizQuestion: JsonData, sSaveMatchTheFollowing: ArrayOption },
                success: function (data)
                {
                    alert(data.Message);
                    if (data.ErrorCode != null && data.ErrorCode)
                    {
                        $('#dvtextboxes').addClass('hidden');
                        $('#txtOption').val('');
                        $("#TxtTitle").val('');
                        $('#txtAnswer').val('');
                        $('#txtMark').val('');
                    }
                    
                    //loadContent('/Examination/MatchTheFollowing');
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
            
        });
    </script>

<script>

    function DeleteSummerNoteHeader()
    {
       
        $('#dvOptions3').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions1').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions2').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        
        //$('#Answer').find(".note-toolbar").remove();
        //$('#Answer').find(".note-statusbar").remove();
        //$('#Answer').find(".note-editing-area").css("border", "1px solid");
        //$('#Answer').find(".note-editable").html("");
        //$('#Answer').find(".note-editable").css("height", "50px");

    }

    function GetOptionCodeForAnswer(answer)
    {
       
        var AnswerCode;
      
        if (answer != null && answer != "")
        {
          
            AnswerCode = $("#Options" + (parseInt(answer) - 1)).summernote('code');
            AnswerCode = btoa(unescape(encodeURIComponent(AnswerCode)));
        }
       
       
        return AnswerCode;
    }
</script>

