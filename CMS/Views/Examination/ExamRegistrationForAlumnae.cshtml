@model CMS.ViewModel.ViewModel.ExaminationViewModel
@using CMS.Utility;
@{ 
    Layout = null;
}


<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <!-- begin breadcrumb -->
        <ol class="breadcrumb pull-right">
            <li><a @*href="@Url.Action("Student", "DashBoard")"*@ href="javascript:;">Home</a></li>
            <li class="active">Exam Registration</li>
        </ol>
        <!-- end breadcrumb -->
        <!-- begin page-header -->
        <h1 class="page-header">Exam Registration<small></small></h1>
        <!-- end page-header -->

        <div class="panel panel-primary" id="panel">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Exam Registration</h4>
            </div>
            <div class="panel-body">
                <div class="col-lg-12" style="z-index:1">

                    <div class="col-md-12 alert alert-danger" id="dvNote">
                        Please verify your course code and title of the paper...!
                        If something went wrong please meet exam registration committee..!
                        No modification will be done after registration !
                    </div>

                    @*<span class="pull-left ">
                            <a @*href='@Url.Action("ExamRegistration", "Examination") href="javascript:;" onclick="loadContent('/Examination/ExamRegistration')" id="idBack" class="btn btn-sm btn-default m-b-10 "><i class="ion-ios-arrow-left m-r-5"></i> Back</a>
                        </span>*@
                    <span class="pull-right hidden-print">
                        <a href="javascript:;" id="sPrint" onclick="printDiv('dvExamRegistrationPriview')" class="btn btn-sm btn-success m-b-10 disabled"><i class="fa fa-print m-r-5"></i> Print</a>
                    </span>
                </div>
                <div id="dvRegister">
                    <div class="form-horizontal">


                        <div class="text-center">
                            @*<img class="image" />*@
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:100px; height:100px" />
                        </div>
                        <div class="text-center">

                            <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                            <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                            <h5>
                                @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>")) <br />
                                EXAMINATION APPLICATION FORM<br />
                                &nbsp;&nbsp; MONTH & YEAR &nbsp;&nbsp; <b>@Model.liExamRegistrationModel.FirstOrDefault().MONTH</b>
                            </h5>


                        </div>
                    </div>
                    <input type="hidden" id="hdStudentId" name="name" value="@Session[Common.SESSION_VARIABLES.USER_ID].ToString()" />

                    <br /> <br />
                    <div class="col-md-12">
                        <div class="form-group col-md-4">
                            <label> Name Of The Candidate : @Model.liExamRegistrationModel.FirstOrDefault().NAME</label>
                        </div>
                        <div class="form-group col-md-4">
                            <label> Roll No : @Model.liExamRegistrationModel.FirstOrDefault().ROLL_NO</label>
                        </div>
                        <div class="form-group col-md-4">
                            <label> Phone No : @Model.liExamRegistrationModel.FirstOrDefault().MOBILE_NO</label>
                        </div>

                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-4">
                            <label> Major : @Model.liExamRegistrationModel.FirstOrDefault().DEPARTMENT</label>
                        </div>
                        <div class="form-group col-md-4">
                            <label> Register No : @Model.liExamRegistrationModel.FirstOrDefault().REGISTER_NO</label>
                        </div>
                        <div class="form-group col-md-4">
                            <label> Date of Birth : @Model.liExamRegistrationModel.FirstOrDefault().DATE_OF_BIRTH</label>
                        </div>


                    </div>


                    <br />


                    <div id="Registration" class="table-responsive table-bordered">
                        <br />
                      

                        <div>
                            @{int no = 0; }
                            @if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                            {
                                <label id="Tittle">COURSE LIST:</label>

                                <br /><br />
                                <table class="table  table-hover" id="ArrearList">
                                    <thead>
                                        <tr>
                                            <th>S.No</th>
                                            
                                            <th>Semester</th>
                                            <th>Course Code</th>
                                            <th>Title of the Paper</th>
                                            <th>Result</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                                        {
                                            foreach (var item in Model.liSemesterList)
                                            {
                                                <tr cms-acyear="@item.AC_YEAR" cms-course-code="@item.COURSE_CODE" cms-subject-type="@item.SUBJECT_TYPE_ID" @*cms-semester="@Model.liExamRegistrationList.FirstOrDefault().SEMESTER_ID"*@ @*cms-semester="@Session[Common.SESSION_VARIABLES.ACTIVE_SEMESTER_FOR_STUDENT].ToString()"*@ cms-examid="@Model.liExamRegistrationModel.FirstOrDefault().EXAM_SETTING_ID">
                                                    <td>
                                                        @{no++; } @no
                                                    </td>
                                                    
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.SEMESTER)
                                                       
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.COURSE_CODE)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                                                    </td>
                                                    <td>
                                                        <b>@Html.DisplayFor(modelItem => item.RESULT)</b>
                                                    </td>
                                                </tr>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td>No Data Found ...!</td>
                                                                </tr>
                                                            }
                                    </tbody>
                                </table>
                                                            }

                        </div>
                    </div>

                </div>

                <div class="form-horizontal">
                    <div class="col-lg-12" id="dvExamRegistration"></div>
                    <div class="col-lg-12" id="dvExamRegistrationPriview"></div>
                </div>

                <div class="form-group">
                    <div class="col-md-12 pull-right">
                        <a class="btn btn-primary pull-right" id="btnSubmit">Submit</a>
                    </div>
                </div>
            </div>
        </div>
                                                            }
</div>

<script>
    function ContentLoad()
    {
            speak('Please verify your course code and title of the paper. If something went wrong please meet exam registration committee. No modification will be done after registration .');
            // Document Ready Function .
            validate();
        }


        function validate() {
            $.ajax({
                url: "@Url.Action("ValidateStudent", "Examination")",
                method: "POST",
                datatype: "json",
                success: function (data)
                {
                    if (data == "1")
                    {
                        // ExamRegistrationList();
                        ExamRegistrationPriview();
                    } else if (data == "404")
                    {
                        //alert('Sorry Session Out Please Login again.!!!');
                        swal({ title: "Failed !", text: 'Sorry Session Out Please Login Again !', showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                        $('#btnSubmit').addClass('hidden');
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }

       
        function ExamRegistrationPriview() {
            $.ajax({
                url: "@Url.Action("ExamRegistrationPriview", "Examination")",
                method: "POST",
                datatype: "json",
                success: function (data) {
                    $("#dvExamRegistrationPriview").empty();
                    $("#dvExamRegistrationPriview").append(data);
                    $('#dvExamRegistration').addClass('hidden');
                    $('#dvRegister').addClass('hidden');
                    $('#btnSubmit').addClass('hidden');
                    $('#dvNote').addClass('hidden');
                    $('#sPrint').removeClass("disabled");
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        };

       function loadFeeSummary()
       {
            $.ajax({
                url: "@Url.Action("FeeSummary", "Fee")",
                method: "POST",
                datatype: "json",
                data: { sFrequencyId: $('#hdFrequencyId').val() },
                success: function (data) {
                    $("#dvExamRegistrationPriview").empty();
                    $("#dvExamRegistrationPriview").append(data);
                    $('#dvExamRegistration').addClass('hidden');
                    $('#dvRegister').addClass('hidden');
                    $('#btnSubmit').addClass('hidden');
                    $('#sPrint').removeClass("disabled");
                }, error: function (error) {
                    alert('Internal Server Error ...!')
                }
            });
        }
</script>


<script>
        // Get Regular Paper ...
        $("#btnSubmit").on("click", function () {

            swal({
                title: "Confirmation !",
                text: "Please verify your course code and title of the paper...!\n If something went wrong please meet exam registration committee..! \n No modification will be done after registration !",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-success",
                confirmButtonText: "Yes, I agree !",
                closeOnConfirm: false
            },
                function () {

                    swal({
                        title: "Are you sure to apply ?",
                        text: "",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonClass: "btn-success",
                        confirmButtonText: "Yes, Apply!",
                        closeOnConfirm: false
                    },
                        function () {

            var JsonData;
            var Semester;
            var CourseId;
            var Status;
            JsonData = '{"SubjectDetails":[';
            $('#RegularList  tbody tr').each(function ()
            {
                var acYear = $(this).attr("cms-acyear");
                var coursecode = $(this).attr("cms-course-code");
                CourseId = $(this).find("div").text();
                Status = "R";
                JsonData += '{"EXAM_SETTING_ID":"' + $(this).attr('cms-examid') + '","SEMESTER":"' + $(this).attr("cms-semester") + '","SUBJECT_TYPE_ID":"' + $(this).attr("cms-subject-type") + '","STUDENT_ID":"' + $('#hdStudentId').val() + '","COURSE_ROOT_ID":"' + CourseId + '","STATUS":"' + Status + '","AC_YEAR":"' + acYear + '","COURSE_CODE":"' + coursecode + '"},';
            });
           
            JsonData = JsonData.slice(0, -1);
            JsonData += ']}';
            $.ajax({
                url: "@Url.Action("SaveExamRegistration", "Examination")", //SaveExamSubjects
                method: "POST",
                datatype: "jsondata",
                data: { ExamDetails: JsonData },
                async: false,
                success: function (data)
                {
                    if (data.ErrorCode=='200')
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        ExamRegistrationPriview();
                        $('#sPrint').removeClass("disabled");
                    }
                    else if(data.ErrorCode!=null && data.ErrorCode!='')
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                    } else
                    {
                        alert(' You have Registered Already ...!');
                    }
                    //ExamRegistrationList();
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });

            });
          });
      });
</script>


<script>
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        loadContent('/Examination/ExamRegistrationForAlumnae');
    }
</script>

