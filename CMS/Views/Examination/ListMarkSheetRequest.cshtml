@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListMarkSheetRequest";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Mark Sheet Request</li>
    </ol>
    <h1 class="page-header">Mark Sheet Request</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Mark Sheet Request</h4>
        </div>
        <div class="panel-body noPadding">
            @if (Model.liStudentAcademicInfo != null && Model.liStudentAcademicInfo.Count > 0)
            {
                <input type="hidden" id="applicationtype" value="@Model.liStudentAcademicInfo.FirstOrDefault().APPTYPE_ID">
                if ((Model.liStudentAcademicInfo.FirstOrDefault().APPTYPE_ID == "1" && Model.liStudentAcademicInfo.FirstOrDefault().CLASS_YEAR == "3") || (Model.liStudentAcademicInfo.FirstOrDefault().APPTYPE_ID == "2" && Model.liStudentAcademicInfo.FirstOrDefault().CLASS_YEAR == "2") || (Model.liStudentAcademicInfo.FirstOrDefault().APPTYPE_ID == "4" && Model.liStudentAcademicInfo.FirstOrDefault().CLASS_YEAR == "3") || (Model.liStudentAcademicInfo.FirstOrDefault().APPTYPE_ID == "7" && Model.liStudentAcademicInfo.FirstOrDefault().CLASS_YEAR == "3"))
                {
                    <div class="form-group col-md-12">
                        <a class="btn btn-success pull-right form-group m-b-5" href="#AddMarksheetRequest" data-toggle="modal"><i class="fa fa-plus" title="Add">Add</i></a>
                    </div>
                    <div class="form-group col-md-12 table-responsive">
                        <table class="table table-hover table-bordered" id="tblMarkSheetRequested">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Semster</th>
                                    <th>Requested Date</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liMarksheetdistribution != null && Model.liMarksheetdistribution.Count > 0)
                                {
                                    int count = 0;
                                    foreach (var item in Model.liMarksheetdistribution)
                                    {
                                        <tr>
                                            <td>@{count++;} @count</td>
                                            <td>@item.SEMESTER_NAME</td>
                                            <td>@item.REQUEST_DATE</td>
                                            <td>@item.REASON</td>
                                            <td>@item.STATUS_NAME</td>

                                            <td>
                                                @if (item.STATUS == "0" || item.STATUS == "")
                                                {
                                                    <a href="#AddMarksheetRequest" onclick="FetchItemDetails(@item.MARKSHEET_DISTRIBUTION_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                                                    <a href="javascrip:;" onclick="GetConfirm(@item.MARKSHEET_DISTRIBUTION_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                                                }
                                                else
                                                {
                                                    @("Action Taken")
                                                }
                                            </td>
                                        </tr>
                                    }

                                }

                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Note:<br>
                        Only for final year students...!
                    </div>
                }


            }

        </div>
    </div>
</div>

<div class="modal" id="AddMarksheetRequest">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group col-lg-12">
                                    <input type="hidden" id="marksheetdisid">
                                    <div class="form-group col-md-6">
                                        @Html.LabelFor(model => model.Semester, htmlAttributes: new { @class = "control-label col-md-4" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control", @data_live_search = "true", @disabled = "disabled" })
                                            @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label class="control-label col-md-4">Description</label>
                                        <div class="col-md-8">
                                            <div class="input-group">
                                                @Html.TextArea("Description", null, 3, 35, new { @class = "form-control input-sm", placeholder = "Enter the Description", id = "txtDescription" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmitAdd" class="btn btn-sm btn-success" data-dismiss="modal">Request</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>


    function ContentLoad() {
        // Document Ready Function .

    }

    $(document).ready(function () {

        var applicationtype = $('#applicationtype').val();

        if (applicationtype == "1" || applicationtype == "4" || applicationtype == "7")
        {
            $('#Semester').val("5");
        }
        else
        {
            $('#Semester').val("3");
        }

    });
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('#tblMarkSheetRequested').DataTable({});
    function FetchItemDetails(ID) {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchMarkRequestInfo", "Examination")",
                type: "post",
                data: { sMarkSheetRequestId: ID },
                success: function (data) {
                    if (data != null)
                    {
                        $('#marksheetdisid').val(data.MARKSHEET_DISTRIBUTION_ID);
                        $('#Semester').val(data.SEMESTER_ID);
                        $('#txtDescription').val(data.REASON);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmitAdd').click(function () {

        var JsonData = null;
        JsonData = '{"MARKSHEET_DISTRIBUTION_ID":"' + $('#marksheetdisid').val() + '","REASON":"' + $('#txtDescription').val() + '","SEMESTER_ID":"' + $('#Semester').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateMarkSheetRequest", "Examination")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {
                if (data.ErrorCode != null && data.ErrorCode == "406") {
                    swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    loadContent('/Examination/ListMarkSheetRequest');
                } else {
                    swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    loadContent('/Examination/ListMarkSheetRequest');
                }
            },
            error: function (ex) {
                swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("DeleteMarkSheetRequested", "Examination")",
                type: "post",
                data: { sMarkSheetRequestId: ID },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode == "402") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                        loadContent('/Examination/ListMarkSheetRequest');
                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Examination/ListMarkSheetRequest');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

    }


</script>
