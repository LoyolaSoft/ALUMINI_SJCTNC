@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    Layout = null;
    int count = 0;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">Student List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student List</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Student List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12 table-bordered">
                                    <br>
                                    @if (Model.liexaminvigilation != null && Model.liexaminvigilation.Count > 0)
                                    {
                                        <div class="col-md-12">
                                            <br><br>
                                            <div class="col-md-offset-2 col-md-6">
                                                Course:@Model.liexaminvigilation.FirstOrDefault().COURSE_TITLE
                                            </div>
                                            <div class="col-md-4">
                                                Time:@Model.liexaminvigilation.FirstOrDefault().START_TIME
                                            </div>
                                            <br>
                                            <br>
                                        </div>
                                    }

                                    <table class="table table-bordered table-responsive" id="studentlist">
                                        <thead>
                                            <tr>
                                                <td>#</td>
                                                <td>Register No</td>
                                                <td>Name</td>
                                                <td>Mobile No</td>
                                                <td>Course</td>
                                                <td>Violation</td>
                                                <td>Logs</td>
                                                <td>Is Suspended</td>
                                                <td>Is Complete</td>
                                               
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.liexaminvigilation != null && Model.liexaminvigilation.Count > 0)
                                            {
                                                foreach (var item in Model.liexaminvigilation)
                                                {

                                                    count++;
                                                    <tr invigilation="@item.EXAM_INVIGILATION_ID" msgcount="@item.MSGCOUNT">
                                                        <td>@count</td>
                                                        <td>@item.REGISTER_NO</td>
                                                        <td>@item.FIRST_NAME</td>
                                                        <td>@item.MOBILE_NO</td>
                                                        <td>@item.COURSE_TITLE</td>
                                                        <td>@item.VIOLATION_COUNT</td>
                                                        <td><a href="#violationmodal" data-target="#violationmodal" data-toggle="modal" onclick="FetchExamStudentLogs(@item.EXAM_INVIGILATION_ID)"><i class="fa fa-eye"></i></a></td>
                                                        @if (@item.SUSPECTIONS == "1")
                                                        {
                                                            <td> <a href="#" onclick="SuspectStatus(@item.EXAM_INVIGILATION_ID,'0');" title="REMOVE SUSPECTIONS"><i class="fa fa-check text-success"></i></a></td>
                                                        }
                                                        else
                                                        {
                                                            <td> <a href="#" onclick="SuspectStatus(@item.EXAM_INVIGILATION_ID,'1');" title="UNDER SUSPECTIONS"><i class="fa fa-close text-danger"></i></a></td>
                                                        }
                                                        @if (@item.COMPLETE == "1")
                                                        {
                                                            <td> <a href="#" onclick="CompleteStatus(@item.EXAM_INVIGILATION_ID,'0');" title="IN COMPLETE"><i class="fa fa-check text-success"></i></a></td>

                                                        }
                                                        else
                                                        {
                                                            <td><a href="#" onclick="CompleteStatus(@item.EXAM_INVIGILATION_ID,'1');" title="COMPLETE"><i class="fa fa-close text-danger"></i></a></td>
                                                        }
                                                        

                                                    </tr>

                                                }

                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="8">No Records Found...!</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <br><br>
                                <a href="#" onclick="loadContent('/Examination/ListInivigilatorsForSquad')" class="btn btn-primary pull-right">Back</a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>



<!-- Begin Modal -->
<div class="modal" id="violationmodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Violation Details</h4>
            </div>
            <div class="modal-body">
                <div class="" id="bindstudentviolation">

                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="newcount" value="0">
<!-- End Modal -->
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function FetchExamStudentLogs(ID) {
        if (ID != "") {
            $.ajax({
                url: "@Url.Action("FetchStudentLogInfo", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sExamInvigilationid: ID },
                success: function (data) {
                    $('#bindstudentviolation').empty();
                    $('#bindstudentviolation').append(data);

                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
    }
    function SuspectStatus(INVIGILATION_ID, VALUE) {
        swal({
            title: "Are you sure want to Suspect/Remove Suspect..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("UpdateSuspectedStatus", "Examination")",
                type: "post",
                data: { sExamInvigilationid: INVIGILATION_ID, sValue: VALUE },
                success: function (data) {
                    if (data.ErrorCode == "406") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        GetStudentList($('#examsettingid').val(), $('#courseid').val(), $('#staffid').val());
                    }
                },
                error: function (ex) {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

    }

    function CompleteStatus(INVIGILATION_ID, VALUE) {
        swal({
            title: "Are you sure want to complete status..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("UpdateCompleteStatus", "Examination")",
                type: "post",
                data: { sExamInvigilationid: INVIGILATION_ID, sValue: VALUE },
                success: function (data) {
                    if (data.ErrorCode == "406") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        GetStudentList($('#examsettingid').val(), $('#courseid').val(), $('#staffid').val());
                    }
                },
                error: function (ex) {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });
        });

    }
</script>
