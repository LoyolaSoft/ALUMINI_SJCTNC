<script>
    var currentStep = 1;
    var completedSteps = {
        1: false,
        2: false,
        3: false,
        4: false
    };

    var currentActiveEditor = null;

    function OpenMathModal() {
        if (!currentActiveEditor) {
            var firstEditorId = $('.editor-textarea').first().attr('id');
            if (firstEditorId && CKEDITOR.instances[firstEditorId]) {
                currentActiveEditor = CKEDITOR.instances[firstEditorId];
            } else {
                swal('Warning', 'Please click inside a Question Entry box first to select where to insert.', 'warning');
                return;
            }
        }
        $('#txtMathInput').val('');
        $('#divMathPreview').html('');
        $('#MathFormModal').modal('show');
    }

    function OpenChemModal() {
        if (!currentActiveEditor) {
            var firstEditorId = $('.editor-textarea').first().attr('id');
            if (firstEditorId && CKEDITOR.instances[firstEditorId]) {
                currentActiveEditor = CKEDITOR.instances[firstEditorId];
            } else {
                swal('Warning', 'Please click inside a Question Entry box first to select where to insert.', 'warning');
                return;
            }
        }
        $('#txtChemInput').val('');
        $('#divChemPreview').html('');
        $('#ChemFormModal').modal('show');
    }

    function UpdateMathPreview() {
        var input = $('#txtMathInput').val();
        $('#divMathPreview').html('\\(' + input + '\\)');
        if (typeof MathJax !== 'undefined') {
            MathJax.Hub.Queue(["Typeset", MathJax.Hub, "divMathPreview"]);
        }
    }

    function UpdateChemPreview() {
        var input = $('#txtChemInput').val();
        $('#divChemPreview').html('\\(\\ce{' + input + '}\\)');
        if (typeof MathJax !== 'undefined') {
            MathJax.Hub.Queue(["Typeset", MathJax.Hub, "divChemPreview"]);
        }
    }

    function InsertMathEquation() {
        var input = $('#txtMathInput').val();
        if (input.trim() == '') {
            swal('Warning', 'Please enter a formula', 'warning');
            return;
        }
        if (currentActiveEditor) {
            var html = '<span class="math-tex">\\(' + input + '\\)</span>&nbsp;';
            currentActiveEditor.insertHtml(html);
            $('#MathFormModal').modal('hide');
        }
    }

    function InsertChemFormula() {
        var input = $('#txtChemInput').val();
        if (input.trim() == '') {
            swal('Warning', 'Please enter a formula', 'warning');
            return;
        }
        if (currentActiveEditor) {
            var html = '<span class="math-tex">\\(\\ce{' + input + '}\\)</span>&nbsp;';
            currentActiveEditor.insertHtml(html);
            $('#ChemFormModal').modal('hide');
        }
    }

    function OpenImagePicker() {
        if (!currentActiveEditor) {
            var firstEditorId = $('.editor-textarea').first().attr('id');
            if (firstEditorId && CKEDITOR.instances[firstEditorId]) {
                currentActiveEditor = CKEDITOR.instances[firstEditorId];
            } else {
                swal('Warning', 'Please click inside a Question Entry box first to select where to insert.', 'warning');
                return;
            }
        }
        $('#hdnImageInput').click();
    }

    function HandleImageUpload(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var base64Image = e.target.result;
                var html = '<div style="margin:10px 0;"><img src="' + base64Image + '" style="max-width: 100%; height: auto;" /></div>&nbsp;';
                if (currentActiveEditor) {
                    currentActiveEditor.insertHtml(html);
                }
                $(input).val(''); // Reset
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Load progress from localStorage
    function loadProgress() {
        var userId = '@Session[CMS.Utility.Common.SESSION_VARIABLES.USER_ID]';
        var savedProgress = localStorage.getItem('ExternalUserWorkflow_' + userId);
        if (savedProgress) {
            completedSteps = JSON.parse(savedProgress);
        }
        updateTabStates();

        // Find furthest completed step to set active tab
        var furthest = 1;
        for (var i = 1; i <= 4; i++) {
            if (completedSteps[i]) {
                furthest = (i < 4) ? i + 1 : 4;
            }
        }
        showTab(furthest);
    }

    // Save progress to localStorage
    function saveProgress() {
        var userId = '@Session[CMS.Utility.Common.SESSION_VARIABLES.USER_ID]';
        localStorage.setItem('ExternalUserWorkflow_' + userId, JSON.stringify(completedSteps));
    }

    function showTab(step) {
        if (step > 1 && !completedSteps[step - 1] && step > currentStep) {
            swal("Wait!", "Please complete the previous step first.", "warning");
            return;
        }

        // Hide all panes
        $('.workflow-pane').hide();
        // Show target pane
        $('#pane-' + step).show();

        // Update active tab UI
        $('.workflow-tab').removeClass('active');
        $('#tab-' + step).addClass('active');

        currentStep = step;

        // Re-enable tabs based on completion
        updateTabStates();
    }

    function completeStep(step) {
        completedSteps[step] = true;
        saveProgress();

        $('#tab-' + step).addClass('completed');
        $('#tab-' + step + ' .tick-mark').show();

        // Enable next tab
        if (step < 4) {
            var nextStep = step + 1;
            $('#tab-' + nextStep).removeClass('disabled');
            showTab(nextStep);
        } else {
            swal("Success!", "You have completed the entire workflow.", "success");
        }

        updateTabStates();
    }

    function updateTabStates() {
        for (var i = 1; i <= 4; i++) {
            if (completedSteps[i]) {
                $('#tab-' + i).addClass('completed');
                $('#tab-' + i + ' .tick-mark').show();
            }

            if (i > 1 && !completedSteps[i-1]) {
                $('#tab-' + i).addClass('disabled');
            } else {
                $('#tab-' + i).removeClass('disabled');
            }
        }

        // Always ensure buttons are enabled as per your latest request
        $('#btnNextSyllabus').prop('disabled', false);
    }

    function downloadSyllabus(courseId) {
        // Enforce the requirement: Button enables only after download
        $('#btnNextSyllabus').prop('disabled', false);

        swal({
            title: "Downloading...",
            text: "Your syllabus is being generated.",
            timer: 1500,
            showConfirmButton: false,
            type: "success"
        });

        // Optional: Trigger actual file download here
        // window.location.href = '@Url.Action("DownloadFile", "Academics")?id=' + courseId;
    }

    function loadQuestionEntry() {
        var courseId = $('#courseSelector').val();
        if (!courseId) {
            swal("Required", "Please select a course first.", "info");
            return;
        }

        // Navigate to the list exam questions page as requested
        loadContent('@Url.Action("ListExamQuestions", "Examination")');
    }

    function calculateClaim() {
        var ugQty = parseFloat($('#qtyUG').val()) || 0;
        var pgQty = parseFloat($('#qtyPG').val()) || 0;
        var postal = parseFloat($('#postalCharges').val()) || 0;

        // UG: 500 (Question) + 200 (Scheme) = 700 per set total
        var totalUG = ugQty * 700;
        // PG: 700 (Question) + 200 (Scheme) = 900 per set total
        var totalPG = pgQty * 900;

        var grandTotal = totalUG + totalPG + postal;

        $('#totalUG').val(totalUG.toFixed(2));
        $('#totalPG').val(totalPG.toFixed(2));
        $('#grandTotal').val(grandTotal.toFixed(2));
    }

    function printClaim() {
        window.print();
    }

    function submitClaim() {
        swal({
            title: "Submit Claim?",
            text: "Are you sure you want to submit your remuneration claim?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes, submit!",
            closeOnConfirm: false
        }, function() {
            completeStep(4);
            $('#btnSubmitClaim').hide();
            $('#btnPrintClaim').show();
            swal("Submitted!", "Your claim has been submitted. You can now print the original form.", "success");
        });
    }

    $(document).ready(function() {
        loadProgress();
    });
</script>


