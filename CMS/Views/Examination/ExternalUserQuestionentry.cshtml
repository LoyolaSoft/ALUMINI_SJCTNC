<script>
    $(document).ready(function () {
        $('.selectpicker').selectpicker('refresh');
    });

    function showBloomDetails(klevel, process, desc, verbs, sample) {
        $('#bloomModalTitle').text(klevel + ' Details');
        $('#tdCognitiveProcess').text(process);
        $('#tdDescription').text(desc);
        $('#tdActionVerbs').text(verbs);
