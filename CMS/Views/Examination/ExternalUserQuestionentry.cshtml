@model CMS.ViewModel.ViewModel.StudentViewModel
@{
    ViewBag.Title = "ExternalUserQuestionentry";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
@*<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />*@
<link href="~/Content/assets/printout1.css" media="print" rel="stylesheet" />

<style>
    .card {
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border: none;
        margin-bottom: 25px;
        background: #fff;
    }

    .profile-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 30px;
        border-radius: 15px 15px 0 0;
    }

    .profile-img {
        width: 120px;
        height: 120px;
        border-radius: 60px;
        border: 4px solid rgba(255,255,255,0.3);
        object-fit: cover;
    }

    /* Tab Workflow Styles */
    .workflow-tabs {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        padding: 0;
        list-style: none;
        background: #f8f9fa;
        border-radius: 10px;
        overflow: hidden;
    }

    .workflow-tab {
        flex: 1;
        text-align: center;
        padding: 20px 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        border-right: 1px solid #ddd;
        position: relative;
        background: #eee;
        color: #777;
        font-weight: 600;
        text-decoration: none !important;
    }

        .workflow-tab:last-child {
            border-right: none;
        }

        .workflow-tab.active {
            background: #fff;
            color: #2a5298;
            box-shadow: inset 0 -4px 0 #2a5298;
        }

        .workflow-tab.completed {
            background-color: #43a047 !important;
            color: white !important;
        }

            .workflow-tab.completed .tick-mark {
                display: inline-block;
                margin-right: 8px;
                font-size: 1.2em;
            }

        .workflow-tab.disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

    .tick-mark {
        display: none;
    }

    .tab-content-panel {
        padding: 40px;
        min-height: 400px;
    }

    .btn-workflow {
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
    }

    .instruction-item {
        margin-bottom: 15px;
        padding-left: 30px;
        position: relative;
    }

        .instruction-item i {
            position: absolute;
            left: 0;
            top: 4px;
            color: #2a5298;
        }

    .borderred {
        border: 2px solid #ff5b57;
        padding: 20px;
        border-radius: 10px;
    }

    /* Success Background for Tab */
    .bg-completion {
        background-color: #d4edda !important;
        border-color: #c3e6cb !important;
    }

    .no-print {
        display: block;
    }

    @@media print {
        .no-print, .header, .sidebar, .breadcrumb, .page-header, .workflow-tabs, .header-college, #pane-1, #pane-2, #pane-3, .instruction-item, .alert, .btn-workflow {
            display: none !important;
        }

        #pane-4, #claimPrintArea {
            display: block !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
        }

        body {
            background: white !important;
        }

        .content {
            margin: 0 !important;
            padding: 0 !important;
        }
    }
</style>

<style>
    /* Styling for the Blooms Taxonomy Sidebar */
    .bloom-box {
        text-align: center;
        padding: 15px 5px;
        margin-bottom: 5px;
        color: #fff;
        font-weight: bold;
        font-size: 16px;
        cursor: pointer;
        border-radius: 5px;
        transition: transform 0.2s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .bloom-box:hover {
            transform: scale(1.05);
        }

    .bloom-k1 {
        background-color: #f5b041;
    }

    .bloom-k2 {
        background-color: #5dade2;
    }

    .bloom-k3 {
        background-color: #58d68d;
    }

    .bloom-k4 {
        background-color: #af7ac5;
    }

    .bloom-k5 {
        background-color: #ec7063;
    }

    .bloom-k6 {
        background-color: #aeb6bf;
    }

    .bloom-sidebar {
        padding-right: 5px;
    }

    .question-panel {
        padding-left: 5px;
    }

    .ck-editor__editable {
        min-height: 100px;
    }

    .mathjax-sidebar-btn {
        text-align: center;
        padding: 8px 2px;
        margin-bottom: 8px;
        color: #fff;
        font-weight: bold;
        font-size: 13px;
        cursor: pointer;
        border-radius: 5px;
        transition: transform 0.2s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        display: block;
        width: 100%;
        border: none;
    }
    .mathjax-sidebar-btn:hover {
        transform: scale(1.05);
        color: #fff;
        text-decoration: none;
    }
</style>

<div id="content" class="content">

    <div class="table-responsive mt-4">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Exam Name</th>
                    <th>Department</th>
                    <th>Course Title</th>
                    <th>Due Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @if (Model.liExternalordercopydetails != null && Model.liExternalordercopydetails.Count > 0)
                    {
                        <td>
                            @if (Model.liExternalordercopydetails[0].EXAM_NAME != null)
                            {
                                <span>@Model.liExternalordercopydetails[0].EXAM_NAME</span>
                            }
                        </td>
                        <td>
                            @if (Model.liExternalordercopydetails[0].DEPARTMENT != null)
                            {
                                <span>@Model.liExternalordercopydetails[0].DEPARTMENT</span>
                            }
                        </td>
                        <td>
                            @if (Model.liExternalordercopydetails[0].COURSE_TITLE != null)
                            {
                                <span>@Model.liExternalordercopydetails[0].COURSE_TITLE</span>
                            }
                        </td>
                        <td>
                            @if (Model.liExternalordercopydetails[0].DUE_DATE != null)
                            {
                                <span>@Model.liExternalordercopydetails[0].DUE_DATE</span>
                            }
                        </td>
                    }
                    else
                    {
                        <td colspan="4" class="text-center">No details found.</td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="panel-body p-0">
                    <!-- Workflow Tabs -->
                    <div class="workflow-tabs" id="workflowTabs">
                        <a href="javascript:void(0)" class="workflow-tab active" id="tab-1" onclick="showTab(1)">
                            <span class="tick-mark"><i class="fa fa-check-circle"></i></span>
                            1. Instructions
                        </a>
                        <a href="javascript:void(0)" class="workflow-tab disabled" id="tab-2" onclick="showTab(2)">
                            <span class="tick-mark"><i class="fa fa-check-circle"></i></span>
                            2. Syllabus Download
                        </a>
                        <a href="javascript:void(0)" class="workflow-tab disabled" id="tab-3" onclick="showTab(3)">
                            <span class="tick-mark"><i class="fa fa-check-circle"></i></span>
                            3. Question Entry
                        </a>
                        <a href="javascript:void(0)" class="workflow-tab disabled" id="tab-4" onclick="showTab(4)">
                            <span class="tick-mark"><i class="fa fa-check-circle"></i></span>
                            4. Claim Form
                        </a>
                    </div>

                    <!-- Tab Content Panes -->
                    <div class="tab-content-panel">
                        <!-- Pane 1: Instructions -->
                        <div id="pane-1" class="workflow-pane">
                            <div class="header-college text-center mb-4">
                                <h3>Instructions to the Question Setters:</h3>
                                <hr />
                            </div>
                            <div class="row">
                                <div class="col-md-9">
                                    <div class="instruction-list" style="max-height: 500px; overflow-y: auto; padding-right: 15px;">
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            1. This appointment must be treated as strictly confidential.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            2. For any clarification, contact only the Controller of Examinations.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            3. Carefully study the <b>syllabus, blueprint, and question paper pattern</b> before setting the paper.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            4. Provide all <b>required particulars</b> such as <b>Title of the Paper, Semester Number, Set Number</b>, etc., accurately.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            5. Questions must be drawn strictly from the <b>prescribed syllabus</b> and distributed fairly across all units, in line with the <b>blueprint</b>.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            6. Frame questions in accordance with <b>Bloom's Taxonomy</b>. Use the prescribed <b>action verbs</b>, and indicate the <b>knowledge level (K1-K6)</b> at the end of each question.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            7. Ensure all <b>technical terms, notations, and symbols</b> are written with precision.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            8. Questions should be <b>clear, specific, and unambiguous</b>.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            9. Marks allotted for each question and subdivision must be indicated, unless otherwise stated as <b>"All Questions Carry Equal Marks."</b>
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            10. Assign <b>running numbers</b> to all questions in sequence.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            11. Prepare a <b>scheme of valuation</b> with key answer points and a clear <b>marking breakup</b> for subdivisions.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            12. Submit the <b>question paper and scheme of valuation</b> to the official email ID: <b>sjccoe@gmail.com</b>.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            13. Claims for <b>remuneration and reimbursement of expenses</b> should be sent separately by post on the day of dispatch.
                                        </div>
                                        <div class="instruction-item">
                                            <i class="fa fa-caret-right"></i>
                                            14. Any documents / correspondence related to question setting should be dispatched only to:<br />
                                            <div style="margin-top:5px; padding-left: 20px;">
                                                <b>THE CONTROLLER OF EXAMINATIONS,</b><br />
                                                St. Joseph's College of Arts & Science (Autonomous),<br />
                                                St. Joseph's College Road, Cuddalore – 607 001., within one week from the date of receipt of this Communication.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-4 bg-light rounded text-center border">
                                        <i class="fa fa-file-text-o fa-4x text-primary mb-3"></i>
                                        <p class="font-weight-bold">Acknowledgement</p>
                                        <p class="small">I have read and understood all the instructions mentioned above.</p>
                                        <button class="btn btn-primary btn-workflow btn-block mt-3" onclick="completeStep(1)">Accept & Proceed</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pane 2: Syllabus -->
                        <div id="pane-2" class="workflow-pane" style="display:none">
                            <h3 class="mb-4">Syllabus Download</h3>
                            <div class="alert alert-info">
                                <i class="fa fa-download mr-2"></i> Please download and review the syllabus for the allotted course(s) before entering the questions.
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped">
                                    <thead>
                                        <tr class="bg-primary text-white">
                                            <th>Course Code</th>
                                            <th>Course Title</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.liExternalordercopydetails != null)
                                        {
                                            foreach (var item in Model.liExternalordercopydetails)
                                            {
                                                <tr>

                                                    <td>@item.COURSE_TITLE</td>
                                                    <td class="text-center">
                                                        <a href="javascript:void(0)" class="btn btn-sm btn-success" onclick="downloadSyllabus('@item.COURSE_ID')">
                                                            <i class="fa fa-file-pdf-o"></i> Download Syllabus
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-center mt-4">
                                <button class="btn btn-primary btn-workflow" id="btnNextSyllabus" onclick="completeStep(2)">Proceed to Question Entry</button>
                            </div>
                        </div>

                        <!-- Pane 3: Question Entry -->
                        <div id="pane-3" class="workflow-pane" style="display:none">
                            <h3 class="mb-4">Question Entry</h3>
                            <div id="questionEntryContent">
                                <div class="panel-body">
                                    <div class="form-horizontal">
                                        <div class="row" style="margin-bottom: 20px;">
                                            <div class="col-md-4 form-group">
                                                @Html.Label("Exam Name", htmlAttributes: new { @class = "control-label col-md-4" })
                                                <div class="col-md-8">
                                                    @Html.DropDownListFor(model => model.ExamSetting, ViewBag.ExamSettings as SelectList ?? Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @id = "ddlExamSetting", @data_live_search = "true" })
                                                </div>
                                            </div>
                                            <div class="col-md-4 form-group">
                                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                                <div class="col-md-9">
                                                    @Html.DropDownListFor(model => model.Course, ViewBag.Courses as SelectList ?? Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control selectpicker show-menu-arrow show-tick", @id = "ddlCourse", @data_live_search = "true" })
                                                </div>
                                            </div>
                                            <div class="col-md-3 form-group">
                                                <a class="btn btn-primary" id="btnGet" onclick="GetPattern()"><i class="fa fa-search"></i> Get Pattern</a>
                                                &nbsp;
                                                <a class="btn btn-success" id="btnPreview" onclick="PreviewQuestionPaper()" style="display:none;"><i class="fa fa-eye"></i> Preview</a>
                                            </div>
                                        </div>

                                        <div class="row" id="divMainContent" style="display:none;">
                                            <!-- Left Column: Blooms Taxonomy -->
                                                <div class="col-md-1 bloom-sidebar">
                                                    <h5 class="text-center" style="font-weight:bold; font-size:12px;">Taxonomy</h5>
                                                    
                                                    <div class="mathjax-sidebar-btn" onclick="OpenMathModal()" style="background-color: #5bc0de; margin-bottom: 10px;">
                                                        <i class="fa fa-superscript fa-lg"></i><br /><span style="font-size: 11px;">Maths</span>
                                                    </div>
                                                    <div class="mathjax-sidebar-btn" onclick="OpenChemModal()" style="background-color: #f0ad4e; margin-bottom: 10px;">
                                                        <i class="fa fa-flask fa-lg"></i><br /><span style="font-size: 11px;">Chem</span>
                                                    </div>
                                                    <div class="mathjax-sidebar-btn" onclick="OpenImagePicker()" style="background-color: #43a047; margin-bottom: 20px;">
                                                        <i class="fa fa-image fa-lg"></i><br /><span style="font-size: 11px;">Image</span>
                                                    </div>

                                                    @if (ViewBag.BloomsTaxonomy != null)
                                                    {
                                                        int counter = 1;
                                                        foreach (var bloom in (IEnumerable<CMS.ViewModel.Model.BLOOMS_TAXONOMY_MASTER>)ViewBag.BloomsTaxonomy)
                                                        {
                                                            var cssClass = "bloom-k" + ((counter > 6) ? 6 : counter);
                                                            <div class="bloom-box @cssClass" onclick="showBloomDetails('@bloom.k_level', '@Html.Raw(HttpUtility.JavaScriptStringEncode(bloom.cognitive_process))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(bloom.description))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(bloom.action_verbs))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(bloom.sample_question_stems))')">
                                                                K @bloom.k_level
                                                            </div>
                                                            counter++;
                                                        }
                                                    }
                                                </div>

                                            <!-- Right Column: Question Entry Panel -->
                                            <div class="col-md-11 question-panel" id="divPatternDetails">
                                                <!-- Content will be loaded dynamically here via Ajax -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="text-center">
                                <button class="btn btn-success btn-workflow" id="btnCompleteQuestions" style="display:none" onclick="completeStep(3)">Complete & Finalize Entry</button>
                            </div>
                        </div>

                        <!-- Pane 4: Claim Form -->
                        <div id="pane-4" class="workflow-pane" style="display:none">
                            <div id="claimPrintArea" class="p-4 border bg-white" style="color: #333; font-family: 'Times New Roman', serif; line-height: 1.5;">
                                <div class="text-center mb-4">
                                    <h3 class="m-0" style="font-weight: bold;">St. Joseph's College of Arts & Science (Autonomous)</h3>
                                    <p class="m-0">(Re-Accredited by NAAC with A Grade 4<sup>th</sup> Cycle)</p>
                                    <p class="m-0">St. Joseph's College Road, Cuddalore – 607 001.</p>
                                    <h4 class="mt-3" style="text-decoration: underline; font-weight: bold;">CLAIM FOR QUESTION PAPER SETTING - NOVEMBER 2025</h4>
                                </div>

                                <table class="table table-bordered border-dark claim-table" style="border: 2px solid #000; width: 100%;">
                                    <tr>
                                        <td width="20%"><b>Programme</b></td>
                                        <td width="30%"><input type="text" class="form-control-plaintext p-0" /></td>
                                        <td width="20%"><b>Course Code</b></td>
                                        <td width="30%"><input type="text" class="form-control-plaintext p-0" /></td>
                                    </tr>
                                    <tr>
                                        <td><b>Title of the Course</b></td>
                                        <td colspan="3"><input type="text" class="form-control-plaintext p-0" value="@(Model.liExternalordercopydetails != null && Model.liExternalordercopydetails.Count > 0 ? Model.liExternalordercopydetails[0].COURSE_TITLE : "")" /></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="text-center"><b>Remuneration</b></td>
                                        <td class="text-center"><b>@@NO OF QUESTION<br />& SCHEME</b></td>
                                        <td class="text-center"><b>TOTAL</b></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <b>UG Question:</b> Rs.500/- <span class="ml-4"><b>SOV:</b> Rs.200/-</span>
                                        </td>
                                        <td><input type="number" class="form-control text-center claim-calc" id="qtyUG" oninput="calculateClaim()" value="0" /></td>
                                        <td><input type="text" class="form-control text-right" id="totalUG" readonly value="0.00" /></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <b>PG Question:</b> Rs.700/- <span class="ml-4"><b>SOV:</b> Rs.200/-</span>
                                        </td>
                                        <td><input type="number" class="form-control text-center claim-calc" id="qtyPG" oninput="calculateClaim()" value="0" /></td>
                                        <td><input type="text" class="form-control text-right" id="totalPG" readonly value="0.00" /></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-right"><b>Postal Charges:</b> (original receipt should be enclosed)</td>
                                        <td><input type="number" class="form-control text-right claim-calc" id="postalCharges" oninput="calculateClaim()" value="0" /></td>
                                    </tr>
                                    <tr style="background: #fdfdfd;">
                                        <td colspan="3" class="text-right"><b>Total Claim (QTN+SCHEME+POSTAL)</b></td>
                                        <td><input type="text" class="form-control text-right font-weight-bold" id="grandTotal" readonly value="0.00" /></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4"><b>Rupees (in words) :</b> <span id="rupeesInWords" class="ml-2 font-italic"></span></td>
                                    </tr>
                                </table>

                                <table class="table table-bordered border-dark mt-3" style="border: 2px solid #000; width: 100%;">
                                    <tr><td width="30%"><b>Name :</b></td><td><input type="text" class="form-control-plaintext p-0" value="@(Model.liExternalordercopydetails != null && Model.liExternalordercopydetails.Count > 0 ? Model.liExternalordercopydetails[0].FIRST_NAME : "")" /></td></tr>
                                    <tr><td><b>Mobile No:</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                    <tr><td><b>Designation:</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                    <tr><td><b>Official Address:</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                    <tr><td><b>Ac/ No :</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                    <tr><td><b>Bank:</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                    <tr><td><b>Branch:</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                    <tr><td><b>IFS Code:</b></td><td><input type="text" class="form-control-plaintext p-0" /></td></tr>
                                </table>

                                <div class="mt-4">
                                    <p><b>Declaration:</b></p>
                                    <p style="text-indent: 30px;">I hereby declare that, the above mentioned claim amount is a part of my taxable income and I am responsible for the same.</p>

                                    <div class="row mt-5">
                                        <div class="col-xs-6 pt-4">
                                            <p><b>Signature:</b> ____________________</p>
                                        </div>
                                        <div class="col-xs-6 text-right small">
                                            <p>NOTE: Account number & IFS Code should be in full form.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-4 no-print pb-5">
                                <button class="btn btn-success btn-lg" id="btnSubmitClaim" onclick="submitClaim()">
                                    <i class="fa fa-save"></i> Submit Claim Form
                                </button>
                                <button class="btn btn-primary btn-lg" id="btnPrintClaim" style="display:none" onclick="printClaim()">
                                    <i class="fa fa-print"></i> Print Original Claim Form
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Bloom's Taxonomy Modal -->
<div class="modal fade" id="BloomModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title" id="bloomModalTitle">Bloom's Taxonomy Details</h4>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tbody>
                        <tr><th style="width: 30%;">Cognitive Process</th><td id="tdCognitiveProcess"></td></tr>
                        <tr><th>Description</th><td id="tdDescription"></td></tr>
