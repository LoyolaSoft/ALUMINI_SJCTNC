@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{
    ViewBag.Title = "QuizMarkMove";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Quiz Mark Move</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Quiz Mark Move<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Quiz Mark Move</h4>
                </div>
                <div class="panel-body">
                    <div class="col-md-12 form-horizontal">
                        <div class="col-md-5 form-group">
                            @Html.Label("Class List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-5 form-group">
                            @Html.Label("Course List", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3 form-group">
                            @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <select class="form-control selectpicker show-menu-arrow show-tick" data-live-search="true" id="ddlSetting">
                                    <option value="0"> -- Select -- </option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-5 form-group">
                            @Html.Label("Component", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ComponentList, (Model.ComponentList != null) ? Model.ComponentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ComponentList, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="col-md-12">
                            <div id="dvBind"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad()
    {
        // Document Ready Function ...
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }

    // On Class Change ...
    $('#ClassList').on('change', function ()
    {
        var inp = $('#ClassList').val();
        $('#CourseList').empty();

        if ($('#ClassList').val())
        {
            $.ajax({
                url: "@Url.Action("FethCourseByClassId", "Examination")",
                method:'POST',
                datatype:'json',
                data: { Class_Id: inp },
                success: function (data)
                {
                    $('#CourseList').append('<option value="0" >---Select---</option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                },error: function (ex)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    });

    $("#CourseList").on("change", function ()
    {
        if ($("#CourseList").val() != 0)
        {
            $.ajax({
                url: "@Url.Action("FetchSettingInfoByClassAndCourseIds", "Examination")",
                method: "POST",
            datatype: "json",
                data: { sClassId: $("#ClassList").val(), sCourseId: $("#CourseList").val() },
            success: function (data)
            {
                $("#ddlSetting").empty();
                if (data.Message != null && data.Message != '')
                {
                    alert(data.Message);
                } else
                {
                    $("#ddlSetting").append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                alert('Internal Server Error .!');
            }
        });
    }
    });


    $('#ddlSetting').change(function () {

        if ($('#ClassList').val() && $('#CourseList').val() && $('#ddlSetting').val())
        {
            $.ajax({
                  url:"@Url.Action("BindQuizMarkBySetting", "Examination")",
                type: "post",
                data: { sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sSettingId: $("#ddlSetting").val() },
                success:function(data)
                  {
                      if(data.Message!=null && data.Message!='')
                      {
                          alert(data.Message)
                      }
                      else {

                          $('#divBind').empty();
                          $('#divBind').append(data);
                          $('.selectpicker').selectpicker('refresh');
                      }
                  },
                  error:function(ex)
                  {
                      alert('Internal Server Error !');
                  }
            });
        }
        else {
            alert("Pleas Select All the fields")
        }
    });


</script>


