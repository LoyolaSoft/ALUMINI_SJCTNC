@model CMS.ViewModel.ViewModel.ExaminationViewModel

@{ 
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">List Exam Registration</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Exam Registration<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Exam Registration</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">

                    <div class="form-group  col-md-12">

                        <div class="col-md-4">
                            @Html.Label("Setting", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(),"-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ExamSetting, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("Class", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            @Html.Label("Student", htmlAttributes: new { @class = "col-md-3 control-label " })
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.StudentList, (Model.StudentList != null) ? Model.StudentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control  selectpicker", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.StudentList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>


                <div id="dvExamRegistrationbind"></div>
            }
         
        </div>

    </div>
</div>
<!-- end #content -->
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>

<script>
    $('#ClassList').on('change', function ()
    {
        $('#StudentList').empty();
        $.ajax({
            url:'@Url.Action("FetchStudentByClassId", "Examination")',
            method:'POST',
            datatype: 'json',
            data: { sClassId: $('#ClassList').val() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#StudentList').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $('#StudentList').on('change', function ()
    {
        BindGrid();
    });

    function BindGrid()
    {
        if ($('#StudentList').val() && $('#ClassList').val() && $('#ExamSetting').val())
        {
            $.ajax({
                url: '@Url.Action("BindStudentExamRegistration", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sExamSettingId: $('#ExamSetting').val(), sClassId: $('#ClassList').val(), sStudentId: $('#StudentList').val() },
                success: function (data)
                {
                    $('#dvExamRegistrationbind').empty();
                    $('#dvExamRegistrationbind').append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }


    function DeleteExamRegistration(Id,CourseId,StudentId)
    {
        if (Id != null && Id != '')
        {
            $.ajax({
                url:'@Url.Action("DeleteRegistration", "Examination")',
                method:'POST',
                datatype:'json',
                data: { sExamRegistrationId: Id, sCourseId: CourseId, sStudentId: StudentId, sExamSettingId: $('#ExamSetting').val() },
                success: function (data)
                {
                    if (data.ErrorCode == "200")
                    {
                        swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        BindGrid();
                    } else
                    {
                        swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }


    function SubmitData()
    {
        var sJsonData = '{"STUDENT_ID":"' + $('#StudentList').val() + '",\
                          "COURSE_ID":"' + $('#CourseList').val() + '",\
                          "STATUS":"' + $('#CourseList Option:selected').attr('cms-sStatus') + '",\
                          "EXAM_SEMESTER":"' + $('#CourseList Option:selected').attr('cms-sSemesterId') + '",\
                          "EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '"}';
        $.ajax({
            url:'@Url.Action("SaveRegistration", "Examination")',
            method:'POST',
            datatype: 'json',
            data: { sJson: sJsonData },
            success: function (data)
            {
                if (data.ErrorCode == "200") {
                    swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    BindGrid();
                } else {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>