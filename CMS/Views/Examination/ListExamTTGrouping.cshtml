@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListExamTTGrouping";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List ExamTTGrouping</li>
    </ol>
    <h1 class="page-header">List ExamTTGrouping</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List ExamTTGrouping</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#ExamTTGrouping" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Click to Add">Add</i></a>
            </div>
            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblExamTTGrouping">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Setting</th>
                            <th>Session</th>
                            <th>Programme Level</th>
                            <th>Programme Year</th>
                            <th>Set</th>
                            <th>Order</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.LiExamttGrouping != null && Model.LiExamttGrouping.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.LiExamttGrouping)
                            {
                                <tr>
                                    <td>@{count++;}@count</td>
                                    <td>@item.EXAM_NAME</td>
                                    <td>@item.EXAM_SESSION</td>
                                    <td>@item.PROGRAMME_LEVEL</td>
                                    <td>@item.PROGRAMME_YEAR</td>
                                    <td>@item.SET_NAME</td>
                                    <td>@item.GROUP_ORDER</td>
                                    <td>
                                        <a href="#ExamTTGrouping" onclick="FetchItemDetails(@item.TT_GROUP_ID)" data-toggle="modal" title="Click to Add/Edit" class="text-primary"><i class="fa fa-edit"></i></a>
                                        <a href="javascrip:;" onclick="GetConfirm(@item.TT_GROUP_ID)" class="text-danger" title="Click to Delete"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                            }

                                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="ExamTTGrouping">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <input type="text" id="itemid" class="hidden">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Setting</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Exam Session</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSession, (Model.ExamSession != null) ? Model.ExamSession : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Programme Level</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Programme Year</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ProgrammeYear, (Model.ProgrammeYear != null) ? Model.ProgrammeYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Set</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Set, (Model.Set != null) ? Model.Set : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true", })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Order</label>
                                <div class="col-md-9">
                                    <input type="number" class="form-control" id="txtGroupOrder" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('#tblExamTTGrouping').DataTable();
    function FetchItemDetails(ID) {
        if (ID != null) {
            $.ajax({
                url: "@Url.Action("FetchExamTTGrouping", "Examination")",
                type: "post",
                data: { sExamttGroupId: ID },
                success: function (data) {
                    if (data != null) {
                        $('#ExamSetting').val(data.EXAM_SETTING_ID);
                        $('#ExamSession').val(data.EXAM_SESSION_ID);
                        $('#ApplicationType').val(data.PROGRAMME_LEVEL);
                        $('#ProgrammeYear').val(data.PROGRAMME_YEAR);
                        $('#Set').val(data.SET_ID);
                        $('#txtGroupOrder').val(data.GROUP_ORDER);
                        $('#itemid').val(data.TT_GROUP_ID);
                        $('.selectpicker').selectpicker('refresh');
                    }
                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function () {
        var isValid = true;
        var JsonData = null;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }
        JsonData = '{"TT_GROUP_ID":"' + $('#itemid').val() + '","EXAM_SETTING_ID":"' + $('#ExamSetting').val() + '","PROGRAMME_LEVEL":"' + $('#ApplicationType').val() + '","PROGRAMME_YEAR":"' + $('#ProgrammeYear').val() + '","EXAM_SESSION_ID":"' + $('#ExamSession').val() + '","SET_ID":"' + $('#Set').val() + '","GROUP_ORDER":"' + $('#txtGroupOrder').val() + '"}';
        $.ajax({
            url: "@Url.Action("SaveorUpdateExamTTGrouping", "Examination")",
            type: "post",
            data: { sJsonData: JsonData },
            success: function (data) {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Examination/ListExamTTGrouping');

            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    GetConfirm = function (ID) {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "@Url.Action("DeleteExamTTGrouping", "Examination")",
        type: "post",
        data: { sExamttGroupId: ID },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/Examination/ListExamTTGrouping');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }
    });
});

    }


</script>

