@model CMS.ViewModel.ViewModel.ExaminationViewModel

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Online Exam Invigilation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Online Exam Invigilation<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Online Exam Invigilation</h4>
                </div>
                <div class="panel-body">
                    <div class="col-md-12 form-horizontal table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Exam Time</th>
                                    <th>Class Code</th>
                                    @*<th>Class Name</th>*@
                                    @*<th>Staff Code</th>*@
                                    <th>Staff Name</th>
                                    <th>Link</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liClassList != null && Model.liClassList.Count > 0)
                                {
                                    int nCount = 0;
                                    foreach (var item in Model.liClassList)
                                    {
                                        <tr>
                                            <td>@{nCount++;} @nCount</td>
                                            <td>@item.EXAM_TIME</td>
                                            <td>@item.CLASS_CODE</td>
                                            @*<td>@item.CLASS_NAME</td>*@
                                            @*<td>@item.STAFF_CODE</td>*@
                                            <td>@item.FIRST_NAME</td>
                                            <td><a href="@item.ONLINE_CLASS_LINK" target="_blank"> Click Here</a></td>
                                        </tr>
                                                    }
                                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
                                                }
</div>

<script>
    function ContentLoad()
    {
        // Document.ready function
    }
</script>