@model CMS.ViewModel.ViewModel.ExaminationViewModel


@{
    Layout = null;
    int nCount = 0;
    string sClass = string.Empty;
    string sExamPass = string.Empty;
}



<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Examination</a></li>
        <li class="active">Semester Result</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Semester Result<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Semester Result</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="col-md-12 form-group text-center">
                    @{
                        if (Model.liCollegeDetails != null && Model.liCollegeDetails.Count > 0)
                        {
                            <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h3>
                            <h4>@Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>"))</h4>
                            <h5>@Model.liCollegeDetails.FirstOrDefault().PLACE</h5>
                            <h5> <b> Semester Result For  @if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                            { @Model.liSemesterList.FirstOrDefault().M_PASS }  </b> </h5>
                        }
                    }
                </div>
                <div class="col-md-12 form-group table-responsive">
                    @{
                        if (!string.IsNullOrEmpty(Model.sErrorMessage))
                        {
                            <div class="alert alert-danger"> @Model.sErrorMessage </div>
                        }
                        else if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                        {
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Semester</th>
                                        <th>Code</th>
                                        <th>Course</th>
                                        <th>CIA</th>
                                        <th>Semester</th>
                                        <th>Total</th>
                                        <th>Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.liSemesterList != null && Model.liSemesterList.Count > 0)
                                        {
                                            foreach (var item in Model.liSemesterList)
                                            {
                                                sClass = string.Empty;
                                                if (item.RESULT != "P" && item.RESULT != "M")
                                                {
                                                    sClass = "text-danger";
                                                }
                                                <tr class="@sClass">
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.SEMESTER_ID</td>
                                                    <td>@item.COURSE_CODE</td>
                                                    <td>@item.COURSE_TITLE</td>
                                                    <td>@item.INTERNAL_MARK</td>
                                                        @if (item.RESULT != "W")
                                                        {
                                                            <td>
                                                                @item.EXTERNAL_MARK
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>--</td>
                                                        }
                                                        @if (item.RESULT != "W")
                                                        {
                                                        <td>
                                                            @item.TOTAL
                                                        </td>
                                                        }
                                                        else
                                                        {
                                                            <td>--</td>
                                                        }
                                                    <td>@item.RESULT</td>
                                                </tr>
                                             }
                                         }
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>

                <div class="col-md-12">
                    <pre> AA : Absent , W : With Held , F : Fail , P : Pass , M : Moderation</pre>
                </div>
         }
        </div>
    </div>
</div>

