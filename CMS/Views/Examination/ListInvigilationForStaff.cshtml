@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListInvigilationForStaff";
    Layout = null;
    int count = 0;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">List  Invigilation</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> List  Invigilation</h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">List Invigilation</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                               <table class="table table-bordered">
                                   <thead>
                                       <tr>
                                           <td>#</td>
                                           <td>Exam</td>
                                           <td>Course Code</td>
                                           <td>Session</td>
                                           <td>View</td>
                                           <td>Action</td>                                                                                    
                                       </tr>
                                   </thead>
                                   <tbody>
                                       @if (Model.liexaminvigilation != null && Model.liexaminvigilation.Count > 0)
                                       {
                                           string sActive=string.Empty;
                                           string sActiveText = string.Empty;
                                           foreach (var item in Model.liexaminvigilation)
                                           {
                                               count++;
                                               if (item.IS_ACTIVE=="1")
                                               {
                                                   sActive = "btn btn-danger";
                                                   sActiveText = "De-Activate";
                                               }
                                               else
                                               {
                                                   sActive = "btn btn-success";
                                                   sActiveText = "Activate";
                                               }
                                               <tr>
                                                   <td>@count</td>
                                                   <td>@item.EXAM_NAME</td>
                                                   <td>@item.COURSE_CODE</td>
                                                   <td>@item.START_TIME</td>
                                                   <td><a href="javascript:;" onclick="loadContent('/Examination/BindSutdentForInvigilator?sExamsettingId=@item.EXAM_SETTING_ID&sCourse=@item.COURSE_ID&sStaffId=@item.EXAM_INVIGILATOR_ID&sTimetableId=@item.TIMETABLE_ID')"><i class="fa fa-eye"></i></a></td>
                                                   <td><a href="javascript:;" class="@sActive" onclick="ActiveOrDeActive('@item.EXAM_SETTING_ID','@item.COURSE_ID','@item.EXAM_INVIGILATOR_ID','@item.IS_ACTIVE','@item.TIMETABLE_ID')"> @sActiveText</a></td>
                                               </tr>
                                           }
                                       }
                                       else
                                       {
                                       <tr>
                                           <td colspan="5">No Records Found...!</td>
                                       </tr>
                                       }
                                   </tbody>
                                </table>
                            </div>                                                    
                            <div class="col-md-12" id="bindstudentforinvigilation">

                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>


<!-- Begin Modal -->

<div class="modal" id="violationmodal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Violation Details</h4>
            </div>
            <div class="modal-body">
                <div class="" id="bindstudentviolation">

                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="examsettingid">
<input type="hidden" id="courseid">
<input type="hidden" id="staffid">

<!-- End Modal -->
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>

    @*function GetStudentList(ExamSetting,CourseId,StaffId)
    {
        if (ExamSetting != "" && CourseId != "" && StaffId!="")
        {
            $('#examsettingid').val(ExamSetting);
            $('#courseid').val(CourseId);
            $('#staffid').val(StaffId);
            $.ajax({
                url: "@Url.Action("BindSutdentForInvigilator", "Examination")",
                method: "POST",
            datatype: "json",
            data: { sExamsettingId: ExamSetting, sCourse: CourseId, sStaffId: StaffId },
            success: function (data)
            {
                $('#bindstudentforinvigilation').empty();
                $('#bindstudentforinvigilation').append(data);
                
            }, error: function (error)
            {
                alert('Internal Server Error .....!');
            }
        });
    }

    }*@
   
</script>

<script>
    function ActiveOrDeActive(ExamSettingId,CourseId,InvigilatorId,IsActive,TimeTableId)
    {
        var sContent = "Activate";
        var sbtnColor = "btn-success";
        if (IsActive=="1")
        {
            sContent = "De-Activate";
            sbtnColor = "btn-danger";
        }
        swal({
            title: "Are you sure?",
            text: "Your sure to " + sContent + " Exam For This Course !",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: sbtnColor,
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: '@Url.Action("ActivateOrDeActivateExamByInvigilator", "Examination")',
                method: 'POST',
                datatype: 'json',
                data: { sExamSettingId: ExamSettingId, sCourseId: CourseId, sInvigilatorId: InvigilatorId, sIsActive: IsActive, sTimeTableId: TimeTableId },
                success: function (data)
                {
                    if (data.ErrorCode == '200')
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        loadContent('/Examination/ListInvigilationForStaff');
                    }
                    else
                    {
                        swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        });
    }
</script>