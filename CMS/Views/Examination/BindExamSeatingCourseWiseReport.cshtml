@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{ int count = 0;}
<div class="form-group table-responsive" id="dvCourseWiseReport">
    <table class="table table-bordered" style="text-align:left;" border="1">
        <thead>
            <tr>
                <th>#</th>
                <th>Block</th>
                <th>Room</th>
                @*<th>ExamDate</th>
                <th>ExamSession</th>*@
                <th>Class</th>
                @*<th>Course Code</th>*@
                <th>Course</th>  
                <th>Count</th>            
            </tr>
        </thead>
        <tbody>
            @if (Model.LiExamSeatingAllotment != null && Model.LiExamSeatingAllotment.Count() > 0)
            {
                foreach (var item in Model.LiExamSeatingAllotment)
                {
                    <tr>
                        <td> @{count++;}@count</td> 
                        <td> @item.BLOCK_NAME </td>
                        <td> @item.ROOM_NO </td>
                        @*<td> @item.EXAM_DATE </td>
                        <td> @item.EXAM_SESSION </td>*@
                        <td> @item.CLASS_NAME </td>
                        @*<th>@item.COURSE_CODE </th>*@
                        <td> @item.COURSE_TITLE </td>
                        <td> @item.STUDENT_COUNT </td>                        
                    </tr>
                }
            }
        </tbody>
    </table>
</div>