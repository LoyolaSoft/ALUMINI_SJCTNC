@model CMS.ViewModel.ViewModel.ExaminationViewModel
@{
    ViewBag.Title = "ListonlineExamQuestion";
    Layout = null;
    
}


<style>
    .note-editing-area {
        max-height: 65px;
    }
</style>
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a @*href="@Url.Action("Staff","Dashboard")"*@ href="javascript:;">Home</a></li>
        <li class="active">List  Questions </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header"> List  Questions </h1>
    <!-- end page-header -->
    <!-- begin row -->
    <div class="row">
        <!-- begin col-12 -->
        <div class="col-md-12">
            <!-- begin panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title"> List  Questions</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-2 form-group">
                                @Html.Label("Year", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ExamSetting, (Model.ExamSetting != null) ? Model.ExamSetting : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="col-md-3 form-group">
                                @Html.Label("Semester", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-1 form-group">
                                <a class="btn btn-primary" id="btnGet"> Get </a>
                            </div>

                            <div class="col-md-12" id="bindexamquestions">
                                
                            </div>
                        </div>
                       
                    </div>
                </div>
            </div>
            <!-- end panel -->
        </div>
        <!-- end col-6 -->
    </div>
    <!-- end row -->
</div>


<!-- Begin Modal -->

<div class="modal" id="AddorEditModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Quiz</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12 form-group">

                                <div class="col-md-2 form-group">
                                    @*<a href="javascript:;" onclick="AddTextBox();" class="btn btn-success"><i class="fa fa-plus"> Add </i></a>*@
                                </div>
                                <div class="col-md-2 form-group">
                                    <a class="btn btn-success" href="#equation-dialog" data-toggle="modal"><i class="fa fa-plus"> Equation </i></a>
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                <div id="Question">
                                    <label class="col-md-2 control-label">Title</label>
                                    <div class="col-md-10" id="divQuestion">
                                        <div id="TxtTitle" class="summernote form-control" placeholder="Enter Your Title"></div>
                                        @*<input type="text" id="TxtTitle" class="summernote form-control" placeholder="Enter Your Title" maxlength="200">*@
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 form-group hidden" id="dvMathTheFollowing">
                                <div class="col-md-6">
                                    <div id="dvOptions1"></div>
                                </div>
                                <div class="col-md-6">
                                    <div id="dvOptions2"></div>
                                </div>
                            </div>

                            <div class="col-md-12 form-group" id="dvOtherType">
                                <div id="dvOptions3"></div>
                            </div>

                            <div class="form-group col-md-12" id="answerdiv">
                                <div class="col-md-8 form-group hidden" id="Answer">
                                    <label class="col-md-3 control-label">Answer</label>
                                    <div class="col-md-9" id="divAnswer">
                                        @*<input type="text" id="txtAnswer" class="form-control" placeholder="Enter Your Correct Option No" style="width:140%" min="0">*@
                                        <div id="txtAnswer" class="summernote form-control" placeholder="Enter Your Title"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <label id="l"></label>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->
<!-- Hidden Filed -->
<input type="text" class="hidden" id="hdQuestionId" />
<!-- Hidden Filed -->
@*<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>*@
<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>


<script>
    $('.selectpicker').selectpicker({
        size: 5
    });
    var Count = 0;
    var sQuestionType = '';
    var sOptionCode = [];

    function ContentLoad() {
        // Document Ready Function .
        $('#tblquestions').DataTable();
        var liMessage = $('#hdErrorMessage').val();
        if (liMessage != null && liMessage != '') {
            alert(liMessage);
        }
        handleSummernote();
        $('#TxtTitle').summernote({
            height: 400,                 // set editor height
            minHeight: 400,             // set minimum height of editor
            maxHeight: 400,          // set maximum height of editor
            focus: true                  // set focus to editable area after initializing summernote
        });
    }

    handleSummernote = function () {
        $(".summernote").summernote({
            placeholder: "Add Your Option"
        })
    }
    // $('.note-editable').css("height", "882");

    function DeleteSummerNoteHeader() {

        $('#dvOptions3').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions2').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#dvOptions1').find(".form-group").each(function () {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        $('#answerdiv').find(".form-group").each(function ()
        {
            $(this).find(".note-toolbar").remove();
            $(this).find(".note-statusbar").remove();
            $(this).find(".note-editing-area").css("border", "1px solid");
            $(this).find(".note-editable").html("");
            $(this).find(".note-editable").css("height", "50px");
        });
        //$('#divQuestion').find(".note-toolbar").remove();
        //$('#divQuestion').find(".note-editing-area").css("border", "1px solid");
    }
    $('#AcademicYearList').on('change', function ()
    {
        $.ajax({
            url: "@Url.Action("FetchExamSettingByAcYear", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sAcYear: $('#AcademicYearList option:selected').html() },
            success: function (data)
            {
                $("#ExamSetting").empty();
                $("#ExamSetting").append(data.sResult);
                $('.selectpicker').selectpicker('refresh');
            }, error: function (error) {
                alert('Internal Server Error .....!');
            }
        });
    });

    $("#Semester").on("change", function ()
    {
        var acyear = $("#AcademicYearList option:selected").html();
        var sem = $("#Semester").val();

        if ($("#AcademicYearList").val() && $("#Semester").val())
        {
            $.ajax({
                url: "@Url.Action("FethCourseByAcademicyearandSemester", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sAcyear: acyear, sSemster: sem },
                success: function (data) {
                    $("#CourseList").empty();
                    $("#CourseList").append('<option value=""> -- Select -- </option>' + data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else
        {
            alert('Please Select the Fields ...!')
        }
    });

    $('#btnGet').on('click', function ()
    {
        var acyear = $("#AcademicYearList option:selected").html();
        if ($('#AcademicYearList').val() && $('#ExamSetting').val() && $('#Semester').val() && $('#CourseList').val())
        {
            $.ajax({
                url: "@Url.Action("BindOnlineExamObjectiveQuestions", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sAcyear: acyear, sExamSettingId: $('#ExamSetting').val(), sSemster: $('#Semester').val(), sCourse: $('#CourseList').val() },
                success: function (data)
                {
                    $("#bindexamquestions").empty();
                    $("#bindexamquestions").append(data);
                    $('#tblquestions').DataTable();
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    alert('Internal Server Error .....!');
                }
            });
        }
        else {
            alert('Please Select the Fields...!');

        }
    });

    function FetchQuestionsById(QUESTION_ID, e)
    {
        sOptionCode = [];
        var Option = '';
        var Option2 = '';
        var Question = $(e).attr("cms-question");
     
        $('#hdQuestionId').val(QUESTION_ID);
        $.ajax({
            url: "@Url.Action("FetchOnlineExamQuestionsByQuestionId", "Examination")",
            method: "POST",
            datatype: "json",
            data: { sQuestionId: QUESTION_ID },
            success: function (data)
            {
                if (data.sErrorMessage != null && data.sErroeMessage != '')
                {
                    alert(data.sErroeMessage);
                } else
                {
                    //$('#Mark').addClass('hidden');
                    $("#dvOptions1").empty();
                    $("#dvOptions2").empty();
                    $("#dvOptions3").empty();
                 
                    var sSummerObject =
                    [{
                        summerval: "",
                        elementid: ""
                    }];
                    var sAnswerCode = "";                  
                    $('#dvOtherType').removeClass('hidden');
                 
                    $.each(data, function (i, Questions)
                    {
                        sOptionCode.push(Questions.OPTIONS);

                        if (Questions.ANSWER != null && Questions.ANSWER != '')
                        {                          
                            // var sHtmlStr = decodeURIComponent(escape(window.atob(Quiz.ANSWER)));
                            var AnswerOption = "";
                            if (Questions.ANSWER == Questions.OPTIONS) {
                                sAnswerCode = Questions.OPTIONS;
                            }
                        }
                        var j = i;
                        j++;
                        Option += '<div class="form-group" id="Qustion_' + i + '">';
                        Option += '<label class ="col-md-2 control-label">' + j + ' .)</label>';
                        Option += '<div class="col-md-10">';
                        //decodeURIComponent(escape(window.atob(data[i].OPTION)))
                        Option += '<input type="text" value="" cms-OptionId="' + Questions.OPTION_ID + '" id="Option' + i + '" class="summernote form-control" placeholder="Enter Your Options" maxlength="145">';
                        sSummerObject.push({ summerval: decodeURIComponent(escape(window.atob(data[i].OPTIONS))), elementid: "Option" + i });                     
                        Option += '</div>';
                        Option += '</div>';                 
                        Count = i;
                    });

                    $('#Answer').removeClass('hidden');
                    $("#dvOptions3").append(Option);

                    $("#TxtTitle").summernote('code', decodeURIComponent(escape(window.atob(Question))));
                    handleSummernote();
                    DeleteSummerNoteHeader();
                    AddSummerNoteValues(sSummerObject);
                    //$('#txtAnswer').val(GetOptionIndexFromOption(sAnswerCode));
                    $("#txtAnswer").summernote('code', decodeURIComponent(escape(window.atob(sAnswerCode))));

                }
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    }

    function GetOptionIndexFromOption(sAnswerCode) {

        var optionIndex;
        if (sAnswerCode != "" && sAnswerCode != null) {

            for (var i = 0; i < sOptionCode.length; i++) {

                if (sOptionCode[i] == sAnswerCode) {

                    optionIndex = parseInt(i) + 1;
                }
            }
        }

        return optionIndex;
    }

    function AddSummerNoteValues(sSummerObject) {


        for (var i = 1; i < sSummerObject.length; i++) {

            $("#" + sSummerObject[i].elementid + "").summernote('code', sSummerObject[i].summerval);
        }
    }




    function AddTextBox() {
        Count++;
        var i = Count;
        var j = Count + 1;
        if (j > 10) {
            alert('Invalid Option .! Maximum Option is 10 .');
            Count--;
            return false;
        }
        // alert(sQuestionType);

        if (sQuestionType == "3") {
            // Bind Match The Following Type Empty Text Box ....
            var Option = '';
            Option += '<div class="form-group" id="Qustion_' + i + '">';
            Option += '<label class = "control-label col-md-3">' + j + ' .)</label>';
            Option += '<div class="col-md-9">';
            Option += '<input type="text" value="" id="Qustions' + i + '" cms-OptionId="" class="summernote form-control" placeholder="Enter Your Questions"  maxlength="145">';
            Option += '</div>';
            Option += '</div>';
            $('#dvOptions1').append(Option);

            var Option2 = '';
            Option2 += '<div class="form-group" id="Option_' + i + '">';
            Option2 += '<div class="col-md-12">';
            Option2 += '<input type="text" value="" id="Option' + i + '" class="summernote form-control" placeholder="Enter Your Options"  maxlength="145">';
            Option2 += '</div>';
            Option2 += '</div>';
            $('#dvOptions2').append(Option2);
        } else {
            // Bind Objective Type && Fill In The Blank Empty Text Box ...
            var Option = '';
            Option += '<div class="form-group" id="Qustion_' + i + '">';
            Option += '<label class = "control-label col-md-2">' + j + ' .)</label>';
            Option += '<div class="col-md-10">';
            Option += '<input type="text" value="" id="Option' + i + '" cms-OptionId="" class="summernote form-control" placeholder="Enter Your Options"  maxlength="145">';
            Option += '</div>';
            Option += '</div>';
            $('#dvOptions3').append(Option);

            //var Option2 = '';
            //Option2 += '<div class="form-group" id="Option_' + i + '">';
            //Option2 += '<div class="col-md-9">';
            //Option2 += '<input type="number" value="" id="Mark' + i + '" class="form-control" placeholder="Enter Your Marks">';
            //Option2 += '</div>';
            //Option2 += '</div>';
            //$('#dvOptions2').append(Option2);
        }

        handleSummernote();
        DeleteSummerNoteHeader();

    }


    $("#btnSubmit").on("click", function ()
    { 
        var Endvalue = Count;
        var SummerNote1 = $("#TxtTitle").summernote('code');
        var str1 = btoa(unescape(encodeURIComponent(SummerNote1)));
        var Question = str1;
    
       
        var CourseId = $("#CourseList").val();
        var QuestionId = $("#hdQuestionId").val();
       
        var ArrayOption = '';
        var nCount = 0;
        ArrayOption = '{"liMF_Option":[';
        for (var i = 0; i <= Endvalue; i++)
        {
            if ($("#Option" + i).summernote('code'))
            {
                    var SummerNote5 = $("#Option" + i).summernote('code');
                    var str5 = btoa(unescape(encodeURIComponent(SummerNote5)));

                    ArrayOption += '{"OPTION_ID":"' + $("#Option" + i).attr('cms-OptionId') + '","OPTION":"' + str5 + '"},';
                    nCount++;
            }
            else
            {
                    alert('All the Options Must to Fill ..!');
                    return false;
                    break;
                }
            }

        
        if (nCount != 0) {
            ArrayOption = ArrayOption.slice(0, -1);
            ArrayOption += ']}';
        } else {
            alert('Something is went wrong . please check your code !');
            return false;
        }

            var Answer = "";
            var s = $("#txtAnswer").summernote('code');
            
            var Answercode = btoa(unescape(encodeURIComponent(s)));
          
            if (Answercode != null && Answercode != "")
            {
                Answer = Answercode;
            }
            else {
                alert('Your Answer Not Valuable ! Please Check You Input !');
                return false;
            }
          

        var JsonData;
        JsonData = '{"QUESTION":"' + Question + '","QUESTION_ID":"' + QuestionId + '","ANSWER_ID":"' + Answer + '"}';
       
        $.ajax({
            url: "@Url.Action("UpdatOnlineExamObjectiveQuestions", "Examination")",
            method: "POST",
            datatype: "json",
            data: { QuizQuestion: JsonData, sOptions: ArrayOption },
            success: function (data)
            {
                alert(data.Message);
                loadContent('/Examination/ListonlineExamQuestion');
            }, error: function (error)
            {
                alert('Internal Server Error !');
            }
        });
    });

    function GetConfirm(ID)
    {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        }
        else {
            $.ajax({
                url: "@Url.Action("DeleteOnlineExamObjectiveQuestions", "Examination")",
                method: "POST",
                datatype: "json",
                data: { sQuestionId: ID },
                success: function (data)
                {
                    alert(data.Message);
                    loadContent('/Examination/ListonlineExamQuestion');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
        }
    }

    function GetOptionCodeForAnswer(answer) {

        var AnswerCode;

        if (answer != null && answer != "") {

            AnswerCode = $("#Option" + (parseInt(answer) - 1)).summernote('code');
            AnswerCode = btoa(unescape(encodeURIComponent(AnswerCode)));
        }


        return AnswerCode;
    }

</script>
<div class="modal" id="equation-dialog">
    <div class="modal-dialog ">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Math Equations</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    @{
                        Html.RenderPartial("Equation");
                    }
                </div>
                <label id="l"></label>
            </div>
            <div class="modal-footer">

                <a href="javascript:;" id="btnCopy" class="btn btn-sm btn-primary" onclick="copyElement('image')">Copy</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


