<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        //var tbl = $('#tblLiERSetting').DataTable();
        $('.selectpicker').selectpicker('refresh');
        handleDatepicker = function () {
            "use strict";


            $("#txtStartDate").datepicker({
                todayHighlight: true,
                autoclose: true,
              //  endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#txtEndDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();
        var Count = 0;
        var Status = 0;


        var formData = new FormData();
        var Dom = "";


        readPreview=function(e)
        {

            alert('#' + $(e).attr("cms-preview") + '');
            Dom = $('#' + $(e).attr("cms-preview") + '');

        }



        function readFiles(e) {
            var file = document.getElementById(e.id).files[0];
            // Read first file
            Dom = $('#' + $(e).attr("cms-preview") + '');
            setup_reader(file);
        }
        function setup_reader(file) {
            //var file = files;

            var name = file.name;
            var reader = new FileReader();
            reader.onloadend = function (e) {
                readerLoaded(e, file, name);
            };
            reader.readAsBinaryString(file);
            // After reading, read the next file.
        }


        function readerLoaded(e, file, name) {

            var _size = file.size;
            var extension = GetFileExtension(file);
            var size = GetFileSize(file);

            //var iProgress = GetProgressRate(_size);

            if (size != null && size != '') {
                var actualFileDom;
                
                if (extension != null && extension != '') {
                    var fName = GetuniqueNameForFile(file);
                    if (extension == 'jpg' || extension == 'png') {
                        actualFileDom = "<div class='table-of-contents' style='padding:4px;'><img src=" + window.URL.createObjectURL(file) + " width=77 height=80 cms-img-name='" + fName + "'></img></div>";
                    }
                    else {
                        actualFileDom = "<span style='color:green;'>" + name + "</span> ";
                    }
                    formData.append(fName, file);
                    Dom.html('');
                    Dom.append(actualFileDom);
                }
            }
        }


        function GetFileExtension(file) {
            // Get uploaded file extension
            var extension = file.name.split('.').pop().toLowerCase();
            var validFileExtensions = ['jpg', 'png'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                alert("Sorry!! Upload only 'jpf','png'")
                //$(this).replaceWith($(this).val('').clone(true));
                $('#fAttachment').val('');
                var formKey = Dom.find('img').attr("cms-img-name");
                DeleteFormData(formKey);
                Dom.find('.table-of-contents').remove();
                return extension = null;
            }
            else {
                return extension;
            }

        }

        function GetFileSize(file) {
            var _size = file.size;
            var fileSize = _size;
            var fSExt = new Array('Bytes', 'KB', 'MB', 'GB'),
            i = 0; while (_size > 900) { _size /= 1024; i++; }
            var exactSize = (Math.round(_size * 100) / 100) + ' ' + fSExt[i];

            if (fileSize > 1000000) {
                alert("Sorry!! Max allowed file size is 1 mb");
                // Clear fileuload control selected file
                // $(this).replaceWith($(this).val('').clone(true));
                $('#fAttachment').val('');
                // get formdata key to remove in formdata also
                var formKey = Dom.find('img').attr("cms-img-name");
                DeleteFormData(formKey);
                Dom.find('.table-of-contents').remove();
                return exactSize = null;

            }
            else {
                return exactSize;
            }

        }


        function GetuniqueNameForFile(file)
        {
            var fileName = file.name;
            var File = fileName.split(".");
            var MaxValue = $('#totalPaper').val();
            var randomValue = Math.floor((Math.random() * parseInt(MaxValue)) + 1);
            var Length = File[0].length;
            var UniqueName = randomString(Length) + randomValue;
            return UniqueName;
        }

        
        function randomString(Length)
        {
	                var chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXTZabcdefghiklmnopqrstuvwxyz";
	
	                var randomstring = '';
	                for (var i = 0; i < Length; i++)
	                {
		                var rnum = Math.floor(Math.random() * chars.length);
		                randomstring += chars.substring(rnum,rnum+1);
	                }
	                return randomstring;
        }


    // deleting in formdata
        function DeleteFormData(key)
        {
          
            formData.delete(key);
        }



        $('#btnSubmit').click(function () {

            // var isValid = true;
            var sCount = 0;
            //if ($('#pBody').parsley().validate() !== true) isValid = false;
            //if (!isValid) {
            //    //gritter-info,danger,success,warning,default
            //    //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            //    return false;
            //}

            //clearing formdata sJsonData 
            if (formData.has('sJsonData')) {

                formData.delete("sJsonData");
            }


            var jsonData = '{"liExamPhotoCopyFiles":[';

            $('#tblCourse tbody tr').each(function () {


                if ($(this).find("img").length>0)
                {
                    var ExamPhotocopyFileId = $(this).find('img').attr(" cms-photocopy-file-id") != null && $(this).find('img').attr(" cms-photocopy-file-id")!=""?$(this).find('img').attr(" cms-photocopy-file-id"):"";
                    var ExamPhotocopyRegistrationId = $(this).attr("cms-photocopy-register-id");
                    var Photocopy = $(this).find("img").attr("cms-img-name");
                    var courseId = $(this).attr("cms-course-id");

                    jsonData += '{"EXAM_PHOTOCOPY_FILE_ID":"' + ExamPhotocopyFileId + '","EXAM_PHOTOCOPY_REGISTER_ID":"' + ExamPhotocopyRegistrationId + '","PHOTOCOPY":"' + Photocopy + '","COURSE_ID":"' + courseId + '"},';
                    sCount++;
                }
  
            });

            if (sCount > 0) {
                jsonData = jsonData.slice(0, -1);
                jsonData += ']}';
                formData.append("sJsonData", jsonData);
                $.ajax({
                    url: "/Examination/SaveorUpdateExaminationPhotoCopyFileRegistration",
                    type: "post",
                    data: formData,
                    contentType: false,
                    processData: false,
                    datatype: "json",
                    success: function (data) {
                        if (data.Message != null && data.Message != "" && data.ErrorCode != "" && data.ErrorCode != null) {

                            if (data.ErrorCode == "201") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }
                            if (data.ErrorCode == "200") {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/Examination/ListRegisterPhotoCopyToCoe?sExamPhotoCopySetting=' + $('#sExamPhotoCopySettingid').val() + '');
                            }
                            if (data.ErrorCode == "304") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                        }
                        else {
                            swal({ title: "Info", text: "Something went wrong so please try again!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                });
            }
            else {
                swal({ title: "Info!", text: "Please upload any file to continue!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
            }
        });



        $('#btnCancel').click(function () {

            loadContent('/Examination/ListRegisterPhotoCopyToCoe?sExamPhotoCopySetting=' + $('#sExamPhotoCopySettingid').val() + '');
        });
    


</script>









