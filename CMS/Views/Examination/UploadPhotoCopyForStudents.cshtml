                                                    {
                                                    <td>
                                                        <div class="col-md-3">
                                                            <span class="btn btn-primary fileinput-button m-r-3">
                                                                <i class="fa fa-plus"></i>
                                                                <span>
                                                                    Add files...
                                                                    <input type="file" id='AfAttachment_@item.COURSE_ROOT_ID' class="form-control" onchange="readFiles(this)" name="sfile" cms-preview='files_@item.COURSE_ROOT_ID'>
                                                                </span>
                                                            </span>
                                                        </div>
                                                    </td>
                                                    }
                    </tr>
                        }

                    }
                    else
