        <div class="panel-body">
            @*<div class="form-group col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" href="#ERRegistration-dialog" data-toggle="modal" id="btnAdd"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>*@

            <div class="col-lg-12 table-responsive">
                <table class="table table-hover table-bordered" id='tblCourse'>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Paper</th>
                            <th width="50%">PREVIEW</th>


                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liExamPhotoCopyFields != null && Model.liExamPhotoCopyFields.Count > 0)
                                        {
                                            //var liRegistration = Model.liExamRevaluationRegistration.GroupBy(x => x.STUDENT_ID).Select(x => new EXAM_REVALUATION_REGISTRATION()).ToList();


                                            //    var liRegistration = from s in Model.liExamRevaluationRegistration group s by s.STUDENT_ID;
                                            var count = 0;
                                            foreach (var item in Model.liExamPhotoCopyFields)
                                            {
                                                count = count + 1;
                    <tr cms-photocopy-register-id="@item.EXAM_PHOTOCOPY_REGISTER_ID" cms-course-id="@item.COURSE_ROOT_ID">
                        <td>@count</td>

                        <td>@item.COURSE_TITLE</td>
