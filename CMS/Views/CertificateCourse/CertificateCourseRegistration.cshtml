@model CMS.ViewModel.ViewModel.CertificateCoursesViewModel
@{
    ViewBag.Title = "CertificateCourseRegistration";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Certificate Course Registration </li>
    </ol>
    <h1 class="page-header">Certificate Course Registration </h1>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Certificate Course Registration </h4>
        </div>
        <div class="panel-body">
            <br />
            <div class="col-lg-12" id="CertificateCourse">
                <h4 class="hidden" id="hTitle">Choose your Certificate Course:</h4>
                <hr />
                <div id="divRadio" class="form-horizontal col-md-offset-3">

                </div>
                <div class="col-lg-12">
                    <a href="#" class="btn-success btn hidden" id="btnSubmit">Submit</a>
                </div>
            </div>

            <label class="fontawesome" id="dvCourseTitle">
                @if (!string.IsNullOrEmpty(Model.sMessage))
                {
                    @Model.sMessage;
                }
            </label>
        </div>
    </div>
</div>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function .

        var sMessage=@Html.Raw(Json.Encode(Model.sMessage));
        if(sMessage!="" && sMessage!=null)
        {

        }
        else
        {
            LoadCourse();
        }
    }
    $('.selectpicker').selectpicker({
        size: 5
    });
    $('.selectpicker').selectpicker('refresh');


    function LoadCourse() {
        $.ajax({
            url: "@Url.Action("LoadCertificateCourses", "CertificateCourse")",
            async: false,
            success: function (option) {
                if (option.ErrorCode == '200') {
                    if ($('#btnSubmit').hasClass("hidden")) {
                        $('#btnSubmit').removeClass("hidden");
                    }
                    if ($('#hTitle').hasClass("hidden")) {
                        $('#hTitle').removeClass("hidden");
                    }
                    if ($('#CertificateCourse').hasClass("hidden")) {
                        $('#CertificateCourse').removeClass("hidden");
                    }
                    var select = $('#divRadio');
                    select.empty();
                    select.append(option.sResult);
                }
                if (option.ErrorCode == '204')
                {
                    var select = $('#divRadio');
                    select.empty();
                    //$('#lblCCourse').empty();
                    if ($('#btnSubmit').hasClass("hidden")) {

                    }
                    else {
                        $('#btnSubmit').addClass("hidden");
                    }

                    if ($('#hTitle').hasClass("hidden")) {

                    }
                    else
                    {
                        $('#hTitle').addClass("hidden");
                    }

                    swal({ title: "Info !", text: "No Certificate courses were added your class.", showConfirmButton: false, timer: 5000, type: 'info', animation: true });

                }
                if(option.ErrorCode=="208")
                {
                    if ($('#btnSubmit').hasClass("hidden")) {

                    }
                    else {
                        $('#btnSubmit').addClass("hidden");
                    }
                    if ($('#hTitle').hasClass("hidden")) {

                    }
                    else
                    {
                        $('#hTitle').addClass("hidden");
                    }
                    var select = $('#divRadio');
                    select.empty();                   
                }
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        });
    }


    $("#btnSubmit").on('click', function () {
        var sCourse_Id = null;
        var sClass_Id = null;
        var sSemester_Id = null;
        var sSetting_Id = null;
        var sCourseTitle = null;
        if ($("input[name='CerticateCourse']:checked").val()) {
            sCourse_Id = $("input[name='CerticateCourse']:checked").attr('cms-courseid');
            sClass_Id = $("input[name='CerticateCourse']:checked").attr('cms-classid');
            //sSemester_Id = $("input[name='CerticateCourse']:checked").attr('cms-semester');
            sSetting_Id = $("input[name='CerticateCourse']:checked").val();
            sCourseTitle = $("input[name='CerticateCourse']:checked").attr('cms-CourseTitle');

            $.ajax({
                url: '@Url.Action("SaveStudentRegisration", "CertificateCourse")',
                method: 'POST',
                datatype: 'json',
                data: { sCourseId: sCourse_Id, sClassId: sClass_Id, sSettingId: sSetting_Id },
                success: function (data)
                {
                    if (data.Message=='2')
                    {
                        alert('Sorry ! No Quota Available For This Course ...');
                    }
                    else if (data.Message == '3') {
                        swal({ title: "Info !", text: "Sorry ! This course already chosen in previous semester(s)", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                    }
                    else if (data.Message == '4')
                    {
                        swal({ title: "Info !", text: "Session has expired!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });

                    } else if (data.Message == '1')
                    {
                        $('#dvCourseTitle').append("You have chosen CertificateCourse " + sCourseTitle);
                        swal({ title: "Success !", text: "You successfully chosen your certificate course.", showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        var select = $('#CertificateCourse');
                        select.empty();
                        // select.append("You have chosen CertificateCourse " + sCourseTitle);
                    }
                    else if (data.Message == '0')
                    {
                        swal({ title: "Failed !", text: "Failed to save records!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        } else
        {
            alert('Please Select Any Option !');
        }
    });
</script>



