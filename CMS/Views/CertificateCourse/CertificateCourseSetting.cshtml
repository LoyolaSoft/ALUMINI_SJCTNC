@model CMS.ViewModel.ViewModel.CertificateCoursesViewModel

@{
    ViewBag.Title = "CertificateCourseSetting";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
    <link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a href="javascript:;" onclick="loadContent('/CertificateCourse/CertificateSettingsList')">List CertificateCourse Settings </a></li>
            <li class="active">Add CertificateCourse Settings </li>
        </ol>
        <h1 class="page-header">CertificateCourse Settings </h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Add CertificateCourse Settings</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    <div class="col-md-12">
                        <div class="col-md-6 col-md-offset-3">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                @Html.Label("Setting Name", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ObjCertificateCourseSetting.SETTINGS_NAME, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Setting Name" } })
                                    @Html.ValidationMessageFor(model => model.ObjCertificateCourseSetting.SETTINGS_NAME, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ShiftList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @*@Html.DropDownListFor(model => model.ShiftList, Model.ShiftList, "-- Select --", new { @class = "drop-down form-control input-sm" })*@
                                    @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Class, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Class, (Model.Class != null) ? Model.Class : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Class, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.Label("Date From", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker2">
                                        @Html.EditorFor(model => model.ObjCertificateCourseSetting.DATE_FROM, new { htmlAttributes = new { @class = "form-control", id = "Datefrom", placeholder = " Pick Start Date" } })
                                        @Html.ValidationMessageFor(model => model.ObjCertificateCourseSetting.DATE_FROM, "", new { @class = "text-danger" })
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Date To", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker2">
                                        @Html.EditorFor(model => model.ObjCertificateCourseSetting.DATE_TO, new { htmlAttributes = new { @class = "form-control", id = "Dateto", placeholder = " Pick Ending Date" } })
                                        @Html.ValidationMessageFor(model => model.ObjCertificateCourseSetting.DATE_TO, "", new { @class = "text-danger" })
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Semester, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group pull-right ">
                                <div class="col-md-12">
                                    <a id="btnSubmit" title="Click to Save the Setting" class="btn btn-primary">Submit</a>
                                    <a href="javascript:;" onclick="loadContent('/CertificateCourse/CertificateSettingsList')" title="Click to View the ClassCourseList" class="btn btn-danger">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


    <script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        //$("#ClassList").select2();
        $('.selectpicker').selectpicker({
            size: 4
        });
    </script>
    <script>
        ContentLoad = function () {           
                handleDatepicker = function () {
                    "use strict";
                    $("#Datefrom,#Dateto").datepicker({
                        todayHighlight: !0,
                        autoclose: !0,
                        format: "dd/mm/yyyy",
                        orientation: "right bottom"
                        // 'top': top,
                        // 'left': left
                    }
                    )
                }
                handleDatepicker();            
        }        
    </script>
    <script>
        $("#btnSubmit").on("click", function () {
            var SettingName = $("#ObjCertificateCourseSetting_SETTINGS_NAME").val();
            var ClassId = $("#Class").val();
            var DateFrom = $("#Datefrom").val();
            var DateTo = $("#Dateto").val();
            var SemesterId = $("#Semester").val();
            var JsonData;
            if (JsonData == null) {
                JsonData = '{"SETTINGS_NAME":"' + SettingName + '","CLASS_ID":"' + ClassId + '","DATE_FROM":"' + DateFrom + '","DATE_TO":"' + DateTo + '","SEMESTER":"' + SemesterId + '"}';
            }           
            if (ClassId != 0 && SettingName != '' && DateFrom != '' && DateTo != '') {
            $.ajax({
                url: "@Url.Action("SaveCertificateCourseSetting", "CertificateCourse")",
                method: "POST",
                datatype: "html",
                data: { jsonCertificateCourseSetting: JsonData },
                success: function (data) {
                    alert(data);
                }, error: function (error) {
                    alert('Record not saved try again ..!');
                }
            });
            }
            else {
                alert('Please Enter All The Values...!!!');
            }
        });
    </script>
    <script>
        $('#ShiftList').on("change", function () {
            var ShiftId = $('#ShiftList').val();
            if (ShiftId != null) {
                $.ajax({
                    url: "@Url.Action("GetClassIdByShiftId", "CertificateCourse")",
                    data: { sShiftId: ShiftId },
                    success: function (option) {
                        $('#Class').empty();
                        $('#Class').append('<option value="0">-- select --</option>' + option);
                        $('.selectpicker').selectpicker('refresh');
                    },
                    error: function (xhr, textStatus, error) {
                        alert(error + "\n");
                    }
                });
            }
        });
    </script>





