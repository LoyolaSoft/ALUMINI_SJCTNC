@model CMS.ViewModel.ViewModel.CertificateCoursesViewModel

@{
    ViewBag.Title = "ListCertificateCourses";
    //  Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />



<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Certificate Courses </li>
    </ol>
    <h1 class="page-header">List Certificate Courses </h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Certificate Courses </h4>
        </div>
        <div class="panel-body">

            <div class="form-horizontal">
                <div class="form-group  col-md-12">
                    <div class="form-group col-md-4">
                        @Html.Label("Certificate Setting", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.SettingList, (Model.SettingList != null) ? Model.SettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.SettingList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div id="page-loader-index" class="fade in hide"><span class="spinner"></span></div>
            <div id="divQuestionView">

            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

    <script>
        ContentLoad = function () {
            //Ready Function()
           
        }
       
       

        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

        $("#SettingList").on('change', function () {
            if ($("#SettingList").val() != '') {
                $.ajax({
                    url: "@Url.Action("BindCertificateCoursesBySettingId", "CertificateCourse")",
                    async: false,
                    data: { sSettingId: $("#SettingList").val() },
                success: function (data) {
                    var Dom = $('#divQuestionView');
                    Dom.empty();
                    Dom.append(data);
                    Dom.selectpicker('refresh');
                }, error: function (ex) {
                    swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                }
            });
        }
        else {
            swal({ title: "Info !", text: "Please Select the fields!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
        }
        });

    </script>

