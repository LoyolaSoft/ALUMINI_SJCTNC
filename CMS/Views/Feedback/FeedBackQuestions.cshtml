
@model CMS.ViewModel.ViewModel.FeedbackViewModel
  @using CMS.ViewModel.ViewModel
@{
    ViewBag.Title = "FeedBackQuestions";
    Layout = null;
}

<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">FeedBackQuestions</a></li>
        <li class="active">Feedback Questions</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Feedback Questions <small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Feedback Questions</h4>
        </div>
        <div class="panel-body">



            <div class="form-horizontal">
                <div class="form-group  col-md-12">
                    <div class="form-group col-md-4">
                        @Html.Label("Feedback", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.Label("Feedback Role Setting", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.FeedBackRoleSettingList, (Model.FeedBackRoleSettingList != null) ? Model.FeedBackRoleSettingList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.FeedBackRoleSettingList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.Label("Feedback Question Group", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.sQuestionGroupList, (Model.sQuestionGroupList != null) ? Model.sQuestionGroupList : Enumerable.Empty<SelectListItem>(), new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.sQuestionGroupList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div id="page-loader-index" class="fade in hide"><span class="spinner"></span></div>
            <div id="divQuestionView">

            </div>
        

        </div>
    </div>
</div>
<!-- end #content -->



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
        ContentLoad = function () {
            //Ready Function()

            var sAcademicStatus=@Html.Raw(Json.Encode(FeedbackViewModel.sAcademicAttempt));

            if(sAcademicStatus>0)
            {
                if(sAcademicStatus==1)
                {
                    changeAcademicYear(@Session["ACADEMIC_YEAR"]);
                }
                
            }
            else
            {
                  
                  
            }

            var sFeedBackId=@Html.Raw(Json.Encode(Model.sFeedBackId));
            if(sFeedBackId!=null && sFeedBackId!="")
            {
                $("#FeedBackSettingList  option[value="+sFeedBackId+"]").prop('selected',true);
                $("#FeedBackSettingList").trigger("change");

            }


            var sFeedBackRoleId=@Html.Raw(Json.Encode(Model.sFeedBackRoleSettingId));
            if(sFeedBackRoleId!=null && sFeedBackRoleId!="")
            {
                $("#FeedBackRoleSettingList  option[value="+sFeedBackRoleId+"]").prop('selected',true);
                $("#FeedBackRoleSettingList").trigger("change");
            }

            var sFeedbackQuestionGroup=@Html.Raw(Json.Encode(Model.sFeedBackQuestionGroup));
            if(sFeedbackQuestionGroup!=null && sFeedbackQuestionGroup!="")
            {
                $("#sQuestionGroupList  option[value="+sFeedbackQuestionGroup+"]").prop('selected',true);
                $('#sQuestionGroupList').selectpicker('refresh');
                $("#sQuestionGroupList").trigger("change");
            }

        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');
        $("#FeedBackSettingList").on('change', function () {
            //$("#btnReload").click();

           

            if ($("#FeedBackSettingList").val() != '') {
                $.ajax({
                    url: "@Url.Action("FetchFeedBackRoleSettingByFeedBack", "Feedback")",
                    async: false,
                    data: { sFeedBackId: $("#FeedBackSettingList").val() },
                    success: function (data) {
                        var select = $("#FeedBackRoleSettingList");
                        select.empty();
                        // selectbox.html(list);
                        select.append('<option value=""> -- Select -- </option>' + data);
                        //select.html(data);
                        $("#FeedBackRoleSettingList").selectpicker('refresh');
                    }, error: function (ex) {
                        alert('Failed to retrieve .' + ex);
                    }
                });
            }
            else
            {
                var select = $("#FeedBackRoleSettingList");
                select.empty();
            }
        });




    $("#FeedBackRoleSettingList").on('change', function () {



        if ($("#FeedBackSettingList").val() != '' && $("#FeedBackRoleSettingList").val()!='') {
            $.ajax({
                url: "@Url.Action("FetchFeedBackQuestionGroupByFeedBackId", "Feedback")",
                async: false,
            data: { sFeedBackId: $("#FeedBackSettingList").val() },
            success: function (data) {
                var Dom=$('#sQuestionGroupList');
                Dom.empty();
                Dom.append(data);
                Dom.selectpicker('refresh');
            }, error: function (ex) {
                swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
        });
    }
    else {
            swal({ title: "Info !", text: "Please Select the fields!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
    }
    });



    $("#sQuestionGroupList").on('change', function () {

        $("#divQuestionView").empty();

        if ($("#FeedBackSettingList").val() != '' && $("#FeedBackRoleSettingList").val()!='' && $("#sQuestionGroupList").val()) {
            $.ajax({
                url: "@Url.Action("ListFeedBackQuestions", "Feedback")",
                async: false,
                data: { sFeedBackId: $("#FeedBackSettingList").val(),sFeedBackRoleId:$("#FeedBackRoleSettingList").val(),sQuestionGroup:$("#sQuestionGroupList").val()},
            success: function (data) {
                $("#divQuestionView").append(data);
                $('.selectpicker').selectpicker('Refresh');
            }, error: function (ex) {
                swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
        });
    }
    else {
            swal({ title: "Info !", text: "Please Select the fields!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
    }
    });





</script>
<script src="~/Content/assets/plugins/intro-js/intro.js"></script>



