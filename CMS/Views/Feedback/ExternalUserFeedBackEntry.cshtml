@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{ 
    Layout = null;
    string sFilePath = string.Empty;
    bool bFinished = true;
}

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("EXTERNALUSERS", "DASHBOARD")">Home</a></li>
        <li class="active">FeedBack Entry</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">FeedBack Entry</h1>

    <div class="row">
        <div class="panel ">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h3 class="panel-title"><i class="fa fa-inbox"></i>FeedBack Entry</h3>
            </div>
            <div class="panel-body noPadding">
                <div class="col-md-12 table-responsive" id="dvfbEntry" data-parsley-validate="true">
                    
                    <div class="form-group">
                        <div class="col-md-10">
                            <div class="alert alert-warning">
                                <b>
                                    Dear Professor ,  Please make Use of " Save Draff " Option in case you want to leave the page (one session timing is 15 to 20 mins). <br />
                                    Once submited you cannot change it. <br />
                                    E - Certificate can be downloaded from the left side menu after your submission. <br />
                                    Thank  You !!!
                                </b> 
                            </div>
                        </div>
                        <div class="col-md-2">
                            @{sFilePath = "/Syllabus/" + Model.Question + ".pdf"; }
                            <a href="@sFilePath" class="btn btn-success pull-right">View Syllabus</a> 
                        </div>
                                           
                    </div>
                    <table class="form-group table table-bordered" id="tblFeedBack">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Question</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{

                                if (Model.QuestionList != null && Model.QuestionList.Count>0)
                                {
                                    string sQuestionType = string.Empty; string sRemark = string.Empty;
                                    bool bFlag = true; int nCount = 0; string sCourseId = string.Empty;
                                    string sStaffId = string.Empty;string sFbEntryId = string.Empty; 
                                    foreach (var QuestionItem in Model.QuestionList)
                                    {
                                        sRemark = string.Empty; sFbEntryId = string.Empty;
                                        if (bFlag)
                                        {
                                            sQuestionType = QuestionItem.QUESTION_TYPE;
                                            <tr>
                                                <td colspan="3"><b>@sQuestionType </b> @{ bFlag = false; } </td>
                                            </tr>
                                          }
                                        else
                                        {
                                            if (!sQuestionType.Equals(QuestionItem.QUESTION_TYPE))
                                            {
                                                <tr>
                                                    <td colspan="3"> @{ sQuestionType = QuestionItem.QUESTION_TYPE; } <b>@sQuestionType </b></td>
                                                </tr>
                                            }
                                        }
                                        if (Model.liExternalUserEntry!=null && Model.liExternalUserEntry.Count>0)
                                        {
                                            if(Model.liExternalUserEntry.Count==Model.QuestionList.Count)
                                            {
                                                  bFinished=false;
                                            }
                                           
                                            var liExternalUserEntry = Model.liExternalUserEntry.Where(x=>x.QUESTION_ID==QuestionItem.QUESTION_ID).ToList();
                                            if (liExternalUserEntry!=null && liExternalUserEntry.Count>0)
                                            {
                                                sRemark = liExternalUserEntry.FirstOrDefault().REMARK;
                                                sFbEntryId = liExternalUserEntry.FirstOrDefault().FB_ENTRY_ID;
                                            }
                                        }
                                           <tr cms-QuestionId="@QuestionItem.QUESTION_ID" cms-QA="1" cms-CourseCode="@Model.Question" cms-CourseId="@Model.sErrorMessage" cms-StaffId="@Model.sErrorCode" cms-FbEntryId="@sFbEntryId" cms-FbSettingId="@QuestionItem.FEEDBACK_ID">
                                               <td>@{nCount++;} @nCount</td>
                                               <td>@QuestionItem.QUESTION</td>
                                               <td>
                                                   <textarea style="margin: 0px; width: 600px; height: 195px;" required  data-parsley-maxlength="1000" data-parsley-required='true'>@sRemark</textarea>
                                               </td>
                                           </tr>
                                       }
                                }
                                else
                                {
                                       <tr><td><p class="text-yellow">No Records avilable</p> </td></tr>
                                }
                            }
                        </tbody>
                    </table>
                    
                    @if (bFinished)
                    {
                        <div class="form-group" id="dvbtn">
                            <div class="col-md-11">
                                <a class="btn btn-primary  pull-right" href="javascript:;" id="btnDraft" onclick="SaveDraft()"> SaveDraff </a>
                            </div>
                            <div class="col-md-1">
                                <a class="btn btn-primary  pull-right" href="javascript:;" id="btnSubmit" onclick="Submit()"> Submit </a>
                            </div>
                        </div>
                    }
                    
                </div>

                <div class="col-md-12" id="dvECertificate"></div>
            </div>
        </div>
    </div>

  
</div>

<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
    function ContentLoad()
    {
        // Document Ready Function ...,
    }
    function SaveDraft()
    {
        var JsonData = '{"liFbExternalUserEntry":[';
        var count = 0; var nMissCount = 0; var CourseId = ""; var sCourseCode = '';
        $('.table  tbody tr').each(function ()
        {
            CourseId = $(this).attr('cms-CourseId');
            sCourseCode = $(this).attr('cms-CourseCode');
            if ($(this).find('textarea').val())
            {
                JsonData += '{"FB_ENTRY_ID":"' + $(this).attr('cms-FbEntryId') + '","STAFF_ID":"' + $(this).attr('cms-StaffId') + '","COURSE_ID":"' + $(this).attr('cms-CourseId') + '","FEEDBACK_SETTING_ID":"' + $(this).attr('cms-FbSettingId') + '","QUESTION_ID":"' + $(this).attr('cms-QuestionId') + '","REMARK":"' + $(this).find('textarea').val() + '"},';
                count++;
            } else
            {
                nMissCount++;
            }
        });
        alert(nMissCount);
        if (nMissCount == 1)
        {
            swal({ title: " Warning!", text: 'Your almost done ! \n Draff is not allow to save ! \n  Please use submit option to finish entry !', showConfirmButton: false, timer: 5000, type: 'warning', animation: true });
            return false;
        }
        if (count != 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData += ']}';
        } else
        {
            swal({ title: " Warning!", text: 'Please Enter Remarks To Continue !', showConfirmButton: false, timer: 5000, type: 'warning', animation: true });
            return false;
        }
        
        $.ajax({
            url: "@Url.Action("SaveExternalUserFeedBackEntry", "Feedback")",
            async: false,
            method: "POST",
            content: "application/json; charset=utf-8",
            data: { sJson: JsonData, sFinished: "0" },
            success: function (data)
            {
                if (data.ErrorCode != "200")
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                } else
                {
                    //GenerateECertificate();
                    swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                    //$('#dvbtn').addClass('hidden');
                    loadContent('/Feedback/ExternalUserFeedBackEntry?sCourseId=' + CourseId + '&sCourseCode=' + sCourseCode);
                }
            }, error: function (e)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function Submit()
    {

        // Validation Check ,...
        var isValid = true;
        if ($('#dvfbEntry').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 2500, type: 'warning', animation: true });
            return false;
        }

        var JsonData = '{"liFbExternalUserEntry":[';
        var count = 0; var nMissCount = 0; var CourseId = ""; var sCourseCode = '';
        $('.table  tbody tr').each(function ()
        {
            CourseId = $(this).attr('cms-CourseId');
            sCourseCode = $(this).attr('cms-CourseCode');
            if ($(this).find('textarea').val())
            {
                JsonData += '{"FB_ENTRY_ID":"' + $(this).attr('cms-FbEntryId') + '","STAFF_ID":"' + $(this).attr('cms-StaffId') + '","COURSE_ID":"' + $(this).attr('cms-CourseId') + '","FEEDBACK_SETTING_ID":"' + $(this).attr('cms-FbSettingId') + '","QUESTION_ID":"' + $(this).attr('cms-QuestionId') + '","REMARK":"' + $(this).find('textarea').val() + '"},';
                count++;
            } 
        });

        if (count != 0)
        {
            JsonData = JsonData.slice(0, -1);
            JsonData += ']}';
        } else
        {
            alert('Please Entry Remark To Continue !');
        }
        
        $.ajax({
            url: "@Url.Action("SaveExternalUserFeedBackEntry", "Feedback")",
            async: false,
            method: "POST",
            content: "application/json; charset=utf-8",
            data: { sJson:JsonData,sFinished:"1" },
            success: function (data)
            {
                if (data.ErrorCode != "200")
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                } else
                {
                    swal({ title: " Success !", text: "Thank you for reviewing our syllabus ! .", showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                    $('#dvbtn').addClass('hidden');
                    loadContent('/Feedback/ExternalUserFeedBackEntry?sCourseId=' + CourseId + '&sCourseCode=' + sCourseCode);
                }
            }, error: function (e)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }

    function GenerateECertificate()
    {
        $.ajax({
            url: "@Url.Action("GenerateECertificateForExternalFeedback", "Feedback")",
            async: false,
            method: "POST",
            content: "application/json; charset=utf-8",
            data: { sCourseId: "1" },
            success: function (data)
            {
                //alert('Hi');
                $('#dvECertificate').empty();
                $('#dvECertificate').append(data);
                //if (data.ErrorCode != "200")
                //{
                //    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                //} else
                //{
                //    swal({ title: " Success !", text: "Thank you for reviewing our syllabus ! .  Please click here for certificate", showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                //    $('#dvbtn').addClass('hidden');
                //    loadContent('/Feedback/ExternalUserFeedBackEntry?sCourseId=' + CourseId + '&sCourseCode=' + sCourseCode);
                //}
            }, error: function (e)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>
