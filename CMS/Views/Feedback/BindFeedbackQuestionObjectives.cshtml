@model CMS.ViewModel.ViewModel.FeedbackViewModel
@{
    Layout = null;
}

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblLiFbSetting">
        <thead>
            <tr>
                <th>#</th>
                <th>Feedback Name</th>
                <th>Questions</th>
                <th>Objectives</th>
                <th>Academic Year</th>
                <th>Active/Deactive</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.LiFeedbackQuestionMapping != null && Model.LiFeedbackQuestionMapping.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.LiFeedbackQuestionMapping)
                {
                    count = count + 1;

                    <tr>
                        <td>@count</td>
                        <td>@item.FEEDBACK_NAME</td>
                        <td>@item.QUESTION</td>
                        <td>@item.OBJECTIVES</td>
                        <td>@item.ACADEMIC_YEAR</td>
                        <td>
                            @if (item.IS_ACTIVE == "1")
                            {
                                <a href="javascrip:;" onclick="SetActive(@item.QUESTION_OBJECT_ID,0)" class="text-success"><i class="fa fa-check"></i></a> }
                            else
                            {
                                <a href="javascrip:;" onclick="SetActive(@item.QUESTION_OBJECT_ID,1)" class="text-danger"><i class="fa fa-times"></i></a>
                            }
                        </td>


                        <td>
                            <a href="#FbQuestionObjectiveMapping" onclick="FetchLiFeedBackQuestionMappingById('@item.QUESTION_OBJECT_ID')" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>
                            <a href="javascript:;" onclick="GetConfirm('@item.QUESTION_OBJECT_ID')" class="text-danger"><i class="fa fa-trash"></i></a>
                        </td>

                        @*<td>
                                <a href="#FbQuestionObjectiveMapping" onclick="FetchLiFeedBackQuestionMappingById(@item.QUESTION_OBJECT_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                <a href="javascrip:;" onclick="GetConfirm(@item.QUESTION_OBJECT_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                            </td>*@
                    </tr>
                }

            }

        </tbody>
    </table>
</div>