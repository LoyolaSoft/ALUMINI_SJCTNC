@if (Model.liCertificateInfo != null && Model.liCertificateInfo.Count > 0)
{
    <div style="width:1000px; height:1000px; padding:20px;  border: 10px solid #787878">
        <div style="width:940px; height:940px; padding:20px;  border: 5px solid #787878">
            <center>
                <img src="~/Content/assets/img/hcc-img/SJCLOGO.png" width="100" height="100" />
                <h2>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME  </h2>
                <h2>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_ADDRESS</h2>
                <h2>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY</h2>
                <h4>@Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>"))</h4>
                <span style="font-family:Algerian; text-align:center; font-size:45px; font-weight:bold;">Certificate of Appreciation </span>
                <br><br>
                <span style="font-size:25px"><i>This is to certify that</i></span>
                <br><br>
                <span style="font-size:30px;font-family:'Lucida Calligraphy';text-align:center;"><b>@Model.liCertificateInfo.FirstOrDefault().FIRST_NAME  </b>, @Model.liCertificateInfo.FirstOrDefault().DESIGNATION</span><br />
                <span style="font-size:25px"><i>of <u><b>@Model.liCertificateInfo.FirstOrDefault().COLLEGE_NAME</b></u> </i></span> <br /><br />
                <span style="font-size:30px"> served as a Peer Reviewer for the Department of &nbsp; 
                    <u><b>@Model.liCertificateInfo.FirstOrDefault().DEPARTMENT</b></u> &nbsp; and reviewed &nbsp;
                    <u><b>@Model.liCertificateInfo.FirstOrDefault().COURSE_CODE &nbsp; - &nbsp; @Model.liCertificateInfo.FirstOrDefault().COURSE_TITLE </b></u>syllabus. </span> <br /><br />
            </center>
            <br /><br /><br />
            <div class="form-group col-md-12">
                &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp;&nbsp; &nbsp; &nbsp; &nbsp;
               
                <img src="~/Content/hcc_img/sign/SJC_COLLEGE_SEAL.PNG" width="170" height="140"/>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;&nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp;
                
                
                <label><img src="~/Content/hcc_img/sign/SJC_PRINCIPAL_SIGN.jpg" /></label>
            </div>
            <div class="form-group col-md-12">
                <label>Date :&nbsp;@Model.liCertificateInfo.FirstOrDefault().ENTRY_DATE</label> 
                 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp; &nbsp;
                &nbsp; &nbsp; &nbsp;&nbsp; &nbsp; &nbsp; &nbsp;
                <label>Principal</label>
            </div>
           
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <span> Oops ! Your Not Yet Finish Your Entry . </span>
    </div>
}





