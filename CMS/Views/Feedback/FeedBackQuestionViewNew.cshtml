<script>

            // this is for saving feedback answer
            $('#btnSubmit').on("click", function () {
                var ArrayAnswer = '{"liFB_Answer":[';
                var nCount = 0;
                var sStatus = 0;
                var isTextBox=false;
                $('#tblFeedBackAnswer tbody tr').each(function () {
                    if ($(this).attr('id') == "trQuestionStart") {
                        var QuestionId = $(this).find("#Ques").attr("cms-question-id");
                        var names = [];

                        // redio button
                        $(this).find('input[name="' + QuestionId + '"]').each(function () {
                            // Creates an array with the names of all the different checkbox group.
                            names[$(this).attr('name')] = true;
                        });


                        //check text box
                        if($(this).find('textarea[name="' + QuestionId + '"]').length)
                        {
                            isTextBox=true;
                        }

                        if(isTextBox==true)
                        {
                            if ($(this).find('textarea[name="' + QuestionId + '"]').val())
                            {

                                ArrayAnswer += '{"QUESTION":"' + QuestionId + '","ANSWER_IN_TEXT":"' + $(this).find('textarea[name="' + QuestionId + '"]').val() + '"},';
                                nCount++;
                            }
                            else
                            {
                                sStatus++;
                                swal({ title: "Error !", text: "Please attend all questions!", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                                return false;
                            }
                        }
                        else
                        {
                            for (name in names)
                            {
                                var radio_buttons = $("input[name='" + name + "']");

                                if (radio_buttons.filter(':checked').length == 0)
                                {
                                    // alert("All feedback questions are mandatory!");
                                    sStatus++;
                                    swal({ title: "Error !", text: "Please attend all questions!", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                                    return false;
                                    break;

                                }

                                else
                                {
                                    if ($(radio_buttons).is(':checked'))
                                    {

                                        ArrayAnswer += '{"QUESTION":"' + name + '","ANSWER":"' + $("input[name='" + name + "']:checked").val() + '"},';
                                        nCount++;
                                    }
                                    else {
                                        // alert("e");
                                        // If you need to use the result you can do so without
                                        // another (costly) jQuery selector call:

                                    }
                                }
                            }
                        }
                    }
                });


                if (nCount != 0 && sStatus==0) {
                    ArrayAnswer = ArrayAnswer.slice(0, -1);
                    ArrayAnswer += ']}';


                    var fbStudentId="";
                    var Assessee = $("#FeedbackMemberNew").val();
                    var FeedBackRoleId = $("#FeedBackRoleSettingList").val();
                    var AssesseeRole = $("#FeedBackRoleSettingList option:selected").attr("cms-assessee-role");
                    var sSupFbRole= $("#FeedBackRoleSettingList option:selected").attr("cms-sup-fb-role-id");
                    var ClassId="0";
                    var CourseId="0";
                    var attrClass = $('#FeedbackMemberNew option:selected').attr('cms-class-id');

                    if (typeof attrClass !== typeof undefined && attrClass !== false) {
                        // Element has this attribute
                        ClassId = $('#FeedbackMemberNew option:selected').attr("cms-class-id") != "" ? $('#FeedbackMemberNew option:selected').attr("cms-class-id"):"0";
                    }
                    var valCourse = $('#StudentCourseList').val();
                    if (typeof valCourse !== typeof undefined && valCourse !== false) {
                        // Element has this attribute
                        CourseId=$('#StudentCourseList').val()!="" ?$('#StudentCourseList').val():"0";
                    }


                    var FeedBackId = $("#FeedBackSettingList").val();
                    var JsonData;
                    JsonData = '{"FBSTUDENT_ID":"' + fbStudentId + '","ASSESSOR":"","CLASS_ID":"' + ClassId + '","ASSESSEE":"' + Assessee + '","FEEDBACK_ID":"' + FeedBackId + '","FEEDBACK_ROLE_ID":"' + FeedBackRoleId + '","ROLE":"' + AssesseeRole + '","QUESTION":"","ANSWER":"","COURSE_ID":"' + CourseId + '","SUP_FEEDBACK_ROLE_ID":"'+ sSupFbRole +'"}';

                    $.ajax({
                        url: "@Url.Action("SaveFeedBackAnswer", "FeedBack")",
                        method: "POST",
                        datatype: "json",
                        data: { sJsonData: JsonData, sFeedBackAnswer: ArrayAnswer },
                        success: function (data) {
                            if (data.Message != null && data.Message != "") {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'success', animation: true });
                                //  loadContent1('/FeedBack/AddFeedBackQuestions?sFeedBackId=' + $('#FeedBackId').val() + '&sFeedBackRoleId=' + $('#FeedBackRoleId').val() + '&sQuestionId=' + $('#QuestionId').val() + '');
                                //var SupFeedBackRoleId = $("#FeedBackRoleSettingList option:selected").attr("cms-sup-fb-role-id");
                                //loadContent1('/FeedBack/BindFeedBackAnswerFields?sSupFeedBackRoleId='+SupFeedBackRoleId+'',"divAnswerView");
                                //var select = $("#divAnswerView1");
                                //select.empty();
                                var divAppend = $("#divAnswerView1");
                                divAppend.html('');
                                $("#FeedBackSettingList option[value='']").attr('selected', true);

                                $("#FeedBackRoleSettingList option[value='']").attr('selected', true);

                                $('.selectpicker').selectpicker('Refresh');
                            }
                            else {

                            }

                        }, error: function (error) {
                            swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                        }
                    });


                }
                else if (sStatus!=0)
                {
                    swal({ title: "Info !", text: "Please attend all questions!", showConfirmButton: false, timer: 3000, type: 'info', animation: true });
                }
                else {
                    swal({ title: "Error !", text: "Something is went wrong . please check your Input  !", showConfirmButton: false, timer: 3000, type: 'error', animation: true });
                    return false;
                }
            });



            //cancel
            $('#btnCancel').click(function(){


                //var SupFeedBackRoleId = $("#FeedBackRoleSettingList option:selected").attr("cms-sup-fb-role-id");
                //loadContent1('/FeedBack/BindFeedBackAnswerFields?sSupFeedBackRoleId='+SupFeedBackRoleId+'',"divAnswerView");
                var divAppend = $("#divAnswerView1");
                divAppend.html('');
                $("#divAnswerView").empty();

                $("#FeedBackSettingList option[value='']").attr('selected', true);

                $("#FeedBackRoleSettingList option[value='']").attr('selected', true);

                $('.selectpicker').selectpicker('Refresh');
            });


            //function printDiv(divName) {

            //    var printContents = document.getElementById(divName).innerHTML;
            //    var originalContents = document.body.innerHTML;
            //    document.body.innerHTML = printContents;
            //    window.print();
            //    document.body.innerHTML = originalContents;

            //}

    $(document).ready(function () {

        // Listen for changes in any radio button
        $('input[type="radio"]').on('click', function () {
            var selectedClass = $(this).attr('class'); // Get the class of the clicked radio button

            // Check if this radio button is already selected
            if ($('input[type="radio"].' + selectedClass).not(this).prop('checked')) {
                alert('Do not select the same answer that you chose for the first question. ! முதல் கேள்விக்கு நீங்கள் தேர்ந்தெடுத்த அதே பதிலைத் தேர்ந்தெடுக்க வேண்டாம்.');
                $(this).prop('checked', false);
                $('input[type="radio"].' + selectedClass).not(this).prop('checked', true);
            }

            // Deselect all radio buttons with the same class, except for the currently clicked one
            
        });
    });


</script>



