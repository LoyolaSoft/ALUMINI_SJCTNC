
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.Utility
@{
    ViewBag.Title = "ListFeedBackQuestions";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

  
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/FeedBack/AddFeedBackQuestions?sFeedBackId=@Model.sFeedBackId&sFeedBackRoleId=@Model.sFeedBackRoleSettingId&sQuestionGroup=@Model.sFeedBackQuestionGroup')"  id="btnAdd"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblLiFbQuestions">
                    <thead>
                        <tr>
                            <th>#</th>

                            <th>FeedBack Name</th>
                            <th>FeedBack Role Name</th>
                            <th>Question</th>
                            @*<th>Question Type</th>*@
                            <th>Feed Back Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.QuestionList != null && Model.QuestionList.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.QuestionList)
                            {
                                count = count + 1;
                            <tr>
                                <td>@count</td>

                                <td>@item.FEEDBACK_NAME</td>
                                <td>@item.FEEDBACK_ROLE_NAME</td>
                                <td>@item.QUESTION</td>
                                @*<td>@item.QUESTION_TYPE_NAME</td>*@
                                <td>@item.GROUP_TITLE</td>
                                
                                <td>
                                    <a href="#FbSetting-dialog" onclick="loadContent('/FeedBack/AddFeedBackQuestions?sFeedBackId=@Model.sFeedBackId&sFeedBackRoleId=@Model.sFeedBackRoleSettingId&sQuestionGroup=@Model.sFeedBackQuestionGroup&sQuestionId=@item.QUESTION_ID')" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                    <a href="javascrip:;" onclick="GetConfirm(@item.QUESTION_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                </td>
                            </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        
    

<input type="hidden" value="@Model.sFeedBackId" id="FeedBackId" />
<input type="hidden" value="@Model.sFeedBackRoleSettingId" id="FeedBackRoleId" />
<input type="hidden" value="@Model.sFeedBackQuestionGroup" id="FeedBackQuestionGroup" />

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>

<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        var tbl = $('#tblLiFbQuestions').DataTable();
  
        GetConfirm = function (QuestoinId) {
            swal({
                title: "Are you sure want to Delete?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
            
            function () {
                $.ajax({
                    url: "/FeedBack/DeleteFeedBackQuestion",
                    type: "post",
                    data: { sQuestionId: QuestoinId },
                    success: function (data) {
                        if (data.Message != null && data.Message != "") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadContent1('/FeedBack/ListFeedBackQuestions?sFeedBackId=' + $('#FeedBackId').val() + '&sFeedBackRoleId=' + $('#FeedBackRoleId').val() + '&sQuestionGroup='+$('#FeedBackQuestionGroup').val()+'', "divQuestionView");
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }


                });
            });
        }




        







</script>




