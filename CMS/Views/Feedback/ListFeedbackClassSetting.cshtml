

@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.ViewModel.ViewModel
@{
    ViewBag.Title = "ListFeedbackSetting";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListFeedbackClassSetting</li>
    </ol>
    <h1 class="page-header">List Class Feedback Setting</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Class Feedback Setting</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#FbSetting-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <div class="form-group  col-md-12">
                <div class="col-md-4 form-group">
                    <label class="col-md-3 control-label">Academic Year</label>
                    <div class="col-md-9">
                        @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true", id = "dAcademicYearList" })
                        @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    @Html.Label("Feedback", htmlAttributes: new { @class = "col-md-4 control-label " })
                    <div class="col-md-8">
                        @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>
            <div id="bindtable">

            </div>

        </div>
    </div>
</div>
<div class="modal" id="FbSetting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Class Feedback Settings</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="row">
                                    <div class="form-group col-md-10">
                                        <label class="control-label col-md-4">Academic Year</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true", id = "dAcademicYearList2" })
                                            @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-10 form-group">
                                        @Html.Label("Feedback", htmlAttributes: new { @class = "col-md-4 control-label " })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true", id = "feedbacksetting2" })
                                            @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-10">
                                        <label class="control-label col-md-4">Shift</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ShiftList, (Model.ShiftList != null) ? Model.ShiftList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.ShiftList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-10">
                                        <label class="control-label col-md-4">Programme Level</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ProgrammeLevelList, (Model.ProgrammeLevelList != null) ? Model.ProgrammeLevelList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(model => model.ProgrammeLevelList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group col-md-10">
                                        <label class="control-label col-md-4">Programme</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ProgramName, (Model.ProgramName != null) ? Model.ProgramName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                                            @Html.ValidationMessageFor(model => model.ProgramName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-10">
                                        <label class="control-label col-md-4">Class Year</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ClassYearList, (Model.ClassYearList != null) ? Model.ClassYearList : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", data_actions_box = "true", multiple = "multiple" })
                                            @Html.ValidationMessageFor(model => model.ClassYearList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group col-md-10">
                                        <label class="control-label col-md-4">Class Name</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(model => model.ClassName, (Model.ClassName != null) ? Model.ClassName : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })
                                            @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="FeedBackId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        var tbl = $('#tblLiFbSetting').DataTable();

        handleDatepicker = function () {
            "use strict";
        }

    $("#FeedBackSettingList").on("change", function () {
        GetCLassSettingList();
    });

    $("#dAcademicYearList").on("change", function () {
        var acyear = $('#dAcademicYearList option:selected').text();
        $.ajax({
            url: "@Url.Action("FetchgfeedbckByAcyear", "FeedBack")",
            method: "POST",
            datatype: "json",
            data: { sacyear: acyear },
            success: function (data) {
                $("#FeedBackSettingList").empty();
                $("#FeedBackSettingList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (error) {

                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });

    $("#dAcademicYearList2").on("change", function () {
        var acyear = $('#dAcademicYearList2 option:selected').text();
        $.ajax({
            url: "@Url.Action("FetchgfeedbckByAcyear", "FeedBack")",
            method: "POST",
            datatype: "json",
            data: { sacyear: acyear },
            success: function (data) {
                $("#feedbacksetting2").empty();
                $("#feedbacksetting2").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (error) {

                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    $("#feedbacksetting2").on("change", function () {
        var FeedBackId = $('#feedbacksetting2').val();
        var acyear = $('#dAcademicYearList2 option:selected').text();
        $.ajax({
            url: "@Url.Action("FetchgfeedbckClassByAcyear", "FeedBack")",
            method: "POST",
            datatype: "json",
            data: { sacyear: acyear, sFeedBackId: FeedBackId },
            success: function (data) {
                $("#ClassList").empty();
                $("#ClassList").append('<option value="0">-- Select --</option>' + data);
                $('.selectpicker').selectpicker('refresh');
            },
            error: function (error) {

                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    });
    function GetCLassSettingList() {
        var acyear = $('#dAcademicYearList option:selected').text();
        var feedbacksetting = $('#FeedBackSettingList').val();
         $('#submit').show();
        $.ajax({
            url: "@Url.Action("BindFeedbackClassSetting", "FeedBack")",
            method: "POST",
            datatype: "json",
            data: { sacyear: acyear, sfeedbacksetting: feedbacksetting },
            success: function (data) {

                $('#bindtable').empty();
                $('#bindtable').append(data);
                $('#tblLiFbSetting').DataTable({
                    dom: "lBfrtip", buttons: [{
                        extend: "excel", className: "btn-sm ",

                    }

                    ], responsive: !0, "paging": false,
                });
                $('.dt-buttons').append('<a download="StudentList" href="/Content/Student.xlsx" class="btn btn-default btn-sm" id="btndownload" tabindex="0" aria-controls="StudentList"><span>Template Download</span></a> <input class="btn btn-default btn-sm upload" onchange="UploadExcel()"   id="btnupload" type="file" ></input>');

            }, error: function (error) {

                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }


        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var FeedBackId = $('#feedbacksetting2').val();
            var acyear =  $('#dAcademicYearList2 option:selected').text();
            var classid = String($('#ClassName').val());



            var jsonData = '{"FEEDBACK_ID":"' + FeedBackId + '","ACADEMIC_YEAR":"' + acyear + '","CLASS_ID":"' + classid + '"}';


              var req=  $.ajax({
                  url: "/FeedBack/SaveorUpdateFeedBackClassSetting",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "")
                        {
                            if (data.ErrorCode == "200")
                            {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                GetCLassSettingList();
                            }
                            if (data.ErrorCode == "417") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                            if (data.ErrorCode == "503") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }


                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

              });



        });


    function SetActive(FeedBackId,Mode)
    {
        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "/FeedBack/ActivateorDeactivateFeedBackClassSettingBySettingId",
                type: "post",
                data: { sFeedBackId: FeedBackId,sMode:Mode},
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        GetCLassSettingList();
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }

            });
        });

    }


    GetConfirm = function (FeedBackId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "/FeedBack/DeleteLiFeedBackClassSettingById",
        type: "post",
        data: { sFeedBackId: FeedBackId },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                GetCLassSettingList();
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }

        $('#Add').click(function () {
            $('#pBody').parsley().destroy();
            $('#dAcademicYearList2').attr('value', '');
            $('#feedbacksetting2').attr('value','');
            $('#ShiftList').attr('value', '');
            $('#ProgrammeLevelList').attr('value', '');
            $('#ProgramName').attr('value', '');
            $('#ClassYearList').attr('value', '');
            $('#ClassName').attr('value', '');
            $('.selectpicker').selectpicker('refresh');
        });

        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
    }



                                    $("#ProgramName").on("change", function () {
                                    FetchClass();
                                });
    $("#ClassYearList").on("change", function () {
                                    FetchClass();
                                });
                                function FetchClass()
                                {
                                        var ProgramName = String($("#ProgramName").val());
                                    var classyear = String($("#ClassYearList").val());
                                    var sShift = $("#ShiftList").val();
                                    if ($("#ClassYearList").val() && $("#ShiftList").val() && $("#ProgramName").val())
                                    {
                                        $.ajax({
                                            url: "@Url.Action("BindDDLClassListbyClassYear", "Student")",
                                            method: "POST",
                                            datatype: "json",
                                            data: { sProgramId: ProgramName, sShiftId: sShift, classyear: classyear },
                                            success: function (data) {
                                                $("#ClassName").empty();
                                                $("#ClassName").append( data);
                                                $('.selectpicker').selectpicker('refresh');
                                            }, error: function (error) {
                                                alert('Internal Server Error ! ');
                                            }
                                        });
                                    }
                                };

                        $("#ShiftList").on("change", function ()
                        {
                            fetchProgramme();
                        });
    $("#ProgrammeLevelList").on("change", function ()
                        {
                            fetchProgramme();
                        });
                        function fetchProgramme()
                        {
                            var sShift = $("#ShiftList").val();
                            var pLevel = $("#ProgrammeLevelList").val();
                            if ($("#ShiftList").val() && $("#ProgrammeLevelList").val())
                            {
                                $.ajax({
                                    url: "@Url.Action("GetProgramByShiftclasslevel", "Student")",
                                    method: "POST",
                                    datatype: "json",
                                    data: { sShiftId: sShift, programmeLevel: pLevel },
                                    success: function (data) {
                                        $("#ProgramName").empty();
                                        $("#ProgramName").append(data);
                                        $('.selectpicker').selectpicker('refresh');
                                    }, error: function (error) {
                                        alert('Internal Server Error ! ');
                                    }
                                });
                            }
};
</script>



