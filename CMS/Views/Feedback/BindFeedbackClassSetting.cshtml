@model CMS.ViewModel.ViewModel.FeedbackViewModel
@{
    Layout = null;
}

<div class="form-group col-md-12 table-responsive">
    <table class="table table-hover table-bordered" id="tblLiFbSetting">
        <thead>
            <tr>
                <th>#</th>
                <th>Feedback Name</th>
                <th>Date From</th>
                <th>Date To</th>
                <th>Class Name</th>
                <th>Active/Deactive</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.liFbClassSettings != null && Model.liFbClassSettings.Count > 0)
            {
                var count = 0;
                foreach (var item in Model.liFbClassSettings)
                {
                    count = count + 1;

                    <tr>
                        <td>@count</td>
                        <td>@item.FEEDBACK_NAME</td>
                        <td>@item.DATE_FROM</td>
                        <td>@item.DATE_TO</td>
                        <td>@item.CLASS_NAME</td>
                        <td>
                            @if (item.IS_ACTIVE == "1")
                            {
                                <a href="javascrip:;" onclick="SetActive(@item.CLASS_SETTING_ID,0)" class="text-success"><i class="fa fa-check"></i></a> }
                            else
                            {
                                <a href="javascrip:;" onclick="SetActive(@item.CLASS_SETTING_ID,1)" class="text-danger"><i class="fa fa-times"></i></a>
                            }
                        </td>

                        <td>
                            @* <a href="#FbSetting-dialog" onclick="FetchLiFeedBackSettingById(@item.CLASS_SETTING_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>*@

                            <a href="javascrip:;" onclick="GetConfirm(@item.CLASS_SETTING_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                        </td>
                    </tr>
                }

            }

        </tbody>
    </table>
</div>