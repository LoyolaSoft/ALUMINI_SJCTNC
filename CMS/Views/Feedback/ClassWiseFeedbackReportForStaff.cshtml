@model CMS.ViewModel.ViewModel.FeedbackViewModel
@{
    ViewBag.Title = "ClassWiseFeedbackReportForStaff";
    Layout = null;
}

<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">ClassWiseFeedbackReportForStaff</a></li>
        <li class="active">ClassWiseFeedbackReportForStaff</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Class Wise Feedback Report For Staff<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Class Wise Feedback Report For Staff</h4>
        </div>
        <div class="panel-body">


            <div class="form-horizontal">
                <div class="form-group  col-md-12">
                    <div class="col-md-4">
                        @Html.Label("Feedback", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group col-md-6" data-step="1" data-intro="Choose Course">
                        @Html.LabelFor(model => model.CLASS_ID, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.CLASS_ID, (Model.CLASS_ID != null) ? Model.CLASS_ID : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.CLASS_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @*<div class="form-group col-md-6" data-step="2" data-intro="Choose Course">
                        @Html.Label("Course", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.StudentCourseList, (Model.StudentCourseList != null) ? Model.StudentCourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.StudentCourseList, "", new { @class = "text-danger" })
                        </div>
                    </div>*@
                </div>
            </div>
            <div id="page-loader-index" class="fade in hide"><span class="spinner"></span></div>
            <div id="divAnswerView" class="form-group col-md-12">
            </div>
            <div class="col-md-1 pull-right">
                <button class="btn btn-primary pull-right hidden" onclick="printDiv()" id="btnPrint"> Print </button>
            </div>
            @*<div class="col-md-1 pull-right">
                <button class="btn btn-primary pull-right hidden" onclick="Export1()" id="btnExport"> Export </button>
            </div>*@




        </div>
    </div>
</div>
<!-- end #content -->
<input type="hidden" id="FbRating" value="1" />


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

