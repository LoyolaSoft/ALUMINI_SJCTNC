    $("#CLASS_ID, #FeedBackSettingList, #StudentCourseList").on('change', function () {
        if ($("#CLASS_ID").val() !== '' && $("#FeedBackSettingList").val() !== '' && $("#StudentCourseList").val() !== '') {

        // Show "Fetching" message
        $('#divAnswerView').html('<p style="text-align:center;">Fetching...</p>');

        $.ajax({
            url: "@Url.Action("BindclassWiseFeedbackReportForStaff", "Feedback")",
            async: false,
            data: { sStaffId: "staff", sFeedBackId: $('#FeedBackSettingList').val(), sClassId: $("#CLASS_ID").val(), sCourseId: $("#StudentCourseList").val()},
            success: function (data) {

                if (data.Message != null && data.Message != "") {
                    swal({ title: "error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    //loadContent('/Library/LiUserList');
                }
                else {
                    $('#btnPrint').removeClass("hidden");
                    $('#btnExport').removeClass("hidden");

                    // Delay for 2 seconds before appending the data
                    setTimeout(function() {
                        $('#divAnswerView').html('');
                        $('#divAnswerView').append(data);
                    }, 1000);
                }
            },
            error: function (ex) {

                //alert('Failed to retrieve .' + ex);
                swal({ title: "Error !", text: "Internal Server Error!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
        });
    }
});

