    function printDiv() {

        //$('#btnPrint').addClass("hidden");
        //$('#btnExport').addClass("hidden");
        var printContents = document.getElementById('divAnswerView').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
    }


    function Export1() {

        var title = "";
        var sFeedback = $('#FeedBackSettingList option:selected').text();

        title = sFeedback + "_" + $('#lblReportName').text();


        let file = new Blob([$('#divAnswerView').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();

    }

</script>

<script src="~/Content/assets/plugins/intro-js/intro.js"></script>









