@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{ 
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("EXTERNALUSERS", "DASHBOARD")">Home</a></li>
        <li class="active">External User List</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">External User List<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">External User List</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12 table-responsive">
                            <div class="form-group">
                                <a class="btn btn-success pull-right" href="#ModalContent-dialog" data-toggle="modal"><i class="fa fa-plus"></i> ADD</a>
                            </div>
                            <br />
                            <div class="form-group">
                                <table class="table table-bordered table-hover" id="tblExternalUser">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>User Name</th>
                                            <th>Password</th>
                                            <th>Name</th>
                                            <th>College</th>
                                            <th>Mobile No</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.liExternalUserInfo != null && Model.liExternalUserInfo.Count > 0)
                                        {
                                            int nCount = 0;
                                            foreach (var item in Model.liExternalUserInfo)
                                            {
                                                <tr>
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.EXTERNAL_USER_CODE</td>
                                                    <td>@item.MOBILE_NO</td>
                                                    <td>@item.FIRST_NAME</td>
                                                    <td>@item.COLLEGE_NAME</td>
                                                    <td>@item.MOBILE_NO</td>
                                                    <td>
                                                        <a href="#ModalContent-dialog" data-toggle="modal" onclick="FetchExternalUserById(@item.EXTERNAL_USER_ID)"><i class="fa fa-edit"></i></a>
                                                        <a href="javascript:;" onclick="DeleteConfrim(@item.EXTERNAL_USER_ID)"><i class="fa fa-trash text-danger"></i></a>
                                                    </td>
                                                </tr>
                                             }
                                         }
                                    </tbody>
                                </table>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
     }
</div>


<!-- Begin Modal -->
<div class="modal" id="ModalContent-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit External User</h4>
            </div>
            <div class="modal-body" id="dvValidate" data-parsley-validate="true">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">

                            <!-- User Code -->
                            <div class="col-md-12 form-group">
                                @Html.Label("User Code", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="txtUserCode" class="form-control" disabled placeholder="Enter User Code"/>
                                </div>
                            </div>

                            <!-- Name -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Name", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="txtName" class="form-control" placeholder="Enter User Name" data-parsley-required = "true"/>
                                </div>
                            </div>

                            <!-- Date Of Birth -->
                            <div class="col-md-12 form-group">
                                @Html.Label("E - Mail", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="txtMailId" class="form-control input-sm" placeholder="Ex : xyz@gmail.com" data-parsley-required="true" data-parsley-maxlength = "45"/>
                                </div>
                            </div>

                            <!-- Mobile No -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Mobile No", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="txtMobileNo" class="form-control" placeholder="Ex : 9874563210" data-parsley-required = "true" data-parsley-maxlength = "10" data-parsley-type = "number"/>
                                </div>
                            </div>
                            
                            <!-- College Name -->
                            <div class="col-md-12 form-group">
                                @Html.Label("College Name", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" id="txtCollegeName" class="form-control" placeholder="Enter College Name" data-parsley-required = "true"/>
                                </div>
                            </div>

                            <!-- Designation -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Designation", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Designation, (Model.Designation != null) ? Model.Designation : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" , @data_parsley_required = "true" })
                                </div>
                            </div>

                            <!-- Department -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <!-- Role -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Role", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Role, (Model.Role != null) ? Model.Role : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <!-- User Type -->
                            <div class="col-md-12 form-group">
                                @Html.Label("User Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.UserType, (Model.UserType != null) ? Model.UserType : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveExternalUser()" class="btn btn-sm btn-primary">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->

<input type="hidden" name="name" value="" id="hdExternalUserId" />

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>



<script>

    function ContentLoad()
    {
        handleDatepicker = function ()
        {
            "use strict";
            $("#txtDOB").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "down bottom",
                zIndexOffset: '15',
                defaultDate: new Date()
            })
        }
        handleDatepicker();

        $('#tblExternalUser').DataTable();
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
    function FetchExternalUserById(Id)
    {
        $.ajax({
            url: '@Url.Action("FetchExternalInfoById", "Feedback")',
            method: 'POST',
            datatype: 'json',
            data: { sExternalUserId: Id },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#hdExternalUserId').val(data[0].EXTERNAL_USER_ID);
                    $('#txtUserCode').val(data[0].EXTERNAL_USER_CODE);
                    $('#txtName').val(data[0].FIRST_NAME);
                    $('#txtMailId').val(data[0].MAIL_ID);
                    $('#txtMobileNo').val(data[0].MOBILE_NO);
                    $('#txtCollegeName').val(data[0].COLLEGE_NAME);
                    $('#Designation').val(data[0].DESIGNATION);
                    $('#DepartmentList').val(data[0].DEPARTMENT);
                    $('#Role').val(data[0].ROLE);
                    $('#UserType').val(data[0].USER_TYPE);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

<script>
    function DeleteConfrim(Id)
    {
         swal({
             title: "Are you sure to delete ?",
             text: "",
             type: "warning",
             showCancelButton: true,
             confirmButtonClass: "btn-danger",
             confirmButtonText: "Yes, Delete!",
             closeOnConfirm: false
         },function()
         {     
            $.ajax({
                 url: '@Url.Action("DeleteExternalUserInfo", "Feedback")',
                 method: 'POST',
                 datatype: 'json',
                 data: { sExternalUserId: Id },
                 success: function (data) 
                 {
                     if (data.ErrorCode != "200")
                     {
                         swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                     } else
                     {
                         swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                         loadContent('/Feedback/ExternalUserList');
                     }
                 }, error: function (error) 
                 {
                     swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                 }
             });
        })
    }
</script>

<script>
    $(function ()
    {
        $('#ModalContent-dialog').on('hidden.bs.modal', function (e)
        {
            $('#hdExternalUserId').val('');
            $('#txtUserCode').val('');
            $('#txtName').val('');
            $('#txtMailId').val('');
            $('#txtMobileNo').val('');
            $('#txtCollegeName').val('');
            $('#Designation').val('');
            $('#DepartmentList').val('');
            $('#Role').val('');
            $('#UserType').val('');
            $('.selectpicker').selectpicker('refresh');
        });
    });
    function SaveExternalUser()
    {
        // Validation Check ,...
        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 2500, type: 'warning', animation: true });
            return false;
        }

        var JsonData = '{"EXTERNAL_USER_ID":"' + $('#hdExternalUserId').val() + '",\
                         "EXTERNAL_USER_CODE":"' + $('#txtUserCode').val() + '",\
                         "FIRST_NAME":"' + $('#txtName').val() + '",\
                         "MAIL_ID":"' + $('#txtMailId').val() + '",\
                         "MOBILE_NO":"' + $('#txtMobileNo').val() + '",\
                         "COLLEGE_NAME":"' + $('#txtCollegeName').val() + '",\
                         "DESIGNATION":"' + $('#Designation').val() + '",\
                         "DEPARTMENT":"' + $('#DepartmentList').val() + '",\
                         "ROLE":"' + $('#Role').val() + '",\
                         "USER_TYPE":"' + $('#UserType').val() + '"}';

        $.ajax({
            url: '@Url.Action("SaveExternalUserInfo", "Feedback")',
            method: 'POST',
            datatype:'json',
            data: { sJson: JsonData },
            success: function (data)
            {
                if (data.ErrorCode != "200")
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#ModalContent-dialog').modal('hide');
                    swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/Feedback/ExternalUserList');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>