@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">External Feedback Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">External Feedback Report<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">External Feedback Report</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12">
                            <div class="form-group col-md-4">
                                @Html.Label("AcYear", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <div class="form-group col-md-4">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <div class="form-group col-md-4">
                                @Html.Label("Dept", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group col-md-4">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <div class="form-group col-md-1">
                                <a href="javascript:;" onclick="FetchFeedbackReport()" class="btn btn-primary">Get</a>
                            </div>
                            <div class="form-group col-md-1">
                                <a href="javascript:;" onclick="printDiv('dvExternaluser')" class="btn btn-success">Print</a>
                            </div>
                        </div>
                        <div class="col-md-12 table-responsive" id="dvExternaluser"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function
        $('.selectpicker').selectpicker({ size: 6 });
        $('.selectpicker').selectpicker('refresh');
    }

    $('#AcademicYearList').on('change',function ()
    {
         $('#FeedBackSettingList').empty();
        if ($('#AcademicYearList').val())
        {
            $.ajax({
                url: '@Url.Action("FetchExternalFeedbackSettingByAcYear", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sAcademicYear: $('#AcademicYearList OPtion:selected').text() },
                success: function (data)
                {
                    if (data.ErrorCode=="200")
                    {
                        $('#FeedBackSettingList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });
    $('#DepartmentList').on('change', function ()
    {
        $('#CourseList').empty();
        if ($('#DepartmentList').val())
        {
            $.ajax({
                url: '@Url.Action("FetchCourseByDepartmentForExternalFeedback", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sAcYear: $('#AcademicYearList OPtion:selected').text(),sFeedBackSettingId:$('#FeedBackSettingList').val(), sDepartmentId: $('#DepartmentList').val() },
                success: function (data)
                {
                    if (data.ErrorCode=="200")
                    {
                        $('#CourseList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });

    function FetchFeedbackReport()
    {
        $('#dvExternaluser').empty();
        if ($('#FeedBackSettingList').val() && $('#CourseList').val())
        {
            $.ajax({
                url: '@Url.Action("BindFbExternalUserEntryByCourseId", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sFeedbackId: $('#FeedBackSettingList').val(), sCourseId: $('#CourseList').val(), sAcYear: $('#AcademicYearList OPtion:selected').text() },
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                    } else {
                        $('#dvExternaluser').append(data);
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    }
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
        //var printContents = document.getElementById(divName).innerHTML;
        //var originalContents = document.body.innerHTML;

        //document.body.innerHTML = printContents;

        //window.print();

        //document.body.innerHTML = originalContents;
        //loadContent('/Examination/ExamFilledApplicationList');
    }
</script>