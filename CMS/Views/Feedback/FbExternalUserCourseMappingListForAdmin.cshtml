@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{ 
    Layout = null;
}


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">External Feedback Course Mapping List For Admin </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">External Feedback Course Mapping List For Admin<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">External Feedback Course Mapping List For Admin</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>College</th>
                                    <th>Name</th>
                                    <th>Mobile No</th>
                                    <th>Department</th>
                                    <th>Course Code</th>
                                    <th>Course Title</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.liExternalUserCourseMapping!=null && Model.liExternalUserCourseMapping.Count>0)
                                {
                                    int nCount = 0;
                                    foreach (var item in Model.liExternalUserCourseMapping)
                                    {
                                        <tr>
                                            <td>@{nCount++;} @nCount</td>
                                            <td>@item.COLLEGE_NAME</td>
                                            <td>@item.FIRST_NAME ( @item.EXTERNAL_USER_CODE )</td>
                                            <td>@item.MOBILE_NO</td>
                                            <td>@item.DEPARTMENT</td>
                                            <td>@item.COURSE_CODE</td>
                                            <td>@item.COURSE_TITLE</td>
                                            <td>
                                                @if (item.IS_FINISHED == "1")
                                                {
                                                    <i class="ion-ios-checkmark-outline fa-2x text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="ion-ios-close-outline fa-2x text-danger"></i>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

