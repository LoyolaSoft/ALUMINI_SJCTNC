
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@{
    ViewBag.Title = "FeedbackReportForStaff";
    Layout = null;
}

<link href="~/Content/assets/plugins/intro-js/introjs.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<!-- begin #content -->
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">FeedbackReportForStaff</a></li>
        <li class="active">FeedbackReportForStaff</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Feedback Report For Staff<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Feedback Report For Staff</h4>
        </div>
        <div class="panel-body">


            <div class="form-horizontal">
                <div class="form-group  col-md-12">
                    <div class="col-md-4">
                        @Html.Label("Feedback", htmlAttributes: new { @class = "col-md-4 control-label " })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                            @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                        </div>
                    </div>

              
                </div>
            </div>
            <div id="page-loader-index" class="fade in hide"><span class="spinner"></span></div>
            <div id="divAnswerView" class="form-group col-md-12">

            </div>
            <div class="col-md-1 pull-right">
                <button class="btn btn-primary pull-right hidden" onclick="printDiv()" id="btnPrint"> Print </button>
            </div>
            <div class="col-md-1 pull-right">
                <button class="btn btn-primary pull-right hidden" onclick="Export1()" id="btnExport"> Export </button>
            </div>




        </div>
    </div>
</div>
<!-- end #content -->
<input type="hidden" id="FbRating" value="1" />


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
        ContentLoad = function () {
            //Ready Function()
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

  
   
        $("#FeedBackSettingList").on('change', function () {

            if ($("#FeedBackSettingList").val() != '') {
            $.ajax({
                url: "@Url.Action("BindFeedbackReport", "Feedback")",
                async: false,
                data: { sStaffId: "staff", sFeedBackId: $('#FeedBackSettingList').val() },
              success: function (data) {
                if (data.Message != null && data.Message != "") {
                    swal({ title: "error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    //loadContent('/Library/LiUserList');
                }
                else {
                    $('#btnPrint').removeClass("hidden");
                    $('#btnExport').removeClass("hidden");
                    $('#divAnswerView').html('');
                    $('#divAnswerView').append(data);
                }

            }, error: function (ex) {
                //alert('Failed to retrieve .' + ex);
                swal({ title: "Error !", text: "Intetrnal Server Error!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
        });
    }
    });

    function printDiv() {

        //$('#btnPrint').addClass("hidden");
        //$('#btnExport').addClass("hidden");
        var printContents = document.getElementById('divAnswerView').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
    }


    function Export1() {

        var title = "";
        var sFeedback = $('#FeedBackSettingList option:selected').text();
      
        title = sFeedback + "_" + $('#lblReportName').text();
       

        let file = new Blob([$('#divAnswerView').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();

    }

</script>

<script src="~/Content/assets/plugins/intro-js/intro.js"></script>









