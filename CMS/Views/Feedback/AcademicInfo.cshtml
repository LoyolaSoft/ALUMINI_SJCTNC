
@model CMS.ViewModel.ViewModel.FeedbackViewModel
    @using CMS.Utility
@{
    ViewBag.Title = "AcademicInfo";
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">AcademicInfo</li>
    </ol>
    <h1 class="page-header">Academic Info</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Academic Info</h4>
        </div>
        <div class="panel-body noPadding">
           
            <div class="col-md-12" id="divBind"> 


                @{
                    string sAcYear= Session[Common.SESSION_VARIABLES.CUR_ACADEMIC_YEAR] != null ? Session[Common.SESSION_VARIABLES.CUR_ACADEMIC_YEAR].ToString() : (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR] != null ? Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR].ToString() : string.Empty);
                 }

                <div class="col-md-8">
                    <p>The current academic year is @sAcYear for feedback alone.</p>
                </div>
                <div class="col-md-2">
                    <a href="#modal-academicinfo" class="btn btn-sm btn-primary" data-toggle="modal" hidden id="btnacInfo">Change</a>
                </div>
                


            </div>
            
        </div>
    </div>
</div>
<div class="modal" id="modal-academicinfo">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Academic Info</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">
                            @Html.Label("Academic Year", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(),"---select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="FeedBackId" value="" />
    </div>
</div>


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker('refresh');

        //$('#btnacInfo').trigger("click");

        
        $('#btnSubmit').click(function () {
            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }
            if ($('#AcademicYearList').val())
            {
                $.ajax({
                    url: "/FeedBack/ChangeAcademicInfo",
                    type: "post",
                    data: { sAcYear: $('#AcademicYearList option:selected').text() },
                    success: function (data) {
                        if (data.Message != null && data.Message != "" && data.ErrorCode=="200") {


                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            
                            //$('#divBind').html('');
                            //var content = "<p>The current academic year was " + $('#AcademicYearList option:selected').text() + " for feedback alone.</p>";

                            //$('#divBind').append(content);

                            loadContent('/FeedBack/AcademicInfo');
                        }
                        else {
                            swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }
                });
            }
            else {
                swal({ title: "Info !", text: "Please try it again", showConfirmButton: false, timer: 1800, type: 'info', animation: true });

            }

          
        });

       





     
</script>





