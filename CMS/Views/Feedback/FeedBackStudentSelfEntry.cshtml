
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@{
    ViewBag.Title = "FeedBackStudentSelfEntry";
    Layout = null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="form-horizontal">
    <div class="form-group  col-md-12">
        <div class="form-group col-md-6">
            @Html.Label("Student", htmlAttributes: new { @class = "col-md-4 control-label " })
            <div class="col-md-8">
                @Html.DropDownListFor(m => m.FeedbackMember, (Model.FeedbackMember != null) ? Model.FeedbackMember : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control   selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                @Html.ValidationMessageFor(m => m.FeedbackMember, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
        ContentLoad = function () {
            //Ready Function()

        }
    var FeedbackMember=@Html.Raw(Json.Encode(Model.Member));

    if(FeedbackMember!=null && FeedbackMember!="")
    {

        $("#FeedbackMemberNew  option[value="+FeedbackMember+"]").prop('selected',true);
        $("#FeedbackMemberNew").trigger("change");
    }
    else
    {
        swal({ title: "Info !", text: "Please meet admin!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
    }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');









</script>













