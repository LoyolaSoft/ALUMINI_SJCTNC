<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
        ContentLoad = function () {
            //Ready Function()
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');


    $("#CLASS_ID").on('change', function ()
        {
            var select = $("#divAnswerView1");
            select.empty();
            //$("#btnReload").click();
        if ($("#CLASS_ID").val() != '')
            {
                $.ajax({
                    url: "@Url.Action("StaffListByClassId", "Feedback")",
                    async: false,
                    data: { sClassId: $("#CLASS_ID").val() },
                    success: function (data)
                    {
                        var select = $("#FeedbackMember");
                        select.empty();
                        // selectbox.html(list);
                        select.html(data);
                        $("#FeedbackMember").selectpicker('refresh');
                    }, error: function (ex)
                    {
                        alert('Failed to retrieve .' + ex);
                    }
               });
            }
        });

