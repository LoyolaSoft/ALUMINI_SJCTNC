@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BindclassWiseFeedbackReportForStaff";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


@if (Model.liFeedbackEvaluationForReport != null && Model.liFeedbackEvaluationForReport.Count > 0)
{
    <div class="form-group col-md-12 table-responsive">
        <div class="col-md-8 col-lg-offset-2">
            <table class="table table-hover table-bordered" id="tblLiFbReport" cellpadding="50" width="100%" border="1">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Roll_No</th>
                        <th>Student Name</th>
                        <th>Class</th>
                    </tr>
                </thead>
                <tbody style="text-align:center;">
                    @{ int count = 0;}
                    @if (Model.liFeedbackEvaluationForReport != null && Model.liFeedbackEvaluationForReport.Count > 0)
                    {
                        foreach (var item in Model.liFeedbackEvaluationForReport)
                        {
                            <tr>
                                <td>@{count++;} @count</td>
                                <td>@item.ROLL_NO</td>
                                <td>@item.FIRST_NAME</td>
                                <td>@item.CLASS_NAME</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <script>
                            alert("Everyone completed the Feedback");
                        </script>
                    }
                </tbody>
            </table>
        </div>

    </div>
}
else
{
    <div class="alert alert-danger">No Record(s) Found !</div>
}











