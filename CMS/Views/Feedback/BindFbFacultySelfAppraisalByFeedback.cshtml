
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BindFbFacultySelfAppraisalByFeedback";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

@if (Model.liFacultySelfAppraisalEvaluation != null && Model.liFacultySelfAppraisalEvaluation.Count > 0)
{
    <div class="form-group col-md-12 table-responsive">
        <table class="table table-hover table-bordered" id="tblLiFbFacultySelfAppraisal">
            <thead>
                <tr>
                    <th>SL.NO</th>
                    <th>ITEM</th>
                    <th>MARK</th>
                    <th>NUMBER</th>
                    <th>MAX_MARK</th>
                    <th>SCORE</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.liFacultySelfAppraisalEvaluation != null && Model.liFacultySelfAppraisalEvaluation.Count > 0)
                {

                    var liAppraisalType = Model.liFacultySelfAppraisalEvaluation.GroupBy(x => x.APPRAISAL_TYPE_ID).ToList();

                    foreach (var item in liAppraisalType)
                    {
                        var liAppraisal = Model.liFacultySelfAppraisalEvaluation.Where(x => x.APPRAISAL_TYPE_ID == item.FirstOrDefault().APPRAISAL_TYPE_ID).ToList();
                        var isFirst = 0;
                        var count = 0;
                        foreach (var item1 in liAppraisal)
                        {
                            if (isFirst == 0)
                            {
                                <tr>
                                    <td></td>
                                    <td><b>@item1.APPRAISAL_TYPE</b></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }
                            
                                isFirst = isFirst + 1;
                                count = count + 1;
                                <tr cms-fbfpid="@item1.FBFACULTY_APPRAISAL_ID" class="tblappraisal">
                                    <td>@count</td>

                                    <td>@item1.ITEM</td>
                                    <td>


                                        <div class="col-md-12">
                                            <input type="number" class="form-control" placeholder="Mark" name="FFIMark" data-parsley-required="true"   id="txtFFIMark_@item1.FBFACULTY_APPRAISAL_ID" disabled value="@item1.MARK" style="width:auto;">
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col-md-12">
                                            <input type="number" class="form-control" placeholder="Number" name="FFINumber" cms-mark="@item1.MARK" cms-max-mark="@item1.MAX_MARK"  cms-item="txtFFIMark_@item1.FBFACULTY_APPRAISAL_ID"  cms-score="txtFFIScore_@item1.FBFACULTY_APPRAISAL_ID"    data-parsley-required="true" id="txtFFINumber_@item1.FBFACULTY_APPRAISAL_ID" style="width:auto;">
                                        </div>
                                    </td>
                                    <td>@item1.MAX_MARK</td>
                                    <td>
                                        <div class="col-md-12">
                                            <input type="number" class="form-control" placeholder="Score" name="FFIScore" data-parsley-required="true" id="txtFFIScore_@item1.FBFACULTY_APPRAISAL_ID" disabled style="width:auto;">
                                        </div>
                                    </td>
                                </tr>
                            

                        }
                    }
                }

            </tbody>
        </table>
    </div>
    <div class="form-group col-lg-12 row">
        <div class="form-group pull-right">
            <div class="form-group col-md-5">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary">Submit</a>
            </div>
            <div class="col-md-5">
                <a href="javascript:;" class="btn btn-sm btn-danger" id="btnCancel">Cancel</a>
            </div>
        </div>
    </div>
}
else
{

}

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .

        }

        var message=@Html.Raw(Json.Encode(Model.sErrorMessage));
        if(message!=null && message!="")
        {
            alertMessage(message);
        }
        function alertMessage(Message)
        {
            swal({ title: "error !", text:Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
            //swal({

            //    title: "Feedback!",
            //    text: Message,
            //    showConfirmButton: false,
            //    icon: "success",
            //    timer: 1500,
            //    animation: true ,
            //});
        }


    $('#btnSubmit').click(function(){

        var sCount=0;
        var FBFacultySelfAppraisalId;
        var Mark;
        var Number;
        var Score;
        var jsonData='{"liFBFacultySelfAppraisal":[';
        var rowcount=$('#tblLiFbFacultySelfAppraisal tbody tr.tblappraisal').length;
       
        $('#tblLiFbFacultySelfAppraisal tbody  tr').each(function(){

            if($(this).hasClass("tblappraisal"))
            {
                if($(this).find('input[name="FFIMark"]').val() && $(this).find('input[name="FFINumber"]').val() && $(this).find('input[name="FFIScore"]').val() )
                {
                        
                    sCount=parseInt(sCount)+1;
                    FBFacultySelfAppraisalId=$(this).attr('cms-fbfpid');
                    Mark=$(this).find('input[name="FFIMark"]').val();
                    Number=$(this).find('input[name="FFINumber"]').val();
                    Score=$(this).find('input[name="FFIScore"]').val();
                    jsonData+='{"FBFACULTY_APPRAISAL_ID":"'+FBFacultySelfAppraisalId+'","MARK":"'+Mark+'","NUMBER":"'+Number+'","SCORE":"'+Score+'","FEEDBACK_ID":"'+$('#FeedBackSettingList').val()+'"},';

                }
                else
                {
                    swal({ title: "Info !", text: "Please fill all the fields!", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                   
                }
            }
           
               
           
        });
        
        if(sCount==rowcount )
        {
            jsonData = jsonData.slice(0, -1);
            jsonData += ']}';

            $.ajax({
                url: "/Feedback/SaveFeedbackFacultySelfAppraisal",
                type: "post",
                data: { sJsonData: jsonData },
                success: function (data) {
                    if (data.Message != null && data.Message != "" && data.ErrorCode != "" && data.ErrorCode!=null)
                    {

                        if (data.ErrorCode=="201")
                        {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            //loadContent('/Feedback/FeedbackFacultySelfAppraisalEvaluation');
                        }
                        if (data.ErrorCode == "417") {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                    }
                    else {
                        swal({ title: "Info", text: "Something went wrong so please try again!", showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }
                },
                error: function (ex) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }

            });
        }
        else{
            //swal({ title: "Info !", text: "Something went wrong!", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
        }
    });


   
    //validate maximum mark
    $('#tblLiFbFacultySelfAppraisal').find("input[name='FFINumber']").keyup(function(e)
    {
        var MaxValue=$(this).attr("cms-max-mark");
        var ActMark=0;
        ActMark=$(this).attr("cms-mark");
        var keycode = (e.keyCode ? e.keyCode : e.which);
        // alert(this.value);
        if(this.value * parseInt(ActMark) >parseInt(MaxValue) && this.value * parseInt(ActMark)>0)
        {
           
         //   swal({ title: "Info !", text: "Sorry the maximum mark is "+ MaxValue +"!", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
          //  $(this).val('');
            //$('#'+$(this).attr("cms-item")+'').val(MaxValue);
            $('#'+$(this).attr("cms-score")+'').val(MaxValue);
        }
        else if( this.value * parseInt(ActMark)>0 && this.value * parseInt(ActMark)<=parseInt(MaxValue))
        {
            var mark=this.value * parseInt(ActMark);

            //$('#'+$(this).attr("cms-item")+'').val(mark);
            $('#'+$(this).attr("cms-score")+'').val(mark);
        }
        else
        {
            
          //  var mark=this.value * parseInt(ActMark);

            //$('#'+$(this).attr("cms-item")+'').val(mark);
            $('#'+$(this).attr("cms-score")+'').val('0');
        }





    });










       // var tbl = $('#tblLiFbFacultyPerformanceIndex').DataTable();

</script>









