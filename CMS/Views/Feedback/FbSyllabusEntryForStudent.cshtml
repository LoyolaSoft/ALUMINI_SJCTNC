@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Syllabus Feedback Entry </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Syllabus Feedback Entry<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Syllabus Feedback Entry</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12">
                            <div class="form-group col-md-6">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                @Html.Label("Course List", htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @*@Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })*@
                                    <select class="form-control selectpicker show-menu-arrow show-tick" id="CourseList" data-live-search="true">
                                        <option value=""> -- Select -- </option>
                                        @if (Model.liExamRegistrationCourse!=null  && Model.liExamRegistrationCourse.Count>0)
                                        {
                                            foreach (var item in Model.liExamRegistrationCourse)
                                            {
                                                 <option value="@item.COURSE_ROOT_ID" cms-CourseCode="@item.COURSE_CODE">(@item.COURSE_CODE) - @item.COURSE_TITLE</option>       
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12 table-responsive" id="dvSyllabusEntry"  data-parsley-validate="true"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad()
    {
        // Document Ready Function
        $('.selectpicker').selectpicker({ size: 6 });
        $('.selectpicker').selectpicker('refresh');
    }

    $('#CourseList').on('change', function ()
    {
        if ($('#CourseList').val())
        {
            $.ajax({
                url: '@Url.Action("BindFbSyllabusEntryByCourseId", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sCourseId: $('#CourseList').val(), sFeedbackSettingId: $('#FeedBackSettingList').val(), sCourseCode: $('#CourseList option:Selected').attr('cms-CourseCode') },
                success: function (data)
                {
                    $('#dvSyllabusEntry').empty();
                    if (data.Message != null && data.Message != "")
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    } else
                    {
                        $('#dvSyllabusEntry').append(data);
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });

  
    function printDiv(divName)
    {
        var printContents = document.getElementById(divName).innerHTML;
        myWindow = window.open('', '', 'width=200,height=100');
        myWindow.document.write(printContents);
        myWindow.document.close(); //missing code
        myWindow.focus();
        myWindow.print();
        //var printContents = document.getElementById(divName).innerHTML;
        //var originalContents = document.body.innerHTML;

        //document.body.innerHTML = printContents;

        //window.print();

        //document.body.innerHTML = originalContents;
        //loadContent('/Examination/ExamFilledApplicationList');
    }
</script>