
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.ViewModel.ViewModel
@{
    ViewBag.Title = "FacultyPerformanceIndex";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListFacultyPerformanceIndex</li>
    </ol>
    <h1 class="page-header">List Faculty Performance Index</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Faculty Performance Index</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#FbFacultyPerformanceIndex-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblLiFbFacultyPerformanceIndex">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Feedback Setting</th>
                            <th>item</th>
                            <th>Mark</th>
                            <th>Maximum Mark</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liFbFacultyPerformanceIndex != null && Model.liFbFacultyPerformanceIndex.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liFbFacultyPerformanceIndex)
                            {
                                count = count + 1;
                                <tr>
                                    <td>@count</td>

                                    <td>@item.FEEDBACK_SETTING</td>
                                    <td>@item.ITEM</td>
                                    <td>@item.MARK</td>
                                    <td>@item.MAX_MARK</td>
                                   
                                    <td>
                                        <a href="#FbFacultyPerformanceIndex-dialog" onclick="FetchFeedbackFacultyPerformanceIndexById(@item.FBFACULTY_PERFORMANCE_INDEX_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.FBFACULTY_PERFORMANCE_INDEX_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="FbFacultyPerformanceIndex-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Feedback Faculty Performance Index</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <div class="col-md-12 form-group">
                                        @Html.Label("Feedback  ", htmlAttributes: new { @class = "col-md-4 control-label " })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                   
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Item</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtItem" class="form-control" placeholder="Item" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Mark</label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtMark" class="form-control" placeholder="Mark" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Maximum Mark</label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtMaxMark" class="form-control" placeholder="Maximum Mark" data-parsley-required="true">
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="FbFacultyPerformanceIndex" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

        var sAcademicStatus=@Html.Raw(Json.Encode(FeedbackViewModel.sAcademicAttempt));

        if(sAcademicStatus>0)
        {
            if(sAcademicStatus==1)
            {
                changeAcademicYear(@Session["ACADEMIC_YEAR"]);
            }
                
        }
        else
        {
                  
                  
        }

        var tbl = $('#tblLiFbFacultyPerformanceIndex').DataTable();

        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var FbFacultyPerformanceIndexId = $('#FbFacultyPerformanceIndex').val();
            var FbId = $('#FeedBackSettingList').val();
            var Item = $('#txtItem').val();
            var mark=$('#txtMark').val();
            var Maxmark = $('#txtMaxMark').val();


            var jsonData = '{"FBFACULTY_PERFORMANCE_INDEX_ID":"' + FbFacultyPerformanceIndexId + '","ITEM":"' + Item + '","MAX_MARK":"' + Maxmark + '","FEEDBACK_ID":"' + FbId + '","MARK":"'+mark+'"}';


              var req=  $.ajax({
                  url: "/FeedBack/SaveorUpdateFeedBackFacultyPerformanceIndex",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "")
                        {
                            if (data.ErrorCode == "417")
                            {
                                swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                            }
                            if (data.ErrorCode == "208") {
                                swal({ title: "Info !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                            }
                            if (data.ErrorCode == "200") {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/FeedBack/FacultyPerformanceIndex');
                            }

                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

              });

        });

        GetConfirm = function (feedbackPerformanceIndexId)
        {
            swal({
                title: "Are you sure want to Delete?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, I agree!",
                closeOnConfirm: false
            },
       function(){   $.ajax({
           url: "/FeedBack/DeleteLiFeedBackFacultyPerformanceIndex",
           type:"post",
           data: { sFeedBackFacultyPerformanceIndex: feedbackPerformanceIndexId },
           success:function(data)
           {
               if (data.Message != null && data.Message != "")
               {
                   swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                   loadContent('/FeedBack/FacultyPerformanceIndex');
               }
           },
           error:function(ex)
           {
               swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

           }


       });
       });
    }


    function FetchFeedbackFacultyPerformanceIndexById(feedbackPerformanceIndexId)
    {
        if (feedbackPerformanceIndexId!="")
        {
            $.ajax({
                url: "/FeedBack/FetchLiFeedBackFacultyPerformanceIndexByFeedbackFacultyperformanceIndex",
                type: "post",
                data: { sFeedBackFacultyPerformanceIndex: feedbackPerformanceIndexId },
                success: function (data) {
                    if (data.Message != null) {
                        alert(data.Message);
                    }
                    else {
                        if (data.oResult[0] != null) {

                            $('#txtItem').attr('value', data.oResult[0].ITEM);
                            $('#txtMark').attr('value', data.oResult[0].MARK);
                            $('#txtMaxMark').attr('value', data.oResult[0].MAX_MARK);
                            $('#FeedBackSettingList option[value="' + data.oResult[0].FEEDBACK_ID + '"]').attr("selected", "selected");
                            //$('#QuestionTypeList option[value="' + data.oResult[0].QUESTION_TYPE_ID + '"]').attr("selected", "selected");
                            //$('#txtNoOfQuestion').attr('value', data.oResult[0].NO_OF_QUESTION);
                            //$('#sQuestionGroupList option[value="' + data.oResult[0].FEEDBACK_TYPE + '"]').attr("selected", "selected");
                            $('#FbFacultyPerformanceIndex').attr('value', data.oResult[0].FBFACULTY_PERFORMANCE_INDEX_ID);
                            $('.selectpicker').selectpicker('refresh');
                        }


                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }


            });


        }
    }



        $('#Add').click(function () {

            $('#pBody').parsley().destroy();

            $('#FeedBackSettingList option[value=""]').attr("selected", "selected");
            $('#txtItem').attr('value', '');
            $('#txtMark').attr('value', '');
            $('#txtMaxMark').attr('value', '');
            $('#FbFacultyPerformanceIndex').attr('value', '');
            $('.selectpicker').selectpicker('refresh');
        });





</script>






