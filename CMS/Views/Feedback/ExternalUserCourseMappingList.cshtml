@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("EXTERNALUSERS", "DASHBOARD")">Home</a></li>
        <li class="active">Course Mapping List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Course Mapping List <small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Course Mapping List </h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="col-md-12 table-responsive">
                            <div class="form-group">
                                <a class="btn btn-success pull-right" href="#ModalContent-dialog" data-toggle="modal"><i class="fa fa-plus"></i> ADD</a>
                                &nbsp; &nbsp; &nbsp; 
                                <a class="btn btn-primary pull-right" href="javascript:;" onclick="SendSMS();"><i class="fa fa-envelope-o text-white"></i> Send SMS</a>
                            </div>
                            <br />
                            <div class="form-group">
                                <table class="table table-bordered table-hover" id="tblExternalUser">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Code</th>
                                            <th>Title</th>
                                            <th>Name</th>
                                            <th>College</th>
                                            <th>Mobile No</th>
                                            <th>Date From</th>
                                            <th>Date To</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.liExternalUserCourseMapping != null && Model.liExternalUserCourseMapping.Count > 0)
                                        {
                                            int nCount = 0;
                                            foreach (var item in Model.liExternalUserCourseMapping)
                                            {
                                                <tr>
                                                    <td>@{nCount++;} @nCount</td>
                                                    <td>@item.COURSE_CODE</td>
                                                    <td>@item.COURSE_TITLE</td>
                                                    <td>@item.FIRST_NAME</td>
                                                    <td>@item.COLLEGE_NAME</td>
                                                    <td>@item.MOBILE_NO</td>
                                                    <td>@item.DATE_FROM</td>
                                                    <td>@item.DATE_TO</td>
                                                    <td>
                                                        @if (item.IS_FINISHED=="1")
                                                        {
                                                            <i class="ion-ios-checkmark-outline fa-2x text-success"></i>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a href="#ModalContent-dialog" data-toggle="modal" onclick="FetchCourseMappingById(@item.COURSE_MAPPING_ID)"><i class="fa fa-edit"></i></a>
                                                        <a href="javascript:;" onclick="DeleteConfrim(@item.COURSE_MAPPING_ID)"><i class="fa fa-trash text-danger"></i></a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<!-- Begin Modal -->
<div class="modal" id="ModalContent-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit External User</h4>
            </div>
            <div class="modal-body" id="dvValidate" data-parsley-validate="true">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">

                            <!-- Feedback Setting -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Feedback Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true" , @data_parsley_required = "true" })
                                </div>
                            </div>

                            <!-- Staff -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Staff", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.StaffListByDepartmet, (Model.StaffListByDepartmet != null) ? Model.StaffListByDepartmet : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <!-- User Code -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), null, new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_actions_box= "true",multiple="multiple", @data_parsley_required = "true" })
                                </div>
                            </div>

                            <!-- Date From -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Date From", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker1">
                                        <input type="text" id="txtFromDate" class="form-control input-sm" placeholder="dd/mm/yyyy"  data-parsley-required = "true"/>
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Date To -->
                            <div class="col-md-12 form-group">
                                @Html.Label("Date To", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker1">
                                        <input type="text" id="txtToDate" class="form-control input-sm" placeholder="dd/mm/yyyy"  data-parsley-required = "true"/>
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveExternalUser()" class="btn btn-sm btn-primary" >Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
<!-- End Modal -->

<input type="hidden" name="name" value="" id="hdCourseMappingId" />

<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>

@* On Load Script *@
<script>
    
    function ContentLoad()
    {
        handleDatepicker = function ()
        {
            "use strict";
            $(".date").datepicker({
                todayHighlight: true,
                autoclose: true,
                format: "dd/mm/yyyy",
                orientation: "down bottom",
                zIndexOffset: '15',
                defaultDate: new Date()
            })
        }
        handleDatepicker();
        $('#tblExternalUser').DataTable({ "bPaginate": false });
    }
    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');
</script>

@* Fetch Record by Id Script *@
<script>
    function FetchCourseMappingById(Id)
    {
        $.ajax({
            url: '@Url.Action("FetchExternalUserCourseById", "Feedback")',
            method: 'POST',
            datatype: 'json',
            data: { sCourseMappingId: Id },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#hdCourseMappingId').val(data[0].COURSE_MAPPING_ID);
                    $('#FeedBackSettingList').val(data[0].FEEDBACK_SETTING_ID);
                    $('#CourseList').val(data[0].COURSE_ID);
                    $('#StaffListByDepartmet').val(data[0].STAFF_ID);
                    $('#txtFromDate').val(data[0].DATE_FROM);
                    $('#txtToDate').val(data[0].DATE_TO);
                    
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

@* Save / Update Script *@
<script>
    $(function () {
        $('#ModalContent-dialog').on('hidden.bs.modal', function (e) {
            $('#hdCourseMappingId').val('');
            $('#FeedBackSettingList').val('');
            $('#CourseList').val('');
            $('#StaffListByDepartmet').val('');
            $('#txtFromDate').val('');
            $('#txtToDate').val('');
            $('.selectpicker').selectpicker('refresh');
        });
    });
    function SaveExternalUser()
    {
        // Validation Check ,...
        var isValid = true;
        if ($('#dvValidate').parsley().validate() !== true) isValid = false;
        if (!isValid)
        {
            //gritter-info,danger,success,warning,default
            swal({ title: "Warning !", text: 'Something went wrong ! Please check your inputs !', showConfirmButton: false, timer: 2500, type: 'warning', animation: true });
            return false;
        }

        var JsonData = '{"COURSE_MAPPING_ID":"' + $('#hdCourseMappingId').val() + '",\
                         "FEEDBACK_SETTING_ID":"' + $('#FeedBackSettingList').val() + '",\
                         "COURSE_ID":"' + String($('#CourseList').val()) + '",\
                         "STAFF_ID":"' + $('#StaffListByDepartmet').val() + '",\
                         "DATE_FROM":"' + $('#txtFromDate').val() + '",\
                         "DATE_TO":"' + $('#txtToDate').val() + '"}';

        $.ajax({
            url: '@Url.Action("SaveExternalUserCourseMapping", "Feedback")',
            method: 'POST',
            datatype:'json',
            data: { sJson: JsonData },
            success: function (data)
            {
                if (data.ErrorCode != "200")
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#ModalContent-dialog').modal('hide');
                    swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    loadContent('/Feedback/ExternalUserCourseMappingList');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

@* Delete Script *@
<script>
    function DeleteConfrim(Id)
    {
         swal({
             title: "Are you sure to delete ?",
             text: "",
             type: "warning",
             showCancelButton: true,
             confirmButtonClass: "btn-danger",
             confirmButtonText: "Yes, Delete!",
             closeOnConfirm: false
         },function()
         {
            $.ajax({
                 url: '@Url.Action("DeleteExternalUserCourseMapping", "Feedback")',
                 method: 'POST',
                 datatype: 'json',
                 data: { sCourseMappingId: Id },
                 success: function (data)
                 {
                     if (data.ErrorCode != "200")
                     {
                         swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                     } else
                     {
                         swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                         loadContent('/Feedback/ExternalUserCourseMappingList');
                     }
                 }, error: function (error)
                 {
                     swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                 }
             });
        })
    }
</script>

@* SMS Script *@
<script>
    function SendSMS()
    {
        $.ajax({
            url:'@Url.Action("SendSMS", "Feedback")',
            method:'POST',
            datatype:'json',
            success: function (data)
            {
                if (data.ErrorCode != "200")
                {
                    swal({ title: " Error!", text: data.Message, showConfirmButton: false, timer: 2500, type: 'error', animation: true });
                } else
                {
                    swal({ title: " Success !", text: data.Message, showConfirmButton: false, timer: 2500, type: 'success', animation: true });
                    //loadContent('/Feedback/ExternalUserCourseMappingList');
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>