
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.ViewModel.ViewModel
@{
    ViewBag.Title = "ListFeedbackSetting";
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListFeedbackSetting</li>
    </ol>
    <h1 class="page-header">List Feedback Setting</h1>

    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Feedback Setting</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#FbSetting-dialog" data-toggle="modal" id="Add"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>

            <div class="form-group col-md-12 table-responsive">
                <table class="table table-hover table-bordered" id="tblLiFbSetting">
                    <thead>
                        <tr>
                            <th>#</th>

                            <th>Feedback Name</th>
                            <th>Date From</th>
                            <th>Date To</th>
                            @*<th>Question Type</th>*@
                           @*@ <th>No of Quetion</th>*@
                            @*@<th>Feedback Type</th>*@
                            <th>Active/Deactive</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.liFbSettings != null && Model.liFbSettings.Count > 0)
                        {
                            var count = 0;
                            foreach (var item in Model.liFbSettings)
                            {
                                count = count + 1;
                               
                                <tr>
                                    <td>@count</td>

                                    <td>@item.FEEDBACK_NAME</td>
                                    <td>@item.DATE_FROM</td>
                                    <td>@item.DATE_TO</td>
                                    @*<td>@item.QUESTION_TYPE</td>*@
                                    @*@<td>@item.NO_OF_QUESTION</td>*@
                                    @*@<td>@item.FEEDBACK_TYPE_NAME</td>*@
                                  <td>
                                      @if (item.IS_ACTIVE == "1")
                                      {
                                          <a href="javascrip:;" onclick="SetActive(@item.FEEDBACK_ID,0)" class="text-success"><i class="fa fa-check"></i></a>             }
                                      else
                                      {
                                          <a href="javascrip:;" onclick="SetActive(@item.FEEDBACK_ID,1)" class="text-danger"><i class="fa fa-times"></i></a>
                                      }
                                  </td>
                                   
                                    <td>
                                        <a href="#FbSetting-dialog" onclick="FetchLiFeedBackSettingById(@item.FEEDBACK_ID)" data-toggle="modal" class="text-primary"><i class="fa fa-edit"></i></a>

                                        <a href="javascrip:;" onclick="GetConfirm(@item.FEEDBACK_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>
                                </tr>
                            }

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="FbSetting-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Feedback Settings</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">
                                  

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Feedback Name</label>

                                        <div class="col-md-8">
                                            <input type="text" id="txtName" class="form-control" placeholder="FeedBack Name" data-parsley-required="true">
                                        </div>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">  Date From </label>

                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateFrom">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtStartDate" class="form-control input-sm" placeholder="Select  Date" id="txtStartDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                       
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Date To</label>
                                        <div class="col-md-8">
                                            <div class="input-group date" id="dpDateTo">
                                                @*@Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" , @name = "txtDate" } })*@
                                                <input type="text" name="txtEndDate" class="form-control input-sm" placeholder="Select  Date" id="txtEndDate" data-parsley-required="true" />

                                                <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                       
                                    </div>

                                    @*<div class="col-md-12 form-group">
                                        @Html.Label("Question Type", htmlAttributes: new { @class = "col-md-4 control-label " })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.QuestionTypeList, (Model.QuestionTypeList != null) ? Model.QuestionTypeList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.QuestionTypeList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>*@
                                    @*@<div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">No of Questions</label>

                                        <div class="col-md-8">
                                            <input type="number" id="txtNoOfQuestion" class="form-control" placeholder="No of Questions" data-parsley-required="true">
                                        </div>
                                    </div>
                                        *@
                                    @*@<div class="col-md-12 form-group">
                                        @Html.Label("Feed Back Category", htmlAttributes: new { @class = "col-md-4 control-label " })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.sQuestionGroupList, (Model.sQuestionGroupList != null) ? Model.sQuestionGroupList : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true",@multiple="multiple" })
                                            @Html.ValidationMessageFor(m => m.sQuestionGroupList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                        *@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="FeedBackId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>
        function ContentLoad()
        {
            // Document Ready Function .
        }

            var sAcademicStatus=@Html.Raw(Json.Encode(FeedbackViewModel.sAcademicAttempt));

             if(sAcademicStatus>0)
             {
                 if(sAcademicStatus==1)
                 {
                     changeAcademicYear(@Session["ACADEMIC_YEAR"]);
                 }

             }
             else
             {


             }


        var tbl = $('#tblLiFbSetting').DataTable();

        handleDatepicker = function () {
            "use strict";


            $("#txtStartDate").datepicker({
                todayHighlight: true,
                autoclose: true,
              //  endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
            $("#txtEndDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                //endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });


        }
        handleDatepicker();




        function FetchLiFeedBackSettingById(FeedBackId)
        {
            $('#pBody').parsley().destroy();

            if (FeedBackId != null)
            {
                $.ajax({
                    url: "/FeedBack/FetchLiFeedBackSettingById",
                    type:"post",
                    data: { sFeedBackId: FeedBackId },
                    success:function(data)
                    {
                        if(data.Message!=null)
                        {
                            alert(data.Message);
                        }
                        else {
                            if (data.oResult[0] != null)
                            {

                                $('#txtName').attr('value', data.oResult[0].FEEDBACK_NAME);
                                $('#txtStartDate').attr('value', data.oResult[0].DATE_FROM);
                                $('#txtEndDate').attr('value', data.oResult[0].DATE_TO);
                                //$('#QuestionTypeList option[value="' + data.oResult[0].QUESTION_TYPE_ID + '"]').attr("selected", "selected");
                                //$('#txtNoOfQuestion').attr('value', data.oResult[0].NO_OF_QUESTION);
                                //$('#sQuestionGroupList option[value="' + data.oResult[0].FEEDBACK_TYPE + '"]').attr("selected", "selected");
                                $('#FeedBackId').attr('value', data.oResult[0].FEEDBACK_ID);
                                $('.selectpicker').selectpicker('refresh');
                            }


                        }

                    },
                    error:function(ex)
                    {
                        alert(ex.Message);
                    }
                });
            }
        }

        $('#btnSubmit').click(function () {

            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var FeedBackId = $('#FeedBackId').val();
            var FeedBackName = $('#txtName').val();
            var DateFrom = $('#txtStartDate').val();
            var DateTo = $('#txtEndDate').val();
            //var QuestionType = $('#QuestionTypeList').val();
            //var NoofQuestion = $('#txtNoOfQuestion').val();
            //var FeedBAckCategory = $('#sQuestionGroupList').val();
            //var AutoReneval;
            //if ($('#AutoReneval').is(":checked"))
            //{
            //     AutoReneval = 1;
            //}
            //else
            //{
            //    AutoReneval = 0;
            //}
            //var ExtraBook = $('#txtExtraBooks').val();


            var jsonData = '{"FEEDBACK_ID":"' + FeedBackId + '","FEEDBACK_NAME":"' + FeedBackName + '","DATE_FROM":"' + DateFrom + '","DATE_TO":"' + DateTo + '","NO_OF_QUESTION":""}';


              var req=  $.ajax({
                    url: "/FeedBack/SaveorUpdateFeedBackSetting",
                    type: "post",
                    data: { sJsonData: jsonData },
                    success: function (data) {
                        if (data.Message != null && data.Message != "")
                        {
                            if (data.ErrorCode == "200")
                            {
                                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                                loadContent('/FeedBack/ListFeedbackSetting');
                            }
                            if (data.ErrorCode == "417") {
                                swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                            }
                            if (data.ErrorCode == "503") {
                                swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                            }


                        }
                    },
                    error: function (ex) {
                        swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

              });
              @*req.done(function (response) {
                  var item = @Html.Raw(Json.Encode(Model.liRules));
                  alert(item[0].MAX_BOOKS);
                  tbl.rows().remove().draw();
                  for(var i=0;i<item.length;i++)
                  {

                         //alert(item[i].MAX_BOOKS);
                         var result=[];
                         result.push(i);
                         result.push(item[i].CATEGORY_NAME);
                         result.push(item[i].MAX_BOOKS);
                         result.push(item[i].LOAN_PERIOD);
                         result.push(item[i].FINE_AMOUNT);
                         result.push(item[i].DEPOSIT);
                         result.push(item[i].AUTORENEVAL);
                         result.push(item[i].EXTRA_BOOKS);
                         result.push(item[i].EXTRA_BOOKS);

                  }
                  tbl.rows.add(result);
                  tbl.draw();
              });*@


        });


    function SetActive(FeedBackId,Mode)
    {
        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "/FeedBack/ActivateorDeactivateFeedBackSettingBySettingId",
                type: "post",
                data: { sFeedBackId: FeedBackId,sMode:Mode},
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/FeedBack/ListFeedbackSetting');
                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                }

            });
        });

    }


    GetConfirm = function (FeedBackId)
        {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },


function () {
    $.ajax({
        url: "/FeedBack/DeleteLiFeedBackSettingById",
        type: "post",
        data: { sFeedBackId: FeedBackId },
        success: function (data) {
            if (data.Message != null && data.Message != "") {
                swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                loadContent('/FeedBack/ListFeedbackSetting');
            }
        },
        error: function (ex) {
            swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

        }


    });
});

        }

        $('#Add').click(function () {

            $('#pBody').parsley().destroy();

            $('#txtName').attr('value', '');
            $('#txtStartDate').attr('value','');
            $('#txtEndDate').attr('value', '');
            //$('#QuestionTypeList option[value=""]').attr("selected", "selected");
            $('#txtNoOfQuestion').attr('value','');
            $('#sQuestionGroupList option[value=""]').attr("selected", "selected");
            $('#FeedBackId').attr('value', '');
            $('.selectpicker').selectpicker('refresh');


        });

        function refreshTable() {
            $('#tblLiRules').each(function () {
                dt = $(this).dataTable();
                dt.fnDraw();
            });
        }
</script>



