    //    $('#dvFeedbackBind table tr').each(function () {
    //        var data = [];
    //        $(this).find('td, th').each(function () {
    //            var text = $(this).text().replace(/"/g, '""'); // Escape double quotes
    //            data.push(`"${text}"`); // Add quotes around each field
    //        });
    //        csvContent += data.join(",") + "\n";
    //    });

    //    let file = new Blob([csvContent], { type: "text/csv" });
    //    let url = URL.createObjectURL(file);
    //    let a = $("<a />", {
    //        href: url,
    //        download: title + ".csv"
    //    }).appendTo("body").get(0).click();
    //}

</script>