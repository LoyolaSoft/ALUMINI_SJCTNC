@model CMS.ViewModel.ViewModel.FeedbackViewModel


@{
    Layout = null;
}

<!-- ================== BEGIN PAGE LEVEL STYLE ================== -->
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<!-- ================== END PAGE LEVEL STYLE ================== -->

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">Feedback</a></li>
        <li class="active">Feedback  Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Feedback  Report<small></small></h1>
    <!-- end page-header -->

    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Feedback  Report</h4>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="col-md-12 form-group">
                        <div class="col-md-3 form-group">
                            <label class="col-md-3 control-label">Year</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3 form-group">
                            <label class="col-md-3 control-label">FeedBack</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.FeedBackSettingList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3 form-group">
                            <label class="col-md-3 control-label">Dept</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.DepartmentList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3 form-group">
                            <label class="col-md-3 control-label">Staff</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.StaffListByDepartmet, (Model.StaffListByDepartmet != null) ? Model.StaffListByDepartmet : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.StaffListByDepartmet, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>


                    <div class="col-md-12 form-group">

                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Class</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-4 form-group">
                            <label class="col-md-3 control-label">Course</label>
                            <div class="col-md-9">
                                @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_parsley_required = "true", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.CourseList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-1 form-group">
                            <a href="javascript:;" class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                        <div class="col-md-2 form-group">
                            <a href="javascript:;" class="btn btn-success hidden" id="btnPrint" onclick="printDiv()">Print</a>
                        </div>
                        <div class="col-md-1 form-group">
                            <a href="javascript:;" class="btn btn-success hidden" id="btnExport" onclick="Export()">Export</a>
                        </div>
                    </div>

                    <div class="col-md-12 form-group">
                        <div id="dvFeedbackBind"></div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>



<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>


<script>

    function ContentLoad() {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

</script>



<script>
    $('#ClassList').on('change', function () {
        fetchCourse();

    })
    $('#StaffListByDepartmet').on('change', function () {
        fetchCourse();
        fetchClassList();
    })
    $('#FeedBackSettingList').on('change', function () {
        fetchCourse();
        fetchClassList();
    })

    //on ac year change
    $('#AcademicYearList').on('change', function () {
        if ($('#AcademicYearList').val()) {
            $.ajax({
                url: '@Url.Action("FetchStaffFeedBacksettingByYear", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sAcyear: $('#AcademicYearList option:selected').text() },
                success: function (data) {
                    $('#FeedBackSettingList').empty();
                    $('#FeedBackSettingList').append(data);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });



    $('#DepartmentList').on('change', function ()
    {
        if ($('#DepartmentList').val())
        {
            $.ajax({
                url: '@Url.Action("FetchStaffByDepartmentById", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sDepartmentId: $('#DepartmentList').val() },
                success: function (data)
                {
                    $('#StaffListByDepartmet').empty();
                    if (data.ErrorCode == '200')
                    {
                        $('#StaffListByDepartmet').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });



  function  fetchClassList(){
        if ($('#StaffListByDepartmet').val() && $('#FeedBackSettingList').val() && $('#AcademicYearList option:selected').text())
        {
            $.ajax({
                url: '@Url.Action("FetchClassByStaffIdAndFeedBackIdAndAcYear", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sStaffId: $('#StaffListByDepartmet').val(), sFeedBackId: $('#FeedBackSettingList').val(), sAcademicYear: $('#AcademicYearList option:selected').text()},
                success: function (data)
                {
                    $('#ClassList').empty();
                    $('#CourseList').empty();
                    if (data.ErrorCode == '200')
                    {
                        $('#ClassList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    };

    function fetchCourse() {
        if ($('#ClassList').val() && $('#StaffListByDepartmet').val() && $('#FeedBackSettingList').val())
        {
            $.ajax({
                url: '@Url.Action("FetchCourseByClassIdAndFeedBackId", "SupportData")',
                method: 'POST',
                datatype: 'json',
                data: { sClassId: $('#ClassList').val(), sStaffId: $('#StaffListByDepartmet').val(), sFeedBackId: $('#FeedBackSettingList').val() },
                success: function (data)
                {
                    $('#CourseList').empty();
                    if (data.ErrorCode == '200')
                    {
                        $('#CourseList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    } else
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }

                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    };

    $('#btnGet').on('click', function ()
    {
        if ($('#ClassList').val() && $('#StaffListByDepartmet').val() && $('#FeedBackSettingList').val() && $('#CourseList').val() && $('#AcademicYearList  option:Selected').text()) {
            //var Json = '{"DEPARTMENT_ID":"' + $('#DepartmentList').val() + '","STAFF_ID":"' + $('#StaffListByDepartmet').val() + '","sFbSettingId":"' + $('#AcademicYearList Option:selected').text() + '"}';
            $.ajax({
                url: '@Url.Action("BindFeedBackReportForSJC", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sFbSettingId: $('#FeedBackSettingList').val(), sSatffId: $('#StaffListByDepartmet').val(), sClassId: $('#ClassList').val(), sCourseId: $('#CourseList').val(), sAcYear: $('#AcademicYearList  option:Selected').text() },
                success: function (data) {
                    $('#dvFeedbackBind').empty();
                    if (data.Message != null && data.Message != '') {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else {
                        $('#dvFeedbackBind').append(data);
                        $('#lblDepartment').text($('#DepartmentList Option:selected').text());
                        $('#lblStaff').text($('#StaffListByDepartmet Option:selected').text());
                        $('#lblClass').text($('#ClassList Option:selected').text());
                        $('#lblCourse').text($('#CourseList Option:selected').text());
                        $('#dvFbSetting').text($('#FeedBackSettingList Option:selected').text());
                        $('#btnPrint').removeClass('hidden');
                        $('#btnExport').removeClass('hidden');
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
        else
        {

            swal({ title: "Please Select All The Fields", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });

        }

    });


    function printDiv() {

        var printContents = document.getElementById('dvFeedbackBind').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        //loadContent('/IQAC/IQACDateWiseReportForIncharge');
        $('#btnGet').click();
    }


    function Export()
    {
        var title = "";
        var sAcademicYear = $('#FeedBackSettingList option:selected').text();
        var Department = $('#DepartmentList option:selected').text();
        var sSatff = $('#StaffListByDepartmet option:selected').text();
        title = sAcademicYear + "_" + sSatff + "_" + Department;
        let file = new Blob([$('#dvFeedbackBind').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        $('#btnGet').click();
        //e.preventDefault();
       // loadContent('/IQAC/IQACDateWiseReportForIncharge');
    }
