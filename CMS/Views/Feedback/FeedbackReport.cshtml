<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
        ContentLoad = function () {
            //Ready Function()
        }
        $('.selectpicker').selectpicker({
            size: 6
        });
        $('.selectpicker').selectpicker('Refresh');

    $("#ProgrammeList").on('change', function () {
        //$("#btnReload").click();



        if ($("#ProgrammeList").val() != '') {
            $.ajax({
                url: "@Url.Action("FetchStaffByProgramme", "Feedback")",
                async: false,
            data: { sProgrammeId: $("#ProgrammeList").val() },
            success: function (data) {
                var select = $("#FeedbackMember");
                select.empty();
                // selectbox.html(list);
                select.append('<option value=""> -- Select -- </option>' + data);
                //select.html(data);
                $("#FeedbackMember").selectpicker('refresh');
            }, error: function (ex) {
                alert('Failed to retrieve .' + ex);
            }
        });
    }
    else
    {
                var select = $("#FeedbackMember");
                 select.empty();
    }
    });

    // this is common for all the feedback member change event
    // this is for fetching the question based  on the feedback ,assessor and assesse
    $("#FeedbackMember").on('change', function () {

        if ($("#FeedbackMember").val() != '') {
            $.ajax({
                url: "@Url.Action("BindFeedbackReport", "Feedback")",
                async: false,
                data: { sStaffId: $("#FeedbackMember").val(), sFeedBackId: $('#FeedBackSettingList').val() },
              success: function (data) {
                if (data.Message != null && data.Message != "") {
                    swal({ title: "error !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    //loadContent('/Library/LiUserList');
                }
                else {
                    $('#btnPrint').removeClass("hidden");
                    $('#btnExport').removeClass("hidden");


                    $('#divAnswerView').html('');
                    $('#divAnswerView').append(data);
                }

            }, error: function (ex) {
                //alert('Failed to retrieve .' + ex);
                swal({ title: "Error !", text: "Intetrnal Server Error!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
            }
        });
    }
    });


    $('#sDepartmentList').on('change', function ()
    {
        if (String($('#sDepartmentList').val())) {
            $.ajax({
                url: '@Url.Action("FetchClassByDepartmentId", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sDepartmentId: String($('#sDepartmentList').val())},
                success: function (data)
                {
                    $("#sClassList").empty();
                    $("#sClassList").append(data);
                    $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });




    $('#btnGet').on('click', function ()
    {
        //var Json = '{"DEPARTMENT_ID":"' + $('#DepartmentList').val() + '","STAFF_ID":"' + $('#StaffListByDepartmet').val() + '","sFbSettingId":"' + $('#AcademicYearList Option:selected').text() + '"}';
        if ($("#sFeedbackSettingList").val() && String($('#sDepartmentList').val()) && String($('#sClassList').val()))
        {
            $.ajax({
                url: '@Url.Action("BindFeedBackReportForStudent", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sFbSettingId: $('#sFeedbackSettingList').val(), sClassId: String($('#sClassList').val()) },
                success: function (data) {
                    $('#divAnswerView').empty();
                    if (data.Message != null && data.Message != '')
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else {
                        $('#divAnswerView').append(data);

                        $('#btnPrint').removeClass('hidden');
                        $('#btnExport').removeClass('hidden');
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
