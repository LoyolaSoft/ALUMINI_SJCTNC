
@model CMS.ViewModel.ViewModel.FeedbackViewModel
@using CMS.Utility;
@{
    Layout = null;
    int nCount = 0;
}

<div class="form-group col-md-12">
    <div class="form-group text-center">
        <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" style="width:150px; height:150px" />
    </div>

    <div class="form-group text-center">
        <h4>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME</h4>
        <h5>
            @Model.liCollegeDetails.FirstOrDefault().UNIVERSITY<br />
            @Html.Raw(Model.liCollegeDetails.FirstOrDefault().GRADE.Replace("rd", "<sup>rd</sup>"))<br />
        </h5>

    </div>
</div>

<div class="form-group col-md-12 table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Department</th>
                <th>Class Name</th>
                <th>Shift</th>
                <th>Class Year</th>
                <th>Application Type</th>
                <th>Total Student</th>
                <th>Attended Student</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.liFeedbackEvaluationForReport != null && Model.liFeedbackEvaluationForReport.Count > 0)
            {

                foreach (var item in Model.liFeedbackEvaluationForReport)
                {
                    nCount++;
                    <tr>
                        <td>@nCount</td>
                        <td>@item.DEPARTMENT</td>
                        <td>@item.CLASS_NAME</td>
                        <td>@item.SHIFT</td>
                        <td>@item.CLASS_YEAR</td>
                        <td>@item.APPLICATION_TYPE</td>
                        <td>@item.TOTAL_STUDENT</td>
                        <td>@item.ATTEND_STUDENT</td>
                    </tr>

                }
            }

    </table>
</div>
