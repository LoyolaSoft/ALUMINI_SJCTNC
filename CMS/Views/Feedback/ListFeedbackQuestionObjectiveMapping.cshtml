        url: "@Url.Action("BindFeedbackQuestionObjectives", "FeedBack")",
        method: "POST",
        datatype: "json",
        data: { sacyear: acyear, sfeedbacksetting: feedbacksetting },
        success: function (data) {

            $('#bindtable').empty();
            $('#bindtable').append(data);
            $('#tblLiFbSetting').DataTable({
                dom: "lBfrtip", buttons: [{
                    extend: "excel", className: "btn-sm ",

