    function FetchLiFeedBackQuestionMappingById(QUESTION_OBJECT_ID) {

        if (!QUESTION_OBJECT_ID || QUESTION_OBJECT_ID.trim() === "") {
            swal("Error", "Invalid Question Object ID", "error");
            return;
        }

       /* $('#pBody').parsley().destroy();*/

        $.ajax({
            url: "/FeedBack/FetchFeedbackQuestionObjectiveMappingById",
            type: "POST",
            data: { QuestionObjectId: QUESTION_OBJECT_ID },
            dataType: "json",
            success: function (data) {

                if (data.Message) {
                    swal("Error", data.Message, "error");
                } else if (data.oResult && data.oResult.length > 0) {

                    var mapping = data.oResult[0];

                    $('#QUESTION_OBJECT_ID').val(mapping.QUESTION_OBJECT_ID);
                    $('#FeedBackSettingList2').val(mapping.FEEDBACK_ID);
                    $('#sQuestionList').val(mapping.QUESTION_ID);
                    $('#sObjectiveList').val(mapping.OBJECTIVE_ID);
                    $('#AcademicYearList option:selected').text(mapping.ACADEMIC_YEAR);
                    $('#Active').prop('checked', mapping.IS_ACTIVE == 1);

                    $('.selectpicker').selectpicker('refresh');
                    $('#FbQuestionObjectiveMapping').modal('show');
                }
            },
            error: function (xhr, status, error) {

                swal("Error", "Failed to fetch mapping details: " + error, "error");
            }
        });
    }




    $('#btnSubmit').click(function () {

        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            return false;
        }

        // Get values from form fields
        var questionObjectId = $('#QUESTION_OBJECT_ID').val();
        var feedbackId = $('#FeedBackSettingList2').val();
        var questionId = $('#sQuestionList').val();
        var objectiveId = $('#sObjectiveList').val();
        var academicYear = $('#AcademicYearList option:selected').text();
        var isActive = $('#Active').is(':checked') ? 1 : 0;

        // Prepare data as JSON string
        var jsonData = JSON.stringify({
            QUESTION_OBJECT_ID: questionObjectId,
            FEEDBACK_ID: feedbackId,
           /* QUESTION_ID: questionId,*/
            QUESTION_ID: questionId.join(','),
            OBJECTIVE_ID: objectiveId.join(','),
            ACADEMIC_YEAR: academicYear,
            IS_ACTIVE: isActive
        });
        if (academicYear != null && academicYear != " ") {
            $.ajax({
                url: "/FeedBack/SaveOrUpdateFeedbackQuestionObjectiveMapping",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ sJsonData: jsonData }),
                success: function (data) {

                    if (data.Message != null && data.Message != "") {
                        if (data.ErrorCode == "200") {
                            swal({
                                title: "Success!",
                                text: data.Message,
                                showConfirmButton: false,
                                timer: 2000,
                                type: 'success',
                                animation: true
                            });
                            GetquestionObjective();
                        }
                        else if (data.ErrorCode == "417") {

                            swal({
                                title: "Error",
                                text: data.Message,
                                showConfirmButton: false,
                                timer: 2000,
                                type: 'error',
                                animation: true
                            });
                        }
                        else if (data.ErrorCode == "503") {

                            swal({
                                title: "Info",
                                text: data.Message,
                                showConfirmButton: false,
                                timer: 2000,
                                type: 'info',
                                animation: true
                            });
                        }
                    }
                },
                error: function (xhr, status, error) {

                    swal({
                        title: "Error!",
                        text: "An error occurred: " + error,
                        showConfirmButton: false,
                        timer: 1500,
                        type: 'error',
                        animation: true
                    });
                }
            });
        } else {

            swal({
                title: "Error!",
                text: "Please select Academic Year: " + error,
                showConfirmButton: false,
                timer: 1500,
                type: 'error',
                animation: true
            });
        }
    });




    function SetActive(QUESTION_OBJECT_ID, Mode)
    {

        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                url: "/FeedBack/ActivateorDeactivateFeedbackQuestionObjectiveMappingId",
                type: "post",
                data: { QuestionObjectId: QUESTION_OBJECT_ID,sMode:Mode},
                success: function (data) {
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 2000, type: 'success', animation: true });
                        GetquestionObjective();                    }
                },
                error: function (ex) {
                    swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 2000, type: 'error', animation: true });

                }

            });
        });

    }


    GetConfirm = function (QUESTION_OBJECT_ID)
