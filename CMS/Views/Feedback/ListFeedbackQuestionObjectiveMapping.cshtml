$("#dAcademicYearList").on("change", function () {
    var acyear = $('#dAcademicYearList option:selected').text();
    $.ajax({
        url: "@Url.Action("FetchgfeedbckByAcyear", "FeedBack")",
        method: "POST",
        datatype: "json",
        data: { sacyear: acyear },
        success: function (data) {
            $("#FeedBackSettingList").empty();
            $("#FeedBackSettingList2").empty();
            $("#FeedBackSettingList").append('<option value="0">-- Select --</option>' + data);
            $("#FeedBackSettingList2").append('<option value="0">-- Select --</option>' + data);
            $('.selectpicker').selectpicker('refresh');
        },
        error: function (error) {

            swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 2000, type: 'error', animation: true });
        }
    });
});
    $("#FeedBackSettingList2").on("change", function () {
        var fbID = $('#FeedBackSettingList2').val();
    $.ajax({
        url: "@Url.Action("FetchQuestionByFeedbackId", "FeedBack")",
        method: "POST",
        datatype: "json",
        data: { sFeedbackId: fbID },
        success: function (data) {
            $("#sQuestionList").empty();
            $("#sQuestionList").append('<option value="0">-- Select --</option>' + data);
            $('.selectpicker').selectpicker('refresh');
        },
        error: function (error) {

            swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 2000, type: 'error', animation: true });
        }
    });
});
function GetquestionObjective() {
    var acyear = $('#dAcademicYearList option:selected').text();
