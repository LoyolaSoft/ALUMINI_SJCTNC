</div>
<input type="hidden" id="FeedBackId" value="@Model.sFeedBackId" />
<input type="hidden" id="FeedBacKQuestionGroup" value="@Model.sFeedBackQuestionGroup" />
<input type="hidden" id="FeedBackRoleId" value="@Model.sFeedBackRoleSettingId" />
<input type="hidden" id="QuestionId" value="" />
<!-- end #content -->


<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    var NoofQuestion=@Html.Raw(Json.Encode(Model.liFbSettings.FirstOrDefault().NO_OF_QUESTION));
        ContentLoad = function () {
            //Ready Function()


            var item=@Html.Raw(Json.Encode(Model.QuestionId));
            if(item!=null && item!="")
            {
                $('#txtOption').attr('value','1');
                $('#txtOption').prop('disabled',true);
                $('#QuestionId').attr('value',@Html.Raw(Json.Encode(Model.QuestionId)));
                GetQuestions(@Html.Raw(Json.Encode(Model.Question)));

            }
            else{
                $('#txtOption').prop('disabled',false);
            }
            if(NoofQuestion!=null && NoofQuestion!="" && item==null || item=="")
            {
                $('#txtOption').attr('value',NoofQuestion);
                GetQuestions("");
            }



        }

        $('.selectpicker').selectpicker({
                size: 6
        });
        $('.selectpicker').selectpicker('Refresh');


            function GetQuestions(Question)
        {


                var QuestionSize = $('#txtOption').val();
                
                var Questions="";
                var QuestionContent=null;
                if(Question!="" && Question!=null)
                {
                    QuestionContent=Question;

                }
                
             
                $('#Question').html("");
                $('#dvtextboxes').removeClass("hidden");
                if (QuestionSize != '') {
                   
                    if(parseInt(QuestionSize) > parseInt(NoofQuestion))
                    {
                            swal({ title: "Error !", text: "Sorry Maximum Question is "+NoofQuestion+"!", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                            QuestionSize = NoofQuestion;
                    }

                        for (var i = 0; i < QuestionSize; i++) {
                            var j = 0;
                            j = i + 1;
                            Questions += '<div class="col-md-12 form-group">';
                            Questions += '<label class = "control-label col-md-1">' + j + ' .)</label>';
                            Questions += '<div class="col-md-10">';

                            if(QuestionContent!="" && QuestionContent!=null)
                            {
                                Questions += '<input type="text" id="Question' + i + '" class="form-control" placeholder="Enter Your Question" maxlength="145" value="'+QuestionContent+'">';
                            }
                            else{
                                Questions += '<input type="text" id="Question' + i + '" class="form-control" placeholder="Enter Your Question" maxlength="145">';
                            }

                            Questions += '</div>';
                            Questions += '</div>';
                        }

                    $('#Question').append(Questions);
                    $('#btnSubmit').removeClass("hidden");
                    $('#btnCancel').removeClass("hidden");
                    }
                    else {

                        $('#btnSubmit').addClass("hidden");
                        $('#btnCancel').addClass("hidden");
                    }
                
         

            }




        $('#txtOption').on('change', function () {

                GetQuestions("");

            });



        $('#btnSubmit').on("click", function () {


                var EndValue = $('#txtOption').val();
                ArrayQuestion = '{"liFB_Question":[';
                var nCount = 0;
                for(var i=0; i <EndValue;i++)
                {
                    if ($("#Question" + i).val())
                {
                        ArrayQuestion += '{"QUESTION":"' + $("#Question" + i).val() + '"},';
                    nCount++;
                }
                else
                {
                    swal({ title: "Info !", text: "All questions must be filled!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                    return false;
                    break;
                }

            }


            if (nCount != 0) {
                ArrayQuestion = ArrayQuestion.slice(0, -1);
                ArrayQuestion += ']}';
            } else {
                swal({ title: "Error !", text: "Something is went wrong . please check your Input  !", showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                return false;
            }

            var QuestionId= $('#QuestionId').val();
            var FeedBackId = $("#FeedBackId").val();
            var FeedBackRoleId = $("#FeedBackRoleId").val();
            //var QuestionType = $("#QuestionType").val();
            var QuestionGroup = $("#FeedBacKQuestionGroup").val();
            var JsonData;
            JsonData = '{"QUESTION_ID":"' + QuestionId + '","FEEDBACK_ID":"' + FeedBackId + '","FEEDBACK_ROLE_ID":"' + FeedBackRoleId + '","QUESTION_GROUP":"' + QuestionGroup + '"}';

            $.ajax({
                url:"@Url.Action("SaveFeedBackQuestions", "FeedBack")",
                method: "POST",
            datatype: "json",
            data: { sJsonData: JsonData, sFeedBackQuestions: ArrayQuestion },
            success: function (data)
            {
                if(data.Message!=null && data.Message!="" )
                {
                    swal({ title: "Success !", text:data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                    //loadContent('/FeedBack/AddFeedBackQuestions?sFeedBackId=' + $('#FeedBackId').val() + '&sFeedBackRoleId=' + $('#FeedBackRoleId').val() + '&sQuestionGroup='+QuestionGroup+'&sQuestionId='+$('#QuestionId').val()+'');
                    loadContent('/FeedBack/FeedBackQuestions?sFeedBackId=' + $('#FeedBackId').val() + '&sFeedBackRoleId=' + $('#FeedBackRoleId').val() + '&sFeedbackQuestionGroup='+$("#FeedBacKQuestionGroup").val()+'');
                }
                else
                {

                }

                }, error: function (error)
            {
                    swal({ title: "Error !", text:data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                }
            });



        });


    $('#btnCancel').click(function(){

        loadContent('/FeedBack/FeedBackQuestions?sFeedBackId=' + $('#FeedBackId').val() + '&sFeedBackRoleId=' + $('#FeedBackRoleId').val() + '&sFeedbackQuestionGroup='+$("#FeedBacKQuestionGroup").val()+'');

    });
</script>
