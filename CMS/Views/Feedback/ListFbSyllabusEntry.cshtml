@model CMS.ViewModel.ViewModel.FeedbackViewModel

@{
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Syllabus Feedback Report </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Syllabus Feedback Report<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Syllabus Feedback Report</h4>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="form-group col-md-3">
                                @Html.Label("Year", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                @Html.Label("Setting", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.FeedBackSettingList, (Model.FeedBackSettingList != null) ? Model.FeedBackSettingList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                @Html.Label("Dept", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.DepartmentList, (Model.DepartmentList != null) ? Model.DepartmentList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "form-control selectpicker show-menu-arrow show-tick", @data_live_search = "true", @data_parsley_required = "true" })
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                @Html.Label("Course", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <select class="form-control selectpicker show-menu-arrow show-tick" id="CourseList" data-live-search="true">
                                        <option value=""> -- Select -- </option>
                                        @if (Model.liExamRegistrationCourse != null && Model.liExamRegistrationCourse.Count > 0)
                                        {
                                            foreach (var item in Model.liExamRegistrationCourse)
                                            {
                                                <option value="@item.COURSE_ROOT_ID" cms-CourseCode="@item.COURSE_CODE">(@item.COURSE_CODE) - @item.COURSE_TITLE</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-2 form-group">
                                <a href="javascript:;" class="btn btn-success hidden" id="btnPrint" onclick="printDiv()">Print</a>
                            </div>
                            <div class="col-md-1 form-group">
                                <a href="javascript:;" class="btn btn-success hidden" id="btnExport" onclick="Export()">Export</a>
                            </div>
                           
                            </div>
                        <div class="col-md-12  table-responsive" id="dvSyllabusEntry">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>

<script>
    function ContentLoad() {
        // Document Ready Function
        $('.selectpicker').selectpicker({ size: 6 });
        $('.selectpicker').selectpicker('refresh');
    }

    //on ac year change
    $('#AcademicYearList').on('change', function () {
        if ($('#AcademicYearList').val()) {
            $.ajax({
                url: '@Url.Action("FetchSyllabusFeedBacksettingByYear", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sAcyear: $('#AcademicYearList option:selected').text() },
                success: function (data)
                {
                    $('#FeedBackSettingList').empty();
                    $('#FeedBackSettingList').append(data);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });


    $('#DepartmentList').on('change', function () {
        if ($('#DepartmentList').val()) {
            $.ajax({
                url: '@Url.Action("FetchCourseByDepartmentIdandYear", "supportdata")',
                method: 'POST',
                datatype: 'json',
                data: { sDepartmentId: $('#DepartmentList').val(),sAcyear:$('#AcademicYearList option:selected').text()  },
                success: function (data) {
                    $('#CourseList').empty();
                    if (data.Message != null && data.Message != "") {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    } else {
                        $('#CourseList').append(data.sResult);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
    });

    $('#CourseList').on('change', function ()
    {
        Load();
    });

function Load()
{
if ($('#CourseList').val()) {
            $.ajax({
                url: '@Url.Action("BindListFbSyllabusEntryByCourseId", "Feedback")',
                method: 'POST',
                datatype: 'json',
                data: { sCourseId: $('#CourseList').val(), sCourseCode: $('#CourseList option:Selected').attr('cms-CourseCode'), sFeedbackId: $('#FeedBackSettingList').val(), sAcYear: $('#AcademicYearList  option:Selected').text() },
                success: function (data)
                {
                    $('#dvSyllabusEntry').empty();
                    if (data.Message != null && data.Message != "")
                    {
                        swal({ title: "Error!", text: data.Message, showConfirmButton: false, timer: 3500, type: 'error', animation: true });
                    } else
                    {
                        $('#dvSyllabusEntry').append(data);
                        $('#lblDepartment').text($('#DepartmentList Option:selected').text());
                        $('#dvFbSetting').text($('#FeedBackSettingList Option:selected').text());
                        $('#lblCourse').text($('#CourseList Option:selected').text());
                        $('#btnPrint').removeClass('hidden');
                        $('#btnExport').removeClass('hidden');
                    }
                }, error: function (error) {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });
        }
}
    function printDiv()
    {

        var printContents = document.getElementById('dvSyllabusEntry').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        //loadContent('/IQAC/IQACDateWiseReportForIncharge');
       // $('#btnGet').click;
	   Load();

    }



    function Export() {
        var title = "";
        var sAcademicYear = $('#FeedBackSettingList option:selected').text();
        var Department = $('#DepartmentList option:selected').text();
        var Course = $('#CourseList Option:selected').text();
        //var sSatff = $('#StaffListByDepartmet option:selected').text();
        title = sAcademicYear + "_" + sSatff + "_" + Department;
        let file = new Blob([$('#dvSyllabusEntry').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        //$('#btnGet').click();
        Load();
        //e.preventDefault();
        // loadContent('/IQAC/IQACDateWiseReportForIncharge');
    }


</script>