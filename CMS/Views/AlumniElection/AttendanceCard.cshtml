@model CMS.Models.AlumniElectionCardViewModel
@{
    Layout = null;
    var reg = Model != null ? Model.Registration : null;
    var setting = Model != null ? Model.Setting : null;
    string errorMsg = ViewBag.ErrorMessage as string;

    string progCode = (reg != null && !string.IsNullOrWhiteSpace(reg.PROGRAMME_CODE)) ? reg.PROGRAMME_CODE.Trim() : "ELEC";
    string academicYear = (reg != null && !string.IsNullOrWhiteSpace(reg.ACADEMIC_YEAR)) ? reg.ACADEMIC_YEAR.Trim() : (setting != null ? setting.ACADEMIC_YEAR : DateTime.Now.Year.ToString());
    string serialId = (reg != null) ? reg.ID.ToString("D4") : "0001";
    string batchNo = (Model != null && !string.IsNullOrWhiteSpace(Model.SerialNo)) ? Model.SerialNo : serialId;

    // PASS NUMBER matches SERIAL NO in report: SJC-ELEC-[ACADEMIC_YEAR]-[ID:D4]
    string electionPassNo = (Model != null && !string.IsNullOrWhiteSpace(Model.PassNo))
        ? Model.PassNo
        : ((reg != null && !string.IsNullOrEmpty(reg.SERIAL_NO))
            ? reg.SERIAL_NO
            : string.Format("SJC-ELEC-{0}-{1}", academicYear, serialId));

    // REGISTRATION NO matches REGISTERED NO in report: SJC-[PROGRAMME_CODE]-[ACADEMIC_YEAR]-[SERIAL]
    string registeredNo = (reg != null && !string.IsNullOrEmpty(reg.REGISTRATION_NO))
        ? reg.REGISTRATION_NO
        : string.Format("SJC-{0}-{1}-{2}", progCode, academicYear, batchNo);
}

