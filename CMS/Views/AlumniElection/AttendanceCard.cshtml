                box-sizing: border-box !important;
            }

            .stamp-icon {
                margin-bottom: 6px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }

            .stamp-seal-img {
                width: 74px !important;
                height: 74px !important;
                max-width: 74px !important;
                max-height: 74px !important;
                object-fit: contain !important;
                display: block !important;
                margin: 0 auto !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .stamp-status {
                font-size: 13px !important;
                font-weight: 800 !important;
                color: #047857 !important;
                text-transform: uppercase !important;
                letter-spacing: 0.5px !important;
            }

            .stamp-sub {
                font-size: 11px !important;
                color: #065f46 !important;
                margin-top: 2px !important;
                font-weight: 600 !important;
            }

            .election-schedule-box {
                background-color: #f8fafc !important;
                border: 1.5px solid #cbd5e1 !important;
                border-radius: 12px !important;
                padding: 12px 18px !important;
                margin-bottom: 16px !important;
                position: relative !important;
                z-index: 2 !important;
                display: block !important;
            }

            .schedule-title {
                font-size: 12.5px !important;
                font-weight: 800 !important;
                color: #1e3a8a !important;
                text-transform: uppercase !important;
                letter-spacing: 0.5px !important;
                margin-bottom: 8px !important;
                display: flex !important;
                align-items: center !important;
                gap: 6px !important;
            }

            .schedule-grid {
                display: grid !important;
                grid-template-columns: 1fr 1fr 1.5fr !important;
                gap: 12px !important;
                font-size: 12px !important;
            }

            .schedule-item {
                border-bottom: none !important;
                padding-bottom: 0 !important;
            }

            .schedule-item strong {
                display: block !important;
                color: #64748b !important;
                font-size: 10.5px !important;
                text-transform: uppercase !important;
                margin-bottom: 2px !important;
            }

            .schedule-item span {
                font-weight: 700 !important;
                color: #0f172a !important;
                font-size: 12px !important;
            }

            .rules-section {
                background-color: #fffbeb !important;
                border-left: 4px solid #f59e0b !important;
                border-radius: 0 8px 8px 0 !important;
                padding: 11px 16px !important;
                margin-bottom: 18px !important;
                font-size: 13px !important;
                color: #78350f !important;
                position: relative !important;
                z-index: 2 !important;
            }

            .rules-section strong {
                display: block !important;
                margin-bottom: 5px !important;
                font-size: 13.5px !important;
                font-weight: 800 !important;
                color: #92400e !important;
            }

            .rules-section p {
                margin: 0 !important;
                line-height: 1.5 !important;
                font-size: 13px !important;
            }

            .signature-block {
                display: flex !important;
                flex-direction: row !important;
                justify-content: space-between !important;
                align-items: flex-end !important;
                margin-top: 16px !important;
                padding-top: 8px !important;
                border-top: 1px dashed #cbd5e1 !important;
                position: relative !important;
                z-index: 2 !important;
                gap: 10px !important;
            }

            .signature-box {
                text-align: center !important;
                flex: 1 !important;
                max-width: 175px !important;
                width: auto !important;
                min-width: 0 !important;
            }

            .sig-space {
                height: 34px !important;
                display: flex !important;
                align-items: flex-end !important;
                justify-content: center !important;
                margin-bottom: 3px !important;
            }

            .principal-sign-img {
                max-height: 34px !important;
                max-width: 95px !important;
                object-fit: contain !important;
                display: block !important;
                margin: 0 auto !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .sig-line {
                border-top: 1.5px solid #334155 !important;
                margin-bottom: 3px !important;
            }

            .sig-title {
                font-size: 9px !important;
                font-weight: 700 !important;
                color: #1e293b !important;
                text-transform: uppercase !important;
                letter-spacing: 0.1px !important;
                white-space: nowrap !important;
            }

            .sig-sub {
                font-size: 8px !important;
                color: #64748b !important;
                margin-top: 2px !important;
                white-space: nowrap !important;
            }
        }
    </style>
</head>
<body>

    @if (!string.IsNullOrEmpty(errorMsg) || reg == null)
    {
        <div style="max-width: 600px; margin: 50px auto; background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); text-align: center;">
            <i class="fa fa-exclamation-triangle fa-3x text-danger" style="color: #ef4444; margin-bottom: 12px;"></i>
            <h3 style="margin: 0 0 10px; color: #1e293b;">Unable to Display Attendance Card</h3>
            <p style="color: #64748b; font-size: 14px;">@(errorMsg ?? "No valid registration details found.")</p>
            <div style="margin-top: 20px;">
                <a href="/AlumniElection" class="btn-action btn-print" style="text-decoration: none;">
                    <i class="fa fa-arrow-left"></i> Return to Alumni Election
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Action Toolbar -->
        <div class="card-action-bar">
            <a href="/AlumniElection" class="btn-action btn-back">
                <i class="fa fa-arrow-left"></i> Back to Election Notice
            </a>
            <button type="button" class="btn-action btn-print" onclick="window.print()">
                <i class="fa fa-print"></i> Print / Download Attendance Card
            </button>
        </div>

        <!-- Attendance & Admit Pass -->
        <div class="admit-card-container">
            
            <!-- Header with College Crest -->
            <div class="card-header-section">
                <img src="/Content/assets/img/hcc-img/SJCLOGO.png" alt="SJC Logo" class="college-crest-logo" onerror="this.style.display='none'" />
                <div class="college-titles">
                    <h1>ST. JOSEPH'S COLLEGE OF ARTS & SCIENCE (AUTONOMOUS)</h1>
                    <p> Re-Accredited by NAAC with 'A' Grade</p>
                    <p>Cuddalore - 607 001, Tamil Nadu</p>
                    <h5 style="color: #1e3a8a; font-weight: 700; margin-top: 2px;"> @(setting != null ? setting.SETTING_NAME : "ELECTION 2026")</h5>
                </div>
                <div class="card-badge-box">
                    <div class="card-pass-no">PASS NUMBER</div>
                    <div class="card-pass-num-bold">@electionPassNo</div>
                    <div style="font-size: 11px; color: #059669; font-weight: 700; margin-top: 4px;">VERIFIED ENTRY</div>
                </div>
            </div>

            <!-- Banner -->
            <div class="card-title-banner">
                OFFICIAL ATTENDANCE & ENTRY PASS
            </div>

            <!-- Alumnus Details & Verification Seal -->
            <div class="info-grid-section">
                <div>
                    <table class="table-details">
                        <tr>
                            <td class="lbl-col">Alumnus / Alumna Name</td>
                            <td class="colon-col">:</td>
                            <td class="val-col val-name">@reg.NAME.ToUpper()</td>

                        </tr>
                        <tr>
                            <td class="lbl-col">Mobile Number</td>
                            <td class="colon-col">:</td>
                            <td class="val-col">@reg.MOBILE_NO</td>

                        </tr>
                        <tr>
                            <td class="lbl-col">Programme / Degree</td>
                            <td class="colon-col">:</td>
                            <td class="val-col">@reg.PROGRAMME_NAME</td>

                        </tr>
                        <tr>
                            <td class="lbl-col">Year of Passing</td>
                            <td class="colon-col">:</td>
                            <td class="val-col">@reg.YEAR_OF_PASSING</td>
                        </tr>

                        @*<tr>
                            <td class="lbl-col">Academic Year</td>
                            <td class="colon-col">:</td>
                            <td class="val-col">@reg.ACADEMIC_YEAR</td>
                        </tr>*@
                        <tr>
                            <td class="lbl-col">Registration No</td>
                            <td class="colon-col">:</td>
                            <td class="val-col val-regno">@registeredNo</td>
                        </tr>
                    </table>
                </div>

                <!-- Green Attendance Confirmed Seal -->
                <div class="status-stamp-card">
                    @*<div class="stamp-icon"><i class="fa fa-certificate"></i></div>*@
                    <div class="stamp-icon">
                        <img src="@Url.Content("~/Content/hcc_img/sign/SJC_COLLEGE_SEALremovebg.png")" alt="College Seal" class="stamp-seal-img" onerror="this.style.display='none'" />
                    </div>
                    <div class="stamp-status">ATTENDANCE CONFIRMED</div>
                    <div class="stamp-sub">APPROVED VOTER</div>
                    <div style="margin-top: 8px; font-size: 10px; color: #047857; font-weight: 700;">
                        VALID ENTRY PASS
                    </div>
                </div>
            </div>

            <!-- Schedule & Venue Information (from active setting) -->
            <div class="election-schedule-box">
                <div class="schedule-title">
                    <i class="fa fa-calendar-check"></i> Election Schedule & Venue Details
                </div>
                <div class="schedule-grid">
                    <div class="schedule-item">
                        <strong>Date of Election</strong>
                        <span>
                            @(setting != null && setting.ELECTION_DATE.HasValue 
                                ? setting.ELECTION_DATE.Value.ToString("dddd, dd MMMM yyyy") 
                                : "Sunday, 27th September 2026")
                        </span>
                    </div>
                    <div class="schedule-item">
                        <strong>Election Timing</strong>
                        <span>@(setting != null && !string.IsNullOrEmpty(setting.ELECTION_TIME) ? setting.ELECTION_TIME : "10:00 AM - 01:00 PM")</span>
                    </div>
                    <div class="schedule-item">
                        <strong>Election Venue (Place)</strong>
                        <span>
                            @(setting != null && !string.IsNullOrEmpty(setting.ELECTION_PLACE) 
                                ? setting.ELECTION_PLACE 
                                : " St. Joseph's College, Cuddalore")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Rules & Notes from Setting -->
            <div class="rules-section">
                <strong><i class="fa fa-info-circle"></i> Important Instructions for Entry & Voting:</strong>
                <p>@(setting != null && !string.IsNullOrWhiteSpace(setting.NOTES) 
                    ? setting.NOTES 
                    : "1. This attendance pass is strictly non-transferable.\n2. Please report at least 30 minutes prior to the commencement of the meeting.")</p>
            </div>

            <!-- Signatures: 1. Signature of Alumnus, 2. Principal, 3. Alumni Coordinator, 4. Secretary -->
            <div class="signature-block">
                <!-- 1. Signature of Alumnus -->
                <div class="signature-box">
                    <div class="sig-space"></div>
                    <div class="sig-line"></div>
                    <div class="sig-title">Sign. of Alumnus / Alumna</div>
                    <div class="sig-sub">(To be signed at the venue)</div>
                </div>

                <!-- 2. Principal -->
                <div class="signature-box">
                    <div class="sig-space">
                        <img src="@Url.Content("~/Content/hcc_img/sign/SJC_PRINCIPAL_Singn_RBG.png")" alt="Principal Signature" class="principal-sign-img" onerror="this.style.display='none'" />
                    </div>
                    <div class="sig-line"></div>
                    <div class="sig-title">Principal</div>
                    @*<div class="sig-sub">St. Joseph's College (Autonomous)</div>*@
                </div>

                <!-- 3. Alumni Coordinator -->
                <div class="signature-box">
                    <div class="sig-space">
                        <img src="@Url.Content("~/Content/hcc_img/sign/Fr_maria_anandraj.png")" alt="Alumni Coordinator" class="principal-sign-img" onerror="this.style.display='none'" />

                    </div>
                    <div class="sig-line"></div>
                    <div class="sig-title">Alumni Coordinator</div>
                    @*<div class="sig-sub">Alumni Association, SJC</div>*@
                </div>

                <!-- 4. Secretary -->
                <div class="signature-box">
                    <div class="sig-space">
                        <img src="@Url.Content("~/Content/hcc_img/sign/Secretary_Sign.png")" alt="Secretary" class="principal-sign-img" onerror="this.style.display='none'" />

                    </div>
                    <div class="sig-line"></div>
                    <div class="sig-title">Secretary</div>
                    @*<div class="sig-sub">Alumni Association, SJC</div>*@
                </div>
            </div>

        </div>
    }

</body>
</html>
