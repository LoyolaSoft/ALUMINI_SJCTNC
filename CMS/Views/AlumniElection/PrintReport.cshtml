    <div class="summary-stats-strip">
        <div class="stat-badge">
            <div class="stat-num" style="color: #1e3a8a;">@totReg</div>
            <div class="stat-lbl">Total Registered</div>
        </div>
        <div class="stat-badge">
            <div class="stat-num" style="color: #15803d;">@totApp</div>
            <div class="stat-lbl">Attending (Approved)</div>
        </div>
        <div class="stat-badge">
            <div class="stat-num" style="color: #b91c1c;">@totRej</div>
            <div class="stat-lbl">Cannot Attend (Rejected)</div>
        </div>
    </div>

    <!-- Detailed Alphabetical Table -->
    <table class="report-table" id="tblDetailedReport">
        <thead>
            <tr>
                <th style="width: 35px; text-align: center;">#</th>
                <th style="width: 140px; text-align: center;">SERIAL NO.</th>
                <th style="width: 155px; text-align: center;">REGISTERED NO.</th>
                <th style="text-align: left;">ALUMNUS NAME (A TO Z)</th>
                <th style="width: 95px; text-align: center;">MOBILE NO</th>
                <th style="text-align: left;">PROGRAMME / DEGREE</th>
                <th style="width: 75px; text-align: center;">PASSING YEAR</th>
                <th class="col-signature @(includeSignature ? "" : "hidden-signature")" style="width: 130px; text-align: center;">SIGNATURE</th>
            </tr>
        </thead>
        <tbody>
            @if (regList.Count == 0)
            {
                <tr>
                    <td colspan="@(includeSignature ? 8 : 7)" id="tdEmptyMsg" style="text-align: center; padding: 25px; color: #64748b;">No registrations found for the selected criteria.</td>
                </tr>
            }
            else
            {
                int sno = 1;
                foreach (var row in regList)
                {
                    string serialNo = !string.IsNullOrEmpty(row.SERIAL_NO)
                        ? row.SERIAL_NO
                        : ("SJC-ELEC-" + (!string.IsNullOrWhiteSpace(row.ACADEMIC_YEAR) ? row.ACADEMIC_YEAR.Trim() : "2026") + "-" + row.ID.ToString("D4"));
                    string registeredNo = !string.IsNullOrEmpty(row.REGISTRATION_NO)
                        ? row.REGISTRATION_NO
                        : ("SJC-" + (!string.IsNullOrWhiteSpace(row.PROGRAMME_CODE) ? row.PROGRAMME_CODE.Trim() : "ELEC") + "-" + (!string.IsNullOrWhiteSpace(row.ACADEMIC_YEAR) ? row.ACADEMIC_YEAR.Trim() : "2026") + "-" + row.ID.ToString("D4"));

                    <tr>
                        <td style="text-align: center;">@(sno++)</td>
                        <td style="text-align: center; font-weight: 700; color: #1e3a8a; font-family: monospace; font-size: 10.5px;">
                            @serialNo
                        </td>
                        <td style="text-align: center; font-weight: 700; color: #0284c7; font-family: monospace; font-size: 10.5px;">
                            @registeredNo
                        </td>
                        <td style="font-weight: 700; color: #0f172a;">@row.NAME</td>
                        <td style="text-align: center;">@row.MOBILE_NO</td>
                        <td>@row.PROGRAMME_NAME</td>
                        <td style="text-align: center;">@row.YEAR_OF_PASSING</td>
                        <td class="col-signature @(includeSignature ? "" : "hidden-signature")" style="text-align: center; vertical-align: bottom; height: 32px; padding: 2px 6px;">
                            <div class="sig-line-dotted"></div>
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr class="table-total-row">
                <th colspan="4" style="text-align: right;">Total Registrations Listed:</th>
                <th colspan="@(includeSignature ? 4 : 3)" id="thFooterTotal" style="text-align: left; color: #1e3a8a;">@totReg Alumni</th>
            </tr>
        </tfoot>
    </table>

    <div class="signature-section">
        <div class="sig-block">
            <div class="sig-line"></div>
            <div class="sig-title">Prepared By (ERP)</div>
        </div>
        <div class="sig-block">
            <img src="@Url.Content("~/Content/hcc_img/sign/Fr_maria_anandraj.png")" alt="Alumni Coordinator" class="principal-sign-img" onerror="this.style.display='none'" />

            <div class="sig-line">
            </div>
            <div class="sig-title">Verified By Alumni Coordinator</div>
        </div>
        <div class="sig-block">
            <img src="@Url.Content("~/Content/hcc_img/sign/SJC_PRINCIPAL_Singn_RBG.png")" alt="Principal Signature" class="principal-sign-img" onerror="this.style.display='none'" />

            <div class="sig-line">
            </div>
            <div class="sig-title">Verified By Principal</div>
        </div>
        <div class="sig-block">
            <img src="@Url.Content("~/Content/hcc_img/sign/Secretary_Sign.png")" alt="Secretary" class="principal-sign-img" onerror="this.style.display='none'" />

            <div class="sig-line">
            </div>
            <div class="sig-title">Certified By Secretary</div>
        </div>
    </div>

    <div class="page-footer-note">
        This is an official system-generated attendance report from the St. Joseph's College Alumni Election Registry. Generated on @genDate.
    </div>
</div>
    }

    <script>
        function switchPrintMode(mode) {
            var paged = document.getElementById('containerPaged');
            var continuous = document.getElementById('containerContinuous');
            var btnPaged = document.getElementById('btnModePaged');
            var btnContinuous = document.getElementById('btnModeContinuous');

            if (mode === 'paged') {
                if (paged) paged.classList.remove('hidden-mode');
                if (continuous) continuous.classList.add('hidden-mode');
                if (btnPaged) btnPaged.classList.add('active-mode');
                if (btnContinuous) btnContinuous.classList.remove('active-mode');
            } else {
                if (paged) paged.classList.add('hidden-mode');
                if (continuous) continuous.classList.remove('hidden-mode');
                if (btnPaged) btnPaged.classList.remove('active-mode');
                if (btnContinuous) btnContinuous.classList.add('active-mode');
            }
        }

        function toggleSignatureColumn(show) {
            var cols = document.querySelectorAll('.col-signature');
            for (var i = 0; i < cols.length; i++) {
                if (show) {
                    cols[i].classList.remove('hidden-signature');
                } else {
                    cols[i].classList.add('hidden-signature');
                }
            }

            var thTot = document.getElementById('thFooterTotal');
            if (thTot) {
                thTot.setAttribute('colspan', show ? '4' : '3');
            }

            var tdEmpty = document.getElementById('tdEmptyMsg');
            if (tdEmpty) {
                tdEmpty.setAttribute('colspan', show ? '8' : '7');
            }

            var container = document.getElementById('printSignatureContainer');
            if (container) {
                if (show) {
                    container.classList.add('active-toggle');
                } else {
                    container.classList.remove('active-toggle');
                }
            }
        }

        window.onload = function () {
            // Auto-trigger print dialog after styles load
            setTimeout(function () {
                window.print();
            }, 600);
        };
    </script>
</body>
</html>
