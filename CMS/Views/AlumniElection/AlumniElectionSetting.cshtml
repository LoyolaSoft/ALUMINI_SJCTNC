@model List<CMS.Models.AlumniElectionSetting>
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    }
    ViewBag.Title = "Alumni Election Settings";
    string activeAcYear = ViewBag.ActiveAcademicYear as string ?? DateTime.Now.Year.ToString();
}

<style>
    .badge-active-setting {
        background-color: #10b981;
        color: #fff;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 12px;
        font-size: 11.5px;
        display: inline-block;
    }
    .badge-inactive-setting {
        background-color: #94a3b8;
        color: #fff;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 11px;
        display: inline-block;
    }
    .setting-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
    }
    .modal-header-custom {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        color: #fff;
        padding: 15px 20px;
        border-radius: 6px 6px 0 0;
    }
    .modal-header-custom .close {
        color: #fff;
        opacity: 0.9;
        font-size: 24px;
    }
    .form-group-label {
        font-weight: 600;
        color: #334155;
        font-size: 13px;
        margin-bottom: 4px;
    }
</style>

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;" onclick="loadContent('/DashBoard/Index')">Home</a></li>
        <li><a href="javascript:;">Alumnae</a></li>
        <li class="active">Alumni Election Settings</li>
    </ol>
    <!-- end breadcrumb -->

    <h1 class="page-header">
        <i class="fa fa-cog text-primary"></i> Alumni Election Settings
        <small>Configure election dates, submission deadline, venue, timing, notes & official notice PDF</small>
    </h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <button type="button" class="btn btn-xs btn-success" onclick="openCreateModal()">
                    <i class="fa fa-plus"></i> Create New Election Setting
                </button>
                <a href="javascript:;" onclick="loadContent('/AlumniElection/Reports')" class="btn btn-xs btn-info" style="margin-left: 5px;">
                    <i class="fa fa-bar-chart"></i> View Election Reports
                </a>
                <a href="/AlumniElection" target="_blank" class="btn btn-xs btn-warning" style="margin-left: 5px;">
                    <i class="fa fa-external-link"></i> Preview Public Form
                </a>
            </div>
            <h4 class="panel-title"><b>Election Settings Directory</b></h4>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblElectionSettings">
                    <thead>
                        <tr class="bg-silver-lighter">
                            <th style="width: 40px; text-align: center;">#</th>
                            <th>Setting Name & Academic Year</th>
                            <th style="width: 140px;">Election Date & Time</th>
                            <th style="width: 160px;">Submission Deadline</th>
                            <th>Place of Election (Venue)</th>
                            <th style="width: 130px; text-align: center;">Official Notice</th>
                            <th style="width: 90px; text-align: center;">Status</th>
                            <th style="width: 170px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            int sno = 1;
                            foreach (var item in Model)
                            {
                                bool isPastDeadline = item.LAST_DATE_SUBMISSION.HasValue && DateTime.Now > item.LAST_DATE_SUBMISSION.Value;
                                <tr>
                                    <td style="text-align: center;">@sno</td>
                                    <td>
                                        <div class="setting-card-title">@item.SETTING_NAME</div>
                                        <div class="text-muted small">
                                            Academic Year: <span class="badge badge-info">@item.ACADEMIC_YEAR</span>
                                            @if (!string.IsNullOrEmpty(item.CREATED_BY))
                                            {
                                                <span> &bull; Created by @item.CREATED_BY</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.NOTES))
                                        {
                                            <div class="small text-secondary mt-1" style="max-width: 320px; white-space: pre-line;">
                                                <i class="fa fa-info-circle text-primary"></i> @item.NOTES
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div><strong>@(item.ELECTION_DATE.HasValue ? item.ELECTION_DATE.Value.ToString("dd-MMM-yyyy") : "-")</strong></div>
                                        <div class="text-muted small">@(item.ELECTION_TIME ?? "-")</div>
                                    </td>
                                    <td>
                                        <div><strong>@(item.LAST_DATE_SUBMISSION.HasValue ? item.LAST_DATE_SUBMISSION.Value.ToString("dd-MMM-yyyy hh:mm tt") : "-")</strong></div>
                                        @if (isPastDeadline)
                                        {
                                            <span class="badge badge-danger" style="font-size: 10px;">Deadline Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success" style="font-size: 10px;">Registration Open</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="max-width: 250px;">
                                            <i class="fa fa-map-marker text-danger"></i> @(item.ELECTION_PLACE ?? "-")
                                        </div>
                                    </td>
                                    <td style="text-align: center;">
                                        @if (!string.IsNullOrEmpty(item.NOTICE_PDF_PATH))
                                        {
                                            <a href="@item.NOTICE_PDF_PATH" target="_blank" class="btn btn-xs btn-danger">
                                                <i class="fa fa-file-pdf-o"></i> View PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No PDF</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        @if (item.IS_ACTIVE == 1)
                                        {
                                            <span class="badge-active-setting"><i class="fa fa-check"></i> ACTIVE</span>
                                        }
                                        else
                                        {
                                            <span class="badge-inactive-setting">Inactive</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-xs btn-primary" onclick="openEditModal(@item.ID)" title="Edit Setting">
                                                <i class="fa fa-pencil"></i> Edit
                                            </button>
                                            @if (item.IS_ACTIVE != 1)
                                            {
                                                <button type="button" class="btn btn-xs btn-success" onclick="setActiveSetting(@item.ID)" title="Make this setting active">
                                                    <i class="fa fa-star"></i> Activate
                                                </button>
                                                <button type="button" class="btn btn-xs btn-danger" onclick="deleteSetting(@item.ID)" title="Delete setting">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                sno++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted" style="padding: 25px;">
                                    <i class="fa fa-info-circle fa-2x text-warning"></i>
                                    <p class="mt-2">No election settings configured yet. Click 'Create New Election Setting' above.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create / Edit Election Setting -->
<div class="modal fade" id="modalSetting" tabindex="-1" role="dialog" aria-labelledby="modalSettingTitle">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="frmSaveSetting" enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" id="hdnSettingId" name="ID" value="0" />
                <input type="hidden" id="hdnExistingPdfPath" name="NOTICE_PDF_PATH" value="" />

                <div class="modal-header modal-header-custom">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button>
                    <h4 class="modal-title text-white" id="modalSettingTitle">
                        <i class="fa fa-sliders"></i> <span id="lblModalAction">Create</span> Election Setting
                    </h4>
                </div>
                <div class="modal-body" style="padding: 20px 25px;">
                    
                    <div class="row">
                        <!-- Setting Name -->
                        <div class="col-md-8 form-group">
                            <label class="form-group-label">Election / Setting Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtSettingName" name="SETTING_NAME" placeholder="e.g. Alumni Association General Body Meeting & Election 2026" required />
                        </div>

                        <!-- Academic Year -->
                        <div class="col-md-4 form-group">
                            <label class="form-group-label">Academic Year <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtAcademicYear" name="ACADEMIC_YEAR" value="@activeAcYear" placeholder="e.g. 2026" required />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Election Date -->
                        <div class="col-md-4 form-group">
                            <label class="form-group-label">Date of Election <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtElectionDate" name="ELECTION_DATE" required />
                        </div>

                        <!-- Election Time -->
                        <div class="col-md-4 form-group">
                            <label class="form-group-label">Time of Election <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtElectionTime" name="ELECTION_TIME" placeholder="e.g. 10:00 AM - 01:00 PM" required />
                        </div>

                        <!-- Last Date of Submission -->
                        <div class="col-md-4 form-group">
                            <label class="form-group-label">Last Date Submission (Deadline) <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" id="txtLastDateSubmission" name="LAST_DATE_SUBMISSION" required />
                            <small class="text-muted">Alumni registration closes after this date/time.</small>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Place of Election -->
                        <div class="col-md-12 form-group">
                            <label class="form-group-label">Place of Election (Venue) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtElectionPlace" name="ELECTION_PLACE" placeholder="e.g. Rev. Fr. M. A. Antonysamy Auditorium, St. Joseph's College of Arts and Science (Autonomous), Cuddalore" required />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Official Election Notice (PDF) -->
                        <div class="col-md-12 form-group">
                            <label class="form-group-label">Official Election Notice (PDF Upload)</label>
                            <input type="file" class="form-control" id="fileNoticePdf" name="noticePdfFile" accept=".pdf,application/pdf" />
                            <div id="dvCurrentPdf" class="small mt-1" style="display: none;">
                                Current PDF: <a href="#" id="lnkCurrentPdf" target="_blank" class="text-primary fw-bold">View File</a>
                            </div>
                            <small class="text-muted">Upload official signed notification PDF (default will be used if none uploaded).</small>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Notes / Instructions -->
                        <div class="col-md-12 form-group">
                            <label class="form-group-label">Important Notes / Instructions for Alumni & Voters</label>
                            <textarea class="form-control" id="txtNotes" name="NOTES" rows="3" placeholder="Enter guidelines, entry rules, ID requirements, etc. (printed on the Attendance Card and displayed on the notice page)"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="checkbox">
                                <label style="font-weight: 700; color: #10b981;">
                                    <input type="checkbox" id="chkIsActive" name="IS_ACTIVE" value="1" checked />
                                    Set this setting as ACTIVE (deactivates previous settings)
                                </label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveSetting">
                        <i class="fa fa-save"></i> Save Setting
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCreateModal() {
        $('#hdnSettingId').val('0');
        $('#hdnExistingPdfPath').val('');
        $('#txtSettingName').val('');
        $('#txtAcademicYear').val('@activeAcYear');
        $('#txtElectionDate').val('');
        $('#txtElectionTime').val('10:00 AM - 01:00 PM');
        $('#txtLastDateSubmission').val('');
        $('#txtElectionPlace').val("Rev. Fr. M. A. Antonysamy Auditorium, St. Joseph's College of Arts and Science (Autonomous), Cuddalore - 607 001");
        $('#txtNotes').val("1. Valid Photo ID proof (Aadhaar / Voter ID / College ID) is mandatory for entry.\n2. Only registered alumni with confirmed attendance are permitted to vote.\n3. Election timing is strictly adhered to. Please report 30 minutes prior to commencement.");
        $('#chkIsActive').prop('checked', true);
        $('#fileNoticePdf').val('');
        $('#dvCurrentPdf').hide();
        $('#lblModalAction').text('Create');
        $('#modalSetting').modal('show');
    }

    function openEditModal(id) {
        $.ajax({
            url: '/AlumniElection/GetSetting',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res && res.success && res.data) {
                    var d = res.data;
                    $('#hdnSettingId').val(d.id);
                    $('#hdnExistingPdfPath').val(d.noticePdfPath || '');
                    $('#txtSettingName').val(d.settingName);
                    $('#txtAcademicYear').val(d.academicYear);
                    $('#txtElectionDate').val(d.electionDate);
                    $('#txtElectionTime').val(d.electionTime);
                    $('#txtLastDateSubmission').val(d.lastDateSubmission);
                    $('#txtElectionPlace').val(d.electionPlace);
                    $('#txtNotes').val(d.notes);
                    $('#chkIsActive').prop('checked', d.isActive);
                    $('#fileNoticePdf').val('');

                    if (d.noticePdfPath) {
                        $('#lnkCurrentPdf').attr('href', d.noticePdfPath);
                        $('#dvCurrentPdf').show();
                    } else {
                        $('#dvCurrentPdf').hide();
                    }

                    $('#lblModalAction').text('Edit');
                    $('#modalSetting').modal('show');
                } else {
                    alert(res.message || 'Could not fetch setting details.');
                }
            },
            error: function () {
                alert('Network error while retrieving setting.');
            }
        });
    }

    $('#frmSaveSetting').on('submit', function (e) {
        e.preventDefault();

        var formData = new FormData(this);
        formData.set('IS_ACTIVE', $('#chkIsActive').is(':checked') ? '1' : '0');

        $('#btnSaveSetting').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

        $.ajax({
            url: '/AlumniElection/SaveSetting',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                $('#btnSaveSetting').prop('disabled', false).html('<i class="fa fa-save"></i> Save Setting');
                if (res && res.success) {
                    $('#modalSetting').modal('hide');
                    alert(res.message || 'Saved successfully.');
                    if (typeof loadContent === 'function') {
                        loadContent('/AlumniElection/AlumniElectionSetting');
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert((res && res.message) ? res.message : 'Error saving setting.');
                }
            },
            error: function () {
                $('#btnSaveSetting').prop('disabled', false).html('<i class="fa fa-save"></i> Save Setting');
                alert('Network error occurred.');
            }
        });
    });

    function setActiveSetting(id) {
        if (!confirm('Are you sure you want to mark this setting as ACTIVE? Public registrations will use these election details.')) {
            return;
        }

        $.ajax({
            url: '/AlumniElection/SetActiveSetting',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res && res.success) {
                    alert(res.message);
                    if (typeof loadContent === 'function') {
                        loadContent('/AlumniElection/AlumniElectionSetting');
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(res.message || 'Error updating setting.');
                }
            }
        });
    }

    function deleteSetting(id) {
        if (!confirm('Are you sure you want to delete this election setting?')) {
            return;
        }

        $.ajax({
            url: '/AlumniElection/DeleteSetting',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res && res.success) {
                    alert(res.message);
                    if (typeof loadContent === 'function') {
                        loadContent('/AlumniElection/AlumniElectionSetting');
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(res.message || 'Error deleting setting.');
                }
            }
        });
    }
</script>
