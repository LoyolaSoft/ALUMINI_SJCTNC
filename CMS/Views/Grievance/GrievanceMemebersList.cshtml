    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Grievance Members List</li>
    </ol>
    
    <h1 class="page-header">Grievance Members List</h1>
    <div class="panel" >
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Grievance Members List </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:AddorEdit()"><i class="fa fa-plus" title="Add"></i>Add</a>
            </div>
            <br />
            <div class="form-horizontal">
                <div class="col-md-12">
                    <div class="form-group table-responsive">
                        @{ int count = 0;}
                               <table class="table table-bordered table-hover table-responsive" id="Grievancetbl">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                            Staff Name
                                        </th>
                                        <th>
                                            Grievance Type
                                        </th>
                                        <th>
                                            Role
                                        </th>
                                        <th>
                                            Action
                                        </th>
                                    </tr>
                                </thead>

                    @if (Model.liGrievancemembers != null && Model.liGrievancemembers.Count>0)
                    {

                                foreach (var item in Model.liGrievancemembers)
                                { 
                                    <tr>
                                        <td>
                                            @{ count++;}
                                            @count
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.FIRST_NAME)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.GRIEVANCE_TYPE_NAME)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ROLE_NAME)
                                        </td>
                                        <td>
                                            <a href="javascript:AddorEdit(@item.G_MEMBER_ID)"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                            <a href="javascript:;" onclick="GetConfirm(@item.G_MEMBER_ID,@item.STAFF_ID,@item.ROLES)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                                        </td>
                                    </tr>
                                                    }
                                                }
                                                

                            </table>
                                                
                    </div>
            </div>
        </div>
        </div>
    </div>
</div>
<div class="modal" id="AddorEdit">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Grievance Member</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="">
                        <input type="hidden" name="memberid" id="memberid" />
                        <input type="hidden" name="useracid" id="useracid" />
                        <div class="form-group ">
                            <label class="col-md-3 control-label">Grievance Type</label>
                            <div class="col-md-9 col-lg-9">
                                <select id="grievance" class="form-control selectpicker" data-live-search="true">
                                    <option value="0">--Select--</option>
                                </select>
                            </div>
                        </div><br>
                        <div class="form-group ">
                            <label class="col-md-3 control-label">Staff Name</label>
                            <div class="col-md-9 col-lg-9">
                                <select id="staff" class="form-control selectpicker"  data-live-search = "true">
                                    <option value="0">--Select--</option>
                                </select>
                            </div>
                        </div><br>
                        <div class="form-group ">
                            <label class="col-md-3 control-label">Role</label>
                            <div class="col-md-9 col-lg-9">
                                <select id="role" class="form-control selectpicker" data-live-search="true">
                                    <option value="0">--Select--</option>
                                </select>
                            </div>
                        </div><br>
                       
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <a href="#" onclick=";" class="btn btn-sm btn-primary" data-dismiss="modal" id="btnSave">Save</a>
                <a href="javascript:;" onclick="Cancel()" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>


