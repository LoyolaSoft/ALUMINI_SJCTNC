    <script>
        $("#Grievancetbl").DataTable();
       
    </script>
    <script>

        function ContentLoad()
        {
            $('.selectpicker').selectpicker({
                size: 4
            });
            $('.selectpicker').selectpicker('refresh');
            loadstaffandgrievancetype();
           
        }
        
    </script>
<script>
    function GetConfirm(ID,USERID,ROLE) {
      
            if (!confirm('Are you sure to delete ?')) {
                return false;
            } else {
                $.ajax({
                    url: "@Url.Action("DeleteGrievanceMembers", "Grievance")",
                    method: "POST",
                    datatype: "json",
                    data: { sGrievancememberid: ID, sUserid: USERID,sRole:ROLE },
                    success: function (objResult)
                    {
                        alert(objResult.Message);
                        loadContent('/Grievance/GrievanceMemebersList')
                    }, error: function (error) {
                        alert(error);
                    }
                });
            }
        }
        function loadstaffandgrievancetype()
        {
            $.ajax({
             url:  "@Url.Action("Fetchstaffandgrievancetype", "Grievance")",
             method:"POST",
            datatype:"html",
            data: {},
            success:function(result)
            {
                
                $('#staff').empty(), $('#staff').append('<option value="0">---Select--</option>' + result.sStaff);
                $('#grievance').empty(), $('#grievance').append('<option value="0">---Select--</option>' + result.sGrievane);
                $('#role').empty(), $('#role').append('<option value="0">---Select--</option>' + result.sRole);
                $('.selectpicker').selectpicker('refresh');

            },
            error:function()
            {

            }


        })
        }
        function AddorEdit(ID)
        {

            $.ajax({
                url:"@Url.Action("FetchGrievanceMemberById", "Grievance")",
                method:"POST",
                datatype: "json",
                data: { sGrievancememberid: ID },
                success: function (GrievanceModel)
                {
                    if(GrievanceModel.G_MEMBER_ID!=null)
                    {
                                                 
                            $('#memberid').val(GrievanceModel.G_MEMBER_ID);
                            $('#staff').val(GrievanceModel.STAFF_ID);
                            $('#staff').prop('disabled', true);
                            $('#grievance').val(GrievanceModel.GRIEVANCE_TYPE_ID);
                            $('#role').val(GrievanceModel.ROLE);
                            $('#member').attr('checked', true);
                            $('#member').prop('disabled', true);
                            $('.selectpicker').selectpicker('refresh');
                        
                    }
                
                    
                                          
                },
                error:function()
                {
                    alert('error')
                }

            })

            $('#AddorEdit').modal();

        }
    function Cancel()
    {
        
        $("#grievance").val(0);
        $('#staff').val(0);
        $('#staff').prop('disabled', false);
        $('#member').attr('checked', false);
        $('#member').prop('disabled', false);
        $('.selectpicker').selectpicker('refresh');
    }
        $("#btnSave").on("click", function () {

            var memberid=$('#memberid').val();
            var staffid = $('#staff').val();
            var staffname = $('#staff').find('option:selected').text();

            var grievanceval = $("#grievance").val();
            var grievancetext=$('#grievance').find('option:selected').text();

            var role = $('#staff Option:selected').attr('roles')
            var members =$('#role').val();
            
            var JsonData;
            if (staffid != '' && grievanceval !=0 && members !=0 && role !=null)
            {
                $.ajax({
                    url: "@Url.Action("SaveorUpdateGrievanceMembers", "Grievance")",
                    method: "POST",
                    datatype: "json",
                    data: { "memberid": memberid, "staffid": staffid, "members": members, "grievanceval": grievanceval,"role":role },
                    success: function (objResult)
                    {
                        alert(objResult.Message);
                        loadContent('/Grievance/GrievanceMemebersList')
                    }, error: function (error) {
                        alert('Record not saved try again ..!');
                    }
                });
            }
            else
            {
                alert('Please Select All The Option')
            }
        });
    $('.modal').on('hide.bs.modal', function () {
        loadContent('/Grievance/GrievanceMemebersList')
    });
