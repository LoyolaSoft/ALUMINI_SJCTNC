@model CMS.ViewModel.ViewModel.GrievanceViewModel
@{
    ViewBag.Title = "Report";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/css/animate.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">GrievanceReport</li>
    </ol>
    <h1 class="page-header">Grievance Report</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Generate Report</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">

            <div class="row">
                <!-- begin col-12 -->
                <div class="col-lg-12">
                    <!-- begin nav-tabs -->
                    <ul class="nav nav-tabs" style="background-color:#ffff;">
                        <li class="nav-items">
                            <a href="#default-tab-1" data-toggle="tab" class="nav-link">
                                <span class="d-sm-none">Day Wise</span>
                                <span class="d-sm-block d-none">Report</span>
                            </a>
                        </li>
                        <li class="nav-items">
                            <a href="#default-tab-2" data-toggle="tab" class="nav-link">
                                <span class="d-sm-none">Group Wise</span>
                                <span class="d-sm-block d-none">Report</span>
                            </a>
                        </li>
                        <li class="nav-items">
                            <a href="#default-tab-3" data-toggle="tab" class="nav-link active show">
                                <span class="d-sm-none">Month Wise</span>
                                <span class="d-sm-block d-none">Report</span>
                            </a>
                        </li>
                    </ul>
                    <!-- end nav-tabs -->
                    <!-- begin tab-content -->
                    <div class="tab-content">
                        <!-- begin tab-pane -->
                        <div class="tab-pane fade" id="default-tab-1">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">
                                  

                                    <div class="col-md-4">
                                        <label class="col-md-4 control-label p-l-0"> Date </label>
                                        <div class="col-md-8 input-group date" id="datetimepicker1">
                                            @Html.Editor("txtdDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.GRIEVANCE_TYPE_ID, "Grievance", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.GRIEVANCE_TYPE_ID, (Model.GRIEVANCE_TYPE_ID != null) ? Model.GRIEVANCE_TYPE_ID : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "ddGrievanceType", @data_live_search = "true",@multiple = "multiple", @data_actions_box = "true" })
                                            @Html.ValidationMessageFor(m => m.GRIEVANCE_TYPE_ID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn btn-primary" id="btnDGet"> Get </button>
                                    </div>

                                    <div class="col-md-1">
                                        <button class="btn btn-success hidden" onclick="printDiv()" id="btnPrintForDayWise"> Print </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end tab-pane -->
                        <!-- begin tab-pane -->
                        <div class="tab-pane fade" id="default-tab-2">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">
                                    <div class="col-md-3">
                                        <label class="col-md-4 control-label p-l-0">From Date </label>
                                        <div class="col-md-8 input-group date" id="datetimepicker2">
                                            @Html.Editor("txtgDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="col-md-4 control-label p-l-0">End Date </label>
                                        <div class="col-md-8 input-group date" id="datetimepicker3">
                                            @Html.Editor("txtgEndDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                                            <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.GRIEVANCE_TYPE_ID, "Grievance", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.GRIEVANCE_TYPE_ID, (Model.GRIEVANCE_TYPE_ID != null) ? Model.GRIEVANCE_TYPE_ID : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "dgGrievanceType", @data_live_search = "true" , @multiple = "multiple", @data_actions_box = "true" })
                                            @Html.ValidationMessageFor(m => m.GRIEVANCE_TYPE_ID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn btn-primary" id="btnGGet"> Get </button>
                                    </div>

                                    <div class="col-md-1">
                                        <button class="btn btn-success hidden" onclick="printDiv()" id="btnPrintForGroupWise"> Print </button>
                                    </div>
                                </div>

                              
                            </div>
                        </div>
                        <!-- end tab-pane -->
                        <!-- begin tab-pane -->
                        <div class="tab-pane fade active show" id="default-tab-3">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-group">                       
                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.MonthList, "Select Month", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.MonthList, (Model.MonthList != null) ? Model.MonthList : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "dMonth", @data_live_search = "true" })
                                            @Html.ValidationMessageFor(m => m.MonthList, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.GRIEVANCE_TYPE_ID, "Grievance", htmlAttributes: new { @class = "col-md-4 control-label p-l-0" })
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.GRIEVANCE_TYPE_ID, (Model.GRIEVANCE_TYPE_ID != null) ? Model.GRIEVANCE_TYPE_ID : Enumerable.Empty<SelectListItem>(),null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @id = "dmGrievanceType", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true" })
                                            @Html.ValidationMessageFor(m => m.GRIEVANCE_TYPE_ID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-1">
                                        <button class="btn btn-primary" id="btnMGet"> Get </button>
                                    </div>

                                    <div class="col-md-1">
                                        <button class="btn btn-success hidden" onclick="printDiv()" id="btnPrintForMonthWise"> Print </button>
                                    </div>
                                
                                </div>

                               
                            </div>
                        </div>
                        <!-- end tab-pane -->
                    </div>
                    <!-- end tab-content -->
            
                </div>
            </div>



         
     
          
            <div class="form-group col-md-12">
                <div id="dvGrievanceReport"></div>
            </div>
                <br />
                <br />
             

            </div>
        </div>
    
</div>


    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        ContentLoad = function () {
            $('.selectpicker').selectpicker({
                size: 5
            });
            $('.selectpicker').selectpicker('refresh');
        }

     
        $("#txtdDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $("#txtgDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        $("#txtgEndDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });


        $('#btnDGet').on('click', function () {
            if ($("#txtdDate").val() && $('#ddGrievanceType').val()) {
                $.ajax({
                    url: '@Url.Action("BindDayWiseGrievanceReport", "Grievance")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sDate: $("#txtdDate").val(), sGrievanceType: String($('#ddGrievanceType').val()) },
                    success: function (data) {
                        $('#dvGrievanceReport').empty();
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        } else {
                            $('#dvGrievanceReport').append(data);
                            $('#lblReportName').text($("#txtdDate").val());
                            $('#btnPrintForDayWise').removeClass('hidden');
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Please Select All The Fileds');
            }
        });

        $('#btnGGet').on('click', function () {
            if ($("#txtgDate").val() && $('#txtgEndDate').val() && $('#dgGrievanceType').val()) {
                $.ajax({
                    url: '@Url.Action("BindGroupWiseGrievanceReport", "Grievance")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sDate: $("#txtgDate").val(), sEndDate: $("#txtgEndDate").val(),sGrievanceType: String($('#dgGrievanceType').val()) },
                    success: function (data) {
                        $('#dvGrievanceReport').empty();
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        } else {
                            $('#dvGrievanceReport').append(data);
                            $('#lblReportName').text($("#txtgDate").val() +" "+ "to" +" "+ $("#txtgEndDate").val());
                            $('#btnPrintForGroupWise').removeClass('hidden');
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Please Select All The Fileds');
            }
        });

        $('#btnMGet').on('click', function () {
            if ($("#dMonth").val() && $('#dmGrievanceType').val()) {
                $.ajax({
                    url: '@Url.Action("BindMonthWiseGrievanceReport", "Grievance")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sMonth: $("#dMonth").val(), sGrievanceType: String($('#dmGrievanceType').val()) },
                    success: function (data) {
                        $('#dvGrievanceReport').empty();
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        } else {
                            $('#dvGrievanceReport').append(data);
                            $('#lblReportName').text($("#dMonth option:selected").text());
                            $('#btnPrintForMonthWise').removeClass('hidden');
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Please Select All The Fileds');
            }
        });

        $('.nav-items').on("click", function () {
                
            $('#dvGrievanceReport').html('');

        });

        function printDiv() {
            var printContents = document.getElementById('dvGrievanceReport').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            loadContent('/Grievance/GrievanceReport');
        }
    </script>
    
