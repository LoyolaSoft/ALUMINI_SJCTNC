@model CMS.ViewModel.ViewModel.GrievanceViewModel
@{
    ViewBag.Title = "ReOpenComplaints";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link href="~/Content/assets/css/animate.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ReOpenComplaints</li>
    </ol>
    <h1 class="page-header">ReOpen Complaints</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ReOpen Complaints</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="col-md-12 form-horizontal">

                <div class="col-md-4 form-group">
                    <label class="col-md-4 control-label"> Date </label>
                    <div class="input-group date" id="datetimepicker1">
                        @Html.Editor("txtDate", new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Select  Date" } })
                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>

                <div class="col-md-4 form-group">
                    @Html.LabelFor(model => model.GRIEVANCE_TYPE_ID, "Grievance", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.GRIEVANCE_TYPE_ID, (Model.GRIEVANCE_TYPE_ID != null) ? Model.GRIEVANCE_TYPE_ID : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",@id="dGrievanceType", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.GRIEVANCE_TYPE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-4 form-group">
                    @Html.LabelFor(model => model.ClassList, "Class", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.ClassList, (Model.ClassList != null) ? Model.ClassList : Enumerable.Empty<SelectListItem>(), "---Select---", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm",@id="dClass", @data_live_search = "true" })
                        @Html.ValidationMessageFor(m => m.ClassList, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-2 form-group">
                    <button class="btn btn-primary" id="btnGet"> Get </button>
                </div>
            <br />
            <br />
                <div class="form-group col-md-12">
                    <div id="dvGrievanceClose">
                        <div class="col-md-12">
                            <div class="table table-responsive">
                                <table class="table m-b-0" id="tblComplaints">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Complaint Id</th>
                                            <th>Student Name</th>
                                            <th>Class</th>
                                            <th>Complaint Type</th>
                                            <th>Complaint Subject</th>
                                            <th>Complaint</th>
                                            <th>Submitted Date</th>
                                            <th align="center"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyAppend">

                                    </tbody>

                                  
                                </table>
                            </div>
                          

                        </div>
                    </div>
                </div>
       

    </div>
</div>
        </div></div>

    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        ContentLoad = function () {
            $('.selectpicker').selectpicker({
                size: 5
            });
            $('.selectpicker').selectpicker('refresh');
        }
        $("#txtDate").datepicker({
            todayHighlight: true,
            autoclose: true,
            endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        });
        
        $('#btnGet').on('click', function () {
            if ($('#dClass').val() && $('#txtDate').val() && $('#dGrievanceType').val()) {
                $.ajax({
                    url: '@Url.Action("ReOpenComplaint", "Grievance")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sClass: $('#dClass').val(), sDate: $('#txtDate').val(), sGrievanceType: $('#dGrievanceType').val() },
                    success: function (data) {
                        var count = 0;
                        $('#tbodyAppend').empty();
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        } else {
                            $.each(data, function (id, GrievanceUserInfo) {
                                count += 1;
                                $('#tbodyAppend').append(" <tr>" +
                                           "<td>" + count + "</td>" +
                                           "<td>" + GrievanceUserInfo.GRIEVANCE_ID + "</td>" +
                                           "<td>" + GrievanceUserInfo.FIRST_NAME + "</td>" +
                                            "<td>" + GrievanceUserInfo.CLASS_NAME + "</td>" +
                                           "<td> <b>" + GrievanceUserInfo.GRIEVANCE_TYPE_ID + "</b></td>" +
                                           "<td>" + GrievanceUserInfo.GRIEVANCE_SUBJECT + "</td>" +
                                           "<td>" + GrievanceUserInfo.GRIEVANCE_CONTENT + "</td>" +
                                           "<td>" + GrievanceUserInfo.SUB_DATE_TIME + "</td>" +
                                           "<td><a href='#' title='reopen' class='btn btn-primary' onclick='ReOpen(" + GrievanceUserInfo.GRIEVANCE_ID + ")'> Reopen </a></td>" +
                                       "</tr>");
                            });
                           
                            $('#dClass').text($('#ClassList option:selected').text());
                            $('#txtDate').text($('#txtDate').val());
                            $('#dGrievanceType option:selected').text($('#dGrievanceType option:selected').text());
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Please Select All The Fileds');
            }
        });

        ReOpen=function(GrievanceId)
        {
            if(GrievanceId!='')
            {
                $.ajax({
                    url: '@Url.Action("ReOpen", "Grievance")',
                    type: "post",
                    data: { sGrievanceId: GrievanceId },
                    success: function (data) {
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        }
                        else {
                            alert("Grievance ReOpened")
                            window.location.reload();
                        }
                    },
                    error: function () {
                        alert('Internal Server Error !');
                    }
                });
            }
        }
        

    </script>
