@model CMS.ViewModel.ViewModel.GrievanceViewModel
@{
    ViewBag.Title = "SupGrievanceType";
    Layout =null;
}

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Grievance Type List</li>
    </ol>
    <h1 class="page-header">Grievance Type List</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Grievance Type List</h4>
        </div>
        <div class="panel-body noPadding">
            <div class="">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:AddorEdit()"><i class="fa fa-plus" title="Add"></i>Add</a>
            </div>
            <br />
            @{ int count = 0;}
            @if (Model.liGrievanceType != null)
            {
                <table class="table table-bordered table-hover table-responsive" id="Supgrievancetbl">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                               Grievance Name
                            </th>
                            <th>
                                Grievance Code
                            </th>
                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>

                    @foreach (var item in Model.liGrievanceType)
                {
                        <tr>
                            <td>
                                @{ count++;}
                                @count
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.GRIEVANCE_TYPE_NAME)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.GRIEVANCE_TYPE_CODE)
                            </td>
                            <td>
                                <a href="javascript:AddorEdit(@item.GRIEVANCE_TYPE_ID)"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                <a href="javascript:;" onclick="GetConfirm(@item.GRIEVANCE_TYPE_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a>
                            </td>
                        </tr>
                                    }

                </table>
                                    }
        </div>
    </div>
</div>
<div class="modal" id="AddorEdit">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Grievance Type</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="">
                        <input type="hidden" name="grievacnetypeid" id="grievacnetypeid" />
                        <div class="form-group ">
                            <label class="col-md-3 control-label">Grievance Name</label>
                            <div class="col-md-9 col-lg-9">
                                <input type="text" id="grievancetype" class="form-control">
                            </div>
                        </div>
                            <div class="form-group ">
                                <label class="col-md-3 control-label">Grievance Code</label>
                                <div class="col-md-9 col-lg-9">
                                    <input type="text" id="grievancecode" class="form-control" disabled>
                                </div>
                            </div>
                            
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a href="#" onclick=";" class="btn btn-sm btn-primary" data-dismiss="modal" id="btnSave">Save</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad()
    {
        $("#Supgrievancetbl").DataTable();
    }
    
</script>
    <script>
        var id;
        function GetConfirm(ID) {
            if (!confirm('Are you sure to delete ?')) {
                return false;
            } else {
                $.ajax({
                    url: "@Url.Action("DeleteGrievanceType", "Grievance")",
                    method: "POST",
                    datatype: "json",
                    data: { sGrievancetypeid: ID },
                    success: function (objResult) {
                        alert(objResult.Message);
                        loadContent('/Grievance/SupGrievanceType');
                    }, error: function (error) {
                        alert('Internal Server Error');
                    }
                });
            }
        }
        function AddorEdit(ID)
        {

            $.ajax({
                url:"@Url.Action("GrievanceTypeById", "Grievance")",
                method:"POST",
                datatype: "json",
                data: { sGrievancetypeid: ID },
                success:function(objModel)
                {                   
                    $('#grievacnetypeid').val(objModel.GRIEVANCE_TYPE_ID);
                    $('#grievancetype').val(objModel.GRIEVANCE_TYPE_NAME);
                    $('#grievancecode').val(objModel.GRIEVANCE_TYPE_CODE);
                }

            })

            $('#AddorEdit').modal();

        }
        $("#btnSave").on("click", function () {
            var grievacnetypeid = $("#grievacnetypeid").val();
            var grievancetype = $("#grievancetype").val();
            var JsonData;
            if (JsonData == null) {
                JsonData = '{"GRIEVANCE_TYPE_ID":"' + grievacnetypeid + '","GRIEVANCE_TYPE_NAME":"' + grievancetype + '"}';
            }
            $.ajax({
             url: "@Url.Action("SaveorUpdateGrievanceType", "Grievance")",
             method: "POST",
            datatype: "html",
            data: { sGrievancetype: JsonData },
            success: function (objResult) {
                alert(objResult.Message);
                loadContent('/Grievance/SupGrievanceType');
            }, error: function (error) {
                alert('Record not saved try again ..!');
            }
        });
        });
    </script>


