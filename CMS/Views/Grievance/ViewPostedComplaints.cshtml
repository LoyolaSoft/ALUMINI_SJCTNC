@model CMS.ViewModel.ViewModel.GrievanceViewModel
@using CMS.Utility
@{
    ViewBag.Title = "ViewPostedComplaints";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
    @*<link href="~/Content/assets/css/animate.min.css" rel="stylesheet" />*@


<style type="text/css">
 
   .attached-document {
    list-style-type: none;
    margin: 15px 0 0;
    padding: 0;
}
    .bg-white {
    background: #fff!important;
    color: #000!important;
}
    .attached-document>li {
    width: 180px;
    float: left;
    background: #fff;
    color: #222;
    font-weight: 600;
    position: relative;
    margin-right: 15px;
    margin-bottom: 15px;
    border: 1px solid #d9dfe5;
}
    .fa-file:before {
    content: "\f15b";
}
    .attached-document>li .document-file {
    height: 70px;
    background: 0 0;
    overflow: hidden;
    text-align: center;
    line-height: 70px;
    font-size: 32px;
    margin: -1px;
}
    .attached-document>li .document-name {
    padding: 5px 10px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background: #f1f3f4;
}
    .fa-camera:before {
    content: "\f030";
}

</style>

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">UserRolesRightList</li>
    </ol>
    <h1 class="page-header">View Posted Complaints</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">View Posted Complaints</h4>
        </div>
        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            @Html.AntiForgeryToken()
            <div class="col-md-12 row">
                <ul class="nav navbar-nav navbar-right">

                    <li class="dropdown" style="list-style:none;">
                        <a href="javascript:;" data-toggle="dropdown" class="dropdown-toggle icon" aria-expanded="false">
                            <i class="ion-ios-bell" style="font-size: 26px;"></i>
                            <span class="label" id="sRemainder"></span>
                        </a>
                        <ul class="dropdown-menu media-list pull-right animated fadeInDown" id="NotificationFind">
                            <li class="dropdown-header"><p id="pNotification"></p></li>

                            <li class="dropdown-footer text-center">
                                <a href="javascript:;">View more</a>
                            </li>
                        </ul>
                    </li>
                    <li class="active">
                        <a href="#" id="NewComplaints">
                            <span class="label label-theme m-l-5" id="Nbadge"></span>
                        </a>
                    </li>
                </ul>
            </div>
            
        <div class="form-group">
            <div class="col-lg-12 row">
                <div class="col-lg-4">
                    <div class="widget widget-stats bg-gradient-blue m-b-10">
                        <div class="stats-icon stats-icon-lg"><i class="fa fa-dollar-sign fa-fw"></i></div>
                        <div class="stats-content">
                            <div class="stats-title">TOTAL COMPLAINTS</div>
                            <div class="stats-number"><p id="pTotalComplaints"></p></div>
                            <div class="stats-progress progress">
                                <div class="progress-bar" style="width: 40.5%;"></div>
                            </div>
                            <div class="stats-desc">Better than last week (40.5%)</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="widget widget-stats bg-gradient-purple m-b-10">
                        <div class="stats-icon stats-icon-lg"><i class="fa fa-archive fa-fw"></i></div>
                        <div class="stats-content">
                            <div class="stats-title">PENDING COMPLAINTS</div>
                            <div class="stats-number"><p id="pPendingComplaints"></p></div>
                            <div class="stats-progress progress">
                                <div class="progress-bar" style="width: 76.3%;"></div>
                            </div>
                            <div class="stats-desc">Better than last week (76.3%)</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="widget widget-stats bg-gradient-green m-b-10">
                        <div class="stats-icon stats-icon-lg"><i class="fa fa-comment-alt fa-fw"></i></div>
                        <div class="stats-content">
                            <div class="stats-title">REPLIED COMPLAINTS</div>
                            <div class="stats-number"><p id="pRepliedComplaints"></p></div>
                            <div class="stats-progress progress">
                                <div class="progress-bar" style="width: 54.9%;"></div>
                            </div>
                            <div class="stats-desc">Better than last week (54.9%)</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    
            
            <br />
            <br />
            <br />
            <br />
            <div class="form-group col-md-12">
                <div id="dvGrievance">
                    @{ int count = 0;}
                    @if (Model.liGrievanceUserInfo != null)
                    {
                        <div class="table-responsive">
                            <table class="table m-b-0" id="tblComplaints">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th width="10%">Student Name</th>
                                        <th width="20%">Class</th>
                                        <th>Complaint Type</th>
                                        <th>Complaint Subject</th>
                                        @*<th>Complaint</th>*@
                                        <th>Submitted Date</th>
                                        <th>Status</th>
                                        <th align="center"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.liGrievanceUserInfo)
                                    {

                                        <tr>
                                            <td>@{count++;}@count</td>
                                            <td>@Html.DisplayFor(model => item.FIRST_NAME)</td>
                                            <td>@Html.DisplayFor(model => item.CLASS_NAME)</td>
                                            <td>@Html.DisplayFor(model => item.GRIEVANCE_TYPE_ID)</td>
                                            <td>@Html.DisplayFor(model => item.GRIEVANCE_SUBJECT)</td>
                                            @*<td>@(new HtmlString(item.GRIEVANCE_CONTENT))</td>*@
                                            <td>@Html.DisplayFor(model => item.SUB_DATE_TIME)</td>
                                            @if (item.STATUS == "1")
                                            {
                                                <td><a class="" href="" onclick="CloseComplaintById(@item.GRIEVANCE_ID)">Close</a></td>
                                            }
                                            @if (item.STATUS == "0")
                                            {

                                                <td><a class="" href="#" onclick="Reply(@item.GRIEVANCE_ID)">Reply</a></td>
                                            }
                                            <td><a href="#modal-success" data-toggle="modal" title="view" class="btn btn-primary" onclick="ViewComplaintsById(@item.GRIEVANCE_ID)"> View </a></td>
                                        </tr>
                                                }
                                </tbody>
                            </table>
                        </div>
                                                }

                </div>

            </div>
        </div>

</div>
   </div>                    

  <div class="modal modal-success fade" id="modal-success">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title"><label id="lblModal" class="form-group">View Complaint</label></h4>
            </div>
            <div class="modal-body" id="mBody">
                <div class="panel-body">
                    <!-- begin table-responsive -->
                    <div class="col-lg-12 form-group row">
                        <div class="col-lg-12">
                          
                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <img src="" width="100" height="100" alt="student image" id="imgStudent" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Roll No:</span></strong><br /> @Html.LabelFor(model => model.grievance_userinfo.ROLL_NO, new { @class = "", @id = "dRollno" })
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Name:</span></strong> <br /> @Html.LabelFor(model => model.grievance_userinfo.FIRST_NAME, new { @class = "", @id = "dName" })
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Class:</span></strong> <br />@Html.LabelFor(model => model.grievance_userinfo.CLASS_NAME, new { @class = "", @id = "dClass" })
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Type:</span></strong><br />  @Html.LabelFor(model => model.grievance_userinfo.GRIEVANCE_TYPE_ID, new { @class = "", @id = "dGrievanceType" })
                                           
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Subject:</span></strong><br />  @Html.LabelFor(model => model.grievance_userinfo.GRIEVANCE_SUBJECT, new { @class = "", @id = "dGrievanceSubject" })
                                          
                                        </div>

                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <strong><span style="color:dodgerblue">Date:</span></strong><br /> @Html.LabelFor(model => model.grievance_userinfo.SUB_DATE_TIME, new { @class = "", @id = "dSubDatetiem" })
                                           
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12">
                          
                            <div class="form-group">
                                <div class="col-md-12">
                                    @Html.Label("Grievance", new { @class = "control-label col-md-2" })<pre class="col-md-8" id="preContent">@*@Html.LabelFor(model => model.grievance_userinfo.GRIEVANCE_CONTENT, new { @class = "", @id = "dGrievanceContent" })*@</pre>
                                   
                                </div>
                            </div>
                        </div>
                        <br />
                       
                        

                    </div>
           
                        <div class="table table-responsive">
                            <table class="table m-b-0">
                                <thead>
                                    <tr>
                                        <th width="10%">Attachment</th>
                                       
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr data-id="empty" style="display: none;" id="trEmpty">
                                        <td colspan="4" class="text-center text-muted p-t-30 p-b-30">
                                            <div class="m-b-10"><i class="fa fa-file fa-3x"></i></div>
                                            <div>No file selected</div>
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody class="files" id="tBody"></tbody>
                            </table>
                        </div>
                        <!-- end table-responsive -->
                    </div>

            </div>
            <div class="modal-footer">


            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

    
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
    <script>
        ContentLoad = function () {
            $('.selectpicker').selectpicker({
                size: 5
            });
            $('.selectpicker').selectpicker('refresh');
            LoadNewComplaints()
            LoadRemaind()
            TotalComplaintViews()

        }


        $('#tblComplaints').DataTable({
            "bsort": false,
            "ordering":false,


        });

        function Reply(ComplaintId)
        {

            if(ComplaintId!='')
            {

                //var Url = "@Url.Action("ReplyComplaint", "Grievance")";
                $.ajax({
                    url: "/Grievance/Reply",
                    type:"get",
                    data:{sComplaintId:ComplaintId},
                    success:function(data)
                    {
                        //window.location.href = Url;
                        loadContent('/Grievance/ReplyComplaint');
                    },
                    error:function(ex)
                    {

                    }
                });
            }
        }
        function ViewComplaintsById(GrievanceId)
        {
            $.ajax({
                url:"/Grievance/ViewComplaintsByGrievanceId",
                type:"post",
                data:{sGrievanceId:GrievanceId},
                datatype:"json",
                success:function(data)
                {
                    $('#tBody').html('');
                    var result="";
                    if(data[0]!=null && data[0]!='')
                    {
                        $('#imgStudent').attr("src",data[0].PHOTO);
                        $('#dName').text(data[0].FIRST_NAME);
                        $('#dRollno').text(data[0].ROLL_NO);
                        $('#dClass').text(data[0].CLASS_NAME);
                        $('#dGrievanceType').text(data[0].GRIEVANCE_TYPE_ID);
                        $('#dGrievanceSubject').text(data[0].GRIEVANCE_SUBJECT);
                        // $('#dGrievanceContent').text(data[0].GRIEVANCE_CONTENT);preContent
                        $('#preContent').html(data[0].GRIEVANCE_CONTENT);
                        $('#dSubDatetiem').text(data[0].SUB_DATE_TIME);

                      
                        var extension = "";
                        var file = "";
                      
                        
                           
                            var TotalPath = data[0].ATTACHMENT_PATH.split(",");
                            $.each(TotalPath, function (id, path) {
                                var File = path.split(".");
                                //  var filename = path.match(/[-_\w]+[.][\w]+$/i)[0];
                                var filename = path.replace(/^.*[\\\/]/, '');
                                extension = File[1];
                                file += (typeof extension.toLowerCase() == 'jpg' || extension.toLowerCase() == 'png' ? "<li class='fa-camera'>" +
                                          "<div class='document-file'>" +
                                              "<a href='#'>" +
                                                  "<img src=" + path + "   alt=''>" +
                                              "</a>" +
                                          "</div>" +
                                          "<div class='document-name'><a href='" + path + "' download>" + filename + "</a></div>" +
                                      "</li>" : "<li class='fa-file'>" +
                                      "<div class='document-file'>" +
                                      "<a href='#'>" +
                                          "<i class='fa fa-file'></i>" +
                                      "</a>" +
                                      "</div>" +
                                     "<div class='document-name'><a href='" + path + "' download title=" + filename + ">" + filename + "</a></div>" +
                                "</li>")

                            });
                            result += "<ul class='attached-document clearfix'>" +
                               file
                            "</ul>";
                       
                        $('#tBody').append(result);
                    }
                },
                error:function(ex)
                {
                    $('#dName').text('');
                    $('#dRollno').text('');
                    $('#dClass').text('');
                    $('#dGrievanceType').text('');
                    $('#dGrievanceSubject').text('');
                    $('#dGrievanceContent').text('');
                    $('#dSubDatetiem').text('');
                }
            });
        }

        function LoadNewComplaints() {
            $.ajax({
                url: "/Grievance/StaffNewComplaints",
                type: "post",
                success: function (data) {
                    var count = 0;
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {
                        $.each(data, function (id, value) {
                            count += 1;
                        });
                        $('#Nbadge').text("NEW " + " " + count);
                        myAlert('Please Find  the'+ count +'new Complaints by clicking  new  icon in below', 'gritter-info', '');
                    }
                },
                error: function (ex) {

                }
            });
           // setInterval(LoadNewComplaints, 5000);
        }
        $('#NewComplaints').on("click", function () {
            $.ajax({

                url: "/Grievance/StaffNewComplaintsView",
                type: "post",
                success: function (data) {
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {
                        LoadNewComplaints()
                        loadContent('/Grievance/ViewPostedComplaints');
                    }
                },
                error: function (ex) {

                }
            });
        });
        function CloseComplaintById(ComplaintId)
        {
            $.ajax({

                url: "/Grievance/CloseComplaintById",
                type: "post",
                data:{sComplaintId:ComplaintId },
                success: function (data) {
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {

                        LoadNewComplaints()
                        loadContent('/Grievance/ViewPostedComplaints');
                    }
                },
                error: function (ex) {

                }
            });
        }


        function LoadRemaind()
        {

            $.ajax({
                url: "/Grievance/LoadRemaind",
                type: "post",
                success: function (data) {
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {
                        var result = "";
                        var count = 0;
                        $.each(data, function (id, info) {
                            count += 1;
                            result += "<li class='media'>" +
                                          "<a href='javascript:;' onclick='UpdateRemaind(" + info.GRIEVANCE_ID + ")'>" +
                                              "<div class='media-left'><i class='ion-ios-close-empty media-object bg-red'></i></div>" +
                                              "<div class='media-body'>" +
                                                  "<h6 class='media-heading'>" + info.FIRST_NAME + "</h6>" +
                                                  "<p>" + info.GRIEVANCE_SUBJECT + "</p>" +
                                                   "<label hidden id='lblGrievanceId'>"+info.GRIEVANCE_ID+"</label>"+
                                                  "<div class='text-muted f-s-11'>3 minutes ago</div>" +
                                              "</div>" +
                                          "</a>" +
                                    "</li>";
                        });
                        $('#NotificationFind').append(result);
                        $('#pNotification').text("Notificatios(" + count + ")");
                        $('#sRemainder').text(count);
                        myAlert('Please find remainder nodifications by clicking bell icon in below', 'gritter-danger', '');
                    }
                },
                error: function (ex) {

                }
            });
        }

        function UpdateRemaind(GrievanceId)
        {
            $.ajax({
                url: "/Grievance/UpdateRemaind",
                type: "post",
                data:{sGrievanceId:GrievanceId},
                success: function (data) {
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {
                        Reply(GrievanceId);
                    }
                },
                error: function (ex) {

                }
            });
        }


        function TotalComplaintViews()
        {
            $.ajax({
                url: "/Grievance/FetchTotalComplaintsForStaff",
                type: "post",
                success: function (data) {
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {
                        $('#pTotalComplaints').text(data[0].TOTAL_COMPLAINT);
                        $('#pPendingComplaints').text(data[0].PENDING_COMPLAINT);
                        $('#pRepliedComplaints').text(data[0].REPLIED_COMPLAINT);
                    }
                },
                error: function (ex) {

                }
            });
        }







     </script>
