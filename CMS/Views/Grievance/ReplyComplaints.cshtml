
@model CMS.ViewModel.ViewModel.GrievanceViewModel
@using CMS.Utility

<style>
     .fileinput-button input {
   position: absolute;
    top: 0;
    right: 0;
    margin: 0;
    opacity: 0;
    -ms-filter: 'alpha(opacity=0)';
    font-size: 200px !important;
    direction: ltr;
    cursor: pointer;
    }
    button, input, optgroup, select {
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
}
    .btn{
     
    font-weight: 600; 
     line-height: 20px; 
    padding: 6px 12px; 
    transition: all .1s ease-in-out; 
    box-shadow: none!important; 
}
    .btn:not(:disabled):not(.disabled) {
    cursor: pointer;
}
    .fileinput-button {
    position: relative;
    overflow: hidden;
    display: inline-block;
}
    .btn, .input-group-addon:focus {
    outline: 0!important;
</style>
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />
@if (Model.grievance_userinfo != null)
{
    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">UserRolesRightList</li>
        </ol>
        <h1 class="page-header">Reply Complaints</h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Reply Complaint</h4>
            </div>

            <div class="panel-body" data-parsley-validate="true" id="Pbody">
                <br /><br />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.grievance_userinfo.USER_ID, htmlAttributes: new { @class = "control-label col-md-6", @id = "txtId" })
                @Html.HiddenFor(model => model.grievance_userinfo.GRIEVANCE_ID, htmlAttributes: new { @class = "control-label col-md-6", @id = "txtGrievanceId" })
                <div class="col-lg-12 form-group row">
                    <div class="col-lg-12">
                        @*<div class="col-md-8">
                                @Html.Label("To", new { @class = "control-label col-md-6" })
                            </div>*@
                        <div class="form-group">
                            <div class="col-md-12">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <img src="@Html.DisplayFor(model =>model.grievance_userinfo.PHOTO)" width="100" height="100" alt="student image" />
                                    </div>
                                </div>
                                <div class="col-md-2">

                                    <div class="form-group">
                                        <strong><span style="color:dodgerblue">Roll No:</span></strong><br /> @Html.DisplayFor(model => model.grievance_userinfo.ROLL_NO)
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <strong><span style="color:dodgerblue">Name:</span></strong> <br /> @Html.DisplayFor(model => model.grievance_userinfo.FIRST_NAME)
                                    </div>
                                </div>

                                <div class="col-md-5">
                                    <div class="form-group">
                                        <strong><span style="color:dodgerblue">Class:</span></strong> <br /> @Html.DisplayFor(model => model.grievance_userinfo.CLASS_NAME)
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <strong><span style="color:dodgerblue">Type:</span></strong><br />  @Html.DisplayFor(model => model.grievance_userinfo.GRIEVANCE_TYPE_ID)
                                        @Html.HiddenFor(model => model.grievance_userinfo.GRIEVANCE_TYPE_ID, htmlAttributes: new { @class = "control-label col-md-6", @id = "GrievanceTypeId" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <strong><span style="color:dodgerblue">Subject:</span></strong><br />   @Html.DisplayFor(model => model.grievance_userinfo.GRIEVANCE_SUBJECT)
                                        @Html.HiddenFor(model => model.grievance_userinfo.GRIEVANCE_SUBJECT, htmlAttributes: new { @class = "control-label col-md-6", @id = "txtGrievanceSubject" })
                                    </div>

                                </div>

                                <div class="col-md-5">
                                    <div class="form-group">
                                        <strong><span style="color:dodgerblue">Date:</span></strong><br />   @Html.DisplayFor(model => model.grievance_userinfo.SUB_DATE_TIME)
                                        @Html.HiddenFor(model => model.grievance_userinfo.SUB_DATE_TIME, htmlAttributes: new { @class = "control-label col-md-6", @id = "txtSubDate" })
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        @*<div class="col-md-8">
                                @Html.Label("Grievance", new { @class = "control-label col-md-6" })
                            </div>*@
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.Label("Grievance", new { @class = "control-label col-md-2" })<pre class="col-md-8" id="preGrievanceContent">@(new HtmlString(Model.grievance_userinfo.GRIEVANCE_CONTENT))</pre>
                                @*@Html.HiddenFor(model => model.grievance_userinfo.GRIEVANCE_CONTENT, htmlAttributes: new { @class = "control-label col-md-6", @id = "txtGrievanceContent" })*@
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="col-lg-12">

                        @*<div class="col-md-8">
                                @Html.Label("Reply Message", new { @class = "control-label col-md-6" })
                            </div>*@

                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.Label("Reply Message", new { @class = "control-label col-md-2" })

                                <form action="" method="POST" name="summernote_form" class="table-bordered col-md-8">
                                    @Html.TextArea("Description", null, new { @class = "summernote table-bordered", @id = "txtGrievanceReplyContent", @cols = "20", @rows = "8", @max_length = "612", @data_parsley_required = "true", @data_live_search = "true" })
                                </form>

                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">


                            @*<div class="col-md-8">
                                    @Html.Label("Attachment", new { @class = "control-label col-md-6" })
                                </div>*@

                            <div class="form-group">
                                <div class="col-md-12">
                                    @Html.Label("Attachment", new { @class = "control-label col-md-2" })

                                    <span class="btn btn-primary fileinput-button m-r-3">
                                        <i class="fa fa-plus"></i>
                                        <span>Add files...</span>
                                        <input type="file" name="files[]" multiple id="fAttachment" onchange="readmultifiles()">
                                    </span>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>


                <div class="col-lg-12 table-responsive">
                    <table class="table m-b-0">
                        <thead>
                            <tr>
                                <th width="10%">PREVIEW</th>
                                <th>FILE INFO</th>
                                <th>UPLOAD PROGRESS</th>
                                <th width="1%"></th>
                            </tr>
                        </thead>
                        <tbody class="files">
                            <tr data-id="empty" style="display: none;" id="trEmpty">
                                <td colspan="4" class="text-center text-muted p-t-30 p-b-30">
                                    <div class="m-b-10"><i class="fa fa-file fa-3x"></i></div>
                                    <div>No file selected</div>
                                </td>
                            </tr>


                        </tbody>
                    </table>
                </div>
              
                <div class="form-group col-lg-12 row">

                    <div class="form-group pull-right">
                        <div class="col-md-4">
                            <a href="javascript:;" id="btnPost" onclick="" class="btn btn-primary">Reply</a>
                        </div>

                        <div class="col-md-4">
                            <a href="javascript:;" id="btnCancelPage" onclick="" class="btn btn-danger">Cancel</a>
                        </div>
                    </div>

                </div>



            </div>
        </div>
    </div>
}

<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>
<script>
   
        $(".summernote").summernote({
            placeholder: "Add a Description"
        });
        $('.note-editable').css("height", "182");
    
</script>