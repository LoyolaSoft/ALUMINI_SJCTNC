                success: function (data) {
                    var count = 0;
                    if (data.message != null && data.message != '') {
                        alert(data.message)
                    }
                    else {
                        $.each(data, function (id, value) {
                            count += 1;
                        });
                        $('#Nbadge').text("NEW"+" "+count);
                    }
                },
                error: function (ex) {

                }

            });

          //  setInterval(LoadNewMessages, 5000);
        }
