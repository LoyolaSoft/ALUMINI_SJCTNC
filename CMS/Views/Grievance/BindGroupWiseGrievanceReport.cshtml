
@model CMS.ViewModel.ViewModel.GrievanceViewModel
@using CMS.Utility
@{
    ViewBag.Title = "BindGroupWiseGrievanceReport";
    Layout = null;
}
<div class="col-md-12 table-responsive">
    @if (Model.liGrievanceViewInfo != null && Model.liGrievanceViewInfo.Count > 0)
    {
        if (Model.liCollegeDetails != null)
        {
            <div class="text-center">
                @*<img class="image" />*@
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img src="@Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO" style="width:100px; height:100px" />
            </div>
            <div class="text-center">

                <h3>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_NAME &nbsp;&nbsp; @Model.liCollegeDetails.FirstOrDefault().PLACE .</h3>
                <h4>@Model.liCollegeDetails.FirstOrDefault().UNIVERSITY.</h4>
                <h5>
                    GRIEVANCE  REPORT FOR <label id="lblReportName">m</label> &nbsp;-(@{if (Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] != null)
                        { @Session[Common.SESSION_VARIABLES.ACADEMIC_YEAR_NAME] } }) <br />

                </h5>


            </div>
                        }
        <div class="">
          
            @foreach (var item in Model.liGrievanceViewInfo)
            {
                <div style="page-break-after:avoid !important;page-break-inside:avoid !important;">



                    <br />
                    
                    <hr />
                    <div class="col-xs-4 form-group"> <b>Roll No : </b> @item.ROLL_NO</div>
                    <div class="col-xs-4 form-group"> <b>Student Name : </b> @item.FIRST_NAME</div>
                    <div class="col-xs-4 form-group"> <b>Class Name : </b> @item.CLASS_NAME</div>
                    <div class="col-xs-4 form-group"> <b>Submitted Date : </b> @item.SUB_DATE_TIME</div>
                    <div class="col-xs-4 form-group"> <b>Replied Date : </b> @item.REP_DATE_TIME</div>
                    <div>
                        <table class="table table-bordered table-responsive table-hover">
                            <thead>
                                <tr>
                                    @*<th>#</th>*@
                                    <th>Grievance Type</th>
                                    <th>Grievance Subject</th>
                                    <th>Grievance Content </th>
                                    @*<th>Submitted Date</th>*@
                                    <th>Redressal Content</th>
                                    @*<th>Replied Date</th>*@
                                </tr>
                            </thead>
                            <tbody>


                                <tr>
                                    @*<td>@{count++;}@count</td>*@
                                    <td>@item.GRIEVANCE_TYPE_ID</td>
                                    <td>@item.GRIEVANCE_SUBJECT</td>
                                    <td>@(new HtmlString(item.GRIEVANCE_CONTENT))</td>
                                    @*<td>@item.SUB_DATE_TIME</td>*@
                                    <td>@(new HtmlString(item.REDRESSAL_CONTENT))</td>
                                    @*<td>@item.REP_DATE_TIME</td>*@
                                </tr>

                            </tbody>
                        </table>
                    </div>
                    <hr />



                </div>

            }
        </div>
    }
</div>