@model CMS.ViewModel.ViewModel.GrievanceViewModel
@{
    ViewBag.Title = "AssignGrievancetoMembers";
    Layout =null;
}


<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Assign Grievance</li>
    </ol>
    <h1 class="page-header">Assign Grievance</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Assign Grievance</h4>
        </div>
        <div class="panel-body noPadding" id="maindiv">
            <div class="form-horizontal">

                <div class="col-md-12 col-lg-offset-2">

                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Grievance Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.GrievanceType, (Model.GrievanceType != null) ? Model.GrievanceType : Enumerable.Empty<SelectListItem>(), "-- Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "grievancetype", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.GrievanceType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label("Select Staff", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.StaffList, (Model.StaffList != null) ? Model.StaffList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @id = "staff", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.StaffList, "", new { @class = "text-danger" })
                            </div>
                            
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group table-responsive" id="loaddiv">
                      
                           
                            <table class="table table-hover table-bordered" id="Assigntable">
                                <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox" name="myTextEditBox" id="AllchkID" onchange="SelectOrUnselect()" /> Select All
                                        </th>
                                        <th>Sener Name</th>
                                        <th>Grievance Name</th>
                                        <th>Subject</th>
                                        <th>Content</th>
                                        <th>Submission Date&Time</th>
                                        <th>Action</th>
                                        
                                    </tr>
                                </thead>

                                @if (Model.liGrievanceinfolist != null && Model.liGrievanceinfolist.Count>0)
                                {
                                    foreach (var item in Model.liGrievanceinfolist)
                                    {
                                        <tr cms-grievanceid="@item.">
                                            <td>
                                                <input type="checkbox" name="myTextEditBox" id="chkID" cms-grievanceid="@item.GRIEVANCE_ID" />
                                            </td>
                                            <td>@item.SENDER_NAME </td>
                                            <td>@item.GRIEVANCE_TYPE_NAME</td>
                                            <td>@item.GRIEVANCE_SUBJECT</td>
                                            <td>@(new HtmlString(item.GRIEVANCE_CONTENT))</td>
                                            <td>@item.SUB_DATE_TIME</td>
                                            <td><a href="javascript:;" onclick="GetConfirm(@item.GRIEVANCE_ID)" title="CliCk To Delete"><i class="fa fa-trash text-danger"></i></a></td>
                                        </tr>
                                      }
                                 }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="7" align="center"><p>No records available !!!</p></td>
                                                        </tr>
                                                    }


                            </table>
                                                    
                    </div>
                </div>
                <div class="col-md-12 col-md-offset-10">
                    <div class="col-md-1">
                        <button name="assign" class="btn btn-success" id="assignbtn">Assign</button>
                    </div>
                    <div class="col-md-1">
                        <button name="assign" onclick="loadContent('/Grievance/AssignedGrievance')" class="btn btn-danger" id="cancel">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    function ContentLoad()
    {

        $('.selectpicker').selectpicker({
            size: 4
        });

        $("#Grievancetbl").DataTable();
       
        $('#grievancetype').on('change', function () {
            var grievancetype = $('#grievancetype').val();
            if (grievancetype == 0) {
                loadContent('/Grievance/AssignGrievancetoMembers')
            }
            else {
                $.ajax({
                    url: "/Grievance/FetchStaffBygrievancetype",
                    method: "POST",
                    type: "json",
                    data: { "grievanceid": grievancetype },
                    success: function (sOPtion) {

                        $('#staff').empty(), $('#staff').append('<option value="0">---Select--</option>' + sOPtion);
                        $('.selectpicker').selectpicker('refresh');

                    },
                    error: function (data) {
                        alert('Internal Server Error');
                    }
                })
                $.ajax({
                    url: "/Grievance/BindgrievanceBytype",
                    method: "POST",
                    type: "json",
                    data: { "grievanceid": grievancetype },
                    success: function (result) {
                        $('#loaddiv').empty();
                        $('#loaddiv').html(result);
                    },
                    error: function (data)
                    {
                        alert('Internal Server Error');
                    }
                })
            }

            });
        
        $('#assignbtn').click(function () {

            var Grievanceid='';
            var grievancetype = $('#grievancetype').val();
            var staffid = $('#staff').val();

            $('#Assigntable tbody tr').each(function () {
                $(this).find('td').each(function () {
                    var chkBox = $(this).find('input[type="checkbox"]');
                    if (chkBox.is(':checked')) {
                        Grievanceid += $(this).find('input[type="checkbox"]').attr("cms-grievanceid") + ",";

                    }
                });
            });
            var Grievanceids = Grievanceid.slice(0, -1);

            if (Grievanceid == null) {
                alert('Please select the grievance to assign');
                return false;
            }
            if (grievancetype !='' && staffid != '' && Grievanceid != '')
            {
                var JsonData = '{"GRIEVANCE_TYPE_ID":"' + grievancetype + '","GRIEVANCE_ID":"' + Grievanceids + '"}';

                $.ajax({
                    url: "@Url.Action("AssignGrievance", "Grievance")",
                    method: "POST",
                    type: "JSON",
                    data: { sGrievanceassign: JsonData,staffid:staffid },
                    success: function (objResult) {
                        alert(objResult.Message)
                        loadContent('/Grievance/AssignGrievancetoMembers')
                        
                },
                    error: function (data)
                    {
                        alert('Internal Server Error');
                    }
            })
            }
        else
    {
                alert('Choose All The Fields');
    }
    });
    }
    function GetConfirm(ID) {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        } else {
            $.ajax({
                url: "@Url.Action("DeleteGrievance", "Grievance")",
                method: "POST",
            datatype: "json",
            data: { "sGrievanceid": ID },
            success: function (objResultData) {
                alert(objResultData.Message);
                loadContent('/Grievance/AssignGrievancetoMembers')
            }, error: function (error) {
                alert('Internal Server Error');
            }
        });
    }
    }


    SelectOrUnselect = function () {

        if (AllchkID.checked == true) {
            $('#Assigntable tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", true);
                });
            });
        }
        else {
            $('#Assigntable tbody tr').each(function () {
                $(this).find('input[type="checkbox"]').each(function () {
                    $('input[type="checkbox"]').attr("checked", false);
                });
            });
        }
    }

</script>

