<script>
    $('#grievancetype').on('change', function () {

        var grievancetypeid = $(this).find('option:selected').val();
        if (grievancetypeid == 0) {
            loadContent('/Grievance/ListGrievance')
        }
        else {
            $.ajax({
                url: "@Url.Action("Bindgrievancelist", "Grievance")",
                method: "POST",
                type: "json",
                data: { "grievancetypeid": grievancetypeid },
                success: function (data) {

                    $('#loaddiv').empty();
                    $('#loaddiv').html(data);
                    $('#paginationdiv').easyPaginate({
                        paginateElement: 'li',
                        elementsPerPage: 10,
                        prevButton: true,
                        prevButtonText: 'Pre',
                        nextButton: true,
                        nextButtonText: 'Next'
                    });

                },
                error: function () {

                }

            })
        }
    });
    function Viewattachment(ID) {
        $.ajax({
            url: '/Grievance/FetchAttachmentById',
            method: 'POST',
            type: 'json',
            data: { sGrievanceid: ID },
            success: function (result) {
                $('#load').empty();
                $('#load').html(result);
            },
            error: function () {


            }
        })
        $('#ViewAttachment').modal();
    }

</script>




