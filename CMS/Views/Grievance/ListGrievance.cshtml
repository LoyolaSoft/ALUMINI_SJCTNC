@model CMS.ViewModel.ViewModel.GrievanceViewModel

@{
    ViewBag.Title = "ListGrievance";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Grievance</li>
    </ol>
    <h1 class="page-header">List Grievance</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Grievance</h4>
        </div>
        <div class="panel-body noPadding" id="maindiv">
            <div class="form-horizontal">

                <div class="col-md-12">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label("Select Grievance Type", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-6">
                                @Html.DropDownListFor(model => model.GrievanceType, (Model.GrievanceType != null) ? Model.GrievanceType : Enumerable.Empty<SelectListItem>(), "-- Select All--", new { @class = "selectpicker form-control input-sm", @data_live_search = "true", @id = "grievancetype" })
                                @Html.ValidationMessageFor(model => model.GrievanceType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12" id="loaddiv">
                    <ul id="paginationdiv" style="list-style:none">
                        @if (Model.liGrievanceandredrassalinfo != null)
                        {
                            foreach (var item in Model.liGrievanceandredrassalinfo)
                            {
                                <li class="list">
                                    <div class="panel panel-primary">
                                        <div class="panel-heading">@item.GRIEVANCE_TYPE_NAME</div>
                                        <div class="panel-body">
                                            <strong><span style="color:dodgerblue">Grievance Details</span></strong>
                                            <div class="col-md-12">
                                                <div class="col-md-4"><span class="user-image online"><img src="@item.STU_PHOTO" alt="Sender img" height="80" width="80"></span><br><span><b>Sender Name:</b>&nbsp;@item.SENDER_NAME</span></div>
                                                <div class="col-md-4 col-md-offset-4"><a href="javascript:Viewattachment(@item.GRIEVANCE_ID)" title="View" style="text-decoration:none"><span>Attachment:</span> <i class="glyphicon glyphicon-eye-open"></i></a><br><span><b>Submission Date&Time:</b>&nbsp;@item.SUB_DATE_TIME</span></div><br>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="col-md-12">
                                                    <b>Subject&nbsp;</b><br><span>@item.GRIEVANCE_SUBJECT</span><br /><br />
                                                    <b>Content</b>&nbsp;<br><span class="bind">
                                                        @(new HtmlString(item.GRIEVANCE_CONTENT))
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="panel-body" style="background-color:whitesmoke">
                                            <strong><span style="color:dodgerblue">Reply From Admin</span></strong><br>
                                            <div class="col-md-12">
                                                <div class="col-md-4">
                                                    <span class="user-image online"><img src="@item.STAFF_PHOTO" alt="Replier img" height="80" width="80"></span><br><span><b>Replier Name:&nbsp;</b></span>
                                                    @if (!string.IsNullOrEmpty(item.FIRST_NAME))
                                                    {
                                                        <span>@item.FIRST_NAME</span>
                                                    }
                                                    else
                                                    {
                                                        <span><b>Not Yet Assigned</b></span>
                                                    }
                                                </div>
                                                <div class="col-md-4 col-md-offset-4">
                                                    <a href="javascript:Viewattachment(@item.GRIEVANCE_ID)" title="View" style="text-decoration:none"><span>Attachment:</span> <i class="glyphicon glyphicon-eye-open"></i></a><br>
                                                    <span><b>Reply Date:&nbsp;</b></span>
                                                    @if (!string.IsNullOrEmpty(item.REPLY_DATE_TIME))
                                                    {
                                                        <span>@item.REPLY_DATE_TIME</span>
                                                    }
                                                    else
                                                    {
                                                        <span><b>No Reply</b></span>
                                                    }                                                   
                                                </div>
                                            </div>
                                                                                 
                                            <div class="col-md-12">
                                                <div class="col-md-12">
                                                    <br>
                                                    <span><b>Replied Message</b>&nbsp;</span><br>
                                                    @if (!string.IsNullOrEmpty(item.REDRESSAL_CONTENT))
                                                    {
                                                        <span class="bindred">@(new HtmlString(item.REDRESSAL_CONTENT))</span>
                                                    }
                                                    else
                                                    {
                                                        <span><b>No Reply</b></span>
                                                    }
                                                </div>
                                            </div>
                                            <br>
                                        </div>
                                    </div>

                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="ViewAttachment">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Attachment</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="">
                        <div class="" id="load">
                            @*<img src="~/Attachment/file1.png">*@
                        </div><br>
                    </div>
                </div>

            </div>

            @*<div class="modal-footer">
                    <a href="#" onclick=";" class="btn btn-sm btn-primary" data-dismiss="modal" id="btnSave">Save</a>
                    <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                </div>*@
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/js/jquery.easyPaginate.js"></script>
