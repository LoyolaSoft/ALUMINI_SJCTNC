@model CMS.ViewModel.ViewModel.GrievanceViewModel

<ul id="paginationdiv" style="list-style:none">
    @if (Model.liGrievanceandredrassalinfo != null)
    {
        foreach (var item in Model.liGrievanceandredrassalinfo)
        {
            <li>
                <div class="panel panel-primary">
                    <div class="panel-heading">@item.GRIEVANCE_TYPE_NAME</div>
                    <div class="panel-body">
                        <strong><span style="color:dodgerblue">Grievance Details</span></strong>
                        <div class="col-md-12">
                            <div class="col-md-4"><span class="user-image online"><img src="@item.STU_PHOTO" alt="Sender img" height="80" width="80"></span><br><span><b>Sender Name:</b>&nbsp;@item.SENDER_NAME</span></div>
                            <div class="col-md-4 col-md-offset-4"><a href="javascript:Viewattachment(@item.GRIEVANCE_ID)" title="View" style="text-decoration:none"><span>Attachment:</span> <i class="glyphicon glyphicon-eye-open"></i></a><br><span><b>Submission Date&Time:</b>&nbsp;@item.SUB_DATE_TIME</span></div><br>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-12">
                                <b>Subject&nbsp;</b><br><span>@item.GRIEVANCE_SUBJECT</span><br><br>
                                <b>Content&nbsp;</b><br><span>@(new HtmlString(item.GRIEVANCE_CONTENT))</span>
                            </div>
                        </div>
                    </div>
                    <div class="panel-body" style="background-color:whitesmoke">
                        <strong><span style="color:dodgerblue">Reply From Admin</span></strong><br>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <span class="user-image online"><img src="@item.STAFF_PHOTO" alt="Replier img" height="80" width="80"></span><br><span><b>Replier Name:&nbsp;</b></span>
                                @if (!string.IsNullOrEmpty(item.FIRST_NAME))
                                {
                                    <span>@item.FIRST_NAME</span>
                                }
                                else
                                {
                                    <span><b>Not Yet Assigned</b></span>
                                }
                            </div>
                            <div class="col-md-4 col-md-offset-4">
                                <a href="javascript:Viewattachment(@item.GRIEVANCE_ID)" title="View" style="text-decoration:none"><span>Attachment:</span> <i class="glyphicon glyphicon-eye-open"></i></a><br>
                                <span><b>Reply Date:&nbsp;</b></span>
                                @if (!string.IsNullOrEmpty(item.REPLY_DATE_TIME))
                                {
                                    <span>@item.REPLY_DATE_TIME</span>
                                }
                                else
                                {
                                    <span><b>No Reply</b></span>
                                }
                            </div>
                        </div>
                      
                        <div class="col-md-12">
                            <div class="col-md-12">
                                <br>
                                <span><b>Replied Message&nbsp;</b></span><br>
                                @if (!string.IsNullOrEmpty(item.REDRESSAL_CONTENT))
                                {
                                    <span>@(new HtmlString(item.REDRESSAL_CONTENT))</span>
                                }
                                else
                                {
                                    <span><b>No Reply</b></span>
                                }
                            </div>
                        </div>
                        <br>


                    </div>
                </div>



            </li>
        }
    }
</ul>






