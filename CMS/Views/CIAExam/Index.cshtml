
@model CMS.ViewModel.ViewModel.AccountViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE | Login</title>
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="~/Content/assets/plugins/jquery/jquery-1.9.1.min.js" />
    <link rel="stylesheet" href="~/Content/assets/plugins/bootstrap/css/bootstrap.min.css" />
    <style>
        .wrapper {
            display: flex;
            align-items: center;
            flex-direction: column;
            justify-content: center;
            width: 100%;
            min-height: 100%;
            padding: 20px;
        }

        #formContent {
            margin-top: 130px;
            -webkit-border-radius: 10px 10px 10px 10px;
            border-radius: 10px 10px 10px 10px;
            background: #fff;
            padding: 30px;
            width: 90%;
            max-width: 450px;
            position: relative;
            -webkit-box-shadow: 0 30px 60px 0 rgba(0,0,0,0.3);
            box-shadow: 0 30px 60px 0 rgba(0,0,0,0.3);
            text-align: center;
        }

        #formFooter {
            background-color: #f6f6f6;
            border-top: 1px solid #dce8f1;
            padding: 25px;
            text-align: center;
            -webkit-border-radius: 0 0 10px 10px;
            border-radius: 0 0 10px 10px;
        }
    </style>
</head>


<body class="">

    <div class="wrapper">
        <div id="formContent">
            <form action="@Url.Action("Login", "CIAExam")" method="post">
                <img src="@Url.Content(Model.liCollegeDetails.FirstOrDefault().COLLEGE_LOGO)" height="80" width="80" data-id="login-cover-image" alt="" />
                <div class="form-group m-b-15">
                    @Html.EditorFor(model => model.objLoginViewModel.Username, new { htmlAttributes = new { @class = "form-control ", placeholder = "Username" } })
                    @Html.ValidationMessageFor(model => model.objLoginViewModel.Username, "", new { @class = "text-danger" })
                    @*<input type="text" id="txtUsername" ng-model="txtUsername" class="form-control input-lg" placeholder="Username" required autofocus />*@
                </div>
                <div class="form-group m-b-15">
                    @Html.EditorFor(model => model.objLoginViewModel.Password, new { htmlAttributes = new { @class = "form-control", placeholder = "Password" } })
                    @Html.ValidationMessageFor(model => model.objLoginViewModel.Password, "", new { @class = "text-danger" })
                    @*<input type="password" class="form-control input-lg" placeholder="Password" id="txtPassword" ng-model="txtPassword" required />*@
                </div>

                <button type="submit" id="btnLogin" class="btn btn-primary btn-block btn-lg">Sign me in</button>
                <div class="m-t-20 m-b-40 p-b-40 text-inverse">
                    <a href="#Forgot-dialog" data-toggle="modal">Forgot password?</a>
                </div>
                <hr />
                <p class="text-center">
                    &copy; @DateTime.Today.Year   All Rights Reserved by @Model.liCollegeDetails.FirstOrDefault().COLLEGE_CODE
                </p>
            </form>

        </div>
    </div>

    
    <!-- Hidden Filed -->
    <input type="hidden" id="sUserName" />
    <input type="hidden" id="sAcountId" />
    <input type="hidden" id="sUserId" />
    <input type="hidden" id="sMailId" />
    <input type="hidden" id="sMobileNo" />
    <input type="hidden" id="sOTPString" />
    <!-- Hidden Filed -->

    <!-- Start Modal -->
    <div class="modal" id="Forgot-dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                    <h4 class="modal-title"> Forgot Password </h4>
                </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        <div id="dvFiled">
                            <div class="form-group">
                                @Html.Label("User Name", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" id="USERNAME" placeholder="Enter Your UserName" />
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Date Of Birth", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" id="DATE_OF_BIRTH" placeholder="dd/mm/yyyy" />
                                </div>
                            </div>
                        </div>

                        <div class="hidden" id="dvSend">
                            <div class="form-group">
                                <div class="col-md-2">

                                </div>
                                <div class="col-md-9">
                                    <h4>Select how you'd like to change your password.</h4>
                                    <h5>We'll send a verification code to your preferred method.</h5>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-2">

                                </div>
                                <div class="col-md-9">
                                    <div class="radio radio-css radio-primary">
                                        <input type="radio" name="cssRadio" id="cssRadioMail" value="1" />
                                        <label for="cssRadioMail"> Send me an email <span class="dvMail"></span></label>
                                    </div>

                                    <div class="radio radio-css radio-success">
                                        <input type="radio" name="cssRadio" id="cssRadioMobile" value="2" />
                                        <label for="cssRadioMobile"> Text my phone number ending in <span class="dvNumber"></span></label>
                                    </div>



                                </div>

                            </div>
                        </div>

                        <div class="form-group hidden" id="dvOTP">
                            @Html.Label("Please enter the OTP", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <input id="sOTP" type="text" class="form-control" maxlength="6" />
                            </div>
                        </div>

                        <div id="dvResetPassword" class="hidden">
                            <div class="form-group">
                                @Html.Label("New Password", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="password" class="form-control input-sm" id="txtNewPassword" placeholder="Enter Your New Password" />
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Confrim Password", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <input type="password" class="form-control input-sm" id="txtConfrimPassword" placeholder="Enter Your Confrim Password" />
                                </div>
                            </div>


                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <a id="btnNext" href="javascript:;" onclick="Validate()" class="btn btn-primary">Next</a>
                    <a id="btnSend" href="javascript:;" onclick="Send()" class="btn btn-primary hidden">Send</a>
                    <a id="btnVerify" href="javascript:;" onclick="VerifyOTP()" class="btn btn-primary hidden">Verify</a>
                    <a id="btnSubmit" href="javascript:;" onclick="ForgotSubmit()" class="btn btn-primary hidden" data-dismiss="modal">Submit</a>
                    <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
                </div>
            </div>
        </div>
    </div>
    <!-- End Modal-->

    <script type="text/javascript" src="~/Content/assets/plugins/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/Content/assets/plugins/bootstrap/js/bootstrap.min.js"></script>

    <script>
        $(document).ready(function (e) {

            //$('#btnLogin').click(function (e)
            //{
            //    var un=$('#Username').val();
            //    var pw = $('#Password').val();
            //    if (un=="" && pw=="")
            //    {
            //        e.preventDefault();
            //    } else
            //    {
            //        myfunction('Please wait...');
            //    }
            //});

            myfunction('@TempData["ErrorMessage"]');
        });
        function myfunction(e) {
            if (e != '')
            {
                alert(e);
            }

        }

    </script>

    <script>
    function Validate()
    {
        if ($('#USERNAME').val() && $('#DATE_OF_BIRTH').val())
        {
            $.ajax({
                url:'@Url.Action("ValidateForgotPassword", "Account")',
                method:'POST',
                datatype: 'json',
                data: { sUsername: $('#USERNAME').val(), sDOB: $('#DATE_OF_BIRTH').val() },
                success: function (data)
                {
                    if (data.ErrorCode != null && data.ErrorCode != '')
                    {
                        alert("Sorry ! No Matches Found .!");
                    } else
                    {
                        $('#dvResetPassword').removeClass('hidden');
                        $('#btnSubmit').removeClass('hidden');

                        $('#btnSend').addClass('hidden');
                        $('#btnNext').addClass('hidden');
                        $('#dvSend').addClass('hidden');
                        $('#dvFiled').addClass('hidden');


                        $('#sUserName').val(data[0].USERNAME);
                        $('#sAcountId').val(data[0].USER_ACCOUNT_ID);
                        $('#sUserId').val(data[0].USER_ID);
                        $('#sMailId').val(data[0].EMAIL);
                        $('#sMobileNo').val(data[0].MOBILE);

                        $('.dvMail').text(data[0].EMAIL);
                        $('.dvNumber').text('xxxxx' + data[0].MOBILE.substring(6,11));
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    }

        function Send()
        {
            var sUrl = null;
            if ($('#cssRadioMail').is(':checked'))
            {
                sUrl = '/Account/SendMail';
            } else if ($('#cssRadioMobile').is(':checked'))
            {
                sUrl = '/Account/SendSMS';
            } else if ($('#cssRadioCall').is(':checked'))
            {
                sUrl = '/Account/VoiceCall';
            } else
            {
                alert('Please Select Any Options To Continue .!');
                return false;
            }
            //alert($('#sUserId').val());
            $.ajax({
                url: sUrl,
                method: 'POST',
                datatype: 'json',
                data: { sMobileNo: $('#sMobileNo').val(), sMailId: $('#sMailId').val(), sStudentId: $('#sUserId').val() },
                success: function (data)
                {
                    alert(data.Message);
                    if (data.ErrorCode ==  "200")
                    {
                        $('#sOTPString').val(data.sResult);
                        $('#btnVerify').removeClass('hidden');
                        $('#btnSend').addClass('hidden');

                        $('#dvSend').addClass('hidden');
                        $('#dvOTP').removeClass('hidden');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }

    function VerifyOTP()
    {
        $('#dvFiled').addClass('hidden');
        $('#dvSend').addClass('hidden');
        $('#dvOTP').addClass('hidden');
        $('#dvResetPassword').removeClass('hidden');
        $('#btnSubmit').removeClass('hidden');
        $('#dvFiled').addClass('hidden');
        $('#btnVerify').addClass('hidden');
        $('#btnSend').addClass('hidden');
    }

        $('#Forgot-dialog').on('hidden.bs.modal', function ()
        {
            $('#dvOTP').addClass('hidden');
            $('#dvSend').addClass('hidden');
            $('#dvResetPassword').addClass('hidden');
            $('#dvFiled').removeClass('hidden');
            $('#btnVerify').addClass('hidden');
            $('#btnSend').addClass('hidden');
            $('#btnSubmit').addClass('hidden');

            $('#btnNext').removeClass('hidden');
            $('#USERNAME').val('');
            $('#DATE_OF_BIRTH').val('');
            $('#sOTP').val('');
            if ($('#cssRadioMail').is(':checked'))
            {
                $('#cssRadioMail').attr('checked',false);
            } else if ($('#cssRadioMobile').is(':checked'))
            {
                $('#cssRadioMobile').attr('checked', false);
            } else if ($('#cssRadioCall').is(':checked'))
            {
                $('#cssRadioCall').attr('checked', false);
            }
           // window.location.href = "/Account/Index";
        });
    </script>

    <script>
        function ForgotSubmit()
        {
            if ($('#txtNewPassword').val() && $('#txtConfrimPassword').val())
            {
                if ($('#txtNewPassword').val() == $('#txtConfrimPassword').val())
                {
                    var Password = $('#txtNewPassword').val();
                    var ConfirmPassword = $('#txtConfrimPassword').val();
                    var JsonData;
                    JsonData = '{"PASSWORD":"' + Password + '","CONFIRM_PASSWORD":"' + ConfirmPassword + '","USERNAME":"' + $('#sUserName').val() + '"}';

                    $.ajax({
                        url: '@Url.Action("SaveChangePassword", "Account")',
                        method: 'POST',
                        datatype: 'json',
                        data: { ChangePassword: JsonData },
                        success: function (data)
                        {
                            alert(data);
                        }, error: function (error) {
                            alert('Internal Server Error !');
                        }
                    });
                } else
                {
                    alert('Password and confirm password are not match !');
                }
            } else
            {
                alert('Please enter valied password to continue!');
            }
        }
    </script>
</body>
</html>
