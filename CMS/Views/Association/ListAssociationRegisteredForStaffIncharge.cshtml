@model CMS.ViewModel.ViewModel.AssociationViewModel
@{
    ViewBag.Title = "ListAssociationRegisteredForStaffIncharge";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Association Registraion</li>
    </ol>
    <h1 class="page-header">Association Registraion</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Association Registraion</h4>
        </div>
        <div class="panel-body noPadding">

            <br />
            @{ int count = 0;}
            <div class="table-responsive col-md-12" id="dvPrint">
                <table class="table table-bordered table-hover" id="tblAssociationRegistration">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Roll No
                            </th>
                            <th>
                                Class
                            </th>
                            <th>
                                Course
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liAssociationRegistration != null)
                        {
                            foreach (var item in Model.liAssociationRegistration)
                            {
                                <tr>
                                    <td>
                                        @{ count++;}
                                        @count
                                    </td>
                                    <td>
                                        @item.FIRST_NAME
                                    </td>
                                    <td>
                                        @item.ROLL_NO
                                    </td>
                                    <td>
                                        @item.CLASS_NAME
                                    </td>
                                    <td>
                                        @item.ASSOCIATION_GROUP
                                    </td>


                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-md-1 pull-right">
                <button class="btn btn-primary pull-right" onclick="printDiv()" id="btnPrint"> Print </button>
            </div>

        </div>
    </div>
</div>




<script>
    ContentLoad = function () {
        
    }
  
    //$("#tblAssociationRegistration").DataTable();


    function printDiv() {

        //$('#btnPrint').addClass("hidden");
        //$('#btnExport').addClass("hidden");


        var printContents = document.getElementById('dvPrint').innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
    }

</script>



