
@model CMS.ViewModel.ViewModel.AssociationViewModel

@{

    Layout = null;
}
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Assocation Registered List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Assocation Registered List<small></small></h1>
    <!-- end page-header -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="panel panel-primary">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                    </div>
                    <h4 class="panel-title">Assocation Registered List</h4>
                </div>
                <div class="panel-body">
                    <div class="col-md-12 form-horizontal">
                        <div class="col-md-4 form-group">
                            @Html.Label("Year", htmlAttributes: new { @class = "col-md-4 control-label" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AcademicYearList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.Label("Course", htmlAttributes: new { @class = "col-md-4 control-label " })
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.AssociationGroup, (Model.AssociationGroup != null) ? Model.AssociationGroup : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "form-control    selectpicker show-menu-arrow show-tick", @data_live_search = "true" })
                                @Html.ValidationMessageFor(m => m.AssociationGroup, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-1">
                            <a href="#" class="btn btn-primary" id="btnget">Get</a>
                        </div>


                    </div>

                    <div class="col-md-12">
                        <div id="dvBind">

                        </div>
                    </div>

                </div>

            </div>
        </div>
    }

</div>
<input id="txtRegistrationId" value="" type="hidden" />
<div class="modal" id="Registration-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit Student Registration</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">

                <div class="form-group">
                    <div class="form-horizontal">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group">
                                @Html.LabelFor(model => model.AcademicYearList, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AcademicYearList, (Model.AcademicYearList != null) ? Model.AcademicYearList : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker form-control input-sm", @data_live_search = "true", @data_parsley_required = "true", @id = "ddlacyear" })
                                    @Html.ValidationMessageFor(model => model.AcademicYearList, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Class, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.Class, (Model.Class != null) ? Model.Class : Enumerable.Empty<SelectListItem>(), new { @class = "selectpicker form-control input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                    @Html.ValidationMessageFor(model => model.Class, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="form-group">
                                <label for="Student_Name" class="control-label col-md-3">Select Student</label>

                                <div class="col-md-9">

                                    <select class="form-control selectpicker input-sm" id="StudentList" data_live_search="true"></select>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.AssociationGroup, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.AssociationGroup, (Model.AssociationGroup != null) ? Model.AssociationGroup : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true", @data_parsley_required = "true", @id = "ddlgroups" })
                                    @Html.ValidationMessageFor(model => model.AssociationGroup, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>


<script>
    function ContentLoad()
    {
        // Document Ready Function ...
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
        }

    $("#tblAssociationRegistration").DataTable({ dom: "lBfrtip", buttons: [{ extend: "copy", className: "btn-sm" }, { extend: "excel", className: "btn-sm" }, { extend: "print", className: "btn-sm" }], responsive: !0, });

    //Academic year
    $('#AcademicYearList').on('change', function ()
    {

        if ($('#AcademicYearList').val())
        {
            $.ajax({
                url: "@Url.Action("FetchAssocationgropus", "Association")",
                method: 'POST',
                datatype: 'json',
                data: { sAcyear: $('#AcademicYearList option:selected').text()},
                success: function (data)
                {
                    $('#AssociationGroup').empty();
                    $('#AssociationGroup').append('<option value="0" >---Select---</option>' + data.sResult);
                    $('.selectpicker').selectpicker('refresh');

                }, error: function (ex)
                {
                    swal({ title: "Error !", text:'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });

                }
            });
        }
        else
        {
            swal({ title: "Infromation !", text: 'Please Select Application Type...!', showConfirmButton: false, timer: 1500, type: 'info', animation: true });
        }
    });

    $('#ddlacyear').on('change', function ()
    {

        if ($('#ddlacyear').val())
     {
         $.ajax({
             url: "@Url.Action("FetchAssocationgropus", "Association")",
             method: 'POST',
             datatype: 'json',
             data: { sAcyear: $('#ddlacyear option:selected').text()},
             success: function (data)
             {
                 $('#ddlgroups').empty();
                 $('#ddlgroups').append('<option value="0" >---Select---</option>' + data.sResult);
                 $('.selectpicker').selectpicker('refresh');

             }, error: function (ex)
             {
                 swal({ title: "Error !", text:'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });

             }
         });
     }
     else
     {
         swal({ title: "Infromation !", text: 'Please Select Application Type...!', showConfirmButton: false, timer: 1500, type: 'info', animation: true });
     }
 });

    $("#btnget").on("click", function ()
    {

            $.ajax({
                url: "@Url.Action("ListAssociationRegistered", "Association")",
                method: "POST",
                datatype: "json",
                data: { sAcyear: $('#AcademicYearList option:selected').text(), sCourseId: $("#AssociationGroup").val()},
            success: function (data)
            {
                $('#dvBind').empty();
                $('#dvBind').append(data);
                $("#tblAssociationRegistration").DataTable({ dom: "lBfrtip", buttons: [{ extend: "copy", className: "btn-sm" }, { extend: "excel", className: "btn-sm" }, { extend: "print", className: "btn-sm" }], responsive: !0, });

            }, error: function (error)
            {

                swal({ title: "Error !", text: 'Internal Server Error !', showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });

    });
</script>

<script>
    function DeleteRegistration(ID)
    {
        if (!confirm('Are you sure to delete ?')) {
            return false;
        }
        else
        {
            $.ajax({
                url: "@Url.Action("DeleteRegistration", "Association")",
                method: "POST",
            datatype: "json",
            data: { sRegistrationId: ID },
            success: function (data) {
                if(data.ErrorCode =="200")
                {
                    //swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                    alert(data.Message);
                    //$('#SettingList option[value="' + SettingId + '"]').trigger("change");
                    // loadContent('/Association/AssociationRegisteredList');
                    $("#btnget").click();
                }
                if (data.ErrorCode == "417") {
                    //swal({ title: "Failed !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'error', animation: true });
                    alert(data.Message);
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
     }
    }
    function FetchRegistration(ID) {
        $.ajax({
            url: '@Url.Action("FetchStudentRegistration", "Association")',
            method: 'POST',
            datatype: 'json',
            data: { sRegistrationId: ID },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    alert(data.Message);
                } else
                {

                    $('#ddlacyear option[value="' + data[0].AC_YEAR + '"]').prop("selected", true);
                    $('#Class option[value="' + data[0].CLASS_ID + '"]').prop("selected", true);

                    $('#Class').trigger("change");

                    $('#StudentList option[value="' + data[0].STUDENT_ID + '"]').prop("selected", true);
                    $('#ddlgroups option[value="' + data[0].COURSE_ID + '"]').prop("selected", true);

                    $('#txtRegistrationId').val(data[0].REGISTRATION_ID);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    }

    $('#Class').on('change', function () {
        $.ajax({
            url: '@Url.Action("FetchStudentByClassId", "CertificateCourse")',
            method: 'POST',
            datatype: 'json',
            async: false,
            data: { sClassId: $('#Class').val() },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    alert(data.Message);
                } else {
                    //$('#Course').empty();
                    //$('#Course').append('<option value=""> -- Select -- </option>' + data.ErrorCode);
                    $('#StudentList').empty();
                    $('#StudentList').append('<option value=""> -- Select -- </option>' + data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }

            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });

        $.ajax({
            url: '@Url.Action("FetchAssociationGroupsByClassId", "Association")',
            method: 'POST',
            datatype: 'json',
            async: false,
            data: { sClassId: $('#Class').val()},
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    alert(data.Message);
                } else {
                    //$('#Course').empty();
                    //$('#Course').append('<option value=""> -- Select -- </option>' + data.ErrorCode);
                    $('#AssociationGroup').empty();
                    $('#AssociationGroup').append('<option value=""> -- Select -- </option>' + data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }

            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });

    });


  


    $('#btnAdd').click(function () {
        $('#ddlacyear option[value=""]').prop("selected", true);
        $('#Class option[value=""]').prop("selected", true);
        $('#StudentList option[value=""]').prop("selected", true);
        $('#ddlgroups option[value=""]').prop("selected", true);

        $('#txtRegistrationId').val('');
        $('.selectpicker').selectpicker('refresh');
    });
</script>

