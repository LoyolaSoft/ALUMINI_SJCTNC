@model CMS.ViewModel.ViewModel.AssociationViewModel

@{
    ViewBag.Title = "ListAssociationGroupSetting";
    Layout = null;
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Association Group Setting</li>
    </ol>
    <h1 class="page-header">Association Group Setting</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Association Group Setting</h4>
        </div>
        <div class="panel-body noPadding">

            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#Assocation-dialog" data-toggle="modal"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <br />
            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-bordered table-hover" id="tblAssociationSetting">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Setting Name
                            </th>
                            <th>
                                Date From
                            </th>
                            <th>
                                Date To
                            </th>
                            <th>
                                Semester
                            </th>
                            <th>
                                Active
                            </th>
                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liAssociationSetting != null)
                        {
                            foreach (var item in Model.liAssociationSetting)
                            {
                                <tr>
                                    <td>
                                        @{ count++;}
                                        @count
                                    </td>
                                    <td>
                                        @item.SETTING_NAME
                                    </td>
                                    <td>
                                        @item.DATE_FROM
                                    </td>
                                    <td>
                                        @item.DATE_TO
                                    </td>
                                    <td>
                                        @item.SEMESTER_TYPE
                                    </td>
                                    <td>
                                        @if (item.IS_ACTIVE == "0")
                                        {
                                            <label onclick="ActiveRegistration(@item.ASSOCIATION_GROUP_SETTING_ID,1);"><small>close</small></label>
                                        }
                                        else
                                        {
                                            <label onclick="ActiveRegistration(@item.ASSOCIATION_GROUP_SETTING_ID,0);"><small>OPEN</small></label>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="#Assocation-dialog" onclick="FetchCertificationCourseSettingById('@item.ASSOCIATION_GROUP_SETTING_ID')" data-toggle="modal"><i class="fa fa-edit text-primary" title="Click to Update"></i></a>
                                        }
                                        <a href="javascript:;" onclick="DeleteSetting(@item.ASSOCIATION_GROUP_SETTING_ID)"><i class="fa fa-trash text-danger" title="Click to Delete"></i></a>
                                    </td>
                                </tr>
                                                }
                                            }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    ContentLoad = function () 
    {
        handleDatepicker();
    }

    handleDatepicker = function () 
    {
        "use strict";
        $("#txtDateFrom,#txtDateTo").datepicker({
            todayHighlight: true,
            autoclose: true,
           // endDate: new Date(),
            format: "dd/mm/yyyy",
            orientation: "right bottom"
        })
    }

    $("#tblAssociationSetting").DataTable();

    $('#btnSubmit').on('click',function () 
    {
        var sJsonData='{"ASSOCIATION_GROUP_SETTING_ID":"",\
                        "SETTING_NAME":"' + $('#txtSettingName').val() + '",\
                        "DATE_FROM":"' + $('#txtDateFrom').val() + '",\
                        "DATE_TO":"' + $('#txtDateTo').val() + '",\
                        "SEMESTER_ID":"' + $('#SemesterType').val() + '"}';
    });
    function FetchCertificationCourseSettingById(CCSettingId) {
     

        if (CCSettingId != null) {
            $.ajax({
                url: "/Association/FetchAssociationGroupSettingsById",
                type: "post",
                data: { sSettingsId: CCSettingId },
                success: function (data) {
                    if (data.Message != null) {
                        alert(data.Message);
                    }
                    else {
                        if (data.oResult[0] != null) {

                            $('#txtSettingName').attr('value', data.oResult[0].SETTING_NAME);
                            $('#txtDateFrom').attr('value', data.oResult[0].DATE_FROM);
                            $('#txtDateTo').attr('value', data.oResult[0].DATE_TO);
                            //$('#QuestionTypeList option[value="' + data.oResult[0].QUESTION_TYPE_ID + '"]').attr("selected", "selected");
                            //$('#txtNoOfQuestion').attr('value', data.oResult[0].NO_OF_QUESTION);
                            $('#SemesterType option[value="' + data.oResult[0].SEMESTER_TYPE_ID + '"]').attr("selected", "selected");
                            $('#txtSettingId').attr('value', data.oResult[0].SETTING_ID);
                            $('.selectpicker').selectpicker('refresh');
                        }


                    }

                },
                error: function (ex) {
                    alert(ex.Message);
                }
            });
        }
    }
    $('#btnSubmit').click(function () {

       

        var SettingId = $('#txtSettingId').val();
        var Settingname = $('#txtSettingName').val();
        var DateFrom = $('#txtDateFrom').val();
        var DateTo = $('#txtDateTo').val();
        var SemsesterType = $('#SemesterType').val();


        var jsonData = '{"ASSOCIATION_GROUP_SETTING_ID":"' + SettingId + '","SETTING_NAME":"' + Settingname + '","DATE_FROM":"' + DateFrom + '","DATE_TO":"' + DateTo + '","SEMESTER_TYPE_ID":"' + SemsesterType + '"}';
        var req = $.ajax({
            url: "/Association/SaveOrUpdateGroupSetting",
            type: "post",
            data: { sJson: jsonData },
            success: function (data) {
                if (data.Message != null && data.Message != "") {
                    if (data.ErrorCode == "200") {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                        loadContent('/Association/ListAssociationGroupSetting');
                    }
                    if (data.ErrorCode == "417") {
                        swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    }
                    if (data.ErrorCode == "503") {
                        swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                    }


                }
            },
            error: function (ex) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }

        });
    });
    function ActiveRegistration(SettingId, Mode) {
        swal({
            title: "Are you sure want to Activate/Deactivate?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },
            function () {
                $.ajax({
                    url: "/Association/ActiveRegistration",
                    type: "post",
                    data: { sSettingsId: SettingId, sMode: Mode },
                    success: function (data) {


                        if (data.ErrorCode == "200") {
                            swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                            loadContent('/Association/ListAssociationGroupSetting');
                        }
                        if (data.ErrorCode == "417") {
                            swal({ title: "Error", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                        }
                        if (data.ErrorCode == "503") {
                            swal({ title: "Info", text: data.Message, showConfirmButton: false, timer: 1500, type: 'info', animation: true });
                        }
                    },
                    error: function (ex) {
                        swal({ title: "Error !", text: ex.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });

                    }

                });
            });

    }
    $('#Add').click(function () {

        $('#pBody').parsley().destroy();

        $('#txtSettingName').attr('value', '');
        $('#txtDateFrom').attr('value', '');
        $('#txtDateTo').attr('value', '');
        //$('#QuestionTypeList option[value=""]').attr("selected", "selected");

        $('#SemesterType option[value=""]').attr("selected", "selected");
        $('#txtSettingId').attr('value', '');
        $('.selectpicker').selectpicker('refresh');


    });
</script>


<div class="modal" id="Assocation-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <input type="hidden" id="hdRoomId" />
                            <div class="form-group">
                                <label class="control-label col-md-3">Setting Name</label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control input-sm" id="txtSettingName" placeholder="Enter Setting Name" />
                                    <input type="hidden" class="form-control input-sm" id="txtSettingId" placeholder="Enter Setting Name" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Date From</label>
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker1">
                                        <input type="text" id="txtDateFrom" class="form-control input-sm" placeholder="Select Date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <!-- Date To -->
                            <div class="form-group">
                                <label class="control-label col-md-3">Date To</label>
                                <div class="col-md-9">
                                    <div class="input-group date" id="datetimepicker2">
                                        <input type="text" id="txtDateTo" class="form-control input-sm" placeholder="Select Date" />
                                        <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Semester</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.SemesterType, (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
