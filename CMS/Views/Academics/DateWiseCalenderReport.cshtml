                <div class="form-group col-md-5">
                    @Html.LabelFor(model => model.AcademicYear, "Academic Year", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group col-md-5">
                    @Html.LabelFor(model => model.SemesterType, "Semester Type", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.SemesterType, (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control  input-sm", @data_live_search = "true" })
                        @Html.ValidationMessageFor(model => model.SemesterType, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-success btnPrint hidden" onclick="printDiv('dvReport')"> Print </button>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary btnExport hidden" onclick="Export()"> Export </button>
                </div>
                <div class="form-group col-md-1">
                    <a class="btn btn-primary" id="btnGet"> Get </a>
                </div>

                <div class="col-md-12" id="dvReport"></div>
