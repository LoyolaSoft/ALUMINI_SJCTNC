<script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker('refresh');
        handleDatepicker = function ()
        {
            "use strict";
            $("#txtFromDate,#txtToDate").datepicker({
                todayHighlight: true,
                autoclose: true,
                endDate: new Date(),
                format: "dd/mm/yyyy",
                orientation: "right bottom"
            });
        }
        handleDatepicker();

        $('#btnGet').on('click', function ()
        {
            bindDatewiseClaender();
        });
    function bindDatewiseClaender()
    {
                $.ajax({
                    url: '@Url.Action("BindDateWiseCalenderReport", "Academics")',
                    method: 'POST',
                    datatype: 'json',
                    data: { SemesterType: $('#SemesterType').val(), sAcademicYear: $('#AcademicYear option:selected').text() },
                    success: function (data) {
                        $('#dvReport').empty();
                        if (data.Message != null && data.Message != '') {
                            alert(data.Message);
                        } else {
                            $('#dvReport').append(data);
                            $('.table').DataTable({
                                dom: "lBfrtip", buttons: [{
                                    extend: "copy", className: "btn-sm"
                                }
                                    , {
                                    extend: "excel", className: "btn-sm"
                                }
                                    , {
                                    extend: "print", className: "btn-sm"
                                }
                                ], responsive: !0, "paging": false,
                            });
                        }
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            }


    //$('#btnPrint').on('click', function () {
    //    var printContents = document.getElementById('dvAttendanceReport').innerHTML;
    //    myWindow = window.open('', '', 'width=200,height=100');
    //    myWindow.document.write(printContents);
    //    myWindow.document.close(); //missing code
    //    myWindow.focus();
    //    myWindow.print();
    //});
    function printDiv(divName) {
        var table = $('#tbltpmReport').DataTable();
        table.destroy();
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        bindDatewiseClaender();
    }
    function Export() {
        var title = "";
        //var sSatff = $('#StaffListByDepartmet option:selected').text();
        title = "Calendar_Day_Order";
        let file = new Blob([$('#dvReport').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: title + ".xls"
        }).appendTo("body").get(0).click();
        //$('#btnGet').click();
        //loadContent('/attendance/AttendancePercentageCommon');
        //e.preventDefault();
        // loadContent('/IQAC/IQACDateWiseReportForIncharge');
    }
</script>





