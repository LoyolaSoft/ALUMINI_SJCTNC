<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $(document).ready(function(){
            EditCourseRootInfo = function () {
                var ID=@Session[Common.SESSION_VARIABLES.COURSE_ROOT_ID];
                $.ajax({
                    url:"@Url.Action("FetchCourseRootInfo","Academics")",
                    method:"POST",
                    datatype:"html",
                    data:{id:ID},
                    success:function(data){
                        $("#ddlDepartment").val(data.DEPARTMENT);
                        $("#txtYearfrom").val(data.YEAR_FROM);
                        $("#txtYearto").val(data.YEAR_TO);
                        $("#txtYear").val(data.YEAR);
                        //$("#ddlSemesterfrom").val(data.SEMESTER_FROM);
                        //$("#ddlSemesterto").val(data.SEMESTER_TO);
                        $("#ddlPart").val(data.PART);
                        $("#ddlCoursetype").val(data.COURSE_TYPE);
                        $("#txtHrsperweek").val(data.HRS_PER_WEEK);
                        $("#txtCredits").val(data.CREDITS);
                        //$("#ddlOptionname").val(data.OPTION_NAME);
                        $("#ddlPapercode").val(data.PAPER_CODE);
                        $("#txtCoursetitle").val(data.COURSE_TITLE);
                        $("#txtConsCoursetitle").val(data.CONS_COURSE_TITLE);
                        $("#txtCoursecode").val(data.COURSE_CODE);
                        $("#ddlSemester").val(data.SEMESTER);
                        $("#IS_NME_SUBJECT").val(data.IS_NME_SUBJECT);
                        $("#IS_ALLIED_SUBJECT").val(data.IS_ALLIED_SUBJECT);
                        $("#txtCourseorder").val(data.COURSE_ORDER);
                        $("#txtSubjects").val(data.SUBJECTS);
                        $("#IS_COMPULSORY_SUBJECT").val(data.IS_COMPULSORY_SUBJECT);
                        $("#ddlUGCCoursetype").val(data.UGC_COURSE_TYPE);
                        $("#ddlPaperType").val(data.PAPER_TYPE);
                        $("#ddlSubjectType").val(data.SUBJECT_TYPE);
                        $("#txtInternal").val(data.INTERNAL);
                        $("#txtExternal").val(data.EXTERNAL);
                        $("#txtTotal").val(data.TOTAL);
                        if ($("#IS_NME_SUBJECT").val()==1) {
                            $("#IS_NME_SUBJECT").prop( "checked", true );
                        }
                        else {
                            $("#IS_NME_SUBJECT").prop( "checked", false );
                        }
                        if ($("#IS_ALLIED_SUBJECT").val()==1) {
                            $("#IS_ALLIED_SUBJECT").prop( "checked", true );
                        }
                        else {
                            $("#IS_ALLIED_SUBJECT").prop( "checked", false );
                        }
                        if ($("#IS_COMPULSORY_SUBJECT").val()==1) {
                            $("#IS_COMPULSORY_SUBJECT").prop( "checked", true );
                        }
                        else {
                            $("#IS_COMPULSORY_SUBJECT").prop( "checked", false );
                        }
                        $('.selectpicker').selectpicker('refresh');
                    },error:function(error){
                        alert('No Data Found');
                    }
                });
            }
            EditCourseRootInfo();
        });
</script>
