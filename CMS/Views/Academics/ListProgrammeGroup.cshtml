@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "ListProgrammeGroup";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List ProgrammeGroup</li>
    </ol>
    <h1 class="page-header">List ProgrammeGroup</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List ProgrammeGroup</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#ProgrammeGroupModal" data-toggle="modal"><i class="fa fa-plus" title="Add/Edit"> Add/Edit</i></a>
            </div>
            <br />
            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-hover table-bordered" id="tblProgrammeMode">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Degree</th>
                            <th>Programme</th>
                            <th>Shift</th>
                            <th>Programme Mode</th>                        
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liProgrammeGroup != null && Model.liProgrammeGroup.Count > 0)
                        {
                            foreach (var item in Model.liProgrammeGroup)
                            {
                                <tr>
                                    <td>@{ count++;}@count</td>
                                    <td>@item.APPLICATION_TYPE</td>
                                    <td>@item.PROGRAMME_NAME</td>
                                    <td>@item.SHIFT_NAME</td>
                                    <td>@item.PROGRAMME_MODE</td>
                                    <td>                                        
                                        <a href="javascript:;" style="cursor:pointer" onclick="DeleteProgrammeGroupById(@item.PROGRAMME_GROUP_ID);"><i class="fa fa-trash text-danger" title="Click to Delete"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $("#tblProgrammeMode").DataTable();
        $('.selectpicker').selectpicker({
            size: 5
           
        });
        $('.selectpicker').selectpicker('refresh');
</script>
<script>
        // Delete .....
    function DeleteProgrammeGroup(ID) {
        if (!confirm('Are you sure to Delete ProgrammeGroup?')) {
            return false;
        }
        $.ajax({
            url: "@Url.Action("DeleteProgrammeGroup", "Academics")",
            method: "POST",
            datatype: "json",
            data: { sProgrammeGroupId: ID },
            success: function (data) {
                alert(data.Message);
                loadContent('/Academics/ListProgrammeGroup');
            }, error: function (error) {
                alert('Internal Server Error !');
            }
        });
    };
    $('#ProgrammeMode').change(function () {
        if ($("#Shift").val() == '' || $('#ProgrammeMode').val() == '' || $("#ApplicationType").val() == '') {
            alert('Please Select ApplicationType,Shift And Programme Mode...!!!');
            $("#ProgrammeMode").val($("#ProgrammeMode option:first").val());
            $('.selectpicker').selectpicker('refresh');
            return false;
        }
        $.ajax({
            url: "@Url.Action("LoadProgrammes", "Academics")",
            async: false,
            data: { sApplicationTypeId: $("#ApplicationType").val(), sShiftId: $("#Shift").val(), sProgrammeModeId: $('#ProgrammeMode').val(), },
        success: function (objResult) {
            $('#Programme').empty().append(objResult.sResult).selectpicker('refresh');
        },
        error: function (xhr, textStatus, error) {
            alert(error + "\n");
        }
    });

    });
        // Submit ProgrammeGroup
    $('#btnSubmit').click(function () {
        var vProgrammeId = String($('#Programme').val());
            var vProgrammeId = vProgrammeId.split(",");
            //if (SubHeadIds == '' || MainHeadId=='') {
            //    alert('Please provide valid inputs..!');
            //    return false;
            //}
            var jsonInput = '[';
            for (var i = 0; i < vProgrammeId.length; i++) {
                jsonInput += '{"APPTYPE_ID":"' + $("#ApplicationType").val() + '","SHIFT":"' + $("#Shift").val() + '","PROGRAMME_MODE":"' + $('#ProgrammeMode').val() + '","PROGRAMME_ID":"' + vProgrammeId[i] + '",},'
            }
            jsonInput = jsonInput.slice(0, -1);
            jsonInput = jsonInput + "]"
            $.ajax({
                url: "@Url.Action("SaveProgrammeGroup", "Academics")",
                async: false,
                method: "POST",
                data: { sJsonProgrammeGroup: jsonInput },
                success: function (objResult) {
                 alert(objResult.Message);                    
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        });

</script>


<div class="modal" id="ProgrammeGroupModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input type="hidden" id="hdApplicationType" />
                                <div class="form-group">
                                    @Html.Label("ApplicationType", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ApplicationType, (Model.ApplicationType != null) ? Model.ApplicationType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.ApplicationType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.Label("Programme Mode", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ProgrammeMode, (Model.ProgrammeMode != null) ? Model.ProgrammeMode : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.ProgrammeMode, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.Label("Programme", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true",multiple="multiple" })
                                        @Html.ValidationMessageFor(model => model.Programme, "", new { @class = "text-danger" })
                                    </div>
                                </div>                                
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>
