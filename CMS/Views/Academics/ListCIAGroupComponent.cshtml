                        </div>
                    </div>*@

                    <div class="form-group">
                        <label class="col-md-12">Order</label>
                        <div class="col-md-12">
                            @Html.EditorFor(model => model.ObjCourseTypeGroup.ORDER_ID, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Order", type = "number" ,id="OrderId", @data_parsley_required="true" } })
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" id="btnSubmitGroupTypeGroup" class="btn btn-default" data-dismiss="modal">Submit</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


