    // On Submit ....
    $('#btnSubmitGroupTypeGroup').on('click', function () {
        var isValid = true;
        if ($('#pBody').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }



        var JsonData = '[';
        $("#tblComponent tbody tr").each(function () {

                var group_id = $(this).find('input[type="text"]').attr('id');

                var cia_group_component_id = $(this).attr('cms-ca-group-id');

                var max_mark = $(this).find('input[name="max-mark"]').val();

                var min_mark = $(this).find('input[name="min-mark"]').val();

                var supComponent = $(this).find('select[name="ciacomponent"]').val();

                JsonData += '{"CIA_GROUP_COMPONENT_ID":"' + cia_group_component_id + '",\
                                "CIA_GROUP_ID":"' + group_id + '",\
                                "SUP_CIA_COMPONENT_ID":"' + supComponent + '",\
                               "MAX_MARK":"' + max_mark + '",\
                               "MIN_MARK":"' + min_mark + '",\
                               "ORDER_ID":"'+ $('#OrderId').val() + '"},';
           
        });
        JsonData = JsonData.slice(0, -1);
        JsonData += ']';
        

            $.ajax({
                url: '@Url.Action("SaveCIAGroupComponent", "Academics")',
                type: "post",
                data: { sJsonData: JsonData },
                success: function (data) {
                 //   alert(data.Message)

                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                    loadContent('/Academics/ListCIAGroupComponent');
                },
                error:function()
                {
                    //alert("Internal Server Error");
                    swal({ title: "Info !", text: "Internal Server Error", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                }
                
                
            });
        
    });


    GetConfirm = function (ciaGroupComponentId) {
        swal({
            title: "Are you sure?",
            text: "Your will not be able to recover this file!",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },

      function () {
          var req = $.ajax({
              url: "/Academics/DeletedCIAGroupComponentById",
              type: "post",
              data: { sGroupComponentId: ciaGroupComponentId },
              success: function (data) {
                  if(data.Message!="" && data.Message!=null)
                  {
                      swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                      loadContent('/Academics/ListCIAGroupComponent');
                  }
                  else
                  {
                      swal({ title: "Info !", text: "Something went wrong please try again!", showConfirmButton: false, timer: 1800, type: 'info', animation: true });
                  }
                  


              },
              error: function (ex) {
                  alert(ex.Message);
              }


          });
      });
    }
    
    $('#btnAdd').click(function () {
         sIndex = 1;
        $('#tblComponent').empty();
        $('#OrderId').val('');
        $('#ddlCourseType option[value=""]').prop("selected", true);
        $('.selectpicker').selectpicker('refresh');
        $('#ddlCourseType').trigger("change");

    });

</script>

<script>

    function addCourseTypeGroupForCiaGroupcomponentAdd(objGroup,sRowIndex)
    {
        indexArrange(sRowIndex);

        sIndex = parseInt(sRowIndex) + 1;
        var sHtml = "<tr cms-ca-group-id='' id='" + sIndex + "' cms-row='" + sIndex + "'>" +
                               "<td><input type='text' value='" + objGroup.scaGroup + "' class='form-control' id='" + objGroup.scaGroupId + "' data-parsley-required='true'></td>" +
                               "<td>" + sCiaGroupComponent + "</td>" +
                               "<td><input type='number' name='max-mark' class='form-control' placeholder='Ente maximum mark' value='' data-parsley-required='true'></input></td>" +
                             "<td><input type='number' name='min-mark' class='form-control' placeholder='Enter minimum mark' value='' data-parsley-required='true'></input></td>" +
                               "<td><a class='btn btn-danger btn-icon btn-circle btn-lg' href='javascript:;' onclick=ComponentCancel(this)><i class='fa fa-times'></i></a></td>" +
                           "</tr>"; 
        $('#tblComponent > tbody > tr:nth-child(' + sRowIndex + ')').after(sHtml);
        $('.selectpicker').selectpicker('refresh');
    }

    function ComponentCancel(e) {
        var rowId = $(e).closest("tr").attr("id");
        var row = document.getElementById(rowId);
        row.parentNode.removeChild(row);
        indexArrangeDecrease(rowId);

    }



    function indexArrange(rowIndex)
    {
        $("#tblComponent tbody tr").each(function () {

            if($(this).attr("cms-row")>parseInt(rowIndex))
            {
                var sVal=$(this).attr("cms-row");
                $(this).attr("cms-row", parseInt(sVal) + 1);
                $(this).attr("id", parseInt(sVal) + 1);
            }

        });

    }
    function indexArrangeDecrease(rowIndex) {
        $("#tblComponent tbody tr").each(function () {

            if ($(this).attr("cms-row") > parseInt(rowIndex)) {
                var sVal = $(this).attr("cms-row");
                $(this).attr("cms-row", parseInt(sVal) - 1);
                $(this).attr("id", parseInt(sVal) - 1);
            }

        });

    }


</script>

