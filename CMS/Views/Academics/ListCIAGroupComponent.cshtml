<script>
    $('#tblCourses').DataTable();
    function ContentLoad() {
        // Document Ready Function .
    }
    $('.selectpicker').selectpicker({
        size: 5
    });

    $('.selectpicker').selectpicker('refresh');


    //get cia group componet
    var sCiaGroupComponent = "";
    var sIndex = 1;
    var sCiagroupObject = {
        scaGroup: "",
        scaGroupId: ""
    };




    function ConstrtuctCiaGroup(group,groupId,e)
    {
       
        if(group!="" && group!=null)
        {
            sCiagroupObject.scaGroup = group;
        }
        if (groupId != "" && groupId != null) {
