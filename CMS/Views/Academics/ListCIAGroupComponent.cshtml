                        if (data.oResult != null)
                        {
                           
                            result = "<tbody>";
                            $.each(data.oResult, function (id, info) {
                                if (info.CIA_GROUP_COMPONENT_ID != null && info.CIA_GROUP_COMPONENT_ID != '')
                                {

                                    if (aGroupId.indexOf(info.GROUP_ID) != -1) {

                                        result += "<tr cms-ca-group-id='" + info.CIA_GROUP_COMPONENT_ID + "' id='" + sIndex + "' cms-row='" + sIndex + "'>" +
                                  "<td><input type='text' value='" + info.CA_GROUP + "' class='form-control' id='" + info.GROUP_ID + "' data-parsley-required='true'></td>" +
                                  "<td>" + data.sResult + "</td>" +
                                  "<td><input type='number' name='max-mark' class='form-control' placeholder='Ente maximum mark' value='" + info.MAX_MARK + "' data-parsley-required='true'></input></td>" +
                                "<td><input type='number' name='min-mark' class='form-control' placeholder='Enter minimum mark' value='" + info.MIN_MARK + "' data-parsley-required='true'></input></td>" +
                                "<td></td>" +
                              "</tr>";
                                        
                                    } else {
                                      
                                        result += "<tr cms-ca-group-id='" + info.CIA_GROUP_COMPONENT_ID + "' id='" + sIndex + "' cms-row='" + sIndex + "'>" +
                                  "<td><input type='text' value='" + info.CA_GROUP + "' class='form-control' id='" + info.GROUP_ID + "' data-parsley-required='true'></td>" +
                                  "<td>" + data.sResult + "</td>" +
                                  "<td><input type='number' name='max-mark' class='form-control' placeholder='Ente maximum mark' value='" + info.MAX_MARK + "' data-parsley-required='true'></input></td>" +
                                "<td><input type='number' name='min-mark' class='form-control' placeholder='Enter minimum mark' value='" + info.MIN_MARK + "' data-parsley-required='true'></input></td>" +
                                "<td><a class='btn btn-primary btn-icon btn-circle btn-lg' href='javascript:;' onclick=ConstrtuctCiaGroup('" + info.CA_GROUP + "','" + info.GROUP_ID + "',this) ><i class='fa fa-plus'></i></a></td>" +
                              "</tr>";

                                    }


                                   
                                    aGroupId.push(info.GROUP_ID);

                                }
                                else
                                {
                                    if (aGroupId.indexOf(info.GROUP_ID) != -1) {

                                        result += "<tr cms-ca-group-id='" + info.CIA_GROUP_COMPONENT_ID + "' id='" + sIndex + "' cms-row='" + sIndex + "'>" +
                               "<td><input type='text' value='" + info.CA_GROUP + "' class='form-control' id='" + info.GROUP_ID + "' data-parsley-required='true'></td>" +
                               "<td>" + data.sResult + "</td>" +
                               "<td><input type='number' name='max-mark' class='form-control' placeholder='Ente maximum mark' value='" + info.MAX_MARK + "' data-parsley-required='true'></input></td>" +
                             "<td><input type='number' name='min-mark' class='form-control' placeholder='Enter minimum mark' value='" + info.MIN_MARK + "' data-parsley-required='true'></input></td>" +
                              "<td></td>"+
                           "</tr>";
                                    }
                                    else
                                    {
                                        result += "<tr cms-ca-group-id='" + info.CIA_GROUP_COMPONENT_ID + "' id='" + sIndex + "' cms-row='" + sIndex + "'>" +
                               "<td><input type='text' value='" + info.CA_GROUP + "' class='form-control' id='" + info.GROUP_ID + "' data-parsley-required='true'></td>" +
                               "<td>" + data.sResult + "</td>" +
                               "<td><input type='number' name='max-mark' class='form-control' placeholder='Ente maximum mark' value='" + info.MAX_MARK + "' data-parsley-required='true'></input></td>" +
                             "<td><input type='number' name='min-mark' class='form-control' placeholder='Enter minimum mark' value='" + info.MIN_MARK + "' data-parsley-required='true'></input></td>" +
                              "<td><a class='btn btn-primary btn-icon btn-circle btn-lg' href='javascript:;' onclick=ConstrtuctCiaGroup('" + info.CA_GROUP + "','" + info.GROUP_ID + "',this)><i class='fa fa-plus'></i></a></td>" +
