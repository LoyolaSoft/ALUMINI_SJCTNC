            </div>
            <br />
            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-hover table-bordered" id="tblCourses">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Course Type</th>
                            <th>Internal</th>
                            <th>CA Group</th>
                            <th>Group Mark</th>
                            <th>Component</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LiCourseTypeGroup != null && Model.LiCourseTypeGroup.Count > 0)
                        {
                            foreach (var item in Model.LiCourseTypeGroup)
                            {
                                <tr>
                                    <td>@{ count++;}@count</td>
                                    <td>@item.COURSE_TYPE</td>
                                    <td>@item.INTERNAL</td>
                                    <td>@item.CA_GROUP</td>
                                    <td>@item.GROUP_MARK</td>
                                    <td>@item.COMPONENT</td>

                                    <td>
                                       
                                        <a href="javascrip:;" onclick="GetConfirm(@item.CIA_GROUP_COMPONENT_ID)" class="text-danger"><i class="fa fa-trash"></i></a>

                                    </td>

                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="CourseTypeGroup">
