@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{ Layout = null; int count = 0; int WorkingDayCount = 0;}
<div class="form-group col-md-12 table-responsive" id="dvPrint">
    <div class="form-group col-md-12" id="Tittle">
        <h3 class="text-center">

            @if (Model.liCalendarList != null && Model.liCalendarList.Count > 0)
            {
                var academic_year = Model.liCalendarList.FirstOrDefault().ACADEMIC_YEAR;

                <b>
                    Calendar - @academic_year
                </b>
            }

        </h3>
    </div>
    <table class="table table-bordered table-hover" id="tblDateWiseCollection">
        <thead>
            <tr>
                <th>S. NO.</th>
                <th>Date</th>
                <th>Day Order</th>
                <th>Event</th>
                <th>Is Holiday</th>
                <th>Day</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.liCalendarList != null && Model.liCalendarList.Count > 0)
            {
                foreach (var item in Model.liCalendarList)
                {

                    <tr>
                        <td>@{count++;} @count</td>
                        <td>@item.DAY_ORDER_DATE</td>
                        <td>@item.DAY_ORDER</td>
                        <td>@item.EVENT</td>

                        @if (item.IS_HOLIDAY == "1")
                        {

                            <td>
                                <b>  Holiday</b>
                            </td>
                            <td></td>
                        }
                        else
                        {
                            WorkingDayCount++;
                            <td> Working Day</td>
                            <td><b>@WorkingDayCount</b></td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>