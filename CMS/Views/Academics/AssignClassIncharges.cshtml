@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{
    ViewBag.Title = "AssignClassIncharges";
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Student Course Report</li>
    </ol>
    <h1 class="page-header">Student Course Report</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Student Course Report</h4>
        </div>
        <div class="panel-body" id="maindiv">

            <div class="form-horizontal">
                <div class="col-md-12">
                    <div class="form-group col-md-5">
                        @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Department, (Model.Department != null) ? Model.Department : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "department" })
                            @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="form-group col-md-5">
                        @Html.Label("Shift", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @id = "shift" })
                            @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-2">
                        <a href="#" id="getbtn" class="btn btn-primary">Get</a>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group table-responsive" id="loaddiv">                      
                    </div>  
                    <div class="form-group pull-right">
                        <a href="#" id="btnsubmit" class="btn btn-primary pull-right disabled">Submit</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>

<script>
    function ContentLoad() {

        $('.selectpicker').selectpicker({
            size: 4
        });
    }
    function loadClassIncharge() {
        var departmentid = $('#department').val();
        var shiftid = $('#shift').val();
        $.ajax({
            url: "/Academics/BindClassessForAssign",
            async: false,
            method: "POST",
            type: "JSON",
            data: { "department": departmentid, "shift": shiftid },
            success: function (data) {
                $('#loaddiv').empty();
                $('#loaddiv').html(data);
                $('.selectpicker').selectpicker({
                    size: 4
                });
                $('.selectpicker').selectpicker('refresh');
                $('#btnsubmit').removeClass('disabled');
            },
            error: function () {
                alert('Internal Server Errror!!');
            }
        })
    }
   
    $('#getbtn').on('click', function () {
        loadClassIncharge();
    });
    $('#btnsubmit').on('click', function () {
        var jsonObject;
        if (jsonObject == null) {
            jsonObject = '{"liClassincharge":[';
            $('#StudentList tbody tr').each(function () {
                if (($(this).find('#Stafflist').val()) != null) {
                    jsonObject += '{"CLASS_ID":"' + $(this).attr("classid") + '","STAFF_ID":"' + String($(this).find('#Stafflist').val()) + '"},';
                }
            });
            jsonObject = jsonObject.slice(0, -1);
            jsonObject += ']}';
        }
        $.ajax({
            url: "@Url.Action("SaveClassIncharges", "Academics")",
            async: false,
            method: "POST",
            type: "JSON",
            data: { Classincharge: jsonObject },
            success: function (objResult) {
                alert(objResult.Message);
                loadClassIncharge();
            },
            error: function (xhr, textStatus, error) {
                alert(error + "\n");
            }
        })
    });
</script>

