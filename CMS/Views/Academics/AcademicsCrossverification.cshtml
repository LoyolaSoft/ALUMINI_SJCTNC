@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{
    ViewBag.Title = "AcademicsCrossverification";
    Layout = null;
}
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">Academics Crossverification</li>
    </ol>
    <h1 class="page-header">Academics Crossverification</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Academics Crossverification</h4>
        </div>
        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Programme, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.Programme, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.liSemesterType, "Semester", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.liSemesterType, (Model.liSemesterType != null) ? Model.liSemesterType : Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                            @Html.ValidationMessageFor(model => model.liSemesterType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-1">
                        <a class="btn btn-primary" id="btnGet">Verify</a>
                    </div>
                    <div class="form-group col-md-1">
                        <a href="#" id="btnExport" class="btn btn-success  m-b-20">Export</a>
                    </div>
                </div>
                <div class="col-md-12">
                    <div id="dvCrossverification" class="form-group table-responsive">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    ContentLoad = function () {
        // Document Ready Function .
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    }


    $('#btnGet').on('click', function () {    
        var vProgrammeGroupId = $('#Programme').val();
        var vSemesterType = $('#liSemesterType').val();
        $.ajax({
            url: '@Url.Action("BindAcademicsCrossverification", "Academics")',
            method: 'POST',
            data: { sProgrammeGroupId: vProgrammeGroupId, sSemesterType: vSemesterType },
            success: function (data) {
                $('#dvCrossverification').empty();
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {                   
                    $('#dvCrossverification').append(data);
                }
            }, error: function (error) {
                alert(error);
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        })
    });

    //Excel Export
    $("#btnExport").click(function (e) {
        var Programme = $('#Programme option:selected').text();
        let file = new Blob([$('#dvCrossverification').html()], { type: "application/vnd.ms-excel" });
        let url = URL.createObjectURL(file);
        let a = $("<a />", {
            href: url,
            download: Programme+".xls"
        }).appendTo("body").get(0).click();
        e.preventDefault();
    });

</script>


