@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "AddCoursePattern";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
    @*<style>
        {background-color:blue}
    </style>*@

<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a @*href="@Url.Action("ListCoursePattern","Academics")"*@ href="javascript:;" onclick="loadContent('/Academics/ListCoursePattern')">Course Pattern List</a></li>
            <li class="active">Add/Edit CoursePattern List</li>
        </ol>
        <h2 class="page-header">Add/Edit CoursePattern List</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Add/Edit CoursePattern List</h4>
            </div>
            <div class="panel-body">                
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })                    
                    <div class="col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.AcademicYear, "Academicyear", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.FacultyList, "Faculty", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.FacultyList, (Model.FacultyList != null) ? Model.FacultyList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.FacultyList, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Programme, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.Programme, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.Semester, "Semester", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(model => model.ProgrammeLevel, "ProgrammeLevel", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ProgrammeLevel, (Model.ProgrammeLevel != null) ? Model.ProgrammeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <a class="btn btn-primary" id="btnGet">Get</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 m-b-5">
                    <div id="divAddCoursepattern" class="table-responsive">
                        <!--Need to use this field to bind Course Structure-->
                    </div>  
                    <div class="hidden pull-right" id="hdSubmit">
                        <a class="btn btn-primary" id="btnSubmit">Submit</a> 
                    </div>
                                 
                </div>
            </div>
        </div>
    }
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $('.selectpicker').selectpicker("refresh");
        $('#btnGet').on('click', function () {
            if ($('#AcademicYear').val() && $('#FacultyList').val() && $('#Programme').val() && $('#Semester').val() && $('#ProgrammeLevel').val()) {
                var Semester = String($('#Semester').val());
                var AcademicYear = $('#AcademicYear option:selected').text();
                $.ajax({
                    url: "@Url.Action("FetchCoursePatternByForAddEdit", "Academics")",
                    method: "POST",
                datatype: "html",
                data: { sAcYear: AcademicYear, sFacultyId: $('#FacultyList').val(), sProgramme: $('#Programme').val(), sSemester: Semester, sProgrammeLevel: $('#ProgrammeLevel').val() },
                success: function (option) {
                    var dvBindAddCoursePattern = $('#divAddCoursepattern');
                    dvBindAddCoursePattern.empty();
                    dvBindAddCoursePattern.append(option);
                    $("#tblAddCoursePatternList").DataTable({ paging: false });
                    $('#hdSubmit').removeClass('hidden');
                   // $('.selectpicker').selectpicker('refresh');
                }, error: function (error) {
                    alert('Internal Server Error ! ');
                }
            });
            }else{
                alert('Select All the Fields..!');
        }            
        });
        $('#btnSubmit').on('click', function () {
            if ($('#AcademicYear').val() && $('#FacultyList').val() && $('#Programme').val() && $('#Semester').val() && $('#ProgrammeLevel').val()) {
                var JsonCount = 0;
                var jsonObject = null;
                //var vnewattrib = "";
                var nselcourses;
                //var nvselcourses = new Array();
                if (jsonObject == null)
                {
                    jsonObject = '{"JSONlstCP_COURSE_PATTERN":[';
                    $('#tblAddCoursePatternList tbody tr').each(function ()
                    {
                        
                            nselcourses = String($(this).find('#cpCourses').val());
                            jsonObject += '{"COURSE_PATTERN_ID":"' + $(this).attr("cms-coursepatternid") + '","COURSE_STRUCTURE_ID":"' + $(this).attr("cms-coursestrutureid") + '","PROGRAMME_GROUP_ID":"' + $('#Programme').val() + '","ACADEMIC_YEAR":"' + $('#AcademicYear option:selected').text() + '","COURSE_ID":"' + nselcourses + '","IS_OPTIONAL":"' + $(this).attr("cms-isoptional") + '"},';
                            JsonCount++;
                                                                                
                    });
                    if (JsonCount != 0) {
                        jsonObject = jsonObject.slice(0, -1);
                        jsonObject += ']}';
                    } else {
                        return false;
                    }
                }
                $.ajax({
                    url: '@Url.Action("SaveCoursePattern", "Academics")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sJsonSaveCoursePattern: jsonObject },
                    success: function (data)
                    {
                        if (data.Message == '200')
                        {
                            myAlert('Record Saved Successfully ', 'gritter-success', '');
                            $('#btnGet').click();
                        } else
                        {
                            myAlert(data.Message, 'gritter-warning', '');
                        }
                    }, error: function (error)
                    {
                        myAlert('Internal Server Error ...!', 'gritter-danger', '');
                    }
                });
        }else{
               // alert('Select All the Fields..!');
                myAlert('Select All the Fields !', 'gritter-warning', '');
        }            
        });

    </script>

}

