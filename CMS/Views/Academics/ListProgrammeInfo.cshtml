@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "ListProgrammeInfo";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Programme </li>
    </ol>
    <h1 class="page-header">List Programme </h1>
    
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Programme </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="javascript:;" onclick="loadContent('/Academics/ProgrammeInfo')" @*href="@Url.Action("ProgrammeInfo","Academics")"*@><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <br />

            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-hover table-bordered" id="ProgrammeList">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.PROGRAMME_NAME)*@
                                Programme 
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.PROGRAMME_DESCRIPTION)*@
                                Programme Description
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.DEPARTMENT)*@
                                Department
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.DEGREE)*@
                                Degree
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.CHANNEL)*@
                                Channel
                            </th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liProgrammeList != null && Model.liProgrammeList.Count > 0)
                        {
                            foreach (var item in Model.liProgrammeList)
                            {
                                <tr>
                                    <td>
                                        @{ count++;}
                                        @count
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PROGRAMME_NAME)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PROGRAMME_DESCRIPTION)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DEPARTMENT)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DEGREE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CHANNEL)
                                    </td>
                                    <td>
                                        <a href="javascript:;" onclick="loadContent('/Academics/EditProgrammeInfo/@item.PROGRAMME_ID')" @*href="@Url.Action("EditProgrammeInfo","Academics",new { id=@item.PROGRAMME_ID})"*@><i class="fa fa-edit text-primary" title="Update"></i></a>
                                        <a href="javascript:;" onclick="GetConfrim(@item.PROGRAMME_ID);" @*href="@Url.Action("DeleteProgrammeInfo","Academics",new { id=@item.PROGRAMME_ID})" onclick="return confirm('Are you sure want to delete ?');"*@><i class="fa fa-trash text-danger" title="Delete"></i></a>
                                    </td>
                                </tr>
                                }
                            }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        $("#ProgrammeList").DataTable();
        function ContentLoad() {
            // Document Ready Function .

        }

        function GetConfrim(ID)
        {
            if (!confirm('Are you sure want to delete ?'))
            {
                return false;
            } 
            $.ajax({
                url: "@Url.Action("DeleteProgrammeInfo", "Academics")",
                method: "POST",
                datatype: "json",
                data: { id: ID },
                success: function (data)
                {
                    alert(data.Message);
                    if(data.sResult!="False")
                    {
                        loadContent('/Academics/ListProgrammeInfo');
                    }
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }
    </script>
