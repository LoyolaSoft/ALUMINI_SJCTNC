@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{ 
    Layout = null;
}

<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">List Rescapes Class Wise Staff</li>
        </ol>
        <h2 class="page-header">List Rescapes Class Wise Staff</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">List Rescapes Class Wise Staff</h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal" id="Validate">
                    <div class="col-md-12 form-group pull-right">
                        <a data-toggle="modal" href="#RescapesClassCourseStaf-dialog" class="btn btn-success pull-right"><i class="fa fa-plus"> Add </i></a>
                    </div>
                    <div class="col-md-12 form-group">
                        <div class="col-md-6">
                            <label class="col-md-3 control-label">Ac Year</label>
                            <div class="col-md-6">
                                @Html.DropDownListFor(m => m.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "sAcYear" })
                            </div>
                        </div>
                        
                    </div>

                    <div id="dvLoadGrid"></div>
                </div>
            </div>
        </div>
    </div>



<div class="modal" id="RescapesClassCourseStaf-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add/Edit Rescapes Class Course Staff</h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="pBody">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="col-md-12 form-horizontal">

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Academic Year</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group" id="dvProgram">
                                        <label class="col-md-4 control-label">Program </label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Class</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.liClass, (Model.liClass != null) ? Model.liClass : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Course</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.CourseList, (Model.CourseList != null) ? Model.CourseList : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group">
                                        <label class="col-md-4 control-label">Staff</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(m => m.Staff, (Model.Staff != null) ? Model.Staff : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" onclick="SaveData()" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" id="btnCancel" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
        <input type="hidden" id="sClassCourseStaffId" value="" />
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }

    $('.selectpicker').selectpicker({
        size: 6
    });
    $('.selectpicker').selectpicker('refresh');

    $(function ()
    {
        $('#RescapesClassCourseStaf-dialog').on('hidden.bs.modal', function (e)
        {
            $('#dvProgram').removeClass('hidden');
            $('#AcademicYear').val('');
            $('#AcademicYear option:Selected').text('');
            $('#Programme').val('');
            $('#liClass').val('');
            $('#CourseList').val('');
            $('#Staff').val('');
            $('.selectpicker').selectpicker('refresh');
        });
    });
</script>

<script>
    $('#sAcYear').on('change',function ()
    {
        LoadGrid();
    });

    function LoadGrid() 
    {
        $('#dvLoadGrid').empty();
        $.ajax({
            url: '@Url.Action("ClassCourseStaffForRescapes", "Academics")',
            method: 'POST',
            datatype: 'json',
            data: { sAcYear: $('#sAcYear option:Selected').text() },
            success: function (data)
            {
                if (data.Message != null && data.Message != '')
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    $('#dvLoadGrid').append(data);
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

<script>
    $('#Programme').on('change', function myfunction()
    {
        FetchClassByProgramId();
    });

    function FetchClassByProgramId()
    {
        $('#liClass').empty();
        $.ajax({
            url: '@Url.Action("FetchClassByProgramGroupId", "SupportData")',
            method: 'POST',
            datatype: 'json',
            data: { sProgramGroupId: $('#Programme').val() },
            success: function (data) {
                if (data.Message != null && data.Message != '') {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else {
                    $('#liClass').append(data.sResult);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

<script>
    function FetchCourseWiseStaffById(Id)
    {
        $.ajax({
            url: '@Url.Action("FetchRescapesClassCourseStaffById", "Academics")',
            method: 'POST',
            datatype: 'json',
            data: { sClassWiseStaffId: Id },
            success: function (data) 
            {
                if (data.Message != null && data.Message != '') 
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else 
                {
                    $('#dvProgram').addClass('hidden');
                    $('#AcademicYear option:Selected').text(data[0].ACADEMIC_YEAR);
                    $('#liClass').val(data[0].CLASS_ID);
                    $('#CourseList').val(data[0].COURSE_ID);
                    $('#Staff').val(data[0].STAFF_ID);
                    $('#sClassCourseStaffId').val(data[0].CLS_CRSE_STF_ID);
                    $('.selectpicker').selectpicker('refresh');
                }
            }, error: function (error) 
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

<script>
    function SaveData()
    {
        var sAcademicYear=$('#AcademicYear option:Selected').text();
        var sClass=$('#liClass').val();
        var sCourse=$('#CourseList').val();
        var sStaff=$('#Staff').val();
        var sClassCourseStaff=$('#sClassCourseStaffId').val();
        $.ajax({
            url: '@Url.Action("SaveRescapesClassCourseStaff", "Academics")',
            method: 'POST',
            datatype: 'json',
            data: { sClassCourseStaffId:sClassCourseStaff ,sAcademicYearId:sAcademicYear,sClassId:sClass,sCourseId:sCourse,sStaffId:sStaff },
            success: function (data)
            {
                if (data.ErrorCode!="200")
                {
                    swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                } else
                {
                    swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                    LoadGrid() ;
                }
            }, error: function (error)
            {
                swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
            }
        });
    }
</script>

<script>
    function DeleteCourseWiseStaff(Id)
    {
        swal({
            title: "Are you sure want to Delete?",
            text: "",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        },function () 
        {
            $.ajax({
                url: '@Url.Action("DeleteRescapesClassCourseStaff", "Academics")',
                method: 'POST',
                datatype: 'json',
                data: { sClassWiseStaffId: Id },
                success: function (data)
                {
                    if (data.ErrorCode != "200")
                    {
                        swal({ title: "Error !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                    } else
                    {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 1500, type: 'success', animation: true });
                        LoadGrid();
                    }
                }, error: function (error)
                {
                    swal({ title: "Internal Server Error!", text: "Sorry for the inconvenience", showConfirmButton: false, timer: 1500, type: 'error', animation: true });
                }
            });

        })
    }
</script>