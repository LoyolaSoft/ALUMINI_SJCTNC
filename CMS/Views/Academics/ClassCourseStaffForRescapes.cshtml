@model CMS.ViewModel.ViewModel.AcademicsViewModel


<div class="col-md-12 form-group">
    <table class="table table-bordered table-responsive">
        <thead>
            <tr>
                <th>#</th>
                <th>Department</th>
                <th>Staff Name</th>
                <th>Shift</th>
                <th>Class</th>
                <th>Course Title</th>
                <th>Semester</th>
                <th>Ac Year</th>
                <td>Action</td>
            </tr>
        </thead>
        <tbody>
            @{  int nCount = 0;
                if (Model.liClassCourseStaffForRescapes != null && Model.liClassCourseStaffForRescapes.Count > 0)
                {
                    foreach (var item in Model.liClassCourseStaffForRescapes)
                    {
                        <tr>
                            <td>@{nCount++;} @nCount</td>
                            <td>@item.DEPARTMENT</td>
                            <td>@item.FIRST_NAME (@item.STAFF_CODE)</td>
                            <td>@item.SHIFT</td>
                            <td>@item.CLASS_NAME</td>
                            <td>@item.COURSE_TITLE (@item.COURSE_CODE)</td>
                            <td>@item.SEMESTER_ID</td>
                            <td>@item.ACADEMIC_YEAR</td>
                            <td>
                                <a href="#RescapesClassCourseStaf-dialog" onclick="FetchCourseWiseStaffById(@item.CLS_CRSE_STF_ID)" data-toggle="modal"><i class="fa fa-edit"></i></a>
                                <a href="javascript:;" onclick="DeleteCourseWiseStaff(@item.CLS_CRSE_STF_ID)" class="text-danger"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                                    }
                                }
            }
        </tbody>
    </table>

</div>