
@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{ Layout = null; string sSelected = string.Empty;}
@if (Model.liClassInchargeInfo != null && Model.liClassInchargeInfo.Count > 0)
{
    var classgroup = Model.liClassInchargeInfo.GroupBy(o => o.CLASS_ID).ToList();
    <div class="col-md-12">
        <table class="table table-bordered table-responsive" id="StudentList">
            <thead>
                <tr>
                    <th>Class Name</th>
                    <th>Staff List</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.ClassList != null && Model.ClassList.Count() > 0 && Model.liClassInchargeInfo!=null && Model.liClassInchargeInfo.Count()>0)
                    {
                        
                        foreach (var classitem in Model.ClassList)
                        {
                            <tr classid=@classitem.CLASS_ID>
                                <td classid="@classitem.CLASS_ID">
                                    @classitem.CLASS_NAME
                                </td>
                                <td>
                                    <div class="col-md-8">                                        
                                        <select class="form-control m-b-10 selectpicker" id="Stafflist" data-live-search="true" data-selected-text-format="count" multiple>
                                            <option value="0">--Select--</option>
                                            @if (Model.Staff_List != null && Model.Staff_List.Count > 0)
                                            {
                                                foreach (var staff in Model.Staff_List)
                                                {
                                                    foreach (var item in Model.liClassInchargeInfo)
                                                    {
                                                        var matchedstaff = Model.liClassInchargeInfo.Where(o => o.STAFF_ID == staff.STAFF_ID).ToList();
                                                        foreach (var match in matchedstaff)
                                                        {
                                                            if (classitem.CLASS_ID == match.CLASS_ID)
                                                            {
                                                                sSelected = "selected";
                                                            }
                                                        }
                                                    }
                                                    <option value="@staff.STAFF_ID" @sSelected>@staff.FIRST_NAME</option>
                                                    sSelected = string.Empty;
                                                }
                                            }
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }               
            </tbody>
        </table>
    </div>
 
}
else
{
    <table class="table table-bordered table-responsive">
        <thead>
            <tr>
                <th>Class Name</th>
                <th>Staff List</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="2">Not Avialable</td>
            </tr>
        </tbody>
    </table>
}