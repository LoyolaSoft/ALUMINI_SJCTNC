@model CMS.ViewModel.ViewModel.AcademicsViewModel

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover" id="tblSyllabus">
        <thead>
            <tr>
                <th>#</th>
                <th>Course Code</th>
                <th>Course Title</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.liAcademicSyllabus != null && Model.liAcademicSyllabus.Count > 0)
            {
                int index = 1;
                foreach (var item in Model.liAcademicSyllabus)
                {
                    <tr>
                        <td>@index</td>
                        <td>@item.COURSE_CODE</td>
                        <td>@item.COURSE_TITLE</td>
                        <td class="text-center">
                            <div class="btn-group">
                                @if (!string.IsNullOrEmpty(item.FILE_PATH))
                                {
                                    <a href="@Url.Content("~" + item.FILE_PATH)" target="_blank" class="btn btn-sm btn-info" title="View Syllabus">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                }
                                <button type="button" class="btn btn-sm btn-primary" onclick="EditSyllabus(@item.SYLLABUS_ID, '@item.COURSE_CODE', '@item.COURSE_TITLE', @item.COURSE_ID)" title="Edit">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="DeleteSyllabus(@item.SYLLABUS_ID)" title="Delete">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No syllabus found for this academic year.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
