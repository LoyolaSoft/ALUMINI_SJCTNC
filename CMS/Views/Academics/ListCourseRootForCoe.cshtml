@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "ListCourseRootForCoe";
    // Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

<link href="~/Content/assets/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Course</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">List Course</h1>
    <!-- end page-header -->
    @if (TempData["DeleteSuccess"] != null)
    {
        <div class="alert alert-success fade in m-b-15" id="Success">
            <strong>Success!</strong>
            @TempData["DeleteSuccess"]
            <span class="close" data-dismiss="alert">×</span>
        </div>
    }
    @if (TempData["DeleteError!"] != null)
    {
        <div class="alert alert-danger fade in m-b-15" id="Error">
            <strong>Error!</strong>
            @TempData["DeleteError"]
            <span class="close" data-dismiss="alert">×</span>
        </div>
    }
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Course</h4>
        </div>
        <div class="panel-body noPadding" id="Validate" data-parsley-validate="true">

            <div class="form-group col-md-4">
                @Html.LabelFor(model => model.AcademicYear, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlAcademicYear", @data_parsley_required = "true" })
                    @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group col-md-4">
                @Html.LabelFor(model => model.Department, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.Department, (Model.Department != null) ? Model.Department : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlDepartment", @data_parsley_required = "true" })
                    @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group col-md-4">
                @Html.LabelFor(model => model.Semester, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", id = "ddlSemester", @data_parsley_required = "true" })
                    @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                </div>
            </div>



            <div class="col-md-12" id="dvBind">



            </div>




        </div>
    </div>
</div>


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/select2/dist/js/select2.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script>

        function ContentLoad() {
            // Document Ready Function .

            var sacYear=@Html.Raw(Json.Encode(Model.acYear));
            if (sacYear != null && sacYear!="")
            {
                $("#ddlAcademicYear  option[value=" + sacYear+"]").prop('selected',true);
                

            }


            var sDept=@Html.Raw(Json.Encode(Model.sDept));
            if (sDept != null && sDept!="")
            {
                $("#ddlDepartment  option[value=" + sDept+"]").prop('selected',true);
              
            }

             var sSemester=@Html.Raw(Json.Encode(Model.sSemester));
            if (sSemester != null && sSemester!="")
            {
                $("#ddlSemester  option[value=" + sSemester+"]").prop('selected',true);
                $("#ddlSemester").trigger("change");
            }



            $('.selectpicker').selectpicker({
                size: 4
            });
            $('.selectpicker').selectpicker('refresh');
        }


    function LoadCourse() {
         var AcademicYear = $("#ddlAcademicYear option:selected").text();
        
        var sDepartment = $("#ddlDepartment").val();
        var sSemester = $("#ddlSemester").val();
            $.ajax({
                url: "@Url.Action("ListCourseInfoByAcademicAndDepartmentAndSemesterType", "Academics")",
                method: "POST",
                datatype: "json",
                data: { sAcademicYear: AcademicYear, sDept: sDepartment, sSemester: sSemester},
                success: function (data)
                {
                    $("#dvBind").empty();
                    $("#dvBind").append(data);

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
    }


    $("#ddlSemester").on("change", function () {
        
        var isValid = true;
        if ($('#Validate').parsley().validate() !== true) isValid = false;
        if (!isValid) {
            //gritter-info,danger,success,warning,default
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        LoadCourse();
       
        });

</script>



