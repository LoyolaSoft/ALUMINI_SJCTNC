@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "CourseStructure";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />



<div class="content" id="content">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li class="active">Course Structure Info</li>
        </ol>
        <h2 class="page-header">Course Structure Info</h2>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Course Structure Info </h4>
            </div>
            <div class="panel-body">
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="col-md-12" id="Validate" data-parsley-validate="true">  
                                              
                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.CREDIT, "Credit", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.ObjCourseStructure.CREDIT, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Credits", @data_parsley_type = "number", @data_parsley_required = "true" } })
                                @Html.ValidationMessageFor(model => model.ObjCourseStructure.CREDIT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.PART_ID, "Part", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.Part, (Model.Part != null) ? Model.Part : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true" })
                                @Html.ValidationMessageFor(model => model.FacultyList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.UGC_TYPE_ID, "Ugc Type", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.UGC_Type, (Model.UGC_Type != null) ? Model.UGC_Type : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.FacultyList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.HRS_PER_WEEK, "Hours", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.ObjCourseStructure.HRS_PER_WEEK, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Hours Per Week", @data_parsley_type = "number", @data_parsley_required = "true" } })
                                @Html.ValidationMessageFor(model => model.ObjCourseStructure.HRS_PER_WEEK, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.MARKS, "Marks", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.ObjCourseStructure.MARKS, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter Marks", @data_parsley_type = "number", @data_parsley_required = "true" } })
                                @Html.ValidationMessageFor(model => model.ObjCourseStructure.MARKS, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.SEMESTER_ID, "Semester", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.FacultyList, "Faculty", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.FacultyList, (Model.FacultyList != null) ? Model.FacultyList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.FacultyList, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.ObjCourseStructure.PROGRAMME_LEVEL, "Programme Level", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ProgrammeLevel, (Model.ProgrammeLevel != null) ? Model.ProgrammeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.AcademicYear, "Programme Year", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.ProgrammeYear, (Model.ProgrammeYear != null) ? Model.ProgrammeYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", id = "ProgrammeYear", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.ProgrammeYear, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group col-md-6">
                            @Html.LabelFor(model => model.AcademicYear, "Academic Year", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker form-control  input-sm", @data_live_search = "true", @data_parsley_required = "true" })
                                @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row"></div>

                        <div class="form-group col-md-8">
                            @*@Html.LabelFor(model => model.ObjCourseStructure.IS_OPTIONAL, "Is Optional", htmlAttributes: new { @class = "control-label col-md-3" })*@
                            <label class="control-label col-md-2"></label>
                            <div class="form-group col-md-3">
                                <div class="checkbox checkbox-css">
                                    <input type="checkbox" id="IsOptional" name="hobbies[]" data-parsley-mincheck="1"  />
                                    <label for="IsOptional">IsOptional</label>
                                </div>
                            </div>

                            <div class="form-group col-md-3">
                                <div class="checkbox checkbox-css">
                                    <input type="checkbox" id="IsNme" name="hobbies[]" />
                                    <label for="IsNme">IsNme </label>
                                </div>
                            </div>

                            <div class="form-group col-md-3">
                                <div class="checkbox checkbox-css">
                                    <input type="checkbox" id="IsAllied" name="hobbies[]" />
                                    <label for="IsAllied">IsAllied </label>
                                </div>
                            </div>

                        </div>
                        
                       <div class="col-md-2">
                           <a class="btn btn-primary" id="btnSubmit"> Submit</a>
                           <a class="btn btn-danger" @*href="@Url.Action("ListCourseStructure","Academics")"*@ href="javascript:;" onclick="loadContent('/Academics/ListCourseStructure')"> Cancel</a>
                       </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Hidden Field-->
@Html.HiddenFor(model => model.ObjCourseStructure.COURSE_STRUCTURE_ID)
@Html.HiddenFor(model => model.ObjCourseStructure.PART_ID)
@Html.HiddenFor(model => model.ObjCourseStructure.UGC_TYPE_ID)
@Html.HiddenFor(model => model.ObjCourseStructure.SEMESTER_ID)
@Html.HiddenFor(model => model.ObjCourseStructure.FACULTY_ID)
@Html.HiddenFor(model => model.ObjCourseStructure.PROGRAMME_LEVEL)
@Html.HiddenFor(model => model.ObjCourseStructure.PROGRAMME_YEAR)
@Html.HiddenFor(model => model.ObjCourseStructure.ACADEMIC_YEAR)
@Html.HiddenFor(model => model.ObjCourseStructure.IS_OPTIONAL)
@Html.HiddenFor(model => model.ObjCourseStructure.IS_NME)
@Html.HiddenFor(model => model.ObjCourseStructure.IS_ALLIED)
<!-- Hidden Field-->

   
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
    <script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
    <script>
        function ContentLoad()
        {
            // Document Ready Function .
            
            $('#Part').val($('#ObjCourseStructure_PART_ID').val());
            $('#UGC_Type').val($('#ObjCourseStructure_UGC_TYPE_ID').val());
            $('#Semester').val($('#ObjCourseStructure_SEMESTER_ID').val());
            $('#FacultyList').val($('#ObjCourseStructure_FACULTY_ID').val());
            $('#ProgrammeLevel').val($('#ObjCourseStructure_PROGRAMME_LEVEL').val());
            $('#ProgrammeYear').val($('#ObjCourseStructure_PROGRAMME_YEAR').val());
            $('#AcademicYear').val($('#ObjCourseStructure_ACADEMIC_YEAR').val());
            var isOptional = $('#ObjCourseStructure_IS_OPTIONAL').val();
            var isNme = $('#ObjCourseStructure_IS_NME').val();
            var isAllied = $('#ObjCourseStructure_IS_ALLIED').val();
            if (isOptional == "1") {
                $('#IsOptional').click();
            }
            if (isNme == "1") {
                $('#IsNme').click();
            }
            if (isAllied == "1") {
                $('#IsAllied').click();
            }
            $('.selectpicker').selectpicker({
                size: 4
            });
            $('.selectpicker').selectpicker('Refresh');
        }
        //$(document).ready(function myfunction()
        //{
            
        //});
        

        $('#btnSubmit').on('click', function ()
        {
            var isValid = true;
            if ($('#Validate').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }

            var IsNme = 0;
            var IsAllied = 0;
            var IsOptional = 0;
            if ($('#IsNme').is(':checked')) {
                IsNme = 1;
            }

            if ($('#IsAllied').is(':checked')) {
                IsAllied = 1;
            }

            if ($('#IsOptional').is(':checked')) {
                IsOptional = 1;
            }
            //alert($('#ProgrammeLevel').val());
            var JsonData = null;
            JsonData = '{"COURSE_STRUCTURE_ID":"' + $('#ObjCourseStructure_COURSE_STRUCTURE_ID').val() + '",\
                        "CREDIT":"' + $('#ObjCourseStructure_CREDIT').val() + '",\
                        "PART_ID":"' + $('#Part').val() + '",\
                        "UGC_TYPE_ID":"' + $('#UGC_Type').val() + '",\
                        "HRS_PER_WEEK":"' + $('#ObjCourseStructure_HRS_PER_WEEK').val() + '",\
                        "MARKS":"' + $('#ObjCourseStructure_MARKS').val() + '",\
                        "SEMESTER_ID":"' + $('#Semester').val() + '",\
                        "FACULTY_ID":"' + $('#FacultyList').val() + '",\
                        "PROGRAMME_LEVEL":"' + $('#ProgrammeLevel').val() + '",\
                        "PROGRAMME_YEAR":"' + $('#ProgrammeYear').val() + '",\
                        "ACADEMIC_YEAR":"' + $('#AcademicYear option:selected').text() + '",\
                        "IS_OPTIONAL":"' + IsOptional + '",\
                        "IS_NME":"' + IsNme + '",\
                        "IS_ALLIED":"' + IsAllied + '"}';
            $.ajax({
                url: '@Url.Action("SaveCourseStructure", "Academics")',
                method: 'POST',
                datatype: 'json',
                data: { CourseStructureJsonData: JsonData },
                success: function (data)
                {
                    if (data.Message == '200')
                    {
                        myAlert('Record Saved Successfully ', 'gritter-success', '');
                    } else
                    {
                        myAlert(data.Message, 'gritter-warning', '');
                    }
                }, error: function (error)
                {
                    myAlert('Internal Server Error ...!', 'gritter-danger', '');
                }
            });
        });
    </script>
