@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "ListCourseTypeGroup";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />

<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">ListCourseTypeGroup</li>
    </ol>
    <h1 class="page-header">ListCourseTypeGroup</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">ListCourseTypeGroup</h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#CourseTypeGroup" data-toggle="modal"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <br />
            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-hover table-bordered" id="tblCourses">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Course Type</th>
                            <th>Internal</th>
                            @*<th>External</th>*@
                            @*<th>Total</th>*@
                            <th>CA Group</th>
                            <th>Group Mark</th>
                            @*<th>Action</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LiCourseTypeGroup != null && Model.LiCourseTypeGroup.Count > 0)
                        {
                            foreach (var item in Model.LiCourseTypeGroup)
                            {
                                <tr>
                                    <td>@{ count++;}@count</td>
                                    <td>@item.COURSE_TYPE</td>
                                    <td>@item.INTERNAL</td>
                                    @*<td>@item.EXTERNAL</td>*@
                                    @*<td>@item.TOTAL</td>*@
                                    <td>@item.CA_GROUP</td>
                                    <td>@item.GROUP_MARK</td>
                                    @*<td>
                                        <a href="#CourseTypeGroup" data-toggle="modal" onclick="GetCourseTypeGroup(@item.GROUP_ID)"><i class="fa fa-edit"></i></a>
                                        <a href=";;" onclick="GetConfrim(@item.GROUP_ID)"><i class="fa fa-trash text-danger"></i></a>
                                    </td>*@                                    
                                </tr>
                             }
                         }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="CourseTypeGroup">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Course Type Group </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true"  id="pBody">
                <div class="form-horizontal">

                    <div class="form-group">
                        <label class="control-label col-md-3">Course Type</label>
                        <div class="col-md-9">
                            <select class="selectpicker show-menu-arrow show-tick drop-down form-control input-sm" id="ddlCourseType" data-live-search = "true">
                                @if (Model.liCourseType != null && Model.liCourseType.Count > 0)
                                {
                                    <option value=""> -- Select -- </option>
                                    foreach (var item in Model.liCourseType)
                                    {
                                        <option value="@item.COURSE_TYPE_ID" cms-component="@item.NO_OF_COMPONENTS" > @item.COURSE_TYPE</option>
                                    }
                                }   
                            </select>
                            @*@Html.DropDownListFor(model => model.CourseType, (Model.CourseType != null) ? Model.CourseType : Enumerable.Empty<SelectListItem>(), "-- Select -- ", new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true" })*@
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Group Component</label>
                        <div class="col-md-9">
                            @*@Html.DropDownListFor(model => model.GroupComponent, (Model.GroupComponent != null) ? Model.GroupComponent : Enumerable.Empty<SelectListItem>(), null, new { @class = "selectpicker show-menu-arrow show-tick drop-down form-control input-sm", @data_live_search = "true", @data_actions_box = "true", multiple = "multiple" })*@
                        
                        <table class="table table-bordered  table-hover" id="tblComponent">
                            
                        </table>
                         
                        
                        </div>
                    </div>


                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" id="btnSubmitGroupTypeGroup" class="btn btn-default" data-dismiss="modal">Submit</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
    <script>
        $('#tblCourses').DataTable();
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 5
        });
        
        $('.selectpicker').selectpicker('refresh');

        // Fetch Course Type Group For Edit ...
        function GetCourseTypeGroup(Id) 
        {
            if (Id != null && Id != '')
            {
                $.ajax({
                    url: '@Url.Action("FetchCourseTypeGroupById", "Academics")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sCourseTypeGroupId: Id },
                    success: function (data)
                    {
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                            $('#ddlCourseType').val();
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }

        // When Course Type Change ....
        $('#ddlCourseType').on('change', function ()
        {
            if ($('#ddlCourseType').val())
            {
               // var sDoubleQuot = '"';
                var Limit = $('#ddlCourseType Option:selected').attr('cms-component');
                $.ajax({
                     url:'@Url.Action("FetchCourseTypeGroupDDL", "Academics")',
                    method: 'POST',
                    datatype: 'json',
                    data: { sCourseTypeId: $('#ddlCourseType').val()},
                    success: function (data)
                    {
                        if (data.Message != null && data.Message != '')
                        {
                            alert(data.Message);
                        } else
                        {
                         
                            
                            var result = "";
                            //$.each(data.sResultStringArray, function (id, info) {
                            //    result +=info;
                            //});
                            
                            $('#tblComponent').empty();
                            if (data.sResult != null && data.sResult != '')
                            {
                                $('#tblComponent').append(data.sResult);
                            }
                            else
                            {
                                //for (var i = 0; i < Limit; i++)
                                //{
                                //    result += '<tr>' +
                                //                '<td><input class="form-control input-sm text-box single-line" id=""' +
                                //                 'placeholder="Enter Group Component" value="" type="text"></input>' +
                                //               '</td>' +
                                //              '<td><input class="form-control input-sm text-box single-line" id=""' +
                                //               'name="" placeholder="Enter Group mark" type="number" value=""></input></td>' +
                                //              "</tr>";
                                //}

                                //$('#tblComponent').append(result);
                            }
                          
                            $('.selectpicker').selectpicker('refresh');
                        }
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            } 
            
        });

        // On Delete .....
        function GetConfrim(Id) 
        {
            if (Id!=null && Id!='') 
            {
                $.ajax({
                    url:'@Url.Action("DeleteCourseTypeGroup", "Academics")',
                    method:'POST',
                    datatype:'json',
                    data: { sCourseTypeGroupId: Id },
                    success: function (data)
                    {
                        alert(data.Message);
                        loadContent('/Academics/ListCourseTypeGroup');
                    }, error: function (error)
                    {
                        alert('Internal Server Error !');
                    }
                });
            }
        }


        // On Submit ....
        $('#btnSubmitGroupTypeGroup').on('click', function () {
            var JsonData = '[';
            var sCount = 0;
            var isValid = true;
            if ($('#pBody').parsley().validate() !== true) isValid = false;
            if (!isValid) {
                //gritter-info,danger,success,warning,default
                //   alert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
                return false;
            }




            $("#tblComponent tbody tr").each(function () {
               
                if ($(this).find('input[type="text"]').val())
                {
                     var group_id = $(this).find('input[type="text"]').attr('id');
                var ca_group = $(this).find('input[type="text"]').val();
                var group_mark = $(this).find('input[type="number"]').val();
                JsonData += '{"GROUP_ID":"' + group_id + '",\
                                "CA_GROUP":"' + ca_group + '",\
                                "COURSE_TYPE_ID":"' + $('#ddlCourseType').val() +'",\
                               "GROUP_MARK":"' + group_mark + '"},';
                sCount = parseInt(sCount) + 1;
            }
            else
            {

            }
            });
            if (sCount > 0)
            {
                JsonData = JsonData.slice(0, -1);
                JsonData += ']';

                // return false;
                $.ajax({
                    url: '@Url.Action("SaveCourseTypeGroup", "Academics")',
                    type: "post",
                    data: { sjsonData: JsonData },
                    success: function (data) {
                        swal({ title: "Success !", text: data.Message, showConfirmButton: false, timer: 5000, type: 'success', animation: true });
                        loadContent('/Academics/ListCourseTypeGroup');
                    },
                    error: function () {
                        swal({ title: "Info !", text: "Internal server error!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
                    }

                });

            }
            else
            {
                swal({ title: "Info !", text: "Please fill any one component to save!", showConfirmButton: false, timer: 5000, type: 'info', animation: true });
            }
        });
          
      
        
        
    </script>

