@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "ListDepartmentInfo";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Department </li>
    </ol>
    <h1 class="page-header">List Department </h1>
   
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Department </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" @*href="@Url.Action("DepartmentInfo","Academics")"*@ href="javascript:;" onclick="loadContent('/Academics/DepartmentInfo')"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            <br />

            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-hover table-bordered" id="DepartmentList">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.DEPARTMENT_CODE)*@
                                Department Code
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.DEPARTMENT)*@
                                Department
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.DEPARTMENT_ORDER)*@
                                Department Order
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.FACULTY)*@
                                Faculty
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.YEAR_OF_PUBLISHMENT)*@
                                Publish Year
                            </th>
                            <th>
                                @*@Html.DisplayNameFor(model => model.IS_ACTIVE)*@
                                Is Active
                            </th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.liDepartmentList)
                        {
                            <tr>
                                <td>
                                    @{ count++;}
                                    @count
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DEPARTMENT_CODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DEPARTMENT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DEPARTMENT_ORDER)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FACULTY)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.YEAR_OF_PUBLISHMENT)
                                </td>
                                <td>
                                    @if (item.IS_ACTIVE == "0")
                                    {
                                        <i class="fa fa-close text-danger"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-check text-success"></i>
                                    }
                                </td>
                                <td>
                                    <a href="javascript:;" onclick="loadContent('/Academics/EditDepartmentInfo/@item.DEPARTMENT_ID')" @*href="@Url.Action("EditDepartmentInfo","Academics",new { id=@item.DEPARTMENT_ID})"*@><i class="fa fa-edit text-primary" title="Click To Update"></i></a>
                                    <a href="javascript:;" onclick="GetConfrim(@item.DEPARTMENT_ID);" @*href="@Url.Action("DeleteDepartmentInfo","Academics",new { id=@item.DEPARTMENT_ID})" onclick="return confirm('Are you sure want to delete ?');"*@><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>
                                </td>
                            </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        function ContentLoad() 
        {
            // Document Ready Function .
        }
        $("#DepartmentList").DataTable();
        function GetConfrim(ID)
        {
            $.ajax({
                url: "@Url.Action("DeleteDepartmentInfo", "Academics")",
                method: "POST",
                datatype: "json",
                data: { id: ID },
                success: function (data) 
                {
                    alert(data.Message);
                    if (data.sResult!='False') 
                    {
                        LoadList();
                    }
                }, error: function (error) 
                {
                    alert('Internal Server Error !');
                }
            });
        }

        function LoadList() {
            loadContent('/Academics/ListDepartmentInfo');
        }
    </script>

