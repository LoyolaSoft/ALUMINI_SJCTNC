@*<div class="form-group">
    <a class="btn btn-success m-b-10 pull-right form-group" href="javascript:;" onclick="loadContent('/Academics/CourseRootInfo')" ><i class="fa fa-plus" title="Add"> Add</i></a>
</div>*@
@{ int count = 0;}

@if (Model.liCourseRootList != null && Model.liCourseRootList.Count > 0)
{
    <table class="table table-hover table-bordered" id="CourseRootList">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.DEPARTMENT)*@
                    Department
                </th>

                <th>
                    @*@Html.DisplayNameFor(model => model.COURSE_CODE)*@
                    Course Code
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.COURSE_TITLE)*@
                    Course Tittle
                </th>

                <th>
                    @*@Html.DisplayNameFor(model => model.SEMESTER)*@
                    Semester
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.IS_NME_SUBJECT)*@
                    Is NME
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.IS_ALLIED_SUBJECT)*@
                    Is Allied
                </th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liCourseRootList)
            {
                <tr>
                    <td>
                        @{ count++;}
                        @count
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DEPARTMENT)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.COURSE_CODE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.SEMESTER_NAME)
                    </td>
                    <td>
                        @if (item.IS_NME_SUBJECT == "1")
                        {
                            <span>Yes</span>
                        }
                        else
                        {
                            <span>No</span>
                        }
                    </td>
                    <td>
                        @if (item.IS_ALLIED_SUBJECT == "1")
                        {
                            <span>Yes</span>
                        }
                        else
                        {
                            <span>No</span>
                        }
                    </td>
                    <td>
                        <a href="javascript:;" onclick="loadContent('/Academics/EditCourseRootInfoForCoe/@item.COURSE_ROOT_ID')" @*href="@Url.Action("EditCourseRootInfo","Academics",new { id=@item.COURSE_ROOT_ID})"*@><i class="fa fa-edit text-primary" title="Update"></i></a>
                        <a @*href="@Url.Action("DeleteCourseRoot","Academics",new { id=@item.COURSE_ROOT_ID})"*@ href="javascript:;" onclick="GetConfrim(@item.COURSE_ROOT_ID);"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
                            }
                            else
                            {
                                <p>No Records Found!.</p>
                            }


<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>

        function ContentLoad() {
            // Document Ready Function .
        }
        $("#CourseRootList").DataTable({
            "columnDefs": [
                {"width":"8%","targets":[5,6]}
            ], "scrollX": true

        });
        //$("#CourseRootList").DataTable({
        //    "columnDefs": [
        //      { "width": "15%", "targets": [2,3,4,5,7,6,8] }
        //    ],"scrollX":true
        //});
        function GetConfrim(ID)
        {
            if (!confirm('Are you sure want to delete ?'))
            {
                return false;
            }
            $.ajax({
                url: "@Url.Action("DeleteCourseRoot", "Academics")",
                method: "POST",
                datatype: "json",
                data: { id: ID },
                success: function (data)
                {
                    alert(data.Message);
                    if (data.sResult == 'True')
                    {
                        LoadList();
                    }
                }
            });
        }


        function LoadList()
        {
            loadContent('/Academics/ListCourseInfo');
        }
</script>



