@model CMS.ViewModel.ViewModel.AcademicsViewModel


@{ Layout = null; int count = 0;}


<div class="table-responsive">
    <table class="table table-hover table-bordered" id="SelectedCourseWiseStaff">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.CLASS_ID)*@
                    Class
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.COURSE_CODE)*@
                    Code
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.COURSE_TITLE)*@
                    Course
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.STAFF_ID)*@
                    Staff
                </th>
                <th>
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.liCourseWiseStaff)
            {
                <tr>
                    <td>
                        @{ count++;}
                        @count
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CLASS_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COURSE_CODE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COURSE_TITLE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.STAFF_ID)
                    </td>
                    <td>
                        <a href="#EditSelectedCourseStaff-dialog" onclick="EditSelectedCourseWiseStaff(@item.CLSCRSSTF_ID)" data-toggle="modal" data-dismiss="modal"><i class="fa fa-edit text-primary" title="Edit"></i></a>
                        <a href="javascript:;" onclick="GetConfrim(@item.CLSCRSSTF_ID);" data-dismiss="modal" @*href="@Url.Action("DeleteCourseWiseStaffInfo","Academics",new { id=@item.CLSCRSSTF_ID})" onclick="return confirm('Are you sure want to delete ?');"*@><i class="fa fa-trash text-danger" title="Delete"></i></a>
                    </td>
                </tr>
                            }
        </tbody>
    </table>
</div>

<script>
    function ContentLoad()
    {
        // Document Ready Function .
    }
    function GetConfrim(ID)
    {
        if (!confirm('Are you sure want to delete ?'))
        {
            return false;
        }
        $.ajax({
            url: "@Url.Action("DeleteCourseWiseStaffInfo", "Academics")",
            method: "POST",
            datatype: "json",
            data: { id: ID },
            success: function (data)
            {
                alert(data.Message);
                if (data.sResult == 'True') 
                {
                    LoadList();
                }   
            }
        });
    }

    function LoadList() 
    {
        loadContent('/Academics/ListCourseWiseStaffInfo');
    }
</script>