@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{
    ViewBag.Title = "AcademicWiseCoursePatternReport";
}

<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">CoursePatternReport</li>
    </ol>
    <h1 class="page-header">Course Pattern Report</h1>
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">Course Pattern Report</h4>
        </div>

        <div class="panel-body" data-parsley-validate="true" id="Pbody">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.AcademicYear, "Academicyear", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.AcademicYear, (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" ,@id="dAcademicYear" })
                            @Html.ValidationMessageFor(model => model.AcademicYear, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.FacultyList, "Shift", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Shift, (Model.Shift != null) ? Model.Shift : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" ,@id="dShift" })
                            @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Programme, "ProgrammeMode", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ProgrammeMode, (Model.ProgrammeMode != null) ? Model.ProgrammeMode : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" ,@id="dProgrammeMode"})
                            @Html.ValidationMessageFor(model => model.ProgrammeMode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.FacultyList, "Faculty", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.FacultyList, (Model.FacultyList != null) ? Model.FacultyList : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @id = "dFaculty" })
                            @Html.ValidationMessageFor(model => model.FacultyList, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Semester, "Semester", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Semester, (Model.Semester != null) ? Model.Semester : Enumerable.Empty<SelectListItem>(), null, new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @id="dSemester"})
                            @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.ProgrammeLevel, "ProgrammeLevel", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ProgrammeLevel, (Model.ProgrammeLevel != null) ? Model.ProgrammeLevel : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" , @id="dProgrammeLevel" })
                            @Html.ValidationMessageFor(model => model.ProgrammeLevel, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Programme, "Programme", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.Programme, (Model.Programme != null) ? Model.Programme : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true", @multiple = "multiple", @data_actions_box = "true", @id="dProgramme"})
                            @Html.ValidationMessageFor(model => model.Programme, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <a class="btn btn-primary" id="btnGet">Get</a>
                    </div>
                </div>
            </div>
            <div class="form-group col-md-12" id="divBind">

            </div>

    

        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script>
    ContentLoad = function () {


        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');

    }

    $('#btnGet').click(function () {
        if ($('#dAcademicYear option:selected').text() && $('#dFaculty').val() && $('#dSemester').val() && $('#dProgrammeLevel').val() && $('#dProgramme').val()) {
            $.ajax({
                url: "/Academics/BindAcademicWiseCoursePatternReport",
                type: "post",
                data: { sAcademic: $('#dAcademicYear  option:selected').text(), sFaculty: $('#dFaculty').val(), sProgrammeLevel: $('#dProgrammeLevel').val(), sProgramme: String($('#dProgramme').val()), sSemester: String($('#dSemester').val()) },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        alert(data.Message)
                    }
                    else {

                        $('#divBind').html('');
                        $('#divBind').append(data);
                        $('#dvHead').att
                    }
                },
                error: function (ex) {

                }
            });
        }
        else {
            alert("Pleas Select All the fields")
        }
    });


    $('#dProgrammeMode').on("change", function () {
        $('#dProgramme').html('');
        $('#dProgramme').selectpicker('refresh');
        if ($('#dAcademicYear option:selected').text() && $('#dShift').val() && $('#dProgrammeMode').val()) {
            $.ajax({

                url: "/Academics/FetchProgrammeByProgrammeModeandShift",
                type: "post",
                data: { sShift: String($('#dShift').val()), sProgrammeMode: String($('#dProgrammeMode').val()) },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {

                    }
                    else {
                        $('#dProgramme').empty();
                        $.each(data, function (id, info) {
                            $('#dProgramme').append($('<option>',
                            {
                                value: info.PROGRAMME_GROUP_ID,
                                text: info.PROGRAMME_NAME
                            }));

                        });
                        $('#dProgramme').selectpicker('refresh');
                    }
                },
                error: function (ex) {

                }
            });
        }
    });


</script>