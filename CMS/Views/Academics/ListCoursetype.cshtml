@model CMS.ViewModel.ViewModel.AcademicsViewModel

@{
    ViewBag.Title = "ListCoursetype";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Course Type </li>
    </ol>
    <h1 class="page-header">List Course Type </h1>
   
    <div class="panel">
        <div class="panel-heading bg-primary">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List Course Type </h4>
        </div>
        <div class="panel-body noPadding">
            <div class="form-group col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" @*href="@Url.Action("CourseTypeInfo","Academics")"*@ href="javascript:;" onclick="loadContent('/Academics/CourseTypeInfo')"><i class="fa fa-plus" title="Add"> Add</i></a>
            </div>
            @{ int count = 0;}
            <div class="form-group col-md-12 table-responsive">
            <table class="table table-hover table-bordered" id="CourseTypeList">
                <thead>
                    <tr>
                        <th>
                            #
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.COURSE_TYPE)*@
                            Course Type
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.NO_OF_COMPONENTS)*@
                            No Of Component
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.INTERNAL)*@
                            Internal
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.EXTERNAL)*@
                            External
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.TOTAL)*@
                            Total
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.PART_ID)*@
                            Part
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.PROGRAMME_LEVEL)*@
                            Programme Level
                        </th>
                        <th>
                            @*@Html.DisplayNameFor(model => model.CREDITS)*@
                            Credits
                        </th>
                        <th>
                            Student View CIA Mark
                        </th>
                        <th>Action</th>
                    </tr>
                    </thead>
                <tbody>
                    @foreach (var item in Model.liCourseType)
                    {
                        <tr>
                            <td>
                                @{ count++;}
                                @count
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.COURSE_TYPE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NO_OF_COMPONENTS)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.INTERNAL)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EXTERNAL)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TOTAL)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PART_ID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PROGRAMME_LEVEL)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CREDITS)
                            </td>
                            <td>
                                @if (item.IS_STUDENT_VIEW_CIA_MARK == "0")
                                {
                                    <span class="label label-danger">No</span>
                                }
                                else
                                {
                                    <span class="label label-success">Yes</span>
                                }
                            </td>
                            <td>
                                <a @*href="@Url.Action("EditCourseTypeInfo","Academics",new { id=@item.COURSE_TYPE_ID})"*@ href="javascript:;" onclick="loadContent('/Academics/EditCourseTypeInfo/@item.COURSE_TYPE_ID')"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                <a href="javascript:;" onclick="GetConfrim(@item.COURSE_TYPE_ID);" @*href="@Url.Action("DeleteCourseTypeInfo","Academics",new { id=@item.COURSE_TYPE_ID})" onclick="return confirm('Are you sure want to delete ?');"*@><i class="fa fa-trash text-danger" title="Delete"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
                </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        function ContentLoad() 
        {
            // Document Ready Function .
        }
        $("#CourseTypeList").DataTable();

        function GetConfrim(ID)
        {
            if (!confirm('Are you sure want to delete ?'))
            {
                return false;
            }
            $.ajax({
                url: "@Url.Action("DeleteCourseTypeInfo", "Academics")",
                method: "POST",
                datatype: "json",
                data: { id: ID },
                success: function (data) 
                {
                    alert(data.Message);
                    if (data.sResult != "False") 
                    {
                        loadContent('/Academics/ListCoursetype');
                    }
                }, error: function (error) 
                {
                    alert('Internal Server Error !');
                }
            });
        }
    </script>
