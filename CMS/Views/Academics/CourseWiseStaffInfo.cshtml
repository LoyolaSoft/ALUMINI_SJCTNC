@model CMS.ViewModel.Model.CourseWiseStaffModel

@{
    ViewBag.Title = "CourseWiseStaffInfo";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    @*<link href="~/Content/assets/plugins/multi-select/multiselect.css" rel="stylesheet" />*@
    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />

@*<h2 class="col-md-offset-2">Add Course Wise Staff</h2>*@

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="javascript:;">Home</a></li>
            <li><a @*href="@Url.Action("ListCourseWiseStaffInfo","Academics")"*@ href="javascript:;" onclick="loadContent('/Academics/ListCourseWiseStaffInfo')">List Course Wise Staff</a></li>
            <li class="active">Add Course Wise Staff</li>
        </ol>
        <h1 class="page-header">Add Course Wise Staff</h1>
        <div class="panel">
            <div class="panel-heading bg-primary">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">Add Course Wise Staff</h4>
            </div>
            <div class="panel-body">
                <div class="col-md-12">
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.DEPARTMENT, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.DEPARTMENT, (Model.DEPARTMENT != null) ? Model.DEPARTMENT : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.DEPARTMENT, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.SHIFT, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.SHIFT, (Model.SHIFT != null) ? Model.SHIFT : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.SHIFT, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.CLASS_TYPE,"C.Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CLASS_TYPE, (Model.CLASS_TYPE != null) ? Model.CLASS_TYPE : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CLASS_TYPE, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.CLASS_ID, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.CLASS_ID, (Model.CLASS_ID != null) ? Model.CLASS_ID : Enumerable.Empty<SelectListItem>(), "--select--", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                    @Html.ValidationMessageFor(model => model.CLASS_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-md-3 control-label"> A.Semester</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model=>model.SemesterType, (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = " selectpicker show-menu-arrow show-tick drop-down form-control  input-sm", @data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal">
                        <div id="dvCourseWiseStaffBIND"></div>
                    </div>
                    <div>
                        <div class="col-lg-12 pull-right">
                            <div class="form-group pull-right">
                                <a href="#" class="btn-primary btn" id="btnSubmit">Submit</a>
                                <a id="btnCancel" value="Submit" class="btn btn-danger" href="javascript:;" onclick="loadContent('/Academics/ListCourseWiseStaffInfo')" @*href="@Url.Action("ListCourseWiseStaffInfo","Academics")"*@>Cancel</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    @*<script src="~/Content/assets/plugins/multi-select/multiselect-js.js"></script>*@
    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $('.selectpicker').selectpicker({
            size: 4
        });
        $(document).ready(function () {
            //  $('.sudo-multi-chekbox').SumoSelect({ search: true, searchText: 'Enter here' });
        });
    </script>
    <script>
        $('#SHIFT').on("change", function () {
            var Shift = $('#SHIFT').val();
            $('#dvCourseWiseStaffBIND').empty();
            $("#CLASS_ID").val($("#CLASS_ID option:first").val());
            $.ajax({
                url: "@Url.Action("GetClassTypeByShiftId", "Academics")",
                data: { sShift: Shift },
                success: function (option) {
                    var select = $('#CLASS_TYPE');
                    select.empty();
                    select.append('<option value="0" >---Select---</option>' + option);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
        });
    </script>
   
    <script>
        $('#CLASS_TYPE').on("change", function () {
            if ($('#DEPARTMENT').val() && $('#SHIFT').val()) {
                var ClassType = $('#CLASS_TYPE').val();
                var Shift = $('#SHIFT').val();
                var Department = $('#DEPARTMENT').val();
                $('#dvCourseWiseStaffBIND').empty();
                $("#CLASS_ID").val($("#CLASS_ID option:first").val());
                $.ajax({
                    url: "@Url.Action("GetClassListByClassTypeId", "Academics")",
                    data: { sClassType: ClassType, sDepartment: Department, sShift: Shift },
                    success: function (option) {
                    var select = $('#CLASS_ID');
                    select.empty();
                    select.append('<option value="0" >---Select---</option>' + option);
                    $('.selectpicker').selectpicker('refresh');
                },
                error: function (xhr, textStatus, error) {
                    alert(error + "\n");
                }
            });
            } else {
                alert("Select the Department And Shift");
            }
        });
    </script>
    <script>
        $("#CLASS_ID").on("change", function ()
        {
            BindClassCourseStaff();
        });

        $("#SemesterType").on("change", function () {
            BindClassCourseStaff();
        });
        function BindClassCourseStaff() 
        {
            if ($('#CLASS_ID').val() != 0 && $("#SHIFT").val() && $("#CLASS_TYPE").val() != 0 && $("#DEPARTMENT").val() && $('#SemesterType').val())
            {
                var ClassId = $("#CLASS_ID").val();
                var Shift = $("#SHIFT").val();
                var ClassType = $("#CLASS_TYPE").val();
                var Department = $("#DEPARTMENT").val();
                $.ajax({
                    url: "@Url.Action("BindStaffsbyClassId", "Academics")",
                    data: { sClassId: ClassId, sDepartment: Department, sShift: Shift, sClassType: ClassType },
                    success: function (option)
                    {
                        var divHtml = $('#dvCourseWiseStaffBIND');
                        divHtml.empty();
                        divHtml.html(option);
                       
                        $('.selectpicker').selectpicker('refresh');    
                    },
                    error: function (xhr, textStatus, error)
                    {
                        alert(error + "\n");
                    }
                   });
            } else
            {
                var divHtml = $("#dvCourseWiseStaffBIND");
                divHtml.empty();
            }
        }
    </script>
  
    <script>
        $("#btnSubmit").on("click", function ()
        {
            var ClassId = $("#CLASS_ID").val();
            var ShiftId = $("#SHIFT").val();
            var ClassType = $('#CLASS_TYPE').val();
            var Department = $('#DEPARTMENT').val();
            var SemesterType = $('#SemesterType').val();
            if (ClassId == 0 || ShiftId == 0)
            {
                alert('Please Select All Options To Continue');
                return false;
            }
             
            var ObjJsonData = null;
            if (ObjJsonData = null)
            {
                ObjJsonData += '{"CLASS_ID":"' + ClassId + '","SHIFT_ID":"' + ShiftId + '","CLASS_TYPE":"' + ClassType + '","DEPARTMENT_ID":"' + Department + '"}';
            }
            var nCount = 0;
            var sCourseId;
            var sShiftId;
            var sClassId;
            var sStaffId;
            var sSemesterId;
            var JsonData;
            var sArrStaff;

            
            if (JsonData == null)
            {
                JsonData = '{"CourseWiseStaffList":[';
                $('#CourseWiseStaff tbody tr').each(function ()
                {
                    

                    sClassId = ClassId;
                    sShiftId = ShiftId;
                    sCourseId = $(this).attr("cms-rcourseid");
                    sSemesterId = $(this).attr("cms-rsemesterid");
                    sStaffId = String($(this).find("#Staff_List").val());
                    
                    sArrStaff = $(this).attr("cms-sStaffId");

                    var sArray = sStaffId.split(',');
                    if (sArrStaff != null && sArrStaff!='')
                    {
                        var sArrStaffval = sArrStaff.split(',');
                        for (var i = 0; i < sArrStaffval.length; i++)
                        {
                            var s = '';
                            for (var j = 0; j < sArray.length; j++)
                            {
                                if (sArrStaffval[i] == sArray[j])
                                {
                                    s = '1';
                                }
                                
                            }
                            if (s == '')
                            {
                                JsonData += '{"IS_DELETED":"1","CLASS_ID":"' + sClassId + '","COURSE_ID":"' + sCourseId + '","STAFF_ID":"' + sArrStaffval[i] + '","SHIFT":"' + sShiftId + '","SEMESTER_ID":"' + sSemesterId + '","SEMESTER_TYPE_ID":"' + SemesterType + '"},';
                                nCount++;
                            }
                        }
                    }
                    
                    for (var i = 0; i < sArray.length; i++)
                    {
                        if (sArray[i] != 'null')
                        {
                            JsonData += '{"IS_DELETED":"0","CLASS_ID":"' + sClassId + '","COURSE_ID":"' + sCourseId + '","STAFF_ID":"' + sArray[i] + '","SHIFT":"' + sShiftId + '","SEMESTER_ID":"' + sSemesterId + '","SEMESTER_TYPE_ID":"' + SemesterType + '"},';
                            nCount++;
                        }
                    }
                 
                });
                if (nCount != 0)
                {
                    JsonData = JsonData.slice(0, -1);
                    JsonData += ']}';
                } else {
                    alert('Please Select Staff To Continue !');
                    return false;
                }
                
            }
            $.ajax({
                url: "@Url.Action("InsertCourseWiseStaff","Academics")",
                method: "POST",
                datatype: "html",
                data: { sJsonCourseWiseStaff: JsonData},
                success: function (data)
                {
                    alert(data);
                    BindClassCourseStaff();
                }, error: function (error)
                {
                    alert('Internal Server Error !')
                }
            });
        });
    </script>



