@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{
    ViewBag.Title = "StudentTagMapping";
}


<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Buttons/css/buttons.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/gritter/css/jquery.gritter.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.css" rel="stylesheet" />
<link href="~/Content/assets/plugins/parsley/src/parsley.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/css/lightbox.min.css">
<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>

        <li class="active">Student Tag List </li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Student Tag List <small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Student Tag List </h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 pull-right">
                <a href="#modal-dialog" data-toggle="modal" id="Add" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
            </div>
            <br /><br />
            <div class="col-md-12 form-group table-responsive">

                <table class="table table-bordered table-hover" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tag Name</th>
                            <th>Color </th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liSupStudentTag != null && Model.liSupStudentTag.Count > 0)
                        {
                            int nCount = 0;
                            foreach (var item in Model.liSupStudentTag)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.TAG_NAME</td>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <div style="width: 20px; height: 20px; border-radius:4px; background:@item.COLOR_CODE;"></div>
                                            @*<span>@item.COLOR_CODE</span>*@
                                        </div>
                                    </td>


                                    <td>

                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>

                                    <td>
                                        <a href="#modal-dialog" data-toggle="modal" class="text-primary" onclick="FetchStudentTagById(@item.TAG_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfirm(@item.TAG_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>


<div class="modal" id="modal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="TagList">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                           
                            <input type="hidden" id="TagId" />

                           
                            <div class="form-group">
                                <label class="control-label col-md-3">Tag Name </label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="TagName" class="form-control" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3">Tag Color </label>
                                <div class="col-md-9">
                                   
                                    <input type="color" name="color" id="ColorCode" class="form-control" required />

                                </div>
                            </div>
                           

                            <div class="col-md-4 form-group">
                                <div class="col-md-8">
                                    <input type="checkbox" id="IsActive" /> &nbsp; &nbsp; IsActive
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" onclick="SaveStudentTagList()" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.flash.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/jszip.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/pdfmake.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/vfs_fonts.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Buttons/js/buttons.print.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/assets/plugins/flot/jquery.flot.min.js"></script>
<script src="~/Content/assets/plugins/gritter/js/jquery.gritter.js"></script>
<script src="~/Content/assets/plugins/bootstrap-sweetalert/sweetalert.min.js"></script>
<script src="~/Content/assets/js/ui-modal-notification.demo.min.js"></script>
<script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/Content/assets/plugins/parsley/dist/parsley.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightbox2@2.11.3/dist/js/lightbox.min.js"></script>
<script src="~/Content/assets/plugins/summernote/summernote.min.js"></script>


<script>


    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
    });

    function ContentLoad() {
        // Document. Ready Function ...,
    }



    function GetConfirm(id) {
        swal({
            title: "Are you sure want to Delete..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("DeleteStudentTagById", "Academics")",
                type: "post",
                data: { TagID: id },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode == "402") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 2800, type: 'error', animation: true });
                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 2800, type: 'success', animation: true });
                    }
                    loadContent('/Academics/StudentTagMapping');
                },
                error: function () {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            });
        });

    }


    $("#Add").on('click', function () {
        $('#TagName').val('');
        $('#ColorCode').val('');
      
        $("#IsActive").prop("checked", false);
    });



    function FetchStudentTagById(Id) {
        $.ajax({
            url: '/Academics/FetchStudentTagById',
            method: 'POST',
            datatype: 'json',
            data: { TagID: Id },
            success: function (data) {
                $('#TagId').val(data.oResult[0].TAG_ID);
                $('#TagName').val(data.oResult[0].TAG_NAME);
                $('#ColorCode').val(data.oResult[0].COLOR_CODE);

                if (data.oResult[0].IS_ACTIVE == 1) {
                    $("#IsActive").prop("checked", true);
                } else {
                    $("#IsActive").prop("checked", false);
                }
            }, error: function () {
                alert('Internal Server Error !');
            }
        });
    }




     $('#btnSubmit').on('click', function () {
     var isValid = true;
         if ($('#TagList').parsley().validate() !== true) isValid = false;

     var IsActive = $('#IsActive').is(':checked') ? 1 : 0;
         var sJsonData = '{"TAG_ID":"' + $("#TagId").val() +
             '","TAG_NAME":"' + $('#TagName').val() +
             '","COLOR_CODE":"' + $('#ColorCode').val() +
         '","IS_ACTIVE":"' + IsActive + '"}';

     $.ajax({
         url: '@Url.Action("SaveStudentTagList", "Academics")',
         method: 'POST',
         data: { TagList: sJsonData },
         success: function (data) {
             if (data.ErrorCode == "200") {
                 swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
             } else {
                 swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
             }
             loadContent('/Academics/StudentTagMapping');
         },
         error: function () {
             alert('Internal Server Error !');
         }
     });
 });



   

</script>