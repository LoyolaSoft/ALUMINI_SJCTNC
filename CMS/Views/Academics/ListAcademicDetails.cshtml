@model CMS.ViewModel.ViewModel.AcademicsViewModel


@{
    ViewBag.Title = "List Academic Details";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}


    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />


<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List Academic Year </li>
    </ol>
    <h1 class="page-header">List Academic Year </h1>
    @if (TempData["DeleteSuccess"] != null)
    {
        <div class="row alert alert-success fade in m-b-15" id="Success">
            <strong>Success!</strong>
            @TempData["DeleteSuccess"]
            <span class="close" data-dismiss="alert">×</span>
        </div>
    }
    @if (TempData["DeleteError"] != null)
    {
        <div class=" row alert alert-danger fade in m-b-15" id="Error">
            <strong>Error!</strong>
            @TempData["DeleteError"]
            <span class="close" data-dismiss="alert">×</span>
        </div>
    }

        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
                </div>
                <h4 class="panel-title">List Academic Year </h4>
            </div>
            <div class="panel-body">
                <div class="col-md-12">
                    <a class="btn btn-success pull-right form-group m-b-5" @*href="@Url.Action("AcademicYearInfo","Academics")"*@ href="javascript:;" onclick="loadContent('/Academics/AcademicYearInfo')"><i class="fa fa-plus" title="Add"> Add</i></a>
                </div>
                <br />
                @{ int count = 0;}
                <div class="table-responsive col-md-12">
                    <table class="table table-bordered table-hover" id="AdacemicYearList">
                        <thead>
                            <tr>
                                <th>
                                    #
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.AC_YEAR)*@
                                    Ac Year
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.DATE_FROM)*@
                                    Date From
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.DATE_TO)*@
                                    Date To
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.ACTIVE_YEAR)*@
                                    Active Year
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.ACADEMIC_NAME)*@
                                    Academic Name
                                </th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.liAcademicYear)
                        {
                                <tr>
                                    <td>
                                        @{ count++;}
                                        @count
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.AC_YEAR)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DATE_FROM)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DATE_TO)
                                    </td>
                                    <td>
                                        @if (item.ACTIVE_YEAR == "0")
                                    {
                                            <i class="fa fa-close text-danger" onclick="ActiveAcademic(@item.ACADEMIC_YEAR_ID);"></i>
                                    }
                                    else
                                    {
                                            <i class="fa fa-check text-success"></i>
                                    }
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ACADEMIC_NAME)
                                    </td>
                                    <td>
                                        <a href="javascript:;" onclick="loadContent('/Academics/EditAcademicYearInfo/@item.ACADEMIC_YEAR_ID')" @*href="@Url.Action("EditAcademicYearInfo","Academics",new { id=@item.ACADEMIC_YEAR_ID})"*@><i class="fa fa-edit text-primary" title="Click To Edit"></i></a>
                                        @if (item.ACTIVE_YEAR == "0")
                                    { <a @*href="@Url.Action("DeleteAcademicYearInfo","Academics",new { id=@item.ACADEMIC_YEAR_ID})"*@ href="javascript:;" onclick="GetConfrim(@item.ACADEMIC_YEAR_ID);"><i class="fa fa-trash text-danger" title="Click To Delete"></i></a>}

                                    </td>
                                </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
</div>

    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        
        function ContentLoad() {
            // Document Ready Function .
        }
        $("#AdacemicYearList").DataTable();
    </script>
    <script>
        ActiveAcademic = function (ID) {
            if (!confirm('Are you sure to change academic year ?')) {
                return false;
            }
            $.ajax({
                url: "@Url.Action("UpdateActiveAcademic","Academics")",
                method: "POST",
                datatype: "html",
                data: { sActiveYearId: ID },
                success: function (data) {
                    if (data != 'False') {
                        alert("Academic year has been changed successfully !!!");
                        LoadAcademics();
                    } else {
                        alert("Failed to change Academic year !!!");
                    }

                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }

        function GetConfrim(ID)
        {
            if (!confirm('Are you sure want to delete ?'))
            {
                return false;
            }
            $.ajax({
                url: "@Url.Action("DeleteAcademicYearInfo", "Academics")",
                method: "POST",
                datatype: "json",
                data: { id: ID },
                success: function (data)
                {
                    alert(data.Message);
                    if (data.sResult == 'True') 
                    {
                        LoadAcademics();
                    }   
                }, error: function (error)
                {
                    alert('Internal Server Error !');
                }
            });
        }


        function LoadAcademics() 
        {
            loadContent('/Academics/ListAcademicDetails');
        }
    </script>
