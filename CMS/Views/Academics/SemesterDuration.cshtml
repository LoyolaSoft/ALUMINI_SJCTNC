<link href="~/Content/assets/plugins/summernote/summernote.css" rel="stylesheet" />


<div id="content" class="content">
    <!-- begin breadcrumb -->
    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li><a href="javascript:;">SemesterDuration</a></li>
        <li class="active">Semester Duration</li>
    </ol>
    <!-- end breadcrumb -->
    <!-- begin page-header -->
    <h1 class="page-header">Semester Duration<small></small></h1>
    <!-- end page-header -->
    <div class="panel panel-info" id="panel">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" id="btnReload" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h3 class="panel-title">Semester Duration</h3>
        </div>
        <div class="panel-body">
            <div class="col-md-12 pull-right">
                <a href="#modal-dialog" data-toggle="modal" id="Add" class="btn btn-success pull-right"><i class="fa fa-plus"></i> Add</a>
            </div>
            <br /><br />
            <div class="col-md-12 form-group table-responsive">

                <table class="table table-bordered table-hover" id="tblcer">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Semester Name</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th>Academic Year</th>
                            <th>Semester Type</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liSemesterDuration != null && Model.liSemesterDuration.Count > 0)
                        {
                            int nCount = 0;
                            foreach (var item in Model.liSemesterDuration)
                            {
                                <tr>
                                    <td>@{nCount++;} @nCount</td>
                                    <td>@item.SEMESTER_NAME</td>
                                    <td>@item.FROM_DATE</td>
                                    <td>@item.TO_DATE</td>
                                    <td>@item.ACADEMIC_YEAR</td>
                                    <td>@item.SEMESTER_TYPE</td>
                                    <td>

                                        @if (item.IS_ACTIVE == "1")
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;" onclick=""><i class="fa fa-times text-danger"></i></a>
                                        }

                                    </td>

                                    <td>
                                        <a href="#modal-dialog" data-toggle="modal" class="text-primary" onclick="FetchSemesterDurationById(@item.DURATION_ID)"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:;" class="text-danger" onclick="GetConfirm(@item.DURATION_ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>



<div class="modal" id="modal-dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit </h4>
            </div>
            <div class="modal-body" data-parsley-validate="true" id="Duration">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <input type="hidden" id="DurationID" />

                            <div class="form-group">
                                <label class="control-label col-md-3">Semester Name</label>
                                <div class="col-md-9">
                                    <input type="text" name="name" id="SemesterName" class="form-control" required />
                                </div>
                            </div>


              <div class="form-group">
            <label class="control-label col-md-3">From Date</label>
            <div class="col-md-9">
                <div class="input-group">
                    <input type="text" name="name" id="Fromdate" class="form-control date" />
                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                </div>
            </div>
        </div>


              <div class="form-group">
            <label class="control-label col-md-3">To Date</label>
            <div class="col-md-9">
                <div class="input-group">
                    <input type="text" name="name" id="Todate" class="form-control date"  />
                    <span class="input-group-addon bg-purple"><i class="fa fa-calendar"></i></span>
                </div>
            </div>
        </div>

                            <!-- Academic Year -->
                            <div class="form-group">
                                <label class="control-label col-md-3">Academic Year</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                        model => model.AcademicYear,
                                        (Model.AcademicYear != null) ? Model.AcademicYear : Enumerable.Empty<SelectListItem>(),
                                        "-- Select --",
                                        new
                                             {
                                            @class = "form-control selectpicker show-menu-arrow show-tick",
                                            id = "AcademicYear",
                                            @data_live_search = "true",
                                            @data_parsley_required = "true",
                                            @data_parsley_trigger = "change"
                                        })
                                    @Html.ValidationMessageFor(m => m.AcademicYear, "", new { @class = "text-danger" })
                                </div>
                            </div>
                   
                            <!-- Semester Type -->
                            <div class="form-group">
                                <label class="control-label col-md-3">Semester Type</label>
                                <div class="col-md-9">
                                    @Html.DropDownListFor(
                                        model => model.SemesterType,
                                        (Model.SemesterType != null) ? Model.SemesterType : Enumerable.Empty<SelectListItem>(),
                                        "-- Select --",
                                        new
                                             {
                                            @class = "form-control selectpicker show-menu-arrow show-tick",
                                            id = "SemesterType",
                                            @data_live_search = "true",
                                            @data_parsley_required = "true",
                                            @data_parsley_trigger = "change"
                                        })
                                    @Html.ValidationMessageFor(m => m.SemesterType, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-4 form-group">
                                <div class="col-md-8">
                                    <input type="checkbox" id="IsActive" /> &nbsp; &nbsp; IsActive
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" onclick="SaveSemesterDuration()" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>



<input type="hidden" id="hdExamSettingId" />

<script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
<script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
