<script>

    $(document).ready(function () {
        // ✅ Initialize DataTable
        $('#tblcer').DataTable({});
    });

    function ContentLoad() {
        // Document. Ready Function ...,
    }

    // ✅ Handle Datepickers with restriction
    handleDatepicker = function () {
        "use strict";

        $('#Fromdate').datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy",
            orientation: "left"
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());
            $('#Todate').datepicker('setStartDate', minDate);   // restrict TO_DATE >= FROM_DATE
        });

        $('#Todate').datepicker({
            todayHighlight: true,
            autoclose: true,
            format: "dd/mm/yyyy",
            orientation: "left"
        }).on('changeDate', function (selected) {
            var maxDate = new Date(selected.date.valueOf());
            $('#Fromdate').datepicker('setEndDate', maxDate);   // optional: restrict FROM_DATE <= TO_DATE
        });
    }
    handleDatepicker();

    $('.selectpicker').selectpicker({ size: 6 });
    $('.selectpicker').selectpicker('refresh');

    $("#Add").on('click', function () {
        $('#SemesterName').val('');
        $('#Fromdate').val('').datepicker('clearDates');
        $('#Todate').val('').datepicker('clearDates');
        $('#AcademicYear').val('');
        $("#IsActive").prop("checked", false);
        $('.selectpicker').selectpicker('refresh');
    });

    function FetchSemesterDurationById(Id) {
        $.ajax({
            url: '/Academics/FetchSemesterDurationById',
            method: 'POST',
            datatype: 'json',
            data: { DurationID: Id },
            success: function (data) {
                $('#DurationID').val(data.oResult[0].DURATION_ID);
                $('#SemesterName').val(data.oResult[0].SEMESTER_NAME);
                $('#Fromdate').val(data.oResult[0].FROM_DATE);
                $('#Todate').val(data.oResult[0].TO_DATE);
                $('#AcademicYear option[value="' + data.oResult[0].ACADEMIC_YEAR + '"]').attr("selected", "selected");
                $('#SemesterType option[value="' + data.oResult[0].SEMESTER_TYPE + '"]').attr("selected", "selected");
                $('.selectpicker').selectpicker('refresh');

                if (data.oResult[0].IS_ACTIVE == 1) {
                    $("#IsActive").prop("checked", true);
                } else {
                    $("#IsActive").prop("checked", false);
                }
            }, error: function () {
                alert('Internal Server Error !');
            }
        });
    }

    function GetConfirm(id) {
        swal({
            title: "Are you sure want to Delete..?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, I agree!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                url: "@Url.Action("DeleteSemesterDurationById", "Academics")",
                type: "post",
                data: { DurationID: id },
                success: function (data) {
                    if (data.ErrorCode != null && data.ErrorCode == "402") {
                        swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                    } else {
                        swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                    }
                    loadContent('/Academics/SemesterDuration');
                },
                error: function () {
                    swal({ title: "Error..!!", text: "Internal Server Error..!!", showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
            });
        });
    }

    $('#btnSubmit').on('click', function () {
        var isValid = true;
        if ($('#Duration').parsley().validate() !== true) isValid = false;

        // ✅ Extra validation for From Date <= To Date
        var fromDate = $('#Fromdate').val();
        var toDate = $('#Todate').val();
        if (fromDate && toDate) {
            var f = fromDate.split("/").reverse().join("-");
            var t = toDate.split("/").reverse().join("-");
            if (new Date(f) > new Date(t)) {
                isValid = false;
                swal({ title: "Error..!!", text: "To Date cannot be earlier than From Date!", showConfirmButton: true, type: 'error' });
                return false;
            }
        }

        if (!isValid) {
            myAlert('Something went wrong ! Please check your inputs !', 'gritter-warning', '');
            return false;
        }

        var IsActive = $('#IsActive').is(':checked') ? 1 : 0;
        var sJsonData = '{"DURATION_ID":"' + $("#DurationID").val() +
            '","SEMESTER_NAME":"' + $('#SemesterName').val() +
            '","FROM_DATE":"' + $('#Fromdate').val() +
            '","TO_DATE":"' + $('#Todate').val() +
            '","ACADEMIC_YEAR":"' + $('#AcademicYear').val() +
            '","SEMESTER_TYPE":"' + $('#SemesterType').val() +
            '","IS_ACTIVE":"' + IsActive + '"}';

        $.ajax({
            url: '@Url.Action("SaveSemesterDuration", "Academics")',
            method: 'POST',
            data: { duration: sJsonData },
            success: function (data) {
                if (data.ErrorCode == "200") {
                    swal({ title: "Success..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'success', animation: true });
                } else {
                    swal({ title: "Error..!!", text: data.Message, showConfirmButton: false, timer: 1800, type: 'error', animation: true });
                }
                loadContent('/Academics/SemesterDuration');
            },
            error: function () {
                alert('Internal Server Error !');
            }
        });
    });

    $(function () {
        // Revalidate on input/change
        $('#Fromdate, #Todate, #AcademicYear, #SemesterType').on('change input', function () {
            $(this).parsley().validate(); // re-check field
        });
    });


</script>
