@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{ Layout = null; int count = 0;}
<table class="table table-bordered table-hover" id="tblCoursePatternList">
    <thead>
        <tr>
            <th>#</th>
            <th>Semester</th>
            <th>Part</th>
            <th>Credit</th>
            <th>Hour Per Week</th>
            <th>Faculty</th>
            <th>UGC Type</th>
            <th>Course Title</th>
            <th>Course Code</th>
            <th>Syllabus</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.liCoursePattern != null && Model.liCoursePattern != null)
        {
            string sFilePath = string.Empty;
            foreach (var list in Model.liCoursePattern)
            {
                sFilePath = "/Syllabus/" + list.COURSE_CODE + ".pdf";
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>@list.SEMESTER_NAME</td>
                    <td>@list.PART</td>
                    <td>@list.CREDIT</td>
                    <td>@list.HRS_PER_WEEK</td>
                    <td>@list.FACULTY</td>
                    <td>@list.UGC_COURSE_TYPE</td>
                    <td>@list.COURSE_TITLE</td>
                    <td>@list.COURSE_CODE</td>
                    <td><a href="@sFilePath" target="_blank"><i class="fa fa-file-pdf-o text-danger"></i></a></td>
                </tr>
             }
        }

    </tbody>
</table>

