@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{
    ViewBag.Title = "ListUgcCourseType";
    //Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    Layout = null;
}

    <link href="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />

<div class="content" id="content">

    <ol class="breadcrumb pull-right">
        <li><a href="javascript:;">Home</a></li>
        <li class="active">List UgcCourseType</li>
    </ol>
    <h1 class="page-header">List UgcCourseType </h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="panel-heading-btn">
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-success" data-click="panel-reload"><i class="fa fa-repeat"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-warning" data-click="panel-collapse"><i class="fa fa-minus"></i></a>
                <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
            </div>
            <h4 class="panel-title">List UgcCourseType </h4>
        </div>
        <div class="panel-body">
            <div class="col-md-12">
                <a class="btn btn-success pull-right form-group m-b-5" href="#UgcCourseTypemodal" data-toggle="modal"><i class="fa fa-plus" title="Add/Edit"> Add/Edit</i></a>
            </div>
            <br />
            @{ int count = 0;}
            <div class="table-responsive col-md-12">
                <table class="table table-hover table-bordered" id="tblCourses">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ugc Course Type</th>
                            <th>Part</th>
                            <th>Programme Level</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.liUgcCourseType != null && Model.liUgcCourseType.Count > 0)
                        {
                            foreach (var item in Model.liUgcCourseType)
                            {
                                <tr>
                                    <td>@{ count++;}@count</td>
                                    <td>@item.UGC_COURSE_TYPE</td>
                                    <td>@item.PART_ID</td>
                                    <td>@item.PROGRAMME_LEVEL</td>
                                    <td>
                                        <a href="#UgcCourseTypemodal" onclick="FetchUgcCourseTypeById(@item.UGC_COURSE_TYPE_ID);" data-toggle="modal"><i class="fa fa-edit text-primary" title="Update"></i></a>
                                        <a href="#" onclick="DeleteUgcCoursType(@item.UGC_COURSE_TYPE_ID);"><i class="fa fa-trash text-danger" title="Delete"></i></a>
                                    </td>
                                </tr>
                                            }
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

    <script src="~/Content/assets/plugins/bootstrap-select/bootstrap-select.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/Content/assets/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        function ContentLoad() {
            // Document Ready Function .
        }
        $("#tblCourses").DataTable();
        $('.selectpicker').selectpicker({
            size: 5
        });
        $('.selectpicker').selectpicker('refresh');
    </script>
    <script>
        // Delete .....
        function DeleteUgcCoursType(ID) {
            if (!confirm('Are you sure to Delete UgcCourseType?')) {
                return false;
            }
            $.ajax({
                url: "@Url.Action("DeleteUgcCourseType", "Academics")",
                method: "POST",
                datatype: "json",
                data: { sUgcCourseTypeId: ID },
                success: function (data) {
                    alert(data.Message);
                    
                    loadContent('/Academics/ListUgcCourseType');
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }        
        // Edit Class Course
        function FetchUgcCourseTypeById(ID) {
            $.ajax({
                url: '@Url.Action("FetchUgcCourseTypeById", "Academics")',
                method: 'POST',
                datatype: 'json',
                data: { sUgcCourseTypeId: ID },
                success: function (data) {
                    if (data.Message != null && data.Message != '') {
                        alert(data.Message);
                    } else {
                        $('#objUgcCourseType_UGC_COURSE_TYPE').val(data[0].UGC_COURSE_TYPE);
                        $('#Part').val(data[0].PART_ID);
                        $('#ProgrammeLevel').val(data[0].PROGRAMME_LEVEL);
                        $('#hdUgcCourseTypeId').val(data[0].UGC_COURSE_TYPE_ID);
                        $('.selectpicker').selectpicker('refresh');
                    }
                }, error: function (error) {
                    alert('Internal Server Error !');
                }
            });
        }

        // Submit Class Course
        $('#btnSubmit').on('click', function () {
            if ($('#objUgcCourseType_UGC_COURSE_TYPE').val()) {
                var JsonData = '{"UGC_COURSE_TYPE_ID":"' + $('#hdUgcCourseTypeId').val() + '","PART_ID":"' + $('#Part').val() + '","PROGRAMME_LEVEL":"' + $('#ProgrammeLevel').val() + '","UGC_COURSE_TYPE":"' + $('#objUgcCourseType_UGC_COURSE_TYPE').val() + '"}';
                $.ajax({
                    url: '@Url.Action("SaveUgcCourseType", "Academics")',
                    method: 'POST',
                    datatype: 'json',
                    data: { JsonSaveUgcCousrseType: JsonData },
                    success: function (data) {
                        alert(data.Message);
                        loadContent('/Academics/ListUgcCourseType');
                    }, error: function (error) {
                        alert('Internal Server Error !');
                    }
                });
            } else {
                alert('Enter Ugc Course Type');
            }
            
        });

    </script>


<div class="modal" id="UgcCourseTypemodal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title">Add / Edit UgcCourseType</h4>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="form-horizontal">
                            <div class="col-md-12">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input type="hidden" id="hdUgcCourseTypeId" />
                                <div class="form-group">
                                    @Html.Label("Ugc Course Type", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.EditorFor(model => model.objUgcCourseType.UGC_COURSE_TYPE, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Enter the Ugc Course Type" } })
                                        @Html.ValidationMessageFor(model => model.objUgcCourseType.UGC_COURSE_TYPE, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.Label("Part", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.Part, (Model.Part != null) ? Model.Part : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ProgrammeLevel, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.DropDownListFor(model => model.ProgrammeLevel, (Model.ProgrammeLevel != null) ? Model.ProgrammeLevel : Enumerable.Empty<SelectListItem>(), "-- Select --", new { @class = "selectpicker form-control input-sm", @data_live_search = "true" })
                                        @Html.ValidationMessageFor(model => model.Semester, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a href="javascript:;" id="btnSubmit" class="btn btn-sm btn-primary" data-dismiss="modal">Submit</a>
                <a href="javascript:;" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</div>