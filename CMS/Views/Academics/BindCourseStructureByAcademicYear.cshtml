@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{ Layout = null; int count = 0;}
<table class="table table-bordered table-hover" id="CourseStructureList">
    <thead>
        <tr>
            <th>#</th>
            <th>Semester</th>
            <th>UGC Course Type</th>
            <th>part</th>
            <th>Programme Level</th>
            <th>Programme Year</th>
            <th>Credit</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.liCourseStructure != null && Model.liCourseStructure != null)
        {
            foreach (var list in Model.liCourseStructure)
            {
                <tr>
                    <td>
                        @{ count++;}@count
                    </td>
                    <td>@list.SEMESTER_ID</td>
                    <td>@list.UGC_TYPE_ID</td>
                    <td>@list.PART_ID</td>
                    <td>@list.PROGRAMME_LEVEL</td>
                    <td>@list.PROGRAMME_YEAR</td>
                    <td>@list.CREDIT</td>
                    <td>
                        <a @*href="@Url.Action("CourseStructure","Academics",new {CourseStructureId=@list.COURSE_STRUCTURE_ID })"*@ href="javascript:;" onclick="loadContent('/Academics/CourseStructure/@list.COURSE_STRUCTURE_ID')" title="Click To Edit"> <i class="fa fa-edit text-primary"></i></a>
                        <a onclick="GetConfirm(@list.COURSE_STRUCTURE_ID)" style="cursor:pointer" title="Click To Delete"> <i class="fa fa-trash text-danger"></i></a>
                    </td>
                </tr>
             }
         }

    </tbody>
</table>


