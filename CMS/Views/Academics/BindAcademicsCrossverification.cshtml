@model CMS.ViewModel.ViewModel.AcademicsViewModel
@{ Layout = null;}

@if(Model.ClassCourseList != null && Model.ClassCourseList.Count > 0)
{

    var Status = Model.ClassCourseList.GroupBy(o => o.STATUS).ToList();
    if (Status != null && Status.Count > 0)
    {
        foreach (var item in Status)
        {
            int count = 0;
            <table class="table table-bordered table-hover" border="1">
                <caption> Class Course  Correction</caption>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Class</th>
                        <th>CourseCode</th>
                        <th>CourseTitle</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var Stausclass = Model.ClassCourseList.Where(o => o.STATUS == item.FirstOrDefault().STATUS).ToList();
                        if (Stausclass != null && Stausclass.Count > 0)
                        {

                            Stausclass.OrderBy(o => o.CLASS_ID);
                            foreach (var stclitem in Stausclass)
                            {
                                <tr>
                                    <td>@{count++;}@count</td>
                                    <td>@stclitem.CLASS_NAME</td>
                                    <td>@stclitem.COURSE_CODE</td>
                                    <td>@stclitem.COURSE_TITLE</td>
                                </tr>
                                            }

                                        }
                    }
                </tbody>
            </table>
                                                }

                                            }

                                        }



